  <script>
    (function () {
      var key = 'lingzanzan-v1-admin-login';
      var params = new URLSearchParams(location.search);
      if (params.get('resetLogin') === '1') localStorage.removeItem(key);
      if (params.get('login') === 'sales') {
        localStorage.removeItem(key);
        document.documentElement.setAttribute('data-sales-entry', 'true');
        return;
      }
      try {
        var cached = JSON.parse(localStorage.getItem(key) || '{}');
        if (cached.version === 'password-login-v2' && cached.until && Date.now() < cached.until && cached.role !== 'sales') {
          document.body.classList.add('is-admin-unlocked');
        }
      } catch (error) {}
    }());
  </script>

