  <script>
    (function () {
      function applyCustomField(select, input) {
        if (!select || !input) return;
        var custom = select.value === '__custom__';
        var host = select.closest('label');
        input.hidden = !custom;
        if (host) host.classList.toggle('is-custom', custom);
        if (!custom && select.value) input.value = select.value;
      }
      function bind(select, input) {
        if (!select || !input) return;
        select.addEventListener('change', function () { applyCustomField(select, input); });
        applyCustomField(select, input);
      }
      function init() {
        var form = document.querySelector('[data-manual-preorder-form]');
        if (!form) return;
        var colorSelect = form.querySelector('[data-preorder-color-select]');
        var sizeSelect = form.querySelector('[data-preorder-size-select]');
        var colorInput = form.querySelector('[data-manual-preorder-color]');
        var sizeInput = form.querySelector('[data-manual-preorder-size]');
        bind(colorSelect, colorInput);
        bind(sizeSelect, sizeInput);
        var selected = document.querySelector('[data-manual-preorder-selected]');
        function refresh() {
          applyCustomField(colorSelect, colorInput);
          applyCustomField(sizeSelect, sizeInput);
        }
        if (selected && window.MutationObserver) {
          new MutationObserver(refresh).observe(selected, { childList: true, subtree: true, attributes: true, attributeFilter: ['class'] });
        }
      }
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init);
      else init();
    }());
  </script>
