.inventory-tools [data-inventory-layer-filter] {
  position: absolute;
  width: 1px;
  height: 1px;
  opacity: 0;
  pointer-events: none;
}

.inventory-location-filter-chips {
  display: flex;
  gap: 8px;
  overflow-x: auto;
  padding: 2px 1px 4px;
  scrollbar-width: thin;
}

.inventory-location-filter-chip {
  flex: 0 0 auto;
  min-height: 42px;
  padding: 0 13px;
  border: 1px solid rgba(80,216,186,.44);
  border-radius: 10px;
  background: #17302d;
  color: #fff8ed;
  -webkit-text-fill-color: #fff8ed;
  font-weight: 950;
  cursor: pointer;
  white-space: nowrap;
}

.inventory-location-filter-chip.is-active {
  border-color: #58e6cd;
  background: #075d50;
  color: #ffffff;
  -webkit-text-fill-color: #ffffff;
  box-shadow: 0 0 0 3px rgba(80,216,186,.18);
}

.inventory-location-filter-chip:focus-visible {
  outline: 3px solid rgba(255, 209, 102, .78);
  outline-offset: 2px;
}

/* Compact inventory filters: frequent choices stay visible without horizontal dragging. */
.inventory-business-switch {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 10px;
  margin: 14px 0 10px;
  padding: 10px;
  border: 1px solid rgba(80, 216, 186, .3);
  border-radius: 9px;
  background: rgba(255, 255, 255, .035);
}

.inventory-business-switch button {
  min-height: 48px;
  border: 1px solid rgba(255, 255, 255, .22);
  border-radius: 8px;
  background: #27212a;
  color: #f8eee1 !important;
  -webkit-text-fill-color: #f8eee1 !important;
  font-size: 1rem;
  font-weight: 900;
  cursor: pointer;
  opacity: 1;
}

.inventory-business-switch button.is-active {
  border-color: #f4bd4d;
  background: #f4bd4d;
  color: #211719 !important;
  -webkit-text-fill-color: #211719 !important;
  box-shadow: 0 0 0 3px rgba(244, 189, 77, .18);
}

#inventory .inventory-business-select {
  display: none;
}

.inventory-department-badge {
  display: inline-flex !important;
  width: fit-content;
  margin-top: 5px;
  padding: 3px 8px;
  border-radius: 999px;
  font-size: .76rem;
  font-weight: 900;
}

