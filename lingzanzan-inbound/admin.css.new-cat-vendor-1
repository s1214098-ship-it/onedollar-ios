@media (max-width: 560px) {
  .freight-filed-photo-summary { grid-template-columns: 72px minmax(0, 1fr); padding: 10px; }
  .freight-filed-photo-summary > img,
  .freight-filed-photo-summary .freight-list-photo-thumb,
  .freight-filed-photo-summary .freight-list-photo-thumb img { width: 72px; height: 72px; }
  .freight-size-matrix { padding: 13px; }
  .freight-size-matrix-grid { grid-template-columns: 1fr 1fr; }
  .freight-size-matrix-cell { grid-template-columns: 1fr; }
  .freight-size-matrix-cell > b { text-align: left; }
  #freight .freight-quantity-stepper{grid-template-columns:52px minmax(74px,1fr) 52px}
