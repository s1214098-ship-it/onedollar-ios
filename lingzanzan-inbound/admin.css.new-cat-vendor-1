  color: #d7ccd4;
}
.freight-product-image-preview[data-image-size="small"],
.freight-color-image-preview[data-image-size="small"] { grid-template-columns: repeat(auto-fill, minmax(86px, 1fr)); gap: 8px; }
.freight-product-image-preview[data-image-size="medium"],
.freight-color-image-preview[data-image-size="medium"] { grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
.freight-product-image-preview[data-image-size="large"],
.freight-color-image-preview[data-image-size="large"] { grid-template-columns: repeat(auto-fill, minmax(270px, 1fr)); gap: 16px; }
.freight-product-image-preview > p,
.freight-color-image-preview > p { grid-column: 1 / -1; margin: 0; padding: 16px; border: 1px dashed rgba(255,255,255,.2); border-radius: 15px; color: #d8cedb; }
.freight-product-image-preview figure,
.freight-color-image-preview figure { display: grid; gap: 7px; margin: 0; padding: 9px; border: 1px solid rgba(255,255,255,.16); border-radius: 16px; background: rgba(13, 20, 25, .82); }
.freight-card-image-gallery figure { display: grid; gap: 4px; margin: 0; padding: 4px; width: 84px; border: 1px solid rgba(255,255,255,.16); border-radius: 12px; background: rgba(13, 20, 25, .82); }
.freight-product-image-preview img,
.freight-color-image-preview img { width: 100%; aspect-ratio: 1 / 1; object-fit: cover; border-radius: 11px; background: #201a22; }
.freight-card-image-gallery img { width: 72px; height: 72px; object-fit: cover; border-radius: 8px; background: #201a22; }
.freight-product-image-preview figcaption,
.freight-color-image-preview figcaption,
.freight-card-image-gallery figcaption { color: #fff; font-weight: 850; text-align: center; }
.freight-product-image-preview .danger-button,
.freight-color-image-preview .danger-button { width: 100%; min-height: 42px; }
.freight-product-image-preview [data-freight-product-image-use-color] { width: 100%; min-height: 42px; color: #10201e; background: #8de8dc; }
.freight-card-image-gallery { display: grid; gap: 10px; margin: 14px 0; padding: 14px; border: 1px solid rgba(111, 224, 209, .4); border-radius: 18px; background: rgba(12, 28, 31, .72); }
.freight-card-image-gallery > header { display: flex; justify-content: space-between; gap: 12px; color: #8de8dc; }
.freight-card-image-gallery figure.is-color { border-color: rgba(243, 202, 105, .62); }

.freight-card-variant-lines {
  display: grid;
  gap: 8px;
  margin: 14px 0;
  padding: 14px;
  border: 1px solid rgba(111, 224, 209, .4);
  border-radius: 18px;
  background: rgba(12, 28, 31, .72);
}

.freight-card-variant-lines header,
.freight-card-variant-lines > div {
  display: grid;
  grid-template-columns: minmax(220px, 1.5fr) auto minmax(190px, 1fr) auto;
  align-items: center;
  gap: 12px;
}

.freight-card-variant-lines header { grid-template-columns: 1fr auto; color: #8de8dc; }
.freight-card-variant-lines > div { padding-top: 8px; border-top: 1px solid rgba(255,255,255,.12); }
.freight-card-variant-lines code { color: #fff; overflow-wrap: anywhere; }
.freight-card-variant-lines strong { color: #8de8dc; }

.freight-inline-variant-editor {
  grid-column: 2;
  margin: 10px 0;
  border: 1px solid rgba(111, 224, 209, .48);
  border-radius: 18px;
  background: rgba(15, 38, 39, .74);
  overflow: hidden;
}

.freight-inline-variant-editor > summary {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  padding: 15px 17px;
  color: #fff;
  font-weight: 900;
  cursor: pointer;
}

.freight-inline-variant-editor > summary b { color: #8de8dc; }
.freight-inline-variant-rows { display: grid; gap: 10px; padding: 0 16px 12px; }
.freight-inline-variant-row {
  display: grid;
  grid-template-columns: minmax(160px, 1fr) minmax(140px, .8fr) 110px auto;
  align-items: end;
  gap: 10px;
  padding: 12px;
  border: 1px solid rgba(255,255,255,.13);
  border-radius: 14px;
  background: rgba(25, 22, 30, .78);
}
.freight-inline-variant-row label { display: grid; gap: 5px; color: #f5c65e; font-weight: 850; }
.freight-inline-variant-row input { width: 100%; min-width: 0; min-height: 46px; color: #fff; background: #3a323e; border: 1px solid #6d626f; border-radius: 11px; padding: 9px 11px; }
.freight-inline-variant-actions { display: flex; align-items: center; flex-wrap: wrap; gap: 10px; padding: 0 16px 16px; }
.freight-inline-variant-actions span { color: #cfc5d1; font-size: 14px; }

@media (max-width: 820px) {
  .freight-size-matrix > header,
  .freight-size-matrix > footer { align-items: stretch; flex-direction: column; }
  .freight-size-matrix-presets { display: grid; grid-template-columns: 1fr 1fr; justify-content: stretch; }
  .freight-size-matrix-presets button:last-child { grid-column: 1 / -1; }
  .freight-size-matrix > footer [data-freight-size-matrix-add] { width: 100%; }
  .freight-variant-workbench > header { align-items: stretch; flex-direction: column; }
  .freight-variant-row { grid-template-columns: 1fr; }
  .freight-variant-row .danger-button { width: 100%; }
  .freight-card-variant-lines > div { grid-template-columns: 1fr auto; }
  .freight-card-variant-lines > div code,
  .freight-card-variant-lines > div strong { grid-column: 1 / -1; }
  .freight-inline-variant-editor { grid-column: 1!important; }
  .freight-inline-variant-row { grid-template-columns: 1fr 1fr; }
  .freight-inline-variant-row .danger-button { width: 100%; }
