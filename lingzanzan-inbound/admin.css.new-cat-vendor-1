#inventory .inventory-tools {
  display: grid;
  grid-template-columns: minmax(280px, 1.6fr) minmax(300px, 1.35fr) auto minmax(150px, .7fr);
  align-items: end;
  gap: 8px;
  padding: 10px;
  border: 1px solid rgba(80, 216, 186, .22);
  border-radius: 8px;
  background: rgba(255, 255, 255, .025);
}

#inventory .inventory-tools > label,
#inventory .inventory-stock-filter {
  min-width: 0;
  padding: 7px 9px;
  border-radius: 6px;
}

#inventory .inventory-tools > label:has([data-inventory-search]) {
  grid-column: 1;
  grid-row: 1;
}

#inventory .inventory-tools > label:has([data-inventory-warehouse-filter]) {
  grid-column: 2;
  grid-row: 1;
}

#inventory .inventory-stock-filter {
  grid-column: 3;
  grid-row: 1;
}

#inventory .inventory-tools > label:has([data-inventory-price-sort]) {
  grid-column: 4;
  grid-row: 1;
}

.inventory-count-check-toolbar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-top: 10px;
  padding: 10px 12px;
  border: 1px solid rgba(80, 216, 186, .35);
  border-radius: 9px;
  background: rgba(20, 75, 68, .22);
}

.inventory-count-check-toolbar span {
  color: #d9fff6;
  font-size: .92rem;
  font-weight: 800;
}

.inventory-count-check-toolbar button {
  flex: 0 0 auto;
  min-height: 40px;
}

#inventory .inventory-location-filter-chips {
  display: flex;
  flex-wrap: wrap;
  gap: 5px;
  overflow: visible;
  padding: 0;
}

#inventory .inventory-location-filter-chip {
  flex: 0 0 auto;
  min-height: 34px;
  padding: 0 10px;
  border-radius: 6px;
  font-size: .9rem;
}

#inventory .inventory-stock-filter {
  grid-template-columns: repeat(2, minmax(90px, 1fr));
  gap: 5px;
  padding-top: 5px;
}

#inventory .inventory-stock-filter label {
  min-height: 36px;
  padding: 6px 8px !important;
  border-radius: 6px;
  white-space: nowrap;
}

#inventory .inventory-position-filter {
  grid-column: 1 / -1;
  grid-row: 2;
  min-width: 0;
  border-top: 1px solid rgba(255, 255, 255, .1);
  padding-top: 8px;
}

#inventory .inventory-position-filter summary {
  display: inline-flex;
  align-items: center;
  min-height: 36px;
  padding: 0 12px;
  border: 1px solid rgba(80, 216, 186, .44);
  border-radius: 6px;
  background: #17302d;
  color: #fff8ed;
  font-weight: 900;
  cursor: pointer;
  list-style: none;
}

#inventory .inventory-position-filter summary::-webkit-details-marker {
  display: none;
}

#inventory .inventory-position-filter summary::after {
  content: "+";
  margin-left: 8px;
  color: #58e6cd;
  font-size: 1.1rem;
}

#inventory .inventory-position-filter[open] summary::after {
  content: "-";
}

#inventory .inventory-position-filter-body {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));
  gap: 8px;
  margin-top: 8px;
}

#inventory .inventory-position-filter-body > label {
  min-width: 0;
  padding: 8px;
  border-radius: 6px;
}

@media (max-width: 1050px) {
  #inventory .inventory-tools {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  #inventory .inventory-tools > label:has([data-inventory-search]),
  #inventory .inventory-tools > label:has([data-inventory-warehouse-filter]),
  #inventory .inventory-stock-filter,
  #inventory .inventory-tools > label:has([data-inventory-price-sort]),
  #inventory .inventory-position-filter {
    grid-column: auto;
    grid-row: auto;
  }

  #inventory .inventory-position-filter {
    grid-column: 1 / -1;
  }
}

@media (max-width: 620px) {
  .inventory-business-switch {
    grid-template-columns: 1fr;
  }

  #inventory .inventory-tools {
    grid-template-columns: 1fr;
    padding: 8px;
  }

  #inventory .inventory-tools > label,
  #inventory .inventory-stock-filter,
  #inventory .inventory-position-filter {
    grid-column: 1;
    grid-row: auto;
  }

  #inventory .inventory-position-filter-body {
    grid-template-columns: 1fr;
  }

  #inventory .inventory-location-filter-chip {
    min-height: 32px;
    padding: 0 9px;
    font-size: .84rem;
  }

  .inventory-count-check-toolbar {
    align-items: stretch;
    flex-direction: column;
  }
}

@media (max-width: 1100px) {
  .member-tools:has([data-product-price-sort]) {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 640px) {
  .member-tools:has([data-product-price-sort]) {
    grid-template-columns: 1fr;
  }
}

/* Manager-only preorder product image review. This never changes stock by itself. */
