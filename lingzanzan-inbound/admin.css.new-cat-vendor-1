}
#freight .freight-key-facts .is-product .freight-list-photo-thumb {
  width: 54px;
}
#freight .freight-key-facts .is-product .freight-list-photo-thumb img {
  width: 54px;
  height: 54px;
}
#freight .freight-key-facts .is-product .freight-list-photo-thumb span {
  display: none;
}
#freight .freight-product-name-thumb {
  display: block;
