  font-weight: 950;
  border: 1px solid #cbd5e1!important;
  background: #ffffff!important;
  color: #0f172a!important;
}
.freight-size-matrix > footer [data-freight-size-matrix-add] {
  min-height: 50px;
  white-space: nowrap;
  border-color: #0f766e;
  background: #0f766e;
  color: #ffffff;
}

.freight-variant-workbench > header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 18px;
}

.freight-variant-workbench > header [data-freight-variant-add] {
