  justify-content: space-between;
  gap: 18px;
}

.freight-product-image-editor > header div { display: grid; gap: 6px; }
.freight-product-image-editor > header b { color: #8de8dc; font-size: 1.08rem; }
.freight-product-image-editor > header small { color: #e8dfeb; line-height: 1.55; }
.freight-product-image-editor > header strong { color: #f3ca69; white-space: nowrap; }
.freight-product-image-actions,
.freight-color-image-picker { display: flex; align-items: end; flex-wrap: wrap; gap: 12px; }
.freight-color-image-picker > label:first-child { display: grid; gap: 7px; min-width: min(320px, 100%); color: #f3ca69; font-weight: 850; }
