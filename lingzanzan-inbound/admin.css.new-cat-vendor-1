  width: 72px;
  height: 72px;
}
.freight-filed-photo-summary > div { display: grid; gap: 5px; min-width: 0; }
.freight-filed-photo-summary > div b { color: #ffe09a; font-size: 18px; }
.freight-filed-photo-summary > div span { color: #eee5eb; line-height: 1.5; }
.freight-filed-photo-summary > details { grid-column: 1 / -1; }
.freight-filed-photo-summary > details > summary {
  min-height: 44px;
  padding: 11px 14px;
  border: 1px solid rgba(245, 198, 95, .42);
  border-radius: 11px;
