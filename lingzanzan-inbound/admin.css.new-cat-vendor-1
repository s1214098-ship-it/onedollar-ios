.freight-product-image-preview,
.freight-color-image-preview { display: grid; grid-template-columns: repeat(auto-fill, minmax(130px, 1fr)); gap: 12px; }
.freight-card-image-gallery > div { display: grid; grid-template-columns: repeat(auto-fill, 72px); gap: 10px; }
.freight-filed-photo-summary {
