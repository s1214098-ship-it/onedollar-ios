/* Preorder warehouse: two clear supply sources, keyed by official barcode. */
.preorder-supply-summary {
  margin: 14px 0;
  padding: 16px;
  border: 1px solid rgba(105, 220, 202, .55);
  border-radius: 18px;
  background: rgba(20, 42, 43, .72);
}
.preorder-supply-summary > header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  margin-bottom: 12px;
}
.preorder-supply-summary > header div { display: grid; gap: 2px; }
.preorder-supply-summary > header small { color: #75ddcf; letter-spacing: .08em; }
.preorder-supply-summary > header b { color: #fff8ee; font-size: 1.2rem; }
.preorder-supply-summary > p {
  display: grid;
  grid-template-columns: minmax(170px, .7fr) 1.3fr;
  gap: 12px;
  margin: 7px 0;
  padding: 10px 12px;
  border-radius: 12px;
  background: rgba(255,255,255,.055);
}
.preorder-supply-summary > p strong { color: #f2c761; }
.preorder-supply-summary > p span { color: #e8dfe8; }
.preorder-supply-lines { display: grid; gap: 7px; margin-top: 10px; }
.manual-preorder-freight-badge {
  display: inline-flex;
  align-items: center;
  padding: 6px 10px;
  border: 1px solid #57dfcd;
  border-radius: 999px;
  background: #17342f;
  color: #8ff5df;
  font-size: 13px;
  font-weight: 900;
  white-space: nowrap;
}
.manual-preorder-stock-demand {
  display: grid;
  grid-template-columns: repeat(7, minmax(0, 1fr));
  gap: 6px;
  width: 100%;
}
.manual-preorder-stock-cell {
  display: grid;
  gap: 2px;
  min-width: 0;
  padding: 8px 6px;
  border: 1px solid #4a5f5a;
  border-radius: 10px;
  background: #141c1b;
  text-align: center;
}
