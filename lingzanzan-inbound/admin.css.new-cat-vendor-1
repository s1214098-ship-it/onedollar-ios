  border-color: #57dfcd;
  background: #163430;
}
.manual-preorder-stock-cell.is-demand {
  border-color: #f0be50;
  background: #3a2f18;
}
.manual-preorder-stock-cell.is-demand b {
  color: #ffe49c;
}
.manual-preorder-stock-cell.is-ok {
  border-color: #57dfcd;
  background: #163430;
}
.manual-preorder-stock-cell.is-ok b,
.manual-preorder-stock-cell.is-open b {
  color: #8ff5df;
  font-size: 18px;
}
.manual-preorder-stock-cell.is-short {
  border-color: #dc6670;
  background: #3a2025;
}
.manual-preorder-stock-cell.is-short b {
  color: #ff9ba4;
}
.manual-preorder-size-choice .manual-preorder-stock-cell b,
.manual-preorder-color-head .manual-preorder-stock-cell b {
  font-size: 18px;
}
.manual-preorder-size-choice .manual-preorder-stock-demand,
.manual-preorder-color-head .manual-preorder-stock-demand {
  margin-top: 8px;
}
.manual-preorder-size-select em {
  white-space: normal;
}
@media (max-width: 860px) {
  .manual-preorder-stock-demand {
    grid-template-columns: repeat(4, minmax(0, 1fr));
