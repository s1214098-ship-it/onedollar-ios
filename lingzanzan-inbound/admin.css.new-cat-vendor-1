.preorder-image-review-dialog[hidden] { display: none; }
.preorder-image-review-panel { position: relative; width: min(880px, 100%); max-height: min(780px, 92vh); overflow: auto; padding: 24px; border: 1px solid #5c856f; border-radius: 12px; background: #1d2427; color: #fff8ed; box-shadow: 0 24px 64px rgba(0, 0, 0, .48); }
.preorder-image-review-panel h3 { margin: 0 36px 8px 0; color: #ffd166; }
.preorder-image-review-panel > p { margin: 0 0 16px; color: #d7e2df; line-height: 1.55; }
.preorder-image-review-panel label { display: grid; gap: 6px; font-weight: 700; color: #ffd166; }
.preorder-image-review-panel input { min-height: 42px; padding: 8px 10px; border: 1px solid #617073; border-radius: 7px; background: #293337; color: #fff; }
.preorder-image-review-close { position: absolute; top: 12px; right: 12px; width: 34px; height: 34px; border: 1px solid #b89349; border-radius: 50%; background: #34251c; color: #fff8ed; font-size: 22px; line-height: 1; }
.preorder-image-review-source { display: flex; gap: 12px; align-items: center; margin: 14px 0; padding: 10px; border: 1px solid #c8953a; border-radius: 9px; background: #2e2920; }
.preorder-image-review-source img { width: 84px; height: 84px; flex: 0 0 84px; object-fit: cover; border-radius: 7px; background: #111; }
.preorder-image-review-source b, .preorder-image-review-source span, .preorder-image-review-source small { display: block; }
.preorder-image-review-source b { color: #ffd166; } .preorder-image-review-source small { color: #d7e2df; }
.preorder-image-review-results { display: grid; gap: 8px; margin-top: 14px; }
.preorder-image-review-results article { display: grid; grid-template-columns: 58px minmax(0, 1fr) auto; gap: 10px; align-items: center; padding: 8px; border: 1px solid #4f6062; border-radius: 8px; background: #253035; }
.preorder-image-review-results img { width: 58px; height: 58px; object-fit: cover; border-radius: 6px; background: #111; }
.preorder-image-review-results b, .preorder-image-review-results span, .preorder-image-review-results small { display: block; }
.preorder-image-review-results b { color: #fff8ed; } .preorder-image-review-results small { color: #a9c4be; }
.preorder-image-review-results button { min-height: 36px; padding: 7px 10px; border: 1px solid #f0bd4f; border-radius: 7px; background: #f0bd4f; color: #1d1a16; font-weight: 800; }
.preorder-image-review-empty { padding: 12px; border: 1px dashed #667b79; color: #d7e2df; }
@media (max-width: 640px) { .preorder-image-review-dialog { padding: 10px; } .preorder-image-review-panel { padding: 18px 14px; } .preorder-image-review-results article { grid-template-columns: 48px minmax(0, 1fr); } .preorder-image-review-results button { grid-column: 1 / -1; width: 100%; } }

/* Keep image-recognition matches compact and clickable instead of rendering source-sized photos. */
.product-similar-panel {
  display: grid;
  gap: 10px;
  margin-top: 12px;
  padding: 12px;
  border: 1px solid rgba(92, 204, 155, .34);
  border-radius: 14px;
  background: rgba(19, 82, 63, .12);
}
.product-similar-panel[hidden] { display: none !important; }
.product-similar-head { display: flex; flex-wrap: wrap; justify-content: space-between; gap: 6px 12px; }
