/* Freight: one tracking number may contain multiple category/color/size rows. */
.freight-variant-workbench {
  border: 1px solid #b8d8d3;
  border-radius: 24px;
  padding: 20px;
  background: #f6faf9;
}

.freight-size-matrix {
  display: grid;
  gap: 14px;
  padding: 18px;
