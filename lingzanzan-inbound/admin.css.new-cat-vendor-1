.product-similar-list article span { color: rgba(255,248,237,.78); font-size: 12px; }
.product-similar-list article small { color: #f4c65a; font-size: 11px; }
.product-similar-list article button { grid-column: 1 / -1; width: 100%; min-height: 32px; padding: 6px 8px; border: 1px solid #f0bd4f; border-radius: 8px; background: #f0bd4f; color: #1d1a16; font-weight: 800; }
.product-image-recognition-gate { display: grid; gap: 8px; }
