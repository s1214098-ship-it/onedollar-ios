/* Three provider worklines keep self pickup, Pinduoduo and HaoHong separate. */
.freight-workline-board {
  margin: 18px 0 24px;
  padding: 18px;
  border: 1px solid rgba(255, 255, 255, .14);
  border-radius: 22px;
  background: linear-gradient(145deg, rgba(27, 23, 31, .98), rgba(14, 20, 24, .98));
  box-shadow: 0 16px 44px rgba(0, 0, 0, .28);
}
.freight-workline-board > header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18px;
  margin-bottom: 14px;
}
.freight-workline-board > header p { margin: 0; color: #78dfd2; font-size: .76rem; font-weight: 900; letter-spacing: .12em; }
.freight-workline-board > header h3 { margin: 4px 0; color: #fff; font-size: 1.32rem; }
.freight-workline-board > header span { color: #c8c0c9; line-height: 1.55; }
.freight-workline-board > header > strong {
  flex: 0 0 auto;
  padding: 10px 14px;
  border-radius: 999px;
  color: #102423;
  background: #84e4d7;
  font-size: .92rem;
}
.freight-workline-list { display: grid; gap: 10px; }
.freight-workline-row {
  --workline-accent: #6fded0;
  display: grid;
  grid-template-columns: 52px minmax(290px, 1.15fr) minmax(420px, 1.8fr) 122px;
  align-items: center;
  gap: 14px;
  width: 100%;
  min-height: 78px;
  padding: 12px 14px;
  border: 1px solid rgba(255, 255, 255, .13);
  border-left: 7px solid var(--workline-accent);
  border-radius: 16px;
  color: #f4eff3;
  background: rgba(35, 29, 39, .88);
  text-align: left;
  cursor: pointer;
  transition: border-color .16s ease, background .16s ease, transform .16s ease;
}
.freight-workline-row.is-pickup { --workline-accent: #f1bd5c; }
.freight-workline-row.is-pinduoduo { --workline-accent: #70ded0; }
.freight-workline-row.is-haohong { --workline-accent: #76aef7; }
.freight-workline-row:hover,
.freight-workline-row:focus-visible { border-color: var(--workline-accent); transform: translateX(3px); outline: none; }
.freight-workline-row.is-active {
  border-color: var(--workline-accent);
  background: linear-gradient(90deg, color-mix(in srgb, var(--workline-accent) 17%, #201a24), #171c21 62%);
  box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--workline-accent) 45%, transparent), 0 10px 28px rgba(0, 0, 0, .25);
}
.freight-workline-number {
  display: grid;
  place-items: center;
  width: 46px;
  height: 46px;
  border-radius: 13px;
  color: #11191b;
  background: var(--workline-accent);
  font-weight: 950;
}
.freight-workline-route { display: grid; gap: 4px; min-width: 0; }
.freight-workline-route b { color: #fff; font-size: 1.12rem; }
.freight-workline-route small { color: #c9c1ca; line-height: 1.4; }
.freight-workline-metrics {
  padding: 10px 13px;
  border-radius: 12px;
  color: #f2edf1;
  background: rgba(6, 10, 13, .48);
  font-size: .91rem;
  font-weight: 850;
  line-height: 1.45;
}
.freight-workline-open { justify-self: end; color: var(--workline-accent); font-weight: 950; }
.freight-workline-row.is-active .freight-workline-open { padding: 8px 11px; border-radius: 999px; color: #11191b; background: var(--workline-accent); }
.freight-workline-help {
  margin: 12px 0 0;
  padding: 11px 14px;
  border-radius: 12px;
  color: #d8d1d8;
  background: rgba(255, 255, 255, .045);
  line-height: 1.55;
}
.freight-workline-self_pickup #freight .freight-haohong-sync-panel,
.freight-workline-self_pickup #freight [data-preorder-freight-balance],
.freight-workline-haohong #freight .freight-import-panel,
.freight-workline-self_pickup #freight .freight-import-panel,
.freight-workline-pinduoduo #freight .freight-haohong-sync-panel { display: none !important; }

@media (max-width: 1280px) {
  .freight-workline-row { grid-template-columns: 48px minmax(240px, 1fr) minmax(320px, 1.4fr); }
  .freight-workline-open { grid-column: 2 / -1; justify-self: start; }
}
@media (max-width: 760px) {
  .freight-workline-board { padding: 12px; border-radius: 18px; }
  .freight-workline-board > header { display: grid; }
  .freight-workline-board > header > strong { justify-self: start; }
  .freight-workline-row { grid-template-columns: 44px minmax(0, 1fr); gap: 10px; min-height: 0; padding: 12px; }
  .freight-workline-number { width: 40px; height: 40px; }
  .freight-workline-route { align-self: center; }
  .freight-workline-metrics,
  .freight-workline-open { grid-column: 1 / -1; justify-self: stretch; }
  .freight-workline-open { text-align: center; }
}
