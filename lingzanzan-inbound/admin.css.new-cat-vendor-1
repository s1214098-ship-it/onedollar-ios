:root {
  color-scheme: dark;
  --bg: #110d12;
  --panel: #1b151d;
  --panel-2: #241b27;
  --ink: #fff8ed;
  --muted: #b8aab2;
  --line: rgba(255, 248, 237, .14);
  --gold: #e8b75b;
  --rose: #e05c7e;
  --danger: #ef4b4b;
  --teal: #35c2ae;
}

/* Codex 20260801 local356: administrative shipping clipboard image controls. */
.admin-shipment-customer-photo:focus{outline:3px solid rgba(73,221,194,.32);outline-offset:4px}
.admin-shipment-customer-photo.is-dragging{border-radius:16px;box-shadow:0 0 0 3px #49ddc2}
.admin-shipment-customer-photo-actions{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.admin-shipment-customer-photo-actions button{min-height:42px;padding:8px 10px}
.admin-shipment-customer-photo>small{color:#d8cbd6;line-height:1.5}

/* 本機160｜物流單逐筆到貨、整批到齊提示與三日追貨 */
.freight-arrival-all-complete{display:grid;gap:4px;padding:14px 16px;border:2px solid #2aa982;border-radius:14px;background:#dff8ef;color:#124d3b}
.freight-receiving-row{grid-template-columns:34px minmax(220px,1fr) minmax(150px,210px) minmax(110px,auto)!important}
.freight-arrival-row-qty{display:flex;align-items:center;gap:5px;color:#f1c561;font-weight:800}
.freight-arrival-row-qty b{font-size:18px;color:#fff}
.freight-arrival-all-complete b{font-size:18px;color:#0f6047}
.freight-arrival-actions [data-freight-arrival-finish].is-all-arrived{background:#18a279!important;border-color:#0c6c50!important;color:#fff!important;-webkit-text-fill-color:#fff!important;box-shadow:0 0 0 4px rgba(24,162,121,.16)}
.freight-arrival-status-modal>section{width:min(760px,100%)}
.freight-arrival-status-modal.is-complete>section{border-top:8px solid #27a47e}
.freight-arrival-status-modal.is-missing>section{border-top:8px solid #d65d65}
.freight-arrival-status-modal.is-next>section{border-top:8px solid #d9a62e}
.freight-arrival-status-modal.is-next>section{
  background:#1b151d!important;
  color:#fff8ed!important;
  border:1px solid rgba(232,183,91,.72)!important;
  border-top:8px solid #d9a62e!important;
}
.freight-arrival-status-modal.is-next>section>header{
  border-bottom-color:rgba(255,248,237,.16)!important;
}
.freight-arrival-status-modal.is-next>section>header small,
.freight-arrival-status-modal.is-next>section>header h3,
.freight-arrival-status-modal.is-next>section>header p,
.freight-arrival-status-modal.is-next .freight-arrival-next-list li b,
.freight-arrival-status-modal.is-next .freight-arrival-next-list li small{
  color:#fff8ed!important;
  -webkit-text-fill-color:#fff8ed!important;
}
.freight-arrival-status-modal.is-next .freight-arrival-next-list li{
  border-color:rgba(232,183,91,.35)!important;
  background:#241b27!important;
  color:#fff8ed!important;
}
.freight-arrival-status-modal.is-next .freight-arrival-complete-steps{
  background:#17372f!important;
  color:#effff9!important;
}
.freight-arrival-status-modal.is-next .freight-arrival-complete-steps b,
.freight-arrival-status-modal.is-next .freight-arrival-complete-steps span{
  color:#effff9!important;
  -webkit-text-fill-color:#effff9!important;
}
.freight-arrival-status-modal.is-next .freight-arrival-complete-steps span{
  border-color:#397d69!important;
  background:#21483e!important;
}
.freight-arrival-status-modal.is-next .freight-arrival-reminder-rule{
  border-left-color:#e05c7e!important;
  background:#3a2029!important;
  color:#ffdce4!important;
  -webkit-text-fill-color:#ffdce4!important;
}
.freight-arrival-status-modal.is-next .freight-arrival-reminder-rule b{
  color:#fff2f5!important;
  -webkit-text-fill-color:#fff2f5!important;
}
.freight-arrival-status-modal.is-next .ghost-button,
.freight-arrival-status-modal.is-next [data-freight-arrival-status-close]{
  border:1px solid #8a788d!important;
  background:#302634!important;
  color:#fff8ed!important;
  -webkit-text-fill-color:#fff8ed!important;
  opacity:1!important;
}
.freight-arrival-status-modal.is-next [data-freight-arrival-item-receive],
.freight-arrival-status-modal.is-next [data-freight-batch-next-receive],
.freight-arrival-status-modal.is-next [data-freight-arrival-finish]{
  border:2px solid #b7831e!important;
  background:#e8b75b!important;
  color:#21150d!important;
  -webkit-text-fill-color:#21150d!important;
  opacity:1!important;
  font-weight:900!important;
}
.freight-arrival-complete-steps{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:9px;margin:16px 0;padding:14px;border-radius:14px;background:#edf9f4;color:#174d3c}
.freight-arrival-complete-steps b{grid-column:1/-1;font-size:18px}
.freight-arrival-complete-steps span{padding:10px;border:1px solid #9dcdbd;border-radius:9px;background:#fff}
.freight-arrival-missing-list,.freight-arrival-next-list,.freight-arrival-overdue-reminders ul{display:grid;gap:8px;margin:14px 0;padding:0;list-style:none}
.freight-arrival-missing-list li,.freight-arrival-next-list li,.freight-arrival-overdue-reminders li{display:grid;grid-template-columns:minmax(130px,.8fr) minmax(160px,1fr) auto;gap:9px;align-items:center;padding:11px;border:1px solid #e0c9cc;border-radius:10px;background:#fff}
.freight-arrival-missing-list strong{color:#a72f3b}
.freight-arrival-reminder-rule{padding:13px;border-left:4px solid #d65d65;background:#fff0f1;color:#74242b}
.freight-arrival-next-list li{grid-template-columns:auto minmax(0,1fr) auto}
.freight-arrival-next-list em{display:grid;place-items:center;width:30px;height:30px;border-radius:50%;background:#f0c24c;color:#332300;font-style:normal;font-weight:900}
.freight-arrival-next-list span{display:grid;gap:3px}
.freight-arrival-next-list strong{color:#17654f}
.freight-arrival-overdue-reminders{display:grid;gap:12px;margin:16px 0;padding:18px;border:3px solid #d65d65;border-radius:18px;background:#fff0f1;color:#522027}
.freight-arrival-overdue-reminders[hidden]{display:none!important}
.freight-arrival-overdue-reminders>header{display:flex;justify-content:space-between;gap:14px;align-items:flex-start;cursor:pointer}
.freight-arrival-overdue-reminders>header h3{margin:3px 0;color:#8b2630}
.freight-arrival-overdue-reminders>header p{margin:0}
.freight-arrival-overdue-reminders>header>strong{padding:8px 12px;border-radius:999px;background:#a72f3b;color:#fff;white-space:nowrap}
.freight-arrival-overdue-reminders>header .ghost-button{flex:0 0 auto;align-self:center;border-color:#d8aeb2;color:#8b2630;background:#fff}
.freight-arrival-overdue-body{display:grid;gap:12px}
.freight-arrival-overdue-body[hidden]{display:none!important}
.freight-arrival-overdue-reminders article{display:grid;gap:8px;padding:14px;border:1px solid #d8aeb2;border-radius:12px;background:#fff}
.freight-arrival-overdue-reminders article>div{display:flex;justify-content:space-between;gap:12px}
.freight-arrival-overdue-reminders.is-collapsed{padding:10px 14px;gap:0}
.freight-arrival-overdue-reminders.is-collapsed>header{align-items:center}
.freight-arrival-overdue-reminders.is-collapsed>header h3{margin:0;font-size:16px}

@media(max-width:760px){
  .freight-arrival-complete-steps{grid-template-columns:1fr}
  .freight-arrival-complete-steps b{grid-column:auto}
  .freight-arrival-missing-list li,.freight-arrival-next-list li,.freight-arrival-overdue-reminders li{grid-template-columns:1fr}
  .freight-arrival-next-list em{display:none}
  .freight-arrival-overdue-reminders>header,.freight-arrival-overdue-reminders article>div{display:grid}
  .freight-receiving-row{grid-template-columns:30px minmax(0,1fr)!important}
  .freight-arrival-row-qty,.freight-receiving-row>strong{grid-column:2;width:100%}
}

/* LZ_FREIGHT_RECV_CHIP_20260924: 左上角小按鈕分辨有無驗收入庫，不再用雙語大卡。 */
#freight .freight-item-card{position:relative}
#freight .freight-item-card>.freight-recv-status-chip,
#freight .freight-batch-package-row>.freight-recv-status-chip{
  grid-column:1/-1;
  justify-self:start;
  z-index:2
}
.freight-recv-status-chip{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  min-height:28px;
  margin:0 0 6px;
  padding:4px 11px;
  border:0;
  border-radius:999px;
  font-size:12px;
  font-weight:950;
  letter-spacing:.02em;
  line-height:1;
  cursor:pointer
}
.freight-recv-status-chip.is-received{
  color:#08241c;
  background:#6ee7c1
}
.freight-recv-status-chip.is-pending{
  color:#251607;
  background:#f2b84b
}
.freight-recv-status-chip[disabled]{
  cursor:default;
  opacity:1
}
#freight .freight-item-card.is-product-filed{
  padding-top:16px!important;
  transition:border-color .2s ease,background .2s ease,box-shadow .2s ease
}
#freight .freight-item-card.is-product-filed::before{content:none!important;display:none!important}
#freight .freight-item-card.is-product-filed.is-awaiting-inventory,
#freight .freight-item-card.is-product-filed.is-stocked-inventory{
  border-color:#514956!important;
  background:#211c24!important
}
#freight .freight-item-card.is-recv-pending{box-shadow:inset 6px 0 0 #f2b84b}
#freight .freight-item-card.is-recv-received{box-shadow:inset 6px 0 0 #52d6af}
.freight-stock-state-legend{display:none!important}

.freight-stage-waiting #freight .freight-product-filed-history,
.freight-view-entry #freight .freight-product-filed-history{
  display:none!important
}

