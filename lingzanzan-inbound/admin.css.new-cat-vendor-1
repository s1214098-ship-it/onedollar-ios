.freight-size-matrix-cell > b { min-width: 34px; color: #334155; font-size: 16px; text-align: center; }
.freight-size-matrix-cell > span { display: grid; grid-template-columns: 34px minmax(42px, 1fr) 34px; gap: 4px; }
.freight-size-matrix-cell button {
  display: grid;
  place-items: center;
  min-width: 34px;
  min-height: 38px;
  padding: 0;
  border: 1px solid #94a3b8;
