/* 20260716: prevent the freight cost framework from overlapping form inputs. */
#freight .freight-grid{
  grid-template-columns:minmax(0,1fr)!important;
  width:100%;
  min-width:0;
}
#freight [data-freight-item-form],
#freight [data-freight-batch-form]{
  width:100%;
  min-width:0;
  max-width:100%;
  box-sizing:border-box;
  overflow:visible;
}
#freight [data-freight-item-form]{
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
}
#freight [data-freight-batch-form]{
  grid-template-columns:repeat(3,minmax(0,1fr))!important;
}
#freight [data-freight-item-form]>* ,
#freight [data-freight-batch-form]>*{
  min-width:0;
  max-width:100%;
  box-sizing:border-box;
}
#freight [data-freight-item-form]>label,
#freight [data-freight-batch-form]>label{
  align-content:start;
}
#freight [data-freight-item-form] input,
#freight [data-freight-item-form] select,
#freight [data-freight-item-form] textarea,
#freight [data-freight-batch-form] input,
#freight [data-freight-batch-form] select,
#freight [data-freight-batch-form] textarea{
  width:100%;
  min-width:0;
  max-width:100%;
  box-sizing:border-box;
}
#freight [data-freight-item-form]>.freight-auto-cost{
  grid-column:1/-1!important;
  width:100%;
  min-width:0;
  max-width:100%;
  box-sizing:border-box;
  overflow-wrap:anywhere;
}
#freight [data-freight-item-form].is-internal-use .freight-customer-link-grid{
  opacity:.42;
  pointer-events:none;
}
#freight [data-freight-item-form].is-internal-use [data-freight-sale-price]{
