.quick-stock-review-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16px;
}

.quick-stock-review-head p,
.quick-stock-review-head h3,
.quick-stock-review-head span { margin: 0; }
.quick-stock-review-head p { color: #69dfd0; font-weight: 900; letter-spacing: .08em; }
.quick-stock-review-head h3 { margin-top: 4px; color: #fff8ed; }
.quick-stock-review-head span { display: block; margin-top: 6px; color: rgba(255, 248, 237, .72); }
.quick-stock-review-head strong {
