.freight-size-matrix > header b { color: #134e4a; font-size: 18px; }
.freight-size-matrix > header small,
.freight-size-matrix > footer span { color: #475569; line-height: 1.5; }
.freight-size-matrix-presets { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: 7px; }
.freight-size-matrix-presets button {
  min-height: 42px;
  padding: 8px 12px;
  border: 1px solid #cbd5e1;
  border-radius: 11px;
  background: #ffffff;
  color: #334155;
  font-weight: 900;
}
.freight-size-matrix-presets button.is-active {
