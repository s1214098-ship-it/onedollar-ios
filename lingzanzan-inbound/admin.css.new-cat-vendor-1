.allocation-source-row {
  display: grid;
  gap: 6px;
  padding: 9px 11px;
  border: 1px solid #d8d1c8;
  border-radius: 10px;
  background: #fff;
}

.allocation-source-orders summary {
  cursor: pointer;
  color: #765313;
  font-weight: 800;
}

.allocation-source-orders span {
  display: flex;
