.freight-pagination {
  display: grid;
  grid-template-columns: auto auto 1fr auto;
  align-items: center;
  gap: 10px;
  margin: 14px 0 22px;
  padding: 12px;
  border: 1px solid rgba(111, 224, 209, .32);
  border-radius: 16px;
  background: rgba(17, 29, 33, .78);
}

/* The whole consolidation batch is one compact button until an operator opens it. */
.freight-batch-card-collapse {
  padding: 0 !important;
  overflow: hidden;
}

.freight-batch-card-collapse > .freight-batch-card-summary {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18px;
  min-height: 78px;
  padding: 14px 16px;
  color: #f7fbfa;
  background:
    linear-gradient(135deg, rgba(39, 87, 84, .98), rgba(18, 46, 49, .98));
  cursor: pointer;
  list-style: none;
  transition: background .18s ease, box-shadow .18s ease;
}

.freight-batch-card-collapse > .freight-batch-card-summary::-webkit-details-marker { display: none; }
.freight-batch-card-collapse > .freight-batch-card-summary:hover,
.freight-batch-card-collapse > .freight-batch-card-summary:focus-visible {
  background:
    linear-gradient(135deg, rgba(55, 112, 107, .99), rgba(25, 61, 64, .99));
  box-shadow: inset 0 0 0 2px rgba(141, 232, 220, .72);
  outline: none;
}
.freight-batch-card-summary .freight-batch-heading {
  flex: 1 1 auto;
  min-width: 0;
  margin: 0;
}
.freight-batch-card-summary-status {
  display: grid;
  flex: 0 0 auto;
  justify-items: end;
  gap: 6px;
  min-width: 250px;
}
.freight-batch-card-summary-status small {
  color: #d9f8f3;
  font-weight: 800;
  text-align: right;
}
.freight-batch-card-summary-status .is-closed,
.freight-batch-card-summary-status .is-open {
  min-width: 132px;
  padding: 8px 13px;
  border: 1px solid rgba(255, 255, 255, .52);
  border-radius: 999px;
  color: #102223;
  background: #8de8dc;
  font-weight: 950;
  text-align: center;
}
.freight-batch-card-summary-status .is-open { display: none; }
.freight-batch-card-collapse[open] > .freight-batch-card-summary .is-open { display: inline-block; }
.freight-batch-card-collapse[open] > .freight-batch-card-summary .is-closed { display: none; }
.freight-batch-card-collapse[open] > .freight-batch-card-summary {
  border-bottom: 1px solid rgba(141, 232, 220, .34);
}
.freight-batch-card-collapse.has-missing-items > .freight-batch-card-summary {
  box-shadow: inset 5px 0 0 #ff7474;
}
.freight-batch-card-body {
  padding: 0 16px 16px;
  background: rgba(7, 18, 22, .34);
}
.freight-batch-card-body > .freight-batch-collapse-body { padding: 14px 0 0; }

.freight-batch-missing-alert {
  display: flex;
  flex-wrap: wrap;
  gap: 6px 12px;
  margin: 12px 0 0;
  padding: 10px 12px;
  border: 1px solid #ff6b6b;
  border-radius: 12px;
  color: #ffd7d7;
  background: rgba(154, 26, 36, .28);
