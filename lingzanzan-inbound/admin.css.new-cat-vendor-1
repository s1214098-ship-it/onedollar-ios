  #freight .freight-variant-quantity-stepper button{width:46px;min-width:46px}
  .freight-inline-variant-row { grid-template-columns: 1fr; }
  .freight-inline-variant-actions > button { width: 100%; }
  .image-view-size-switch > span,
  .image-view-size-switch > small { flex-basis: 100%; text-align: left; }
  .freight-product-image-preview[data-image-size="large"],
  .freight-color-image-preview[data-image-size="large"] { grid-template-columns: minmax(0, 1fr); }
}
