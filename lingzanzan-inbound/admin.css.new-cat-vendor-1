   input,select{color:#fff8ed!important;background-color:rgba(255,248,237,.08)!important}
   蓋掉淺底設定，但 strip 的 -webkit-text-fill-color:#241820 仍生效，
   造成深色字畫在近透明深底上。此層用 !important 把字色與底一次對齊。 */

/* Non-strip shortcut (dark admin card): light text on solid dark fills. */
.freight-same-color-shortcut select,
.freight-same-color-shortcut input[type="number"],
.freight-same-color-shortcut input[type="text"],
.freight-inline-variant-row select,
.freight-inline-variant-row input[type="number"],
.freight-inline-variant-row input[type="text"] {
  color: #fff8ed !important;
  -webkit-text-fill-color: #fff8ed !important;
  background: #2b222c !important;
  background-color: #2b222c !important;
  border-color: #8a788d !important;
  color-scheme: dark !important;
  caret-color: #fff8ed !important;
  opacity: 1 !important;
}

.freight-same-color-shortcut select:hover,
.freight-same-color-shortcut input[type="number"]:hover,
.freight-same-color-shortcut input[type="text"]:hover,
.freight-inline-variant-row select:hover,
.freight-inline-variant-row input[type="number"]:hover,
.freight-inline-variant-row input[type="text"]:hover {
  border-color: #f4c65a !important;
  background: #362b38 !important;
  background-color: #362b38 !important;
  color: #fff8ed !important;
  -webkit-text-fill-color: #fff8ed !important;
}

.freight-same-color-shortcut select:focus,
.freight-same-color-shortcut input[type="number"]:focus,
.freight-same-color-shortcut input[type="text"]:focus,
.freight-inline-variant-row select:focus,
.freight-inline-variant-row input[type="number"]:focus,
.freight-inline-variant-row input[type="text"]:focus {
  outline: 2px solid #f4c65a;
  outline-offset: 1px;
  border-color: #f4c65a !important;
  background: #2b222c !important;
  background-color: #2b222c !important;
  color: #fff8ed !important;
  -webkit-text-fill-color: #fff8ed !important;
}

.freight-same-color-shortcut select:disabled,
.freight-same-color-shortcut input:disabled,
.freight-inline-variant-row select:disabled,
.freight-inline-variant-row input:disabled {
  color: #c9bdc6 !important;
  -webkit-text-fill-color: #c9bdc6 !important;
  background: #221c24 !important;
  background-color: #221c24 !important;
  opacity: 1 !important;
}

.freight-same-color-shortcut select option,
.freight-same-color-shortcut select option:checked,
.freight-same-color-shortcut select option:hover,
.freight-inline-variant-row select option,
.freight-inline-variant-row select option:checked {
  color: #1b151d !important;
  -webkit-text-fill-color: #1b151d !important;
  background: #fff8ed !important;
}

.freight-same-color-shortcut b {
  color: #8de8dc !important;
  -webkit-text-fill-color: #8de8dc !important;
}
.freight-same-color-shortcut small {
  color: #c9ddd9 !important;
  -webkit-text-fill-color: #c9ddd9 !important;
}
.freight-same-color-shortcut label {
  color: #f5c65e !important;
  -webkit-text-fill-color: #f5c65e !important;
}
.freight-same-color-shortcut [data-freight-same-color-color-label] {
  color: #fff8ed !important;
  -webkit-text-fill-color: #fff8ed !important;
}

