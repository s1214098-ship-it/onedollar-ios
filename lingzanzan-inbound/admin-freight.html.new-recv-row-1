<body class="labels-ready freight-view-entry freight-stage-waiting freight-workline-pinduoduo" data-freight-workline="pinduoduo">
  <script>
    var freightParams = new URLSearchParams(location.search);
    var freightViewMode = freightParams.get('view') === 'tracking' ? 'tracking' : 'entry';
    var freightStageParam = freightParams.get('stage');
    var freightStageMode = freightViewMode === 'entry' ? 'waiting' : (freightStageParam === 'stocked' ? 'stocked' : (freightStageParam === 'awaiting' ? 'awaiting' : 'consolidated'));
    var freightWorklineMode = freightParams.get('line');
    if (['self_pickup', 'pinduoduo', 'haohong'].indexOf(freightWorklineMode) === -1) {
      try { freightWorklineMode = localStorage.getItem('lingzanzan-freight-workline') || sessionStorage.getItem('lingzanzan-freight-workline') || 'pinduoduo'; } catch (error) { freightWorklineMode = 'pinduoduo'; }
    }
    if (['self_pickup', 'pinduoduo', 'haohong'].indexOf(freightWorklineMode) === -1) freightWorklineMode = 'pinduoduo';
    document.body.classList.remove('freight-workline-self_pickup', 'freight-workline-pinduoduo', 'freight-workline-haohong');
    document.body.classList.add('freight-workline-' + freightWorklineMode);
    document.body.dataset.freightWorkline = freightWorklineMode;
    document.body.classList.toggle('freight-view-entry', freightViewMode === 'entry');
    document.body.classList.toggle('freight-view-tracking', freightViewMode === 'tracking');
    document.body.classList.toggle('freight-stage-waiting', freightStageMode === 'waiting');
    document.body.classList.toggle('freight-stage-consolidated', freightStageMode === 'consolidated');
    document.body.classList.toggle('freight-stage-stocked', freightStageMode === 'stocked');
    document.body.classList.toggle('freight-stage-awaiting', freightStageMode === 'awaiting');
    var loginParams = new URLSearchParams(location.search);
    var loginKey = 'lingzanzan-v1-admin-login';
    if (loginParams.get('resetLogin') === '1') {
      localStorage.removeItem(loginKey);
    }
    try {
      var cachedLogin = JSON.parse(localStorage.getItem(loginKey) || '{}');
      if (cachedLogin.version === 'password-login-v2' && cachedLogin.serverSession === true && ['admin', 'staff'].indexOf(cachedLogin.role) !== -1 && cachedLogin.until && Date.now() < cachedLogin.until) {
        document.body.classList.add('is-admin-unlocked');
      }
    } catch (error) {}
    document.addEventListener('DOMContentLoaded', function () {
      var title = document.querySelector('#freight .panel-head h2');
      var subtitle = document.querySelector('#freight .panel-head span');
      var sectionTitle = document.querySelector('[data-freight-tracking-panel] > .panel-subhead h3');
      var sectionSubtitle = document.querySelector('[data-freight-tracking-panel] > .panel-subhead span');
      if (freightStageMode === 'stocked') {
        document.title = 'LINGZANZAN - 物流已入庫';
        if (title) title.textContent = '物流集運／已入庫';
        if (subtitle) subtitle.textContent = '查看已帶入產品並完成正式入庫的物流紀錄，每頁 10 個物件。';
        if (sectionTitle) sectionTitle.textContent = '已入庫物流';
        if (sectionSubtitle) sectionSubtitle.textContent = '已完成產品建檔與庫存入庫的物流紀錄。';
        var filedTitle = document.querySelector('[data-freight-product-filed-history] h3');
        var filedLead = document.querySelector('[data-freight-product-filed-history] header p');
        if (filedTitle) filedTitle.textContent = '已驗收入庫';
        if (filedLead) filedLead.textContent = '卡片左上角小按鈕分辨已驗收入庫／未驗收入庫。';
      } else if (freightStageMode === 'awaiting') {
        document.title = 'LINGZANZAN - 未驗收入庫';
        if (title) title.textContent = '物流集運／未驗收入庫';
        if (subtitle) subtitle.textContent = '左上角小按鈕分辨已驗收入庫／未驗收入庫。尚未驗收入庫的物流列在這裡，每頁 10 筆。';
        if (sectionTitle) sectionTitle.textContent = '未驗收入庫';
        if (sectionSubtitle) sectionSubtitle.textContent = '卡片左上角可直接看出有沒有驗收入庫。';
        var awaitingFiledTitle = document.querySelector('[data-freight-product-filed-history] h3');
        var awaitingFiledLead = document.querySelector('[data-freight-product-filed-history] header p');
        if (awaitingFiledTitle) awaitingFiledTitle.textContent = '未驗收入庫';
        if (awaitingFiledLead) awaitingFiledLead.textContent = '卡片左上角小按鈕分辨已驗收入庫／未驗收入庫。已完成的請到「已入庫」。';
      } else if (freightStageMode === 'consolidated') {
        document.title = 'LINGZANZAN - 集運後狀態';
        if (title) title.textContent = '物流集運／集運後狀態';
        if (subtitle) subtitle.textContent = '集中查看已建立批次、配送進度、點貨驗收與缺件提醒，每頁 10 個批次。';
        if (sectionTitle) sectionTitle.textContent = '集運後批次進度';
        if (sectionSubtitle) sectionSubtitle.textContent = '已集運、配送中、待驗收與超過 10 天未完成的物流集中在這裡。';
      } else {
        if (title) title.textContent = '物流集運建檔';
        if (subtitle) subtitle.textContent = '輸入平台、物流單號、產品明細與成本；尚未入批次或待正式入庫的物流都保留在本頁。';
        if (sectionTitle) sectionTitle.textContent = '物流單號建檔';
        if (sectionSubtitle) sectionSubtitle.textContent = '建立物流單號、購買平台、產品分類、顏色、尺寸、數量與成本資料。';
      }
    });
  </script>
