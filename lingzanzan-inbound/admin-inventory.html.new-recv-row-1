  <script>
    var loginParams = new URLSearchParams(location.search);
    var loginKey = 'lingzanzan-v1-admin-login';
    if (loginParams.get('resetLogin') === '1') {
      loginParams.delete('resetLogin');
      var cleanLoginQuery = loginParams.toString();
      history.replaceState(null, '', location.pathname + (cleanLoginQuery ? '?' + cleanLoginQuery : '') + location.hash);
    }
    if (loginParams.get('login') === 'sales') {
      localStorage.removeItem(loginKey);
      document.documentElement.setAttribute('data-sales-entry', 'true');
    } else {
      try {
        var cachedLogin = JSON.parse(localStorage.getItem(loginKey) || '{}');
        if (cachedLogin.version === 'password-login-v2' && cachedLogin.until && Date.now() < cachedLogin.until) {
          document.body.classList.add('is-admin-unlocked');
        }
      } catch (error) {}
    }
  </script>
