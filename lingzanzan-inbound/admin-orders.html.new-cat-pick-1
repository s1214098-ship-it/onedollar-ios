  <script>
    // 現貨首屏先只啟動核心訂單功能；其餘裝飾模組等第一次操作後再載入，
    // 避免多個 DOM 掃描器同時處理訂單卡造成瀏覽器停止回應。
    (function () {
      var loaded = false;
      var sources = [
        './assets/order-audit-link.js?v=20260901-profit-order-audit-retry-1',
        './assets/admin-labels.js?v=20260730-local313-brand-product-search-1',
        './assets/admin-ui-rescue.js?v=20260718-preorder-waiting-flow-2',
        './assets/order-payments.js?v=20260910-orders-etag-cache-1',
        './assets/member-risk-v2.js?v=20260924-bl-return-1',
        './assets/submission-feedback.js?v=20260815-admin-orders-write-feedback-settle-2',
        './assets/address-helper.js?v=20260821-addr-hang-1'
      ];
      function loadEnhancements() {
        if (loaded) return;
        loaded = true;
        function loadNext(index) {
          if (index >= sources.length) return;
          var script = document.createElement('script');
          script.src = sources[index];
          script.defer = true;
          script.onload = script.onerror = function () {
            window.setTimeout(function () { loadNext(index + 1); }, 2500);
          };
          document.body.appendChild(script);
        }
        loadNext(0);
      }
      function loadOnNonFormAction(event) {
        if (event.target && event.target.closest && event.target.closest('input, textarea, select, [contenteditable="true"]')) return;
        document.removeEventListener('pointerdown', loadOnNonFormAction);
        loadEnhancements();
      }
      document.addEventListener('pointerdown', loadOnNonFormAction, { passive: true });
      // 毛利報表帶 auditOrder 進來時必須立即啟動查核模組；不能等使用者
      // 再點一下頁面或等候 120 秒，否則搜尋框與訂單區會保持空白。
      if (new URLSearchParams(window.location.search).get('auditOrder')) loadEnhancements();
      window.setTimeout(loadEnhancements, 120000);
    }());
  </script>
