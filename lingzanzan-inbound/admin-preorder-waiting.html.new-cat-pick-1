<body class="labels-ready">
  <script>
    (function () {
      var key = 'lingzanzan-v1-admin-login';
      var params = new URLSearchParams(location.search);
      if (params.get('resetLogin') === '1') localStorage.removeItem(key);
      if (params.get('login') === 'sales') {
        localStorage.removeItem(key);
        document.documentElement.setAttribute('data-sales-entry', 'true');
        return;
      }
      try {
        var cached = JSON.parse(localStorage.getItem(key) || '{}');
        if (cached.version === 'password-login-v2' && cached.until && Date.now() < cached.until && cached.role !== 'sales') {
          document.body.classList.add('is-admin-unlocked');
        }
      } catch (error) {}
    }());
  </script>

  <div class="login-gate" data-login-gate>
    <form class="login-card" data-login-form>
      <img src="./assets/brand-logo.jpg" alt="LINGZANZAN">
      <p>ADMIN LOGIN</p>
      <h1>管理者登入</h1>
      <span>請輸入管理者或行政人員帳號與密碼登入。</span>
      <input data-login-account type="text" placeholder="輸入管理者帳號" autocomplete="username">
      <input data-login-password type="password" placeholder="輸入管理者密碼" autocomplete="current-password">
      <button type="submit">登入後台</button>
      <a class="login-home-link" href="./">回首頁</a>
      <small data-login-hint>登入後同一台瀏覽器 24 小時內不用重複登入。</small>
    </form>
  </div>

  <div class="admin-top-actions" hidden>
    <span data-current-user hidden></span>
    <a href="./">回首頁</a>
    <button type="button" data-logout-admin>登出</button>
  </div>

  <div class="admin-shell">
