              <article class="customer-shipping-option is-home">
                <label class="customer-shipping-option-pick"><input type="radio" name="live-customer-address-primary" data-customer-address-primary value="home"><span><b>住家出貨 NT$100</b><small>HCT／大榮／郵局</small></span></label>
                <div class="customer-home-address-row"><input data-customer-home-address placeholder="住家地址，或 HCT新竹／大榮 KTJ／POST 郵局"></div>
