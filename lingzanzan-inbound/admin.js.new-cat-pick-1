      return '<article><header><b>' + escapeHtml(customer.name) + '</b><span>' + escapeHtml(customer.phone || '未填電話') + '</span><em>匹配 ' + customer.qty + ' 件</em></header><small>' + escapeHtml(customer.products.join('；')) + '</small><small>' + escapeHtml((customer.orderId ? '出貨單 ' : '預購單 ') + targetId) + '</small><nav><a href="' + customerHref + '">客戶資料</a><a href="' + orderHref + '">' + orderLabel + '</a></nav></article>';
    }).join('') + '</div></details>';
  }

  function openPreorderTaiwanStockNotice(row) {
    var items = Array.isArray(row && row.items) ? row.items : [];
    var plan = preorderTaiwanStockPlan(row, items);
    if (!plan.ready) return false;
