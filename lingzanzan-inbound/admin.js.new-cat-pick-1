          toast('錯誤回報已送出，等待管理者確認');
        }).catch(function (error) {
          var msg = error && error.name === 'QuotaExceededError' ? '圖片太大，請改用較小截圖再送出' : '錯誤回報儲存失敗';
          toast(msg);
        });
      }).catch(function () {
        toast('圖片讀取失敗，請重新選擇圖片');
      });
    });

    bindLiveOrders();

    document.querySelectorAll('[data-reset]').forEach(function (button) {
      button.addEventListener('click', function () {
        var mode = button.getAttribute('data-reset');
        var label = mode === 'products' ? '產品資料' : '會員資料';
        var ok = window.confirm('確定要重置' + label + '嗎？目前前端安全模式只會清除本機暫存，不會刪除 NAS JSON。');
