    var packages = collectHaoHongMissingPackages(options.item || null);
    if (!packages.length) {
      var noneText = options.item ? '這個單號豪鴻已經有了，或還沒填正式物流單號。' : '後台物流單號（拼多多／寶輝／豪鴻）都已對上豪鴻我的包裹，沒有需要預報的。';
      if (!options.auto) {
