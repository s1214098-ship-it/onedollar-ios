      [/^(深藍色|深藍)(?:\((BIRUTUA|NAVY|DARKBLUE)\)?)?$/, '深藍色'],
      [/^(淺藍色|淺藍)(?:\((BIRUMUDA|LIGHTBLUE|SKYBLUE)\)?)?$/, '淺藍色'],
      [/^(藍色|藍)(?:\((BIR|BIRU|BLUE)\)?)?$/, '藍色'],
      [/^(綠色|綠)(?:\((HIGAU|HIJAU|GREEN)\)?)?$/, '綠色'],
      [/^(黃色|黃)(?:\((KUR|KUNING|YELLOW)\)?)?$/, '黃色'],
      [/^(紫色|紫)(?:\((UNGU|PURPLE)\)?)?$/, '紫色'],
      [/^(橘色|橘)(?:\((ORANG|ORANGE|ORANYE)\)?)?$/, '橘色'],
      [/^(咖啡色|咖色|棕色)(?:\((COKELAT|BROWN)\)?)?$/, '咖啡色'],
