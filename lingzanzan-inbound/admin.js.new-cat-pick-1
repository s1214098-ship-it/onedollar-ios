      return states.every(function (state) { return state === wanted; });
    }
    if (allWanted('delivered')) return 'delivered';
    if (allWanted('returned')) return 'returned';
    var rest = states.filter(function (state) { return state !== 'delivered'; });
    if (rest.length && rest.every(function (state) { return state === 'arrived_store'; })) return 'arrived_store';
    if (states.some(function (state) { return state === 'in_transit' || state === 'arrived_store' || state === 'delivered'; })) {
      return 'in_transit';
    }
    return 'pending';
  }

