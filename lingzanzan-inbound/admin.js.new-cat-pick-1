      groups[key].availableQty = groups[key].stockQty;
    });
    // 本機428：所有尚未轉正式的預購依人工插隊優先、再依建立時間做 FIFO
    // 台灣現貨軟配額。這裡只保留配額，不改 SKU stock；真正扣庫存仍只會在
    // 管理者確認轉正式出貨時由 convert API 執行。已經綁到物流預購倉的數量
    // 不重複占用台灣現貨，也不破壞既有物流客戶綁定。
    var earlierRows = (Array.isArray(state.inquiries) ? state.inquiries : []).filter(function (candidate) {
      if (!candidate || String(candidate.id || '') === String(row.id || '')) return false;
      if (candidate.status === 'cancelled' || preorderInquiryConverted(candidate) || candidate.reserved || candidate.inventoryReceived) return false;
      if (normalizePreorderPurchaseStatus(candidate.purchaseStatus) === 'received') return false;
      return freightFifoQueueCompare(candidate, row) < 0;
    }).sort(freightFifoQueueCompare);
    earlierRows.forEach(function (earlierRow) {
      (Array.isArray(earlierRow.items) ? earlierRow.items : []).forEach(function (earlierItem, earlierItemIndex) {
        var earlierRequested = Math.max(0, Number(earlierItem && (earlierItem.qty || earlierItem.quantity || earlierItem.requestedQty) || 0));
        var earlierFreightAllocated = Math.min(earlierRequested, preorderExistingFreightAllocatedItemQty(earlierRow.id, earlierItemIndex));
        var earlierOutstanding = Math.max(0, earlierRequested - earlierFreightAllocated);
        if (!earlierOutstanding) return;
        var earlierCode = preorderItemCode(earlierItem);
        var earlierColor = freightDemandIdentity(canonicalProductSpecificVariantColor(earlierCode, preorderItemColor(earlierItem)));
        var earlierSize = freightDemandIdentity(canonicalProductVariantSize(preorderItemSize(earlierItem)));
        var earlierIdentities = preorderOfficialProductIdentities(
          [earlierItem && (earlierItem.code || earlierItem.productCode)],
          [earlierItem && earlierItem.sku, earlierItem && earlierItem.skuId, earlierItem && earlierItem.productId, earlierItem && earlierItem.barcode]
        );
        Object.keys(groups).forEach(function (groupKey) {
          var group = groups[groupKey];
          if (freightDemandIdentity(group.color) !== earlierColor || freightDemandIdentity(group.size) !== earlierSize) return;
          if (!group.identities.some(function (identity) { return earlierIdentities.has(identity); })) return;
          group.earlierCustomerQty += earlierOutstanding;
          var earlierCustomer = earlierRow.customer || {};
          var earlierOrderId = String(earlierRow.convertedOrderId || earlierRow.convertedToOrderId || earlierRow.formalOrderId || earlierRow.orderId || '').trim();
          var earlierInquiryId = String(earlierRow.id || '').trim();
          var earlierKey = earlierInquiryId || earlierOrderId || [earlierCustomer.name, earlierCustomer.phone].join('|');
          var matchedCustomer = group.earlierCustomers.find(function (candidate) { return candidate.key === earlierKey; });
          if (!matchedCustomer) {
            matchedCustomer = {
              key: earlierKey,
              name: earlierCustomer.name || earlierRow.customerName || '未填客戶',
              phone: earlierCustomer.phone || earlierRow.customerPhone || '',
              inquiryId: earlierInquiryId,
              orderId: earlierOrderId,
              qty: 0
            };
            group.earlierCustomers.push(matchedCustomer);
          }
          matchedCustomer.qty += earlierOutstanding;
        });
      });
    });
    Object.keys(groups).forEach(function (groupKey) {
      var group = groups[groupKey];
      // 台灣現貨在尚未出貨前可前牌：實體庫存就能配，不被其他未出貨客戶的軟占用擋住。
      group.availableQty = Math.max(0, group.stockQty);
