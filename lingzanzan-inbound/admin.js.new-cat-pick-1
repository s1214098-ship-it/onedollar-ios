      '<div class="freight-quantity-warning"><b>' + (unclassifiedCount ? '廠商名不能拿來點貨' : '實收與作廢分開') + '</b><span>' + (unclassifiedCount ? '這裡顯示的是採購帳號／廠商，不是款式。先搜尋後台產品或新建檔，選定後才會出現可填的實收數量。' : '沒寄到按「沒寄到／刪除此規格」或「作廢此產品」。') + '</span></div>' +
      rows +
      items.map(function (item) { return freightSupplementalPendingHtml(item); }).join('') +
      '<output data-freight-quantity-total>尚未完成點貨</output>' +
      '<div class="freight-receiving-workbench-actions"><button type="button" class="ghost-button" data-freight-arrival-status-close>稍後核對</button><button type="button" class="primary-button" data-freight-quantity-confirm-save>確認本次實收數量 → 下一步</button></div></section>';
    document.body.appendChild(modal);
    bindFreightSupplementalNewProductSearch(modal);
    var updateTotal = function () {
      var inputs = Array.from(modal.querySelectorAll('[data-freight-quantity-actual]'));
