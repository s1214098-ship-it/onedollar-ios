    return Object.keys(groups).reduce(function (rows, key) {
      var siblings = groups[key];
      var stocked = siblings.filter(function (row) { return Number(row.sku.stock || 0) > 0; });
      var visible = stocked.length ? stocked : [siblings[0]];
      visible.forEach(function (row) { rows.push(row); });
