  function applyAdminShipmentBulkProduct(card) {
    if (!card) return;
    var warehouse = adminShipmentSelectedWarehouse();
    var warehouseCode = adminOrderWarehouseCode(warehouse);
    if (!warehouseCode) {
      toast('請先選擇出貨倉，帶入商品才會對應艙位');
      return;
    }
    var quantityInputs = Array.from(card.querySelectorAll('[data-admin-shipment-pick-qty]'));
    var hasSelectedQuantity = quantityInputs.some(function (input) {
      return Number(input.value || 0) > 0;
    });
    if (!hasSelectedQuantity) {
      toast('請先在各尺寸按 + 選數量，再一次帶入出貨單');
      return;
    }
    var added = 0;
    var skipped = 0;
    quantityInputs.forEach(function (input) {
      var qty = Number(input.value || 0);
      if (qty <= 0) return;
      var pick = input.closest('.admin-shipment-sku-pick');
      var key = input.getAttribute('data-admin-shipment-pick-qty');
      var row = adminShipmentFindRow(key);
      if (!row) { skipped += qty; return; }
      var map = orderEntryWarehouseStockMap(row.product, row.sku);
      var pickCode = orderEntryPreferredWarehouse(map, warehouse);
      var sku = orderEntrySkuForWarehouse(row.product, row.sku, pickCode) || orderEntrySkuForWarehouse(row.product, row.sku, warehouseCode);
      if (!sku || Number(sku.stock || 0) <= 0) { skipped += qty; return; }
      var addKey = adminShipmentSkuKey({ product: row.product, sku: sku });
      var priceField = pick && pick.querySelector('[data-admin-shipment-pick-price]');
      var price = Number(priceField && priceField.value !== '' ? priceField.value : 0);
      if (addAdminShipmentSkuQty(addKey, qty, price, true)) added += qty;
      else skipped += qty;
    });
    if (!added) {
      toast(skipped ? '未帶入：請確認已選出貨倉有庫存' : '請先在各尺寸按 + 選數量');
      return;
