  function runAdminOrdersBackgroundRender() {
    window.clearTimeout(adminOrdersBackgroundRenderTimer);
    adminOrdersBackgroundRenderTimer = 0;
    if (!adminOrdersBackgroundRenderPending || adminCurrentFileName() !== 'admin-orders.html') return;
    // Orders and catalog arrive after the form is already usable. Never replace
    // the form DOM while the operator is typing; Chrome otherwise blocks on the
    // large order-card rebuild and can report the page as unresponsive.
    if (adminOrdersEditorHasFocus()) return;
    var orderList = document.querySelector('[data-admin-orders]');
    if (!orderList) return;
    var listRect = orderList.getBoundingClientRect();
    if (listRect.top > window.innerHeight + 400 || listRect.bottom < -400) return;
    ensureAdminOrdersDeferredData().then(function (loaded) {
      if (!loaded || adminOrdersEditorHasFocus()) return;
      adminOrdersBackgroundRenderPending = false;
      if (adminOrdersBackgroundRenderObserver) {
        adminOrdersBackgroundRenderObserver.disconnect();
        adminOrdersBackgroundRenderObserver = null;
      }
      renderOrders();
      renderAdminShipmentLines();
      ensureAdminShipmentPanel();
    });
  }

  function scheduleAdminOrdersBackgroundRender() {
    if (adminCurrentFileName() !== 'admin-orders.html') return;
    if (adminOrdersDeferredDataLoaded) return;
    adminOrdersBackgroundRenderPending = true;
    window.clearTimeout(adminOrdersBackgroundRenderTimer);
    renderAdminOrdersDeferredPrompt();
    var orderList = document.querySelector('[data-admin-orders]');
    if (!orderList) return;

    // Keep the first paint fast, then load the 11 MB order history as soon as
    // the operator approaches the list. This restores automatic visibility of
    // recent orders without rebuilding the large list while a form is edited.
    if (!adminOrdersBackgroundRenderObserver && 'IntersectionObserver' in window) {
      adminOrdersBackgroundRenderObserver = new IntersectionObserver(function (entries) {
        var nearList = entries.some(function (entry) {
          return entry.isIntersecting || entry.boundingClientRect.top < window.innerHeight + 500;
        });
        if (nearList) runAdminOrdersBackgroundRender();
      }, { rootMargin: '500px 0px' });
      adminOrdersBackgroundRenderObserver.observe(orderList);
    }

    if (!adminOrdersBackgroundRenderBound) {
      adminOrdersBackgroundRenderBound = true;
      var requestNearbyOrderRender = function () {
        if (!adminOrdersBackgroundRenderPending) return;
        window.clearTimeout(adminOrdersBackgroundRenderTimer);
        adminOrdersBackgroundRenderTimer = window.setTimeout(runAdminOrdersBackgroundRender, 120);
      };
      window.addEventListener('scroll', requestNearbyOrderRender, { passive: true });
      window.addEventListener('resize', requestNearbyOrderRender, { passive: true });
      document.addEventListener('focusout', requestNearbyOrderRender);
    }

    adminOrdersBackgroundRenderTimer = window.setTimeout(runAdminOrdersBackgroundRender, 350);
  }

