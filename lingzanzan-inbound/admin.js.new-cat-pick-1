        }
        if (badge) badge.hidden = actual === null;
        if (!balance) return;
        var arrived = freightSafeQty(input.getAttribute('data-arrived'), 0);
        var extraColor = input.getAttribute('data-extra-color') === '1';
        var combined = (actual === null ? 0 : actual) + arrived;
        balance.textContent = actual === null
          ? '請填驗收數量'
          : (extraColor
            ? ('新增配色驗收 ' + actual + ' 件（無原始預報）')
            : (combined < expected ? '已到 ' + arrived + '／這次驗收 ' + actual + '／尚待 ' + (expected - combined) : (combined === expected ? '已到 ' + arrived + '／這次驗收 ' + actual + '／預報到齊' : '已到 ' + arrived + '／這次驗收 ' + actual + '／多到 ' + (combined - expected))));
        balance.setAttribute('data-state', actual === null ? 'pending' : (actual < expected ? 'partial' : 'complete'));
      });
      if (output) {
        var autosaveNote = modal.getAttribute('data-freight-quantity-autosave-note') || '';
        output.textContent = (completed === inputs.length
          ? '本張實際收到合計 ' + total + ' 件' + (voidedCount ? '；已作廢 ' + voidedCount + ' 個規格，不作廢的才入庫' : '；只以實收建檔與配貨，未到數量會保留追蹤')
          : '尚有 ' + (inputs.length - completed) + ' 個配色／尺寸未填實收數量') + (autosaveNote ? '　' + autosaveNote : '');
      }
    };
    var autosaveTimer = null;
    var autosaveInFlight = false;
    var scheduleFreightQuantityAutosave = function () {
      if (autosaveTimer) window.clearTimeout(autosaveTimer);
      autosaveTimer = window.setTimeout(function () {
        autosaveTimer = null;
        if (autosaveInFlight) return;
        var itemGroups = Array.from(modal.querySelectorAll('[data-freight-quantity-item]'));
        var requests = [];
        itemGroups.forEach(function (group) {
          var itemId = String(group.getAttribute('data-freight-quantity-item') || '');
          if (!itemId) return;
