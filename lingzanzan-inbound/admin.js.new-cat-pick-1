  function freightFifoDownloadCardImage(blob, name) {
    if (!blob) return false;
    var safeName = String(name || 'customer').replace(/[^\w\u4e00-\u9fff-]+/g, '-').replace(/^-+|-+$/g, '') || 'customer';
    var url = URL.createObjectURL(blob);
    var anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = 'LINGZANZAN-' + safeName + '.png';
    anchor.style.display = 'none';
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();
    setTimeout(function () { URL.revokeObjectURL(url); }, 1500);
    return true;
  }

