  function callStockInquiryApi(payload, timeoutMs) {
    function send(body) {
      var controller = typeof AbortController === 'function' ? new AbortController() : null;
      var timeoutId = controller ? setTimeout(function () { controller.abort(); }, Math.max(10000, Number(timeoutMs || 60000))) : null;
      return fetch('./stock-inquiry-api.php', {
        method: 'POST',
        headers: adminAuthorizationHeaders({ 'Content-Type': 'application/json' }),
        body: JSON.stringify(body),
        signal: controller ? controller.signal : undefined
      }).then(function (res) {
        return res.text().then(function (rawText) {
          var data;
          try {
            data = rawText ? JSON.parse(rawText) : {};
          } catch (parseError) {
            var phpHint = /PHP Parse error:\s*([^\n]+)/i.exec(rawText || '');
            throw new Error(phpHint
              ? ('後台程式錯誤：' + phpHint[1].trim())
              : (res.ok ? '後台回傳不是正確資料' : ('HTTP ' + res.status)));
          }
          if (!res.ok || !data.ok) {
            var err = new Error(data.error || '預購處理失敗');
            if (data && data.blacklistHit) {
              err.blacklistHit = true;
              err.blacklist = data.blacklist;
            }
            throw err;
          }
          scheduleAdminPostSaveRefresh('stock-inquiry-save');
          return data;
        });
      }).finally(function () {
        if (timeoutId) clearTimeout(timeoutId);
      });
    }
    return confirmAdminBlacklist(payload).then(function (ready) {
      return send(ready).catch(function (error) {
        if ((ready.action === 'create' || ready.action === 'convert') && error && error.blacklistHit && !ready.confirmBlacklist) {
          if (!window.confirm((error.message || '') + '\n\n已問過業務、仍要繼續？')) throw error;
          ready.confirmBlacklist = true;
          return send(ready);
        }
        throw error;
      });
    });
  }
