      var kind = entry.settlementMode === 'id_sales_full' ? '全部收' : (entry.settlementMode === 'id_sales_partial' ? '部分收' : '');
      var party = isIdSales
        ? ((entry.collectorName || entry.salesName || '業務') + ' 代收 ANI' + (kind ? '（' + kind + '／印尼）' : '（印尼）') + '｜公司營收，非獎金')
        : (entry.collectionParty === 'sales' ? '訂金由業務收' : (entry.collectionParty === 'company' ? '訂金由公司收' : '訂金收款人待確認'));
      var region = entry.collectionRegion === 'ID' ? '印尼' : '台灣';
