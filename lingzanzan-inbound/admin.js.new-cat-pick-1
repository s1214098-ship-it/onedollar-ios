    var selectedBatchId = String(document.querySelector('[data-freight-bulk-batch]')?.value || '');
    var selectedBatch = selectedBatchId ? freightBatchById(selectedBatchId) : null;
    // Existing batch purpose must never turn a newly selected item into self-use.
    var allowsMultipleAccounts = selectedBatch ? freightBatchAllowsMultipleAccounts(selectedBatch) : false;
    var accountText = selectedAccounts.length ? selectedAccounts.join('、') : '未填／待確認';
    var batchAccounts = selectedBatch ? freightBatchPurchaseAccounts(selectedBatch) : [];
    var finalAccount = selectedBatch ? (batchAccounts.join('、') || '待確認') : '';
    var count = document.querySelector('[data-freight-bulk-count]');
    if (count) count.textContent = '待處理 ' + packageCount + ' 個物流單號／' + unitCount + ' 件商品／物流帳號：' + accountText + '／' + (selectedBatch ? '既有批次：' + freightBatchLabel(selectedBatch) : '可直接建立新批號');
    var internalUseButton = document.querySelector('[data-freight-workbench-internal-use]');
    var internalUseStatus = document.querySelector('[data-freight-workbench-internal-use-status]');
    if (internalUseButton) {
      internalUseButton.hidden = true;
      internalUseButton.disabled = !selected.length;
      internalUseButton.classList.toggle('primary-button', freightWorkbenchInternalUse);
      internalUseButton.classList.toggle('ghost-button', !freightWorkbenchInternalUse);
      internalUseButton.setAttribute('aria-pressed', freightWorkbenchInternalUse ? 'true' : 'false');
      internalUseButton.textContent = freightWorkbenchInternalUse ? '✓ 本批已設為公司自用' : '本批設為公司自用';
    }
    if (internalUseStatus) internalUseStatus.textContent = freightWorkbenchInternalUse
      ? '建立或加入批次後，整批不配客戶；到貨驗收會自動顯示「公司自用」，成本照常入帳。'
      : '自用按每筆商品分別設定；請按該筆「自用加入本批」，其他商品用途不變。';
    var accountRule = document.querySelector('[data-freight-workbench-account-rule]');
    if (accountRule) accountRule.textContent = !selectedBatch
      ? '勾選物流後，可直接按「加入批次並自動產生批號」；若要加入舊批次，再從下方選擇既有批次。'
      : (allowsMultipleAccounts
        ? '將加入豪鴻既有批次；此批允許多個購買帳號，目前批次帳號：' + finalAccount + '。'
        : '將依既有批次把物流帳號回寫為「' + finalAccount + '」，配送倉位也以該批次為準。');
    var batchPreview = document.querySelector('[data-freight-existing-batch-preview]');
    if (batchPreview) {
      if (!selectedBatch) {
        batchPreview.innerHTML = '<p>選擇既有批次後，這裡會先列出該批全部產品，確認正確再加入。</p>';
        batchPreview.classList.remove('has-batch');
