  function freightItemHasOutstandingArrival(item) {
    item = item || {};
    if (Math.max(0, Number(item.arrivalRemainingQty || 0)) > 0) return true;
    var inspection = item.receivingInspection && typeof item.receivingInspection === 'object' ? item.receivingInspection : {};
    if (Math.max(0, Number(inspection.remainingQty || 0)) > 0) return true;
    try {
      return (freightOutstandingArrivalByLine(item) || []).some(function (qty) { return Number(qty || 0) > 0; });
    } catch (error) {
