  function freightReceivingOtherItems(inquiry, link) {
    var items = Array.isArray(inquiry && inquiry.items) ? inquiry.items : [];
    var currentIndex = -1;
    var wantedLineId = String(link && link.lineId || '');
    if (wantedLineId) {
      currentIndex = items.findIndex(function (candidate) {
        return String(candidate && candidate.lineId || '') === wantedLineId;
      });
    }
    if (currentIndex < 0 && link && link.itemIndex !== undefined && link.itemIndex !== null) {
      var indexed = Math.max(0, Number(link.itemIndex || 0));
      if (items[indexed]) currentIndex = indexed;
    }
    if (currentIndex < 0) {
      var wantedCode = normalizeLiveCode(link && link.productCode || '');
      var wantedColor = freightDemandIdentity(link && link.color || '');
      var wantedSize = freightDemandIdentity(labelSizeText(link && link.size || 'NO SIZE'));
      currentIndex = items.findIndex(function (candidate) {
        return normalizeLiveCode(candidate && (candidate.code || candidate.productCode || candidate.sku) || '') === wantedCode
          && freightDemandIdentity(candidate && candidate.color || '') === wantedColor
          && freightDemandIdentity(labelSizeText(candidate && candidate.size || 'NO SIZE')) === wantedSize;
      });
    }
    return items.filter(function (_, index) { return index !== currentIndex; }).map(function (other) {
      other = other || {};
      var requested = Math.max(1, Number(other.requestedQty || other.qty || other.quantity || 1));
      var received = Math.max(0, Number(other.freightReceivedQty || 0));
      return {
        code: String(other.code || other.productCode || other.sku || '未填編號'),
        color: String(other.color || '未填顏色'),
        size: String(other.size || 'NO SIZE'),
        requested: requested,
        received: received,
        pending: Math.max(0, requested - received)
