  function updateFreightBatchStatus(batchId) {
    var batch = freightBatchById(batchId);
    var select = Array.from(document.querySelectorAll('[data-freight-batch-status-control]')).find(function (el) { return String(el.getAttribute('data-freight-batch-status-control') || '') === String(batchId || ''); });
    if (!batch || !select) { toast('找不到要更新的物流批次'); return; }
    var nextStatus = String(select.value || '').trim();
    if (!nextStatus) { toast('請選擇配送狀態'); return; }
    if (nextStatus === '台灣收到待點貨') { startFreightBatchReceiving(batchId); return; }
    if (nextStatus === '已入庫') {
      toast('正式入庫必須由採購進貨建檔確認，系統才會增加庫存並開放配貨');
      window.location.href = './admin-inventory-entry.html?freightBatchId=' + encodeURIComponent(batchId || '');
      return;
    }
    var receiving = freightBatchReceivingSummary(batch);
    if ((nextStatus === '已驗收進貨' || nextStatus === '已入庫') && receiving.rows.length && (!receiving.completedAt || receiving.missingQty > 0)) {
      toast(receiving.missingQty > 0 ? '本批仍有缺件，請先完成補點或保留「缺件待處理」' : '請先開始點貨並按「完成點貨並檢查缺件」');
      return;
    }
    var saveButton = Array.from(document.querySelectorAll('[data-freight-batch-status-save]')).find(function (el) {
      return String(el.getAttribute('data-freight-batch-status-save') || '') === String(batchId || '');
    });
    if (saveButton) {
      saveButton.disabled = true;
      saveButton.textContent = '儲存中…';
    }
    saveFreightBatchStatusRecord(batchId, nextStatus).then(function () {
      toast('批次已更新為「' + nextStatus + '」；其他頁面同時出貨也不會覆蓋本次狀態');
    }).catch(function (error) {
      if (saveButton && document.body.contains(saveButton)) {
        saveButton.disabled = false;
        saveButton.textContent = '儲存狀態';
      }
      toast(error.message || '批次狀態儲存失敗');
    });
  }

