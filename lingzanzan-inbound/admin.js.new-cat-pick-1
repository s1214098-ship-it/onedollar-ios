      ready: ready,
      lines: lines,
      demandQty: demandQty,
      earlierCustomerQty: lines.reduce(function (sum, line) { return sum + Math.max(0, Number(line.earlierCustomerQty || 0)); }, 0),
      availableQty: lines.reduce(function (sum, line) { return sum + Math.min(line.availableQty, line.demandQty); }, 0)
