  function saveFreightInlineVariants(itemId, editor) {
    var item = freightItemById(itemId);
    if (!item || !editor) return Promise.reject(new Error('找不到這筆物流資料，請重新整理'));
    var existing = freightVariantLines(item);
    var rows = Array.from(editor.querySelectorAll('[data-freight-inline-variant-row]'));
    if (!rows.length) return Promise.reject(new Error('至少要保留一組顏色與尺寸'));
    var missing = [];
    var lines = rows.map(function (row, index) {
      var id = String(row.getAttribute('data-freight-inline-variant-id') || '').trim();
      var previous = existing.find(function (line) { return String(line.id || '') === id; }) || normalizeFreightVariantLine({ id: id || ('variant-' + Date.now() + '-' + index) }, index, item);
      var color = String(row.querySelector('[data-freight-inline-variant-color]')?.value || '').trim();
      var size = String(row.querySelector('[data-freight-inline-variant-size]')?.value || '').trim();
      var quantity = Math.max(1, Math.round(Number(row.querySelector('[data-freight-inline-variant-quantity]')?.value || 1)));
      if (!color) missing.push('第 ' + (index + 1) + ' 組顏色');
      if (!size) missing.push('第 ' + (index + 1) + ' 組尺寸');
      var line = freightInlineRegeneratedVariant(previous, item, color, size || 'NO SIZE');
      line.quantity = quantity;
      return normalizeFreightVariantLine(line, index, item);
    });
    if (missing.length) return Promise.reject(new Error('尚缺：' + missing.join('、')));
    lines = lines.map(function (line) {
      if (line.sampleBarcode && Number(line.barcodeCostTwd || 0) > 0) return line;
      return freightBuildSameColorSizeLine(lines, item, line.color, line.size, line.quantity);
    });
    var incomplete = lines.find(function (line) { return !line.sampleBarcode || !(Number(line.barcodeCostTwd || 0) > 0); });
    if (incomplete) return Promise.reject(new Error('「' + (incomplete.color || '未填顏色') + '／' + (incomplete.size || 'NO SIZE') + '」還沒產生條碼或首次成本'));
    var primary = lines[0];
    var updated = Object.assign({}, item, {
      variants: lines,
      category: primary.category || item.category || '',
      color: primary.color,
      size: primary.size,
      quantity: freightVariantTotalQuantity(lines),
      sampleBarcode: primary.sampleBarcode || '',
      taiwanBarcode: primary.taiwanBarcode || primary.sampleBarcode || '',
      updatedAt: new Date().toISOString()
    });
    var status = editor.querySelector('[data-freight-inline-variant-status]');
