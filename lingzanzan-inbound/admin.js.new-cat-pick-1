  function applyPendingMemberEditRequest() {
    if ((location.pathname.split('/').pop() || '').toLowerCase() !== 'admin-members.html') return;
    var params = new URLSearchParams(location.search);
    if (params.get('editMember') !== '1') return;
    var raw = '';
    try { raw = sessionStorage.getItem('lingzanzan-admin-member-edit-request') || ''; } catch (error) {}
    var request = {};
    try { request = raw ? JSON.parse(raw) : {}; } catch (error) {}
    var digits = String(request.phone || params.get('phone') || '').replace(/\D/g, '');
    var name = String(request.name || params.get('name') || '').trim().toLowerCase();
    var index = state.members.findIndex(function (member) {
      return digits && String(member.phone || '').replace(/\D/g, '') === digits;
    });
    if (index < 0 && name) {
      index = state.members.findIndex(function (member) {
        return String(member.name || '').trim().toLowerCase() === name;
      });
    }
    if (index > -1 && startMemberEdit(index, { scroll: true })) {
      var memberSearch = document.querySelector('[data-member-search]');
      if (memberSearch) {
        memberSearch.value = state.members[index].phone || state.members[index].name || '';
        renderPeopleLists();
      }
      try { sessionStorage.removeItem('lingzanzan-admin-member-edit-request'); } catch (error) {}
      history.replaceState(null, '', './admin-members.html#members');
      return;
    }
    toast('找不到可編輯的會員，請用電話或姓名重新搜尋');
  }

