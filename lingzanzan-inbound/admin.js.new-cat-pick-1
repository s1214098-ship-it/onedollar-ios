    sequence.then(function () {
      return typeof loadFreightTracking === 'function' ? loadFreightTracking(true) : null;
    }).then(function () {
      toast('已作廢：' + label + '，沒有入庫');
      modal.remove();
      if (typeof renderFreightTracking === 'function') renderFreightTracking();
    }).catch(function (error) {
      Array.from(modal.querySelectorAll('[data-freight-receiving-void]')).forEach(function (control) {
        control.disabled = false;
        control.textContent = control.getAttribute('data-idle-label') || '作廢這一張單';
      });
