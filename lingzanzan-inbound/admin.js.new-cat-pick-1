  }

  function adminOrderSearchIsShortNumericTracking(query) {
    var raw = String(query || '');
    if (raw.normalize) raw = raw.normalize('NFKC');
    raw = raw.trim();
    var digits = raw.replace(/\D/g, '');
    if (!digits || digits.length >= 6) return false;
    if (/^09/.test(digits) && digits.length >= 5) return false;
    return /^\d+$/.test(raw);
  }

  function adminOrderSearchIsTooShort(query) {
    query = String(query || '');
    if (query.normalize) query = query.normalize('NFKC');
    query = query.trim();
    if (!query) return false;
    var digits = query.replace(/\D/g, '');
    if (/^\d+$/.test(query)) {
      if (/^09/.test(digits)) return digits.length < 5;
      return digits.length < 6;
    }
    return query.length < 2;
  }

