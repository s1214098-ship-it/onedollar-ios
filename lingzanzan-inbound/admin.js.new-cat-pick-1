  function renderFreightCodeInterlink(payload) {
    var panel = document.querySelector('[data-freight-code-interlink]');
    var title = document.querySelector('[data-freight-code-interlink-title]');
    var host = document.querySelector('[data-freight-code-interlink-results]');
    if (!panel || !host) return;
    var samePayload = freightCodeInterlinkPayload === payload;
    freightCodeInterlinkPayload = payload && payload.ok ? payload : null;
    if (!freightCodeInterlinkPayload) { panel.hidden = true; host.innerHTML = ''; return; }
    if (!samePayload) {
      freightInterlinkStockPage = 1;
      freightInterlinkOrderPage = 1;
    }
    var code = String(payload.productCode || '').trim();
    var inventory = payload.inventory || {};
    var stockRows = Array.isArray(inventory.stockRows) ? inventory.stockRows : [];
    var candidates = Array.isArray(payload.candidates) ? payload.candidates : [];
    var totalStock = Math.max(0, Number(inventory.totalStockQty || 0));
    if (!totalStock && !candidates.length) { panel.hidden = true; host.innerHTML = ''; return; }
    if (title) title.textContent = '產品編號 ' + code + ' 已找到可互聯資料';
    var stockPages = Math.max(1, Math.ceil(stockRows.length / freightInterlinkPageSize));
    freightInterlinkStockPage = Math.min(Math.max(1, freightInterlinkStockPage), stockPages);
    var stockStart = (freightInterlinkStockPage - 1) * freightInterlinkPageSize;
    var visibleStockRows = stockRows.map(function (row, index) { return { row: row, index: index }; }).slice(stockStart, stockStart + freightInterlinkPageSize);
    var inventoryHtml = totalStock ? '<section class="freight-code-interlink-group is-stock"><h5>目前有庫存｜共 ' + totalStock + ' 件／' + stockRows.length + ' 個規格</h5>' + visibleStockRows.map(function (entry) {
      var row = entry.row;
      return '<article><div><b>' + escapeHtml(row.warehouse || row.warehouseCode || '未標倉別') + '｜' + escapeHtml(row.color || '未填顏色') + '｜' + escapeHtml(row.size || 'NO SIZE') + '</b><small>可用庫存 ' + Math.max(0, Number(row.stock || 0)) + ' 件｜條碼 ' + escapeHtml(row.barcode || row.skuId || '-') + '</small></div><button type="button" class="primary-button" data-freight-interlink-stock="' + entry.index + '">帶入此庫存產品</button></article>';
    }).join('') + freightInterlinkPaginationHtml('stock', freightInterlinkStockPage, stockRows.length) + '</section>' : '';
    var preorderCount = Math.max(0, Number(payload.preorderCandidateCount || 0));
    var liveCount = Math.max(0, Number(payload.liveCandidateCount || 0));
    var indexedCandidates = candidates.map(function (row, index) {
      return { row: row, index: index };
    });
    var orderedCandidates = indexedCandidates.filter(function (entry) {
      return !String(entry.row && entry.row.liveSource || '').trim();
    }).concat(indexedCandidates.filter(function (entry) {
      return !!String(entry.row && entry.row.liveSource || '').trim();
    }));
    var orderPages = Math.max(1, Math.ceil(orderedCandidates.length / freightInterlinkPageSize));
    freightInterlinkOrderPage = Math.min(Math.max(1, freightInterlinkOrderPage), orderPages);
    var orderStart = (freightInterlinkOrderPage - 1) * freightInterlinkPageSize;
    var visibleCandidates = orderedCandidates.slice(orderStart, orderStart + freightInterlinkPageSize);
    var orderHtml = candidates.length ? '<section class="freight-code-interlink-group is-order"><h5>找到可能需要此款的訂單｜預購 ' + preorderCount + ' 筆／直播 ' + liveCount + ' 筆／尚缺 ' + Math.max(0, Number(payload.remainingQty || 0)) + ' 件</h5><p class="freight-auto-allocation-help"><b>正常不用逐筆按：</b>儲存物流商品後，系統會依條碼基碼、顏色名稱、尺寸與最早下單時間自動提撥。下方按鈕只供資料不完整或需要人工改配時使用。</p>' + visibleCandidates.map(function (entry) {
      var row = entry.row;
      var index = entry.index;
      var session = row.liveSession ? '｜' + row.liveSession : '';
      var image = String(row.productImage || '').trim();
      var imageHtml = image
        ? '<button type="button" class="freight-interlink-order-photo" data-order-photo="' + escapeHtml(image) + '" aria-label="放大查看業務訂單產品圖片"><img src="' + escapeHtml(image) + '" alt="' + escapeHtml(row.productName || row.productCode || '業務訂單產品') + '"><span>點圖放大</span></button>'
        : '<span class="freight-interlink-order-photo is-missing"><b>無圖片</b><small>請核對編號</small></span>';
      var customerPhone = String(row.customerPhone || row.phone || '').trim();
      var productTitle = String(row.productName || row.productTitle || row.productCode || '未填商品').trim();
      var productCode = String(row.productCode || row.sku || row.skuId || '').trim();
      var orderNo = String(row.customerOrderNo || row.inquiryId || '-').trim();
      return '<article class="freight-interlink-order-row">' + imageHtml +
        '<div class="freight-interlink-customer"><b>' + escapeHtml(row.customerName || '未填姓名') + '</b><a href="' + (customerPhone ? 'tel:' + escapeHtml(customerPhone.replace(/[^0-9+]/g, '')) : '#') + '"' + (customerPhone ? '' : ' aria-disabled="true"') + '>' + escapeHtml(customerPhone || '未填電話') + '</a><small>' + freightInterlinkOrderLabel(row) + session + '</small></div>' +
        '<div class="freight-interlink-product"><b>' + escapeHtml(productTitle) + '</b><small>' + (productCode ? escapeHtml(productCode) + '｜' : '') + escapeHtml(row.color || '未填顏色') + '／' + escapeHtml(row.size || '未填尺寸') + '</small><code>' + escapeHtml(orderNo) + '</code></div>' +
        '<div class="freight-interlink-qty"><span>尚缺</span><b>' + Math.max(0, Number(row.pendingQty || 0)) + '</b><small>件</small></div>' +
