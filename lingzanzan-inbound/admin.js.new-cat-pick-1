    var candidates = summary.rows.filter(function (row) {
      var source = row.item || {};
      if (itemId && [source.id, source.sourceItemId].some(function (id) { return String(id || '') === itemId; })) return true;
      return wanted && freightReceivingTrackingAliases(source).some(function (code) {
        return normalizeScanCode(code) === wanted;
      });
    });
    return candidates.find(function (row) { return row.receivedQty < row.expectedQty; }) || candidates[0] || null;
  }

  function freightArrivalRowsForScan(batch, item, trackingNo) {
    var summary = freightBatchReceivingSummary(batch || {});
    var itemId = String(item && item.id || '');
    var wanted = normalizeScanCode(trackingNo || item && item.trackingNo || '');
    var directMatches = summary.rows.filter(function (row) {
      var source = row.item || {};
      return wanted && freightReceivingTrackingAliases(source).some(function (code) {
        return normalizeScanCode(code) === wanted;
      });
    });
    if (directMatches.length) return directMatches;
    return summary.rows.filter(function (row) {
      var source = row.item || {};
      return itemId && [source.id, source.sourceItemId].some(function (id) { return String(id || '') === itemId; });
    });
  }

  function freightArrivalItemsForTracking(batch, trackingNo) {
    var rows = freightArrivalRowsForScan(batch, null, trackingNo);
    var seen = new Set();
    var items = rows.map(function (row) {
      var source = row.item || {};
      return freightItemById(source.id || source.sourceItemId) || source;
    });
    var parentIds = new Set(items.map(function (item) { return String(item && item.id || ''); }).filter(Boolean));
    normalizeFreightTracking(state.freightTracking).items.forEach(function (item) {
      if (!item || item.isSupplementalSplitReceipt !== true) return;
      if (!parentIds.has(String(item.parentFreightItemId || ''))) return;
      if (freightItemClosesBatchQueueWithoutSelectionCheck(item)) return;
      items.push(item);
    });
    return items.filter(function (item) {
      var id = String(item && item.id || '');
      if (!id || seen.has(id)) return false;
      seen.add(id);
