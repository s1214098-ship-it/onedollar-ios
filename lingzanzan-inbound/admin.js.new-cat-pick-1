      else if (mode === 'account') result = accountLabel(a).localeCompare(accountLabel(b), 'zh-Hant');
      else if (mode === 'status') result = String(a.status || a.progress || '').localeCompare(String(b.status || b.progress || ''), 'zh-Hant');
      else result = freightListRowTimestamp(b) - freightListRowTimestamp(a);
      return result || (freightListRowTimestamp(b) - freightListRowTimestamp(a)) || String(a.id || '').localeCompare(String(b.id || ''));
    });
    return list;
  }

  function freightTrackingSelectionKey(itemOrTracking) {
    var value = typeof itemOrTracking === 'object' && itemOrTracking
      ? (itemOrTracking.trackingNo || itemOrTracking.pendingLogisticsCode || itemOrTracking.id || '')
      : itemOrTracking;
    return String(value || '').replace(/\s+/g, '').toUpperCase();
  }

  function freightWorkbenchSelectedTrackingGroups(items) {
    var groups = [];
    var byKey = new Map();
    (items || []).forEach(function (item, index) {
      var key = freightTrackingSelectionKey(item) || ('ROW|' + String(item.id || index));
      var group = byKey.get(key);
      if (!group) {
        group = {
          key: key,
          trackingNo: String(item.trackingNo || item.pendingLogisticsCode || '未填物流單號').trim(),
          rows: [],
          quantity: 0,
          accounts: [],
          destinations: []
        };
        byKey.set(key, group);
        groups.push(group);
      }
      group.rows.push(item);
      group.quantity += Math.max(1, Number(item.quantity || item.qty || 1));
      var account = freightPurchaseAccountLabel(item);
      if (account && group.accounts.indexOf(account) === -1) group.accounts.push(account);
      var destination = freightDestinationRule(item.destinationWarehouse).site;
      if (destination && group.destinations.indexOf(destination) === -1) group.destinations.push(destination);
    });
    return groups;
  }

  function freightWorkbenchTrackingNumbers(items) {
    var numbers = [];
    (items || []).forEach(function (item) {
      var parcels = freightSplitPackages(item && item.splitPackages || []);
      if (parcels.length) {
        parcels.forEach(function (parcel) {
          var trackingNo = String(parcel.trackingNo || '').trim();
          if (trackingNo && numbers.indexOf(trackingNo) === -1) numbers.push(trackingNo);
        });
        return;
      }
      var fallback = String(item && (item.trackingNo || item.haohongTrackingNo) || '').trim();
      if (fallback && numbers.indexOf(fallback) === -1) numbers.push(fallback);
    });
    return numbers;
  }

