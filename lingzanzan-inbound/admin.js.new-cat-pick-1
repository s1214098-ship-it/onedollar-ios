      if (!/self|自取/i.test(currentDelivery)) setDeliverySelectFromShippingRule(delivery, info);
    }
    var regularFee = selectedMode ? selectedDeliveryFee(delivery, info.fee) : info.fee;
    if (!selectedMode && shipping && shipping.addressPrimary === 'store') regularFee = storeFee;
    if (manualPreorderSalesValue(form) === 'any' && regularFee === 70) regularFee = 100;
    var productSubtotal = manualPreorderItems.reduce(function (sum, item) {
