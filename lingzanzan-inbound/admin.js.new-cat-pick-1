  function refreshBatchCustomsFromBaohuiThen(batch) {
    if (!batch) return Promise.resolve(null);
    if (freightBatchTaxType(batch) === 'tax_exempt') return Promise.resolve(batch);
    var no = String(batch.customsNo || batch.consolidationNo || '').trim();
    var live = liveBaohuiCustomsMatchForBatch(batch);
    if (live) {
      applyBaohuiCustomsCostsToBatch(batch, live);
      return Promise.resolve(batch);
    }
    if (!no) return Promise.resolve(batch);
    return fetch('./freight-customs-lookup.php?q=' + encodeURIComponent(no) + '&_=' + Date.now(), { cache: 'no-store' })
      .then(function (res) { return res.ok ? res.json() : { matches: [] }; })
      .then(function (payload) {
        var matches = Array.isArray(payload.matches) ? payload.matches : [];
        mergeBaohuiCustomsMatches(matches);
        var match = liveBaohuiCustomsMatchForBatch(batch) || matches[0];
        if (match) applyBaohuiCustomsCostsToBatch(batch, match);
        return batch;
      })
      .catch(function () { return batch; });
  }

  function syncStaleFreightBatchesFromBaohui() {
    var stamp = (state.baohuiCustoms || []).map(function (row) {
      return [row.customsNo, row.dutyTwd, row.lateFeeTwd, row.allocationTotalTwd, row.packageCount].join(':');
    }).join('|');
    if (!stamp || stamp === baohuiCustomsCostSyncStamp) return Promise.resolve([]);
    var dirty = [];
    (normalizeFreightTracking(state.freightTracking).batches || []).forEach(function (batch) {
      if (freightBatchTaxType(batch) === 'tax_exempt') return;
      if (/豪鴻/.test(String(batch.forwarder || '')) || String(batch.provider || '') === 'haohong') return;
      var match = liveBaohuiCustomsMatchForBatch(batch);
      if (!match || !freightBatchCustomsCostIsStale(batch, match)) return;
      applyBaohuiCustomsCostsToBatch(batch, match);
      dirty.push(String(batch.id || ''));
    });
    baohuiCustomsCostSyncStamp = stamp;
    if (!dirty.length) return Promise.resolve([]);
    return saveFreightTracking().then(function () { return dirty; });
  }

  function applyBaohuiFreightMatch(match) {
    if (!match) return;
    var currentBatch = freightBatchById(document.querySelector('[data-freight-batch-id]')?.value || '');
    var summary = baohuiCustomsCostSummary(match, currentBatch);
    var trackingInput = document.querySelector('[data-freight-batch-tracking]');
    var batchNoInput = document.querySelector('[data-freight-batch-no]');
    var dateInput = document.querySelector('[data-freight-batch-date]');
    if (customsInput) customsInput.value = summary.customsNo || match.taiwanTrackingNo || '';
    if (trackingInput && !trackingInput.value) trackingInput.value = summary.taiwanTrackingNo || (match.trackingNos || [])[0] || '';
    if (batchNoInput && !batchNoInput.value) batchNoInput.value = match.batch || summary.customsNo || '';
    if (dateInput && match.date) dateInput.value = String(match.date).slice(0, 10);
    setFreightNumberValue('[data-freight-duty-twd]', summary.dutyTwd);
    setFreightNumberValue('[data-freight-taiwan-courier-twd]', summary.taiwanCourierFeeTwd);
    setFreightNumberValue('[data-freight-charge-total-twd]', summary.allocationTotalTwd);
    setFreightNumberValue('[data-freight-batch-amount]', summary.allocationTotalTwd);
    setFreightNumberValue('[data-freight-customs-package-count]', summary.count);
    renderFreightBatchFormula();
  }

