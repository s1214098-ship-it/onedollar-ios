  }
  function freightFifoPaymentValues(modal) {
    var box = modal && modal.querySelector('[data-freight-fifo-payment]');
    if (!box) return null;
    var totalInput = box.querySelector('[data-freight-fifo-payment-total]');
    if (!box.hasAttribute('data-base-order-total')) {
      box.setAttribute('data-base-order-total', String(Math.max(0, Number((totalInput || {}).value || 0))));
    }
    var baseTotal = Math.max(0, Number(box.getAttribute('data-base-order-total') || 0));
    var mode = String((box.querySelector('[data-freight-fifo-payment-mode]') || {}).value || '');
    var indonesiaCollectionMode = String((box.querySelector('[data-freight-fifo-indonesia-collection-mode]') || {}).value || '');
    var indonesiaCollectionCurrency = String((box.querySelector('[data-freight-fifo-indonesia-collection-currency]') || {}).value || 'TWD').toUpperCase() === 'IDR' ? 'IDR' : 'TWD';
    var indonesiaCollectionOriginalAmount = Math.max(0, Number((box.querySelector('[data-freight-fifo-indonesia-collection-amount]') || {}).value || 0));
    var indonesiaCollectionRate = Math.max(1, Number((box.querySelector('[data-freight-fifo-indonesia-collection-rate]') || {}).value || 500));
    var indonesiaCollectionAmount = indonesiaCollectionCurrency === 'IDR' ? Math.round(indonesiaCollectionOriginalAmount / indonesiaCollectionRate) : Math.round(indonesiaCollectionOriginalAmount);
    var indonesiaCollectionStatus = String((box.querySelector('[data-freight-fifo-indonesia-collection-status]') || {}).value || 'pending') === 'received' ? 'received' : 'pending';
    var indonesiaCollectionReceiver = String((box.querySelector('[data-freight-fifo-indonesia-collection-receiver]') || {}).value || 'indonesia_sales') === 'taiwan_company' ? 'taiwan_company' : 'indonesia_sales';
    // Mode 2 + Taiwan collection is an extra Indonesia-sale item travelling
    // in this Taiwan parcel. Add it to this parcel's receivable, but keep it
    // out of Indonesia-collected revenue.
    var taiwanCollectedIndonesiaGoods = indonesiaCollectionMode === 'company_deposit' && indonesiaCollectionReceiver === 'taiwan_company'
      ? indonesiaCollectionAmount : 0;
    var total = baseTotal + taiwanCollectedIndonesiaGoods;
    if (totalInput) totalInput.value = String(total);
    var previousInput = box.querySelector('[data-freight-fifo-payment-previous]');
    var previousPaidEntered = Math.max(0, Number((previousInput || {}).value || box.getAttribute('data-previous-paid') || 0));
    var previousPaid = Math.max(0, Math.min(total, previousPaidEntered));
    var previousDeposit = Math.max(0, Math.min(previousPaid, Number(box.getAttribute('data-previous-deposit') || 0)));
    var current = Math.max(0, Math.min(total - previousPaid, Number((box.querySelector('[data-freight-fifo-payment-current]') || {}).value || 0)));
    var paid = Math.min(total, previousPaid + current);
    var balance = Math.max(0, total - paid);
    var shippingFeeSelect = modal.querySelector('[data-freight-fifo-shipping-fee-mode]');
    var allocationShippingFee = shippingFeeSelect && shippingFeeSelect.value !== 'free' && shippingFeeSelect.value !== 'id_self'
      ? Math.max(0, Number(shippingFeeSelect.getAttribute('data-regular-shipping-fee') || 0))
      : 0;
    var indonesiaShipping = indonesiaShippingAllocation(indonesiaCollectionMode, allocationShippingFee);
    var remainder = String((box.querySelector('[data-freight-fifo-id-remainder]') || {}).value || '');
    var deposit = (mode === 'deposit_before_ship' || mode === 'deposit_cod' || mode === 'deposit_account')
      ? Math.max(previousDeposit, paid)
      : previousDeposit;
    var idRemainderStage = mode === 'id_sales_full' ? 'none' : (mode === 'id_sales_partial' ? remainder : '');
    var feeMode = String((modal.querySelector('[data-freight-fifo-shipping-fee-mode]') || {}).value || '');
    var indonesiaSelfShip = feeMode === 'id_self';
    var storeIdCod = isIndonesiaSalesCollectionMode(mode) && !indonesiaSelfShip && freightFifoStoreIdCodChecked(box);
    var taiwanCod = mode === 'deposit_cod' || mode === 'cod_full' || (mode === 'id_sales_partial' && remainder === 'tw_cod');
    var idr = isIndonesiaSalesCollectionMode(mode) ? freightFifoIndonesiaIdrValues(box) : { amount: 0, rate: freightFifoDefaultIdrRate(), twd: 0 };
    var indonesiaShortfall = isIndonesiaSalesCollectionMode(mode) && idr.amount > 0 ? Math.max(0, total - idr.twd) : 0;
    var indonesiaCovered = isIndonesiaSalesCollectionMode(mode) && idr.amount > 0 && idr.twd >= total;
    return {
      total: total,
      baseTotal: baseTotal,
      taiwanCollectedIndonesiaGoods: taiwanCollectedIndonesiaGoods,
      previousPaid: previousPaid,
      previousPaidEntered: previousPaidEntered,
      previousPaidEditable: !!(previousInput && !previousInput.readOnly && !previousInput.disabled),
      previousDeposit: previousDeposit,
      originalPreviousPaid: Math.max(0, Number(box.getAttribute('data-original-previous-paid') || box.getAttribute('data-previous-paid') || 0)),
      current: current,
      paid: paid,
      balance: balance,
      deposit: Math.min(paid, deposit),
      mode: mode,
      indonesiaCollectionMode: indonesiaCollectionMode,
      indonesiaCollectionAmount: indonesiaCollectionAmount,
      indonesiaCollectionCurrency: indonesiaCollectionCurrency,
      indonesiaCollectionOriginalAmount: indonesiaCollectionOriginalAmount,
      indonesiaCollectionRate: indonesiaCollectionRate,
      indonesiaCollectionStatus: indonesiaCollectionStatus,
      indonesiaCollectionReceiver: indonesiaCollectionReceiver,
      indonesiaShippingSalesRate: indonesiaShipping.salesRate,
      indonesiaShippingCompanyRate: indonesiaShipping.companyRate,
      indonesiaShippingSalesAmount: indonesiaShipping.salesAmount,
      indonesiaShippingCompanyAmount: indonesiaShipping.companyAmount,
      indonesiaTaiwanCodCharge: indonesiaShipping.taiwanCodCharge,
      indonesiaCustomerShippingRefund: indonesiaShipping.customerRefund,
      indonesiaNetCustomerShipping: indonesiaShipping.netCustomerShipping,
      indonesiaActualShippingCost: indonesiaShipping.actualShippingCost,
      indonesiaShippingAllocationLabel: indonesiaShipping.label,
      idRemainderStage: idRemainderStage,
      storeIdCod: storeIdCod,
      storeIdCodAmount: storeIdCod ? 100 : 0,
      indonesiaSelfShip: indonesiaSelfShip,
      indonesiaAmount: idr.amount,
      indonesiaRate: idr.rate,
      indonesiaTwd: idr.twd,
      indonesiaShortfall: indonesiaShortfall,
