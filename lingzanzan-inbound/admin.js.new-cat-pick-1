  // LZ_CN_PREFIX_PICK_20260924 + LZ_ADMIN_SEARCH_20260924: prefix listing + concat barcode family.
  function liveSearchProducts(query) {
    var q = String(query || '').trim();
    var prefix = '';
    try { prefix = String((typeof scanFamilyCode === 'function' ? scanFamilyCode(q) : '') || labelBarcodeBaseProductCode(q) || '').toUpperCase(); } catch (error) { prefix = ''; }
    if (/^[A-Z]+\d+$/.test(prefix)) {
      var exactByPrefix = (state.products || []).filter(function (product) {
        return labelBarcodeBaseProductCode(product.code || product.id || '') === prefix
          || (typeof scanFamilyCode === 'function' && scanFamilyCode(product.code || '') === prefix);
      });
      if (exactByPrefix.length) return exactByPrefix.slice(0, 48);
    }
    var compact = searchLooseNormalize(q);
    if (/^[a-z]+\d{1,6}$/.test(compact)) {
      var exactCode = freightDemandIdentity(labelBarcodeBaseProductCode(q));
      var exact = (state.products || []).filter(function (product) {
        return freightDemandIdentity(labelBarcodeBaseProductCode(product.code || product.id || '')) === exactCode;
      });
      if (exact.length) return exact.slice(0, 48);
    }
    if (/^[a-z]{2,8}$/.test(compact)) {
      var letterHits = (state.products || []).filter(function (product) {
        return searchLooseNormalize(product.code || product.productLine || '').indexOf(compact) === 0;
      }).sort(function (a, b) {
        return searchStableCodeCompare(a.code || a.id, b.code || b.id);
      });
      if (letterHits.length) return letterHits.slice(0, 48);
    }
    return liveProductMatches(query);
  }

  function applyLiveBulkProduct(card) {
    if (!card) return;
    var scanner = liveScannerRow();
    var warehouseLabelText = liveRowWarehouse(scanner);
    var warehouseCode = adminOrderWarehouseCode(warehouseLabelText);
    if (!warehouseCode) {
      toast('請先選擇出貨倉，帶入商品才會對應艙位');
      return;
    }
    var choices = Array.prototype.slice.call(card.querySelectorAll('[data-live-size-choice]'));
    var picks = [];
    var skipped = 0;
    choices.forEach(function (choice) {
      var qty = Math.max(0, Math.floor(Number((choice.querySelector('[data-live-multi-qty]') || {}).value || 0)));
      if (qty <= 0) return;
      var productId = String(choice.getAttribute('data-live-multi-product') || '');
      var product = (state.products || []).find(function (item) { return String(item.id || '') === productId; });
      if (!product) { skipped += qty; return; }
      var dummySku = {
        colorName: choice.getAttribute('data-live-variant-color') || '',
        sizeName: choice.getAttribute('data-live-variant-size') || 'NO SIZE'
      };
      var map = orderEntryWarehouseStockMap(product, dummySku);
      var pickCode = orderEntryPreferredWarehouse(map, warehouseLabelText);
      var sku = orderEntrySkuForWarehouse(product, dummySku, pickCode) || orderEntrySkuForWarehouse(product, dummySku, warehouseCode);
      if (!sku || Number(sku.stock || 0) <= 0) { skipped += qty; return; }
      qty = Math.min(Number(sku.stock || 0), qty);
      var memory = rememberedOrderPrice(product, sku);
      var priceInput = choice.querySelector('[data-live-multi-price]');
      var price = Math.max(0, Number(priceInput && priceInput.value !== '' ? priceInput.value : zhangzhangDefaultSalePrice(product, sku, memory.price)));
      picks.push({ product: product, sku: sku, qty: qty, price: price });
    });
    if (!picks.length) {
      toast(skipped ? '未帶入：請確認已選出貨倉有庫存' : '請先把要帶入的尺寸數量改成 1 以上，再一次加入');
      return;
    }
    var addedPicks = [];
    picks.forEach(function (pick) {
      rememberOrderPrice(pick.product, pick.sku, pick.price);
      if (addOrIncrementLiveSku(pick.product, pick.sku, pick.qty, pick.price)) addedPicks.push(pick);
    });
    if (!addedPicks.length) {
      toast(skipped ? '未帶入：請確認已選出貨倉有庫存' : '請先把要帶入的尺寸數量改成 1 以上，再一次加入');
      return;
