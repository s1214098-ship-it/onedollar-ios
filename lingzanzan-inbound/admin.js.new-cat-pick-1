      });
    });
    var timer = null;
    page.addEventListener('input', function (event) {
      if (!event.target.matches('[data-order-demand-query]')) return;
      orderDemandPage = 1;
      window.clearTimeout(timer);
      timer = window.setTimeout(renderOrderTrackingDemandSummary, 220);
