      var key = String(section && section.getAttribute('data-freight-fifo-collapsible') || '');
      if (!key) return;
      // 部分瀏覽器會在重新 render 前吞掉 details 的原生 toggle，造成按了
      // 「展開名單」看似完全沒反應。這裡直接以狀態集合為準，只切換一次。
      event.preventDefault();
      event.stopPropagation();
      var opening = !freightFifoOpenSections.has(key);
      if (opening) freightFifoOpenSections.add(key);
      else freightFifoOpenSections.delete(key);

      // 先把 details 真正展開並顯示處理中，再於下一個畫面更新週期整理名單。
