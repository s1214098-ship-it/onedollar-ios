  function refreshOrdersAndInquiries(options) {
    options = options || {};
    if (adminCurrentFileName() === 'admin-preorders.html' && adminPreorderServerSearchActive) {
      return refreshAdminPreorderServerSearch();
    }
    if (adminOrdersInquiryRefreshRequest) {
