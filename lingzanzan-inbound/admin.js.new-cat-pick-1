  function freightFifoCreatePlanningContext() {
    var normalizedFreight = normalizeFreightTracking(state.freightTracking);
    var itemAllocatedQty = new Map();
    (normalizedFreight.items || []).forEach(function (freightItem) {
      (Array.isArray(freightItem && freightItem.customerLinks) ? freightItem.customerLinks : []).forEach(function (link) {
        var linkedId = String(link && (link.inquiryId || link.customerOrderNo) || '').trim();
        var linkedIndex = Number(link && link.itemIndex);
        var linkStatus = String(link && link.status || '').toLowerCase();
        if (!linkedId || !Number.isInteger(linkedIndex) || /cancel|release|取消|解除/.test(linkStatus)) return;
        var key = linkedId + '|' + linkedIndex;
        itemAllocatedQty.set(key, (itemAllocatedQty.get(key) || 0) + Math.max(0, Number(link && link.qty || 0)));
      });
    });
    var productById = new Map();
    (state.products || []).forEach(function (product) {
      productById.set(String(product && product.id || ''), product || {});
    });
    return {
      normalizedFreight: normalizedFreight,
      itemAllocatedQty: itemAllocatedQty,
      productById: productById,
      readyStockQty: new Map()
    };
  }

  function freightFifoComputeReadyRows(sourceRows) {
