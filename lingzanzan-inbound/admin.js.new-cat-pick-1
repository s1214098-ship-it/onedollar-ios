    return list.filter(function (order) {
      return orderSalesName(order) === owner;
    });
  }

  function orderQueueSort(a, b) {
    var completedA = isOverviewPendingOrder(a) ? 0 : 1;
    var completedB = isOverviewPendingOrder(b) ? 0 : 1;
    if (completedA !== completedB) return completedA - completedB;
    return orderVisibleTime(b) - orderVisibleTime(a);
  }

  function loadStockInquiries(options) {
    options = options || {};
    var login = currentLogin();
    var role = login.role === 'sales' ? 'sales' : 'admin';
    var sales = login.role === 'sales' ? (login.name || login.account || '') : '';
    var scopeKey = role + '::' + sales;
    var baseRequestKey = scopeKey + (options.strict ? '::strict' : '');
    if (!options.force && adminStockInquiryRequests[baseRequestKey]) return adminStockInquiryRequests[baseRequestKey];
    var sequence = Number(adminStockInquiryLoadSequences[scopeKey] || 0) + 1;
    adminStockInquiryLoadSequences[scopeKey] = sequence;
    var requestKey = options.force ? (baseRequestKey + '::force::' + sequence) : baseRequestKey;
    var request = fetch('./stock-inquiry-api.php?action=list&role=' + encodeURIComponent(role) + '&sales=' + encodeURIComponent(sales) + '&_=' + Date.now(), { cache: 'no-store' })
      .then(function (res) { if (!res.ok) throw new Error('preorder load ' + res.status); return res.json(); })
      .then(function (data) {
        if (options.strict && (!data || !Array.isArray(data.inquiries))) throw new Error('預購資料未完整載入，請重新搜尋');
        return Array.isArray(data.inquiries) ? data.inquiries : [];
      })
      .catch(function (error) { if (options.strict) throw error; return []; })
      .then(function (rows) {
        delete adminStockInquiryRequests[requestKey];
        var latest = adminStockInquiryLatestRequests[scopeKey];
        if (sequence < Number(adminStockInquiryLoadSequences[scopeKey] || 0) && latest && latest !== request) return latest;
        return rows;
      }, function (error) {
        delete adminStockInquiryRequests[requestKey];
        throw error;
      });
    adminStockInquiryRequests[requestKey] = request;
    adminStockInquiryLatestRequests[scopeKey] = request;
    return request;
  }

  function adminPreorderServerSearchStatus(message, stateName) {
    var host = document.querySelector('[data-preorder-fifo-search-status]');
    if (!host) return;
