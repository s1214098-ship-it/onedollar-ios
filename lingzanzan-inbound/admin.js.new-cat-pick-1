  function logisticsType(row) {
    var post = row.postNo || '';
    var blob = [post, row.status, row.note].join(' ');
    if (row.sevenNo) return '711';
    if (row.familyNo) return 'family';
    if (/hct|新竹/i.test(blob)) return 'hct';
    if (/ktj|大榮|大荣|kerry/i.test(blob)) return 'ktj';
    if (/post|郵/i.test(post)) return 'post';
    if (/宅配/i.test(blob)) return 'home';
    if (/異常|未達|拒收|退|改址/i.test([row.status, row.returnFlag, row.note].join(' '))) return 'abnormal';
    return post ? 'post' : '711';
  }

