  function preorderFreightAllocationCandidates(row) {
    var orderItems = Array.isArray(row && row.items) ? row.items : [];
    // Taiwan FIFO planning is order-wide and comparatively expensive. Compute
    // it once per item before scanning every freight variant, otherwise a large
    // freight batch repeats the same all-order FIFO scan dozens of times.
    var taiwanSoftByItem = orderItems.map(function (_item, itemIndex) {
      return preorderTaiwanSoftAllocatedItemQty(row, itemIndex);
    });
    var candidates = [];
    freightTrackingForAllocation().items.forEach(function (freightItem) {
      if (freightItemClosesBatchQueueWithoutSelectionCheck(freightItem)) return;
      if (freightIsInternalUseItem(freightItem)) return;
      var links = Array.isArray(freightItem.customerLinks) ? freightItem.customerLinks : [];
      var itemRemaining = Math.max(0, freightItemSellableQty(freightItem) - links.reduce(function (sum, link) {
        return sum + Math.max(0, Number(link && link.qty || 0));
      }, 0));
      if (!itemRemaining) return;
      freightVariantLines(freightItem).forEach(function (line, variantIndex) {
        orderItems.forEach(function (orderItem, itemIndex) {
          var selectedSourceCode = String(orderItem && orderItem.sourceWarehouseCode || '').trim().toUpperCase();
          var selectedSourceLabel = String(orderItem && orderItem.sourceWarehouse || '').trim();
          // 舊預購單未記錄來源倉時仍依原規則視為預購倉；新單若人工改選
          // 台灣／中國／印尼倉，不能再被預購倉自動提撥程序重複占用。
          if ((selectedSourceCode && selectedSourceCode !== 'PREORDER') || (!selectedSourceCode && selectedSourceLabel && selectedSourceLabel.indexOf('預購') === -1)) return;
          var wanted = preorderOfficialProductIdentities(
            [orderItem.code || orderItem.productCode],
            [orderItem.sku, orderItem.skuId, orderItem.productId, orderItem.barcode]
          );
          var actual = preorderOfficialProductIdentities(
            [line.productCode, line.catalogProductCode, freightItem.productCode, freightItem.catalogProductCode],
            [line.productId, line.sampleBarcode, line.taiwanBarcode, freightItem.productId]
          );
          if (!Array.from(wanted).some(function (identity) { return actual.has(identity); })) return;
          if (!preorderSupplyVariantMatches(orderItem, line.color, line.size, line.productCode || line.catalogProductCode || line.sampleBarcode || freightItem.productCode)) return;
          var lineQty = freightLineSellableQty(line, freightItem);
          var variantLinked = links.filter(function (link) {
            return Number(link && link.variantIndex) === variantIndex || (String(link && link.barcode || '') && freightDemandIdentity(link.barcode) === freightDemandIdentity(line.sampleBarcode || line.taiwanBarcode || ''));
          }).reduce(function (sum, link) { return sum + Math.max(0, Number(link && link.qty || 0)); }, 0);
          var available = Math.min(itemRemaining, Math.max(0, lineQty - variantLinked));
          var orderedQty = Math.max(1, Number(orderItem.qty || orderItem.quantity || 1));
          // Count reservations across every freight record, not only the
          // currently edited package. The same customer line can otherwise
          // be reserved once by an old imported package and again by a new
          // package carrying the same product/color/size.
          var alreadyForOrder = preorderExistingFreightAllocatedItemQty(row.id, itemIndex);
          // 客戶已指定預購倉時，台灣現貨軟保留不可再把預購倉可提撥數量扣成 0。
          var taiwanSoftAllocated = (selectedSourceCode === 'PREORDER' || (!selectedSourceCode && (!selectedSourceLabel || selectedSourceLabel.indexOf('預購') !== -1)))
            ? 0
            : Math.max(0, Number(taiwanSoftByItem[itemIndex] || 0));
          var needed = Math.max(0, orderedQty - alreadyForOrder - taiwanSoftAllocated);
          if (!available || !needed) return;
          candidates.push({ freightItem: freightItem, line: line, variantIndex: variantIndex, itemIndex: itemIndex, available: available, needed: needed, suggested: Math.min(available, needed) });
        });
      });
    });
    return candidates;
  }

  function preorderFreightColorWarnings(row) {
    var orderItems = Array.isArray(row && row.items) ? row.items : [];
    var warnings = [];
    var seen = new Set();
    normalizeFreightTracking(state.freightTracking).items.forEach(function (freightItem) {
      if (freightItemClosesBatchQueueWithoutSelectionCheck(freightItem)) return;
      freightVariantLines(freightItem).forEach(function (line) {
        orderItems.forEach(function (orderItem) {
          var wanted = preorderOfficialProductIdentities(
            [orderItem.code || orderItem.productCode],
            [orderItem.sku, orderItem.skuId, orderItem.productId, orderItem.barcode]
          );
          var actual = preorderOfficialProductIdentities(
            [line.productCode, line.catalogProductCode, freightItem.productCode, freightItem.catalogProductCode],
            [line.productId, line.sampleBarcode, line.taiwanBarcode, freightItem.productId]
          );
          if (!Array.from(wanted).some(function (identity) { return actual.has(identity); })) return;
          var wantedSize = freightDemandIdentity(canonicalProductVariantSize(preorderItemSize(orderItem)));
          var actualSize = freightDemandIdentity(canonicalProductVariantSize(line.size || 'NO SIZE'));
          var sizeIsOpen = !wantedSize || /未填|未帶尺寸|未帶|無尺寸|NO SIZE|NONE|UNKNOWN/.test(wantedSize);
          if (!sizeIsOpen && wantedSize !== actualSize) return;
          var orderColor = preorderItemColor(orderItem);
          var actualProductCode = line.productCode || line.catalogProductCode || line.sampleBarcode || freightItem.productCode;
          var productSpecificOrderColor = freightAllocationColorKey(canonicalProductSpecificVariantColor(preorderItemCode(orderItem), orderColor));
          var productSpecificFreightColor = freightAllocationColorKey(canonicalProductSpecificVariantColor(actualProductCode, line.color));
          if (productSpecificOrderColor && productSpecificOrderColor === productSpecificFreightColor) return;
          if (!freightAllocationSimilarColor(orderColor, line.color)) return;
          var key = [freightItem.trackingNo, line.productCode || freightItem.productCode, orderColor, line.color, actualSize].join('|');
          if (seen.has(key)) return;
          seen.add(key);
          warnings.push({ trackingNo: freightItem.trackingNo || freightItem.pendingLogisticsCode || '待補物流單號', code: line.productCode || freightItem.productCode || '-', orderColor: orderColor, freightColor: line.color, size: line.size || 'NO SIZE' });
        });
      });
    });
    return warnings;
  }

