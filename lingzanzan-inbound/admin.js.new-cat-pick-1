  function savePreorderItemPrices(preorderId, button) {
    var rowIndex = (state.inquiries || []).findIndex(function (row) {
      return String(row && row.id || '') === String(preorderId || '');
    });
    if (rowIndex < 0) {
      toast('找不到這筆預購訂單，請先重新整理');
      return;
    }
    var card = button && button.closest ? button.closest('[data-preorder-card], [data-preorder-admin-delete-card]') : null;
    if (!card) {
      toast('找不到預購商品明細');
      return;
    }
    var priceRows = Array.from(card.querySelectorAll('[data-preorder-item-price]')).map(function (input) {
      return {
        index: Number(input.getAttribute('data-preorder-item-price')),
        skuId: input.getAttribute('data-preorder-item-sku') || '',
        price: Number(input.value)
      };
    });
    if (!priceRows.length || priceRows.some(function (item) {
      return !Number.isInteger(item.index) || !Number.isFinite(item.price) || item.price < 0;
    })) {
      toast('請輸入正確的商品單價');
      return;
    }
    button.disabled = true;
    button.textContent = '儲存中…';
    callStockInquiryApi({
      action: 'update-prices',
      inquiryId: preorderId,
      priceRows: priceRows
    }).then(function (data) {
      if (data && data.inquiry) state.inquiries[rowIndex] = data.inquiry;
      return refreshOrdersAndInquiries();
    }).then(function () {
      toast('商品單價與訂單總額已更新');
    }).catch(function (error) {
      toast(error.message || '商品單價更新失敗');
    }).finally(function () {
      button.disabled = false;
      button.textContent = '儲存商品單價';
    });
  }

  function savePreorderMeta(preorderId) {
    var statusInput = document.querySelector('[data-preorder-purchase-status="' + preorderId + '"]');
    var noteInput = document.querySelector('[data-preorder-purchase-note="' + preorderId + '"]');
    var platformInput = document.querySelector('[data-preorder-purchase-platform="' + preorderId + '"]');
    var carrierInput = document.querySelector('[data-preorder-supplier-carrier="' + preorderId + '"]');
    var trackingInput = document.querySelector('[data-preorder-supplier-tracking="' + preorderId + '"]');
    var allocationNoteInput = document.querySelector('[data-preorder-allocation-note="' + preorderId + '"]');
    var warehouseInput = document.querySelector('[data-preorder-fulfill="' + preorderId + '"]');
    var waitStatusInput = document.querySelector('[data-preorder-wait-status="' + preorderId + '"]');
    var progressLogin = currentLogin();
    var purchaseStatus = statusInput ? normalizePreorderPurchaseStatus(statusInput.value) : 'not_ordered';
    var preorderRow = (state.inquiries || []).find(function (row) { return String(row.id || '') === String(preorderId || ''); });
    if (purchaseStatus === 'received' && !(preorderRow && preorderRow.inventoryReceived)) {
      toast('已到貨必須由採購進貨建檔確認，不能直接改狀態');
      return Promise.resolve();
    }
    var payload = {
      action: 'update-preorder-meta',
      inquiryId: preorderId,
      purchaseStatus: purchaseStatus,
      purchaseNote: noteInput ? noteInput.value : '',
      purchasePlatform: platformInput ? platformInput.value : '',
      supplierCarrier: carrierInput ? carrierInput.value : '',
      supplierTrackingNo: trackingInput ? trackingInput.value : '',
      allocationNote: allocationNoteInput ? allocationNoteInput.value : '',
      arrivalWarehouse: warehouseInput ? warehouseInput.value : 'TW',
      employeeName: progressLogin.name || progressLogin.account || '管理者'
    };
    if (waitStatusInput) payload.preorderWaitStatus = waitStatusInput.value;
    var saveButton = document.querySelector('[data-save-preorder-meta="' + CSS.escape(preorderId) + '"]');
    var saveStatus = document.querySelector('[data-preorder-meta-save-status="' + CSS.escape(preorderId) + '"]');
    if (saveButton) { saveButton.disabled = true; saveButton.textContent = '儲存中…'; }
    if (saveStatus) { saveStatus.textContent = '正在寫入正式資料…'; saveStatus.classList.remove('is-success', 'is-error'); }
    return callStockInquiryApi(payload).then(function (data) {
      if (!data || !data.inquiry || normalizePreorderPurchaseStatus(data.inquiry.purchaseStatus) !== purchaseStatus) {
        throw new Error('正式資料讀回的採購狀態不一致，請勿重複操作');
      }
      var savedRow = data.inquiry;
      var savedIndex = (state.inquiries || []).findIndex(function (row) { return String(row && row.id || '') === String(preorderId || ''); });
      if (savedIndex >= 0) state.inquiries[savedIndex] = savedRow;
      else state.inquiries = [savedRow].concat(state.inquiries || []);
      return loadAdminRealtimeRevision().then(function (revision) {
        if (revision) adminLastServerRevision = revision;
        adminAutoSyncQueued = false;
        document.body.setAttribute('data-admin-last-sync', new Date().toISOString());
        return savedRow;
      }).catch(function () { return savedRow; }).then(function (savedRow) {
        var nextStatus = document.querySelector('[data-preorder-meta-save-status="' + CSS.escape(preorderId) + '"]');
        if (nextStatus) {
          nextStatus.textContent = '✓ 已儲存成功：' + (savedRow.purchaseStatusLabel || preorderPurchaseStatusLabel(purchaseStatus));
          nextStatus.classList.add('is-success');
        }
        var nextCard = document.querySelector('[data-preorder-card="' + CSS.escape(preorderId) + '"]');
        if (nextCard) nextCard.scrollIntoView({ block: 'center' });
        toast(purchaseStatus === 'ordered' ? '已下單，這筆已移至預購等待區' : '✓ 預購採購與等待狀態已儲存成功');
      });
    }).catch(function (error) {
      var failedStatus = document.querySelector('[data-preorder-meta-save-status="' + CSS.escape(preorderId) + '"]');
      if (failedStatus) { failedStatus.textContent = '✕ 儲存失敗：' + (error.message || error); failedStatus.classList.add('is-error'); }
      toast('儲存採購紀錄失敗：' + (error.message || error));
    }).finally(function () {
      var currentButton = document.querySelector('[data-save-preorder-meta="' + CSS.escape(preorderId) + '"]');
      if (currentButton) { currentButton.disabled = false; currentButton.textContent = '儲存狀態與備註'; }
    });
  }

  function receivePreorderInventory(preorderId) {
    var warehouseInput = document.querySelector('[data-preorder-fulfill="' + CSS.escape(preorderId) + '"]');
    var warehouse = warehouseInput ? warehouseInput.value : 'TW';
    var freightEntry = window.LingzanzanInventoryFreightEntry;
    var receiptPayload = freightEntry && typeof freightEntry.payload === 'function' ? freightEntry.payload(preorderId) : {};
    if (receiptPayload && receiptPayload.error) {
      toast(receiptPayload.error);
      return;
    }
    if (!window.confirm('確定這張預購已實際到貨，並把數量加入所選倉庫嗎？此動作不可重複。')) return;
    callStockInquiryApi(Object.assign({ action: 'receive-preorder', inquiryId: preorderId, arrivalWarehouse: warehouse, receivedBy: (login && (login.name || login.account)) || '管理者' }, receiptPayload || {})).then(function () {
      return refreshPreorderAfterBulk('預購已到貨並加入庫存');
    }).catch(function (error) {
      toast('到貨入庫失敗：' + (error.message || error));
    });
  }

