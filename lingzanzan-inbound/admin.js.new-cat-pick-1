  function normalizeFreightIdentityNumber(value) {
    return String(value || '').trim().replace(/\s+/g, '').toUpperCase();
  }

  function freightPendingPlatformCode(platform) {
    var token = canonicalPurchasePlatformName(platform);
    var codes = {
      '拚直': 'PZHI', '拼直': 'PZHI', '拚郭': 'PGUO', '拼郭': 'PGUO',
      '拚張': 'PZHANG', '拼張': 'PZHANG', '拚A': 'PA', '拼A': 'PA',
      '拚電': 'PD', '拼電': 'PD', '拼多多': 'PDD', '掏寶': 'TB',
      '淘寶': 'TB', '抖音': 'DY', '豪鴻': 'HH', '其他': 'OT'
    };
    if (codes[token]) return codes[token];
    var fallback = normalizeFreightIdentityNumber(token).replace(/[^A-Z0-9]/g, '').slice(0, 6);
    return fallback || 'PO';
  }

  function freightPlatformFromPendingCode(code) {
    var prefix = String(code || '').trim().toUpperCase().split('-')[0];
    var names = {
      PZHI: '拼直',
      PGUO: '拼郭',
      PZHANG: '拼張',
      PA: '拼A',
      PD: '拼電',
      PDD: '拼多多',
      TB: '淘寶',
      DY: '抖音',
      HH: '豪鴻',
      OT: '其他'
    };
    return names[prefix] || '';
  }

  function recoverFreightPlatformFromForm() {
    var select = document.querySelector('[data-freight-platform]');
    var current = String(select && select.value || '').trim();
    if (current) return current;
    var pending = String(document.querySelector('[data-freight-pending-code]')?.value || '').trim();
    var inferred = freightPlatformFromPendingCode(pending);
    if (!inferred) return '';
    if (select) {
      addFreightChoiceOption('[data-freight-platform]', inferred);
      select.value = inferred;
    }
    return inferred;
  }

  function freightPendingCodeBase(platform, date, purchaseOrderNo) {
    var orderToken = normalizeFreightIdentityNumber(purchaseOrderNo).replace(/[^A-Z0-9]/g, '');
    if (!orderToken) return '';
    var lastSix = orderToken.slice(-6).padStart(6, '0');
    var dateToken = String(date || freightToday()).replace(/[^0-9]/g, '').slice(-6).padStart(6, '0');
    return freightPendingPlatformCode(platform) + '-' + dateToken + '-' + lastSix;
  }

  function freightPendingCodeForForm() {
    var currentId = String(document.querySelector('[data-freight-item-id]')?.value || '');
    var existingCode = String(document.querySelector('[data-freight-pending-code]')?.value || '').trim();
    if (currentId && existingCode) return existingCode;
    var purchaseOrderNo = String(document.querySelector('[data-freight-purchase-order-no]')?.value || '').trim();
    var base = freightPendingCodeBase(
      document.querySelector('[data-freight-platform]')?.value || recoverFreightPlatformFromForm(),
      document.querySelector('[data-freight-item-date]')?.value || freightToday(),
      purchaseOrderNo
    );
    if (!base) return '';
    var used = new Set(normalizeFreightTracking(state.freightTracking).items.filter(function (item) {
      return String(item.id || '') !== currentId;
    }).map(function (item) {
      return normalizeFreightIdentityNumber(item.pendingLogisticsCode || item.pendingTrackingCode || '');
    }).filter(Boolean));
    var sequence = 1;
    var candidate = base + '-' + String(sequence).padStart(2, '0');
    while (used.has(normalizeFreightIdentityNumber(candidate))) {
      sequence += 1;
      candidate = base + '-' + String(sequence).padStart(2, '0');
    }
    return candidate;
  }

  function syncFreightPendingIdentity() {
    var purchaseOrderNo = String(document.querySelector('[data-freight-purchase-order-no]')?.value || '').trim();
    var trackingNo = String(document.querySelector('[data-freight-tracking-no]')?.value || '').trim();
    var codeInput = document.querySelector('[data-freight-pending-code]');
    var status = document.querySelector('[data-freight-pending-state]');
    var code = freightPendingCodeForForm();
    if (codeInput) codeInput.value = code;
    if (!status) return code;
    status.classList.toggle('is-assigned', !!trackingNo);
    status.classList.toggle('is-waiting', !!purchaseOrderNo && !trackingNo);
    if (trackingNo) status.textContent = '已補正式物流號；兩組識別碼仍保留';
    else if (purchaseOrderNo) status.textContent = '待補正式物流號｜' + (code || '儲存時產生');
    else status.textContent = '尚未輸入平台採購訂單號';
    return code;
  }

  function freightNameAliases(value) {
    var rows = value;
    if (typeof value === 'string') {
      try { rows = JSON.parse(value || '[]'); } catch (error) { rows = value ? [value] : []; }
    }
    if (!Array.isArray(rows)) rows = [];
    var seen = new Set();
    return rows.map(function (item) { return String(item || '').trim(); }).filter(function (item) {
      var key = normalizeLiveCode(item);
      if (!key || seen.has(key)) return false;
      seen.add(key);
      return true;
    });
  }

  function mergeFreightNameAliases() {
    var merged = [];
    Array.prototype.slice.call(arguments).forEach(function (value) {
      freightNameAliases(value).forEach(function (alias) { merged.push(alias); });
    });
    return freightNameAliases(merged);
  }

