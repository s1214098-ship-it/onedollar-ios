  async function freightFifoShareImageFiles(imageUrls) {
    var files = [];
    for (var index = 0; index < Math.min(6, imageUrls.length); index += 1) {
      try {
        var response = await fetch(imageUrls[index], { credentials: 'same-origin', cache: 'no-store' });
        if (!response.ok) continue;
        var blob = await response.blob();
        if (!String(blob.type || '').startsWith('image/')) continue;
        var extension = String(blob.type || '').split('/')[1] || 'jpg';
        files.push(new File([blob], '客戶出貨圖片-' + (index + 1) + '.' + extension.replace('jpeg', 'jpg'), { type: blob.type }));
      } catch (error) {
        // 個別圖片抓不到時仍繼續分享其他圖片與文字。
      }
    }
    return files;
  }

  function freightFifoCanShareFiles(files, text) {
    if (!navigator.share || !Array.isArray(files) || !files.length) return false;
    if (!navigator.canShare) return true;
    try {
      return navigator.canShare({ files: files, text: text || '' }) || navigator.canShare({ files: files });
    } catch (error) {
      return false;
    }
  }

  /* LZ_CARD_BIN_20260925: 出貨小卡／物流明細帶入倉架與艙位 */
  function freightFifoBlankBinPart(value) {
    var text = String(value || '').trim();
    if (!text) return true;
    if (isInvalidShelfName(text) || isInvalidLayerName(text)) return true;
    return /^(未設定|未指定|未填|不指定|不適用|無|-|—)/.test(text);
  }

  function freightFifoFirstBinPart(candidates) {
    var seen = [];
    (candidates || []).forEach(function (value) {
      if (Array.isArray(value)) {
        value.forEach(function (item) {
          var text = String(item || '').trim();
          if (text && seen.indexOf(text) === -1) seen.push(text);
        });
        return;
      }
      var text = String(value || '').trim();
      if (text && seen.indexOf(text) === -1) seen.push(text);
    });
    for (var i = 0; i < seen.length; i++) {
      if (!freightFifoBlankBinPart(seen[i])) return seen[i];
    }
    return '';
  }

  function freightFifoLookupItemSku(item) {
    item = item || {};
    var skus = Array.isArray(state.skus) ? state.skus : [];
    var wanted = {};
    ['skuId', 'sku', 'barcode', 'companyBarcode', 'officialBarcode', 'labelBarcode'].forEach(function (key) {
      var value = String(item[key] || '').trim();
      if (value) wanted[value] = true;
    });
    var wantedKeys = Object.keys(wanted);
    var match = null;
    if (wantedKeys.length) {
      match = skus.find(function (sku) {
        return [sku.id, sku.sku, sku.barcode, sku.companyBarcode, sku.officialBarcode, sku.labelBarcode].some(function (value) {
          return wanted[String(value || '').trim()];
        });
      }) || null;
    }
    if (match) return match;
    var productId = String(item.productId || '').trim();
    var code = String(item.code || item.productCode || '').trim().toUpperCase();
    var colorKey = freightAllocationColorKey(canonicalProductVariantColor(item.color || item.colorName || ''));
    var sizeKey = freightDemandIdentity(canonicalProductVariantSize(item.size || item.sizeName || 'NO SIZE'));
    var warehouseCode = String(item.sourceWarehouseCode || item.warehouseCode || '').trim().toUpperCase();
    if (!warehouseCode && (item.sourceWarehouse || item.warehouse)) {
      warehouseCode = String(normalizeWarehouseCode(item.sourceWarehouse || item.warehouse) || '').toUpperCase();
    }
    var candidates = skus.filter(function (sku) {
      var product = (state.products || []).find(function (row) { return String(row.id || '') === String(sku.productId || ''); }) || {};
      if (productId && String(sku.productId || '') !== productId) return false;
      if (!productId && code) {
        var productCode = String(product.code || sku.productCode || sku.code || '').trim().toUpperCase();
        if (productCode !== code) return false;
      }
      if (!productId && !code) return false;
      if (colorKey && freightAllocationColorKey(canonicalProductVariantColor(sku.colorName || sku.color || '')) !== colorKey) return false;
      if (sizeKey && freightDemandIdentity(canonicalProductVariantSize(sku.sizeName || sku.size || 'NO SIZE')) !== sizeKey) return false;
      return true;
    });
    if (warehouseCode) {
      var warehouseMatch = candidates.find(function (sku) {
        return String(warehouseCodeForRecord(sku) || sku.warehouseCode || '').toUpperCase() === warehouseCode;
      });
      if (warehouseMatch) return warehouseMatch;
    }
    return candidates[0] || null;
  }

  function freightFifoItemBinLocation(item) {
    item = item || {};
    var sku = freightFifoLookupItemSku(item) || {};
    var product = (state.products || []).find(function (row) {
      return String(row.id || '') === String(item.productId || sku.productId || '');
    }) || {};
    var shelf = freightFifoFirstBinPart([item.sourceShelf, item.shelf, item.shelfName, sku.shelf, sku.shelfName, sku.shelves, product.shelf, product.shelves]);
    var layer = freightFifoFirstBinPart([item.sourceLayer, item.layer, item.layerName, sku.layer, sku.layerName, sku.layers, product.layer, product.layers]);
    var warehouse = freightFifoFirstBinPart([item.sourceWarehouse, item.warehouse, sku.warehouseName, sku.warehouse, product.warehouse]);
    return {
      warehouse: warehouse,
      shelf: shelf,
      layer: layer,
      label: '倉架 ' + (shelf || '未設定') + '／艙位 ' + (layer || '未設定'),
      shortLabel: (shelf || '未設倉架') + '／' + (layer || '未設艙位')
