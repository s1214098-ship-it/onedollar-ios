  function rememberFreightReceivingContinuation(item) {
    if (!item || !item.id) return;
    sessionStorage.setItem(FREIGHT_RECEIVING_CONTINUATION_KEY, JSON.stringify({
      itemId: String(item.id || ''),
      trackingNo: String(item.trackingNo || ''),
      createdAt: new Date().toISOString()
    }));
  }

  function freightReceivingContinuation() {
    try {
      var raw = sessionStorage.getItem(FREIGHT_RECEIVING_CONTINUATION_KEY);
      if (!raw) return null;
      var value = JSON.parse(raw);
      if (!value || !value.itemId) return null;
      var age = Date.now() - new Date(value.createdAt || 0).getTime();
      if (!Number.isFinite(age) || age > 12 * 60 * 60 * 1000) {
        sessionStorage.removeItem(FREIGHT_RECEIVING_CONTINUATION_KEY);
        return null;
      }
      return value;
    } catch (error) {
      sessionStorage.removeItem(FREIGHT_RECEIVING_CONTINUATION_KEY);
      return null;
    }
  }

  function resumeFreightReceivingFromUrl() {
    if (freightReceivingContinuationOpened || (location.pathname.split('/').pop() || '') !== 'admin-freight.html') return;
    var itemId = String(new URLSearchParams(location.search).get('resumeFreightReceive') || '').trim();
    if (!itemId) return;
    freightReceivingContinuationOpened = true;
    var cleanUrl = new URL(location.href);
    cleanUrl.searchParams.delete('resumeFreightReceive');
    history.replaceState(null, '', cleanUrl.pathname + (cleanUrl.searchParams.toString() ? '?' + cleanUrl.searchParams.toString() : '') + cleanUrl.hash);
    // This hook runs inside loadFreightTracking. Waiting for another full
    // refresh here can wait on that same in-flight freight request.
    ensureAdminFreightCatalogLoaded(adminFreightDeferredServerFiles).then(function (loaded) {
      if (!loaded) throw new Error('正式商品資料尚未載入，請重試；不需重新建檔');
      var item = freightItemById(itemId);
      if (!item) {
        toast('產品已建立，但找不到原物流單，尚未正式入庫');
        return;
      }
      var readiness = freightFormalReceiptReadiness(item);
      if (!readiness.ready) {
        showFreightProductConfirmationRequired(item, readiness);
        toast('實收數量仍保留；產品或 SKU 連結尚未完成，沒有增加庫存');
        return;
      }
      sessionStorage.removeItem(FREIGHT_RECEIVING_CONTINUATION_KEY);
      setTimeout(function () {
        openFreightReceivingWorkbench(itemId, { prefillExpected: false, fromArrival: true });
        toast('產品與物流已連結；請確認正式入庫與列印條碼');
      }, 120);
    }).catch(function (error) {
      toast('回到原物流單失敗：' + (error.message || error));
    });
  }

