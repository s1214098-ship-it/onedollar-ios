    freightPostJsonWithTimeout({ action: 'save-receiving-inspection', freightItemId: itemId, lines: lines, goodsPurpose: goodsPurpose, inventoryBusinessUnit: selectedBusinessUnit, destinationWarehouse: selectedDestination, category: selectedCategory, varianceReason: reason, final: !!finalize }, 30000).then(function (payload) {
      var index = state.freightTracking.items.findIndex(function (row) { return String(row.id || '') === String(itemId); });
      if (index >= 0 && payload.item) state.freightTracking.items[index] = payload.item;
      if (payload.revision !== undefined) state.freightTracking.revision = payload.revision;
      if (!finalize) {
        toast('點貨進度已暫存；尚未改庫存或成本');
        modal.remove();
        renderFreightTracking();
        return null;
      }
      return continueFreightReceivingAfterInspection(itemId, actual, expected, button, modal, actionStatus, allocationMode, selectedDestination, confirmReleaseCustomerReservations, selectedStockPurpose);
    }).catch(function (error) {
      if (button) {
        button.disabled = false;
        button.textContent = button.getAttribute('data-idle-label') || (finalize ? '點貨完成 → 核准正式入庫' : '暫存點貨／尚未結案');
