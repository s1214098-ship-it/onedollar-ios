  function purchaseStatsRoot() {
    return document.querySelector('[data-purchase-stats]');
  }

  function purchaseStatsTaipeiDay() {
    var now = new Date();
    try {
      var parts = new Intl.DateTimeFormat('en-US', {
        timeZone: 'Asia/Taipei',
        year: 'numeric',
        month: '2-digit',
        day: '2-digit'
      }).formatToParts(now);
      var values = {};
      parts.forEach(function (part) {
        if (part.type !== 'literal') values[part.type] = part.value;
      });
      return values.year + '-' + values.month + '-' + values.day;
    } catch (error) {
      return new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    }
  }

  function purchaseStatsShiftDay(day, amount) {
    var parts = String(day || '').split('-').map(Number);
    if (parts.length !== 3 || !parts[0] || !parts[1] || !parts[2]) return purchaseStatsTaipeiDay();
    var value = new Date(Date.UTC(parts[0], parts[1] - 1, parts[2] + Number(amount || 0), 12, 0, 0));
    return value.toISOString().slice(0, 10);
  }

  function purchaseStatsDateLabel(day) {
    var parts = String(day || '').split('-');
    if (parts.length !== 3) return String(day || '-');
    return Number(parts[1]) + '/' + Number(parts[2]);
  }

  function purchaseStatsRange() {
    var root = purchaseStatsRoot();
    var today = purchaseStatsTaipeiDay();
    var mode = String((root && root.querySelector('[data-purchase-date-mode]') || {}).value || 'day');
    var fromInput = root && root.querySelector('[data-purchase-date-from]');
    var toInput = root && root.querySelector('[data-purchase-date-to]');
    var from = String(fromInput && fromInput.value || today);
    var to = mode === 'range' ? String(toInput && toInput.value || from) : from;
    if (to < from) {
      var originalFrom = from;
      from = to;
      to = originalFrom;
      if (fromInput) fromInput.value = from;
      if (toInput) toInput.value = to;
    }
    return { mode: mode, from: from, to: to };
  }

  function purchaseStatsMutationId(prefix) {
    if (window.crypto && typeof window.crypto.randomUUID === 'function') {
      return String(prefix || 'purchase') + '-' + window.crypto.randomUUID();
    }
    return String(prefix || 'purchase') + '-' + Date.now() + '-' + Math.random().toString(16).slice(2);
  }

  function purchaseStatsNumber(value) {
