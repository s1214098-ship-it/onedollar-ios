  function freightFifoIdentityTokens(value) {
    var token = normalizeLiveCode(value || '');
    if (!token) return [];
    var base = token.replace(/P\d+$/i, '');
    return base && base !== token ? [token, base] : [token];
  }

  function freightFifoScopeLines(items) {
    return (items || []).reduce(function (rows, item) {
      var variants = freightVariantLines(item);
      if (!variants.length) variants = [item || {}];
      variants.forEach(function (line) {
        var identities = [
          item && item.productCode,
          item && item.productFiledProductCode,
          item && item.productFiledBarcode,
          item && item.sampleBarcode,
          item && item.taiwanBarcode,
          line && line.productCode,
