  function preorderPurchaseStatusLabel(value) {
    var map = {
      not_ordered: '待下單',
      ordered: '已下單／進入預購等待',
      preparing: '已下單／進入預購等待',
      arrived: '物流運送中',
      received: '已到貨入庫',
      shipped: '已出貨（行政）',
      ready_to_ship: '商品已齊／准許出貨',
      completed: '已出貨（行政）'
    };
    return map[normalizePreorderPurchaseStatus(value)] || map.not_ordered;
  }

  function preorderFormalOrder(row) {
    row = row || {};
    return (state.orders || []).find(function (order) {
      return String(order.id || '') === String(row.orderId || '') || String(order.sourceInquiryId || '') === String(row.id || '');
    }) || null;
  }

  function preorderWorkflowStatus(row) {
    row = row || {};
    var converted = row.status === 'converted' || !!row.preorderConvertedAt || !!row.orderId;
    var normalizedStatus = normalizePreorderPurchaseStatus(row.purchaseStatus);
    var received = !!row.inventoryReceived || normalizedStatus === 'received';
    var reserved = !!row.reserved;
    var status = received ? 'received' : normalizedStatus;
    var waitStatus = preorderWaitStatusValue(row);
    var stage = 0;
    if (status === 'ordered') stage = 1;
    else if (status === 'arrived') stage = 2;
    else if (status === 'received' || received || reserved) stage = 3;
    if (converted) stage = 4;
    var formalOrder = preorderFormalOrder(row);
    var shipmentLabel = converted
      ? (formalOrder ? orderStatusLabel(formalOrder) : '已轉正式出貨單')
      : (reserved
        ? '現貨已保留／可以轉正式出貨'
        : (received
          ? (waitStatus === 'ready_to_ship' ? '商品已齊／准許出貨' : '累計訂單／等待其他預購商品')
          : (status === 'arrived' ? '物流配送中／預購等待' : (status === 'ordered' ? '已下單／預購等待' : '待採購下單'))));
    return { stage: stage, converted: converted, received: received, reserved: reserved, waitStatus: waitStatus, formalOrder: formalOrder, shipmentLabel: shipmentLabel };
  }

  function preorderWorkflowProgressHtml(row) {
    var info = preorderWorkflowStatus(row);
