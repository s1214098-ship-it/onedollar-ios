    if (catalogBySku && catalogBySku.product) return catalogBySku.product;
    var catalogByProduct = catalogRows.find(function (row) {
      var product = row.product || {};
      return [product.code, product.id, product.productCode, product.productLine].some(function (field) {
        return aliases.indexOf(normalizeLiveCode(field)) !== -1;
