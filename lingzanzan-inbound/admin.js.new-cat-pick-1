        customerAddress: address,
        storeAddress: shipping.storeAddress,
        homeAddress: shipping.homeAddress,
        addressPrimary: shipping.addressPrimary,
        customerName: name || formalCustomer.name || formalRow.customerName || sourceCustomer.name || sourceInquiry && sourceInquiry.customerName || '',
        customerPhone: phone || formalCustomer.phone || formalRow.customerPhone || sourceCustomer.phone || sourceInquiry && sourceInquiry.customerPhone || '',
        deliveryType: (feeSelect && feeSelect.value === 'id_self') ? 'indonesia_sales' : shipping.deliveryType,
        deliveryLabel: (feeSelect && feeSelect.value === 'id_self') ? '印尼業務自行出貨' : shipping.deliveryLabel,
        freightDispatchDecision: decision,
        shippingNote: shippingNote,
        shippingCarrier: shippingCarrier,
        trackingNo: trackingNo,
        outboundParcels: outboundParcels,
        clearTrackingNo: outboundParcels.length === 0,
        skipAutomaticTrackingDispatch: reservation.isHold,
        holdReason: reservation.holdReason || '',
        holdReasonText: reservation.holdReasonText || '',
        updatedBy: currentLogin().name || currentLogin().account || '管理者'
      }).then(function (data) {
        var next = function (saved) {
          if (!imagesChanged) return saved;
          return callOrderAdmin({
            action: 'update-customer-images',
            orderId: orderId,
            images: (modal._freightCustomerImages || []).slice(0, 12),
            updatedBy: currentLogin().name || currentLogin().account || '管理者'
          }).then(function () { return saved; }).catch(function (error) {
            console.warn('[freight-fifo] customer images not saved', error);
            return saved;
          });
        };
        return saveInquiryShipping(data).then(next).catch(function () { return next(data); });
      }).catch(function (error) {
        if (!preorderId) throw error;
        return saveInquiryShipping();
      });
    }
    if (!preorderId) return Promise.reject(new Error('找不到客戶訂單編號'));
    return saveInquiryShipping();
  }

  function applyFreightFifoCustomerDetailsLocally(modal, payload) {
    if (!modal) return;
    var preorderId = String(modal.getAttribute('data-preorder-id') || '');
    var orderId = String(modal.getAttribute('data-order-id') || '');
    var name = String((modal.querySelector('[data-freight-fifo-name]') || {}).value || '').trim();
