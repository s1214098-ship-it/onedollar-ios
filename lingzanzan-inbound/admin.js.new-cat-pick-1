        line.pending = Math.max(0, line.requested - line.reserved - line.covered);
        available -= line.covered;
        line.summary.reserved += line.reserved;
        line.summary.covered += line.covered;
        line.summary.pending += line.pending;
        delete line.variantKey;
        delete line.summary;
      });
    });
    orderTrackingCoverageByOrder = result;
  }

  function orderTrackingCoverageHtml(entry) {
    if (!entry || entry.category !== 'preorder' || entry.kind !== 'inquiry') return '';
    var coverage = orderTrackingCoverageByOrder[String(entry.record && entry.record.id || '')];
    if (!coverage || !coverage.requested) return '';
    var purchaseStatus = normalizePreorderPurchaseStatus(entry.record && entry.record.purchaseStatus);
    var alreadyOrdered = ['ordered', 'arrived', 'received'].indexOf(purchaseStatus) >= 0 || ['ordered', 'shipped', 'arrived_store', 'delivered'].indexOf(entry.stage) >= 0;
    var preparedQty = Math.min(coverage.requested, Math.max(0, Number(coverage.reserved || 0)) + Math.max(0, Number(coverage.covered || 0)));
    var label;
    var stateClass;
    if (coverage.reserved >= coverage.requested) {
      label = '預購倉名額已保留（不等於台灣現貨）';
      stateClass = 'is-reserved';
    } else if (preparedQty >= coverage.requested) {
      label = '預購倉數量已備妥';
      stateClass = 'is-covered';
    } else if (alreadyOrdered) {
      label = purchaseStatus === 'arrived' ? '配送中／預購倉準備中' : '已採購／預購倉準備中';
      stateClass = 'is-covered';
    } else if (coverage.pending) {
      label = '尚需採購 ' + coverage.pending + ' 件';
      stateClass = 'is-shortage';
    } else {
      label = '預購倉數量已備妥';
      stateClass = 'is-covered';
    }
    var details = coverage.lines.map(function (line) {
      var result;
      if (line.reserved >= line.requested) result = '預購名額已綁 ' + line.reserved + '，實物到貨狀態請看上方';
      else if ((line.reserved + line.covered) >= line.requested) result = '預購倉可直接分配 ' + (line.requested - line.reserved);
      else if (alreadyOrdered) result = '已採購，等待配送入預購倉 ' + (line.requested - line.reserved);
      else if (line.pending) result = '尚需採購 ' + line.pending;
