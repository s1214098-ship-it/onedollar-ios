    else params.set('browse', '1');
    params.set('page', String(Math.max(1, Number(page || 1))));
    params.set('limit', String(PREORDER_PAGE_SIZE));
    params.set('sales', String(sales && sales.value || 'all'));
    params.set('status', String(status && status.value || 'all'));
    params.set('_', String(Date.now()));
    return params;
  }

  function loadAdminPreordersFromServerSearch(query, page) {
    if (adminCurrentFileName() !== 'admin-preorders.html') return Promise.resolve(false);
    query = String(query || '').trim();
    var compactPhone = query.replace(/[^0-9]/g, '');
    var phoneLike = !!query && /^[0-9\s()+-]+$/.test(query);
    if (phoneLike && adminOrderSearchIsTooShort(query)) {
      if (adminPreorderServerSearchController) adminPreorderServerSearchController.abort();
      adminPreorderServerSearchStatus(adminOrderSearchMinimumMessage(query), 'short-query');
      return Promise.resolve(false);
    }
    if (query && !phoneLike && query.length < 2) {
      if (adminPreorderServerSearchController) adminPreorderServerSearchController.abort();
      adminPreorderServerSearchStatus('客戶姓名、產品或訂單資料請至少輸入 2 個字。', 'short-query');
      return Promise.resolve(false);
    }
    adminPreorderServerSearchSequence += 1;
    var sequence = adminPreorderServerSearchSequence;
    if (adminPreorderServerSearchController) adminPreorderServerSearchController.abort();
    var controller = typeof AbortController === 'function' ? new AbortController() : null;
    adminPreorderServerSearchController = controller;
    adminPreorderServerSearchActive = true;
    adminPreorderServerSearchStatus(query ? '正在搜尋「' + query + '」…' : '正在讀取第 ' + Math.max(1, Number(page || 1)) + ' 頁預購名單…', 'loading');
    var list = document.querySelector('[data-preorder-list]');
    if (list && !(state.inquiries || []).length) list.innerHTML = '<div class="empty">正在從伺服器讀取，每次只載入 10 筆…</div>';
    return fetch('./admin-preorder-search-api.php?' + adminPreorderServerSearchParams(query, page).toString(), {
      cache: 'no-store',
      credentials: 'same-origin',
      signal: controller ? controller.signal : undefined
    }).then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (data) {
        if (!res.ok || !data.ok) throw new Error(data.error || ('預購搜尋失敗 ' + res.status));
        return data;
      });
    }).then(function (data) {
      if (sequence !== adminPreorderServerSearchSequence) return false;
      state.inquiries = Array.isArray(data.inquiries) ? data.inquiries : [];
      adminPreorderServerSearchTotal = Math.max(0, Number(data.count || 0));
      adminPreorderServerSearchPages = Math.max(1, Number(data.pages || 1));
      adminPreorderServerSearchPage = Math.max(1, Number(data.page || 1));
      adminPreorderServerSearchMs = Math.max(0, Number(data.serverMs || 0));
      adminPreorderServerSalesOptions = Array.isArray(data.salesOptions) ? data.salesOptions.slice() : [];
      preorderListPage = adminPreorderServerSearchPage;
      renderOrders();
      return true;
    }).catch(function (error) {
      if (error && error.name === 'AbortError') return false;
      if (sequence !== adminPreorderServerSearchSequence) return false;
      adminPreorderServerSearchStatus(error && error.message ? error.message : '預購搜尋失敗，請稍後再試。', 'error');
      return false;
    }).then(function (result) {
      if (sequence === adminPreorderServerSearchSequence) adminPreorderServerSearchController = null;
      return result;
    });
  }

  function refreshAdminPreorderServerSearch() {
    if (adminCurrentFileName() !== 'admin-preorders.html' || !adminPreorderServerSearchActive) return Promise.resolve(false);
    var search = document.querySelector('[data-order-search]');
    return loadAdminPreordersFromServerSearch(search && search.value || '', adminPreorderServerSearchPage);
