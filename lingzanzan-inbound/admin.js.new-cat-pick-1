  function freightArrivalSelectableCustoms(currentBatch) {
    var currentBatchId = String(currentBatch && currentBatch.id || '');
    var usedByOtherBatch = {};
    normalizeFreightTracking(state.freightTracking).batches.forEach(function (batch) {
      if (!batch || String(batch.id || '') === currentBatchId) return;
      freightCustomsIdentity(batch).forEach(function (key) { usedByOtherBatch[key] = true; });
    });
    return (state.baohuiCustoms || []).filter(function (row) {
      if (!row || row.taxFreeWarehouse || !String(row.customsNo || row.taiwanTrackingNo || '').trim()) return false;
      var keys = freightCustomsIdentity(row);
      return !keys.some(function (key) { return usedByOtherBatch[key]; });
    });
  }

  function fetchBaohuiCustomsLookup(extraQuery) {
    var query = extraQuery ? String(extraQuery) : '';
    return fetch('./freight-customs-lookup.php?recent=45&_=' + Date.now() + query, { cache: 'no-store' }).then(function (response) {
      return response.json().then(function (payload) {
        if (!response.ok || !payload.ok) throw new Error(payload.error || '寶輝關稅資料讀取失敗');
        state.baohuiCustoms = Array.isArray(payload.matches) ? payload.matches : [];
        return state.baohuiCustoms;
      });
    });
  }

  function freightArrivalCustomsOptions(batch, scannedTrackingNo, optionsConfig) {
    optionsConfig = optionsConfig || {};
    var includeTaxFree = optionsConfig.includeTaxFree === true;
    var currentNo = String(batch && (batch.customsNo || batch.consolidationNo) || '').trim();
    var wanted = normalizeScanCode(scannedTrackingNo || '');
    var rows = freightArrivalSelectableCustoms(batch);
    var bestIndex = -1;
    rows.forEach(function (row, index) {
      if (bestIndex >= 0 || !wanted) return;
      var numbers = [row.customsNo, row.taiwanTrackingNo].concat(row.trackingNos || []);
      if (numbers.some(function (number) { return normalizeScanCode(number) === wanted; })) bestIndex = index;
    });
    var options = '';
    if (includeTaxFree) {
      options += '<option value="TAX_FREE"' + (!currentNo && bestIndex < 0 ? ' selected' : '') + '>免稅批次（不需寶輝關稅號碼）</option>';
    }
    options += '<option value="">請選寶輝關稅號碼' + (includeTaxFree ? '（有關稅時改選）' : '（必選）') + '</option>';
    if (currentNo) options += '<option value="CURRENT" selected>沿用本批：' + escapeHtml(currentNo) + '</option>';
    options += rows.map(function (row, index) {
      var globalIndex = (state.baohuiCustoms || []).indexOf(row);
      var selected = !currentNo && index === bestIndex ? ' selected' : '';
      var label = [row.date || '未填日期', row.customsNo || '未填關稅號', row.taiwanTrackingNo || '', '共 ' + Number(row.logisticsPieces || row.declaredQty || row.itemCount || row.customsPackageCount || 0) + ' 件'].filter(Boolean).join('／');
      return '<option value="BAOHUI:' + globalIndex + '"' + selected + '>' + escapeHtml(label) + '</option>';
    }).join('');
    return options;
  }

  function freightBatchHasFormalInventoryReceipt(batch) {
    if (!batch) return false;
    var batchId = String(batch.id || '');
    var rows = freightBatchPackageRows(batch);
    var itemIds = new Set(rows.map(function (row) {
      return String(row && (row.id || row.sourceItemId) || '');
    }).filter(Boolean));
    return normalizeFreightTracking(state.freightTracking).items.some(function (item) {
      var belongs = String(item.batchId || '') === batchId || itemIds.has(String(item.id || item.sourceItemId || ''));
      return belongs && freightItemClosesBatchQueueWithoutSelectionCheck(item);
    });
  }

