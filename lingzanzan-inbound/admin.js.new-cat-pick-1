  function captureScreenImage() {
    if (!navigator.mediaDevices || !navigator.mediaDevices.getDisplayMedia) {
      toast('瀏覽器不支援直接截圖，請用 Windows 剪刀工具截圖後貼上');
      return Promise.resolve('');
    }
    return navigator.mediaDevices.getDisplayMedia({ video: true }).then(function (stream) {
      return new Promise(function (resolve) {
        var video = document.createElement('video');
        video.srcObject = stream;
        video.onloadedmetadata = function () {
          video.play();
          setTimeout(function () {
            var canvas = document.createElement('canvas');
            canvas.width = video.videoWidth;
            canvas.height = video.videoHeight;
            canvas.getContext('2d').drawImage(video, 0, 0);
            stream.getTracks().forEach(function (track) { track.stop(); });
            resolve(canvas.toDataURL('image/jpeg', 0.9));
          }, 180);
        };
      });
    }).catch(function () {
      toast('已取消截圖');
      return '';
    });
  }

  function splitImageUrls(text) {
    return String(text || '').split(/[\n,]+/).map(function (item) {
      return item.trim();
    }).filter(Boolean);
  }

  function parseCsv(text) {
    var rows = [];
    var row = [];
    var cell = '';
    var quoted = false;
    for (var i = 0; i < text.length; i += 1) {
      var ch = text[i];
      var next = text[i + 1];
      if (quoted) {
        if (ch === '"' && next === '"') {
          cell += '"';
          i += 1;
        } else if (ch === '"') {
          quoted = false;
        } else {
          cell += ch;
        }
      } else if (ch === '"') {
        quoted = true;
      } else if (ch === ',') {
        row.push(cell);
        cell = '';
      } else if (ch === '\n') {
        row.push(cell);
        rows.push(row);
        row = [];
        cell = '';
      } else if (ch !== '\r') {
        cell += ch;
      }
    }
    row.push(cell);
    rows.push(row);
    return rows;
  }

  function normalizeSizeLabel(value) {
    return String(value || '').replace(/Ｍ/g, 'M').replace(/Ｌ/g, 'L').replace(/Ｘ/g, 'X').replace(/\s+/g, ' ').trim();
  }

  function normalizeBarcode(value) {
    var code = String(value || '').trim().toUpperCase();
    var p = code.indexOf('P');
    return p > 0 ? code.slice(0, p) : code;
  }

  function normalizeSheetProductCode(value) {
    var code = String(value || '').trim().toUpperCase();
    var p = code.indexOf('P');
    if (p > 0 && /^P\d+9\d*/.test(code.slice(p))) return code.slice(0, p);
    return code;
  }

  function parseLocationRow(value) {
    var text = String(value || '').trim();
    var match = text.match(/^([A-Z])\s*倉.*?(第[一二三四五六七八九十\d]+層)/i);
    if (!match) return null;
    return { shelf: match[1].toUpperCase() + '架', layer: match[2] };
  }

  function importTaiwanStockByCode() {
    var input = document.querySelector('[data-new-product-code]');
    var code = normalizeSheetProductCode(input?.value || '');
    if (!code) {
      toast('請先輸入產品條碼');
      return;
    }
    productDraftMessage('讀取台灣現貨倉中...');
    var url = './tw-stock-csv.php?_=' + Date.now();
    fetch(url, { cache: 'no-store' }).then(function (res) {
      if (!res.ok) throw new Error('台灣現貨倉 ' + res.status);
      return res.text();
    }).catch(function () {
      return fetch('https://docs.google.com/spreadsheets/d/1W1mXSNeDe3OPFYnAS2djTOGg0dqQktbkTzZ2kxxVk4w/export?format=csv&gid=1888755320&_=' + Date.now(), { cache: 'no-store' }).then(function (res) {
        if (!res.ok) throw new Error('Google Sheet ' + res.status);
        return res.text();
      });
    }).then(function (csv) {
      var rows = parseCsv(csv);
      var header = rows[1] || [];
      var sizeStart = 36;
      var sizeEnd = 51;
      var sizeLabels = [];
      for (var c = sizeStart; c <= sizeEnd; c += 1) {
        sizeLabels.push(normalizeSizeLabel(header[c]));
      }
      ['S', 'M', 'L', 'XL', '2XL', '3XL', 'NO SIZE'].forEach(function (label, index) {
        if (!sizeLabels[index]) sizeLabels[index] = label;
      });
      var currentCode = '';
      var currentLocation = {};
      var colors = [];
      var sizes = [];
      var stocks = {};
      var shelves = [];
      var layers = [];
      rows.slice(2).forEach(function (row) {
        var first = String(row[0] || '').trim();
        var location = !String(row[1] || '').trim() ? parseLocationRow(first) : null;
        if (location) {
          currentLocation = location;
          return;
        }
        if (first) currentCode = normalizeSheetProductCode(first);
        if (currentCode !== code) return;
        var color = String(row[1] || '').trim();
        if (!color) return;
        if (!colors.some(function (item) { return item.name === color; })) colors.push({ name: color, image: '' });
        if (currentLocation.shelf && !isInvalidShelfName(currentLocation.shelf) && shelves.indexOf(currentLocation.shelf) === -1) shelves.push(currentLocation.shelf);
        if (currentLocation.layer && !isInvalidLayerName(currentLocation.layer) && layers.indexOf(currentLocation.layer) === -1) layers.push(currentLocation.layer);
        for (var c = sizeStart; c <= sizeEnd; c += 1) {
          var size = sizeLabels[c - sizeStart];
          var qty = Number(String(row[c] || '').replace(/[^\d.-]/g, '')) || 0;
          if (qty <= 0) continue;
          if (!size) size = 'NO SIZE';
          if (sizes.indexOf(size) === -1) sizes.push(size);
          stocks[color + '||' + size] = (stocks[color + '||' + size] || 0) + qty;
        }
      });
      if (!colors.length) {
        productDraftMessage('找不到條碼：' + code);
        toast('台灣現貨倉找不到這個條碼');
        return;
      }
      productDraft.colors = colors.map(function (color) {
        var existing = productDraft.colors.find(function (item) { return item.name === color.name; });
        return { name: color.name, image: existing ? existing.image || '' : '' };
      });
      productDraft.sizes = sizes.length ? sizes : ['NO SIZE'];
      productDraft.stocks = stocks;
      shelves.forEach(function (shelf) { if (!isInvalidShelfName(shelf) && state.shelves.indexOf(shelf) === -1) state.shelves.push(shelf); });
      layers.forEach(function (layer) { if (!isInvalidLayerName(layer) && state.layers.indexOf(layer) === -1) state.layers.push(layer); });
      saveLocal();
      renderAll();
      Array.from(document.querySelectorAll('[data-product-shelf-select] option')).forEach(function (option) {
        option.selected = shelves.indexOf(option.value) !== -1;
      });
      Array.from(document.querySelectorAll('[data-product-layer-select] option')).forEach(function (option) {
        option.selected = layers.indexOf(option.value) !== -1;
      });
      productDraftMessage('已帶入 ' + colors.length + ' 色 / ' + productDraft.sizes.length + ' 尺寸');
      toast('台灣現貨倉已帶入');
    }).catch(function (error) {
      productDraftMessage('讀取失敗：' + error.message);
      toast('台灣現貨倉讀取失敗');
    });
  }

