  function freightFifoWarehouseSourceOptionsHtml(hasFormalOrder) {
    var china = canUseChinaWarehouseForTaiwanLiveOrder() ? '<option value="CN">中國倉</option>' : '';
    return hasFormalOrder
      ? '<option value="ALL">全部來源（優先顯示現貨）</option><option value="PREORDER">預購倉／等待到貨（不扣庫存）</option><option value="TW">台灣倉</option><option value="ID">印尼倉</option>' + china
