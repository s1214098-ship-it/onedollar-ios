  }

  function freightFifoEffectiveShippingFee(row, subtotal) {
    if (freightFifoWaivesCustomerShippingFee(row)) return 0;
    var rule = freightFifoShippingRule(row);
    if (rule.matched) return Math.max(0, Number(rule.fee || 0));
    if (rule.missingAddress) return 0;
    var stored = freightFifoStoredShippingFee(row);
    if (stored > 0) return stored;
    var explicit = Number(row && (row.total != null ? row.total : (row.grandTotal != null ? row.grandTotal : row.totalAmount)));
    if (Number.isFinite(explicit) && explicit > Math.max(0, Number(subtotal || 0))) return explicit - Math.max(0, Number(subtotal || 0));
    return 0;
  }

  function freightFifoPaymentTotal(row) {
    row = row || {};
    var subtotal = freightFifoSubtotal(row);
    if (freightFifoWaivesCustomerShippingFee(row)) return Math.max(0, subtotal);
    var rule = freightFifoShippingRule(row);
    if (rule.matched && subtotal > 0) return Math.max(0, subtotal + Math.max(0, Number(rule.fee || 0)));
    if (rule.missingAddress) return Math.max(0, subtotal);
    var explicit = Number(row.total != null ? row.total : (row.grandTotal != null ? row.grandTotal : row.totalAmount));
    if (Number.isFinite(explicit) && explicit > 0) return explicit;
    return Math.max(0, subtotal + freightFifoEffectiveShippingFee(row, subtotal));
  }

