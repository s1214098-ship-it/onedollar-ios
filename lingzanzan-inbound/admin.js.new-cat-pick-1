  function saveStaffFromForm() {
    var name = document.querySelector('[data-staff-name]')?.value.trim() || '';
    var account = document.querySelector('[data-staff-account]')?.value.trim() || '';
    var password = document.querySelector('[data-staff-password]')?.value.trim() || '';
    var role = document.querySelector('[data-staff-role]')?.value || '行政人員';
    var permissions = Array.from(document.querySelectorAll('[data-staff-permission]:checked')).map(function (item) {
      return item.value;
    });
    if (role === '行政人員' || role === 'staff') {
      permissions = permissions.filter(function (item) {
        return ['財務系統', '營銷毛利', '財報統計'].indexOf(item) === -1;
      });
    }
    if (!name || !account || (staffEditIndex === -1 && !password)) {
      toast(staffEditIndex === -1 ? '請填員工姓名、帳號和密碼' : '請填員工姓名和帳號');
      return;
    }
    if (!permissions.length) {
      toast('請至少選一個功能權限');
      return;
    }
    var record = {
      name: name,
      account: account,
      password: password || (state.staff[staffEditIndex] && state.staff[staffEditIndex].password) || '',
      role: role,
      permissions: permissions
    };
    if (staffEditIndex > -1 && state.staff[staffEditIndex]) {
      state.staff[staffEditIndex] = record;
      toast('員工權限已更新');
    } else {
      state.staff.push(record);
      toast('員工已新增');
    }
    saveLocal().then(function () {
      resetStaffForm();
      renderAll();
    }).catch(function () {
      toast('員工資料未儲存，請確認 NAS 可寫入後再試一次');
    });
  }

