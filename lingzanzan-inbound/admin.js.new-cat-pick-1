    var trackingNo = outboundParcels[0] && outboundParcels[0].trackingNo || '';
    var images = (modal._freightCustomerImages || []).slice(0, 12);
    function patchCustomerRow(row) {
      row = row || {};
      var next = Object.assign({}, row);
      next.customer = Object.assign({}, row.customer || {}, {
        name: name || row.customer && row.customer.name || row.customerName || '',
        phone: phone || row.customer && row.customer.phone || row.customerPhone || '',
        address: address,
        storeAddress: shipping.storeAddress,
        homeAddress: shipping.homeAddress,
        addressPrimary: shipping.addressPrimary,
        deliveryType: shipping.deliveryType,
        deliveryLabel: shipping.deliveryLabel,
        images: images,
        latestImage: images[0] || row.customer && row.customer.latestImage || ''
      });
      next.customerName = next.customer.name;
      next.customerPhone = next.customer.phone;
      next.address = address;
      next.customerAddress = address;
      next.storeAddress = shipping.storeAddress;
      next.homeAddress = shipping.homeAddress;
      next.addressPrimary = shipping.addressPrimary;
      next.deliveryType = shipping.deliveryType;
      next.deliveryLabel = shipping.deliveryLabel;
      if (decision) next.freightDispatchDecision = decision;
      next.shippingNote = shippingNote;
      next.shippingCarrier = shippingCarrier;
      next.trackingNo = trackingNo;
      next.outboundParcels = outboundParcels;
      next.customer.shippingCarrier = shippingCarrier;
      next.customer.trackingNo = trackingNo;
      next.customer.outboundParcels = outboundParcels;
      return next;
    }
    if (preorderId) {
      var inquiryIndex = (state.inquiries || []).findIndex(function (row) { return String(row && row.id || '') === preorderId; });
      if (inquiryIndex >= 0) {
        var currentInquiry = state.inquiries[inquiryIndex] || {};
        var savedInquiry = payload && payload.inquiry
          ? payload.inquiry
          : patchCustomerRow(currentInquiry);
        // Preserve object identity: FIFO planning caches are keyed by the row
        // object. Replacing it after a metadata-only save made the next open
        // synchronously rescan the complete inventory and freight dataset.
        Object.assign(currentInquiry, savedInquiry);
      }
    }
    if (orderId) {
      var orderIndex = (state.orders || []).findIndex(function (row) { return String(row && row.id || '') === orderId; });
      if (orderIndex >= 0) {
        var currentOrder = state.orders[orderIndex] || {};
        var savedOrder = payload && payload.order
          ? payload.order
          : patchCustomerRow(currentOrder);
        Object.assign(currentOrder, savedOrder);
      }
    }
    // This save only changes customer/shipping metadata. Inventory, freight
    // allocation and FIFO ordering are unchanged, so their caches stay valid.
    acknowledgeAdminRealtimeSave();
  }

