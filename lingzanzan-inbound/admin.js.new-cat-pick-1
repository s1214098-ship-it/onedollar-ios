  function saveFreightFifoPayment(modal, targetOrderId, orderType) {
    var values = freightFifoPaymentValues(modal);
    if (!values) return Promise.resolve();
    var box = modal.querySelector('[data-freight-fifo-payment]');
    var name = String((modal.querySelector('[data-freight-fifo-name]') || {}).value || '').trim();
    var phone = String((modal.querySelector('[data-freight-fifo-phone]') || {}).value || '').trim();
    var date = String((box.querySelector('[data-freight-fifo-payment-date]') || {}).value || '').trim();
    var note = String((box.querySelector('[data-freight-fifo-payment-note]') || {}).value || '').trim();
    var collectionParty = String((box.querySelector('[data-freight-fifo-collection-party]') || {}).value || 'unknown');
    var collectionRegion = String((box.querySelector('[data-freight-fifo-collection-region]') || {}).value || 'TW');
    var collectorName = String((box.querySelector('[data-freight-fifo-collector-name]') || {}).value || '').trim();
    if (collectorName) collectorName = freightFifoSalesName(collectorName);
    var paymentDefaultRow = (state.orders || []).find(function (row) { return String(row && row.id || '') === String(targetOrderId || ''); }) || (state.inquiries || []).find(function (row) { return String(row && row.id || '') === String(targetOrderId || modal.getAttribute('data-preorder-id') || ''); }) || {};
    applyFreightFifoPaymentDefaults(modal, paymentDefaultRow);
    values = freightFifoPaymentValues(modal);
    var originalSettlementMode = String(box.getAttribute('data-original-settlement-mode') || '');
    // 舊單原本就是印尼全數代收時，行政常把超商「隨退 100」誤填到
    // 本次商品收款。這 100 不是營收，不可補進已收款；改由專用勾選
    // 保存，商品款與既有欠款金額維持原樣。
    if (originalSettlementMode === 'id_sales_full'
      && values.mode === 'id_sales_full'
      && values.storeIdCod
      && values.current === 100
      && values.balance > 0) {
      var mistakenStoreRefundInput = box.querySelector('[data-freight-fifo-payment-current]');
      if (mistakenStoreRefundInput) mistakenStoreRefundInput.value = '0';
      renderFreightFifoPayment(modal);
      values = freightFifoPaymentValues(modal);
    }
    var preservingLegacyIndonesiaFullStatus = originalSettlementMode === 'id_sales_full'
      && values.mode === 'id_sales_full'
      && values.current <= 0;
    collectionParty = String((box.querySelector('[data-freight-fifo-collection-party]') || {}).value || 'unknown');
    collectionRegion = String((box.querySelector('[data-freight-fifo-collection-region]') || {}).value || 'TW');
    collectorName = String((box.querySelector('[data-freight-fifo-collector-name]') || {}).value || '').trim();
    if (collectorName) collectorName = freightFifoSalesName(collectorName);
    if (!values.mode) return Promise.reject(new Error('請先選擇收款方式'));
    // 「本張既有訂金」在一般行政流程是唯讀欄位。訂單金額或運費重新
    // 計算時 previousPaid 會被限制在新總額內，這不代表行政人員有修改
    // 歷史收款；只有欄位明確解鎖且數值真的被改動時，才送出更正旗標。
    var paymentCorrection = values.previousPaidEditable
      && Math.abs(values.previousPaidEntered - values.originalPreviousPaid) > 0.00001;
    if (paymentCorrection && !note) return Promise.reject(new Error('更正既有訂金／已收金額時，請填收款備註說明原因'));
    if (values.current > 0 && !date) {
      var requiredDate = box.querySelector('[data-freight-fifo-payment-date]');
      if (requiredDate) {
        var dateLabel = requiredDate.closest('label');
        if (dateLabel) {
          dateLabel.hidden = false;
          if (!dateLabel.querySelector('[data-payment-date-error]')) {
            var dateError = document.createElement('small');
            dateError.setAttribute('data-payment-date-error', '');
            dateError.setAttribute('role', 'alert');
            dateError.textContent = '請在這裡填實際收款日期；本次未收款請把新增收款填 0。';
            dateLabel.appendChild(dateError);
          }
        }
        requiredDate.setAttribute('aria-invalid', 'true');
        requiredDate.scrollIntoView({ block: 'center', behavior: 'auto' });
        requiredDate.focus({ preventScroll: true });
      }
      return Promise.reject(new Error('本次有收款，請填「收款日期」（已移至該欄位）'));
    }
    if (values.current > 0 && collectionParty === 'unknown') return Promise.reject(new Error('請選擇本次訂金由公司收或業務收'));
    if (values.current > 0 && collectionParty === 'sales' && !collectorName) return Promise.reject(new Error('業務代收款請填代收業務姓名'));
    if (values.mode === 'paid_full' && values.balance > 0) return Promise.reject(new Error('選擇已收清時，本次收款需補足全部尾款'));
    if (values.mode === 'id_sales_full' && values.balance > 0 && !preservingLegacyIndonesiaFullStatus) return Promise.reject(new Error('印尼全數代收時，本次收款需補足全部尾款'));
    if (values.indonesiaCollectionMode && values.indonesiaCollectionAmount <= 0) return Promise.reject(new Error('有選印尼收款協助時，請填印尼欄位金額'));
    if (values.mode === 'id_sales_partial') {
      if (values.paid <= 0) return Promise.reject(new Error('印尼部分代收請填本次已收金額'));
      if (values.balance <= 0) return Promise.reject(new Error('若已收清請改選「印尼業務全數代收」'));
      if (values.idRemainderStage !== 'tw_cod' && values.idRemainderStage !== 'id_later' && values.idRemainderStage !== 'tw_store_id_cod') {
        return Promise.reject(new Error('請選擇剩額是台灣貨到付款、超商證件代收，還是繼續等印尼業務收'));
      }
      if (values.idRemainderStage === 'tw_store_id_cod' && values.balance > 0) {
        return Promise.reject(new Error('本單還有欠款，超商證件代收 NT$100 不能充當尾款。請改選台灣貨到付款，或繼續等印尼收。'));
      }
    }
    if (isIndonesiaSalesCollectionMode(values.mode)) {
      collectionParty = 'sales';
      collectionRegion = 'ID';
      if (!collectorName) return Promise.reject(new Error('印尼代收請填代收業務姓名'));
    }
    return fetch('./finance-api.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        action: 'save-order-payment',
        orderId: targetOrderId,
        sourceOrderId: box.getAttribute('data-source-payment-id') || '',
        moveSourcePayment: orderType === 'order',
        orderType: orderType || 'order',
        orderTotal: values.total,
        depositAmount: values.deposit,
        paidAmount: values.paid,
        paymentEventAmount: values.current,
        correctExistingPayment: paymentCorrection,
        correctedPreviousPaidAmount: values.previousPaid,
        correctionReason: paymentCorrection ? note : '',
        paymentStage: values.current > 0 ? (isIndonesiaSalesCollectionMode(values.mode) ? 'balance' : 'deposit') : '',
        proofImage: box._paymentProofImage || '',
        paymentDate: values.current > 0 ? date : '',
        receivableBalance: orderType === 'preorder' ? 0 : values.balance,
        unshippedBalance: orderType === 'preorder' ? values.balance : 0,
        settlementMode: values.mode,
        idRemainderStage: values.idRemainderStage || 'none',
        indonesiaAmount: values.indonesiaAmount || 0,
        indonesiaRate: values.indonesiaRate || freightFifoDefaultIdrRate(),
        indonesiaTwd: values.indonesiaTwd || 0,
        indonesiaShortfall: values.indonesiaShortfall || 0,
        indonesiaCovered: !!values.indonesiaCovered,
        indonesiaCollectionMode: values.indonesiaCollectionMode || '',
        indonesiaCollectionReceiver: values.indonesiaCollectionReceiver || 'indonesia_sales',
        indonesiaCollectionAmount: values.indonesiaCollectionAmount || 0,
        indonesiaCollectionCurrency: values.indonesiaCollectionCurrency || 'TWD',
        indonesiaCollectionOriginalAmount: values.indonesiaCollectionOriginalAmount || 0,
        indonesiaCollectionRate: values.indonesiaCollectionRate || 500,
        indonesiaCollectionStatus: values.indonesiaCollectionStatus || 'pending',
        indonesiaShippingSalesRate: values.indonesiaShippingSalesRate || 0,
        indonesiaShippingCompanyRate: values.indonesiaShippingCompanyRate || 0,
        indonesiaShippingSalesAmount: values.indonesiaShippingSalesAmount || 0,
        indonesiaShippingCompanyAmount: values.indonesiaShippingCompanyAmount || 0,
        indonesiaTaiwanCodCharge: values.indonesiaTaiwanCodCharge || 0,
        indonesiaCustomerShippingRefund: values.indonesiaCustomerShippingRefund || 0,
        indonesiaNetCustomerShipping: values.indonesiaNetCustomerShipping || 0,
        indonesiaActualShippingCost: values.indonesiaActualShippingCost || 0,
        indonesiaShippingAllocationLabel: values.indonesiaShippingAllocationLabel || '',
        indonesiaPending: !!(values.indonesiaCollectionMode && values.indonesiaCollectionStatus !== 'received'),
        indonesiaPendingNote: values.indonesiaCollectionMode ? ((values.indonesiaCollectionMode === 'company_deposit' ? '公司貨款－印尼業務代收（從毛利扣）' : '業務自己的貨款') + '／' + (values.indonesiaCollectionStatus === 'received' ? '已收款成功' : '尚未確認收到')) : '',
        storeIdCodDummy: !!values.storeIdCod,
        storeIdCodAmount: values.storeIdCodAmount || 0,
        balanceCollectionStage: values.balance <= 0 ? 'none' : (values.codAmount > 0 ? 'cod' : (values.beforeShipAmount > 0 ? 'before_ship' : (values.mode === 'deposit_account' ? 'account' : (values.idRemainderStage === 'id_later' ? 'id_later' : 'after_ship')))),
        codAmount: values.codAmount,
        codCollectionParty: values.codAmount > 0 ? 'company' : '',
        codCollectionRegion: values.codAmount > 0 ? 'TW' : '',
        codCollectorName: values.codAmount > 0 ? '公司' : '',
        note: note,
        customerName: name,
        customerPhone: phone,
        collectionParty: collectionParty,
        collectionRegion: collectionRegion,
        collectorName: collectionParty === 'sales' ? collectorName : (collectionParty === 'company' ? '公司' : '待確認'),
        depositCollectionParty: collectionParty,
        depositCollectionRegion: collectionRegion,
        // 「實際收款方」與「負責業務」是兩個欄位：公司收款也必須保留選取的業務。
        depositCollectorName: collectorName,
        salesName: collectorName,
        submittedBy: currentLogin().name || currentLogin().account || '管理者'
      })
    }).then(function (response) {
      return response.text().then(function (rawText) {
        var data;
        try {
          data = rawText ? JSON.parse(rawText) : {};
        } catch (parseError) {
          throw new Error(response.ok ? '收款資料回傳格式錯誤' : ('資料未儲存 HTTP ' + response.status));
        }
        if (!response.ok || !data.ok) throw new Error(data.error || '收款與欠款儲存失敗');
        return data;
      });
    });
  }

