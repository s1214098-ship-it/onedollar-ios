  function collectFreightLookupTokens(item) {
    var barcodes = [];
    var skuIds = [];
    function add(list, value) {
      var token = normalizeScanCode(value);
      if (token && list.indexOf(token) === -1) list.push(token);
    }
    item = item || {};
    add(skuIds, item.skuId);
    add(skuIds, item.productFiledSkuId);
    add(barcodes, item.sampleBarcode);
    add(barcodes, item.taiwanBarcode);
    add(barcodes, item.barcode);
    add(barcodes, item.companyBarcode);
    add(barcodes, item.productFiledBarcode);
    freightVariantLines(item).forEach(function (line) {
      add(skuIds, line && line.skuId);
      add(barcodes, line && (line.sampleBarcode || line.taiwanBarcode || line.barcode));
    });
    return { barcodes: barcodes, skuIds: skuIds };
  }

  function mergeFreightCatalogLookupIntoState(item, lookup) {
    item = item || {};
    lookup = lookup || {};
    var product = lookup.product;
    if (!product || !product.id) return item;
    state.products = Array.isArray(state.products) ? state.products : [];
    state.skus = Array.isArray(state.skus) ? state.skus : [];
    if (!state.products.some(function (row) { return String(row && row.id || '') === String(product.id); })) {
      state.products.unshift(product);
    }
    (lookup.skus || []).forEach(function (sku) {
      if (!sku) return;
      var skuId = String(sku.id || sku.sku || '');
      if (!skuId) return;
      if (!state.skus.some(function (row) { return String(row && (row.id || row.sku) || '') === skuId; })) {
        state.skus.unshift(sku);
      }
    });
    item.productId = item.productId || product.id;
    item.productFiledProductId = item.productFiledProductId || product.id;
    item.productFiledProductCode = item.productFiledProductCode || product.code || item.productCode;
    item.productFiledProductTitle = item.productFiledProductTitle || product.title || item.productName;
    item.productFiledStatus = item.productFiledStatus || 'filed';
    if (product.category && !item.category) item.category = product.category;
    if (Array.isArray(item.variants)) {
      item.variants = item.variants.map(function (line) {
        var next = Object.assign({}, line || {}, { productId: (line && line.productId) || product.id });
        if (!next.category && product.category) next.category = product.category;
        var wanted = normalizeScanCode(next.sampleBarcode || next.taiwanBarcode || next.barcode || next.skuId);
        var hit = (lookup.skus || []).find(function (sku) {
          return [sku.id, sku.sku, sku.barcode, sku.companyBarcode, sku.legacyBarcode].some(function (value) {
            return wanted && normalizeScanCode(value) === wanted;
          });
        });
        if (hit) {
          next.skuId = next.skuId || hit.id || hit.sku;
          next.productId = hit.productId || product.id;
          if (!item.skuId) item.skuId = next.skuId;
          if (!item.productFiledSkuId) item.productFiledSkuId = next.skuId;
          if (!item.productFiledBarcode) item.productFiledBarcode = hit.companyBarcode || hit.barcode || next.sampleBarcode || '';
        }
        return next;
      });
    }
    return item;
  }

  function ensureFreightItemLinkedToFormalCatalog(item) {
    // LZ_NB008_RECV_20260923: no-batch scans painted "補齊產品資料後驗收"
    // from an empty in-memory catalog even when products.json already has
    // the code+barcode (NB008 / NB006 / K406). Link first, then receive.
    item = (item && item.id && freightItemById(item.id)) || item || {};
