  function stocktakeLookupRows(query) {
    var parsedLegacy = parseLegacyProductBarcodeForCatalog(query);
    var legacyAllowed = !parsedLegacy || legacyProductPrefixExists(parsedLegacy);
    var q = String(parsedLegacy && legacyAllowed ? parsedLegacy.queryText || parsedLegacy.productCode : query || '').trim().toLowerCase();
    if (!q) return [];
    var warehouse = stocktakeDraft.warehouse || state.warehouses[0] || '台灣倉';
    var rows = [];
    state.products.forEach(function (product) {
      productSkus(state.skus, product.id).forEach(function (sku) {
        var location = productLocation(product, [sku]);
        var skuWarehouse = warehouseLabelForRecord(sku, warehouseCodeForRecord(product));
        if (!(matchesFilter(location.warehouse, warehouse) || matchesFilter(skuWarehouse, warehouse))) return;
        var text = [
          product.code,
          product.id,
          product.title,
          sku.id,
          sku.sku,
          sku.colorName || sku.color,
          sku.sizeName || sku.size,
          location.warehouse,
          location.shelf,
          location.layer,
          sku.colorCode,
          sku.colorNo,
          (product.colors || []).map(function (item) { return [item.code, item.colorCode, item.no].join(' '); }).join(' ')
        ].join(' ').toLowerCase();
        var legacyMatch = legacyAllowed && stocktakeLegacyMatches(product, sku, parsedLegacy);
        var rank = productSearchRank(product, sku, q, text);
        if (!legacyMatch && rank >= 9999) return;
        rows.push({
          key: stocktakeSkuKey(product.id, sku.id || sku.sku),
          product: product,
          sku: sku,
          productId: product.id,
          skuId: sku.id || sku.sku,
          image: stocktakeSkuImage(product, sku),
          productCode: product.code || product.id || '-',
          skuCode: sku.id || sku.sku || '-',
          title: product.title || '',
          color: sku.colorName || sku.color || '未填顏色',
          size: sku.sizeName || sku.size || 'NO SIZE',
          stock: Number(sku.stock || 0),
          location: location,
          rank: legacyMatch ? 0 : rank
