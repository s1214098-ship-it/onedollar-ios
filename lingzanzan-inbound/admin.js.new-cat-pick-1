      // ownership is validated by order-admin-api-v6.php, which can return the
      // exact existing order/customer. Silently turning a duplicate into an
      // empty value made the later error incorrectly say "出貨需要填物流單號".
      trackingNo = freightFifoNormTrackingNo(String(trackingNo || '').trim());
      if (!trackingNo || seen[trackingNo]) return;
      seen[trackingNo] = true;
      parcels.push({
        trackingNo: trackingNo,
        amount: Math.max(0, Number(amount || 0) || 0),
        note: String(note || '').trim(),
