    openFreightPendingPriorityModal(row, itemIndex, releaseNeeded, '客戶等待過久，改抽其他客戶名額先出').then(function (selection) {
      if (selection === null) return false;
      var selectedKeys = Array.isArray(selection.keys) ? selection.keys : [];
      var reason = String(selection.reason || '').trim();
      if (selection.formal) {
        var remainingByItem = (Array.isArray(row.items) ? row.items : []).map(function () { return 0; });
        remainingByItem[itemIndex] = Math.max(1, releaseNeeded);
        return openFreightFormalPriorityModal(row, reason, remainingByItem).then(function (changed) {
          if (!changed) return false;
          button.disabled = true;
          button.textContent = '正在套用插隊抽貨…';
          if (converted) return refreshOrdersAndInquiries().then(function () { return { releasedQty: missing, displaced: [], creditedToOrder: true }; });
          return callStockInquiryApi({
            action: 'update-preorder-meta',
            inquiryId: targetMetaId,
            manualQueuePriority: true,
            manualQueuePriorityReason: reason,
            manualQueuePriorityItemIndex: itemIndex,
            manualQueuePriorityProductCode: code,
            allocateTaiwanStock: true,
            employeeName: currentLogin().name || currentLogin().account || '管理者'
          }).then(function () { return refreshOrdersAndInquiries(); });
        });
      }
      displacementPlan = selection.previewPlan
        ? preorderManualPriorityPlanFromPreview(row, itemIndex, selectedKeys, releaseNeeded, selection.previewPlan)
        : preorderManualPriorityDisplacementPlan(row, itemIndex, selectedKeys, releaseNeeded);
      if (releaseNeeded > 0 && displacementPlan.releasedQty < releaseNeeded) {
        toast('所選配對名額不足，尚未變更任何客戶');
        return false;
      }
      button.disabled = true;
      button.textContent = '正在抽貨插隊…';
      var pulledFreight = (displacementPlan.modifiedItems || []).length > 0;
      var metaPromise = converted
        ? Promise.resolve({})
        : callStockInquiryApi({
          action: 'update-preorder-meta',
          inquiryId: targetMetaId,
          manualQueuePriority: true,
          manualQueuePriorityReason: reason,
          manualQueuePriorityItemIndex: itemIndex,
          manualQueuePriorityProductCode: code,
          allocateTaiwanStock: pulledFreight || freeQty >= missing,
          employeeName: currentLogin().name || currentLogin().account || '管理者'
        });
      return metaPromise.then(function (data) {
        if (data && data.inquiry) {
          var targetIndex = (state.inquiries || []).findIndex(function (candidate) {
            return String(candidate && candidate.id || '') === targetMetaId;
          });
          if (targetIndex >= 0) state.inquiries[targetIndex] = data.inquiry;
        }
        return displacementPlan.releasedQty > 0
          ? applyPreorderManualPriorityDisplacement(displacementPlan, inquiry || row, reason, { skipBackgroundRefresh: true })
          : Promise.resolve({ releasedQty: 0, displaced: [] });
      }).then(function (result) {
        if (!converted || !targetOrderId) return result;
        return callStockInquiryApi({
          action: 'allocate-order-item-tw-stock',
          orderId: targetOrderId,
          itemIndex: itemIndex,
          qty: missing,
          reason: reason,
          operationId: 'allocate-order-tw-' + freightStableToken([targetOrderId, itemIndex, missing, Date.now()].join('|')),
          employeeName: currentLogin().name || currentLogin().account || '管理者'
        }).then(function (allocated) {
          if (allocated && allocated.order) {
            var orderIndex = (state.orders || []).findIndex(function (candidate) {
              return String(candidate && candidate.id || '') === targetOrderId;
            });
            if (orderIndex >= 0) state.orders[orderIndex] = allocated.order;
          }
          return Object.assign({}, result || {}, {
            releasedQty: Math.max(Number(result && result.releasedQty || 0), Number(allocated && allocated.creditedQty || 0)),
            creditedToOrder: Number(allocated && allocated.creditedQty || 0) > 0
          });
        }).catch(function (error) {
          toast(error.message || '已抽走其他客戶名額，但台灣倉目前沒有現貨可扣到這張正式單');
          return Object.assign({}, result || {}, { creditedToOrder: false });
        });
      });
    }).then(function (changed) {
      if (changed === false) return false;
      freightFifoBaseRowsCache = null;
      freightFifoTaiwanPlanCache = null;
      button.disabled = true;
      button.removeAttribute('aria-busy');
      button.textContent = '插隊抽貨已完成';
      var pulledQty = Number(changed && changed.releasedQty || 0);
      if (changed === true || changed && changed.creditedToOrder || releaseNeeded <= 0 || pulledQty >= releaseNeeded) {
        var donorNames = (Array.isArray(changed && changed.displaced) ? changed.displaced : displacementPlan.displaced).map(function (entry) {
          var donor = (state.inquiries || []).find(function (candidate) {
            return String(candidate && candidate.id || '') === String(entry.inquiryId || '');
          }) || {};
          return String(donor.customer && donor.customer.name || donor.customerName || donor.id || '').trim();
        }).filter(Boolean);
        toast('已抽貨給 ' + customerName + ' 的 ' + code
          + (donorNames.length ? '；原客戶 ' + donorNames.join('、') + ' 改等下一批' : '；已排為優先配貨')
          + (converted ? '。請再核對實收與物流後出貨。' : '。修改金額或刪品仍可繼續，正式出貨請再按送出。'));
        if (sourceModal) reopenFreightFifoShipmentAfterItemChange(sourceModal, inquiry, order, targetOrderId);
        return true;
      }
      toast('可抽名額不足；已有出貨單且物流條碼、或已寄出的客戶會跳過');
      return false;
    }).catch(function (error) {
      button.disabled = false;
      button.textContent = originalText;
      toast(error.message || '插隊抽貨尚未完成');
    });
  }

  function applyPreorderManualPriorityDisplacement(plan, targetRow, reason, options) {
    plan = plan || { modifiedItems: [], displaced: [], releasedQty: 0 };
    options = options || {};
    var operator = currentLogin().name || currentLogin().account || '管理者';
    return plan.modifiedItems.reduce(function (chain, item) {
      return chain.then(function () {
        return saveFreightItemRecord(item, 'manual-priority-release-' + freightStableToken([
          item.id, targetRow && targetRow.id, reason, Date.now()
        ].join('|')));
      });
    }, Promise.resolve()).then(function () {
      return plan.displaced.reduce(function (chain, row) {
        return chain.then(function () {
          return callStockInquiryApi({
            action: 'update-preorder-meta',
            inquiryId: row.inquiryId,
            freightShippingSelected: false,
            manualQueueDisplaced: true,
            manualQueueDisplacedByInquiryId: targetRow && targetRow.id || '',
            manualQueueDisplacedQty: row.quantity,
            manualQueueDisplacedReason: reason,
            employeeName: operator
          }).then(function (data) {
            if (data && data.inquiry) {
              var rowIndex = (state.inquiries || []).findIndex(function (candidate) {
                return String(candidate && candidate.id || '') === String(row.inquiryId || '');
              });
              if (rowIndex >= 0) state.inquiries[rowIndex] = data.inquiry;
            }
            return data;
          });
        });
      }, Promise.resolve());
    }).then(function () {
      if (!options.skipBackgroundRefresh) {
        window.setTimeout(function () {
          Promise.all([
            loadJson('./data/orders.json').then(normalizeOrderRows).catch(function () { return state.orders || []; }),
            loadStockInquiries()
          ]).then(function (rows) {
            state.orders = normalizeOrderRows(rows[0]);
            state.inquiries = Array.isArray(rows[1]) ? rows[1] : state.inquiries;
            freightFifoBaseRowsCache = null;
            freightFifoTaiwanPlanCache = null;
            return reconcilePreorderWarehouseAllocationsUntilStable(4);
          }).catch(function (error) {
            console.warn('priority allocation background refresh failed', error);
          });
        }, 1200);
      }
      return { releasedQty: plan.releasedQty, displaced: plan.displaced };
    });
  }

  function openFreightQueuePriorityReasonModal(customerName) {
    var existing = document.querySelector('[data-freight-queue-priority-reason-modal]');
    if (existing) existing.remove();
    var modal = document.createElement('div');
    modal.className = 'freight-formal-priority-modal';
    modal.setAttribute('data-freight-queue-priority-reason-modal', '');
    modal.innerHTML = '<section role="dialog" aria-modal="true" aria-labelledby="queue-priority-reason-title">'
      + '<header><div><small>QUEUE PRIORITY／人工插隊</small><h3 id="queue-priority-reason-title">把 ' + escapeHtml(customerName) + ' 排到第 1 順位</h3><p>請填寫原因。這一步只調整候補順序，不會直接搶走其他客戶已保留的現貨。</p></div><button type="button" data-queue-priority-reason-close>關閉</button></header>'
      + '<label class="freight-pending-priority-reason"><span>插隊原因</span><input type="text" data-queue-priority-reason-input value="客戶等待過久，調整為優先配貨" maxlength="300" placeholder="請填寫插隊原因"></label>'
      + '<footer><button type="button" class="ghost-button" data-queue-priority-reason-close>取消，不調整順位</button><button type="button" class="primary-button" data-queue-priority-reason-confirm>確認插隊到第 1 順位</button><span data-queue-priority-reason-status>填寫原因後即可確認</span></footer></section>';
    document.body.appendChild(modal);
    return new Promise(function (resolve) {
      var input = modal.querySelector('[data-queue-priority-reason-input]');
      var confirmButton = modal.querySelector('[data-queue-priority-reason-confirm]');
      var status = modal.querySelector('[data-queue-priority-reason-status]');
      var close = function (value) {
        if (modal.parentNode) modal.remove();
        resolve(value);
      };
      var update = function () {
        var reason = String(input && input.value || '').trim();
        confirmButton.disabled = !reason;
        status.textContent = reason ? '原因已填，可確認插隊' : '請先填寫插隊原因';
      };
      modal.querySelectorAll('[data-queue-priority-reason-close]').forEach(function (button) {
        button.addEventListener('click', function () { close(''); });
      });
      confirmButton.addEventListener('click', function () {
        var reason = String(input && input.value || '').trim();
        if (!reason) {
          update();
          if (input) input.focus();
          return;
        }
        close(reason);
      });
      modal.addEventListener('click', function (event) {
        if (event.target === modal) close('');
      });
      input.addEventListener('input', update);
      update();
      window.setTimeout(function () { if (input) input.focus(); }, 0);
    });
  }

