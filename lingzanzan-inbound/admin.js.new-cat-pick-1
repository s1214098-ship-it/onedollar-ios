          line && line.taiwanBarcode
        ].reduce(function (tokens, value) {
          return tokens.concat(freightFifoIdentityTokens(value));
        }, []).filter(Boolean);
        rows.push({
          identities: Array.from(new Set(identities)),
          color: freightVariantTextKey(canonicalProductVariantColor(line && line.color || item && (item.color || item.colorName) || '')),
          size: freightVariantTextKey(canonicalNoSize(line && line.size || item && (item.size || item.sizeName) || 'NO SIZE'))
        });
