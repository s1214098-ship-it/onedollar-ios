  function readOrderCustomerDraft() {
    try {
      var parsed = JSON.parse(localStorage.getItem(ORDER_CUSTOMER_DRAFT_KEY) || 'null');
      return parsed && typeof parsed === 'object' ? parsed : null;
    } catch (error) { return null; }
  }

  function writeOrderCustomerDraft(draft) {
    var localDraft = Object.assign({}, draft || {});
    if (/^data:image\//i.test(localDraft.image || '')) localDraft.image = '';
    try { localStorage.setItem(ORDER_CUSTOMER_DRAFT_KEY, JSON.stringify(localDraft)); } catch (error) {}
  }

  function orderCustomerDraftImage(fields) {
    if (!fields) return '';
    if (fields.imageInput && fields.imageInput.matches && fields.imageInput.matches('[data-admin-live-customer-image]')) {
      return adminLiveCustomerPhoto || fields.imagePreview && fields.imagePreview.src || '';
    }
    if (fields.imageInput && adminCustomerCroppedImages && adminCustomerCroppedImages.get(fields.imageInput)) {
      return adminCustomerCroppedImages.get(fields.imageInput) || '';
    }
    return fields.imagePreview && fields.imagePreview.src || '';
  }

  function collectAdminOrderCustomerDraft() {
    var fields = adminOrderCustomerFields();
    if (!fields) return null;
    var root = document.querySelector('[data-manual-preorder-form], [data-admin-shipment-form], .live-form') || document;
    var shipping = readCustomerShippingAddressFields(root);
    return {
      name: String(fields.name && fields.name.value || '').trim(),
      phone: String(fields.phone && fields.phone.value || '').replace(/\D/g, ''),
      address: shipping.address || String(fields.address && fields.address.value || '').trim(),
      storeAddress: shipping.storeAddress,
      homeAddress: shipping.homeAddress,
      addressPrimary: shipping.addressPrimary,
      deliveryType: String(fields.delivery && fields.delivery.value || '').trim(),
      deliveryLabel: String(fields.delivery && fields.delivery.selectedOptions && fields.delivery.selectedOptions[0] && fields.delivery.selectedOptions[0].textContent || '').trim(),
      shippingFee: Number(fields.shippingFee && fields.shippingFee.value || 0),
      note: String(fields.note && fields.note.value || '').trim(),
      image: orderCustomerDraftImage(fields),
      sales: manualPreorderSalesValue(root),
      savedAt: new Date().toISOString(),
      source: (location.pathname.split('/').pop() || '')
    };
  }

  function updateOrderCustomerDraftStatus(message, stateName) {
    document.querySelectorAll('[data-order-customer-save-status]').forEach(function (node) {
      node.textContent = message;
      node.dataset.state = stateName || '';
    });
  }

  function applyAdminOrderCustomerDraft(draft) {
    var fields = adminOrderCustomerFields();
    if (!fields || !draft) return false;
    var applied = false;
    [['name', 'name'], ['phone', 'phone'], ['address', 'address'], ['note', 'note']].forEach(function (pair) {
      var field = fields[pair[0]];
      var value = String(draft[pair[1]] || '');
      if (field && !String(field.value || '').trim() && value) { field.value = value; applied = true; }
    });
    fillCustomerShippingAddressFields(document, draft);
    if (fields.delivery && draft.deliveryType && Array.prototype.some.call(fields.delivery.options || [], function (option) { return option.value === draft.deliveryType; })) {
      fields.delivery.value = draft.deliveryType;
      fields.delivery.dispatchEvent(new Event('change', { bubbles: true }));
      applied = true;
    }
    if (fields.shippingFee && !Number(fields.shippingFee.value || 0) && Number(draft.shippingFee || 0)) fields.shippingFee.value = draft.shippingFee;
    if (draft.image) {
      if (fields.imageInput && fields.imageInput.matches && fields.imageInput.matches('[data-admin-live-customer-image]')) {
        setAdminLiveCustomerPhoto(draft.image, '已帶入上次儲存圖片');
        applied = true;
      } else if (fields.imageInput && fields.imageInput.matches && fields.imageInput.matches('[data-admin-shipment-customer-image]')) {
        setAdminShipmentCustomerPhoto(draft.image, '已帶入上次儲存圖片');
        applied = true;
      } else if (document.querySelector('[data-manual-customer-photo-preview]')) {
        applyAdminSelectedCustomerPhoto({ photo: draft.image }, 'preorder');
        applied = true;
      }
    }
    if (applied) updateOrderCustomerDraftStatus('已帶入上次儲存的客戶，可直接繼續找產品', 'loaded');
    return applied;
  }

  function saveAdminOrderCustomerDraft(button) {
    var draft = collectAdminOrderCustomerDraft();
    if (!draft || !draft.name) { toast('請先填客戶姓名'); return; }
    writeOrderCustomerDraft(draft);
    if (draft.phone.length < 6) {
      updateOrderCustomerDraftStatus('已保留在這台電腦；補上至少 6 碼電話後可正式串聯會員', 'local');
      toast('客戶資料已暫存，電話補完整後可正式儲存');
      return;
    }
    if (button) { button.disabled = true; button.textContent = '儲存中…'; }
    fetch('./stock-inquiry-api.php', {
      method: 'POST',
      headers: adminAuthorizationHeaders({ 'Content-Type': 'application/json' }),
      body: JSON.stringify({ action: 'save-customer-profile', sales: manualPreorderSalesValue(), customer: draft })
    }).then(function (response) {
      return response.json().catch(function () { return {}; }).then(function (data) {
        if (!response.ok || !data.ok) throw new Error(data.error || '客戶資料儲存失敗');
        return data;
      });
    }).then(function (data) {
      var saved = Object.assign({}, draft, data.customer || {}, { savedAt: new Date().toISOString() });
      writeOrderCustomerDraft(saved);
      var imageSaved = !draft.image || data.photoStored;
      updateOrderCustomerDraftStatus(imageSaved
        ? '已正式儲存' + (draft.image ? '（含客戶截圖）' : '') + '；切換其他打單頁後，按「帶入已存客戶」即可接續'
        : '客戶文字已儲存，但截圖尚未寫入，請再試一次', imageSaved ? 'saved' : 'local');
      toast(imageSaved ? ('客戶資料已儲存' + (draft.image ? '，截圖也已寫入' : '') + '；找不到產品也不會遺失') : '客戶文字已儲存，但截圖尚未寫入');
    }).catch(function (error) {
      updateOrderCustomerDraftStatus('伺服器未完成，但本機暫存仍保留：' + (error.message || error), 'local');
      toast(error.message || '客戶資料暫存在本機，伺服器尚未完成');
    }).finally(function () {
      if (button) { button.disabled = false; button.textContent = '儲存客戶資料'; }
    });
  }

  function clearAdminOrderCustomerDraft() {
    try { localStorage.removeItem(ORDER_CUSTOMER_DRAFT_KEY); } catch (error) {}
    var fields = adminOrderCustomerFields();
    if (fields) ['name', 'phone', 'address', 'note'].forEach(function (key) { if (fields[key]) fields[key].value = ''; });
    var draftRoot = document.querySelector('[data-manual-preorder-form], [data-admin-shipment-form], .live-form') || document;
    var storeField = draftRoot.querySelector('[data-customer-store-address]');
    var homeField = draftRoot.querySelector('[data-customer-home-address]');
    if (storeField) storeField.value = '';
    if (homeField) homeField.value = '';
    if (draftRoot.querySelector('[data-customer-store-address], [data-customer-home-address]')) {
      setCustomerAddressPrimaryValue(draftRoot, 'store');
      readCustomerShippingAddressFields(draftRoot);
    }
    updateOrderCustomerDraftStatus('已清除，可輸入下一位客戶', 'cleared');
    toast('已清除打單客戶暫存');
  }

