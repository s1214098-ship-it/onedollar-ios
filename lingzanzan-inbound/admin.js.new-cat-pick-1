    var table = document.querySelector('[data-live-lines]');
    if (!table) return;
    var scanner = liveScannerRow();
    if (scanner) {
      scanner.dataset.liveScanner = '1';
      scanner.classList.add('live-scan-row');
      var scannerQty = scanner.querySelector('input[type="number"]:not([data-live-price])');
      if (scannerQty) scannerQty.setAttribute('data-live-qty', '');
      var scannerWarehouse = scanner.querySelector('select:not([data-live-color]):not([data-live-size])');
      if (scannerWarehouse) scannerWarehouse.setAttribute('data-live-warehouse', '');
    }
    table.addEventListener('input', function (event) {
      if (event.target.matches('[data-live-code]')) showLiveSuggestions(event.target);
    });
    table.addEventListener('keyup', function (event) {
      if (event.target.matches('[data-live-code]')) showLiveSuggestions(event.target);
    });
    table.addEventListener('focusin', function (event) {
      if (event.target.matches('[data-live-code]')) showLiveSuggestions(event.target);
    });
    var suggestBox = document.querySelector('[data-live-suggest]');
    if (suggestBox && !suggestBox.dataset.liveBulkBound) {
      suggestBox.dataset.liveBulkBound = '1';
      suggestBox.addEventListener('input', function (event) {
        if (!event.target.matches('[data-live-multi-qty], [data-live-multi-price]')) return;
        var choice = event.target.closest('[data-live-size-choice]');
        var check = choice && choice.querySelector('[data-live-multi-sku]');
        if (check && !check.disabled) check.checked = true;
      });
    }
    table.addEventListener('change', function (event) {
      if (event.target.matches('[data-live-warehouse]')) {
        var warehouseRow = event.target.closest('[data-live-line]');
        var changedWarehouse = normalizeLiveWarehouse(event.target.value);
        var accepted = rebindAdminLiveWarehouse(warehouseRow);
        if (warehouseRow && warehouseRow.dataset.liveCommitted !== '1' || accepted) {
          setAdminOrderWarehouseLock(changedWarehouse);
          toast('直播作業倉改為「' + changedWarehouse + '」。選品與數量只看此倉庫存');
        }
        var liveSearch = document.querySelector('[data-live-lines] [data-live-scanner="1"] [data-live-code]');
        if (liveSearch && String(liveSearch.value || '').trim()) {
          var suggestBox = document.querySelector('[data-live-suggest]');
          if (suggestBox) delete suggestBox.dataset.liveRenderKey;
          showLiveSuggestions(liveSearch);
        }
        return;
      }
      if (event.target.matches('[data-live-code]')) {
        var changedRow = event.target.closest('[data-live-line]');
        if (!commitLiveScan(changedRow)) hydrateLiveLine(changedRow);
      }
    });
    table.addEventListener('keydown', function (event) {
      if (!event.target.matches('[data-live-code]') || event.key !== 'Enter') return;
      event.preventDefault();
      event.stopPropagation();
      commitLiveScan(event.target.closest('[data-live-line]'));
    });
    table.addEventListener('input', function (event) {
      if ((event.target.matches('[data-live-qty]') || event.target.matches('[data-live-price]')) && event.target.closest('[data-live-committed="1"]')) {
        updateLiveScanSummary();
        renderAdminLivePayment();
      }
    });
    bindIf('[data-live-picker-close]', 'click', closeLivePicker);
    document.querySelector('[data-live-picker]')?.addEventListener('click', function (event) {
      if (event.target.matches('[data-live-picker]')) closeLivePicker();
    });
    table.querySelectorAll('[data-live-code]').forEach(function (input) {
      if (input.value) hydrateLiveLine(input.closest('[data-live-line]'));
    });
    renderAdminOrderWarehouseLock();
    updateLiveScanSummary();
    resetLiveScannerRow(scanner);
    syncAdminLiveOrderTarget();
    renderAdminLivePayment();
  }

