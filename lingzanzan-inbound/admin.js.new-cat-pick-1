      basePrice: Math.max(0, Number((modal.querySelector('[data-freight-fifo-reseller-base]') || {}).value || 0)),
      customerPrice: Math.max(0, Number((modal.querySelector('[data-freight-fifo-reseller-customer]') || {}).value || 0)),
      advancedBySales: String((modal.querySelector('[data-freight-fifo-reseller-advanced]') || {}).value || 'yes') === 'yes',
      note: String((modal.querySelector('[data-freight-fifo-reseller-note]') || {}).value || '').trim()
    };
    resellerSettlement.resellerMargin = resellerSettlement.customerPrice - resellerSettlement.basePrice;
    var imagesChanged = modal._freightCustomerImagesDirty === true;
    var preorderPayload = preorderId ? {
      action: 'update-preorder-meta',
      inquiryId: preorderId,
      customerName: name,
      customerAddress: address,
      storeAddress: shipping.storeAddress,
      homeAddress: shipping.homeAddress,
      addressPrimary: shipping.addressPrimary,
      deliveryType: shipping.deliveryType,
      deliveryLabel: shipping.deliveryLabel,
      customerPhone: phone,
      freightDispatchDecision: decision,
      shippingNote: shippingNote,
      shippingCarrier: shippingCarrier,
      trackingNo: trackingNo,
      outboundParcels: outboundParcels,
      clearTrackingNo: outboundParcels.length === 0,
      employeeName: currentLogin().name || currentLogin().account || '管理者'
    } : null;
    if (preorderPayload) {
      preorderPayload.resellerSettlement = resellerSettlement;
      preorderPayload.salesChannel = resellerSettlement.enabled ? 'reseller' : 'direct';
    }
    var feeSelect = modal.querySelector('[data-freight-fifo-shipping-fee-mode]');
    if (preorderPayload && feeSelect) {
      var feeMode = String(feeSelect.value || 'standard');
      var regularFee = Math.max(0, Number(feeSelect.getAttribute('data-regular-shipping-fee') || 0));
      var isSelf = feeMode === 'id_self';
      var isFree = feeMode === 'free';
