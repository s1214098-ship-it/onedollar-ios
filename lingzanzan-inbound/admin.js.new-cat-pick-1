  function freightFifoCanvasLines(context, text, maxWidth) {
    var words = String(text || '').split('');
    var lines = [];
    var current = '';
    words.forEach(function (word) {
      var next = current + word;
      if (current && context.measureText(next).width > maxWidth) {
        lines.push(current);
        current = word;
      } else {
        current = next;
      }
    });
    if (current) lines.push(current);
    return lines.length ? lines : ['-'];
  }

  async function freightFifoLoadCanvasImage(url) {
    if (!url) return null;
    try {
      var response = await fetch(new URL(url, window.location.href).href, { credentials: 'same-origin', cache: 'no-store' });
      if (!response.ok) return null;
      return await createImageBitmap(await response.blob());
    } catch (error) {
      return null;
    }
  }

  function freightFifoDrawCanvasImage(context, image, x, y, width, height) {
    context.save();
    context.beginPath();
    context.roundRect(x, y, width, height, 18);
    context.clip();
    context.fillStyle = '#f7f1e8';
    context.fillRect(x, y, width, height);
    if (image) {
      var paddedWidth = Math.max(1, width - 12);
      var paddedHeight = Math.max(1, height - 12);
      var scale = Math.min(paddedWidth / image.width, paddedHeight / image.height);
      var drawWidth = image.width * scale;
      var drawHeight = image.height * scale;
      context.drawImage(image, x + (width - drawWidth) / 2, y + (height - drawHeight) / 2, drawWidth, drawHeight);
    } else {
      context.fillStyle = '#8f8391';
      context.font = '700 16px sans-serif';
      context.textAlign = 'center';
      context.fillText('無圖片', x + width / 2, y + height / 2 - 2);
      context.font = '600 13px sans-serif';
      context.fillText('Tanpa foto', x + width / 2, y + height / 2 + 20);
      context.textAlign = 'left';
    }
    context.restore();
  }

  function freightFifoCanvasBlob(canvas) {
    return new Promise(function (resolve, reject) {
      canvas.toBlob(function (blob) {
        if (blob) resolve(blob);
        else reject(new Error('小卡圖片產生失敗'));
      }, 'image/png');
    });
  }

  async function freightFifoBuildCardCanvas(row, sourceModal) {
    var model = freightFifoShareModel(row, sourceModal);
    var isCombinedCard = !!row.isCombinedShipmentCard;
    var arrivedUnits = freightFifoCardArrivalUnits(model.items, row, 'arrived');
    var missingUnits = freightFifoCardArrivalUnits(model.items, row, 'missing');
    var arrivedQty = arrivedUnits.reduce(function (sum, unit) { return sum + unit.quantity; }, 0);
    var missingQty = missingUnits.reduce(function (sum, unit) { return sum + unit.quantity; }, 0);
    var cardUnitLimit = 12;
    var visibleArrived = arrivedUnits.slice(0, cardUnitLimit);
    var visibleMissing = missingUnits.slice(0, cardUnitLimit);
    var units = visibleArrived.concat(visibleMissing);
    var images = await Promise.all(units.map(function (unit) {
      return freightFifoLoadCanvasImage(orderTrackingItemImage(unit.item || {}));
    }));
    var arrivedImages = images.slice(0, visibleArrived.length);
    var missingImages = images.slice(visibleArrived.length);
    var canvas = document.createElement('canvas');
