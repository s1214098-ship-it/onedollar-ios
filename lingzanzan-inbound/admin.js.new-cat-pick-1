  function adminLivePaymentValues() {
    var box = document.querySelector('[data-admin-live-payment]');
    var total = Math.max(0, adminLiveOrderTotal());
    var deposit = Math.max(0, Math.min(total, Number(box?.querySelector('[data-admin-live-payment-deposit]')?.value || 0)));
    var eventAmount = Math.max(0, Math.min(total - deposit, Number(box?.querySelector('[data-admin-live-payment-event]')?.value || 0)));
    var paid = Math.min(total, deposit + eventAmount);
    return Object.assign({ total: total, depositAmount: deposit, paymentEventAmount: eventAmount, paidAmount: paid, balance: Math.max(0, total - paid) }, orderEntryIndonesiaValues(box || document, adminLiveDeliveryFee()));
  }

