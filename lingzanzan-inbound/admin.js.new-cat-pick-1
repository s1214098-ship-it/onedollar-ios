  function applyPreorderBulkStatus() {
    var ids = selectedPreorderIds();
    if (!ids.length) {
      toast('請先勾選預購單');
      return;
    }
    var statusInput = document.querySelector('[data-preorder-bulk-status]');
    var status = normalizePreorderPurchaseStatus(statusInput ? statusInput.value : 'ordered');
    if (status === 'received') {
      toast('已到貨必須由採購進貨建檔確認，不能直接改狀態');
      return;
    }
    if (!window.confirm('確定把已選 ' + ids.length + ' 筆預購改成「' + preorderPurchaseStatusLabel(status) + '」嗎？')) return;
    ids.reduce(function (chain, id) {
      return chain.then(function () {
        return callStockInquiryApi({
          action: 'update-preorder-meta',
          inquiryId: id,
          purchaseStatus: status,
          purchaseNote: (document.querySelector('[data-preorder-purchase-note="' + CSS.escape(id) + '"]') || {}).value || ''
        });
      });
    }, Promise.resolve()).then(function () {
      return refreshPreorderAfterBulk('已批次更新 ' + ids.length + ' 筆採購狀態');
    }).catch(function (error) {
      toast('批次更新失敗：' + (error.message || error));
    });
  }

  function deleteSelectedPreorders() {
    var ids = selectedPreorderIds();
    if (!ids.length) {
      toast('請先勾選要刪除的預購單');
      return;
    }
    if (!window.confirm('確定刪除已選 ' + ids.length + ' 筆預購單嗎？刪除後採購區與預購區都不會再顯示。')) return;
    callStockInquiryApi({ action: 'bulk-delete-preorders', inquiryIds: ids }).then(function (data) {
      var deletedIds = Array.isArray(data.deleted) ? data.deleted : [];
      var selected = ensurePreorderSelectionSet();
      ids.forEach(function (id) { selected.delete(id); });
      var message = deletedIds.length
        ? '已從 NAS 永久刪除 ' + deletedIds.length + ' 筆預購單'
        : '選取的預購單已不存在，列表已重新整理';
      return refreshPreorderAfterBulk(message);
    }).catch(function (error) {
      toast('批次刪除失敗：' + (error.message || error));
    });
  }

