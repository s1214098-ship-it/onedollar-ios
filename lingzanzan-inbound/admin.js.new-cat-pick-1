  function orderTrackingFilterEntries(rows, category, now) {
    var query = String(document.querySelector('[data-order-tracking-query]')?.value || '').trim().toLowerCase();
    var from = String(document.querySelector('[data-order-tracking-from]')?.value || '');
    var to = String(document.querySelector('[data-order-tracking-to]')?.value || '');
    var status = document.querySelector('[data-order-tracking-status="' + category + '"]')?.value || 'all';
    var overdueOnly = !!document.querySelector('[data-order-tracking-overdue-only]')?.checked;
    return rows.filter(function (entry) {
      var dateKey = taipeiCalendarKey(orderTrackingRecordDate(entry));
      // 有輸入客戶、電話、訂單或商品時查完整歷史；日期只限制平常瀏覽清單。
      // 否則預設日期會把較早但已完成的正確訂單排除。
      var skipDate = !!query;
      if (query && !orderTextMatches(orderTrackingEntryText(entry), query)) return false;
      if (!skipDate && from && (!dateKey || dateKey < from)) return false;
      if (!skipDate && to && (!dateKey || dateKey > to)) return false;
      if (status !== 'all' && entry.stage !== status) return false;
      if (overdueOnly && !orderTrackingIsOverdue(entry, now)) return false;
