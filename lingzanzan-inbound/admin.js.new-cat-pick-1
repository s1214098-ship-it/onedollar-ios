  function adminImageSearch(file, input) {
    if (!file) return;
    var host = input.closest('label') || input.parentElement;
    var result = host.parentElement.querySelector('[data-admin-image-search-results]');
    if (!result) {
      result = document.createElement('div');
      result.setAttribute('data-admin-image-search-results', '');
      result.className = 'image-search-results';
      host.parentElement.appendChild(result);
    }
    result.textContent = '正在比對後台商品圖片…';
    imageHashFromSource(URL.createObjectURL(file)).then(function (needle) {
      var jobs = (state.products || []).map(function (product) {
        var src = productImageSources(product)[0];
        return src ? imageHashFromSource(src).then(function (hash) { return { product: product, hash: hash }; }) : Promise.resolve(null);
      });
      return Promise.all(jobs).then(function (rows) {
        return rows.filter(function (row) { return row && row.hash; }).map(function (row) {
