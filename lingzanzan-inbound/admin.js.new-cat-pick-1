  function saveFreightFifoShippingFeeMode(modal, orderId) {
    var select = modal && modal.querySelector('[data-freight-fifo-shipping-fee-mode]');
    if (!select || !orderId) return Promise.resolve(null);
    var order = (state.orders || []).find(function (row) { return String(row && row.id || '') === String(orderId); }) || {};
    var regularFee = Math.max(0, Number(select.getAttribute('data-regular-shipping-fee') || 0));
    var nextMode = String(select.value || 'standard');
    var isFree = nextMode === 'free';
    var isSelf = nextMode === 'id_self';
    var nextFee = (isFree || isSelf) ? 0 : regularFee;
    var status = String(order.status || '').toLowerCase();
    var delivery = String(order.deliveryState || '').toLowerCase();
    if (
      ['shipped', 'in_transit', 'delivered', 'completed', 'returned', 'cancelled', 'refunded', 'closed', 'converted'].indexOf(status) !== -1
      || ['in_transit', 'delivered', 'returned'].indexOf(delivery) !== -1
      || order.inventoryReceived
    ) {
      return Promise.resolve(null);
    }
    // Always persist the value shown in the final shipment form. Customer and
    // preorder metadata can be saved immediately before this call, while the
    // formal order still carries an older free-shipping total. An early return
    // based on the browser state left finance at the new amount but the order at
    // the old amount. The server update is idempotent, so re-sending the selected
    // fee is safer and keeps the formal order and receivable on one total.
    return callOrderAdmin({
      action: 'update-prices',
      orderId: orderId,
      priceRows: [],
      shippingFee: nextFee,
      regularShippingFee: regularFee,
      freeShipping: isFree,
      shippingFeeMode: nextMode,
      shippingFeeWaived: isFree ? regularFee : 0,
      indonesiaSelfShip: isSelf
    }).then(function (data) {
      var saved = data && data.order ? data.order : null;
      if (!saved) throw new Error('運費與訂單總額尚未寫入正式單');
      var savedFee = Math.max(0, Number(saved.shippingFee || 0));
      var savedMode = freightFifoShippingFeeModeFromRow(saved);
      var savedSubtotal = Math.max(0, Number(saved.subtotal != null ? saved.subtotal : freightFifoSubtotal(saved)));
      var expectedTotal = Math.round((savedSubtotal + nextFee) * 100) / 100;
      var savedTotal = Math.max(0, Number(saved.total || 0));
      if (savedMode !== nextMode || Math.abs(savedFee - nextFee) >= 0.5 || Math.abs(savedTotal - expectedTotal) >= 0.5) {
        throw new Error('運費與正式單總額不同步，已停止儲存欠款，請重新開啟後再試');
      }
      var paymentTotal = modal.querySelector('[data-freight-fifo-payment-total]');
      if (paymentTotal) {
        paymentTotal.value = String(savedTotal);
        var paymentBox = paymentTotal.closest('[data-freight-fifo-payment]');
        if (paymentBox) paymentBox.setAttribute('data-base-order-total', String(savedTotal));
      }
      renderFreightFifoPayment(modal);
      return data;
    });
  }

