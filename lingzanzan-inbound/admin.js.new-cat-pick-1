        if (row.isConnected) commitLiveScan(row);
      });
      return false;
    }
    var exactSkuRow = findExactLiveSkuRow(raw);
    var parsedScan = typeof parseLegacyProductBarcode === 'function' ? parseLegacyProductBarcode(raw) : null;
    var oldStyle = !!(parsedScan && (parsedScan.format === 'legacy' || parsedScan.format === 'v2'));
    var chinaWarehouse = adminOrderWarehouseCode(liveRowWarehouse(row)) === 'CN';
    if (!exactSkuRow || oldStyle) {
      var prefixProduct = findLiveProduct(raw) || (parsedScan && parsedScan.productCode && findLiveProduct(parsedScan.productCode));
      if (prefixProduct && (oldStyle || !exactSkuRow)) {
        if (input) input.value = prefixProduct.code || raw;
        showLiveSuggestions(input);
        toast('已對上產品編號 ' + (prefixProduct.code || '') + '。舊碼只比前面編號，請選顏色、尺寸與數量後帶入');
        return false;
