      freightFifoTaiwanPlanCache = null;
      return state.orders;
    });
  }

  function visiblePreorderInquiries() {
    var login = currentLogin();
    var list = Array.isArray(state.inquiries) ? state.inquiries : [];
    return list.filter(function (row) {
      var isPreorder = row && (row.orderType === 'preorder' || row.status === 'preorder_pending');
      if (!isPreorder) return false;
      var unresolved = !preorderInquiryConverted(row) && row.status !== 'cancelled';
      if (!unresolved && !isRecentOrderRow(row)) return false;
      if (login.role !== 'sales') return true;
      var owner = login.name || login.account || '';
      return (row.salesName || row.sales || '') === owner;
    });
  }

  function preorderInquiryConverted(row) {
    row = row || {};
    return row.status === 'converted' || !!(row.orderId || row.convertedOrderId || row.formalOrderId || row.preorderConvertedAt || row.convertedAt);
  }

  function preorderInquiryTime(row) {
    var value = row && (row.createdAt || row.orderDate || row.purchaseDate || row.purchaseUpdatedAt || row.updatedAt || '');
    var time = Date.parse(value);
    return Number.isFinite(time) ? time : 0;
  }

  function normalizePreorderPurchaseStatus(value) {
    var status = String(value || 'not_ordered');
    // `pending` is an old value used by a small number of preorder rows. It
    // means the same thing as not_ordered; leaving it unrecognised made those
    // rows disappear from every purchase queue.
    if (status === 'pending') return 'not_ordered';
    return status === 'preparing' ? 'ordered' : status;
  }

  function preorderRequestedQuantity(row) {
    return (Array.isArray(row && row.items) ? row.items : []).reduce(function (sum, item) {
      return sum + Math.max(0, Number(item && (item.qty || item.quantity || item.requestedQty) || 0));
    }, 0);
  }

  function preorderFreightRequestedQuantity(row) {
    return (Array.isArray(row && row.items) ? row.items : []).reduce(function (sum, item) {
      var sourceCode = String(item && item.sourceWarehouseCode || '').trim().toUpperCase();
      var sourceLabel = String(item && item.sourceWarehouse || '').trim();
      // 舊預購單沒有記錄供貨倉時仍視為預購倉；已明確綁定現貨倉的品項
      // 不可再進物流／採購待補數量，否則會同一件同時占用現貨與預購。
      var needsFreight = !sourceCode
        ? (!sourceLabel || sourceLabel.indexOf('預購') !== -1)
        : sourceCode === 'PREORDER';
      return needsFreight
        ? sum + Math.max(0, Number(item && (item.qty || item.quantity || item.requestedQty) || 0))
        : sum;
    }, 0);
  }

  function preorderOutstandingFreightQuantity(row) {
    return Math.max(0, preorderFreightRequestedQuantity(row) - preorderExistingFreightAllocatedQty(row && row.id));
  }

  function preorderWasAutoMarkedOrdered(row) {
    var history = Array.isArray(row && row.preorderProgressHistory) ? row.preorderProgressHistory : [];
    return history.some(function (entry) {
      return /物流預購倉自動串聯/.test([entry && entry.by, entry && entry.note].join(' '));
    });
  }

  function preorderPurchaseDisplayRow(row) {
    var displayItems = (Array.isArray(row && row.items) ? row.items : []).map(function (item, itemIndex) {
      var requested = Math.max(0, Number(item && (item.qty || item.quantity || item.requestedQty) || 0));
      var remaining = Math.max(0, requested - preorderExistingFreightAllocatedItemQty(row && row.id, itemIndex));
      if (!remaining) return null;
      return Object.assign({}, item, { qty: remaining, quantity: remaining, requestedQty: remaining, originalRequestedQty: requested });
    }).filter(Boolean);
    return Object.assign({}, row, { _purchaseDisplayItems: displayItems, _purchaseOutstandingQty: displayItems.reduce(function (sum, item) { return sum + Math.max(0, Number(item && item.qty || 0)); }, 0) });
  }

  function preorderWaitStatusValue(row) {
    row = row || {};
    if (preorderInquiryConverted(row)) return 'converted';
    var received = !!row.inventoryReceived || normalizePreorderPurchaseStatus(row.purchaseStatus) === 'received';
    if (!received) return '';
    var value = String(row.preorderWaitStatus || '').trim();
    return value === 'ready_to_ship' ? value : 'waiting_other_items';
  }

  function preorderWaitStatusLabel(value) {
    var labels = {
      waiting_other_items: '累計訂單／等待其他預購商品（暫不出貨）',
      ready_to_ship: '商品已齊／准許出貨',
      converted: '已轉現貨配送'
    };
    return labels[value] || '尚未到貨入庫';
  }

  function preorderPurchaseSort(a, b) {
    var timeDiff = preorderInquiryTime(a) - preorderInquiryTime(b);
    if (timeDiff) return timeDiff;
    return String(a && a.id || '').localeCompare(String(b && b.id || ''), 'zh-Hant', { numeric: true });
  }

  function preorderWorkQueueRow(row) {
    if (!row || preorderInquiryConverted(row) || row.status === 'cancelled') return false;
    var status = row.inventoryReceived ? 'received' : normalizePreorderPurchaseStatus(row.purchaseStatus);
    return ['ordered', 'arrived', 'received'].indexOf(status) !== -1;
  }

  function preorderWaitingAgeDays(row) {
    row = row || {};
    var history = Array.isArray(row.preorderProgressHistory) ? row.preorderProgressHistory : [];
    var waitingTimes = history.map(function (entry) {
      var status = normalizePreorderPurchaseStatus(entry && entry.purchaseStatus);
      if (['ordered', 'arrived', 'received'].indexOf(status) === -1) return NaN;
      return taipeiCalendarSerial(entry && entry.at || '');
    }).filter(Number.isFinite);
    var fallback = taipeiCalendarSerial(row.purchaseUpdatedAt || row.preorderReceivedAt || row.createdAt || row.orderDate || '');
    var started = waitingTimes.length ? Math.min.apply(Math, waitingTimes) : fallback;
    var today = taipeiCalendarSerial(new Date());
    if (!Number.isFinite(started) || !Number.isFinite(today) || started > today) return 0;
    return today - started;
  }

  function preorderWaitingOverdue(row) {
    return preorderWorkQueueRow(row) && preorderWaitingAgeDays(row) > ORDER_OVERDUE_DAYS;
  }

  function preorderWaitingOverdueHtml(row) {
    if (!preorderWaitingOverdue(row)) return '';
    return '<div class="order-overdue-alert" role="alert"><b>預購等待超過 12 天</b><span>進入等待區已 ' + preorderWaitingAgeDays(row) + ' 天，請確認物流、缺貨或是否仍要累計其他商品。</span></div>';
  }

  function renderPreorderWaitingSummary(rows) {
    var host = document.querySelector('[data-preorder-waiting-summary]');
    if (!host) return;
    rows = (Array.isArray(rows) ? rows : []).filter(preorderWorkQueueRow);
    var counts = { ordered: 0, arrived: 0, waiting_other_items: 0, ready_to_ship: 0, overdue: 0 };
    var customerKeys = {};
    var totalQty = 0;
    rows.forEach(function (row) {
      var purchaseStatus = row.inventoryReceived ? 'received' : normalizePreorderPurchaseStatus(row.purchaseStatus);
      if (purchaseStatus === 'ordered') counts.ordered += 1;
      else if (purchaseStatus === 'arrived') counts.arrived += 1;
      if (purchaseStatus === 'received') {
        var waitStatus = preorderWaitStatusValue(row);
        if (counts[waitStatus] !== undefined) counts[waitStatus] += 1;
      }
      if (preorderWaitingOverdue(row)) counts.overdue += 1;
      var customer = row.customer || {};
      var phone = preorderCustomerPhoneKey(customer.phone || row.phone || '');
      var name = String(customer.name || row.customerName || '').trim().toLowerCase();
      customerKeys[phone ? ('p:' + phone) : ('n:' + (name || String(row.id || '')))] = true;
      (Array.isArray(row.items) ? row.items : []).forEach(function (item) {
        totalQty += Number(item.qty || item.quantity || 0);
      });
    });
    host.innerHTML = [
      '<article class="is-total"><span>預購等待總數</span><strong>' + rows.length + '</strong><small>' + Object.keys(customerKeys).length + ' 位客戶／' + totalQty + ' 件商品</small></article>',
      '<article><span>已下單</span><strong>' + counts.ordered + '</strong><small>已離開採購待下單清單</small></article>',
      '<article><span>物流運送中</span><strong>' + counts.arrived + '</strong><small>尚未增加現貨庫存</small></article>',
      '<article class="is-waiting"><span>累計訂單</span><strong>' + counts.waiting_other_items + '</strong><small>已入庫，等待其他預購商品</small></article>',
      '<article class="is-ready"><span>准許出貨</span><strong>' + counts.ready_to_ship + '</strong><small>商品已齊，可轉現貨出貨單</small></article>',
      '<article class="is-overdue"><span>超過 12 天</span><strong>' + counts.overdue + '</strong><small>需優先確認物流或累計原因</small></article>'
    ].join('');
  }

  function preorderInquiryMatches(row, query, salesFilter, statusFilter, typeFilter) {
    var customer = row.customer || {};
    var items = Array.isArray(row.items) ? row.items : [];
    var salesName = row.salesName || row.sales || '未指定';
    function normalizeSearchValue(value) {
      var normalized = String(value == null ? '' : value);
      if (normalized.normalize) normalized = normalized.normalize('NFKC');
      return normalized.trim().toLowerCase();
    }
    var normalizedQuery = normalizeSearchValue(query);
    var text = [
      row.id,
      row.statusLabel,
      row.orderTypeLabel,
      row.preorderWarehouseLabel,
      normalizePreorderPurchaseStatus(row.purchaseStatus),
      row.purchaseStatusLabel,
      row.preorderWaitStatus,
      row.preorderWaitStatusLabel,
      preorderWaitStatusLabel(preorderWaitStatusValue(row)),
      row.supplierTrackingNo,
      row.freightTrackingNo,
      row.trackingNo,
      row.shippingNote,
      row.logisticsNote,
      row.reservedShippingNote,
      row.salesNotice,
      row.note,
      row.notes,
      (Array.isArray(row.progressHistory) ? row.progressHistory : []).map(function (entry) {
        entry = entry || {};
        return [entry.note, entry.statusLabel, entry.carrier, entry.trackingNo].join(' ');
      }).join(' '),
      row.arrivalWarehouse,
      row.arrivalWarehouseLabel,
      row.preorderFulfillWarehouse,
      row.preorderFulfillWarehouseLabel,
      (Array.isArray(row.freightArrivalAllocations) ? row.freightArrivalAllocations : []).map(function (entry) {
        return [entry && entry.trackingNo, entry && entry.receivingDocumentNo, entry && entry.warehouse].join(' ');
      }).join(' '),
      customer.name,
      customer.phone,
      customer.note,
      salesName,
      items.map(function (item) {
        return [
          item.code,
          item.productCode,
          item.productId,
          item.sku,
          item.skuId,
          item.barcode,
          item.companyBarcode,
          item.legacyBarcode,
          item.taiwanBarcode,
          item.title,
          item.productName,
          item.name,
          item.color,
          item.colorName,
          item.size,
          item.sizeName
        ].join(' ');
      }).join(' ')
    ].join(' ');
    text = normalizeSearchValue(text);
    var compactQuery = normalizedQuery.replace(/[\s\-_/]+/g, '');
    var compactText = text.replace(/[\s\-_/]+/g, '');
    var purchaseStatus = row.inventoryReceived ? 'received' : normalizePreorderPurchaseStatus(row.purchaseStatus);
    var waitStatus = preorderWaitStatusValue(row);
    var preorderStatus = row.status || 'preorder_pending';
    var converted = preorderInquiryConverted(row);
    var normalizedFilter = statusFilter === 'preparing' ? 'ordered' : statusFilter;
    var statusMatches = normalizedFilter === 'all';
    if (normalizedFilter === 'converted') statusMatches = converted;
    else if (normalizedFilter === 'cancelled') statusMatches = row.status === 'cancelled' && !converted;
    else if (normalizedFilter === 'waiting_other_items' || normalizedFilter === 'ready_to_ship') statusMatches = !converted && waitStatus === normalizedFilter;
    else if (['not_ordered', 'ordered', 'arrived', 'received'].indexOf(normalizedFilter) !== -1) statusMatches = !converted && purchaseStatus === normalizedFilter;
    else if (normalizedFilter === 'preorder_pending') statusMatches = preorderStatus === 'preorder_pending' && !converted;
    else if (!statusMatches) statusMatches = preorderStatus === normalizedFilter;
    return (!normalizedQuery || text.indexOf(normalizedQuery) !== -1 || (compactQuery && compactText.indexOf(compactQuery) !== -1)) &&
      (salesFilter === 'all' || salesName === salesFilter) &&
      (typeFilter === 'all' || typeFilter === 'preorder') &&
      statusMatches;
  }

  function preorderPaginationHtml(total, page, totalPages) {
    if (total <= PREORDER_PAGE_SIZE) return '';
    return [
      '<nav class="preorder-pager" data-preorder-pager>',
      '<button type="button" data-preorder-page="' + Math.max(1, page - 1) + '"' + (page <= 1 ? ' disabled' : '') + '>上一頁</button>',
      '<span>第 ' + page + ' / ' + totalPages + ' 頁，每頁 ' + PREORDER_PAGE_SIZE + ' 筆，共 ' + total + ' 筆</span>',
      '<button type="button" data-preorder-page="' + Math.min(totalPages, page + 1) + '"' + (page >= totalPages ? ' disabled' : '') + '>下一頁</button>',
      '</nav>'
    ].join('');
  }

  function directPurchaseRows(statusFilter) {
    var rows = Array.isArray(state.inquiries) ? state.inquiries : [];
    statusFilter = statusFilter || 'all';
    return rows.filter(function (row) {
      if (!row) return false;
      if (!(row.orderType === 'preorder' || row.status === 'preorder_pending')) return false;
      var converted = preorderInquiryConverted(row);
      if (statusFilter === 'converted') return converted;
      if (statusFilter === 'cancelled') return row.status === 'cancelled' && !converted;
      if (converted || row.status === 'cancelled') return false;
      var purchaseStatus = row.inventoryReceived ? 'received' : normalizePreorderPurchaseStatus(row.purchaseStatus);
      var normalizedFilter = statusFilter === 'preparing' ? 'ordered' : statusFilter;
      if (normalizedFilter === 'waiting_other_items' || normalizedFilter === 'ready_to_ship') return preorderWaitStatusValue(row) === normalizedFilter;
      if (normalizedFilter === 'received') return purchaseStatus === 'received';
      // A logistics row is a purchased/forecast quantity, but an order may
      // contain several product lines. Older auto allocation marked the whole
      // order as ordered after only one line was matched. Keep those rows in
      // the purchase queue until every requested unit is covered.
      var autoMarkedWithShortage = purchaseStatus === 'ordered' && preorderWasAutoMarkedOrdered(row) && preorderOutstandingFreightQuantity(row) > 0;
      if (normalizedFilter === 'all') return purchaseStatus === 'not_ordered' || autoMarkedWithShortage;
      if (normalizedFilter === 'not_ordered') return purchaseStatus === 'not_ordered' || autoMarkedWithShortage;
      if (['ordered', 'arrived'].indexOf(normalizedFilter) !== -1) return purchaseStatus === normalizedFilter;
      return false;
    }).map(preorderPurchaseDisplayRow).sort(preorderPurchaseSort);
  }

  function directPurchaseFilterState() {
    var searchInput = document.querySelector('[data-order-search]');
    var salesInput = document.querySelector('[data-order-sales-filter]');
    var statusInput = document.querySelector('[data-order-status-filter]');
    var statusOption = statusInput && statusInput.options ? statusInput.options[statusInput.selectedIndex] : null;
    return {
      query: String(searchInput && searchInput.value || '').trim().toLowerCase(),
      sales: String(salesInput && salesInput.value || 'all'),
      status: String(statusInput && statusInput.value || 'all'),
      statusLabel: String(statusOption && statusOption.textContent || '待處理（採購區）').trim()
    };
  }

  function filteredDirectPurchaseRows() {
    var filters = directPurchaseFilterState();
    var baseRows = directPurchaseRows(filters.status);
    var rows = baseRows.filter(function (row) {
      return preorderInquiryMatches(row, filters.query, filters.sales, filters.status, 'preorder');
    });
    if (!rows.length && !filters.query && filters.sales === 'all' && filters.status === 'all') rows = baseRows.slice();
    return { rows: rows, filters: filters };
  }

  function renderDirectPurchaseList() {
    var list = document.querySelector('[data-purchase-page] [data-admin-orders]');
    if (!list) return false;
    var activeRows = directPurchaseRows('all');
    var filtered = filteredDirectPurchaseRows();
    var rows = filtered.rows;
    updatePreorderSummary(activeRows);
    var total = rows.length;
    var pages = Math.max(1, Math.ceil(total / PREORDER_PAGE_SIZE));
