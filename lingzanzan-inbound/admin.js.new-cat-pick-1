  function preorderSupplyVariantMatches(item, color, size, actualProductValue) {
    var wantedProduct = preorderItemCode(item);
    var actualProduct = actualProductValue || wantedProduct;
    var wantedColor = freightAllocationColorKey(canonicalProductSpecificVariantColor(wantedProduct, preorderItemColor(item)));
    var wantedSize = freightDemandIdentity(canonicalProductVariantSize(preorderItemSize(item)));
    var actualColor = freightAllocationColorKey(canonicalProductSpecificVariantColor(actualProduct, color || ''));
    var actualSize = freightDemandIdentity(canonicalProductVariantSize(size || 'NO SIZE'));
    var sizeIsOpen = !wantedSize || /未填|未帶尺寸|未帶|無尺寸|NO SIZE|NONE|UNKNOWN/.test(wantedSize);
