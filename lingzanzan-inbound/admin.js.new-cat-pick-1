  function printFreightReceivingBarcodes(itemId) {
    var item = freightItemById(itemId);
    if (!item) { toast('找不到這筆物流產品，請重新整理'); return; }
    var receipt = freightQuickReceivePayload(item);
    if (receipt.missing.length) {
      toast('尚不能列印驗收條碼：' + receipt.missing.join('、') + '。請先完成正式產品與 SKU 資料。');
      return;
    }
    var modal = document.querySelector('[data-freight-receiving-workbench]');
    if (modal) {
      receipt.lines = receipt.lines.map(function (line) {
        var input = modal.querySelector('[data-freight-inspection-actual="' + Number(line.sourceLineIndex || 0) + '"]');
        return Object.assign({}, line, {
          qty: Math.max(0, Math.floor(Number(input && input.value) || 0))
        });
      }).filter(function (line) { return line.qty > 0; });
      receipt.actualQty = receipt.lines.reduce(function (sum, line) { return sum + Math.max(0, Number(line.qty || 0)); }, 0);
      if (!receipt.actualQty) { toast('請先輸入至少 1 件實收數量，再列印條碼'); return; }
    }
    var payloads = freightReceivedBarcodePayloads({
      receivedAt: new Date().toISOString(),
      ownership: { linkedOrders: [] },
      inventory: { lines: receipt.lines }
    }, receipt);
    if (!payloads.length) { toast('找不到可列印的正式產品條碼'); return; }
    var conflicts = freightBarcodeVariantConflicts(payloads);
    if (conflicts.length) {
      toast('已停止列印：' + conflicts.join('、') + '。請先核對各顏色／尺寸的正式 SKU。');
      return;
    }
    payloads.forEach(function (payload) { payload.receivingLabelTotal = receipt.actualQty; });
    if (payloads.length === 1) openInventoryBarcodePrint(payloads[0]);
    else openInventoryBarcodeBatchPrint(payloads);
    toast('已開啟驗收條碼列印；此動作不會增加庫存或改動客戶訂單');
