    if (/^(YT|S|JT|SF|STO|ZTO|YD)/.test(trackingNo)) return false;
    return /^E\d{10,}$/.test(trackingNo) || /^16\d{8,}$/.test(trackingNo) || /^\d{14}$/.test(trackingNo);
  }

  function freightFifoExtractTrackingFromNote(note) {
    var found = [];
    String(note || '').replace(/\b(E\d{10,}|\d{11,14})\b/gi, function (raw) {
      var trackingNo = freightFifoNormTrackingNo(raw);
      if (!freightFifoLooksLikeOutboundTracking(trackingNo)) return '';
      if (found.indexOf(trackingNo) === -1) found.push(trackingNo);
      return raw;
    });
    return found;
  }

  function freightFifoOutboundParcelsFromRow(row) {
    row = row || {};
    var customer = row.customer || {};
    var rowDeliveryState = String(row.deliveryState || '').toLowerCase();
    var rowStatus = String(row.status || '').toLowerCase();
    if (!rowDeliveryState && ['delivered', 'completed'].indexOf(rowStatus) >= 0) rowDeliveryState = 'delivered';
    if (!rowDeliveryState && ['returned', 'cancelled'].indexOf(rowStatus) >= 0) rowDeliveryState = 'returned';
    if (rowDeliveryState === 'shipped') rowDeliveryState = 'in_transit';
    var seen = {};
    var parcels = [];
    function add(parcel) {
      var trackingNo = freightFifoNormTrackingNo(parcel && (parcel.trackingNo || parcel) || '');
      if (!trackingNo || seen[trackingNo]) return;
      var parcelDeliveryState = String(parcel && parcel.deliveryState || '').toLowerCase();
      if ((!parcelDeliveryState || parcelDeliveryState === 'pending') && rowDeliveryState) parcelDeliveryState = rowDeliveryState;
      seen[trackingNo] = true;
      parcels.push({
        trackingNo: trackingNo,
        amount: Math.max(0, Number(parcel && (parcel.amount || parcel.codAmount) || 0) || 0),
        note: String(parcel && parcel.note || '').trim(),
        deliveryState: parcelDeliveryState,
        officialStatus: String(parcel && (parcel.officialStatus || parcel.officialStatusText) || '').trim(),
