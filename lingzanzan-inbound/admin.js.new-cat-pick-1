        batchPreview.classList.add('has-batch');
        batchPreview.innerHTML = '<header><div><small>SELECTED EXISTING BATCH</small><h4>目前選定：' + escapeHtml(selectedBatch.batchNo || selectedBatch.id || '-') + '</h4></div><div class="freight-existing-batch-preview-actions"><strong>' + previewPackages + ' 個物流單號／' + previewQty + ' 件</strong><button type="button" class="primary-button" data-freight-existing-batch-continue>繼續加入這一批</button></div></header><p>日期：' + escapeHtml(freightListBusinessDateValue(selectedBatch) || '-') + '／帳號：' + escapeHtml(finalAccount) + '／狀態：' + escapeHtml(selectedBatch.status || '-') + '</p>' + previewWarning + '<div class="freight-existing-batch-preview-list">' + (previewRows.length ? previewRows.map(function (item, index) {
          var sourceId = String(item.sourceItemId || item.id || '');
          var currentItem = freightItemById(sourceId) || item;
          var currentLines = freightVariantLines(currentItem);
