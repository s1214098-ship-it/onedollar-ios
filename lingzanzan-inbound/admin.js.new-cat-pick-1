  // Barcode scanners normally finish each scan with Enter. Keep the first
  // row as the permanent scanner, and retain committed products underneath.
  function commitLiveScan(row) {
    if (!row) return false;
    var input = row.querySelector('[data-live-code]');
    var raw = input && String(input.value || '').trim();
    if (!raw) return false;
    if (adminUsesDemandOrderEntryData() && !adminDemandCatalogReady()) {
