        toast('中國倉請用產品編號對上後，再選顏色、尺寸與數量帶入');
        return false;
      }
      showLiveSuggestions(input);
      return false;
    }
    if (!adminOrderWarehouseLock) setAdminOrderWarehouseLock(liveRowWarehouse(row));
    var scannerWarehouse = row.querySelector('[data-live-warehouse]');
    if (scannerWarehouse && adminOrderWarehouseLock) scannerWarehouse.value = adminOrderWarehouseLock;
    var warehouseSku = liveSkuForRowWarehouse(exactSkuRow.product, exactSkuRow.sku, row);
    if (!warehouseSku) {
      if (liveUsesCnTwHold()) {
        var color = liveColorName(exactSkuRow.sku);
        var size = liveSizeName(exactSkuRow.sku);
        var boundSku = productSkus(state.skus, exactSkuRow.product && exactSkuRow.product.id).find(function (candidate) {
