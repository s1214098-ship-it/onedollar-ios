    var formalProduct = state.products.find(function (product) {
      if (product.archived || product.legacyMislinked || String(product.status || 'active') === 'inactive') return false;
      return [product.code, product.id, product.productLine].some(function (field) { return aliases.indexOf(normalizeLiveCode(field)) !== -1; });
    }) || null;
    if (formalProduct) return formalProduct;
    var legacyProduct = state.products.find(function (product) {
      if (!product.archived && !product.legacyMislinked && String(product.status || 'active') !== 'inactive') return false;
      return [product.code, product.id, product.productLine].some(function (field) { return aliases.indexOf(normalizeLiveCode(field)) !== -1; });
    }) || null;
    if (legacyProduct && legacyProduct.replacementProductId) {
      var replacementProduct = state.products.find(function (row) { return String(row.id || '') === String(legacyProduct.replacementProductId || ''); }) || null;
      if (replacementProduct) return replacementProduct;
