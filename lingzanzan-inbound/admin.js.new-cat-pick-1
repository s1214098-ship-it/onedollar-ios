  function startAdminDataBoot() {
    if (adminDataBootStarted || !isLoginValid()) return;
    adminDataBootStarted = true;
    var currentAdminFileName = location.pathname.split('/').pop() || 'admin.html';
    overviewPage = isAdminOverviewPage();
    needsCatalogData = adminNeedsCatalogData();
    needsCustomerData = !adminUsesLazyPreorderHistory() && (['admin-preorders.html', 'admin-preorder-waiting.html', 'admin-live.html'].indexOf(currentAdminFileName) !== -1 || !!document.querySelector('[data-member-list], [data-manual-preorder-form]'));
    var demandOrderEntryPage = adminUsesDemandOrderEntryData();
    var serverStateRequest = demandOrderEntryPage
      ? Promise.resolve({})
      : loadServerState({ overview: overviewPage, lightweight: !overviewPage });
    if (currentAdminFileName === 'admin-order-tracking.html' || currentAdminFileName === 'admin-preorder-demand.html') {
      serverStateRequest = adminDataTimeout(serverStateRequest, 3500, {});
    }
    var useInteractiveCatalogBoot = ['admin-preorders.html', 'admin-live.html', 'admin-freight.html', 'admin-orders.html', 'admin-order-tracking.html'].indexOf(currentAdminFileName) !== -1;
    if (currentAdminFileName === 'admin-order-tracking.html') {
      orderTrackingAwaitingOrders = true;
      orderTrackingAwaitingInquiries = true;
    }
    serverStateRequest.then(function (serverFiles) {
      if (!useInteractiveCatalogBoot) return loadAdminDataFiles(serverFiles);

      // Make the form usable before downloading and parsing the full catalog.
      var deferFreightTracking = currentAdminFileName === 'admin-freight.html';
      finishAdminDataBoot(false, { deferFreightTracking: deferFreightTracking });
      document.body.setAttribute('data-admin-catalog-loading', 'true');
      return new Promise(function (resolve) {
        requestAnimationFrame(function () {
          requestAnimationFrame(function () { resolve(serverFiles); });
        });
      }).then(function (files) {
        if (adminUsesDemandOrderEntryData()) {
          ensureAdminPreorderCatalogData(false).then(function () {
            var liveSearch = document.querySelector('[data-live-code]');
            if (liveSearch && String(liveSearch.value || '').trim()) showLiveSuggestions(liveSearch);
            var preorderSearch = document.querySelector('[data-manual-preorder-search]');
            if (preorderSearch && String(preorderSearch.value || '').trim() && typeof renderManualPreorderSuggest === 'function') {
              renderManualPreorderSuggest();
            }
          });
          return null;
        }
        if (currentAdminFileName === 'admin-orders.html') {
          adminOrdersDeferredServerFiles = files;
          scheduleAdminOrdersBackgroundRender();
          return null;
        }
        if (currentAdminFileName === 'admin-order-tracking.html') {
          return loadAdminDataFiles(files, { ordersCriticalOnly: true }).then(function (items) {
            var loadedOrders = normalizeOrderRows(items && items[2]);
            state.orders = loadedOrders.length
              ? loadedOrders
              : (Array.isArray(savedLocalSnapshot.orders) ? savedLocalSnapshot.orders : (Array.isArray(state.orders) ? state.orders : []));
            orderTrackingAwaitingOrders = false;
            renderOrderTrackingDashboard();
            document.body.setAttribute('data-order-tracking-inquiries-deferred', 'true');
            return null;
          }).catch(function () {
            orderTrackingAwaitingOrders = false;
            orderTrackingAwaitingInquiries = false;
            renderOrderTrackingDashboard();
            toast('訂單資料載入失敗，請按重新讀取');
            return null;
          });
        }
        if (!deferFreightTracking) return loadAdminDataFiles(files);
        document.body.setAttribute('data-admin-freight-loading', 'true');
        // Freight and catalog/order data are independent HTTP payloads. Loading
        // them serially made every workstation wait for the 5 MB freight file
        // before the rest of the page could even start downloading.
        var freightRequest = loadFreightTracking().then(function () {
          document.body.removeAttribute('data-admin-freight-loading');
        }, function () {
          document.body.removeAttribute('data-admin-freight-loading');
        });
        var dataRequest = loadAdminDataFiles(files, { freightCriticalOnly: true });
        return Promise.all([dataRequest, freightRequest]).then(function (results) {
          // The freight shell must stay responsive. Customer/order history and
          // the full product catalog are separate multi-megabyte payloads, so
          // they are loaded only when the operator enters the matching block.
          installAdminFreightCatalogLazyLoader(files);
          /* LZ_FIFO_OPEN_20260925: 出貨順序不要等整頁物流卡片畫完，否則會一直「整理中」。 */
          try { prepareFreightLazySecondarySections(); } catch (error) {}
          return results[0];
        });
      });
    }).then(function (items) {
      var demandDeferred = adminUsesDemandOrderEntryData() && items === null;
      var trackingDeferred = currentAdminFileName === 'admin-order-tracking.html' && items === null;
      if (!demandDeferred && !(currentAdminFileName === 'admin-orders.html' && items === null) && !trackingDeferred) {
        applyAdminDataItems(items);
        importCustomersToMembersIfNeeded();
      }
      if (currentAdminFileName === 'admin-freight.html') renderFreightTracking();
      if (currentAdminFileName === 'admin-freight.html') scheduleAdminSectionOutlineRefresh();
      document.body.removeAttribute('data-admin-catalog-loading');
      if (demandDeferred) return;
      if (currentAdminFileName === 'admin-orders.html') {
        finishAdminDataBoot(false, { skipCurrentWorkline: true });
        scheduleAdminOrdersBackgroundRender();
      } else if (trackingDeferred) {
        finishAdminDataBoot(false, { skipCurrentWorkline: true });
      } else {
        finishAdminDataBoot(false);
      }
    }).catch(function () {
      document.body.removeAttribute('data-admin-catalog-loading');
      orderTrackingAwaitingOrders = false;
      orderTrackingAwaitingInquiries = false;
      finishAdminDataBoot(true);
    });
  }

