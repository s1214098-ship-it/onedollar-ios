  function freightForecastProductGroups(items) {
    var groups = {};
    (items || []).forEach(function (item) {
      var variants = freightVariantLines(item);
      if (!variants.length) return;
      var itemQty = freightVariantTotalQuantity(variants);
      var linkedQty = (Array.isArray(item.customerLinks) ? item.customerLinks : []).reduce(function (sum, row) { return sum + Math.max(0, Number(row && row.qty || 0)); }, 0);
      var reservedQty = Math.min(itemQty, Math.max(linkedQty, Math.max(0, Number(item.purchaseOffsetQty || 0))));
      var itemBases = {};
      variants.forEach(function (line, variantIndex) {
        var fullBarcode = String(line.sampleBarcode || line.taiwanBarcode || '').trim();
        var rawCode = String(line.productCode || line.catalogProductCode || item.productCode || item.catalogProductCode || fullBarcode || '').trim();
        var baseCode = String(labelBarcodeBaseProductCode(rawCode) || freightProductCodeFromBarcode(rawCode) || rawCode).trim();
        var displayCode = baseCode || fullBarcode || item.productName || '未設定產品編號';
        var title = item.productName || line.productName || '';
        // The preorder warehouse is product inventory, not a logistics-row
        // list.  One official product barcode must remain one stock group even
        // when different sellers or freight rows used different product names.
        var groupKey = freightDemandIdentity(displayCode);
        if (!groups[groupKey]) groups[groupKey] = { code: displayCode, title: title, titles: [], searchTokens: [], total: 0, reserved: 0, available: 0, variants: {}, images: [], itemIds: {}, logisticsRows: [], customers: [], firstDate: item.date || '' };
        var group = groups[groupKey];
        if (title && group.titles.indexOf(title) === -1) group.titles.push(title);
        [
          rawCode, baseCode, displayCode, fullBarcode,
          line.productCode, line.catalogProductCode, line.sampleBarcode, line.taiwanBarcode, line.sku, line.skuId,
          item.productCode, item.catalogProductCode, item.sampleBarcode, item.taiwanBarcode, item.sku, item.skuId,
          item.productName, line.productName, item.trackingNo, item.pendingLogisticsCode
        ].forEach(function (value) {
          value = String(value || '').trim();
          if (value && group.searchTokens.indexOf(value) === -1) group.searchTokens.push(value);
        });
        group.total += Math.max(1, Number(line.quantity || 1));
        group.itemIds[item.id] = true;
        if (!group.logisticsRows.some(function (row) { return row.id === item.id; })) {
          group.logisticsRows.push({ id: item.id || '', trackingNo: item.trackingNo || item.pendingLogisticsCode || '待補物流單號', quantity: itemQty, progress: item.progress || '待處理', date: item.date || '' });
        }
        itemBases[groupKey] = true;
        freightForecastImageSources(item, line, displayCode).forEach(function (src) { if (group.images.indexOf(src) === -1) group.images.push(src); });
        var canonicalColor = canonicalProductVariantColor(line.color || '未選顏色');
        var canonicalSize = canonicalProductVariantSize(line.size || 'NO SIZE');
        var variantKey = [freightDemandIdentity(canonicalColor), freightDemandIdentity(canonicalSize), freightDemandIdentity(fullBarcode || displayCode)].join('|');
        if (!group.variants[variantKey]) group.variants[variantKey] = { color: canonicalColor, size: canonicalSize, barcode: fullBarcode || displayCode, quantity: 0, itemId: item.id || '', variantIndex: variantIndex };
        group.variants[variantKey].quantity += Math.max(1, Number(line.quantity || 1));
      });
      var baseKeys = Object.keys(itemBases);
      if (baseKeys.length === 1 && groups[baseKeys[0]]) {
        groups[baseKeys[0]].reserved += reservedQty;
        (Array.isArray(item.customerLinks) ? item.customerLinks : []).forEach(function (link) {
          var inquiry = (state.inquiries || []).find(function (row) { return String(row.id || '') === String(link && link.inquiryId || ''); });
          var customer = inquiry && inquiry.customer || {};
          var name = String(link && (link.customerName || link.name) || customer.name || inquiry && inquiry.customerName || '').trim();
          var orderNo = String(link && (link.inquiryId || link.customerOrderNo) || inquiry && inquiry.id || '').trim();
          var date = String(link && (link.orderDay || link.purchaseDate) || inquiry && (inquiry.createdAt || inquiry.orderDate || inquiry.purchaseDate) || '').trim();
          if (date.indexOf('T') !== -1) date = date.slice(0, 10);
          if (name) {
            var customerKey = [orderNo, name].join('|');
            var existingCustomer = groups[baseKeys[0]].customers.find(function (row) { return row.key === customerKey; });
            if (existingCustomer) existingCustomer.qty += Math.max(1, Number(link && link.qty || 1));
            else groups[baseKeys[0]].customers.push({ key: customerKey, name: name, orderNo: orderNo, date: date, qty: Math.max(1, Number(link && link.qty || 1)), waiting: false });
          }
        });
      }
    });
    (state.inquiries || []).forEach(function (row) {
