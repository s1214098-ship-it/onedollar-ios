    if (topLevelValues.some(function (value) { return freightDemandBaseIdentity(value) === wanted; })) return true;
    return freightVariantLines(item || {}).some(function (line) {
      var raw = line.productCode || line.catalogProductCode || item.productCode || item.catalogProductCode || line.sampleBarcode || line.taiwanBarcode || '';
