  function normalizeScanCode(value) {
    var text = String(value == null ? '' : value);
    try { text = text.normalize('NFKC'); } catch (error) {}
    return text.replace(/[^0-9A-Za-z]/g, '').toUpperCase();
  }

  function canonicalPowBowScanCode(value) {
    var raw = normalizeScanCode(value);
    if (!raw) return '';
    var map = {
      POWL6: 'BOW006', POW6: 'BOW006', POW006: 'BOW006',
      POWL7: 'BOW007', POW7: 'BOW007', POW007: 'BOW007',
      POWL8: 'BOW008', POW8: 'BOW008', POW008: 'BOW008',
      POWL15: 'BOW004', POW15: 'BOW004', POW015: 'BOW004'
    };
    var keys = Object.keys(map).sort(function (a, b) { return b.length - a.length; });
    for (var i = 0; i < keys.length; i += 1) {
      var key = keys[i];
      if (raw === key) return map[key];
      if (raw.indexOf(key + 'P') === 0) return map[key] + raw.slice(key.length);
      if (raw.indexOf(key + 'C') === 0) return map[key] + raw.slice(key.length);
      if (raw.indexOf(key + '-') === 0) return map[key] + raw.slice(key.length);
    }
    return raw;
  }

  function powBowSearchCodes(value) {
    var raw = normalizeScanCode(value);
    var canonical = canonicalPowBowScanCode(raw);
    return [raw, canonical].filter(function (entry, index, list) { return entry && list.indexOf(entry) === index; });
  }

  function scanFamilyCode(value) {
    var raw = normalizeScanCode(value);
    if (!raw) return '';
    try {
      var concat = searchParseConcatBarcode(value);
      if (concat && concat.productCode) return canonicalPowBowScanCode(concat.productCode);
    } catch (error) {}
    try {
      var parsed = parseLegacyProductBarcode(raw);
      if (parsed && parsed.productCode) return canonicalPowBowScanCode(parsed.productCode);
    } catch (error) {}
    var beforeDash = raw.split('-')[0];
    var v3 = beforeDash.match(/^([A-Z]+\d+)C[A-Z0-9]+S[A-Z0-9]+(?:P\d+)?$/);
    if (v3) return v3[1];
    var pIndex = beforeDash.search(/P\d/);
    if (pIndex > 0) return beforeDash.slice(0, pIndex);
    var match = beforeDash.match(/^[A-Z]{1,6}\d{1,6}/);
    return match ? match[0] : beforeDash;
  }

