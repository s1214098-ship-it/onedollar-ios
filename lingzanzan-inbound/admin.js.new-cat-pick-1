  function ensureWarehouseReferenceData() {
    var defaultWarehouses = ['台灣倉', '印尼倉', '中國倉'];
    var defaultSizes = ['NO SIZE', 'XS', 'S', 'M', 'L', 'XL', '2XL', '37', '40', '42', '38', '1.5', '36', '1.3', '35', '43', '2.0'];
    var defaultSizeModules = [
      { name: '女裝一般尺碼', items: ['S', 'M', 'L', 'XL', '2XL'] },
      { name: '全部尺碼', items: defaultSizes.slice() }
    ];
    var defaultShelves = ['A架', 'B架', 'C架', 'D架', 'E架', 'F架', 'G架', 'H架', '直播室'];
    var defaultLayers = ['第一層', '第二層', '第三層', '第四層', '第五層', '第六層'];
    var defaultLocationCombos = [
      '台灣倉 / 直播室 / 第一層', '台灣倉 / 直播室 / 第二層', '台灣倉 / 直播室 / 第三層', '台灣倉 / 直播室 / 第四層',
      '台灣倉 / B架 / 第一層', '台灣倉 / B架 / 第二層', '台灣倉 / B架 / 第三層', '台灣倉 / B架 / 第四層', '台灣倉 / B架 / 第五層',
      '台灣倉 / A架 / 第一層'
    ];
    state.warehouses = Array.from(new Set((Array.isArray(state.warehouses) ? state.warehouses : []).map(function (item) {
      var key = String(item || '').trim().toUpperCase();
      return ({ TW: '台灣倉', CN: '中國倉', ID: '印尼倉', PREORDER: '預購倉' })[key] || String(item || '').trim();
    }).filter(Boolean)));
    state.shelves = (Array.isArray(state.shelves) ? state.shelves : []).filter(function (item) { return !isInvalidShelfName(item); });
    state.layers = (Array.isArray(state.layers) ? state.layers : []).filter(function (item) { return !isInvalidLayerName(item); });
    state.defaultShelves = (Array.isArray(state.defaultShelves) ? state.defaultShelves : []).filter(function (item) { return !isInvalidShelfName(item); });
    state.colors = Array.isArray(state.colors) ? state.colors : [];
    state.sizes = Array.isArray(state.sizes) ? state.sizes : [];
    state.sizeModules = Array.isArray(state.sizeModules) ? state.sizeModules : [];
    (state.products || []).concat(state.skus || []).forEach(function (record) {
      if (!record) return;
      if (isInvalidShelfName(record.shelf)) record.shelf = '';
      if (Array.isArray(record.shelves)) {
        record.shelves = record.shelves.filter(function (item) { return !isInvalidShelfName(item); });
      }
      if (isInvalidLayerName(record.layer)) record.layer = '';
      if (Array.isArray(record.layers)) {
        record.layers = record.layers.filter(function (item) { return !isInvalidLayerName(item); });
      }
    });
    defaultWarehouses.forEach(function (item) { if (state.warehouses.indexOf(item) === -1) state.warehouses.push(item); });
    defaultSizes.forEach(function (item) { if (state.sizes.indexOf(item) === -1) state.sizes.push(item); });
    defaultSizeModules.forEach(function (module) {
      var existing = state.sizeModules.find(function (item) { return item && item.name === module.name; });
      if (!existing) {
        state.sizeModules.push({ name: module.name, items: module.items.slice() });
        return;
      }
      existing.items = Array.isArray(existing.items) ? existing.items : [];
      module.items.forEach(function (item) { if (existing.items.indexOf(item) === -1) existing.items.push(item); });
    });
    defaultShelves.forEach(function (item) { if (state.shelves.indexOf(item) === -1) state.shelves.push(item); });
    defaultLayers.forEach(function (item) { if (state.layers.indexOf(item) === -1) state.layers.push(item); });
    defaultLocationCombos.forEach(function (item) { if (state.defaultShelves.indexOf(item) === -1) state.defaultShelves.push(item); });
    // Build the product lookup once.  The former productSkus() call filtered the
    // complete SKU array once per product, which froze catalog-heavy worklines.
    var productsById = new Map();
    (state.products || []).forEach(function (product) {
      if (product && product.id) productsById.set(product.id, product);
