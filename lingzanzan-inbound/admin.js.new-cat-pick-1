        if (host) host.scrollIntoView({ behavior: 'smooth', block: 'start' });
        return;
      }
      var target = event.target.closest('[data-order-demand-toggle]');
      if (!target) return;
      orderDemandSummaryExpanded = !orderDemandSummaryExpanded;
      target.setAttribute('aria-expanded', orderDemandSummaryExpanded ? 'true' : 'false');
      target.textContent = orderDemandSummaryExpanded ? '收合統計' : '開始統計';
      if (controls) controls.hidden = !orderDemandSummaryExpanded;
      if (overview) overview.hidden = !orderDemandSummaryExpanded;
      if (grid) grid.hidden = !orderDemandSummaryExpanded;
      if (!orderDemandSummaryExpanded) return;
      orderDemandPage = 1;
      if (grid) grid.innerHTML = '<div class="order-tracking-empty">正在載入產品、客戶需求與四倉資料…</div>';
      standaloneOrderDemandLoading = true;
      target.disabled = true;
      target.textContent = '資料載入中…';
      Promise.all([loadOrderTrackingCatalogAfterFirstPaint(), loadFreightTracking(true), loadOrderDemandShortageConfirmations()]).then(function () {
        standaloneOrderDemandLoading = false;
        window.requestAnimationFrame(function () {
          window.setTimeout(function () {
            renderOrderTrackingDemandSummary();
            target.disabled = false;
            target.textContent = '收合統計';
