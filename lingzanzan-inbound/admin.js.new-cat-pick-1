  function normalizeAdminOrderWarehouse(value) {
    var raw = String(value || '').trim();
    var token = raw.toUpperCase().replace(/[\s-]+/g, '_');
    if (['TW', 'TW_BAOHUI', 'TAIWAN', 'BAOHUI'].indexOf(token) >= 0 || /台灣|台湾|寶輝|宝辉|taiwan|gudang\s*taiwan/i.test(raw)) return '台灣倉';
    if (['CN', 'CN_DONGGUAN', 'CHINA', 'DONGGUAN'].indexOf(token) >= 0 || /中國|中国|東莞|东莞|china|gudang\s*china/i.test(raw)) return '中國倉';
    if (['ID', 'ID_DIRECT', 'INDONESIA', 'INDO'].indexOf(token) >= 0 || /印尼|indonesia|gudang\s*indonesia/i.test(raw)) return '印尼倉';
    return '';
