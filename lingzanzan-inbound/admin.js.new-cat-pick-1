    // LZ_SIZE_STEP_20260927: 不要自動跳出用途選單蓋住「關閉」。要印再按「立即列印本次條碼」。
  }

  function freightFifoCreatedTime(row) {
    var time = Date.parse(row && (row.createdAt || row.orderDate || row.submittedAt || row.updatedAt || ''));
    return Number.isFinite(time) ? time : 0;
  }

  function freightFifoQueueCompare(a, b) {
    var aPriority = !!(a && a.manualQueuePriority);
    var bPriority = !!(b && b.manualQueuePriority);
    if (aPriority !== bPriority) return aPriority ? -1 : 1;
    if (aPriority && bPriority) {
      var priorityTime = String(b.manualQueuePriorityAt || '').localeCompare(String(a.manualQueuePriorityAt || ''));
      if (priorityTime) return priorityTime;
    }
    return freightFifoCreatedTime(a) - freightFifoCreatedTime(b)
      || String(a && a.id || '').localeCompare(String(b && b.id || ''), 'zh-Hant', { numeric: true });
  }

  function freightFifoDefaultPriorityItemTarget(row) {
    var items = Array.isArray(row && row.items) ? row.items : [];
    if (!items.length) return { itemIndex: null, productCode: '' };
    var pending = [];
    items.forEach(function (item, index) {
      var requested = Math.max(1, Number(item && (item.requestedQty || item.qty || item.quantity) || 1));
      var received = Math.max(0, Number(item && item.freightReceivedQty || 0));
      if (received < requested) pending.push({ index: index, item: item });
    });
    if (pending.length !== 1) return { itemIndex: null, productCode: '' };
    var only = pending[0];
    return {
      itemIndex: only.index,
      productCode: String(only.item.code || only.item.productCode || only.item.sku || '').trim()
    };
  }

  function freightFifoReadyPreorders(sourceRows) {
    return (Array.isArray(sourceRows) ? sourceRows : (state.inquiries || [])).filter(function (row) {
      if (!row || row.status === 'cancelled' || preorderInquiryConverted(row) || freightFifoInquiryWasReturned(row)) return false;
      if (!!row.manualQueuePriority) return true;
      if (String(row.freightCustomerQueueDecision || '') === 'deferred') return true;
      if (freightFifoShippingSelected(row)) return true;
      if (String(row.salesFifoConfirmAt || row.salesReleasedAt || '').trim()) return true;
      var items = Array.isArray(row.items) ? row.items : [];
      var hasArrivedItem = items.length && items.some(function (item) {
        return Math.max(0, Number(item && item.freightReceivedQty || 0)) > 0
          || String(item && item.freightArrivalStatus || '').toLowerCase() === 'received';
      });
      if (hasArrivedItem) return true;
      var waitStatus = String(row.preorderWaitStatus || 'waiting_other_items').toLowerCase();
      var isUnreleasedPreorder = (String(row.orderType || '').toLowerCase() === 'preorder'
          || String(row.status || '').toLowerCase() === 'preorder_pending')
        && waitStatus !== 'ready_to_ship';
      if (isUnreleasedPreorder) return false;
      return freightFifoTaiwanStockPlan(row, items).ready || freightFifoTaiwanPriorityReady(row);
    }).sort(freightFifoQueueCompare);
  }

  function freightFifoCheapReadyPreorders() {
    return (state.inquiries || []).filter(function (row) {
      if (!row || row.status === 'cancelled' || preorderInquiryConverted(row) || freightFifoInquiryWasReturned(row)) return false;
      if (!!row.manualQueuePriority) return true;
      if (String(row.freightCustomerQueueDecision || '') === 'deferred') return true;
      if (freightFifoShippingSelected(row)) return true;
      if (String(row.salesFifoConfirmAt || row.salesReleasedAt || '').trim()) return true;
      return (Array.isArray(row.items) ? row.items : []).some(function (item) {
        return Math.max(0, Number(item && item.freightReceivedQty || 0)) > 0
          || String(item && item.freightArrivalStatus || '').toLowerCase() === 'received';
      });
    }).sort(freightFifoQueueCompare);
  }

  function freightFifoCheapArrivalState(row) {
    var items = Array.isArray(row && row.items) ? row.items : [];
    var requestedQty = 0;
    var receivedQty = 0;
    items.forEach(function (item) {
      var requested = Math.max(1, Number(item && (item.requestedQty || item.qty || item.quantity) || 1));
      requestedQty += requested;
      receivedQty += Math.min(requested, Math.max(0, Number(item && item.freightReceivedQty || 0)));
    });
    return {
      requestedQty: requestedQty,
      receivedQty: receivedQty,
      complete: requestedQty > 0 && receivedQty >= requestedQty,
      taiwanStockReady: false,
      taiwanStockQty: 0
    };
  }

  function freightFifoArrivalState(row) {
    var cheap = freightFifoCheapArrivalState(row);
    if (!cheap.requestedQty || cheap.receivedQty >= cheap.requestedQty) return cheap;
    var missingQty = Math.max(0, cheap.requestedQty - cheap.receivedQty);
    var taiwanStockReady = freightFifoTaiwanPriorityReady(row);
    if (taiwanStockReady) cheap.receivedQty = cheap.requestedQty;
    return {
      requestedQty: cheap.requestedQty,
      receivedQty: cheap.receivedQty,
      complete: cheap.requestedQty > 0 && cheap.receivedQty >= cheap.requestedQty,
      taiwanStockReady: taiwanStockReady,
      taiwanStockQty: taiwanStockReady ? missingQty : 0
    };
  }

  function freightFifoIsActiveFifoOrder(order) {
    if (!order || !(order.sourceInquiryId || order.convertedFromInquiryId || order.inquiryId)) return false;
    var status = String(order.status || '').toLowerCase();
    var delivery = freightFifoEffectiveDeliveryState(order);
    return ['returned', 'cancelled', 'delivered', 'completed', 'reverted_to_waiting'].indexOf(status) === -1
      && ['returned', 'delivered'].indexOf(delivery) === -1;
  }

  function freightFifoActiveOrders() {
    return (state.orders || []).filter(freightFifoIsActiveFifoOrder).sort(function (a, b) {
      return freightFifoCreatedTime(a) - freightFifoCreatedTime(b) || String(a.id || '').localeCompare(String(b.id || ''), 'zh-Hant', { numeric: true });
    });
  }

  function freightFifoPartitionActiveOrders(orders) {
    var formal = [];
    var transit = [];
    (orders || []).forEach(function (order) {
      if (!order) return;
      var status = String(order.status || '').toLowerCase();
      if (['delivered','completed','cancelled','canceled','returned','refunded','closed'].indexOf(status) !== -1) return;
      var delivery = freightFifoEffectiveDeliveryState(order);
      if (delivery === 'delivered' || delivery === 'returned') return;
      if (delivery === 'in_transit' || delivery === 'arrived_store') transit.push(order);
      else formal.push(order);
    });
    return {
      formal: freightFifoCollapseShipmentGroups(formal),
      transit: freightFifoCollapseShipmentGroups(transit)
    };
  }

  var freightFifoIndexCache = null;
  var forcedCombinedShipmentGroupForEditor = '';

  function freightFifoIndexes() {
    var inquiries = state.inquiries || [];
    var orders = state.orders || [];
    if (freightFifoIndexCache
        && freightFifoIndexCache.inquiries === inquiries
        && freightFifoIndexCache.orders === orders) {
      return freightFifoIndexCache;
    }
    var inquiryById = new Map();
    inquiries.forEach(function (row) {
      if (row && row.id) inquiryById.set(String(row.id), row);
    });
    var orderById = new Map();
    var orderByInquiryId = new Map();
    orders.forEach(function (order) {
      if (!order) return;
      if (order.id) orderById.set(String(order.id), order);
      var status = String(order.status || '').toLowerCase();
      if (['cancelled', 'returned', 'reverted_to_waiting'].indexOf(status) !== -1 || order.revertedToWaitingAt) return;
      [order.id, order.sourceInquiryId, order.convertedFromInquiryId, order.inquiryId].forEach(function (id) {
        id = String(id || '').trim();
        if (id && !orderByInquiryId.has(id)) orderByInquiryId.set(id, order);
      });
    });
    freightFifoIndexCache = {
      inquiries: inquiries,
      orders: orders,
      inquiryById: inquiryById,
      orderById: orderById,
      orderByInquiryId: orderByInquiryId
    };
    return freightFifoIndexCache;
  }

  var freightFifoReservedQtyCache = {
    freightTracking: null,
    rows: new WeakMap()
  };

  function freightFifoReservedItemQty(row, item, itemIndex) {
    row = row || {};
    item = item || {};
    var freightTracking = state.freightTracking || null;
    if (freightFifoReservedQtyCache.freightTracking !== freightTracking) {
      freightFifoReservedQtyCache.freightTracking = freightTracking;
      freightFifoReservedQtyCache.rows = new WeakMap();
    }
    var rowCache = freightFifoReservedQtyCache.rows.get(row);
    if (!rowCache) {
      rowCache = new Map();
      freightFifoReservedQtyCache.rows.set(row, rowCache);
    }
    var cacheKey = String(itemIndex) + '|' + String(item.code || item.productCode || item.sku || item.skuId || item.productId || '');
    if (rowCache.has(cacheKey)) return rowCache.get(cacheKey);
    var inquiryIds = [
      row.id,
      row.sourceInquiryId,
      row.convertedFromInquiryId,
      row.inquiryId
    ].map(function (value) { return String(value || '').trim(); }).filter(Boolean);
    if (!inquiryIds.length) return 0;
    var wantedIdentities = preorderOfficialProductIdentities(
      [item.code, item.productCode],
      [item.sku, item.skuId, item.productId, item.barcode]
    );
    var wantedColor = freightDemandIdentity(canonicalProductSpecificVariantColor(
      item.code || item.productCode || item.sku || '',
      item.color || item.colorName || ''
    ));
    var wantedSize = freightDemandIdentity(canonicalProductVariantSize(item.size || item.sizeName || 'NO SIZE'));
    var seen = {};
    var reservedQty = 0;
    // state.freightTracking is normalized when it is loaded or updated. Running
    // the full deep normalizer again for every customer item made a one-phone
    // search scan the whole freight dataset repeatedly.
    ((state.freightTracking && state.freightTracking.items) || []).forEach(function (freightItem, freightIndex) {
      var candidates = [freightItem].concat(freightVariantLines(freightItem));
      candidates.forEach(function (candidate, candidateIndex) {
        var candidateIdentities = preorderOfficialProductIdentities(
          [candidate.productCode, candidate.catalogProductCode, freightItem.productCode, freightItem.catalogProductCode],
          [candidate.productId, candidate.skuId, candidate.sampleBarcode, candidate.taiwanBarcode, freightItem.productId]
        );
        var identityMatches = Array.from(wantedIdentities).some(function (identity) {
          return candidateIdentities.has(identity);
        });
        var candidateColor = freightDemandIdentity(canonicalProductSpecificVariantColor(
          candidate.productCode || candidate.catalogProductCode || freightItem.productCode || '',
          candidate.color || candidate.colorName || freightItem.color || freightItem.colorName || ''
        ));
        var candidateSize = freightDemandIdentity(canonicalProductVariantSize(
          candidate.size || candidate.sizeName || freightItem.size || freightItem.sizeName || 'NO SIZE'
        ));
        var links = Array.isArray(candidate.customerLinks)
          ? candidate.customerLinks
          : (candidate === freightItem && Array.isArray(freightItem.customerLinks) ? freightItem.customerLinks : []);
        links.forEach(function (link, linkIndex) {
          var linkInquiryId = String(link && (link.inquiryId || link.customerOrderNo) || '').trim();
          if (inquiryIds.indexOf(linkInquiryId) === -1) return;
          var linkStatus = String(link && link.status || '').toLowerCase();
          if (['released', 'cancelled', 'canceled', 'shipped', 'completed'].indexOf(linkStatus) !== -1) return;
          var hasExactItemIndex = link.itemIndex !== undefined && link.itemIndex !== null && link.itemIndex !== '';
          if (hasExactItemIndex && Number(link.itemIndex) !== Number(itemIndex)) return;
          if (!hasExactItemIndex && (!identityMatches || (wantedColor && candidateColor !== wantedColor) || (wantedSize && candidateSize !== wantedSize))) return;
          var uniqueKey = String(link.allocationId || [
            freightItem.id || freightIndex,
            candidateIndex,
            linkInquiryId,
            hasExactItemIndex ? link.itemIndex : '',
            link.qty || 0,
            link.allocatedAt || link.createdAt || ''
          ].join('|'));
          if (seen[uniqueKey]) return;
          seen[uniqueKey] = true;
          reservedQty += Math.max(0, Number(link.qty || 0));
        });
      });
    });
    rowCache.set(cacheKey, reservedQty);
    return reservedQty;
  }

  function freightFifoItemStatus(item, context) {
    item = item || {};
    context = context || {};
    var requested = Math.max(1, Number(item.requestedQty || item.qty || item.quantity || 1));
    var reserved = Math.min(requested, Math.max(0, Number(context.reservedQty || 0)));
    var hasArrival = item.freightReceivedQty !== undefined && item.freightReceivedQty !== null;
    var preorderWaiting = freightFifoItemUsesPreorderWarehouse(item)
      && !hasArrival
      && !freightFifoRowHasPhysicalFulfillment(context.row);
    var received = context.formalOrder && !hasArrival && !preorderWaiting
      ? requested
      : Math.max(0, Number(item.freightReceivedQty || 0));
    var decision = String(context.decision || '');
    var taiwanStockQty = !preorderWaiting && !context.formalOrder && context.autoTaiwanStockReady
      ? Math.max(0, requested - received)
      : 0;
    if (taiwanStockQty > 0) {
      return {
        requested: requested,
        reserved: reserved,
        received: received,
        taiwanStockQty: taiwanStockQty,
        key: 'taiwan-stock-ready',
        label: '台灣現貨足夠 ' + taiwanStockQty + ' 件／可直接扣庫出貨'
      };
    }
    if (received <= 0 && reserved > 0) return { requested: requested, reserved: reserved, received: 0, key: 'reserved-waiting', label: '名額已綁 ' + reserved + ' 件／尚未驗收到貨' };
    if (received <= 0) return { requested: requested, reserved: reserved, received: 0, key: 'not-arrived', label: '尚未驗收到貨／目前不可出貨' };
    if (received < requested) return { requested: requested, reserved: reserved, received: received, key: 'partial', label: '實際到貨 ' + received + '／' + requested + ' 件，尚缺 ' + (requested - received) + ' 件' };
    if (decision === 'wait_all') return { requested: requested, reserved: reserved, received: received, key: 'hold', label: '已配好貨物／寄庫等待' };
    if (decision === 'ask_sales') return { requested: requested, reserved: reserved, received: received, key: 'review', label: '已配好貨物／暫存待問業務' };
    if (decision === 'ship_now' || context.allComplete || context.formalOrder) return { requested: requested, reserved: reserved, received: received, key: 'ready', label: '已驗收到貨／可出貨' };
    return { requested: requested, reserved: reserved, received: received, key: 'allocated', label: '已驗收到貨／待決定寄庫或先出' };
  }

  // 本機429：台灣現貨插隊仍以 FIFO 為預設；只有「真實物流單號且準備寄出」
  // 或「已寄出」的訂單不可退讓。寄庫與尚未寄出的正式單會列出客戶名單，
  // 由管理者人工選擇誰往後排。正式轉單已由後端扣除 SKU stock，因此畫面
  // 會把可退讓與不可退讓的正式單一併還原為台灣倉實體總數。
  function freightFifoItemTaiwanPriorityPlan(row, item) {
    var plan = preorderTaiwanStockPlan(row, [item]);
    var line = plan && Array.isArray(plan.lines) ? plan.lines[0] : null;
    var formalYieldQty = freightFormalPriorityCandidates({ items: [item] }, [Number.MAX_SAFE_INTEGER]).reduce(function (sum, candidate) {
      return sum + Math.max(0, Number(candidate && candidate.quantity || 0));
    }, 0);
    var formalProtectedQty = freightFormalPriorityProtectedCandidates({ items: [item] }, [Number.MAX_SAFE_INTEGER]).reduce(function (sum, candidate) {
      return sum + Math.max(0, Number(candidate && candidate.quantity || 0));
    }, 0);
    // A freight/FIFO reservation can reduce this item's remaining preorder demand
    // to zero, which makes preorderTaiwanStockPlan omit the line entirely.  The
    // operator is explicitly switching this item to Taiwan on-hand stock, so read
    // the physical SKU quantity directly instead of treating the missing demand
    // line as zero inventory.
    var physicalAvailableQty = Math.max(
      0,
      Number(preorderItemReadyStockQty(item) || 0),
      Number(line && line.stockQty || 0)
    );
    var fifoReservedQty = Math.max(0, Number(line && line.earlierCustomerQty || 0));
    // Priority/manual insertion is for Taiwan ready-stock customers only. Do not subtract preorder FIFO soft reservations here.
    var availableStockQty = physicalAvailableQty;
    return {
      physicalQty: physicalAvailableQty,
      stockQty: physicalAvailableQty + formalYieldQty + formalProtectedQty,
      earlierCustomerQty: fifoReservedQty + formalYieldQty + formalProtectedQty,
      availableQty: availableStockQty,
      fifoReservedQty: fifoReservedQty,
      displaceableQty: formalYieldQty,
      protectedQty: formalProtectedQty,
      demandQty: Math.max(1, Number(line && line.demandQty || item && (item.requestedQty || item.qty || item.quantity) || 1))
    };
  }

  function freightFifoItemDisplayCode(item) {
    item = item || {};
    var sku = String(item.sku || item.skuId || item.barcode || item.sampleBarcode || item.taiwanBarcode || item.customerSupplyBarcode || '').trim();
    var code = String(item.code || item.productCode || '').trim();
    if (!sku) return code || '-';
    var skuPrefix = (sku.match(/^([A-Z0-9]+?)P\d/i) || [])[1] || '';
    if (code && skuPrefix && code.toUpperCase() !== skuPrefix.toUpperCase()) return sku;
    return code || sku;
  }

  function freightFifoProductBarcodeSearchText(item) {
    item = item || {};
    var variants = [];
    try { variants = freightVariantLines(item) || []; } catch (error) { variants = []; }
    var values = [
      freightFifoItemDisplayCode(item),
      item.code, item.productCode, item.catalogProductCode, item.productId, item.id,
      item.sku, item.skuId, item.barcode, item.companyBarcode, item.mappingCode, item.legacyBarcode,
      item.sampleBarcode, item.taiwanBarcode, item.productBarcode, item.customerSupplyBarcode, item.productFiledBarcode,
      item.productName, item.name, item.title, item.color, item.colorName, item.size, item.sizeName
    ];
    variants.forEach(function (line) {
      line = line || {};
      values.push(
        line.code, line.productCode, line.catalogProductCode, line.productId, line.id,
        line.sku, line.skuId, line.barcode, line.companyBarcode, line.mappingCode, line.legacyBarcode,
        line.sampleBarcode, line.taiwanBarcode, line.productBarcode, line.customerSupplyBarcode,
        line.productName, line.name, line.title, line.color, line.colorName, line.size, line.sizeName
