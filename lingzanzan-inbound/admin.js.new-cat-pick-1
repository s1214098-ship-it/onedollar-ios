    if (note === null) return;
    note = String(note || '').trim() || defaultNote;
    var isMerged = String(row.shipmentMergeGroupId || '').trim() !== '';
    var confirmText = (isMerged ? '這是合併出貨單，會整張合併單一起轉寄庫。' : '這張訂單會轉到寄庫區。')
