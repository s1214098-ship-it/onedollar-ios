    return !!freightAllocationColorKey(canonicalProductSpecificVariantColor(productCode, line && line.color))
      && freightAllocationColorKey(canonicalProductSpecificVariantColor(productCode, line && line.color)) === freightAllocationColorKey(canonicalProductSpecificVariantColor(productCode, group && group.color))
