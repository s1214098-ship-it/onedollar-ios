  function updateOrderBulkState() {
    var checks = Array.from(document.querySelectorAll('[data-order-select]'));
    var selected = checks.filter(function (input) { return input.checked; });
    var count = document.querySelector('[data-order-selected-count]');
    if (count) count.textContent = '已選 ' + selected.length + ' 張訂單';
    document.querySelectorAll('[data-bulk-delete-orders]').forEach(function (deleteButton) {
      deleteButton.disabled = !selected.length;
    });
    var selectedOrders = selected.map(function (input) {
      var id = input.getAttribute('data-order-select') || '';
      return (state.orders || []).find(function (order) { return String(order.id || '') === String(id); });
    }).filter(Boolean);
    var mergePhones = Array.from(new Set(selectedOrders.map(function (order) {
      return adminManualPhoneDigits((order.customer || {}).phone || '');
    }).filter(function (phone) { return phone.length >= 6; })));
    var mergeOpen = selectedOrders.every(function (order) {
      return ['shipped', 'in_transit', 'delivered', 'completed', 'returned', 'cancelled', 'refunded', 'closed'].indexOf(String(order.status || '').toLowerCase()) === -1;
    });
    var mergeAllowed = selectedOrders.length >= 2 && mergePhones.length === 1 && mergeOpen;
    var mergeButton = document.querySelector('[data-bulk-merge-shipment]');
    if (mergeButton) mergeButton.disabled = !mergeAllowed;
    var mergeStatus = document.querySelector('[data-order-merge-selection-status]');
    if (mergeStatus) {
      mergeStatus.textContent = !selectedOrders.length
        ? '請勾選同一支電話至少 2 張未完成訂單'
        : (selectedOrders.length < 2
          ? '再勾選同一位客戶的其他訂單'
          : (mergePhones.length !== 1
            ? '所選訂單電話不同，不能合併'
            : (!mergeOpen ? '所選訂單含已出貨或已完成資料，不能合併' : '可合併 ' + selectedOrders.length + ' 張；運費只保留一次')));
      mergeStatus.classList.toggle('is-ready', mergeAllowed);
    }
    var clearButton = document.querySelector('[data-order-clear-selection]');
    if (clearButton) clearButton.disabled = !selected.length;
    var selectAllButton = document.querySelector('[data-order-select-all]');
    if (selectAllButton) selectAllButton.disabled = !checks.length;
  }

