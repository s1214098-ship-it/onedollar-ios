        ? '印尼已收清｜超商證件代收 NT$100（還客戶）'
        : '印尼已收清：公司營收，從業務分紅扣';
      else if (values.mode === 'id_sales_partial' && values.idRemainderStage === 'tw_store_id_cod') badge.textContent = '印尼部分代收｜超商證件代收 NT$100（還客戶）';
      else if (values.mode === 'id_sales_partial' && values.idRemainderStage === 'tw_cod') badge.textContent = '印尼部分代收｜台灣貨到付款';
      else if (values.mode === 'id_sales_partial' && values.idRemainderStage === 'id_later') badge.textContent = '印尼部分代收｜台灣免代收';
      else if (values.mode === 'id_sales_partial') badge.textContent = '印尼部分代收：請選剩額去向';
      else if (values.mode === 'deposit_account') badge.textContent = '餘額記帳：包裹不代收';
      else badge.textContent = values.codAmount > 0
        ? '貨到付款：公司收款'
        : (party === 'company' ? '訂金：公司收' : (party === 'sales' ? '訂金：業務收' : '訂金收款人待確認'));
    }
    var proofTitle = box.querySelector('[data-freight-fifo-payment-proof] header b');
    if (proofTitle) proofTitle.textContent = isIndonesiaSalesCollectionMode(values.mode) ? '印尼單據／收款證明' : '訂金收款證明';
    if (!summary) return;
    if (depositBreakdown.amount > 0) {
      summary.setAttribute('data-deposit-region', depositBreakdown.region || '');
    }
    if (!values.mode) {
      summary.textContent = '請先選擇收款方式；尚未儲存任何付款變更。';
    } else if (values.mode === 'id_sales_full') {
      summary.textContent = (collectorName || '業務') + ' 代收 ANI NT$' + Math.round(values.paid).toLocaleString() + '（全部收／印尼）｜公司營收，非獎金｜台灣免代收'
        + (values.indonesiaSelfShip ? '｜印尼自出運費 0（業務跟客戶處理）' : '')
        + (values.storeIdCod ? '｜超商證件代收 NT$100（包裹放100還客戶，不算加價）' : '')
        + (values.indonesiaAmount > 0 ? '｜印尼盾 ' + values.indonesiaAmount + ' × ' + values.indonesiaRate + ' = NT$' + values.indonesiaTwd.toLocaleString() : '')
        + (values.indonesiaShortfall > 0 ? '｜少給 NT$' + values.indonesiaShortfall.toLocaleString() + ' 從毛利獎金扣' : (values.indonesiaCovered ? '｜本單已給足' : ''));
    } else if (values.mode === 'id_sales_partial' && values.idRemainderStage === 'tw_store_id_cod') {
      summary.textContent = '印尼已收 NT$' + Math.round(values.paid).toLocaleString() + '（' + (collectorName || '業務') + '）｜超商證件代收 NT$100（包裹放100還客戶，不算客戶加價）'
        + (values.balance > 0 ? '｜本單尚欠 NT$' + Math.round(values.balance).toLocaleString() + ' 不能用證件代充當尾款' : '');
    } else if (values.mode === 'id_sales_partial' && values.idRemainderStage === 'tw_cod') {
      summary.textContent = '印尼已收 NT$' + Math.round(values.paid).toLocaleString() + '（' + (collectorName || '業務') + '）｜台灣貨到付款 NT$' + Math.round(values.codAmount).toLocaleString();
    } else if (values.mode === 'id_sales_partial' && values.idRemainderStage === 'id_later') {
      summary.textContent = '印尼已收 NT$' + Math.round(values.paid).toLocaleString() + '（' + (collectorName || '業務') + '）｜尚欠印尼 NT$' + Math.round(values.balance).toLocaleString() + '｜台灣免代收';
    } else if (values.mode === 'id_sales_partial') {
      summary.textContent = '印尼部分代收 NT$' + Math.round(values.paid).toLocaleString() + '；請選擇剩額是台灣貨到付款，還是繼續等印尼業務收。';
    } else if (values.balance <= 0) {
      summary.textContent = '已收清 NT$' + Math.round(values.paid).toLocaleString() + '，本單沒有欠款。｜' + ownershipText;
    } else if (values.codAmount > 0) {
      summary.textContent = '已收訂金 NT$' + Math.round(values.paid).toLocaleString() + '；剩餘貨到付款 NT$' + Math.round(values.codAmount).toLocaleString() + '；貨到付款由公司收。' + (hasDepositCollection ? '｜' + ownershipText : '');
    } else if (values.beforeShipAmount > 0) {
      summary.textContent = '本次已收訂金 NT$' + Math.round(values.paid).toLocaleString() + '；出貨前尚需收 NT$' + Math.round(values.beforeShipAmount).toLocaleString() + '。｜' + ownershipText;
    } else {
      summary.textContent = '本次已收 NT$' + Math.round(values.paid).toLocaleString() + '；出貨後列應收欠款 NT$' + Math.round(values.afterShipAmount || values.balance).toLocaleString() + '。｜' + ownershipText;
    }
    if (values.taiwanCollectedIndonesiaGoods > 0) {
      summary.textContent += '｜印尼成交商品 NT$' + Math.round(values.taiwanCollectedIndonesiaGoods).toLocaleString()
        + ' 併入台灣包裹收款｜本張應收總額 NT$' + Math.round(values.total).toLocaleString()
        + '｜不列入印尼收款表';
    }
    if (depositBreakdown.amount > 0 && !isIndonesiaSalesCollectionMode(values.mode)) {
      summary.textContent += '｜' + '\u8a02\u91d1 ' + freightFifoMoney(depositBreakdown.amount) + (depositBreakdown.region ? '｜' + freightFifoCollectionRegionLabel(depositBreakdown.region) : '');
    }
    freightFifoSyncFirstParcelCodAmount(modal);
  }

  function hydrateFreightFifoPayment(modal, row) {
    var box = modal && modal.querySelector('[data-freight-fifo-payment]');
    if (!box) return;
    box._paymentLoaded = false;
    var depositPartyInput = box.querySelector('[data-freight-fifo-collection-party]');
    var depositRegionInput = box.querySelector('[data-freight-fifo-collection-region]');
    var depositCollectorInput = box.querySelector('[data-freight-fifo-collector-name]');
    if (depositPartyInput) {
      depositPartyInput.parentElement.firstChild.nodeValue = '本次訂金由誰收';
      if (depositPartyInput.options[0]) depositPartyInput.options[0].textContent = '尚未收訂金／請選擇';
      if (depositPartyInput.options[1]) depositPartyInput.options[1].textContent = '公司收訂金';
      if (depositPartyInput.options[2]) depositPartyInput.options[2].textContent = '業務收訂金';
    }
    if (depositRegionInput) {
      depositRegionInput.parentElement.firstChild.nodeValue = '訂金收款地區';
      if (depositRegionInput.options[0]) depositRegionInput.options[0].textContent = '台灣收訂金';
      if (depositRegionInput.options[1]) depositRegionInput.options[1].textContent = '印尼收訂金';
    }
    if (depositCollectorInput) {
      depositCollectorInput.parentElement.firstChild.nodeValue = '收訂金業務';
      depositCollectorInput.placeholder = '業務收訂金時必填';
    }
    [
      ['[data-freight-fifo-payment-previous]', '先前已收（系統累計，不在此修改）'],
      ['[data-freight-fifo-payment-current]', '本次實際收款（可分次填 50／100）'],
      ['[data-freight-fifo-payment-paid]', '已收款累計'],
      ['[data-freight-fifo-payment-balance]', '剩餘待收／貨到付款'],
      ['[data-freight-fifo-payment-date]', '收款日期（本次有收款必填）']
    ].forEach(function (entry) {
      var input = box.querySelector(entry[0]);
      if (input && input.parentElement && input.parentElement.firstChild) input.parentElement.firstChild.nodeValue = entry[1];
    });
    var currentPaymentInput = box.querySelector('[data-freight-fifo-payment-current]');
    var currentPaymentDate = box.querySelector('[data-freight-fifo-payment-date]');
    if (currentPaymentInput && currentPaymentDate) {
      currentPaymentInput.readOnly = false;
      currentPaymentInput.disabled = false;
      currentPaymentInput.setAttribute('aria-label', '本次實際收到的金額，可分次收款');
      currentPaymentInput.placeholder = '例如：50 或 100';
      currentPaymentInput.parentElement.insertAdjacentElement('afterend', currentPaymentDate.parentElement);
      currentPaymentDate.setAttribute('aria-label', '收款日期（本次有收款必填）');
      currentPaymentDate.readOnly = false;
      currentPaymentDate.disabled = false;
      if (!currentPaymentDate.value) currentPaymentDate.value = freightFifoLocalDateValue();
      currentPaymentDate.addEventListener('input', function () {
        currentPaymentDate.setAttribute('data-payment-user-edited', '1');
        currentPaymentDate.removeAttribute('aria-invalid');
        var dateHint = box.querySelector('[data-payment-date-error]');
        if (dateHint) dateHint.remove();
      });
    }
    ensureFreightFifoPaymentProofEditor(box);
    ensureFreightFifoAddPayment(modal, box);
    var orderId = modal.getAttribute('data-order-id') || '';
    var preorderId = modal.getAttribute('data-preorder-id') || '';
    fetch('./finance-api.php', { cache: 'no-store', credentials: 'same-origin' }).then(function (response) {
      return response.json().then(function (data) {
        if (!response.ok || !data.ok) throw new Error(data.error || '付款資料讀取失敗');
        var payments = data.payments || {};
        var payment = payments[orderId] || payments[preorderId] || {};
        box._paymentHistory = Array.isArray(payment.history) ? payment.history : [];
        if (!box._paymentProofImage) box._paymentProofImage = payment.proofImage || '';
        var feeModeInput = modal.querySelector('[data-freight-fifo-shipping-fee-mode]');
        var currentOrderTotal = feeModeInput && (feeModeInput.value === 'free' || feeModeInput.value === 'id_self')
          ? freightFifoSubtotal(row)
          : freightFifoPaymentTotal(row);
        // A payment record can still contain the total from an older delivery
        // method. The current order items and recognized address determine the
        // amount now; only fall back to finance when the order has no amount.
        var total = currentOrderTotal > 0
          ? currentOrderTotal
          : Math.max(0, Number(payment.orderTotal || 0));
        box.setAttribute('data-source-payment-id', payment.orderId || (payments[preorderId] ? preorderId : ''));
        box.setAttribute('data-original-settlement-mode', String(payment.settlementMode || ''));
        box.setAttribute('data-previous-paid', Math.max(0, Number(payment.paidAmount || 0)));
        box.setAttribute('data-original-previous-paid', Math.max(0, Number(payment.paidAmount || 0)));
        box.setAttribute('data-previous-deposit', Math.max(0, Number(payment.depositAmount || 0)));
        var totalInput = box.querySelector('[data-freight-fifo-payment-total]');
        var previousInput = box.querySelector('[data-freight-fifo-payment-previous]');
        var modeInput = box.querySelector('[data-freight-fifo-payment-mode]');
        var noteInput = box.querySelector('[data-freight-fifo-payment-note]');
        var dateInput = box.querySelector('[data-freight-fifo-payment-date]');
        var partyInput = box.querySelector('[data-freight-fifo-collection-party]');
        var regionInput = box.querySelector('[data-freight-fifo-collection-region]');
        var collectorInput = box.querySelector('[data-freight-fifo-collector-name]');
        var remainderInput = box.querySelector('[data-freight-fifo-id-remainder]');
        if (totalInput) totalInput.value = total;
        box.setAttribute('data-base-order-total', String(total));
        if (previousInput) previousInput.value = Math.max(0, Number(payment.paidAmount || 0));
        if (modeInput) modeInput.value = payment.settlementMode || (Number(payment.balance || 0) <= 0 && Number(payment.paidAmount || 0) > 0 ? 'paid_full' : '');
        if (remainderInput) remainderInput.value = payment.idRemainderStage === 'tw_cod' || payment.idRemainderStage === 'id_later' || payment.idRemainderStage === 'tw_store_id_cod' ? payment.idRemainderStage : '';
        if (noteInput) noteInput.value = payment.note || '';
        // 這裡是新增下一筆收款，不應把上一筆日期蓋回來。使用者若已開始
        // 輸入，更不能被稍後完成的 finance fetch 覆寫。
        if (dateInput && !dateInput.hasAttribute('data-payment-user-edited') && !dateInput.value) {
          dateInput.value = freightFifoLocalDateValue();
        }
        var idrAmountInput = box.querySelector('[data-freight-fifo-idr-amount]');
        var idrRateInput = box.querySelector('[data-freight-fifo-idr-rate]');
        var collectionCurrencyInput = box.querySelector('[data-freight-fifo-indonesia-collection-currency]');
        var collectionAmountInput = box.querySelector('[data-freight-fifo-indonesia-collection-amount]');
        var collectionRateInput = box.querySelector('[data-freight-fifo-indonesia-collection-rate]');
        var collectionModeInput = box.querySelector('[data-freight-fifo-indonesia-collection-mode]');
        var collectionStatusInput = box.querySelector('[data-freight-fifo-indonesia-collection-status]');
        var collectionReceiverInput = box.querySelector('[data-freight-fifo-indonesia-collection-receiver]');
        var storeIdCodInput = box.querySelector('[data-freight-fifo-store-id-cod]');
        if (idrAmountInput && payment.indonesiaAmount != null && payment.indonesiaAmount !== '') idrAmountInput.value = String(payment.indonesiaAmount);
        if (idrRateInput) idrRateInput.value = String(payment.indonesiaRate || freightFifoDefaultIdrRate());
        if (collectionModeInput) collectionModeInput.value = payment.indonesiaCollectionMode || '';
        if (collectionCurrencyInput) collectionCurrencyInput.value = String(payment.indonesiaCollectionCurrency || 'TWD').toUpperCase() === 'IDR' ? 'IDR' : 'TWD';
        if (collectionAmountInput) collectionAmountInput.value = String(payment.indonesiaCollectionOriginalAmount != null ? payment.indonesiaCollectionOriginalAmount : (payment.indonesiaCollectionAmount || 0));
        if (collectionRateInput) collectionRateInput.value = String(payment.indonesiaCollectionRate || 500);
        if (collectionStatusInput) collectionStatusInput.value = payment.indonesiaCollectionStatus === 'received' ? 'received' : 'pending';
        if (collectionReceiverInput) collectionReceiverInput.value = payment.indonesiaCollectionReceiver === 'taiwan_company' ? 'taiwan_company' : 'indonesia_sales';
        if (collectionModeInput && collectionModeInput.value) collectionModeInput.dispatchEvent(new Event('change', { bubbles: true }));
        if (storeIdCodInput) storeIdCodInput.checked = payment.storeIdCodDummy === true || payment.idRemainderStage === 'tw_store_id_cod';
        var hasRecordedDeposit = Math.max(0, Number(payment.depositAmount || 0)) > 0 || box._paymentHistory.some(function (entry) {
          return String(entry && entry.paymentStage || '') === 'deposit' && Number(entry && entry.amount || 0) > 0;
        });
        if (partyInput) partyInput.value = hasRecordedDeposit ? (payment.depositCollectionParty || payment.collectionParty || 'unknown') : 'unknown';
        if (regionInput) regionInput.value = payment.depositCollectionRegion || payment.collectionRegion || (box._paymentHistory.length ? String(box._paymentHistory[box._paymentHistory.length - 1].collectionRegion || 'TW') : 'TW');
        if (collectorInput) {
          var savedDepositSales = String(payment.depositCollectorName || '').toUpperCase();
          if (savedDepositSales !== 'LINGZANZAN' && savedDepositSales !== 'ANY') savedDepositSales = String(payment.salesName || '').toUpperCase();
          if (savedDepositSales === 'LINGZANZAN' || savedDepositSales === 'ANY') collectorInput.value = savedDepositSales;
        }
        box._paymentLoaded = true;
        renderFreightFifoPaymentProof(box);
        renderFreightFifoPayment(modal);
      });
    }).catch(function (error) {
      var summary = box.querySelector('[data-freight-fifo-payment-summary]');
      if (summary) summary.textContent = '付款資料暫時讀不到：' + (error.message || error) + '。可稍後重開，不會改動舊帳。';
    });
  }

  function ensureFreightFifoAddPayment(modal, box) {
    if (box.querySelector('[data-freight-save-next-payment]')) return;
    var actions = document.createElement('div');
    actions.className = 'freight-fifo-payment-proof-actions';
    actions.style.gridTemplateColumns = 'minmax(0, 1fr)';
    actions.innerHTML = '<button type="button" class="primary-button" data-freight-save-next-payment>儲存本次收款／再新增下一筆</button><p role="status" data-freight-next-payment-status>可分多次收款，每次分別填金額與實際日期再儲存；歷次紀錄保留，不會完成配送。</p>';
    actions.querySelector('button').style.whiteSpace = 'normal';
    var currentInput = box.querySelector('[data-freight-fifo-payment-current]');
    var grid = currentInput && currentInput.closest('.freight-fifo-payment-grid');
    if (grid) grid.insertAdjacentElement('afterend', actions);
    else box.appendChild(actions);
    actions.querySelector('button').addEventListener('click', function () {
      saveFreightFifoNextPayment(modal, box, actions.querySelector('button'), actions.querySelector('[role="status"]'));
    });
  }

  function saveFreightFifoNextPayment(modal, box, button, status) {
    if (box._savingNextPayment) return Promise.resolve();
    if (!box._paymentLoaded) { status.textContent = '原收款資料尚未讀取完成，請稍候；讀取失敗時請重新開啟訂單，不會覆蓋舊帳。'; return Promise.resolve(); }
    var values = freightFifoPaymentValues(modal);
    var orderId = String(modal.getAttribute('data-order-id') || '');
    var preorderId = String(modal.getAttribute('data-preorder-id') || '');
    if (!orderId && !preorderId) { status.textContent = '請先建立訂單，再登記分次收款。'; return Promise.resolve(); }
    if (!values || values.current <= 0) { status.textContent = '請填本次實際收到的金額；沒有收款不新增紀錄。'; return Promise.resolve(); }
    box._savingNextPayment = true;
    button.disabled = true;
    status.textContent = '正在儲存本次收款，請勿重複點擊…';
    return saveFreightFifoPayment(modal, orderId || preorderId, orderId ? 'order' : 'preorder').then(function (data) {
      var payment = data && data.payment;
      if (!payment) throw new Error('未取得收款結果，請重新查核歷史紀錄，勿重複登記');
      box.setAttribute('data-source-payment-id', orderId || preorderId);
      box.setAttribute('data-previous-paid', String(payment.paidAmount || 0));
      box.setAttribute('data-original-previous-paid', String(payment.paidAmount || 0));
      box.setAttribute('data-previous-deposit', String(payment.depositAmount || 0));
      box.querySelector('[data-freight-fifo-payment-previous]').value = String(payment.paidAmount || 0);
      var nextCurrentInput = box.querySelector('[data-freight-fifo-payment-current]');
      var nextDateInput = box.querySelector('[data-freight-fifo-payment-date]');
      nextCurrentInput.value = '0';
      nextCurrentInput.removeAttribute('data-payment-user-edited');
      nextDateInput.value = freightFifoLocalDateValue();
      nextDateInput.removeAttribute('data-payment-user-edited');
      box.querySelector('[data-freight-fifo-payment-note]').value = '';
      box._paymentProofImage = '';
      box._paymentHistory = Array.isArray(payment.history) ? payment.history : [];
      renderFreightFifoPaymentProof(box);
      renderFreightFifoPayment(modal);
      status.textContent = '本次收款已保存，歷次日期與金額如下；可再填下一筆收款。未變更配送狀態。';
    }).catch(function (error) {
      status.textContent = '尚未完成：' + (error.message || error);
    }).finally(function () {
      box._savingNextPayment = false;
      button.disabled = false;
    });
  }

  function setFreightFifoPaymentProofImage(box, dataUrl, sourceLabel) {
    dataUrl = String(dataUrl || '').trim();
    if (!box || !dataUrl) return false;
    box._paymentProofImage = dataUrl;
    var dateInput = box.querySelector('[data-freight-fifo-payment-date]');
    if (dateInput && !dateInput.value) dateInput.value = new Date().toISOString().slice(0, 10);
    renderFreightFifoPaymentProof(box);
    toast((sourceLabel || '收款證明') + '已預覽；儲存訂單時會一起寫入');
    return true;
  }

  function clearFreightFifoPaymentProofImage(box) {
    if (!box) return;
    box._paymentProofImage = '';
    var input = box.querySelector('[data-freight-fifo-payment-proof-input]');
    if (input) input.value = '';
    renderFreightFifoPaymentProof(box);
    toast('已移除尚未儲存的收款證明預覽');
  }

  function applyFreightFifoPaymentProofFiles(box, files, sourceLabel) {
    var imageFiles = Array.from(files || []).filter(function (file) {
      return String(file && file.type || '').indexOf('image/') === 0;
    });
    if (!imageFiles.length) {
      toast('這次沒有圖片，請選 JPG／PNG 或先複製截圖再貼上');
      return Promise.resolve(false);
    }
    return fileToDataUrl(imageFiles[0]).then(function (dataUrl) {
      return setFreightFifoPaymentProofImage(box, dataUrl, sourceLabel);
    }).catch(function (error) {
      toast(error.message || '收款證明讀取失敗');
      return false;
    });
  }

  function ensureFreightFifoPaymentProofEditor(box) {
    if (!box) return;
    var section = box.querySelector('[data-freight-fifo-payment-proof]') || box.querySelector('section.freight-fifo-payment-proof');
    if (section && !section.querySelector('[data-freight-fifo-payment-proof-paste]')) {
      section.remove();
      section = null;
    }
    if (!section) {
      box.insertAdjacentHTML('beforeend', '<section class="freight-fifo-payment-proof" tabindex="0" data-freight-fifo-payment-proof data-freight-fifo-payment-proof-paste-zone aria-label="訂金收款證明，可選檔、貼上或拖入圖片"><header><div><b>訂金收款證明</b><small>可按「貼上圖片」、在此區按 Ctrl/⌘+V，或選擇檔案；先預覽，儲存訂單才正式寫入。</small></div></header><div class="freight-fifo-payment-proof-actions"><button type="button" class="primary-button" data-freight-fifo-payment-proof-paste>貼上圖片</button><label class="ghost-button">＋ 選擇檔案<input type="file" accept="image/*" data-freight-fifo-payment-proof-input></label><button type="button" class="ghost-button" data-freight-fifo-payment-proof-remove hidden>移除證明</button></div><div data-freight-fifo-payment-proof-preview>尚未上傳證明</div><div data-freight-fifo-payment-history></div></section>');
      section = box.querySelector('[data-freight-fifo-payment-proof]');
    }
    if (!section || section.getAttribute('data-freight-fifo-payment-proof-bound') === '1') return;
    section.setAttribute('data-freight-fifo-payment-proof-bound', '1');
    var input = section.querySelector('[data-freight-fifo-payment-proof-input]');
    if (input) input.addEventListener('change', function () {
      applyFreightFifoPaymentProofFiles(box, input.files, '選擇的圖片').then(function () {
        input.value = '';
      });
    });
    var pasteButton = section.querySelector('[data-freight-fifo-payment-proof-paste]');
    if (pasteButton) pasteButton.addEventListener('click', function () {
      pasteButton.disabled = true;
      pasteButton.textContent = '等待貼上圖片…';
      requestClipboardImages(function (images) {
        setFreightFifoPaymentProofImage(box, images[0], '剪貼簿圖片');
        pasteButton.disabled = false;
