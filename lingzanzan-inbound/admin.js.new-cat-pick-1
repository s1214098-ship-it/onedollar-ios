  // A returned formal shipment is a closed transaction. Older records did not
  // always mark their source preorder as converted, which made the same goods
  // appear again in the Taiwan-arrival/inbound queue after inventory restock.
  // Only an explicit "reverted to waiting" operation may reopen that preorder.
  function freightFifoInquiryWasReturned(inquiry) {
    var formalOrder = freightFifoFormalOrderForInquiry(inquiry && inquiry.id);
    if (!formalOrder || formalOrder.revertedToWaitingAt) return false;
    return String(formalOrder.status || '').toLowerCase() === 'returned';
  }

  function freightFifoLinkedFormalOrderIds(preorder) {
    preorder = preorder || {};
    return [preorder.orderId, preorder.convertedOrderId, preorder.convertedToOrderId, preorder.formalOrderId]
      .map(function (value) { return String(value || '').trim(); })
      .filter(Boolean)
      .filter(function (id, index, list) { return list.indexOf(id) === index; });
  }

  function freightFifoLooksLikeInquiry(row) {
    if (!row) return false;
    if (row.convertOperation) return true;
    var status = String(row.status || '').toLowerCase();
    return status === 'converted' || status === 'preorder_pending' || status === 'preorder_draft';
  }

  function resolveFreightFifoFormalOrder(preorder, order) {
    if (preorder && String(preorder.status || '').toLowerCase() === 'preorder_pending') {
      return null;
    }
    var ids = [];
    if (order && order.id && !freightFifoLooksLikeInquiry(order)) ids.push(String(order.id || '').trim());
    freightFifoLinkedFormalOrderIds(preorder).forEach(function (id) { ids.push(id); });
    if (preorder && preorder.id) ids.push(String(preorder.id || '').trim());
    ids = ids.filter(Boolean).filter(function (id, index, list) { return list.indexOf(id) === index; });
    var idx = freightFifoIndexes();
    var found = null;
    ids.some(function (id) {
      found = idx.orderById.get(id) || idx.orderByInquiryId.get(id) || null;
      return !!found;
    });
    return found || freightFifoFormalOrderForInquiry(preorder && preorder.id) || null;
  }

  function freightFifoFormalOrderId(preorder, order) {
    var resolved = resolveFreightFifoFormalOrder(preorder, order);
    if (resolved && resolved.id) return String(resolved.id || '').trim();
    var linked = freightFifoLinkedFormalOrderIds(preorder);
    if (linked[0]) return linked[0];
    if (order && order.id && !freightFifoLooksLikeInquiry(order)) return String(order.id || '').trim();
    return '';
  }

  function freightFifoNormTrackingNo(value) {
    return String(value || '').replace(/\s+/g, '').toUpperCase();
  }

  function freightFifoLooksLikeOutboundTracking(value) {
    var trackingNo = freightFifoNormTrackingNo(value);
