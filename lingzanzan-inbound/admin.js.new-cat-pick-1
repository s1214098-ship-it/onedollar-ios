  var preorderWarehouseReconcilePromise = null;
  function reconcilePreorderWarehouseAllocations() {
    if (preorderWarehouseReconcilePromise) return preorderWarehouseReconcilePromise;
    var rows = (state.inquiries || []).filter(function (row) {
      if (!row || String(row.orderType || '').toLowerCase() !== 'preorder') return false;
      return !/cancel|return|converted|closed|取消|退回|已轉/.test([row.status, row.statusLabel].join(' ').toLowerCase());
    }).sort(freightFifoQueueCompare);
    var summary = { allocated: 0, orders: 0, statusUpdated: 0, customers: [], failed: 0, failures: [] };
    preorderWarehouseReconcilePromise = rows.reduce(function (chain, row) {
      return chain.then(function () {
        return autoAllocatePreorderWarehouse(row).then(function (result) {
          if (result.allocated > 0) {
            summary.allocated += result.allocated;
            summary.orders += 1;
            summary.customers.push({
              name: String(row.customer && row.customer.name || '未填客戶'),
              orderId: String(row.id || '-'),
              quantity: result.allocated
            });
          }
          if (result.statusUpdated) summary.statusUpdated += 1;
        }).catch(function (error) {
          summary.failed += 1;
          summary.failures.push({ orderId: String(row.id || ''), error: String(error && error.message || error || '自動提撥失敗') });
          console.warn('preorder warehouse allocation skipped one order', row.id, error);
        });
      });
    }, Promise.resolve()).then(function () { return summary; }).finally(function () { preorderWarehouseReconcilePromise = null; });
    return preorderWarehouseReconcilePromise;
  }

  function reconcilePreorderWarehouseAllocationsUntilStable(maxPasses) {
    var remainingPasses = Math.max(1, Number(maxPasses || 1));
    var total = { allocated: 0, orders: 0, statusUpdated: 0, customers: [], failed: 0, failures: [] };
    function nextPass() {
      return reconcilePreorderWarehouseAllocations().then(function (summary) {
        total.allocated += Number(summary.allocated || 0);
        total.orders += Number(summary.orders || 0);
        total.statusUpdated += Number(summary.statusUpdated || 0);
        total.customers = total.customers.concat(summary.customers || []);
        total.failed += Number(summary.failed || 0);
        total.failures = total.failures.concat(summary.failures || []);
        remainingPasses -= 1;
        if (summary.allocated > 0 && remainingPasses > 0) return nextPass();
        return total;
      });
    }
    return nextPass();
  }

  function reconcilePreordersAfterRealtimeSync() {
    // 預購需求頁是只讀統計工作列；即時同步不得在這裡觸發四輪全量提撥，
    // 否則使用者只是查看報表也會再次鎖住主執行緒。
    if (['admin-preorder-demand.html', 'admin-orders.html', 'admin-preorders.html', 'admin-live.html'].indexOf(adminCurrentFileName()) !== -1) return Promise.resolve({ allocated: 0, orders: 0, statusUpdated: 0, customers: [] });
