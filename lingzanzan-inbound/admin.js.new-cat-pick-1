    return text;
  }

  function freightFifoCompactPaymentText(payment) {
    payment = payment || {};
    var total = Math.max(0, Number(payment.total || 0));
    var paid = Math.max(0, Number(payment.paid || payment.paidAmount || 0));
    var balance = Math.max(0, Number(payment.balance != null ? payment.balance : (total - paid)));
    var regions = payment.regionTotals || {};
    var twPaid = Math.max(0, Number(regions.TW || 0));
    var idPaid = Math.max(0, Number(regions.ID || 0));
    var classified = twPaid + idPaid;
    var unknownPaid = Math.max(0, Number(regions.unknown || 0), paid - classified);
    var parts = [];
    if (twPaid > 0) parts.push('台灣收款' + freightFifoMoney(twPaid));
    if (idPaid > 0) parts.push('印尼收款' + freightFifoMoney(idPaid));
    if (unknownPaid > 0) parts.push('已收' + freightFifoMoney(unknownPaid));
    if (balance > 0) {
      if (payment.storeIdCod || payment.idRemainderStage === 'tw_store_id_cod') parts.push('超商證件代收NT$100（還客戶）');
      else if (payment.mode === 'id_sales_full' || payment.idRemainderStage === 'id_later') parts.push('台灣免代收');
      else if (payment.idRemainderStage === 'tw_cod') parts.push('台灣貨到付款' + freightFifoMoney(payment.codAmount || balance));
      else if (payment.mode === 'deposit_account') parts.push('記帳欠款' + freightFifoMoney(balance) + '（包裹不代收）');
      else if (payment.mode === 'deposit_before_ship') parts.push('出貨前待收' + freightFifoMoney(balance));
      else if (payment.mode === 'ship_then_collect') parts.push('出貨後待收' + freightFifoMoney(balance) + '（包裹不代收）');
      else if (payment.mode === 'deposit_cod' || payment.mode === 'cod_full') parts.push('貨到付款' + freightFifoMoney(payment.codAmount || balance));
      else parts.push('尚待確認收款方式' + freightFifoMoney(balance));
    }
    else if (payment.storeIdCod || payment.idRemainderStage === 'tw_store_id_cod') parts.push('超商證件代收NT$100（還客戶）');
    else if (paid > 0) parts.push('已收清');
    return parts.length ? '  ' + parts.join('  ') : '';
  }

