  function combinedShipmentCustomerRow(reference) {
    reference = String(reference || '').trim();
    var seed = (state.orders || []).find(function (order) {
      return order && (
        String(order.id || '') === reference
        || String(order.shipmentMergeGroupId || '') === reference
        || String(order.shipmentMasterOrderId || '') === reference
      );
    });
    if (!seed || !seed.shipmentMergeGroupId) return null;
    var groupId = String(seed.shipmentMergeGroupId);
    var orders = (state.orders || []).filter(function (order) {
      var status = String(order && order.status || '').toLowerCase();
      return order && String(order.shipmentMergeGroupId || '') === groupId
        && ['cancelled', 'returned'].indexOf(status) === -1;
    }).sort(function (a, b) {
      return String(a.createdAt || '').localeCompare(String(b.createdAt || '')) || String(a.id || '').localeCompare(String(b.id || ''));
    });
    if (!orders.length) return null;
    var masterId = String(seed.shipmentMasterOrderId || orders[0].shipmentMasterOrderId || '');
    var master = orders.find(function (order) { return String(order.id || '') === masterId; }) || orders[0];
    var itemMap = {};
    orders.forEach(function (order) {
      (order.items || []).forEach(function (sourceItem, sourceItemIndex) {
        var item = Object.assign({}, sourceItem || {});
        item.mergedOrderId = String(order.id || '');
        item.mergedItemIndex = sourceItemIndex;
        item.mergedOrderDate = String(order.orderDate || order.purchaseDate || order.createdAt || order.date || '').slice(0, 10);
        var price = freightFifoItemUnitPrice(item);
        var key = [
          order.id || '',
          item.productId || item.code || item.productCode || '',
          item.skuId || item.sku || item.barcode || '',
          item.color || item.colorName || '',
          canonicalNoSize(item.size || item.sizeName || 'NO SIZE'),
          price
        ].map(function (value) { return normalizeLiveCode(value); }).join('|');
        var qty = Math.max(1, Number(item.qty || item.quantity || 1));
        if (!itemMap[key]) {
          itemMap[key] = item;
          itemMap[key].qty = 0;
          itemMap[key].quantity = 0;
          itemMap[key].requestedQty = 0;
          itemMap[key].freightReceivedQty = 0;
        }
        itemMap[key].qty += qty;
        itemMap[key].quantity += qty;
        itemMap[key].requestedQty += qty;
        itemMap[key].freightReceivedQty += qty;
      });
    });
    var items = Object.keys(itemMap).map(function (key) { return itemMap[key]; });
    var calculatedSubtotal = items.reduce(function (sum, item) {
      return sum + freightFifoItemUnitPrice(item) * Math.max(1, Number(item.qty || 1));
    }, 0);
    var shippingFee = Math.max(0, Number(master.shipmentGroupShippingFee || master.shippingFee || 0));
    var subtotal = calculatedSubtotal;
    var total = Math.max(0, subtotal + shippingFee);
    var paidAmount = orders.reduce(function (sum, order) {
      return sum + Math.max(0, Number(order.paidAmount || order.amountPaid || 0));
    }, 0);
    var mergedOrders = orders.map(function (order) {
      var sourceItems = (order.items || []).map(function (sourceItem, sourceItemIndex) {
        var item = Object.assign({}, sourceItem || {});
        item.mergedOrderId = String(order.id || '');
        item.mergedItemIndex = sourceItemIndex;
        item.mergedOrderDate = String(order.orderDate || order.purchaseDate || order.createdAt || order.date || '').slice(0, 10);
        return item;
      });
      return {
        id: String(order.id || ''),
        date: String(order.orderDate || order.purchaseDate || order.createdAt || order.date || '').slice(0, 10),
        items: sourceItems,
        subtotal: sourceItems.reduce(function (sum, item) {
          return sum + freightFifoItemUnitPrice(item) * Math.max(1, Number(item.qty || item.quantity || 1));
        }, 0)
      };
    });
    var customer = Object.assign({}, master.customer || {});
    return Object.assign({}, master, {
      id: groupId,
      isCombinedShipmentCard: true,
      shipmentMergeGroupId: groupId,
      shipmentMasterOrderId: master.id || masterId,
      shipmentMergedOrderIds: orders.map(function (order) { return String(order.id || ''); }),
      shipmentMergedOrders: mergedOrders,
      customer: customer,
      customerName: customer.name || master.customerName || '',
      customerPhone: customer.phone || master.customerPhone || '',
      items: items,
      subtotal: subtotal,
      shippingFee: shippingFee,
      total: total,
      grandTotal: total,
      paidAmount: Math.min(total, paidAmount)
    });
  }

