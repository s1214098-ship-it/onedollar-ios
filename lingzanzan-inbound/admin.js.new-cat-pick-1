  function orderTrackingSectionDataReady(category) {
    if (category === 'ready' || category === 'live') return !orderTrackingAwaitingOrders;
    return !orderTrackingAwaitingInquiries;
  }

  function orderTrackingQueryReadyForHeavyLoad(query) {
    query = String(query || '').trim();
    if (!query) return false;
    if (/^\d+$/.test(query)) return !adminOrderSearchIsTooShort(query);
    return query.length >= 2;
  }

  function loadOrderTrackingInquiriesOnDemand(forceReload) {
    if (adminCurrentFileName() !== 'admin-order-tracking.html') return Promise.resolve(false);
    if (!orderTrackingAwaitingInquiries && !forceReload) return Promise.resolve(true);
    if (orderTrackingInquiryDataRequest) {
      if (!forceReload) return orderTrackingInquiryDataRequest;
      return orderTrackingInquiryDataRequest.catch(function () {}).then(function () {
        orderTrackingInquiryDataRequest = null;
        return loadOrderTrackingInquiriesOnDemand(true);
      });
    }
    document.body.setAttribute('data-order-tracking-inquiries-loading', 'true');
    orderTrackingInquiryDataRequest = (forceReload
      ? loadStockInquiries({ strict: true, force: true }).then(function (rows) { return [null, null, null, null, null, rows]; })
      : loadAdminDataFiles({}, { inquiriesOnly: true })
    ).then(function (items) {
      if (Array.isArray(items && items[5])) state.inquiries = items[5];
      else if (!Array.isArray(state.inquiries)) state.inquiries = [];
      orderTrackingAwaitingInquiries = false;
      renderOrderTrackingDashboard();
      return true;
    }).catch(function (error) {
      if (!Array.isArray(state.inquiries)) state.inquiries = [];
      orderTrackingAwaitingInquiries = false;
      renderOrderTrackingDashboard();
