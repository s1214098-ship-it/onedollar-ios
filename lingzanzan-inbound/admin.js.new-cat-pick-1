  function buildOrderTrackingCoverage() {
    var supplyByVariant = {};
    var allocatedByVariant = {};
    var allocatedByOrderLine = {};
    var catalogProductsById = new Map((state.products || []).filter(Boolean).map(function (product) {
      return [String(product.id || ''), product];
    }));
    function addValue(target, key, qty) {
      if (!key || !qty) return;
      target[key] = Math.max(0, Number(target[key] || 0)) + Math.max(0, Number(qty || 0));
    }
    normalizeFreightTracking(state.freightTracking).items.forEach(function (item) {
      if (!freightItemClosesBatchQueueWithoutSelectionCheck(item)) {
        freightVariantLines(item).forEach(function (line) {
          var supplyItem = {
            code: line.productCode || item.productCode,
            sku: line.sampleBarcode || line.taiwanBarcode || item.sampleBarcode || item.taiwanBarcode,
            color: line.color,
            size: line.size
          };
          addValue(supplyByVariant, orderTrackingCoverageKey(supplyItem), Math.max(1, Number(line.quantity || 1)));
        });
      }
      (Array.isArray(item.customerLinks) ? item.customerLinks : []).forEach(function (link) {
        if (/cancel|release|取消|解除/.test(String(link && link.status || '').toLowerCase())) return;
        var qty = Math.max(0, Number(link && link.qty || 0));
        if (!qty) return;
        var orderId = String(link.inquiryId || link.customerOrderNo || '');
        var itemIndex = Number(link.itemIndex || 0);
        var row = (state.inquiries || []).find(function (inquiry) { return String(inquiry && inquiry.id || '') === orderId; });
        var orderItem = row && Array.isArray(row.items) ? row.items[itemIndex] : null;
        if (!orderItem) return;
        var variantKey = orderTrackingCoverageKey(orderItem);
        addValue(allocatedByVariant, variantKey, qty);
        addValue(allocatedByOrderLine, orderId + '|' + itemIndex, qty);
      });
    });
    (state.skus || []).forEach(function (sku) {
      if (!sku || /inactive|deleted|archived|下架|刪除/.test(String(sku.status || '').toLowerCase())) return;
      var stock = Math.max(0, Number(sku.stock || 0));
      if (!stock) return;
      var product = catalogProductsById.get(String(sku.productId || '')) || null;
      var warehouse = normalizeWarehouseCode(sku.warehouseCode || sku.warehouseName || sku.warehouse || sku.locationWarehouse || sku.stockWarehouse
        || product && (product.warehouseCode || product.warehouseName || product.warehouse)
        || 'TW');
      if (warehouse !== 'TW' && !(warehouse === 'CN' && orderDemandWarehouseOptions.includeCN) && !(warehouse === 'ID' && orderDemandWarehouseOptions.includeID)) return;
      addValue(supplyByVariant, orderTrackingCoverageKey({
        code: freightBalanceKey(product || sku),
        color: sku.colorName || sku.color || sku.colorLabel || sku.colorCode,
        size: sku.sizeName || sku.size || sku.sizeLabel || sku.sizeCode || 'NO SIZE'
      }), stock);
    });
    var result = {};
    var demandLinesByVariant = {};
    (state.inquiries || []).filter(function (order) {
      var isPreorder = order && (order.orderType === 'preorder' || order.status === 'preorder_pending' || String(order.id || '').indexOf('BYORDER-') === 0);
      var closed = ['cancelled', 'deleted', 'converted', 'shipped', 'completed'].indexOf(String(order && order.status || '').toLowerCase()) !== -1 || !!(order && order.convertedToOrderId);
      return isPreorder && !closed;
    }).sort(function (a, b) {
      return preorderInquiryTime(a) - preorderInquiryTime(b) || String(a.id || '').localeCompare(String(b.id || ''));
    }).forEach(function (order) {
      var summary = { requested: 0, reserved: 0, covered: 0, pending: 0, lines: [] };
      (Array.isArray(order.items) ? order.items : []).forEach(function (item, itemIndex) {
        var requested = Math.max(1, Number(item.qty || item.quantity || 1));
        var reserved = Math.min(requested, Math.max(0, Number(allocatedByOrderLine[String(order.id || '') + '|' + itemIndex] || 0)));
        var variantKey = orderTrackingCoverageKey(item);
        summary.requested += requested;
        var coverageLine = {
          variantKey: variantKey,
          code: freightBalanceKey(item) || item.code || item.sku || item.skuId || '產品',
          color: canonicalProductSpecificVariantColor(freightBalanceKey(item), preorderItemColor(item) || '未填顏色'),
          size: canonicalProductVariantSize(preorderItemSize(item) || 'NO SIZE'),
          requested: requested,
          reserved: reserved,
          covered: 0,
          pending: requested - reserved,
          summary: summary
        };
        summary.lines.push(coverageLine);
        if (!demandLinesByVariant[variantKey]) demandLinesByVariant[variantKey] = [];
        demandLinesByVariant[variantKey].push(coverageLine);
      });
      result[String(order.id || '')] = summary;
    });
    Object.keys(demandLinesByVariant).forEach(function (variantKey) {
      var lines = demandLinesByVariant[variantKey];
      var explicitReserved = lines.reduce(function (sum, line) { return sum + line.reserved; }, 0);
      var unmatchedReserved = Math.max(0, Number(allocatedByVariant[variantKey] || 0) - explicitReserved);
      lines.forEach(function (line) {
