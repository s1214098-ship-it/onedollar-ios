      codAmount: taiwanCod ? balance : 0,
      beforeShipAmount: mode === 'deposit_before_ship' ? balance : 0,
      afterShipAmount: (mode === 'ship_then_collect' || mode === 'deposit_account' || (mode === 'id_sales_partial' && remainder === 'id_later')) ? balance : 0
    };
  }

