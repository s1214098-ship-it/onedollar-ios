    var claimIds = [claim.freightItemId, claim.costFreightItemId, claim.sourceItemId].map(function (value) { return String(value || '').trim(); });
    if (['received', 'posted', 'applied', 'completed'].indexOf(claimStatus) >= 0 && claimIds.indexOf(itemId) >= 0) return true;
    var markers = product.inventoryTransactionMarkers && typeof product.inventoryTransactionMarkers === 'object' ? product.inventoryTransactionMarkers : {};
    return Object.keys(markers).some(function (key) {
      var marker = markers[key] || {};
      var markerIds = [marker.freightItemId, marker.costFreightItemId, marker.sourceItemId].map(function (value) { return String(value || '').trim(); });
      if (markerIds.indexOf(itemId) >= 0) return true;
      return (Array.isArray(marker.lines) ? marker.lines : []).some(function (line) {
        line = line || {};
        var snapshot = line.freightCostSnapshot || {};
        return [line.freightItemId, line.costFreightItemId, line.sourceItemId, snapshot.itemId, snapshot.freightItemId]
          .some(function (value) { return String(value || '').trim() === itemId; });
      });
    });
  }

  function freightProductLinkCatalogIndex() {
