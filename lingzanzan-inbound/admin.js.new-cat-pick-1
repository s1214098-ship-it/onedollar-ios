  function canonicalPurchasePlatformName(value) {
    var name = String(value || '').trim();
    try { name = name.normalize('NFKC'); } catch (error) {}
    return name.replace(/拚/g, '拼');
  }

  function normalizePurchasePlatforms(items) {
    var merged = [];
    var seen = {};
    (Array.isArray(items) ? items : []).concat(defaultPurchasePlatforms()).forEach(function (item) {
      var name = canonicalPurchasePlatformName(item && item.name || item && item.platform || '');
      var masterKind = String(item && (item.masterKind || item.kind) || 'platform').trim().toLowerCase();
      if (['platform', 'supplier', 'brand', 'spec'].indexOf(masterKind) === -1) masterKind = 'platform';
      var identity = masterKind + '|' + name.toLocaleLowerCase();
      if (!name || seen[identity]) return;
      seen[identity] = true;
      merged.push({
        id: item.id || ('platform-' + name.replace(/\s+/g, '-').toLowerCase()),
        name: name,
        masterKind: masterKind,
        type: String(item.type || item.sourceType || '').trim() || '其他',
        contact: String(item.contact || item.account || '').trim(),
        defaultProgress: String(item.defaultProgress || item.progress || '待下單').trim(),
        returnRule: String(item.returnRule || item.afterSaleRule || '').trim(),
        note: String(item.note || item.remark || '').trim(),
        updatedAt: item.updatedAt || ''
      });
    });
    return merged;
  }

  function purchasePlatformNames() {
