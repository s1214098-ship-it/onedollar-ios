    var values = [item.productCode, item.catalogProductCode, item.productId, item.sampleBarcode, item.taiwanBarcode];
    variants.forEach(function (line) {
      values.push(line.productCode, line.catalogProductCode, line.productId, line.sampleBarcode, line.taiwanBarcode);
    });
