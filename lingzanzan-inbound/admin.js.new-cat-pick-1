  function renderFreightReceivingLookupReady(value) {
    var host = document.querySelector('[data-freight-receiving-lookup-result]');
    if (!host) return;
    var wanted = normalizeScanCode(value);
    if (!wanted) { host.className = 'freight-receiving-lookup-result is-error'; host.textContent = '請輸入完整物流單號。'; return; }
    if (freightArrivalReceivingSession.customsLookupValue !== wanted) {
      freightArrivalReceivingSession.customsLookupAttempted = false;
      freightArrivalReceivingSession.customsLookupValue = wanted;
    }
    var freightData = normalizeFreightTracking(state.freightTracking);
    var matches = freightData.items.filter(function (item) {
      return freightReceivingTrackingAliases(item).some(function (tracking) { return normalizeScanCode(tracking) === wanted; });
    });
    var matchedByExactTracking = matches.length > 0;
    if (matchedByExactTracking) setFreightFifoProductScope(matches, value);
    var matchedBatch = null;
    if (!matches.length) {
      matchedBatch = freightData.batches.find(function (batch) {
        return [batch.id, batch.batchNo, batch.batchName, batch.logisticsTrackingNo, batch.customsNo, batch.consolidationNo].some(function (number) { return normalizeScanCode(number) === wanted; });
      }) || null;
      if (matchedBatch) matches = freightData.items.filter(function (item) { return String(item.batchId || '') === String(matchedBatch.id || ''); });
    }
    if (matchedBatch && !matchedByExactTracking) setFreightFifoProductScope([], '');
    if (!matches.length && !matchedBatch) {
      host.className = 'freight-receiving-lookup-result is-error';
      host.innerHTML = '<b>找不到物流單號／批次 ' + escapeHtml(value) + '</b><span>請先確認是否已在物流集運建檔，或檢查完整號碼。</span>';
      return;
    }
    if (matchedByExactTracking) {
      var pendingSupplemental = matches.find(function (item) {
        return item && item.isSupplementalSplitReceipt === true && !freightItemClosesBatchQueueWithoutSelectionCheck(item);
      });
      if (pendingSupplemental) {
        host.className = 'freight-receiving-lookup-result is-found freight-supplemental-found';
        host.innerHTML = '<header><div><small>SPLIT PARCEL PENDING／追加拆包待驗收</small><b>' + escapeHtml(value) + '</b></div><strong>尚未增加庫存</strong></header><p class="freight-arrival-message">這個同單號追加拆包已建立，但還沒有正式入庫。請繼續本次驗收，不會重跑原始批次。</p><article><div><b>' + escapeHtml(pendingSupplemental.productCode || pendingSupplemental.productName || '未命名產品') + '</b><span>本次追加 ' + Math.max(0, Number(pendingSupplemental.quantity || pendingSupplemental.qty || 0)) + ' 件</span></div><small>' + escapeHtml(pendingSupplemental.note || '同單號拆包後續到貨') + '</small><button type="button" class="primary-button" data-freight-receiving-open="' + escapeHtml(pendingSupplemental.id || '') + '">繼續追加拆包驗收入庫</button></article>';
        return;
      }
      var exactPending = matches.some(function (item) {
        return !freightItemClosesBatchQueueWithoutSelectionCheck(item);
      });
      if (!exactPending) {
        renderFreightSupplementalPrompt(matches, value, host);
        return;
      }
    }
    var firstItem = matches[0] || null;
