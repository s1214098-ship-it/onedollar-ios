  function freightFifoItemWarehouse(item) {
    var raw = String(item && (
      item.freightReceivedWarehouse
      || item.allocationSourceWarehouse
      || item.sourceWarehouseCode
      || ''
    ) || '').trim().toUpperCase();
    if (raw === 'TAIWAN') return 'TW';
    if (raw === 'CHINA') return 'CN';
    if (raw === 'INDONESIA') return 'ID';
    if (['TW', 'CN', 'ID'].indexOf(raw) !== -1) return raw;
    var sku = String(item && (item.skuId || item.sku) || '');
    var suffix = sku.match(/-(TW|CN|ID)$/i);
    if (suffix) return suffix[1].toUpperCase();
    var mid = sku.match(/-(TW|CN|ID)(?:-|$)/i);
    return mid ? mid[1].toUpperCase() : '';
  }

  function freightFifoItemWarehouses(items) {
    var seen = {};
    (Array.isArray(items) ? items : []).forEach(function (item) {
      var warehouse = freightFifoItemWarehouse(item);
      if (warehouse) seen[warehouse] = true;
    });
    return Object.keys(seen);
  }

  function freightFifoWarehouseLabel(code) {
    return code === 'CN' ? '中國倉' : (code === 'ID' ? '印尼倉' : '台灣倉');
  }

  function freightFifoSelectedShipWarehouses(modal, row) {
    var checked = [];
    if (modal) {
      Array.prototype.forEach.call(modal.querySelectorAll('[data-freight-fifo-ship-warehouse]'), function (input) {
        var code = String(input.getAttribute('data-freight-fifo-ship-warehouse') || input.value || '').toUpperCase();
        if (['TW', 'CN', 'ID'].indexOf(code) === -1) return;
        if (input.disabled) return;
        if (input.type === 'checkbox' ? input.checked : true) checked.push(code);
      });
    }
    var warehouses = freightFifoItemWarehouses(row && row.items);
    if (!canUseChinaWarehouseForTaiwanLiveOrder()) {
      warehouses = warehouses.filter(function (code) { return code !== 'CN'; });
      checked = checked.filter(function (code) { return code !== 'CN'; });
    }
    if (!checked.length) return warehouses.slice();
    return checked.filter(function (code, index) { return checked.indexOf(code) === index; });
  }

  function freightFifoSelectedShipWarehouse(modal, row) {
    var selected = freightFifoSelectedShipWarehouses(modal, row);
    var warehouses = freightFifoItemWarehouses(row && row.items);
    var coversAll = !warehouses.length || warehouses.every(function (code) { return selected.indexOf(code) !== -1; });
    if (coversAll || selected.length !== 1) return '';
    return selected[0];
  }

  function obtainFreightFifoFormalOrder(modal) {
    var preorderId = modal && modal.getAttribute('data-preorder-id') || '';
    var orderId = modal && modal.getAttribute('data-order-id') || '';
    var preorder = (state.inquiries || []).find(function (row) { return String(row && row.id || '') === preorderId; })
      || (modal && modal._freightFifoPreorder && String(modal._freightFifoPreorder.id || '') === preorderId ? modal._freightFifoPreorder : null)
      || (preorderId ? (freightFifoIndexes().inquiryById.get(String(preorderId)) || null) : null);
    if (!preorder && preorderId) {
      var cachedRow = modal && modal._freightFifoRow || {};
      preorder = Object.assign({}, cachedRow, { id: preorderId, items: cachedRow.items || [] });
    }
    if (!orderId && preorder) orderId = freightFifoFormalOrderId(preorder, null);
    if (orderId) {
      if (modal) modal.setAttribute('data-order-id', orderId);
      return Promise.resolve({ id: orderId });
    }
    if (!preorder) return Promise.reject(new Error('找不到要轉正式出貨的預購客戶'));
    var shipWarehouses = freightFifoSelectedShipWarehouses(modal, preorder);
    var shipWarehouse = freightFifoSelectedShipWarehouse(modal, preorder);
    var itemWarehouses = freightFifoItemWarehouses(preorder.items);
    if (!canUseChinaWarehouseForTaiwanLiveOrder()) {
      var convertingChina = shipWarehouses.indexOf('CN') !== -1
        || (itemWarehouses.indexOf('CN') !== -1 && (!shipWarehouses.length || !shipWarehouse));
      if (convertingChina) return Promise.reject(new Error(chinaWarehouseTaiwanLiveAdminOnlyMessage()));
    }
    var mixedWarehouses = itemWarehouses.length > 1;
    var shipTogether = !shipWarehouse;
    var shippingOnlyChina = (shipWarehouses.length > 0 && shipWarehouses.every(function (code) { return code === 'CN'; }))
      || (!mixedWarehouses && itemWarehouses[0] === 'CN');
    var useTaiwanStock = !shippingOnlyChina && (!mixedWarehouses || shipTogether) && String(modal && modal.getAttribute('data-taiwan-stock-allocation-ready') || '') === '1';
    var useManualPhysical = (!mixedWarehouses || shipTogether) && String(modal && modal.getAttribute('data-manual-physical-allocation-ready') || '') === '1';
    var hasAnyPhysicalLine = (!mixedWarehouses || shipTogether) && (Array.isArray(preorder.items) ? preorder.items : []).some(function (item) {
      if (!item) return false;
      var received = Math.max(0, Number(item.freightReceivedQty || item.receivedQty || 0));
      var source = String(item.freightReceivedWarehouse || item.allocationSourceWarehouse || '').toUpperCase();
      return received > 0
        || ['TW', 'CN', 'ID', 'TAIWAN', 'CHINA', 'INDONESIA'].indexOf(source) !== -1
        || item.manualPriorityAllocation === true
        || String(item.priorityAllocationStatus || '') === 'warehouse_reserved';
    });
    if (hasAnyPhysicalLine && !shippingOnlyChina && (shipWarehouse === 'TW' || shipTogether)) {
      useTaiwanStock = true;
      useManualPhysical = true;
    }
    var fulfillWarehouse = shipWarehouse
      || (shippingOnlyChina
        ? 'CN'
        : (useTaiwanStock
          ? 'TW'
          : (preorder.arrivalWarehouse || preorder.preorderFulfillWarehouse || preorder.preorderWarehouse || 'TW')));
    var preorderMetaPayload = {
      action: 'update-preorder-meta',
      inquiryId: preorderId,
      purchaseNote: preorder.purchaseNote || '',
      allocationNote: preorder.allocationNote || '',
      purchasePlatform: preorder.purchasePlatform || preorder.platform || '',
      supplierTrackingNo: preorder.supplierTrackingNo || '',
      supplierCarrier: preorder.supplierCarrier || '',
      arrivalWarehouse: fulfillWarehouse,
      employeeName: currentLogin().name || currentLogin().account || '管理者'
    };
    // 出貨核對轉正式不要先寫 ready_to_ship。混單（有的台灣現貨、有的還沒入庫）
    // 會被「尚未驗收入庫不能准許出貨」整張擋下。
    return callStockInquiryApi(preorderMetaPayload).then(function () {
      return callStockInquiryApi({
        action: 'convert',
        inquiryId: preorderId,
        fulfillWarehouse: fulfillWarehouse,
        shipWarehouse: shipWarehouse,
        shipWarehouses: shipWarehouses,
        directStockAllocation: shippingOnlyChina ? false : useTaiwanStock,
        manualPhysicalAllocation: shippingOnlyChina ? true : useManualPhysical,
        transferredBy: currentLogin().name || currentLogin().account || '管理者'
      });
    }).then(function (data) {
      if (data && data.inquiry) applyFreightFifoItemChangeResult(data, preorder, null, '');
      var formal = data && data.order ? data.order : { id: data && (data.orderId || data.inquiryId) || preorderId };
      formal.partialWarehouseConvert = !!(data && data.partialWarehouseConvert);
      formal.shipWarehouse = data && data.shipWarehouse || fulfillWarehouse;
      formal.shipWarehouses = shipWarehouses;
      formal.remainingItemCount = Number(data && data.remainingItemCount || 0);
      return formal;
    });
  }

  function persistFreightFifoCustomerDetails(modal) {
    if (!modal) return Promise.reject(new Error('找不到客戶配送視窗'));
    var preorderId = modal.getAttribute('data-preorder-id') || '';
    var orderId = modal.getAttribute('data-order-id') || '';
    // A converted preorder is rendered from the formal order. Older modal
    // markup did not always carry data-preorder-id, so saving the formal order
    // cleared its hold flag but left the linked inquiry in waitNotify=true.
    // The FIFO classifier also reads that linked inquiry and therefore kept a
    // genuine ship-now order in the hold queue. Recover the source id from the
    // formal order before building the inquiry payload so both records move
    // together.
    if (!preorderId && orderId) {
      var linkedFormalOrder = (state.orders || []).find(function (row) {
        return String(row && row.id || '') === String(orderId);
      }) || {};
      preorderId = String(
        linkedFormalOrder.sourceInquiryId
        || linkedFormalOrder.convertedFromInquiryId
        || linkedFormalOrder.inquiryId
        || ''
      ).trim();
      if (preorderId) modal.setAttribute('data-preorder-id', preorderId);
    }
    var name = String((modal.querySelector('[data-freight-fifo-name]') || {}).value || '').trim();
    var shipping = readCustomerShippingAddressFields(modal);
    var address = shipping.address;
    var phone = String((modal.querySelector('[data-freight-fifo-phone]') || {}).value || '').trim();
    var decision = String((modal.querySelector('[data-freight-fifo-bundle-decision]') || {}).value || '').trim();
    var shippingNote = String((modal.querySelector('[data-freight-fifo-note]') || {}).value || '').trim();
    var shippingCarrier = String((modal.querySelector('[data-freight-fifo-carrier]') || {}).value || '').trim();
    var outboundParcels = freightFifoReadOutboundParcels(modal);
    var trackingNo = outboundParcels[0] && outboundParcels[0].trackingNo || '';
    var reservation = freightFifoReservationPayload(modal, decision);
    if (reservation.isHold) {
      if (decision !== 'ask_sales') decision = 'wait_all';
      outboundParcels = freightFifoParcelsHeldPending(outboundParcels);
      trackingNo = outboundParcels[0] && outboundParcels[0].trackingNo || trackingNo;
    } else if (trackingNo && decision !== 'wait_all' && decision !== 'ask_sales') {
      // A real outbound tracking number means the operator has committed this
      // customer to the current shipment, unless 先不出貨／寄庫 is selected.
      decision = 'ship_now';
    }
    var resellerMode = String((modal.querySelector('[data-freight-fifo-reseller-mode]') || {}).value || 'direct');
    var resellerSettlement = {
      enabled: resellerMode === 'reseller',
      mode: resellerMode === 'reseller' ? 'reseller' : 'direct',
