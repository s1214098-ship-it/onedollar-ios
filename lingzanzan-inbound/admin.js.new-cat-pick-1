  function staffErrorFrom(row) {
    row = row || {};
    var error = row.staffError && typeof row.staffError === 'object' ? row.staffError : null;
    var customer = row.customer || {};
    if (!error && customer.staffError && typeof customer.staffError === 'object') error = customer.staffError;
    if (!error && Array.isArray(row.staffErrors)) {
      for (var i = row.staffErrors.length - 1; i >= 0; i -= 1) {
        var candidate = row.staffErrors[i];
        if (candidate && typeof candidate === 'object' && String(candidate.status || 'open') !== 'applied' && String(candidate.status || '') !== 'settled') {
          error = candidate;
          break;
        }
      }
    }
    if (!error) return null;
    var status = String(error.status || 'open');
    if (status === 'applied' || status === 'settled') return null;
    var amount = Math.max(0, Number(error.amountTwd || error.amount || 0));
    var op = String(error.pendingOp || 'none');
