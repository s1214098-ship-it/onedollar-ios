    var isSelfPickup = String(item.logisticsSource || '').trim().toLowerCase() === 'self_pickup';
    var text = [item.trackingNo, item.haohongTrackingNo, item.pendingLogisticsCode, item.pendingTrackingCode, item.progress, item.issueType, item.issueProgress, item.status, item.shippingStatus, item.deliveryState, item.note].join(' ');
    var returned = /退回|退件|退貨|拒收|異常|改址|returned|return|abnormal/i.test(text);
    var noData = /查無|無資料|没有资料|沒有資料|tidak ada data|no data|not found/i.test(text);
    var notHanded = /訂單已成立|尚未至門市|尚未交寄|未交寄|未寄出|未到店家交寄|建單未寄|pending handoff/i.test(text);
    var arrivedStore = /已到門市|到店|待取|門市取件|arrived|pickup/i.test(text);
    var delivered = /已取件|取件完成|投遞成功|已簽收|簽收完成|已送達|完成配送|delivered|received/i.test(text);
    var inTransit = /配送中|物流配送中|已交寄|已寄出|物流中心|轉運|運送中|發貨|集運中|已集運|待簽收|in transit|shipping/i.test(text);
    if (mode === 'missing') return !hasTrackingNo && !isSelfPickup;
    if (mode === 'not_handed') return hasTrackingNo && notHanded && !returned && !delivered;
    if (mode === 'in_transit') return hasTrackingNo && inTransit && !arrivedStore && !returned && !delivered;
    if (mode === 'arrived_store') return hasTrackingNo && arrivedStore && !returned && !delivered;
    if (mode === 'delivered') return hasTrackingNo && delivered && !returned;
    if (mode === 'returned') return returned;
    if (mode === 'no_data') return hasTrackingNo && noData;
    if (mode === 'manual') return (!hasTrackingNo && !isSelfPickup) || returned || noData || notHanded;
