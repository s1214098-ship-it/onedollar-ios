  function inventoryLabelSerialLast6(printBarcode, payload) {
    payload = payload || {};
    if (payload.dedicatedSerialNumber) return String(payload.dedicatedSerialNumber).replace(/[^A-Za-z0-9]/g, '').slice(-6).toUpperCase();
    var unit = Math.max(1, Math.floor(Number(payload.companyUnitIndex || payload.customerUnitIndex || payload.unitIndex || 1)));
