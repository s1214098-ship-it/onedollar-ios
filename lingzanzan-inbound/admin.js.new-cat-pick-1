  function freightFifoPaymentBreakdown(row) {
    row = row || {};
    var items = Array.isArray(row.items) ? row.items : [];
    var lines = items.map(function (item, itemIndex) {
      item = item || {};
      var qty = Math.max(1, Number(item.qty || item.quantity || item.requestedQty || 1));
      var unitPrice = freightFifoItemUnitPrice(item);
      return {
        code: item.code || item.productCode || item.sku || item.skuId || '未帶商品編號',
        variant: [item.color || item.colorName, canonicalNoSize(item.size || item.sizeName || 'NO SIZE')].filter(Boolean).join('／'),
        qty: qty,
        isGift: !!item.isGift || String(item.lineType || '').toLowerCase() === 'gift',
        giftReason: String(item.giftReason || ''),
        index: itemIndex,
        skuId: item.skuId || item.sku || '',
        unitPrice: unitPrice,
        subtotal: unitPrice * qty,
        hasPrice: unitPrice > 0
