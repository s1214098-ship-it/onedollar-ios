      return freightVariantTextKey(row.colorName || row.color || '') === freightVariantTextKey(line.color) && freightVariantTextKey(row.sizeName || row.size || 'NO SIZE') === freightVariantTextKey(line.size);
    }) || null;
    var latest = latestEffectiveCostInfo(product || {}, sku || {});
    var latestCost = latest.hasCost ? Number(latest.cost || 0) : Math.max(0, Number(line.latestCostTwd || item.existingTwdCost || Number(item.costRmb || 0) * 5 || 0));
    var fixed = fixedBarcodeCostInfo(product || {}, sku || {}, latestCost, line);
    var cost = fixed.hasCost ? Number(fixed.cost || 0) : latestCost;
    var baseCode = freightUsableProductBaseCode(line.productCode || line.catalogProductCode || item.productCode || product && (product.code || product.id) || freightProductCodeFromBarcode(line.sampleBarcode || item.sampleBarcode || ''))
