  function freightFifoSubtotal(row) {
    return (Array.isArray(row && row.items) ? row.items : []).reduce(function (sum, item) {
      return sum + freightFifoItemUnitPrice(item) * Math.max(1, Number(item && (item.qty || item.quantity || item.requestedQty) || 1));
    }, 0);
  }

  function freightFifoTextContainsAny(text, tokens) {
    text = String(text || '').toLowerCase();
    return tokens.some(function (token) { return text.indexOf(String(token || '').toLowerCase()) !== -1; });
  }

  function freightFifoShippingRule(row) {
    row = row || {};
    var customer = row.customer || {};
    var split = splitCustomerShippingAddresses(Object.assign({}, row, { customer: customer }));
    var text = [
      row.shippingCarrier,
      split.address,
      row.deliveryType,
      row.deliveryLabel,
      customer.deliveryType,
      customer.deliveryLabel
    ].map(function (value) { return String(value || ''); }).join(' ').toLowerCase();
    if (/self|pickup|ambil\s*sendiri/i.test(text) || freightFifoTextContainsAny(text, ['\u81ea\u53d6', '\u9762\u4ea4', '\u4e0d\u6536\u904b\u8cbb', '\u4e0d\u9700\u7269\u6d41'])) return { matched: true, fee: 0 };
    var placeholderPattern = /請看購買圖片|尚未填|未填地址|地址待補|看圖片|see\s*(?:photo|image)|pending/i;
    var storeAddress = String(split.storeAddress || '').trim();
    var homeAddress = String(split.homeAddress || '').trim();
    var validStoreAddress = !!storeAddress && !placeholderPattern.test(storeAddress);
    var validHomeAddress = !!homeAddress && !placeholderPattern.test(homeAddress);
    // 沒有實際目的地時不能因為預設勾在「超商」就先加 NT$70。
    // 等使用者真的填入超商或住家地址後，才套用 70／100 的規則。
    if (!validStoreAddress && !validHomeAddress) return { matched: false, fee: null, missingAddress: true };
    if (split.addressPrimary === 'store' && validStoreAddress) return { matched: true, fee: 70 };
    if (split.addressPrimary === 'home' && validHomeAddress) return { matched: true, fee: 100 };
    if (/7\s*-?\s*11|711|family|familymart|store|minimarket/i.test(text) || freightFifoTextContainsAny(text, ['\u5168\u5bb6', '\u8d85\u5546', '\u5e97\u5230\u5e97'])) return { matched: true, fee: 70 };
    if (/home|post|hct|ktj/i.test(text) || freightFifoTextContainsAny(text, ['\u5b85\u914d', '\u4f4f\u5bb6', '\u5bb6\u88e1', '\u5bb6\u91cc', '\u5730\u5740', '\u90f5\u5c40', '\u65b0\u7af9', '\u5927\u69ae', '\u5927\u8363', '\u9ed1\u8c93', '\u4fbf\u5229\u5e36', '\u4fbf\u5229\u5e26'])) return { matched: true, fee: 100 };
    return { matched: false, fee: null };
  }
  function freightFifoStoredShippingFee(row) {
    row = row || {};
    var customer = row.customer || {};
    var shippingFee = row.shippingFee !== undefined && row.shippingFee !== null && row.shippingFee !== ''
      ? row.shippingFee
      : customer.shippingFee;
    return Math.max(0, Number(shippingFee || 0));
  }

  function freightFifoIsFreeShipping(row) {
    row = row || {};
    var customer = row.customer || {};
    if (freightFifoIsIndonesiaSelfShip(row)) return false;
    return row.freeShipping === true
      || customer.freeShipping === true
      || String(row.shippingFeeMode || customer.shippingFeeMode || '').toLowerCase() === 'free';
  }

  function freightFifoIsIndonesiaSelfShip(row) {
    row = row || {};
    var customer = row.customer || {};
    var mode = String(row.shippingFeeMode || customer.shippingFeeMode || '').toLowerCase();
    if (mode === 'id_self') return true;
    if (row.indonesiaSelfShip === true || customer.indonesiaSelfShip === true) return true;
    var carrier = String(row.shippingCarrier || customer.shippingCarrier || '');
    var delivery = String(row.deliveryType || row.deliveryLabel || customer.deliveryType || customer.deliveryLabel || '');
    return /印尼業務自行出貨/.test(carrier) || /indonesia_sales|印尼業務自行出貨|印尼自出/.test(delivery);
  }

  function freightFifoShippingFeeModeFromRow(row) {
    if (freightFifoIsIndonesiaSelfShip(row)) return 'id_self';
    if (freightFifoIsFreeShipping(row)) return 'free';
    return 'standard';
  }

  function freightFifoWaivesCustomerShippingFee(row) {
    return freightFifoIsFreeShipping(row) || freightFifoIsIndonesiaSelfShip(row);
  }

  function freightFifoRegularShippingFee(row) {
    row = row || {};
    var customer = row.customer || {};
    // The recognized destination is the current source of truth. Older preorder
    // records can still carry a home-delivery fee after the address was changed
    // to a convenience store, so only use the stored regular fee as a fallback.
    var rule = freightFifoShippingRule(row);
    if (rule.matched) return Math.max(0, Number(rule.fee || 0));
    if (rule.missingAddress) return 0;
    var storedRegular = Number(row.regularShippingFee != null ? row.regularShippingFee : customer.regularShippingFee);
    if (Number.isFinite(storedRegular) && storedRegular > 0) return storedRegular;
