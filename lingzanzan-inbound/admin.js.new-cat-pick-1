  function markPreorderOrderedByFreightAllocation(row) {
    if (!row || !row.id || row.inventoryReceived) return Promise.resolve(row);
    var currentStatus = normalizePreorderPurchaseStatus(row.purchaseStatus);
    if (currentStatus === 'ordered' || currentStatus === 'arrived' || currentStatus === 'received') return Promise.resolve(row);
    // Entering logistics means the matched quantity has been bought and is
    // forecast stock. Do not mark an entire multi-item preorder as ordered
    // until every requested unit is linked; uncovered units must remain in
    // the purchase queue.
    if (preorderExistingFreightAllocatedQty(row.id) < preorderFreightRequestedQuantity(row)) return Promise.resolve(row);
    return callStockInquiryApi({
      action: 'update-preorder-meta',
      inquiryId: row.id,
      purchaseStatus: 'ordered',
      purchaseNote: row.purchaseNote || '',
      allocationNote: row.allocationNote || '',
      purchasePlatform: row.purchasePlatform || row.platform || '',
      supplierTrackingNo: row.supplierTrackingNo || '',
      supplierCarrier: row.supplierCarrier || '',
      arrivalWarehouse: row.arrivalWarehouse || row.preorderWarehouse || 'TW',
      employeeName: '物流預購倉自動串聯'
    }).then(function (data) {
      var updated = data && data.inquiry;
      if (updated) {
        var index = (state.inquiries || []).findIndex(function (item) { return String(item && item.id || '') === String(row.id || ''); });
        if (index >= 0) state.inquiries[index] = updated;
      }
      return updated || row;
    });
