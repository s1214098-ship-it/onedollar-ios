  function freightToday() {
    var now = new Date();
    try {
      var parts = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Taipei', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(now);
      var values = {};
      parts.forEach(function (part) { if (part.type !== 'literal') values[part.type] = part.value; });
      return values.year + '-' + values.month + '-' + values.day;
    } catch (error) {
      return new Date(now.getTime() - now.getTimezoneOffset() * 60000).toISOString().slice(0, 10);
    }
  }

  function normalizeFreightTracking(data) {
    data = data || {};
    // The freight page calls this helper from several independent panels during
    // one render. Re-cloning every item, package and variant each time made the
    // main thread repeatedly process the same multi-megabyte payload.
    if (data.__lingzanzanFreightNormalized === true) return data;
    var damageRetentionNow = Date.now();
    var damageRetentionMs = 20 * 24 * 60 * 60 * 1000;
    function normalizePlatformRecord(item) {
      if (!item || typeof item !== 'object') return item;
      var normalized = Object.assign({}, item, {
        platform: canonicalPurchasePlatformName(item.platform || '')
      });
      if (Array.isArray(item.splitPackages)) normalized.splitPackages = item.splitPackages.map(function (parcel, index) {
        parcel = parcel && typeof parcel === 'object' ? parcel : {};
        return {
          id: String(parcel.id || ('parcel-' + (index + 1))),
          trackingNo: String(parcel.trackingNo || '').trim(),
          quantity: Math.max(1, Number(parcel.quantity || parcel.qty || 1)),
          status: String(parcel.status || '待收貨').trim(),
          note: String(parcel.note || '').trim()
        };
      }).filter(function (parcel) { return parcel.trackingNo; });
      if (Array.isArray(item.packageRows)) normalized.packageRows = item.packageRows.map(normalizePlatformRecord);
      if (Array.isArray(item.variants)) normalized.variants = item.variants.map(function (line, index) {
        line = line && typeof line === 'object' ? line : {};
        return Object.assign({}, line, {
          id: String(line.id || ('variant-' + (index + 1))),
          category: String(line.category || item.category || '').trim(),
          color: String(line.color || line.colorName || '').trim(),
          size: canonicalNoSize(line.size || line.sizeName),
          quantity: Math.max(1, Number(line.quantity || line.qty || 1)),
          sampleBarcode: String(line.sampleBarcode || line.taiwanBarcode || '').trim(),
          taiwanBarcode: String(line.taiwanBarcode || line.sampleBarcode || '').trim(),
          barcodeCostTwd: (function () {
            var fixed = fixedBarcodeCostInfo({}, {}, 0, line);
            return fixed.hasCost ? Math.max(0, Number(fixed.cost || 0)) : 0;
          })(),
          latestCostTwd: Math.max(0, Number(line.latestCostTwd || 0)),
          latestCostSource: String(line.latestCostSource || '').trim()
        });
      });
      return normalized;
    }
    function normalizeDamageRecord(item) {
      var normalized = normalizePlatformRecord(item);
      if (!normalized || typeof normalized !== 'object') return null;
      var isCompleted = String(normalized.progress || '') === '已完成' || Boolean(normalized.completedAt);
      if (!isCompleted) {
        delete normalized.completedAt;
        delete normalized.retentionUntil;
        return normalized;
      }
      var completedAt = String(normalized.completedAt || '').trim();
      var completedMs = Date.parse(completedAt);
      if (!Number.isFinite(completedMs)) {
        completedMs = damageRetentionNow;
        completedAt = new Date(completedMs).toISOString();
      }
      var retentionUntil = String(normalized.retentionUntil || '').trim();
      var retentionMs = Date.parse(retentionUntil);
      if (!Number.isFinite(retentionMs)) {
        retentionMs = completedMs + damageRetentionMs;
        retentionUntil = new Date(retentionMs).toISOString();
      }
      if (retentionMs <= damageRetentionNow) return null;
      normalized.progress = '已完成';
      normalized.completedAt = completedAt;
      normalized.retentionUntil = retentionUntil;
      return normalized;
    }
    var normalizedDamages = (Array.isArray(data.damages) ? data.damages : []).map(normalizeDamageRecord).filter(Boolean);
    var normalizedData = {
      schemaVersion: Math.max(2, Number(data.schemaVersion || 2)),
      revision: Math.max(0, Number(data.revision || 0)),
      batches: Array.isArray(data.batches) ? data.batches.map(normalizePlatformRecord) : [],
      items: Array.isArray(data.items) ? data.items.map(normalizePlatformRecord) : [],
      haohongPackageWeights: Array.isArray(data.haohongPackageWeights) ? data.haohongPackageWeights.map(normalizePlatformRecord) : [],
      checkpoints: Array.isArray(data.checkpoints) ? data.checkpoints.map(normalizePlatformRecord) : [],
      damages: normalizedDamages,
      importMeta: data.importMeta && typeof data.importMeta === 'object' ? data.importMeta : {}
    };
    // Non-enumerable so it never enters JSON backups or API writes.
    Object.defineProperty(normalizedData, '__lingzanzanFreightNormalized', {
      value: true,
      enumerable: false,
      configurable: true
    });
    return normalizedData;
  }

  function freightDamageRetentionNeedsSave(source, normalized) {
    var sourceRows = source && Array.isArray(source.damages) ? source.damages : [];
    var normalizedRows = normalized && Array.isArray(normalized.damages) ? normalized.damages : [];
    if (sourceRows.length !== normalizedRows.length) return true;
    var normalizedById = new Map(normalizedRows.map(function (item) { return [String(item.id || ''), item]; }));
    return sourceRows.some(function (item) {
      var matched = normalizedById.get(String(item.id || ''));
      if (!matched) return true;
      return String(item.progress || '') !== String(matched.progress || '') ||
        String(item.completedAt || '') !== String(matched.completedAt || '') ||
        String(item.retentionUntil || '') !== String(matched.retentionUntil || '');
    });
  }

  function loadFreightTracking(forceForAllocation) {
    // The preorder product picker also uses unreceived freight variants as its
    // PREORDER warehouse catalogue.  Skipping this load made freight-only
    // products (for example BOW006 before its formal product/SKU is filed)
    // disappear from preorder search entirely.
    var needsPreorderFreightCatalog = !!document.querySelector('[data-manual-preorder-form]');
    if (!forceForAllocation && !needsPreorderFreightCatalog && !document.querySelector('[data-freight-tracking-panel]') && !document.querySelector('[data-product-customs-options]') && !document.querySelector('[data-inventory-freight-entry]') && !document.querySelector('[data-order-demand-summary]')) return Promise.resolve();
    if (adminFreightTrackingRequest) return adminFreightTrackingRequest;
    // Freight photos used to be returned as repeated base64 strings inside a
    // 24 MB JSON document.  Ask the API for stable generated image URLs so the
    // browser can cache and lazy-load them while the freight rows arrive fast.
    adminFreightTrackingRequest = fetch('./freight-tracking-api.php?image_urls=1', { cache: 'no-cache' })
      .then(function (res) {
        if (!res.ok) throw new Error('物流集運讀取失敗 ' + res.status);
        return res.json();
      })
      .then(function (payload) {
        var sourceFreightTracking = payload && payload.data;
        state.freightTracking = normalizeFreightTracking(sourceFreightTracking);
        if (adminCurrentFileName() === 'admin-freight.html') {
          adminFreightServerBaseData = state.freightTracking;
          adminFreightServerSearchActive = false;
        }
        // Freight-only products must become searchable as soon as the main
        // tracking payload arrives. Do not keep the preorder picker blocked by
        // the secondary customs lookup, which can be slow or unavailable.
        window.LingzanzanFreightData = normalizeFreightTracking(state.freightTracking);
        manualPreorderSkuRowsCache = null;
        if (document.querySelector('[data-preorders-page]')) renderPreorderProductPool();
        if (document.querySelector('[data-preorders-page]')) {
          var immediatePreorderQuery = String(document.querySelector('[data-manual-preorder-search]')?.value || '');
          if (immediatePreorderQuery) renderManualPreorderSuggest();
        }
        document.dispatchEvent(new CustomEvent('lingzanzan:freight-loaded', { detail: window.LingzanzanFreightData }));
        var shouldSaveDamageRetention = freightDamageRetentionNeedsSave(sourceFreightTracking, state.freightTracking);
        // Preorder entry only needs freight variants for product search.  Do
        // not build the entire freight workbench when none of its panels exist;
        // that was locking the page for tens of seconds on every workstation.
        if (document.querySelector('[data-freight-tracking-panel]')) {
          fillFreightBatchSelect();
          renderFreightTracking();
        }
        adminLastFreightHeavySyncAt = Date.now();
        resumeFreightReceivingFromUrl();
        if (document.querySelector('[data-order-tracking-page]')) renderOrderTrackingDashboard();
        else if (!standaloneOrderDemandLoading) renderOrderTrackingDemandSummary();
        openFreightBatchEditorFromUrl();
        return fetch('./freight-customs-lookup.php?recent=45', { cache: 'no-cache' }).then(function (res) {
          return res.ok ? res.json() : { matches: [] };
        }).catch(function () { return { matches: [] }; }).then(function (customsPayload) {
          state.baohuiCustoms = Array.isArray(customsPayload.matches) ? customsPayload.matches : [];
          fillRecentCustomsOptions();
          window.LingzanzanFreightData = normalizeFreightTracking(state.freightTracking);
          if (document.querySelector('[data-order-tracking-page]')) renderOrderTrackingDashboard();
          if (document.querySelector('[data-preorders-page]')) {
            var pendingPreorderQuery = String(document.querySelector('[data-manual-preorder-search]')?.value || '');
            var preorderSearch = document.querySelector('[data-manual-preorder-search]');
            if (preorderSearch && pendingPreorderQuery) {
              preorderSearch.value = pendingPreorderQuery;
              renderManualPreorderSuggest();
            }
          }
          // Reconcile after every completed freight/inquiry refresh, not only
          // the first visit to the freight page.  Orders and freight records
          // can arrive from different pages/devices; the old one-shot body
          // flag permanently skipped matching when either dataset arrived a
          // moment later.  The reconcile routine is idempotent and already
          // shares an in-flight promise, so rerunning it is safe.
          var currentAdminFile = location.pathname.split('/').pop() || '';
          // 物流工作台本身已在驗收／入庫 API 內完成精準提撥。不要在每次
          // 10 秒同步後又於前景重跑四輪全預購提撥，否則搜尋與展開按鈕會
          // 被長時間運算鎖住。其他後台頁仍保留原本的背景補提撥機制。
          if (['admin-freight.html', 'admin-order-tracking.html', 'admin-preorder-demand.html', 'admin-orders.html', 'admin-preorders.html', 'admin-live.html'].indexOf(currentAdminFile) === -1 && currentLogin().role === 'admin' && (state.inquiries || []).length && normalizeFreightTracking(state.freightTracking).items.length) {
            setTimeout(function () {
              reconcilePreorderWarehouseAllocationsUntilStable(4).then(function (summary) {
                if (summary.allocated > 0 || summary.statusUpdated > 0) {
                  renderFreightTracking();
                  renderOrders();
                }
                if (summary.allocated > 0) {
                  toast('已繼續自動提撥 ' + summary.allocated + ' 件給 ' + summary.orders + ' 張最早的預購單');
                }
              }).catch(function (error) { console.warn('freight preorder allocation continuation failed', error); });
            }, 250);
          }
          return syncStaleFreightBatchesFromBaohui().then(function (dirtyIds) {
            if (dirtyIds && dirtyIds.length && document.querySelector('[data-freight-tracking-panel]')) {
              toast('已從寶輝重抓 ' + dirtyIds.length + ' 批，產品成本改以快遞收費為準。已入庫的請再按「重算已入庫成本」。');
            }
            if (shouldSaveDamageRetention && !(dirtyIds && dirtyIds.length)) return saveFreightTracking();
            return dirtyIds;
          });
        });
      })
      .catch(function (error) {
        state.freightTracking = normalizeFreightTracking(state.freightTracking);
        renderFreightTracking();
        toast(error.message || '物流集運讀取失敗');
      });
    return adminFreightTrackingRequest.then(function (value) {
      adminFreightTrackingRequest = null;
      return value;
    }, function (error) {
      adminFreightTrackingRequest = null;
      throw error;
    });
  }

  function freightTrackingForAllocation() {
    // Server search replaces the on-screen item list. Allocation must still
