    var sibling = freightSiblingLineForColor(freightVariantLines(item).concat([line]), line.color);
    if (sibling && freightVariantTextKey(sibling.size || 'NO SIZE') !== freightVariantTextKey(line.size || 'NO SIZE')) {
      var inherited = freightComposeInheritedSizeBarcode(sibling, line.size);
      if (inherited.barcode) {
        line.sampleBarcode = inherited.barcode;
        line.taiwanBarcode = inherited.barcode;
        line.barcodeAutoGenerated = true;
        line.barcodeColorCode = inherited.colorCode;
        line.barcodeSizeCode = inherited.sizeCode;
        if (!(Number(line.barcodeCostTwd || 0) > 0) && inherited.cost > 0) line.barcodeCostTwd = inherited.cost;
        if (!(Number(line.costRmb || 0) > 0) && Number(sibling.costRmb || item.costRmb || 0) > 0) line.costRmb = Number(sibling.costRmb || item.costRmb || 0);
