  function installAdminImagePerformanceDefaults() {
    function tune(root) {
      var images = [];
      if (root && root.nodeType === 1 && root.tagName === 'IMG') images.push(root);
      if (root && root.querySelectorAll) images = images.concat(Array.from(root.querySelectorAll('img')));
      images.forEach(function (image) {
        var critical = !!image.closest('.brand,.login-card');
        image.decoding = 'async';
        image.loading = critical ? 'eager' : 'lazy';
        if ('fetchPriority' in image) image.fetchPriority = critical ? 'high' : 'low';
      });
    }
    tune(document);
    var largeOrderPage = /\/(?:admin-orders|admin-preorders|admin-live|admin-order-tracking|admin-preorder-waiting|admin-preorder-demand|admin-freight|admin-inventory|admin-inventory-entry|admin-products|admin-finance|admin-profit)\.html$/i.test(String(location.pathname || ''));
    if (largeOrderPage) {
      window.setTimeout(function () { tune(document); }, 1800);
      window.setTimeout(function () { tune(document); }, 5200);
    } else {
      new MutationObserver(function (mutations) {
        mutations.forEach(function (mutation) {
          Array.from(mutation.addedNodes || []).forEach(tune);
        });
      }).observe(document.body, { childList: true, subtree: true });
    }
  }

