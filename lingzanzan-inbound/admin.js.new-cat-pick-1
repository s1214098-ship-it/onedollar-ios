  }

  function preorderTaiwanStockPlan(row, items) {
    if (!row || preorderInquiryConverted(row) || row.status === 'cancelled') {
      return { ready: false, lines: [], demandQty: 0, availableQty: 0 };
    }
    var groups = {};
    var rowItems = Array.isArray(row && row.items) ? row.items : [];
    (items || []).forEach(function (item, fallbackItemIndex) {
      var itemIndex = rowItems.indexOf(item);
      if (itemIndex < 0) itemIndex = fallbackItemIndex;
      var orderDemandQty = Math.max(0, Number(item && (item.qty || item.quantity || item.requestedQty) || 0));
      var freightAllocatedQty = Math.min(orderDemandQty, preorderExistingFreightAllocatedItemQty(row.id, itemIndex));
      var demandQty = Math.max(0, orderDemandQty - freightAllocatedQty);
      if (!demandQty) return;
      var code = preorderItemCode(item);
      var color = canonicalProductSpecificVariantColor(code, preorderItemColor(item));
      var size = canonicalProductVariantSize(preorderItemSize(item));
      var identities = Array.from(preorderOfficialProductIdentities(
        [item && (item.code || item.productCode)],
        [item && item.sku, item && item.skuId, item && item.productId, item && item.barcode]
      )).sort();
      var key = [identities.join(','), freightDemandIdentity(color), freightDemandIdentity(size)].join('|');
