  function autoAllocatePreorderWarehouse(row) {
    if (!row || !row.id) return Promise.resolve({ allocated: 0, links: 0 });
    var totalAllocated = 0;
    var totalLinks = 0;
    function allocateNext() {
      var candidate = preorderFreightAllocationCandidates(row)[0];
      if (!candidate) {
        var existingAllocated = preorderExistingFreightAllocatedQty(row.id);
        if (!totalAllocated && !existingAllocated) return Promise.resolve({ allocated: totalAllocated, links: totalLinks, statusUpdated: false });
        var needsStatusUpdate = normalizePreorderPurchaseStatus(row.purchaseStatus) === 'not_ordered';
        return markPreorderOrderedByFreightAllocation(row).then(function (updatedRow) {
