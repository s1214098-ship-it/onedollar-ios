        actionStatus.className = 'freight-receiving-action-status is-error';
        actionStatus.textContent = '作廢未完成：' + (error.message || '請再按一次') + '。尚未改庫存。';
      }
      toast(error.message || '作廢失敗');
    });
  }

  function saveFreightReceivingInspection(finalize, button) {
    var modal = document.querySelector('[data-freight-receiving-workbench]');
    if (!modal) return;
    var itemId = modal.getAttribute('data-freight-receiving-workbench') || '';
    var item = freightItemById(itemId);
    if (!item) { toast('找不到這筆物流產品'); return; }
    var lines = freightReceivingInspectionLinesFromWorkbench(modal).map(function (row) {
      return { actualQty: row.actualQty, internalUseQty: row.internalUseQty, adjustedExpectedQty: Math.max(Number(row.adjustedExpectedQty || 0), Number(row.actualQty || 0)) };
    });
    var goodsPurpose = freightReceivingWorkbenchPurpose(modal);
    var expected = freightVariantTotalQuantity(freightVariantLines(item));
    var actual = lines.reduce(function (sum, line) { return sum + line.actualQty; }, 0);
    // LZ_RECV_OVERAGE_20260927: 多收時應到跟著實收，後面入庫流程用同一個數字。
    if (actual > expected) expected = actual;
    var reasonBox = modal.querySelector('[data-freight-inspection-reason]');
    var reason = String(reasonBox ? reasonBox.value : '').trim();
    if (actual === expected && /本批點貨(短少|多到)|預計\s*\d+\s*／\s*實收/.test(reason)) {
      reason = '';
      if (reasonBox) reasonBox.value = '';
    }
    var actionStatus = modal.querySelector('[data-freight-receiving-action-status]');
    var routingInput = modal.querySelector('input[name="freight-receiving-routing"]:checked');
    var allocationMode = String(routingInput ? routingInput.value : 'auto_mixed');
    var destinationInput = modal.querySelector('[data-freight-receiving-destination]');
    var selectedDestination = String(destinationInput ? destinationInput.value : '');
    var businessUnitInput = modal.querySelector('[data-freight-receiving-business-unit]');
    var selectedBusinessUnit = String(businessUnitInput ? businessUnitInput.value : item.inventoryBusinessUnit || 'lingzanzan');
    var categoryInput = modal.querySelector('[data-freight-receiving-category]');
    var selectedCategory = String(categoryInput ? categoryInput.value : item.category || item.categoryName || '').trim();
    var purposeInput = modal.querySelector('[data-freight-stock-purpose]');
    var selectedStockPurpose = freightStockPurposeForItem(item, selectedDestination, purposeInput && purposeInput.value);
    var releaseCustomerInput = modal.querySelector('[data-freight-release-customer-confirm]');
    var confirmReleaseCustomerReservations = !!(releaseCustomerInput && releaseCustomerInput.checked);
    if (goodsPurpose === 'internal_use') {
      allocationMode = 'company_stock';
      confirmReleaseCustomerReservations = true;
      selectedStockPurpose = 'internal_use';
    }
    var existingInspection = item.receivingInspection && typeof item.receivingInspection === 'object' ? item.receivingInspection : {};
    var existingInspectionActual = Array.isArray(existingInspection.lines)
      ? existingInspection.lines.reduce(function (sum, line) { return sum + Math.max(0, Math.floor(Number(line && line.actualQty) || 0)); }, 0)
      : Math.max(0, Math.floor(Number(existingInspection.actualQty) || 0));
    if (selectedDestination === 'CN_DONGGUAN' && selectedStockPurpose === 'sample') {
      allocationMode = 'company_stock';
      confirmReleaseCustomerReservations = true;
    }
    if (finalize && (selectedBusinessUnit === 'baohui_computer' || selectedBusinessUnit !== String(item.inventoryBusinessUnit || 'lingzanzan')) && !selectedCategory) {
      if (actionStatus) {
        actionStatus.className = 'freight-receiving-action-status is-error';
        actionStatus.textContent = '跨部門入庫必須先選擇新部門的正式產品分類；尚未改動庫存。';
      }
      toast('請先選擇新部門的正式產品分類');
      if (categoryInput) categoryInput.focus();
      return;
    }
    // A previously finalized count may still need its destination department
    // corrected before the inventory posting. Only bypass the inspection save
    // when the selected business unit is unchanged; otherwise an old clothing
    // value would silently route computer goods into Lingzanzan TW stock.
    if (finalize && existingInspection.status === 'final' && existingInspectionActual === actual
      && selectedBusinessUnit === String(item.inventoryBusinessUnit || 'lingzanzan')
      && selectedDestination === freightReceivingWorkbenchDestination(item).code
      && selectedCategory === String(item.category || item.categoryName || '').trim()) {
      if (actionStatus) {
        actionStatus.className = 'freight-receiving-action-status is-working';
        actionStatus.textContent = '點貨早已保存，現在重新確認批次同步後再核對客戶與正式庫存。';
      }
      if (button) {
        button.disabled = true;
        button.setAttribute('data-idle-label', button.getAttribute('data-idle-label') || button.textContent || '');
        button.textContent = '正在確認批次同步…';
      }
      continueFreightReceivingAfterInspection(itemId, actual, expected, button, modal, actionStatus, allocationMode, selectedDestination, confirmReleaseCustomerReservations, selectedStockPurpose).catch(function (error) {
        if (button) {
          button.disabled = false;
          button.textContent = button.getAttribute('data-idle-label') || '點貨完成 → 核准正式入庫';
        }
        if (actionStatus) {
          actionStatus.className = 'freight-receiving-action-status is-error';
