  function findExactLiveSkuRow(code, preferredWarehouse) {
    var raw = normalizeLiveCode(code);
    if (!raw) return null;
    var parsed = parseLegacyProductBarcode(raw);
    var rows = [];
    state.products.forEach(function (product) {
      productSkus(state.skus, product.id).forEach(function (sku) {
        var exactSku = skuBarcodeAliases(sku).some(function (value) {
          return normalizeLiveCode(value) === raw;
        });
        if ((parsed && stocktakeLegacyMatches(product, sku, parsed)) || exactSku) {
          rows.push({ product: product, sku: sku });
        }
      });
    });
    if (!rows.length) return null;
    if (rows.length === 1) return rows[0];
    var wantedCode = adminOrderWarehouseCode(preferredWarehouse || adminOrderWarehouseLock || '台灣倉') || 'TW';
    rows.sort(function (a, b) {
      var aCode = warehouseCodeForRecord(a.sku, warehouseCodeForRecord(a.product));
      var bCode = warehouseCodeForRecord(b.sku, warehouseCodeForRecord(b.product));
      var aStock = Number(a.sku.stock || 0) > 0 ? 1 : 0;
      var bStock = Number(b.sku.stock || 0) > 0 ? 1 : 0;
      var aWanted = aCode === wantedCode ? 1 : 0;
      var bWanted = bCode === wantedCode ? 1 : 0;
      return (bWanted - aWanted) || (bStock - aStock);
    });
    return rows[0];
  }

