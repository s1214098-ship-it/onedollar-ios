  function freightFifoPaymentRegionBreakdown(box, values) {
    var history = freightFifoPaymentHistory(box);
    var deposit = { amount: 0, region: '' };
    history.forEach(function (event) {
      if (!event || Number(event.amount || 0) <= 0) return;
      if (String(event.paymentStage || '') === 'deposit') {
        deposit.amount += Math.max(0, Number(event.amount || 0));
        if (event.collectionRegion) deposit.region = String(event.collectionRegion);
      }
    });
    if (!deposit.amount && values && values.previousDeposit > 0) deposit.amount = values.previousDeposit;
    return deposit;
  }

  function freightFifoPaymentCollectionBreakdown(box, values, selectedRegion) {
    values = values || {};
    var totals = { TW: 0, ID: 0, unknown: 0 };
    var historyTotal = 0;
    freightFifoPaymentHistory(box).forEach(function (event) {
      var amount = Math.max(0, Number(event && event.amount || 0));
      if (!amount || !(event.collectionRegion || event.paymentStage || event.collectionParty)) return;
      var region = String(event.collectionRegion || '').toUpperCase();
      var key = region === 'TW' || region === 'ID' ? region : 'unknown';
      totals[key] += amount;
      historyTotal += amount;
    });
    var current = Math.max(0, Number(values.current || 0));
    var fallbackRegion = String(selectedRegion || '').toUpperCase();
    var fallbackKey = fallbackRegion === 'TW' || fallbackRegion === 'ID' ? fallbackRegion : 'unknown';
    if (current > 0) totals[fallbackKey] += current;
    var unclassifiedPrevious = Math.max(0, Number(values.paid || 0) - current - historyTotal);
    if (unclassifiedPrevious > 0) totals[fallbackKey] += unclassifiedPrevious;
    return totals;
  }

  function applyFreightFifoPaymentDefaults(modal, row) {
    var box = modal && modal.querySelector('[data-freight-fifo-payment]');
