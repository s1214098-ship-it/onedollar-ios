  function freightConfirmedReceivingSummary(batch) {
    var summary = freightBatchReceivingSummary(batch);
    summary.rows.forEach(function (row) {
      var source = row.item || {};
      var item = freightItemById(source.id || source.sourceItemId) || source;
      var inspection = item.receivingInspection && typeof item.receivingInspection === 'object'
        ? item.receivingInspection
        : null;
      var isStocked = freightItemClosesBatchQueueWithoutSelectionCheck(item);
      var confirmed = inspection && (inspection.status === 'draft' || inspection.status === 'final' || inspection.status === 'voided');
      row.receivedQty = confirmed
        ? Math.max(0, Math.floor(Number(inspection.actualQty) || 0))
        : (isStocked ? Math.max(0, Math.floor(Number(item.receivingActualQty || row.receivedQty || 0))) : 0);
      row.receivedQty += freightSupplementalReceivedByLine(item).reduce(function (sum, qty) {
        return sum + Math.max(0, Math.floor(Number(qty) || 0));
      }, 0);
      row.missingQty = Math.max(0, row.expectedQty - row.receivedQty);
      row.overQty = Math.max(0, row.receivedQty - row.expectedQty);
      row.quantityConfirmed = !!(confirmed || isStocked);
    });
    summary.receivedQty = summary.rows.reduce(function (sum, row) { return sum + row.receivedQty; }, 0);
    summary.missingQty = summary.rows.reduce(function (sum, row) { return sum + row.missingQty; }, 0);
    summary.overQty = summary.rows.reduce(function (sum, row) { return sum + row.overQty; }, 0);
    summary.pendingCount = summary.rows.filter(function (row) { return !row.quantityConfirmed; }).length;
    return summary;
  }

