          var photoSrc = freightForecastImageSources(currentItem, currentLines[0] || {}, currentCode)[0] || '';
          var photoHtml = photoSrc ? '<button type="button" class="freight-existing-batch-photo-button" data-order-photo="' + escapeHtml(photoSrc) + '" aria-label="放大查看產品圖片"><img src="' + escapeHtml(photoSrc) + '" alt="產品圖片" loading="lazy" decoding="async"></button>' : '';
          var photoStatus = photoHtml || '<span class="freight-existing-batch-photo-missing">缺圖片</span>';
          return '<article class="' + (photoHtml ? 'has-photo' : 'is-missing-photo') + '"><span>' + (index + 1) + '</span><div class="freight-existing-batch-product-photo">' + photoStatus + '</div><div><b>' + escapeHtml(currentItem.productName || currentItem.productCode || currentItem.sampleBarcode || '未命名產品') + '</b><small>物流：' + escapeHtml(currentItem.trackingNo || currentItem.haohongTrackingNo || '-') + '</small><small>' + escapeHtml(currentItem.productCode || currentItem.sampleBarcode || '-') + '／' + escapeHtml(currentItem.color || currentItem.colorName || '-') + '／' + escapeHtml(currentItem.size || currentItem.sizeName || '-') + ' × ' + Math.max(1, Number(currentItem.quantity || currentItem.qty || 1)) + '</small></div><button type="button" class="' + (photoHtml ? 'ghost-button' : 'primary-button') + '" data-freight-item-edit="' + escapeHtml(sourceId) + '">' + (photoHtml ? '編輯資料／圖片' : '編輯／補圖片') + '</button></article>';
        }).join('') : '<p>這個批次目前沒有產品明細。</p>') + '</div>';
      }
    }
    var selectedHost = document.querySelector('[data-freight-workbench-selected]');
    if (selectedHost) {
      selectedHost.innerHTML = selectedTrackingGroups.length ? selectedTrackingGroups.map(function (group, index) {
        var productText = group.rows.slice(0, 4).map(function (item) {
          return (freightWorkbenchInternalItemIds.has(String(item.id || '')) || freightIsInternalUseItem(item) ? '【公司自用／到貨勿配客戶】' : '【一般商品】') + (item.productName || item.productCode || item.sampleBarcode || '未命名產品') + '／' + (item.color || '-') + '／' + (item.size || '-') + ' × ' + Math.max(1, Number(item.quantity || item.qty || 1));
        }).join('；');
        if (group.rows.length > 4) productText += '；另 ' + (group.rows.length - 4) + ' 筆明細';
        var splitEditors = group.rows.map(freightWorkbenchSplitEditorHtml).join('');
        return '<article' + (freightWorkbenchInternalUse ? ' class="is-internal-use"' : '') + '><span>' + (index + 1) + '</span><div>' + freightWorkbenchPhotoComparisonHtml(group.rows[0] || {}) + '<b>' + escapeHtml(group.trackingNo) + '</b>' + (freightWorkbenchInternalUse ? '<strong class="freight-internal-use-badge">公司自用／到貨勿配客戶</strong>' : '') + '<small>' + escapeHtml(productText) + '</small><small>共 ' + group.rows.length + ' 筆品項／' + group.quantity + ' 件商品／帳號：' + escapeHtml(group.accounts.join('、') || '待確認') + '／到達：' + escapeHtml(group.destinations.join('、') || '待確認') + '</small>' + splitEditors + '</div><button type="button" class="ghost-button" data-freight-workbench-remove-tracking="' + escapeHtml(group.key) + '">移除此商品／全部拆包</button></article>';
      }).join('') : '<p>本批尚未加入物流包裹。</p>';
    }
    var keyword = freightSearchKeyword(document.querySelector('[data-freight-workbench-search]')?.value || '');
    var rawWorkbenchQuery = document.querySelector('[data-freight-workbench-search]')?.value || '';
    var platformFilter = canonicalPurchasePlatformName(document.querySelector('[data-freight-account-filter]')?.value || '');
    var resultHost = document.querySelector('[data-freight-workbench-results]');
    if (!resultHost) return;
    if (freightWorkbenchShortTrackingQuery(rawWorkbenchQuery)) {
      resultHost.innerHTML = '<p><b>物流單號或批號請至少輸入最後 4 碼。</b>例如 1773；目前不載入清單，避免搜尋時卡住。</p>';
      return;
    }
    var matchedBatches = keyword || platformFilter ? freightWorkbenchMatchingBatches(rawWorkbenchQuery) : [];
    var selectedMatches = String(rawWorkbenchQuery || '').trim() ? selected.filter(function (item) {
      return freightWorkbenchQueryMatchesItem(item, rawWorkbenchQuery);
    }) : [];
    var selectedHitHtml = selectedMatches.map(function (item) {
      var numbers = freightWorkbenchTrackingNumbers([item]);
      return '<article class="freight-workbench-selected-hit"><div><b>✓ 這個單號已連動在上方同一組拆包</b><small>' + escapeHtml(item.productName || item.productCode || '未命名商品') + '／共 ' + numbers.length + ' 組：' + escapeHtml(numbers.join('、')) + '</small></div><button type="button" class="primary-button" data-freight-workbench-focus-split="' + escapeHtml(item.id || '') + '">查看同組拆包</button></article>';
    }).join('');
    var batchHitHtml = matchedBatches.slice(0, 8).map(function (batch) {
      return '<article class="freight-workbench-batch-hit"><div><b>既有批次 ' + escapeHtml(batch.batchNo || batch.id || '-') + '</b><small>' + escapeHtml(freightBatchLabel(batch)) + '／' + Number(batch.itemCount || batch.packageCount || 0) + ' 件</small></div><button type="button" class="primary-button" data-freight-workbench-select-batch="' + escapeHtml(batch.id || '') + '">選定此批次</button></article>';
    }).join('');
    if (!keyword && !platformFilter) {
      resultHost.innerHTML = '<p><b>目前可加入批次：</b>' + escapeHtml(freightWorkbenchAvailabilityText()) + '。輸入平台採購訂單號、待物流辨識碼、正式物流號或批號後 7 碼；勾選後可自動建立新批號，若單號已在其他批次或已入庫，系統會直接告知位置。</p>';
      return;
    }
    var matches = freightWorkbenchFilteredCandidates().filter(function (item) { return !selectedFreightItemIds.has(String(item.id || '')); }).slice(0, 30);
    var itemHtml = matches.length ? matches.map(function (item) {
      var id = String(item.id || '');
      var selectedAlready = selectedFreightItemIds.has(id);
      var batchedAlready = !!item.batchId;
      var waitingTracking = !String(item.trackingNo || '').trim();
      var disabled = selectedAlready || batchedAlready || waitingTracking;
      var label = waitingTracking ? '待補正式物流號' : (selectedAlready ? '已加入本批' : (batchedAlready ? '已在其他批次' : (freightItemAlreadyFiled(item) ? '已建產品／加入本批' : '加入本批')));
      return '<article' + (item.customerPriority ? ' class="is-customer-priority"' : '') + '><label class="freight-workbench-check"><input type="checkbox" data-freight-workbench-check="' + escapeHtml(id) + '"' + (disabled ? ' disabled' : '') + '><span>勾選</span></label><div>' + freightWorkbenchPhotoComparisonHtml(item) + '<b>' + escapeHtml(item.trackingNo || item.pendingLogisticsCode || '未填物流單號') + '</b><small>' + escapeHtml(item.productName || item.productCode || item.sampleBarcode || '未命名產品') + '／' + escapeHtml(item.color || item.colorName || '未填顏色') + '／' + escapeHtml(item.size || item.sizeName || '未填尺寸') + '／' + Math.max(1, Number(item.quantity || 1)) + ' 件／RMB ' + Number(item.costRmb || 0).toLocaleString() + '</small><small class="freight-workbench-source">' + freightInlinePurchaseIdentityHtml(item) + (item.customerPriority ? '<strong>張張客戶重點</strong>' : '') + '</small><small>購買內容：' + escapeHtml(item.purchaseContentRaw || item.variantText || '-') + (item.note ? '／備註：' + escapeHtml(item.note) : '') + '</small></div><button type="button" class="' + (disabled ? 'ghost-button' : 'primary-button') + '" data-freight-workbench-add="' + escapeHtml(id) + '"' + (disabled ? ' disabled' : '') + '>' + label + '</button></article>';
    }).join('') : '';
    var emptyHtml = !selectedHitHtml && !batchHitHtml && !itemHtml
      ? '<p>找不到待選物流或批號；若剛加入本批，代表已從待選清單移除並保留在上方本批明細。</p>'
      : '';
    resultHost.innerHTML = selectedHitHtml + batchHitHtml + itemHtml + emptyHtml;
    Array.from(resultHost.querySelectorAll('[data-freight-workbench-add]')).forEach(function (addButton) {
      var internalButton = document.createElement('button');
      internalButton.type = 'button';
      internalButton.className = 'freight-internal-use-quick-button';
      internalButton.textContent = '自用加入本批';
      internalButton.disabled = addButton.disabled;
      internalButton.setAttribute('data-freight-workbench-add-internal', addButton.getAttribute('data-freight-workbench-add'));
      var actions = document.createElement('div');
      actions.className = 'freight-workbench-purpose-shortcuts';
      addButton.parentNode.insertBefore(actions, addButton);
      actions.appendChild(addButton);
      actions.appendChild(internalButton);
      internalButton.addEventListener('click', function (event) {
        event.preventDefault();
        event.stopPropagation();
        if (internalButton.disabled) return;
        var itemId = internalButton.getAttribute('data-freight-workbench-add-internal');
        addFreightItemToWorkbench(itemId);
        if (!selectedFreightItemIds.has(itemId)) return;
        freightWorkbenchInternalItemIds.add(String(itemId));
        renderFreightBatchWorkbench();
        toast('只有這筆已標記公司自用；同批其他商品不變，請完成建立或加入批次以儲存');
      });
    });
  }

  function selectFilteredFreightWorkbenchItems() {
    var candidates = freightWorkbenchFilteredCandidates().filter(function (item) { return !!String(item.trackingNo || '').trim(); });
    candidates = candidates.filter(function (item) { return freightWorkbenchAcceptsItem(item, false); });
    candidates.forEach(function (item) { selectedFreightItemIds.add(String(item.id || '')); });
    if (candidates[0]) syncFreightWorkbenchAccount(candidates[0]);
    if (candidates.length) clearFreightWorkbenchSearchAfterSelection();
    else renderFreightBatchWorkbench();
    toast(candidates.length ? '已勾選目前篩選的 ' + candidates.length + ' 筆物流明細；可直接自動產生新批號' : '目前篩選沒有可加入批次的正式物流單號');
  }

  function selectFirstFreightWorkbenchItems() {
    var count = Math.max(1, Math.floor(Number(document.querySelector('[data-freight-workbench-take-count]')?.value || 5)));
    var candidates = freightWorkbenchFilteredCandidates().filter(function (item) { return !!String(item.trackingNo || '').trim() && !selectedFreightItemIds.has(String(item.id || '')); });
    candidates = candidates.filter(function (item) { return freightWorkbenchAcceptsItem(item, false); }).slice(0, count);
    candidates.forEach(function (item) { selectedFreightItemIds.add(String(item.id || '')); });
    if (candidates[0]) syncFreightWorkbenchAccount(candidates[0]);
    if (candidates.length) clearFreightWorkbenchSearchAfterSelection();
    else renderFreightBatchWorkbench();
    toast(candidates.length ? '已勾選篩選結果前 ' + candidates.length + ' 個物流單號；送出後可再選下一批' : '目前沒有可加入的正式物流單號');
  }

  function addFreightItemToWorkbench(id) {
    var item = freightItemById(id);
    if (!item) { toast('找不到這筆物流紀錄'); return; }
    if (item.batchId) { toast('這筆物流已綁定批次，如需更改請先編輯原批次'); return; }
    if (freightItemLeavesBatchSelection(item)) { toast(freightItemAwaitsInventoryReceipt(item) ? '這筆物流已建立產品且已到收貨據點，但尚未完成正式入庫；請從產品建檔完成入庫' : '這筆物流已建立正式進貨單並完成入庫，不需要再建立集運批次'); return; }
    if (!String(item.trackingNo || '').trim()) { toast('這筆仍是待物流資料，請先補正式物流單號再加入批次'); return; }
    if (!freightWorkbenchAcceptsItem(item, true)) return;
    selectedFreightItemIds.add(String(item.id || ''));
    syncFreightWorkbenchAccount(item);
    clearFreightWorkbenchSearchAfterSelection();
  }

  function clearFreightWorkbenchSearchAfterSelection() {
    var input = document.querySelector('[data-freight-workbench-search]');
    if (input) {
      input.value = '';
      input.removeAttribute('aria-invalid');
    }
    loadAdminFreightWorkbenchServerSearch('');
    input?.focus();
  }

  function offerContinueFreightExistingBatch(batch, matchedTrackingNo) {
    if (!batch || !batch.id) return false;
    var rows = freightBatchPackageRows(batch);
    var qty = rows.reduce(function (sum, item) { return sum + Math.max(1, Number(item.quantity || item.qty || 1)); }, 0);
    var examples = rows.slice(0, 4).map(function (item) {
      return item.productName || item.productCode || item.sampleBarcode || '未命名產品';
    }).filter(Boolean);
    var startedWarning = freightBatchStatusStage(batch.status) >= 3
      ? '\n\n注意：這批已開始點貨／驗收，繼續加入會增加本批待核對內容，請確認確實屬於同一批。'
      : '';
    var message = '這個物流單號' + (matchedTrackingNo ? '「' + matchedTrackingNo + '」' : '') + '已綁定在：\n\n' +
      freightBatchLabel(batch) + '\n' +
      '狀態：' + (batch.status || '-') + '\n' +
      '目前內容：' + freightWorkbenchPackageCount(rows) + ' 個物流單號／' + qty + ' 件' +
      (examples.length ? '\n產品：' + examples.join('、') + (rows.length > examples.length ? '…' : '') : '') +
      startedWarning + '\n\n要選定這個批次，繼續加入其他物流單號嗎？';
    if (!window.confirm(message)) {
      document.querySelector('[data-freight-workbench-search]')?.focus();
      return false;
    }
    var select = document.querySelector('[data-freight-bulk-batch]');
    if (!select) { toast('找不到既有批次選擇欄，請重新整理'); return false; }
    select.value = String(batch.id || '');
    var input = document.querySelector('[data-freight-workbench-search]');
    if (input) {
      input.value = '';
      input.removeAttribute('aria-invalid');
    }
    loadAdminFreightWorkbenchServerSearch('');
    renderFreightBatchWorkbench();
    document.querySelector('[data-freight-existing-batch-preview]')?.scrollIntoView({ behavior: 'smooth', block: 'center' });
    setTimeout(function () { input?.focus(); }, 220);
    toast('已選定批次「' + freightBatchLabel(batch) + '」；可繼續輸入下一個物流單號');
    return true;
  }

  function addFreightWorkbenchExact() {
    var input = document.querySelector('[data-freight-workbench-search]');
    var raw = String(input?.value || '').trim();
    if (freightWorkbenchShortTrackingQuery(raw)) { toast('物流單號或批號請至少輸入最後 4 碼'); input?.focus(); return; }
    var shortcutCode = freightShortProductCode(raw);
    var keyword = freightSearchKeyword(raw);
    if (!keyword) { toast('請先輸入平台訂單號、待物流碼、正式物流號或批號'); input?.focus(); return; }
    var freightRows = normalizeFreightTracking(state.freightTracking);
    var suffixKey = normalizeFreightIdentityNumber(raw);
    var suffixDigits = suffixKey.replace(/\D/g, '');
    var selectedMatches = freightWorkbenchSelectedItems().filter(function (item) {
      return freightWorkbenchQueryMatchesItem(item, raw);
    });
    if (selectedMatches.length === 1) {
      var linkedNumbers = freightWorkbenchTrackingNumbers([selectedMatches[0]]);
      focusFreightWorkbenchSplitGroup(selectedMatches[0]);
      toast('這個單號已在同一組拆包；目前共 ' + linkedNumbers.length + ' 組：' + linkedNumbers.join('、'));
      return;
    }
    var available = freightRows.items.filter(function (item) {
      return !item.batchId && !freightItemLeavesBatchSelection(item);
    });
    var exact = available.filter(function (item) {
      if (shortcutCode) return freightItemMatchesProductCode(item, shortcutCode);
      return freightWorkbenchExactIdentityMatch(item, keyword) || freightWorkbenchTrackingSuffixMatch(item, suffixKey);
    });
    var matches = exact.length ? exact : (suffixDigits.length >= 4
      ? available.filter(function (item) { return freightWorkbenchTrackingSuffixMatch(item, suffixKey); })
      : available.filter(function (item) { return searchMatchesParts(freightWorkbenchItemSearchText(item), keyword); }));
    if (!matches.length) {
      var batchNumberHits = suffixDigits.length >= 4 ? freightWorkbenchMatchingBatches(raw) : [];
      if (batchNumberHits.length === 1) {
        offerContinueFreightExistingBatch(batchNumberHits[0], raw);
        return;
      }
      if (batchNumberHits.length > 1) {
        renderFreightBatchWorkbench();
        toast('後碼對到 ' + batchNumberHits.length + ' 個既有批次，請按正確那一筆的「選定此批次」');
        input?.focus();
        return;
      }
      var matchedBatches = freightRows.batches.filter(function (batch) {
        return freightBatchPackageRows(batch).some(function (item) { return freightWorkbenchTrackingSuffixMatch(item, suffixKey); });
      });
      if (matchedBatches.length) {
        var matchedTrackingNos = [];
        matchedBatches.forEach(function (batch) {
          freightBatchPackageRows(batch).forEach(function (item) {
            if (!freightWorkbenchTrackingSuffixMatch(item, suffixKey)) return;
            var tracking = String(item.trackingNo || '').trim();
            if (tracking && matchedTrackingNos.indexOf(tracking) === -1) matchedTrackingNos.push(tracking);
          });
        });
        if (matchedBatches.length === 1 && matchedTrackingNos.length <= 1) {
          offerContinueFreightExistingBatch(matchedBatches[0], matchedTrackingNos[0] || '尾碼 ' + suffixDigits);
        } else {
          renderFreightBatchWorkbench();
          toast('後碼 ' + suffixDigits + ' 對到多筆已集運紀錄，請用完整單號確認：' + matchedTrackingNos.slice(0, 4).join('、'));
          input?.focus();
        }
        return;
      }
      var globalExact = freightRows.items.filter(function (item) {
        return freightWorkbenchExactIdentityMatch(item, keyword) || freightWorkbenchTrackingSuffixMatch(item, suffixKey);
      });
      var globalAvailable = globalExact.filter(function (item) { return !item.batchId && !freightItemLeavesBatchSelection(item); });
      if (globalAvailable.length) {
        var targetLines = globalAvailable.map(freightWorklineForItem).filter(function (mode, index, rows) { return rows.indexOf(mode) === index; });
        if (targetLines.length === 1 && targetLines[0] !== freightCurrentWorkline()) {
          var targetLine = targetLines[0];
          var targetLabel = freightWorklineMeta(targetLine).title;
          setFreightWorkline(targetLine);
          var switchedInput = document.querySelector('[data-freight-workbench-search]');
          if (switchedInput) switchedInput.value = raw;
          renderFreightBatchWorkbench();
          toast('這個單號在「' + targetLabel + '」，已替你切換工作列；現在可勾選加入本批');
          switchedInput?.focus();
          return;
        }
      }
      var batched = globalExact.find(function (item) { return !!item.batchId; });
      if (batched) {
        var existingBatch = freightBatchById(batched.batchId) || {};
        offerContinueFreightExistingBatch(existingBatch, batched.trackingNo || raw);
        return;
      }
      var stocked = globalExact.find(function (item) { return freightItemLeavesBatchSelection(item); });
      if (stocked) {
        renderFreightBatchWorkbench();
        if (freightItemFirstInboundPosted(stocked)) {
          openFreightSupplementalReceipt(String(stocked.id || ''), String(stocked.trackingNo || raw), 1);
          toast('這個單號已有正式入庫紀錄。同一單號若又拆到一包，可填這次實到件數；未到預報仍是未入庫');
        } else {
          openFreightReceivingWorkbench(String(stocked.id || ''), { fromArrival: true, prefillExpected: false });
          toast('這個單號尚未入庫／待驗收，不是已經進去。請走原單點貨');
        }
        return;
      }
      var selectedRows = freightWorkbenchSelectedItems();
      var looksLikeFullTracking = /^[A-Z0-9-]{8,}$/i.test(String(raw || '').replace(/\s+/g, '')) && /\d{4}/.test(raw);
      if (selectedRows.length === 1 && looksLikeFullTracking && focusFreightWorkbenchSplitGroup(selectedRows[0], raw)) {
        toast('已把新單號帶到上方同一組拆包；請確認這組件數，再按「儲存這組拆包並重算」');
        return;
      }
      renderFreightBatchWorkbench();
      if (input) input.setAttribute('aria-invalid', 'true');
      toast(globalExact.length ? '這個號碼已存在，但仍缺正式物流單號，請先到物流明細補上；本批原有勾選不會送出' : '三個物流工作列都找不到「' + raw + '」；本批原有勾選已暫停送出，請先確認這個單號是否真的存檔');
      return;
    }
    if (!exact.length && matches.length > 1) { renderFreightBatchWorkbench(); toast('找到多筆相似紀錄，請按正確那一筆的「加入本批」'); return; }
    var readyMatches = matches.filter(function (item) { return !!String(item.trackingNo || '').trim(); });
    if (!readyMatches.length) { renderFreightBatchWorkbench(); toast('找到待物流資料；請先補正式物流單號再加入批次'); return; }
    if (readyMatches.some(function (item) { return !freightWorkbenchAcceptsItem(item, true); })) return;
    if (readyMatches.length === 1) {
      var splitTarget = freightWorkbenchSplitTargetForItem(readyMatches[0]);
      if (splitTarget && addFreightWorkbenchItemAsSplit(readyMatches[0], splitTarget)) return;
    }
    readyMatches.forEach(function (item) { selectedFreightItemIds.add(String(item.id || '')); });
    if (readyMatches[0]) syncFreightWorkbenchAccount(readyMatches[0]);
    clearFreightWorkbenchSearchAfterSelection();
    toast('已加入 ' + readyMatches.length + ' 筆物流紀錄，可繼續掃描下一個單號');
  }

  function removeFreightTrackingFromWorkbench(trackingKey) {
