  function freightFifoParcelCodAmount(modal, row) {
    if (modal) {
      var values = freightFifoPaymentValues(modal);
      if (values) {
        if (values.storeIdCod) return Math.round(Number(values.storeIdCodAmount || 100));
        if (Number(values.codAmount || 0) > 0) return Math.round(Number(values.codAmount));
        // A remaining balance is not automatically COD. Account credit,
        // before-ship collection and later collection must leave the parcel
        // collection amount empty.
        if (values.mode) return 0;
        if (Number(values.balance || 0) > 0) return Math.round(Number(values.balance));
        if (Number(values.paid || 0) <= 0 && Number(values.total || 0) > 0) return Math.round(Number(values.total));
        return 0;
      }
    }
    row = row || {};
    var payment = row.paymentSummary || row.payment || {};
    var billing = typeof orderCustomerBilling === 'function' ? orderCustomerBilling(row) : {};
    var savedMode = String(payment.settlementMode || payment.mode || '');
    var savedStage = String(payment.balanceCollectionStage || '');
    if (Number(payment.codAmount || 0) > 0) return Math.round(Math.max(0, Number(payment.codAmount)));
    if (savedStage === 'cod' || savedMode === 'deposit_cod' || savedMode === 'cod_full') {
      return Math.round(Math.max(0, Number(payment.balance || payment.receivableBalance || billing.total || row.total || 0)));
