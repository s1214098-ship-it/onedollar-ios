  function preorderExistingFreightAllocatedQty(preorderId) {
    var wantedId = String(preorderId || '').trim();
    if (!wantedId) return 0;
    return freightTrackingForAllocation().items.reduce(function (total, item) {
      return total + (Array.isArray(item && item.customerLinks) ? item.customerLinks : []).reduce(function (sum, link) {
        var linkedId = String(link && (link.inquiryId || link.customerOrderNo) || '').trim();
        var linkStatus = String(link && link.status || '').toLowerCase();
        if (linkedId !== wantedId || /cancel|release|取消|解除/.test(linkStatus)) return sum;
        return sum + Math.max(0, Number(link && link.qty || 0));
      }, 0);
    }, 0);
  }

  function preorderExistingFreightAllocatedItemQty(preorderId, itemIndex) {
    var wantedId = String(preorderId || '').trim();
    var wantedIndex = Number(itemIndex);
    if (!wantedId || !Number.isInteger(wantedIndex)) return 0;
    if (freightFifoPlanningContext) {
      return Math.max(0, Number(freightFifoPlanningContext.itemAllocatedQty.get(wantedId + '|' + wantedIndex) || 0));
    }
    return freightTrackingForAllocation().items.reduce(function (total, freightItem) {
      return total + (Array.isArray(freightItem && freightItem.customerLinks) ? freightItem.customerLinks : []).reduce(function (sum, link) {
        var linkedId = String(link && (link.inquiryId || link.customerOrderNo) || '').trim();
        var linkedIndex = Number(link && link.itemIndex);
        var linkStatus = String(link && link.status || '').toLowerCase();
        if (linkedId !== wantedId || linkedIndex !== wantedIndex || /cancel|release|取消|解除/.test(linkStatus)) return sum;
        return sum + Math.max(0, Number(link && link.qty || 0));
      }, 0);
    }, 0);
  }

  function approvePreorderFreightAllocation(preorderId) {
    var row = (state.inquiries || []).find(function (item) { return String(item.id || '') === String(preorderId || ''); });
