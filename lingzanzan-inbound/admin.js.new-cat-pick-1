    var previousPaid = Math.max(0, Number(box.getAttribute('data-previous-paid') || 0));
    var current = Math.max(0, Number(currentInput.value || 0));
    var willBePaid = Math.min(total, previousPaid + current);
    var mode = String(modeInput.value || '');
    if (current > 0 && willBePaid < total && mode === 'id_sales_full') {
      modeInput.value = 'id_sales_partial';
      if (remainderInput) remainderInput.value = 'id_later';
      box._lastIndonesiaMode = '';
