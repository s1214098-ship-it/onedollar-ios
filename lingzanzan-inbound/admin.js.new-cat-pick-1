  function addFreightWorkbenchSplitPackage(itemId, control) {
    itemId = String(itemId || '').trim();
    var item = freightItemById(itemId);
    if (!item || !selectedFreightItemIds.has(itemId)) { toast('請先把這件商品加入本批，再追加拆包單號'); return; }
    if (item.batchId) { toast('這件商品已經在正式批次內；請先選定原批次再追加，避免成本重複'); return; }
    var editor = control && control.closest ? control.closest('[data-freight-workbench-split-editor]') : null;
    if (!editor) { toast('找不到拆包輸入區，請重新整理後再試'); return; }
    var trackingInput = editor.querySelector('[data-freight-workbench-split-tracking]');
    var qtyInput = editor.querySelector('[data-freight-workbench-split-qty]');
    var variantInput = editor.querySelector('[data-freight-workbench-split-variant]');
    var trackingNo = String(trackingInput && trackingInput.value || '').trim();
    var quantity = Math.max(1, Math.floor(Number(qtyInput && qtyInput.value || 1)));
    var variantIndex = Math.max(0, Math.floor(Number(variantInput && variantInput.value || 0)));
    if (!trackingNo) { toast('請先輸入這一組拆包單號'); trackingInput?.focus(); return; }
    var existingTrackingItem = freightItemByAnyTracking(trackingNo, item.id);
    if (existingTrackingItem && !freightItemCanAbsorbAsSplit(existingTrackingItem)) {
      toast('這個物流單號已經入庫或在其他正式批次，不能併入目前拆包：' + trackingNo);
      trackingInput?.focus();
      return;
    }
    var parcels = freightSplitPackages(item.splitPackages || []);
    if (!parcels.length && String(item.trackingNo || '').trim()) {
      parcels.push({
        id: 'parcel-original-' + String(item.id || Date.now()),
        trackingNo: String(item.trackingNo || '').trim(),
        quantity: Math.max(1, Number(item.quantity || item.qty || 1)),
        status: '待收貨',
        note: '原物流單號',
        variantAssignments: []
      });
    }
    if (parcels.some(function (parcel) { return freightTrackingComparable(parcel.trackingNo) === freightTrackingComparable(trackingNo); })) {
      toast('這組拆包單號已經存在：' + trackingNo);
      trackingInput?.focus();
      return;
    }
    var variantLines = Array.isArray(item.variants) ? item.variants.map(function (line) { return Object.assign({}, line); }) : [];
    if (variantLines.length && variantIndex >= variantLines.length) variantIndex = 0;
    parcels.push({
      id: 'parcel-batch-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6),
      trackingNo: trackingNo,
      quantity: quantity,
      status: '待收貨',
      note: '集運建批時追加',
      createdAt: new Date().toISOString(),
      variantAssignments: variantLines.length ? [{ variantIndex: variantIndex, quantity: quantity }] : []
    });
    var splitTotal = parcels.reduce(function (sum, parcel) { return sum + Math.max(1, Number(parcel.quantity || 1)); }, 0);
    var previousTotal = Math.max(1, Number(item.quantity || item.qty || 1));
    var nextTotal = Math.max(previousTotal, splitTotal);
    var addedToProduct = Math.max(0, nextTotal - previousTotal);
    if (addedToProduct > 0 && variantLines.length) {
      variantLines[variantIndex].quantity = Math.max(0, Number(variantLines[variantIndex].quantity || variantLines[variantIndex].qty || 0)) + addedToProduct;
      variantLines[variantIndex].qty = variantLines[variantIndex].quantity;
    }
    var trackingNumbers = [];
    parcels.forEach(function (parcel) {
      var value = String(parcel.trackingNo || '').trim();
      if (value && trackingNumbers.indexOf(value) === -1) trackingNumbers.push(value);
    });
    var next = Object.assign({}, item, {
      splitPackages: parcels,
      trackingNumbers: trackingNumbers,
      quantity: nextTotal,
      qty: nextTotal,
      splitQuantityTotal: splitTotal,
      splitQuantityExpected: nextTotal,
      splitQuantityMismatch: splitTotal !== nextTotal,
      updatedAt: new Date().toISOString()
    });
    if (variantLines.length) next.variants = variantLines;
    if (String(next.goodsPurpose || '') === 'internal_use') next.internalUseQty = nextTotal;
    else if (Object.prototype.hasOwnProperty.call(next, 'sellableQty')) next.sellableQty = Math.max(Number(next.sellableQty || 0), nextTotal - Math.max(0, Number(next.internalUseQty || 0)));
    var oldText = control.textContent;
    control.disabled = true;
    control.textContent = '正在儲存拆包…';
    saveFreightItemRecord(next, 'freight-workbench-split-' + itemId + '-' + Date.now()).then(function (saved) {
      selectedFreightItemIds.add(String(saved && saved.id || itemId));
      return absorbStandaloneFreightItemsIntoSplit(saved || next).then(function () {
        renderFreightBatchWorkbench();
        toast('已連動拆包單號 ' + trackingNo + '／' + quantity + ' 件；同商品全部單號已併在一起，商品共 ' + nextTotal + ' 件並會重算成本');
      });
    }).catch(function (error) {
      control.disabled = false;
      control.textContent = oldText;
      toast('拆包單號儲存失敗：' + (error.message || error));
    });
  }

  function freightWorkbenchPlatformOptions() {
    var select = document.querySelector('[data-freight-workbench-platform]');
    var filter = document.querySelector('[data-freight-account-filter]');
    if (!select && !filter) return;
