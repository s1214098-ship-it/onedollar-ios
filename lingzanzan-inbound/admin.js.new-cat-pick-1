  function productLocation(product, skus) {
    var firstSku = (skus || [])[0] || {};
    var skuWarehouses = [];
    var locatedSkus = (skus || []).filter(function (sku) {
      return Number(sku.stock || 0) > 0;
    });
    // Product cards describe where sellable stock is physically available.
    // Historical zero-stock SKU rows remain in data for audit/scanning, but
    // must not advertise an empty warehouse as a current product location.
    if (!locatedSkus.length) locatedSkus = skus || [];
    var shelves = [];
    locatedSkus.forEach(function (sku) {
      var values = asList(sku.shelves).length ? asList(sku.shelves) : (sku.shelf ? [sku.shelf] : []);
      values.forEach(function (value) {
        if (shelves.indexOf(value) === -1) shelves.push(value);
      });
    });
    if (!shelves.length) shelves = asList(product.shelves);
    if (!shelves.length && product.shelf) shelves = [product.shelf];
    var layers = [];
    locatedSkus.forEach(function (sku) {
      var values = asList(sku.layers).length ? asList(sku.layers) : (sku.layer ? [sku.layer] : []);
      values.forEach(function (value) {
        if (layers.indexOf(value) === -1) layers.push(value);
      });
    });
    if (!layers.length) layers = asList(product.layers);
    if (!layers.length && product.layer) layers = [product.layer];
    locatedSkus.forEach(function (sku) {
      var name = warehouseLabelForRecord(sku, warehouseCodeForRecord(product));
      if (skuWarehouses.indexOf(name) === -1) skuWarehouses.push(name);
    });
    return {
      warehouse: skuWarehouses.length ? skuWarehouses.join('、') : warehouseLabelForRecord(product, warehouseCodeForRecord(firstSku)),
      shelf: shelves.length ? shelves.join('、') : (state.shelves[0] || '未設定貨架'),
