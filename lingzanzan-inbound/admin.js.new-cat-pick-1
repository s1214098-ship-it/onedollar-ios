  function setFreightFifoManualPriority(button, enabled) {
    var attr = enabled ? 'data-freight-fifo-priority' : 'data-freight-fifo-priority-clear';
    var inquiryId = String(button && (button.getAttribute(attr) || button.getAttribute('data-freight-fifo-priority') || button.getAttribute('data-freight-fifo-priority-clear')) || '');
    if (!inquiryId) return;
    var row = (state.inquiries || []).find(function (item) { return String(item && item.id || '') === inquiryId; }) || {};
    var customer = row.customer || {};
    var customerName = customer.name || row.customerName || inquiryId;
    var itemIndexRaw = button && button.getAttribute('data-freight-fifo-item-index');
    var itemIndex = itemIndexRaw === null || itemIndexRaw === undefined || itemIndexRaw === '' ? null : Number(itemIndexRaw);
    var productCode = String(button && button.getAttribute('data-freight-fifo-item-code') || '').trim();
    if (!productCode && Number.isInteger(itemIndex) && row.items && row.items[itemIndex]) {
      productCode = String(row.items[itemIndex].code || row.items[itemIndex].productCode || row.items[itemIndex].sku || '').trim();
    }
    if (enabled && !Number.isInteger(itemIndex)) {
      var defaultTarget = freightFifoDefaultPriorityItemTarget(row);
      if (Number.isInteger(defaultTarget.itemIndex)) {
        itemIndex = defaultTarget.itemIndex;
        if (!productCode) productCode = defaultTarget.productCode;
      }
    }
    var start = function (reason) {
      reason = String(reason || '').trim();
      if (enabled && !reason) {
        toast('尚未插隊：必須填寫原因');
        return;
      }
      var originalText = button.textContent;
      button.disabled = true;
      button.setAttribute('aria-busy', 'true');
      button.textContent = enabled ? '正在調整順位…' : '正在恢復原順位…';
      var payload = {
        action: 'update-preorder-meta',
        inquiryId: inquiryId,
        manualQueuePriority: enabled,
        manualQueuePriorityReason: reason,
        allocateTaiwanStock: false,
        employeeName: currentLogin().name || currentLogin().account || '管理者'
      };
      if (enabled && Number.isInteger(itemIndex) && itemIndex >= 0) {
        payload.manualQueuePriorityItemIndex = itemIndex;
        payload.manualQueuePriorityProductCode = productCode;
      }
      callStockInquiryApi(payload).then(function (data) {
        var updated = data && data.inquiry ? data.inquiry : null;
        var rowIndex = (state.inquiries || []).findIndex(function (candidate) {
          return String(candidate && candidate.id || '') === inquiryId;
        });
        if (updated && rowIndex >= 0) state.inquiries[rowIndex] = updated;
        else if (rowIndex >= 0) {
          state.inquiries[rowIndex] = Object.assign({}, state.inquiries[rowIndex], {
            manualQueuePriority: enabled,
            manualQueuePriorityReason: reason,
            manualQueuePriorityAt: enabled ? new Date().toISOString() : '',
            manualQueuePriorityBy: currentLogin().name || currentLogin().account || '管理者',
            manualQueuePriorityItemIndex: enabled && Number.isInteger(itemIndex) ? itemIndex : null,
            manualQueuePriorityProductCode: enabled ? productCode : ''
          });
        }
        freightFifoBaseRowsCache = null;
        freightFifoTaiwanPlanCache = null;

        var sourceModal = button.closest ? button.closest('[data-freight-fifo-modal]') : null;
        var card = button.closest ? button.closest('.freight-fifo-customer-card') : null;
        var status = card && card.querySelector('[data-freight-fifo-action-status]');
        if (card) {
          card.classList.toggle('is-manual-priority', enabled);
          var oldBadge = card.querySelector('.freight-fifo-manual-priority');
          if (oldBadge) oldBadge.remove();
          if (enabled) {
            var header = card.querySelector('header');
            if (header) header.insertAdjacentHTML('afterend', '<aside class="freight-fifo-manual-priority"><b>管理者人工插隊｜目前第 1 順位</b><span>原因：' + escapeHtml(reason) + '</span></aside>');
            button.removeAttribute('data-freight-fifo-priority');
            button.setAttribute('data-freight-fifo-priority-clear', inquiryId);
            button.className = 'ghost-button freight-fifo-priority-button';
            button.textContent = '取消插隊／恢復原順位';
            if (card.parentNode) card.parentNode.insertBefore(card, card.parentNode.firstChild);
          } else {
            button.removeAttribute('data-freight-fifo-priority-clear');
            button.setAttribute('data-freight-fifo-priority', inquiryId);
            button.className = 'primary-button freight-fifo-priority-button';
            button.textContent = '人工插隊到第 1 順位';
            button.removeAttribute('title');
          }
          button.disabled = false;
          button.removeAttribute('aria-busy');
        }
        if (status) {
          status.className = 'freight-fifo-action-status is-success';
          status.textContent = enabled ? '插隊順位已儲存' : '已恢復原順位';
        }
        toast(enabled
          ? ('已把 ' + customerName + ' 插隊到第 1 順位'
            + (productCode ? '（' + productCode + '）' : '')
            + '；下一次到貨或現貨會先配這位客戶（尚未到貨不會立刻變可出貨）')
          : '已恢復 ' + customerName + ' 的原始下單順位');
        freightFifoOpenSections.add('waiting');
        renderFreightCustomerShipmentQueue();
        if (sourceModal) {
          reopenFreightFifoShipmentAfterItemChange(sourceModal, updated || row, null, '');
        }
        return false;
      }).catch(function (error) {
        button.disabled = false;
        button.removeAttribute('aria-busy');
        button.textContent = originalText;
        toast(error.message || '順位調整尚未儲存');
      });
    };
    if (enabled) {
      openFreightQueuePriorityReasonModal(customerName).then(function (reason) {
        if (reason) start(reason);
      });
      return;
    }
    openFreightQueuePriorityClearModal(customerName).then(function (confirmed) {
      if (confirmed) start('');
    });
  }

  function setFreightFifoCustomerQueueDecision(button, decision, cancellationConfirmed) {
    var attr = decision === 'deferred'
      ? 'data-freight-fifo-defer'
      : (decision === 'cancelled' ? 'data-freight-fifo-cancel' : 'data-freight-fifo-resume');
    var inquiryId = String(button && button.getAttribute(attr) || '');
    if (!inquiryId) return;
    var row = (state.inquiries || []).find(function (item) { return String(item && item.id || '') === inquiryId; }) || null;
    var order = resolveFreightFifoFormalOrder(row, null)
      || (state.orders || []).find(function (item) { return String(item && item.id || '') === inquiryId; })
      || null;
    var customer = (row && row.customer) || (order && order.customer) || {};
    var customerName = customer.name || (row && row.customerName) || (order && order.customerName) || inquiryId;
    if (decision === 'cancelled' && order && String(order.status || '').toLowerCase() !== 'cancelled') {
      openFreightFifoCancelOrder(String(order.id || inquiryId), button);
      return;
    }
    if (decision === 'cancelled' && row && preorderInquiryConverted(row) && !order) {
      toast('這張已轉正式出貨單，但找不到正式訂單。請重新整理後到「正式出貨核對」取消');
      return;
    }
    if (decision === 'cancelled' && (!row || String(row.status || '') === 'cancelled')) {
      if (row) {
        row.status = 'cancelled';
        row.freightCustomerQueueDecision = 'cancelled';
        row.freightShippingSelected = false;
      }
      freightFifoInvalidateQueueCaches();
      renderFreightCustomerShipmentQueue();
      toast('「' + customerName + '」已經取消，這張不會再出現在待配貨');
      return;
    }
    if (decision === 'cancelled' && !cancellationConfirmed) {
      var existingConfirmation = document.querySelector('[data-freight-queue-cancel-confirmation]');
      if (existingConfirmation) existingConfirmation.remove();
      var confirmation = document.createElement('div');
      confirmation.className = 'freight-formal-priority-modal';
      confirmation.setAttribute('data-freight-queue-cancel-confirmation', inquiryId);
      confirmation.innerHTML = '<section role="dialog" aria-modal="true" aria-label="確認取消這張預購需求"><header><div><h3>確認取消這張預購需求</h3><p>' + escapeHtml(customerName) + '／' + escapeHtml(inquiryId) + '</p></div></header><p>只取消這張訂單的需求並釋放其配貨，保留歷史紀錄；不取消同客戶其他訂單，也不加入黑名單。</p><footer><button type="button" class="ghost-button" data-queue-cancel-back>保留這張訂單</button><button type="button" class="danger-button" data-queue-cancel-yes>確認取消這張需求</button></footer></section>';
      document.body.appendChild(confirmation);
      confirmation.querySelector('[data-queue-cancel-back]').addEventListener('click', function () { confirmation.remove(); });
      confirmation.querySelector('[data-queue-cancel-yes]').addEventListener('click', function () {
        confirmation.remove();
        setFreightFifoCustomerQueueDecision(button, decision, true);
      });
      return;
    }
    if (decision === 'deferred' && !window.confirm('確定讓「' + customerName + '」先等嗎？本批配貨會釋放給下一位，但會保留原始下單時間，之後可恢復原順位。')) return;
    var originalText = button.textContent;
    var previousStatus = row ? String(row.status || '') : '';
    var previousDecision = row ? String(row.freightCustomerQueueDecision || '') : '';
    var card = button.closest ? button.closest('.freight-fifo-customer-card') : null;
    var status = card && card.querySelector('[data-freight-fifo-action-status]');
    button.disabled = true;
    button.setAttribute('aria-busy', 'true');
    button.textContent = decision === 'active' ? '正在恢復原順位…' : '正在釋放並補下一位…';
    if (status) {
      status.className = 'freight-fifo-action-status is-working';
      status.textContent = decision === 'active' ? '正在恢復，原始下單時間不變…' : '正在同步客戶、物流配貨與下一順位…';
    }
    if (decision === 'cancelled' && row) {
      row.status = 'cancelled';
      row.freightCustomerQueueDecision = 'cancelled';
      row.freightShippingSelected = false;
      freightFifoMergeSelectedInquiryIds.delete(inquiryId);
      freightFifoInvalidateQueueCaches();
      renderFreightCustomerShipmentQueue();
    }
    callStockInquiryApi({
      action: 'freight-customer-queue-decision',
      inquiryId: inquiryId,
      decision: decision,
      employeeName: currentLogin().name || currentLogin().account || '管理者'
    }).then(function (result) {
      var inquiry = (state.inquiries || []).find(function (item) { return String(item && item.id || '') === inquiryId; });
      if (inquiry) {
        inquiry.freightCustomerQueueDecision = decision;
        inquiry.freightShippingSelected = false;
        inquiry.plannedShipmentMergeGroupId = '';
        inquiry.plannedShipmentMasterInquiryId = '';
        inquiry.plannedShipmentMergedInquiryIds = [];
        if (decision === 'cancelled') {
          inquiry.status = 'cancelled';
          inquiry.manualQueuePriority = false;
        }
      }
      freightFifoMergeSelectedInquiryIds.delete(inquiryId);
      freightFifoInvalidateQueueCaches();
      renderFreightCustomerShipmentQueue();
      if (decision === 'active') {
        toast('已恢復「' + customerName + '」原始下單順位；下一批到貨會依原時間配貨');
        return result;
      }
      toast((decision === 'cancelled' ? '客戶已取消' : '客戶已設為先等') + '，正在依順位補給下一位');
      return freightFifoRematchReleasedFreightItems(result);
    }).then(function (result) {
      if (!result || decision === 'active') return;
