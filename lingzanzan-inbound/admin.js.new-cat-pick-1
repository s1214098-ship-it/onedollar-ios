    var selected = freightWorkbenchSelectedItems();
    var validIds = new Set(selected.map(function (item) { return String(item.id || ''); }));
    Array.from(selectedFreightItemIds).forEach(function (id) { if (!validIds.has(id)) selectedFreightItemIds.delete(id); });
    Array.from(freightWorkbenchInternalItemIds).forEach(function(id) { if (!selectedFreightItemIds.has(id)) freightWorkbenchInternalItemIds.delete(id); });
