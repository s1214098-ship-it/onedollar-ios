  function setPurchaseStatsError(message) {
    var root = purchaseStatsRoot();
    if (!root) return;
    root.dataset.purchaseStatsState = 'error';
    root.setAttribute('aria-busy', 'false');
    root.querySelectorAll('[data-purchase-record-group], [data-purchase-cancel-id], [data-purchase-record-qty]').forEach(function (control) {
      control.disabled = true;
    });
    root.querySelectorAll('[data-purchase-load-error]').forEach(function (node) { node.remove(); });
    var error = document.createElement('div');
    error.className = 'purchase-stats-load-error';
    error.setAttribute('data-purchase-load-error', '');
