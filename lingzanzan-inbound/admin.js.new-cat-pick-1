      try { renderAdminShipmentReplyInbox(); } catch (error) { console.warn('shipment reply inbox failed', error); }
    };
    if (orderTrackingSecondaryTimer) {
      if (window.cancelIdleCallback) {
        try { window.cancelIdleCallback(orderTrackingSecondaryTimer); } catch (error) {}
      }
      window.clearTimeout(orderTrackingSecondaryTimer);
      orderTrackingSecondaryTimer = 0;
    }
    if (window.requestIdleCallback) {
      orderTrackingSecondaryTimer = window.requestIdleCallback(run, { timeout: 1200 });
