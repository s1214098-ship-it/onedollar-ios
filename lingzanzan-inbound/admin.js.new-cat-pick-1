        : '已選寶輝關稅 ' + (cost.customsNo || '-') + '／台灣單號 ' + (cost.taiwanTrackingNo || '-') + '；實收＝關稅 NT$' + Number(cost.dutyTwd || 0).toLocaleString() + '＋滯報 NT$' + Number(cost.lateFeeTwd || 0).toLocaleString() + '＋' + Number(cost.count || 0).toLocaleString() + ' 件×30＝NT$' + Number(cost.allocationTotalTwd || 0).toLocaleString() + '；每件 NT$' + Number(cost.perItemTwd || 0).toLocaleString() + '（每件產品，不是每筆單號）。';
