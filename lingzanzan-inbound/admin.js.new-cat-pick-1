  // 本機250：訂單卡與複製給客戶的明細共用同一組金額算法。
  function orderCustomerBilling(order) {
    order = order || {};
    var items = Array.isArray(order.items) ? order.items : [];
    var hasLinePricing = items.some(function (item) {
      return item && (item.price !== undefined && item.price !== null || item.salePrice !== undefined && item.salePrice !== null);
    });
    var calculatedSubtotal = items.reduce(function (sum, item) {
      var price = item && item.price !== undefined && item.price !== null ? item.price : item && item.salePrice;
      var qty = item && item.qty !== undefined && item.qty !== null ? item.qty : item && item.quantity;
      return sum + Math.max(0, Number(price || 0)) * Math.max(0, Number(qty || 0));
    }, 0);
    var subtotal = hasLinePricing
      ? calculatedSubtotal
      : Math.max(0, Number(order.subtotal || 0));
    var customer = order.customer || {};
    var shippingFee = Math.max(0, Number(order.shippingFee !== undefined && order.shippingFee !== null
      ? order.shippingFee
      : customer.shippingFee || 0));
    var total = hasLinePricing
      ? subtotal + shippingFee
      : Math.max(0, Number(order.total !== undefined && order.total !== null ? order.total : subtotal + shippingFee));
    return { subtotal: subtotal, shippingFee: shippingFee, total: total };
  }

