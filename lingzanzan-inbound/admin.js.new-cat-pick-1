      var sameProduct = !product || String(row && row.productId || '') === String(product.id || '');
      var sameColor = !wantedColor || freightDemandIdentity(row && (row.colorName || row.color) || '') === wantedColor;
      return sameProduct && sameColor && (sameSku || sameBarcode);
    }) || (state.skus || []).find(function (row) {
      return product && String(row && row.productId || '') === String(product.id || '')
        && wantedColor
        && freightDemandIdentity(row && (row.colorName || row.color) || '') === wantedColor;
    }) || null;
    if (sku) {
      var skuColorImage = String(sku.colorImage || sku.image || sku.imageUrl || sku.photo || '').trim();
      if (skuColorImage) images.push(skuColorImage);
    }
    var matchedFreightColorKey = Object.keys(colorImages).find(function (key) {
      return wantedColor && freightDemandIdentity(key) === wantedColor;
    });
    if (matchedFreightColorKey) images.push(colorImages[matchedFreightColorKey]);
    if (product) {
      (product.colors || []).forEach(function (row) {
        if (row && row.image && (!wantedColor || freightDemandIdentity(row.name || row.color) === wantedColor)) images.push(row.image);
      });
    }
    if (line && line.colorImage) images.push(line.colorImage);
    if (line && line.image) images.push(line.image);
    normalizeFreightProductImages(item && (item.productImages || item.images) || []).forEach(function (src) { images.push(src); });
    if (product) {
