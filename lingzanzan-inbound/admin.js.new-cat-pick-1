      return false;
    }).then(function (value) {
      orderTrackingInquiryDataRequest = null;
      document.body.removeAttribute('data-order-tracking-inquiries-loading');
      return value;
    }, function (error) {
      orderTrackingInquiryDataRequest = null;
      document.body.removeAttribute('data-order-tracking-inquiries-loading');
