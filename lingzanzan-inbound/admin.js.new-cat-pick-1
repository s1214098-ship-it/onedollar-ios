    // acknowledging it, the 10-second poll mistakes our own save for a remote
    // edit and reloads the complete freight dataset (about 24 MB).
    adminLastEditAt = Date.now();
    adminAutoSyncQueued = false;
    adminOwnSaveRevisionPending = true;
    return loadAdminRealtimeRevision().then(function (revision) {
      if (revision) adminLastServerRevision = revision;
      document.body.setAttribute('data-realtime-sync', 'ready');
      return revision;
    }).catch(function () { return ''; });
  }

  function scheduleAdminPostSaveRefresh(reason, delayMs) {
    adminPostSaveRefreshReason = String(reason || adminPostSaveRefreshReason || 'save');
    window.clearTimeout(adminPostSaveRefreshTimer);
    adminPostSaveRefreshTimer = window.setTimeout(runAdminPostSaveRefresh, Math.max(250, Number(delayMs || 900)));
  }

  function adminEditorHasActiveInput() {
    var active = document.activeElement;
    return !!(active && active !== document.body && active.matches && active.matches('input, textarea, select, [contenteditable="true"]') && !adminIsQueryControl(active));
  }

  function adminIsQueryControl(target) {
    if (!target || !target.matches) return false;
    if (target.matches('input[type="search"]')) return true;
    var names = Array.prototype.map.call(target.attributes || [], function (attribute) {
      return String(attribute && attribute.name || '');
    }).join(' ');
    return /(?:^|\s)data-[^\s]*(?:search|filter|query)(?:\s|$)/.test(names);
  }

  function runAdminPostSaveRefresh() {
    adminPostSaveRefreshTimer = 0;
    if (document.hidden) {
      document.body.setAttribute('data-realtime-sync', 'paused-hidden');
      return Promise.resolve(false);
    }
    if (adminEditorHasActiveInput()) {
      scheduleAdminPostSaveRefresh(adminPostSaveRefreshReason, 1200);
      return Promise.resolve(false);
    }
    var fileName = adminCurrentFileName();
    var reason = adminPostSaveRefreshReason || 'save';
    adminPostSaveRefreshReason = '';
    document.body.setAttribute('data-realtime-sync', 'syncing-local');
    document.body.setAttribute('data-realtime-save-reason', reason);
    var task;
    if (fileName === 'admin-orders.html') {
      task = document.body.getAttribute('data-admin-orders-search-source') === 'server'
        ? loadAdminOrdersFromServerSearch((document.querySelector('[data-order-search]') || {}).value || '').then(function () {
          renderAdminShipmentLines();
          ensureAdminShipmentPanel();
          return true;
        })
        : adminOrdersDeferredDataLoaded
        ? refreshOrdersAndInquiries().then(function () {
          renderAdminShipmentLines();
          ensureAdminShipmentPanel();
          return true;
        })
        : Promise.resolve(renderCurrentAdminWorkline());
    } else if (fileName === 'admin-preorders.html' || fileName === 'admin-live.html') {
      task = (fileName === 'admin-preorders.html' && adminPreorderServerSearchActive)
        ? refreshAdminPreorderServerSearch().then(function () { return true; })
        : (!adminUsesLazyPreorderHistory() || adminPreorderHistoryDataLoaded)
        ? refreshOrdersAndInquiries().then(function () {
          renderCurrentAdminWorkline();
          return true;
        })
        : Promise.resolve(renderCurrentAdminWorkline()).then(function () { return true; });
    } else if (fileName === 'admin-order-tracking.html') {
      // A preorder delete must re-read the authoritative list. Otherwise an
      // older in-flight list response can leave the removed card on screen.
      task = (reason === 'stock-inquiry-save'
        ? loadOrderTrackingInquiriesOnDemand(true)
        : Promise.resolve()
      ).then(function () {
        renderOrderTrackingDashboard();
        return true;
      });
    } else if (fileName === 'admin-freight.html') {
      task = loadFreightTracking(true).then(function () {
        renderCurrentAdminWorkline();
        return true;
      });
    } else {
      task = Promise.resolve(renderCurrentAdminWorkline());
    }
    return task.then(function (updated) {
      document.body.setAttribute('data-admin-last-sync', new Date().toISOString());
      document.body.setAttribute('data-realtime-sync', 'ready');
      return loadAdminRealtimeRevision().then(function (revision) {
        if (revision) adminLastServerRevision = revision;
        adminOwnSaveRevisionPending = false;
        adminAutoSyncQueued = false;
        return updated;
      }).catch(function () { return updated; });
    }).catch(function () {
      document.body.setAttribute('data-realtime-sync', 'offline');
      return false;
    });
  }

  function refreshAdminDataFromServer(silent, force) {
    if (adminAutoSyncBusy || (!force && !isAdminAutoSyncSafe())) return Promise.resolve(false);
    adminAutoSyncBusy = true;
    var syncFileName = location.pathname.split('/').pop() || '';
    if (adminUsesDemandOrderEntryData()) {
      adminAutoSyncBusy = false;
      document.body.setAttribute('data-realtime-sync', 'demand');
      return Promise.resolve(false);
    }
    if (syncFileName === 'admin-orders.html' && !adminOrdersDeferredDataLoaded) {
      adminAutoSyncBusy = false;
      return Promise.resolve(false);
    }
    if (syncFileName === 'admin-order-tracking.html') {
      return loadServerState({ lightweight: true }).then(function (serverFiles) {
        return loadAdminDataFiles(serverFiles, { ordersCriticalOnly: true, forceReload: true });
      }).then(function (items) {
        var loadedOrders = normalizeOrderRows(items && items[2]);
        if (loadedOrders.length) state.orders = loadedOrders;
        orderTrackingAwaitingOrders = false;
        return orderTrackingAwaitingInquiries
          ? Promise.resolve(false)
          : loadOrderTrackingInquiriesOnDemand(true);
      }).then(function () {
        renderOrderTrackingDashboard();
        document.body.setAttribute('data-admin-last-sync', new Date().toISOString());
        document.body.setAttribute('data-realtime-sync', 'ready');
        adminAutoSyncBusy = false;
        return true;
      }).catch(function () {
        adminAutoSyncBusy = false;
        document.body.setAttribute('data-realtime-sync', 'offline');
        return false;
      });
    }
    var freightSyncPage = syncFileName === 'admin-freight.html' || !!document.querySelector('[data-freight-tracking-panel]');
    var orderSyncPage = ['admin-orders.html', 'admin-preorders.html', 'admin-purchase.html', 'admin-preorder-waiting.html', 'admin-order-tracking.html', 'admin-logistics.html'].indexOf(syncFileName) > -1;
    var freightTrackingSyncPage = adminNeedsFreightTrackingData();
    return loadServerState({ overview: overviewPage, lightweight: !overviewPage }).then(function (serverFiles) {
      return loadAdminDataFiles(serverFiles, { reuseLoadedCatalog: freightSyncPage || syncFileName === 'admin-preorders.html', forceReload: true });
    }).then(function (items) {
      savedLocalSnapshot = {};
      applyAdminDataItems(items);
      importCustomersToMembersIfNeeded();
      var isFastPreorderEntry = (location.pathname.split('/').pop() || '') === 'admin-preorders.html';
      var shouldRunRealtimeAllocation = currentLogin().role === 'admin' && !isFastPreorderEntry;
      var inquiryRefresh = shouldRunRealtimeAllocation && !needsInquiryData
        ? loadStockInquiries().then(function (rows) { state.inquiries = Array.isArray(rows) ? rows : []; })
        : Promise.resolve();
      var freightRefresh = freightTrackingSyncPage
        ? inquiryRefresh.then(function () { return loadFreightTracking(shouldRunRealtimeAllocation); })
        : inquiryRefresh;
      return freightRefresh.then(function () {
        if (freightSyncPage) {
          // loadFreightTracking already repaints the freight workbench. Avoid
          // rebuilding products, people, inventory and every order card again.
          renderAdminPage();
          renderLoginIdentity();
        } else if (orderSyncPage) {
          // Order pages need current order cards, not an application-wide
          // repaint of unrelated inventory, staff and freight form controls.
          orderTrackingAwaitingOrders = false;
          orderTrackingAwaitingInquiries = false;
          renderOrders();
          renderOrderTrackingDashboard();
          renderAdminPage();
          ensureAdminShipmentPanel();
        } else {
          renderAll();
          renderProductCreate();
        }
        document.body.setAttribute('data-admin-last-sync', new Date().toISOString());
        document.body.setAttribute('data-realtime-sync', 'ready');
        try {
          window.dispatchEvent(new CustomEvent('lingzanzan:admin-realtime-updated', {
            detail: { at: new Date().toISOString(), page: syncFileName }
          }));
        } catch (error) {}
        return reconcilePreordersAfterRealtimeSync().then(function () { return true; });
      });
    }).catch(function () {
      if (!silent) toast('後台同步失敗，請稍後再試');
      return false;
    }).then(function (result) {
      adminAutoSyncBusy = false;
      return result;
    });
