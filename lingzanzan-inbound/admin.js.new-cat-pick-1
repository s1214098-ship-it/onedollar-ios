  function freightFifoPrintSourceRows(row) {
    if (row && row.freightFifoPlannedMergeDisplay && Array.isArray(row.freightFifoPlannedMergeRows) && row.freightFifoPlannedMergeRows.length) {
      return row.freightFifoPlannedMergeRows;
    }
    if (row && row.freightFifoMergedDisplay && Array.isArray(row.freightFifoMergedOrderIds) && row.freightFifoMergedOrderIds.length) {
      var idx = freightFifoIndexes();
      var sources = row.freightFifoMergedOrderIds.map(function (id) {
        return idx.orderById.get(String(id || '')) || null;
      }).filter(Boolean);
      if (sources.length) return sources;
    }
    return row ? [row] : [];
  }

  function freightFifoPrintCollectItems(row) {
    var items = [];
    freightFifoPrintSourceRows(row).forEach(function (source) {
      (Array.isArray(source && source.items) ? source.items : []).forEach(function (item) {
        items.push({ item: item || {}, orderId: String((source && source.id) || (row && row.id) || '') });
      });
    });
    return items;
  }

  function freightFifoPrintBilling(row) {
    var sources = freightFifoPrintSourceRows(row);
    if (sources.length <= 1) return orderCustomerBilling(row || {});
    var subtotal = 0;
    sources.forEach(function (source) {
      subtotal += orderCustomerBilling(source).subtotal;
    });
    var shippingFee = orderCustomerBilling(row || sources[0] || {}).shippingFee;
    if (row && (row.freightFifoPlannedMergeDisplay || row.freightFifoMergedDisplay)) {
      shippingFee = orderCustomerBilling(row).shippingFee;
    }
    return { subtotal: subtotal, shippingFee: shippingFee, total: subtotal + shippingFee };
