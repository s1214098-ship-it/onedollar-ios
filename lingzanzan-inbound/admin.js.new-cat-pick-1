  function adminFreightSearchQueryIsShort(value) {
    var raw = String(value || '').trim();
    if (!raw) return false;
    var digits = raw.replace(/\D/g, '');
    var trackingLike = /^[0-9\s()+-]+$/.test(raw);
    return trackingLike ? digits.length < 4 : raw.length < 2;
  }

  function loadAdminFreightFromServerSearch(value) {
    if (adminCurrentFileName() !== 'admin-freight.html') return Promise.resolve(false);
    var query = String(value || '').trim();
    if (!query) {
      adminFreightServerSearchSequence += 1;
      if (adminFreightServerSearchController) adminFreightServerSearchController.abort();
      adminFreightServerSearchController = null;
      adminFreightServerSearchActive = false;
      if (adminFreightServerBaseData) state.freightTracking = adminFreightServerBaseData;
      resetFreightPagination();
      renderFreightTracking();
      return Promise.resolve(true);
    }
    if (adminFreightSearchQueryIsShort(query)) {
      if (adminFreightServerSearchController) adminFreightServerSearchController.abort();
      adminFreightServerSearchStatus(/^[0-9\s()+-]+$/.test(query) ? '物流單號或批號請至少輸入最後 4 碼。' : '產品、客戶或批次資料請至少輸入 2 個字。', 'short-query');
      return Promise.resolve(false);
    }
    if (!adminFreightServerBaseData && !adminFreightServerSearchActive) adminFreightServerBaseData = state.freightTracking;
    adminFreightServerSearchSequence += 1;
    var sequence = adminFreightServerSearchSequence;
    if (adminFreightServerSearchController) adminFreightServerSearchController.abort();
    var controller = typeof AbortController === 'function' ? new AbortController() : null;
    adminFreightServerSearchController = controller;
    adminFreightServerSearchStatus('正在伺服器搜尋「' + query + '」…', 'loading');
    return fetch('./admin-freight-search-api.php?q=' + encodeURIComponent(query) + '&scope=list&limit=' + FREIGHT_PAGE_SIZE + '&_=' + Date.now(), {
      cache: 'no-store',
      credentials: 'same-origin',
      signal: controller ? controller.signal : undefined
    }).then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (data) {
        if (!res.ok || !data.ok) throw new Error(data.error || ('物流搜尋失敗 ' + res.status));
        return data;
      });
    }).then(function (data) {
      if (sequence !== adminFreightServerSearchSequence) return false;
      adminFreightServerSearchActive = true;
      adminFreightServerSearchItemTotal = Math.max(0, Number(data.itemCount || 0));
      adminFreightServerSearchBatchTotal = Math.max(0, Number(data.batchCount || 0));
      adminFreightServerSearchMs = Math.max(0, Number(data.serverMs || 0));
      var freightExtraSource = adminFreightServerBaseData || state.freightTracking || {};
      state.freightTracking = normalizeFreightTracking({
        schemaVersion: 2,
        revision: Math.max(0, Number(data.revision || 0)),
        updatedAt: data.updatedAt || '',
        items: Array.isArray(data.items) ? data.items : [],
        batches: Array.isArray(data.batches) ? data.batches : [],
        // Server search only replaces item/batch results. These operator records
        // belong to the page itself and must never disappear while searching.
        checkpoints: Array.isArray(freightExtraSource.checkpoints) ? freightExtraSource.checkpoints : [],
        damages: Array.isArray(freightExtraSource.damages) ? freightExtraSource.damages : [],
        haohongPackageWeights: Array.isArray(freightExtraSource.haohongPackageWeights) ? freightExtraSource.haohongPackageWeights : [],
        importMeta: freightExtraSource.importMeta && typeof freightExtraSource.importMeta === 'object' ? freightExtraSource.importMeta : {}
      });
      resetFreightPagination();
      renderFreightTracking();
