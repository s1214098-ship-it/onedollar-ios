    localStorage.setItem(QUICK_STOCKIN_WAREHOUSE_KEY, warehouse);
    filesToDataUrls(imageInput && imageInput.files ? imageInput.files : []).then(function (images) {
      var image = images[0] || quickStockInLastImage || '';
      var data = quickStockInPreviewData(scan, qty, warehouse);
      loadQuickStockInBatch();
      var item = {
        scan: scan,
        qty: qty,
        warehouse: warehouse,
        image: image,
        productCode: (data.product && (data.product.code || data.product.id)) || data.parsed.productCode || quickStockInProductCodeFromScan(scan),
        colorName: data.parsed.colorName || '待補顏色',
        sizeName: data.parsed.sizeName || 'NO SIZE',
        cost: data.parsed.cost || 0,
        matched: !!data.product,
        createdAt: new Date().toISOString()
      };
      var key = quickStockInBatchKey(item);
      var existing = quickStockInBatch.find(function (row) { return quickStockInBatchKey(row) === key; });
      if (existing) {
        existing.qty = Number(existing.qty || 0) + qty;
        existing.image = existing.image || image;
