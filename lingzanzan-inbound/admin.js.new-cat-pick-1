  }

  function preorderItemSupplySnapshot(row, item) {
    var itemIdentities = preorderOfficialProductIdentities(
      [item && (item.code || item.productCode)],
      [item && item.sku, item && item.skuId, item && item.productId, item && item.barcode]
    );
    var readyQty = preorderItemReadyStockQty(item);
    var forecastQty = 0;
    var linkedQty = 0;
    normalizeFreightTracking(state.freightTracking).items.forEach(function (freightItem) {
      if (freightItemClosesBatchQueueWithoutSelectionCheck(freightItem)) return;
      var matchedItem = false;
      freightVariantLines(freightItem).forEach(function (line) {
        var freightIdentities = preorderOfficialProductIdentities(
          [line.productCode, line.catalogProductCode, freightItem.productCode, freightItem.catalogProductCode],
          [line.productId, line.sampleBarcode, line.taiwanBarcode, freightItem.productId]
        );
        var identityMatch = Array.from(itemIdentities).some(function (identity) { return freightIdentities.has(identity); });
        if (!identityMatch || !preorderSupplyVariantMatches(item, line.color, line.size, line.productCode || line.catalogProductCode || line.sampleBarcode || freightItem.productCode)) return;
