      // 去計算此處完全不使用的 forecastQty／linkedQty。
      var readyStockQty = preorderItemReadyStockQty(item);
      if (!groups[key]) {
        groups[key] = {
          code: code,
          color: color,
          size: size,
          identities: identities,
          orderDemandQty: 0,
          freightAllocatedQty: 0,
          demandQty: 0,
          stockQty: Math.max(0, Number(readyStockQty || 0)),
          earlierCustomerQty: 0,
          earlierCustomers: [],
          availableQty: Math.max(0, Number(readyStockQty || 0))
