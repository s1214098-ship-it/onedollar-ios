  function isSameLocalDay(value, base) {
    if (!value) return false;
    var date = new Date(value);
    if (Number.isNaN(date.getTime())) {
      var clean = String(value).replace(/\//g, '-').slice(0, 10);
      var today = [
        base.getFullYear(),
        String(base.getMonth() + 1).padStart(2, '0'),
        String(base.getDate()).padStart(2, '0')
      ].join('-');
      return clean === today;
    }
    return date.getFullYear() === base.getFullYear() &&
      date.getMonth() === base.getMonth() &&
      date.getDate() === base.getDate();
  }

  function isOverviewPendingOrder(order) {
    order = order || {};
    var status = [order.status, order.orderStatus, order.deliveryState, order.fulfillmentStatus].join(' ').toLowerCase();
    var label = [order.statusLabel, order.deliveryStatus, order.logisticsStatus, order.fulfillmentStatusLabel].join(' ');
    if (/deleted|archived|removed|cancelled|canceled|returned|completed|delivered|refunded|closed/.test(status)) return false;
    if (/已完成|已送達|完成配送|已取消|退回|退貨|已退款|已關閉/.test(label)) return false;
    return true;
  }

  /* An order becomes overdue only after 12 complete Taipei calendar days. */
  function taipeiCalendarKey(value) {
    if (!value) return '';
    var text = String(value).trim();
    var localMatch = text.match(/^(\d{4})[-\/]([0-9]{1,2})[-\/]([0-9]{1,2})(?:$|[ T](?!.*(?:Z|[+-]\d\d:?\d\d)$))/);
    if (localMatch) return [localMatch[1], String(Number(localMatch[2])).padStart(2, '0'), String(Number(localMatch[3])).padStart(2, '0')].join('-');
    var date = value instanceof Date ? value : new Date(value);
    if (Number.isNaN(date.getTime())) return '';
    try {
      var parts = new Intl.DateTimeFormat('en-CA', { timeZone: 'Asia/Taipei', year: 'numeric', month: '2-digit', day: '2-digit' }).formatToParts(date);
      var map = {};
      parts.forEach(function (part) { map[part.type] = part.value; });
      return [map.year, map.month, map.day].join('-');
    } catch (error) {
      return [date.getFullYear(), String(date.getMonth() + 1).padStart(2, '0'), String(date.getDate()).padStart(2, '0')].join('-');
    }
  }

  function taipeiCalendarSerial(value) {
    var key = /^\d{4}-\d{2}-\d{2}$/.test(String(value || '')) ? String(value) : taipeiCalendarKey(value);
    if (!key) return NaN;
    var parts = key.split('-').map(Number);
    return Math.floor(Date.UTC(parts[0], parts[1] - 1, parts[2]) / 86400000);
  }

  function orderAgeDays(order, now) {
    var raw = adminDateValue(order) || order.createdAt || order.orderDate || order.date || '';
    var createdDay = taipeiCalendarSerial(raw);
    var currentDay = taipeiCalendarSerial(now || new Date());
    if (!Number.isFinite(createdDay) || !Number.isFinite(currentDay)) return 0;
    return Math.max(0, currentDay - createdDay);
  }

  function isOverdueUnshippedOrder(order, now) {
    var status = [order && order.status, order && order.orderStatus, order && order.deliveryState, order && order.fulfillmentStatus].join(' ').toLowerCase();
    if (!isOverviewPendingOrder(order)) return false;
    if (/shipped|in_transit|delivered|completed|returned|cancelled|canceled/.test(status)) return false;
    return orderAgeDays(order, now || new Date()) > ORDER_OVERDUE_DAYS;
  }

