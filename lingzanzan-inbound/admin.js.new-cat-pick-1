  function freightReceivedOtherWarehouseStockModel(data, receipt) {
    var inventory = data && data.inventory || {};
    var currentCode = freightReceivedCurrentWarehouseCode(inventory);
    var product = freightReceivedProductFromData(data, receipt);
    var empty = { currentCode: currentCode, product: product, warehouses: freightReceivedOtherWarehouseCodes(currentCode).map(function (code) {
      return { code: code, name: warehouseLabel(code), total: 0, rows: [] };
    }) };
    if (!product) return empty;
    var allSkus = freightReceivedProductSkus(product);
    var variantMap = {};
    function rememberVariant(color, size) {
      var colorRaw = String(color || '').trim() || '未選顏色';
      var sizeText = labelSizeText(size || 'NO SIZE');
      var colorHead = colorRaw.split(/\s*\/\s*/)[0].replace(/[()（）].*$/, '').trim() || colorRaw;
      var colorKey = freightAllocationColorKey(colorHead) || freightAllocationColorKey(colorRaw) || colorHead;
      var key = colorKey + '|' + freightDemandIdentity(sizeText);
      if (!variantMap[key]) {
        variantMap[key] = {
          key: key,
          color: labelColorText(colorRaw),
          size: sizeText,
          colorRaw: colorRaw
        };
      }
    }
    allSkus.forEach(function (sku) {
      var wh = warehouseCodeForRecord(sku, warehouseCodeForRecord(product));
      if (wh === 'PREORDER') return;
      rememberVariant(sku.colorName || sku.color || '', sku.sizeName || sku.size || 'NO SIZE');
    });
    var receiptLines = Array.isArray(receipt && receipt.lines) ? receipt.lines : (Array.isArray(inventory.lines) ? inventory.lines : []);
    receiptLines.forEach(function (line) {
      rememberVariant(line && (line.color || line.colorName) || '', line && (line.size || line.sizeName) || 'NO SIZE');
    });
    (freightReceivedPrintPayloads || []).forEach(function (payload) {
      rememberVariant(payload && payload.color || '', payload && payload.size || 'NO SIZE');
    });
    var variants = Object.keys(variantMap).map(function (key) { return variantMap[key]; }).sort(function (a, b) {
      var colorCmp = String(a.color || '').localeCompare(String(b.color || ''), 'zh-Hant');
      if (colorCmp) return colorCmp;
      return freightReceivedSizeRank(a.size) - freightReceivedSizeRank(b.size)
        || String(a.size || '').localeCompare(String(b.size || ''), 'zh-Hant', { numeric: true });
    });
    if (!variants.length) return empty;
    return {
      currentCode: currentCode,
      product: product,
      warehouses: freightReceivedOtherWarehouseCodes(currentCode).map(function (code) {
        var warehouseSkus = allSkus.filter(function (sku) {
          return warehouseCodeForRecord(sku, warehouseCodeForRecord(product)) === code;
        });
        var rows = variants.map(function (variant) {
          var matches = warehouseSkus.filter(function (sku) {
            return freightAllocationColorKey(sku.colorName || sku.color || '') === freightAllocationColorKey(variant.colorRaw)
              && freightDemandIdentity(labelSizeText(sku.sizeName || sku.size || 'NO SIZE')) === freightDemandIdentity(variant.size);
          });
          var stocked = matches.filter(function (sku) { return Number(sku.stock || 0) > 0; });
          var sku = stocked[0] || matches[0] || null;
          var qty = matches.reduce(function (sum, item) { return sum + Math.max(0, Math.floor(Number(item.stock || 0))); }, 0);
          var payload = sku ? freightOtherWarehouseStockPrintPayload(product, sku, warehouseLabel(code)) : null;
          return {
            warehouseCode: code,
            warehouseName: warehouseLabel(code),
            color: variant.color,
            size: variant.size,
            qty: qty,
            skuId: sku && (sku.id || sku.sku) || '',
            barcode: payload && payload.barcode || '',
            payload: payload
          };
        });
        return {
          code: code,
          name: warehouseLabel(code),
          total: rows.reduce(function (sum, row) { return sum + Number(row.qty || 0); }, 0),
          rows: rows
        };
      })
    };
  }

  function freightReceivedCombinedPrintPayloads(panel) {
    var inbound = Array.isArray(freightReceivedPrintPayloads) ? freightReceivedPrintPayloads.slice() : [];
