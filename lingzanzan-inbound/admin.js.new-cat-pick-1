  function linkCreatedProductToFreightItem(continuation, product, createdSkus) {
    continuation = continuation || {};
    product = product || {};
    createdSkus = Array.isArray(createdSkus) ? createdSkus : [];
    var itemId = String(continuation.itemId || '').trim();
    if (!itemId) return Promise.resolve(null);
    var item = freightItemById(itemId);
    if (!item) return Promise.reject(new Error('產品已建立，但找不到原物流單，尚未正式入庫'));
    var lines = freightVariantLines(item);
    if (!lines.length) return Promise.reject(new Error('產品已建立，但原物流單沒有顏色／尺寸資料，尚未正式入庫'));
    var usedSkuIds = {};
    var linkedLines = lines.map(function (line, lineIndex) {
      var wantedColor = freightVariantTextKey(canonicalProductVariantColor(line.color || line.colorName || ''));
      var wantedSize = freightVariantTextKey(canonicalNoSize(line.size || line.sizeName || 'NO SIZE'));
      var sku = createdSkus.find(function (candidate) {
        var candidateId = String(candidate && (candidate.id || candidate.sku) || '').trim();
        if (candidateId && usedSkuIds[candidateId]) return false;
        var candidateColor = freightVariantTextKey(canonicalProductVariantColor(candidate && (candidate.colorName || candidate.color) || ''));
        var candidateSize = freightVariantTextKey(canonicalNoSize(candidate && (candidate.sizeName || candidate.size || 'NO SIZE')));
        return candidateColor === wantedColor && candidateSize === wantedSize;
      }) || (lines.length === 1 && createdSkus.length === 1 ? createdSkus[0] : null) || createdSkus[lineIndex] || null;
      if (!sku) return null;
      var skuId = String(sku.id || sku.sku || '').trim();
      var barcode = freightSkuBarcode(sku) || skuId;
      usedSkuIds[skuId] = true;
      return Object.assign({}, line, {
        productId: String(product.id || ''),
        productCode: String(product.code || ''),
        catalogProductCode: String(product.code || ''),
        productName: String(product.title || product.name || item.productName || ''),
        skuId: skuId,
        sampleBarcode: barcode,
        taiwanBarcode: barcode,
        barcode: barcode,
        image: String(sku.colorImage || line.image || product.mainImage || '')
      });
    });
    createdSkus.forEach(function (sku) {
      var skuId = String(sku && (sku.id || sku.sku) || '').trim();
      if (!skuId || usedSkuIds[skuId]) return;
      var barcode = freightSkuBarcode(sku) || skuId;
      var color = String(sku.colorName || sku.color || '').trim();
      var size = canonicalNoSize(sku.sizeName || sku.size || 'NO SIZE');
      var qtyKey = color + '||' + size;
      var qty = Math.max(1, Math.floor(Number((productDraft.stocks || {})[qtyKey] || sku.stock || 1)));
      var linkedFixedCost = fixedBarcodeCostInfo(product, sku, sku.currentCostTwd || sku.cost || product.currentCostTwd || product.cost || 0, {
        sampleBarcode: barcode,
        taiwanBarcode: barcode
      });
      usedSkuIds[skuId] = true;
      linkedLines.push({
        id: 'variant-added-' + linkedLines.length + '-' + Date.now(),
        productId: String(product.id || ''),
        productCode: String(product.code || ''),
        catalogProductCode: String(product.code || ''),
        productName: String(product.title || product.name || item.productName || ''),
        category: String(product.category || ''),
        skuId: skuId,
        sampleBarcode: barcode,
        taiwanBarcode: barcode,
        barcode: barcode,
        color: color,
        size: size,
        quantity: qty,
        qty: qty,
        barcodeCostTwd: Math.max(0, Number(linkedFixedCost.cost || 0)),
        barcodeCostSource: linkedFixedCost.source || '首次建檔成本（固定）',
        latestCostTwd: Math.max(0, Number(sku.currentCostTwd || sku.cost || product.currentCostTwd || product.cost || 0)),
        image: String(sku.colorImage || product.mainImage || '')
      });
    });
    if (linkedLines.some(function (line) { return !line; })) {
      return Promise.reject(new Error('產品已建立，但新 SKU 與物流顏色／尺寸對不上，尚未正式入庫'));
    }
    var primarySku = createdSkus.find(function (sku) { return usedSkuIds[String(sku && (sku.id || sku.sku) || '').trim()]; }) || createdSkus[0] || {};
    var primarySkuId = String(primarySku.id || primarySku.sku || '').trim();
    var primaryBarcode = freightSkuBarcode(primarySku) || primarySkuId;
    var now = new Date().toISOString();
    var linkedItem = Object.assign({}, item, {
      productId: String(product.id || ''),
      skuId: primarySkuId,
      productCode: String(product.code || ''),
      catalogProductCode: String(product.code || ''),
      productName: String(product.title || product.name || item.productName || ''),
      barcode: primaryBarcode,
      companyBarcode: primaryBarcode,
      productFiledProductId: String(product.id || ''),
      productFiledProductCode: String(product.code || ''),
      productFiledProductTitle: String(product.title || product.name || ''),
      productFiledSkuId: primarySkuId,
      productFiledSkuIds: Object.keys(usedSkuIds),
      productFiledBarcode: primaryBarcode,
      productFiledBarcodes: linkedLines.map(function (line) { return line.barcode; }),
      productFiledStatus: 'filed',
      productFiledAt: now,
      productFiledInventoryReceived: item.productFiledInventoryReceived === true,
      variants: linkedLines,
      updatedAt: now
    });
    return saveFreightItemRecord(linkedItem, 'product-filed-' + itemId + '-' + Date.now());
  }

