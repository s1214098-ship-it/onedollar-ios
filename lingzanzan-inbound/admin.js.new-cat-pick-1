    var names = [item.productName].concat(item.nameAliases || []).map(freightDemandIdentity).filter(Boolean);
    var existingLinks = Array.isArray(item.customerLinks) ? item.customerLinks : [];
    return (summary && summary.groups || []).map(function (group) {
      if (!(Number(group.pendingQty || 0) > 0)) return null;
      var groupCode = freightDemandIdentity(group.code);
      var groupBase = freightDemandBaseIdentity(group.code);
      var groupTitle = freightDemandIdentity(group.title);
      var exactMatches = identities.exact.has(groupCode);
      var nameMatches = names.indexOf(groupTitle) >= 0;
      var baseOnlyMatches = !!groupBase && identities.bases.has(groupBase);
      var baseMatches = baseOnlyMatches && nameMatches;
