  function freightWorkbenchAllocationComparison(item) {
    item = item || {};
    var logisticsColor = canonicalProductVariantColor(item.color || item.colorName || '未填顏色');
    var logisticsSize = canonicalProductVariantSize(item.size || item.sizeName || 'NO SIZE');
    var logisticsProduct = freightDemandIdentity(item.catalogProductCode || item.productCode || freightProductCodeFromBarcode(item.sampleBarcode || item.taiwanBarcode || ''));
    var logisticsQty = Math.max(1, Number(item.quantity || item.qty || 1));
    var activeLinks = (Array.isArray(item.customerLinks) ? item.customerLinks : []).filter(function (link) {
      return link && ['cancelled', 'canceled', 'released', 'void'].indexOf(String(link.status || '').toLowerCase()) === -1;
    });
    var linkedQty = activeLinks.reduce(function (sum, link) { return sum + Math.max(0, Number(link.qty || 0)); }, 0);
    var variants = {};
    var mismatchCount = 0;
    activeLinks.forEach(function (link) {
      var color = canonicalProductVariantColor(link.color || link.colorName || '未填顏色');
      var size = canonicalProductVariantSize(link.size || link.sizeName || 'NO SIZE');
      var product = freightDemandIdentity(link.productCode || freightProductCodeFromBarcode(link.barcode || ''));
      var qty = Math.max(0, Number(link.qty || 0));
      var key = [color, size].join('|');
      if (!variants[key]) variants[key] = { color: color, size: size, qty: 0 };
      variants[key].qty += qty;
      var sameColor = freightDemandIdentity(color) === freightDemandIdentity(logisticsColor);
      var sameSize = freightDemandIdentity(size) === freightDemandIdentity(logisticsSize);
      var sameProduct = !logisticsProduct || !product || logisticsProduct === product;
      if (!sameColor || !sameSize || !sameProduct) mismatchCount += 1;
    });
    return {
      logisticsColor: logisticsColor,
      logisticsSize: logisticsSize,
      logisticsQty: logisticsQty,
      linkedQty: linkedQty,
      remainingQty: Math.max(0, logisticsQty - linkedQty),
      variants: Object.keys(variants).map(function (key) { return variants[key]; }),
      mismatchCount: mismatchCount
    };
  }

  function freightWorkbenchPhotoComparisonHtml(item) {
