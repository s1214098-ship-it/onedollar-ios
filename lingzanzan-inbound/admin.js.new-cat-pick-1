      // 已到貨、人工已選或暫緩的列會提早通過名單篩選；卡片稍後仍需要
      // 到貨／台灣現貨摘要，因此也在索引仍有效時先完成一次計畫。
      readyRows.forEach(function (row) {
        freightFifoTaiwanStockPlan(row, Array.isArray(row && row.items) ? row.items : []);
      });
      return readyRows;
    } finally {
      freightFifoPlanningContext = previousContext;
    }
