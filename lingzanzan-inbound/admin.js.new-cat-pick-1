  function freightItemClosesBatchQueue(item) {
    if (freightItemHasOutstandingArrival(item)) return false;
    if (!freightItemLeavesBatchSelection(item)) return false;
    var info = freightItemFiledProductInfo(item) || {};
    var claim = item && item.inventoryReceiptClaim && typeof item.inventoryReceiptClaim === 'object' ? item.inventoryReceiptClaim : {};
    var claimStatus = String(claim.status || '').toLowerCase();
    var inventoryStatus = String(item && item.inventoryStatus || '').toLowerCase();
    var receivingStage = String(item && item.receivingStage || '').toLowerCase();
    return item.productFiledInventoryReceived === true ||
      !!String(item.inventoryReceivedAt || item.receivedAt || item.receivingDocumentNo || '').trim() ||
      ['received', 'posted', 'applied', 'completed'].indexOf(claimStatus) >= 0 ||
      ['received', 'inventory_received', 'completed'].indexOf(inventoryStatus) >= 0 ||
      ['received', 'inventory_received', 'completed'].indexOf(receivingStage) >= 0 ||
      info.inventoryReceived === true;
  }

  function freightItemHasReceivedLocationStatus(item) {
    var words = [
      item && item.progress,
      item && item.freightReceivingStatus,
      item && item.receivingStatus,
      item && item.inventoryStatus,
      item && item.receivingStage
    ].join(' ').replace(/\s+/g, '');
    if (/尚未|未收到|未收貨|未收货|未到貨|未到货|待驗收|待验收|待入庫|待入库|缺件|部分|pending|awaiting/i.test(words)) return false;
    return /中國|中国|東莞|东莞|台灣|台湾|寶輝|宝辉|印尼|已驗收|已验收|已入庫|已入库|收到|收貨|收货|到貨|到货|received|inventory_received|completed/i.test(words);
  }

  function freightItemLeavesBatchSelection(item) {
    // Only a durable inventory receipt may remove a row from the unbatched
    // logistics list.  "中國收到／台灣收到" and a product mapping describe
    // package progress, not a completed stock-in operation.
    return freightItemClosesBatchQueueWithoutSelectionCheck(item);
  }

  function freightItemClosesBatchQueueWithoutSelectionCheck(item) {
    item = item || {};
    if (freightItemHasOutstandingArrival(item)) return false;
    var info = freightItemFiledProductInfo(item) || {};
    var claim = item.inventoryReceiptClaim && typeof item.inventoryReceiptClaim === 'object' ? item.inventoryReceiptClaim : {};
    var claimStatus = String(claim.status || '').toLowerCase();
    var inventoryStatus = String(item.inventoryStatus || '').toLowerCase();
    var receivingStage = String(item.receivingStage || '').toLowerCase();
    var returnStatus = [
      item.returnStatus,
      item.trackingStatus,
      item.status,
      item.progress,
      item.issueType,
      item.issueProgress
    ].join(' ').toLowerCase();
    if (item.receivingVoided === true) return true;
    if (String(item.receivingStage || '').toLowerCase() === 'voided') return true;
    if (String((item.receivingInspection && item.receivingInspection.status) || '').toLowerCase() === 'voided') return true;
    if (/已退貨|已退款|退回供應商|取消採購|returned|refunded|cancelled|canceled|作廢/.test(returnStatus)) return true;
    return item.productFiledInventoryReceived === true ||
      !!String(item.inventoryReceivedAt || item.receivedAt || item.receivingDocumentNo || '').trim() ||
      ['received', 'posted', 'applied', 'completed'].indexOf(claimStatus) >= 0 ||
      ['received', 'inventory_received', 'completed'].indexOf(inventoryStatus) >= 0 ||
      ['received', 'inventory_received', 'completed'].indexOf(receivingStage) >= 0 ||
      info.inventoryReceived === true;
  }

  function freightItemAwaitsInventoryReceipt(item) {
    if (!item) return false;
    if (freightItemHasOutstandingArrival(item)) return true;
    if (freightItemClosesBatchQueueWithoutSelectionCheck(item)) return false;
    var inspection = item.receivingInspection && typeof item.receivingInspection === 'object' ? item.receivingInspection : {};
    var words = [
      item.progress,
      item.freightReceivingStatus,
      item.receivingStatus,
      item.inventoryStatus,
      item.receivingStage,
      inspection.status,
      inspection.arrivalStatus
    ].join(' ');
    // 點貨／驗收後「待正式入庫」含「待入庫」字樣，不可被收到據點判斷擋掉。
    if (/待正式入庫|驗收點齊|inspection_finalized/.test(words)) return true;
    if (String(item.receivingStage || '').toLowerCase() === 'inspection_finalized') return true;
    if (String(inspection.status || '').toLowerCase() === 'final') return true;
    if (!freightItemAlreadyFiled(item)) return false;
    return freightItemHasReceivedLocationStatus(item);
  }

