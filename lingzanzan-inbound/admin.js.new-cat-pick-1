  function scanSimilarProductsForDraftImages() {
    var images = (productDraft.images || []).slice(-3).filter(Boolean);
    var box = document.querySelector('[data-product-similar-panel]');
    if (!box || !images.length) {
      if (box) {
        box.hidden = true;
        box.innerHTML = '';
      }
      return;
    }
    var token = ++productImageSimilarityToken;
    renderProductImageSimilarity([], true);
    Promise.all(images.map(imageHashFromSource)).then(function (draftHashes) {
      if (token !== productImageSimilarityToken) return;
      draftHashes = draftHashes.filter(Boolean);
      var currentCode = normalizeVerifyCode(document.querySelector('[data-new-product-code]')?.value || '');
      var candidates = unifiedProductRecognitionCatalog().filter(function (catalogRow) {
        var product = catalogRow.product || {};
        if (productEditId && String(product.id || '') === String(productEditId)) return false;
        if (currentCode && normalizeVerifyCode(product.code || product.id) === currentCode) return true;
        return productImageSources(product).length > 0;
      }).slice(0, 600);
      return Promise.all(candidates.map(function (catalogRow) {
        var product = catalogRow.product || {};
        var sources = productImageSources(product);
        return Promise.all(sources.map(function (src) {
          var key = String(src || '');
          if (productImageSimilarityCache[key]) return Promise.resolve(productImageSimilarityCache[key]);
