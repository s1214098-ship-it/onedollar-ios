    var trackingQueryValue = String(document.querySelector('[data-order-tracking-query]')?.value || '').trim();
    var hasActiveTrackingSearch = orderTrackingQueryReadyForHeavyLoad(trackingQueryValue);
    ['ready', 'preorder', 'live', 'inquiry'].forEach(function (category) {
