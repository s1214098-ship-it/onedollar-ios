  function freightHasOfficialCarrierMovement(row) {
    var queue = orderTrackingCarrierQueueEntry(row) || {};
    var type = String(queue.resultType || '');
    var status = String(queue.suggestedStatus || '').toLowerCase();
    var text = [queue.sourceStatusText, queue.externalStatus, row.externalStatus].filter(Boolean).join(' ');
    if (/尚未.*寄件|尚未.*交寄|訂單失效|查無資料|等待寄件/.test(text)) return false;
    if (type === 'official_verified' && ['shipped', 'in_transit', 'arrived_store', 'delivered'].indexOf(status) >= 0) return true;
    return /已收件|門市已收|已完成寄件|寄件成功|貨件已受理|已送往物流中心|已送達物流中心|配送中|運輸中|轉運中|配達取件|到達門市|抵達門市|已到店|已送達|取件完成|已完成包裹取件/.test(text);
  }

  // One mutually-exclusive lane per canonical order. Classification never writes stock/status.
  function freightWorkflowLane(row, source) {
    var status = String(row.status || '').toLowerCase();
    if (row.cancelledAt || /cancelled|canceled|取消/.test(String(row.deliveryState || '').toLowerCase())) return '';
    if (status === 'collection_only' || row.documentMode === 'collection_only') return '';
    var delivery = freightFifoEffectiveDeliveryState(row);
    if (['delivered', 'completed', 'cancelled', 'canceled', 'returned', 'refunded', 'closed', 'reverted_to_waiting'].indexOf(status) >= 0 || ['delivered', 'returned'].indexOf(delivery) >= 0) return '';
    if (reservedShippingLane(row) === 'hold') return 'hold';
    if (freightFifoTrackingJoin(row)) {
      // A saved formal tracking number starts delivery immediately, unless
      // 先不出貨／寄庫 is still in force above.
      if (['in_transit', 'arrived_store', 'shipped'].indexOf(delivery) >= 0) return 'transit';
      return freightHasOfficialCarrierMovement(row) ? 'transit' : 'awaiting_carrier';
    }
    if (['in_transit', 'arrived_store', 'shipped'].indexOf(delivery) >= 0) return 'transit';
    if (String(row.reservedShippingDate || '').trim() && row.reservedShippingStatus !== 'cancelled') return 'schedule';
    // 寄庫／排程是訂單身分；缺貨與重新配貨只是庫存狀態，不可把訂單移出原區。
    if (String(row.reservedShippingStatus || '').toLowerCase() === 'reserved'
      || String(row.reservedShippingHoldReason || row.holdReason || '').trim()) return 'hold';
    if (freightFifoIsLiveOrder(row)) return 'live_notify';
    var preorder = source === 'inquiry' || !!(row.sourceInquiryId || row.convertedFromInquiryId || row.inquiryId) || /^BYORDER-/i.test(String(row.id || '')) || /preorder/i.test(String(row.orderType || row.type || ''));
    if (!preorder) return 'administrative';
    return freightFifoTrackingJoin(row) ? 'hold' : 'waiting';
  }

  function freightWorkflowCollect(candidates) {
    var lanes = { waiting: [], administrative: [], live_notify: [], hold: [], schedule: [], awaiting_carrier: [], transit: [] };
    var seen = new Set();
    function add(row, source) {
      if (!row || !row.id || seen.has(String(row.id))) return;
      if (!freightFifoRowMatchesScope(row) || !freightFifoRowMatchesSearch(row) || !freightFifoMatchesSales(row)) return;
      var lane = freightWorkflowLane(row, source);
      if (!lane) return;
      seen.add(String(row.id));
      lanes[lane].push({ row: row, source: source, lane: lane });
      (row.freightFifoMergedOrderIds || []).forEach(function (id) { seen.add(String(id)); });
      (row.freightFifoPlannedMergeRows || []).forEach(function (member) {
        seen.add(String(member.id || ''));
        var formalMember = freightFifoFormalOrderForInquiry(member.id);
        if (formalMember) seen.add(String(formalMember.id || ''));
      });
    }
    // Repartition the established worklist, never re-import all historical orders.
    (candidates || []).forEach(function (entry) {
      if (!entry || !entry.row) return;
      var row = entry.row;
      if (entry.source === 'inquiry' && !row.freightFifoPlannedMergeDisplay) {
        var formal = freightFifoFormalOrderForInquiry(row.id);
        if (formal && formal.status !== 'reverted_to_waiting' && !formal.revertedToWaitingAt) {
          add(formal, 'order');
          return;
        }
      }
      add(row, entry.source);
    });
    Object.keys(lanes).forEach(function (key) {
      lanes[key].sort(function (a, b) {
        if (key === 'schedule') {
          var dateOrder = String(a.row.reservedShippingDate || '').localeCompare(String(b.row.reservedShippingDate || ''));
          if (dateOrder) return dateOrder;
        }
        return freightFifoQueueCompare(a.row, b.row);
      });
    });
    return lanes;
  }

