    line.barcodeColorCode = colorCode;
    line.barcodeSizeCode = sizeCode;
    line.barcodeCostTwd = cost;
    line.barcodeCostSource = fixed.source || line.barcodeCostSource || '首次建檔成本（固定）';
    line.latestCostTwd = latestCost;
    line.latestCostSource = latest.hasCost ? (latest.source || '最新正式進貨成本') : (line.latestCostSource || '物流建檔成本');
