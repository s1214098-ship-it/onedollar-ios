  function pollAdminRealtimeSync(force) {
    if (document.hidden && !force) {
      document.body.setAttribute('data-realtime-sync', 'paused-hidden');
      return Promise.resolve(false);
    }
    return loadAdminRealtimeRevision().then(function (revision) {
      if (!revision) return false;
      if (adminOwnSaveRevisionPending) {
        // The local save already patched this page's state. Consume exactly
        // one revision poll without downloading/repainting all freight data.
        adminLastServerRevision = revision;
        adminOwnSaveRevisionPending = false;
        adminAutoSyncQueued = false;
        document.body.setAttribute('data-realtime-sync', 'ready');
        return false;
      }
      if (!adminLastServerRevision) {
        adminLastServerRevision = revision;
        document.body.setAttribute('data-realtime-sync', 'ready');
        return false;
      }
      if (revision === adminLastServerRevision) return false;
      adminLastServerRevision = revision;
      adminAutoSyncQueued = true;
      return false;
      /* Kept below for reference: data is no longer repainted automatically. */
      var freightHeavySyncPage = !!document.querySelector('[data-freight-tracking-panel]');
      if (!force && freightHeavySyncPage && adminLastFreightHeavySyncAt && Date.now() - adminLastFreightHeavySyncAt < ADMIN_FREIGHT_HEAVY_SYNC_MIN_INTERVAL_MS) {
        adminAutoSyncQueued = true;
        document.body.setAttribute('data-realtime-sync', 'waiting-for-freight-window');
        return false;
      }
      if (!force && !isAdminAutoSyncSafe()) {
        adminAutoSyncQueued = true;
        document.body.setAttribute('data-realtime-sync', 'waiting-for-editor');
        return false;
      }
      document.body.setAttribute('data-realtime-sync', 'syncing');
      return refreshAdminDataFromServer(true, true).then(function (updated) {
        if (updated) {
          adminLastServerRevision = revision;
          adminAutoSyncQueued = false;
        }
        return updated;
      });
    }).catch(function () {
      document.body.setAttribute('data-realtime-sync', 'offline');
      return false;
    });
  }

  function startAdminAutoSync() {
    if (adminAutoSyncTimer) clearInterval(adminAutoSyncTimer);
    if (adminUsesDemandOrderEntryData()) {
      loadAdminRealtimeRevision().then(function (revision) {
        adminLastServerRevision = revision;
        document.body.setAttribute('data-realtime-sync', 'ready');
        startAdminRealtimeEvents();
      }).catch(function () {
        document.body.setAttribute('data-realtime-sync', 'offline');
      });
      adminAutoSyncTimer = setInterval(function () {
        if (document.hidden) return;
        if (document.body.getAttribute('data-realtime-transport') === 'sse') return;
        loadAdminRealtimeSnapshot().then(refreshAdminRealtimeDomains).catch(function () {
          document.body.setAttribute('data-realtime-sync', 'offline');
        });
      }, 15000);
      return;
    }
    ['input', 'change', 'keydown', 'pointerdown'].forEach(function (eventName) {
      document.addEventListener(eventName, function (event) {
        var target = event.target;
        if (!target || !target.matches || !target.matches('input, textarea, select, [contenteditable="true"]')) return;
        if (adminIsQueryControl(target)) return;
        adminLastEditAt = Date.now();
      }, true);
    });
    // Do not apply queued remote changes on focusout. Losing focus from an
    // input used to trigger a full repaint and was reported as random jumping.
    document.addEventListener('visibilitychange', function () {
      if (document.hidden) {
        document.body.setAttribute('data-realtime-sync', 'paused-hidden');
        return;
      }
      pollAdminRealtimeSync(false);
    });
    loadAdminRealtimeRevision().then(function (revision) {
      adminLastServerRevision = revision;
      document.body.setAttribute('data-realtime-sync', 'ready');
      startAdminRealtimeEvents();
    }).catch(function () {
      document.body.setAttribute('data-realtime-sync', 'offline');
    });
    adminAutoSyncTimer = setInterval(function () {
      if (document.hidden) {
        document.body.setAttribute('data-realtime-sync', 'paused-hidden');
        return;
      }
      if (document.body.getAttribute('data-realtime-transport') === 'sse' && !adminAutoSyncQueued) return;
      pollAdminRealtimeSync(false);
    }, ADMIN_AUTO_SYNC_INTERVAL_MS + Math.floor(Math.random() * ADMIN_AUTO_SYNC_JITTER_MS));
  }

  function toast(message, kind) {
    var el = document.querySelector('[data-admin-toast]');
    if (!el) {
      el = document.createElement('div');
      el.className = 'toast';
      el.setAttribute('data-admin-toast', '');
      document.body.appendChild(el);
    }
    var text = String(message || '');
    el.textContent = text;
    el.hidden = false;
    var isError = kind === 'error' || /失敗|無法|不足|為 0|為0|尚未|請先/.test(text);
    el.classList.toggle('is-error', isError);
    el.style.zIndex = '2147483646';
    clearTimeout(toast.timer);
    toast.timer = setTimeout(function () {
      el.hidden = true;
    }, isError ? 5600 : 2800);
  }

  // LZ_ORDER_SAVE_ATOMIC_20260924
  var ORDER_SAVE_SUCCESS_HOLD_MS = 3000;

  function newAdminOrderClientTransactionId() {
    var rand = '';
    try {
      rand = Array.from(crypto.getRandomValues(new Uint8Array(6))).map(function (b) { return ('0' + b.toString(16)).slice(-2); }).join('');
    } catch (error) {
      rand = String(Date.now()) + String(Math.random()).slice(2, 8);
    }
    return 'ORDER-' + Date.now() + '-' + rand;
  }

  function queryAdminOrderTransactionStatus(transactionId) {
    return fetchJsonWithTimeout('./cart-order-api.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ action: 'transaction-status', clientTransactionId: transactionId })
    }, 12000, '無法確認訂單是否已儲存').catch(function () { return null; });
  }

  function recoverAdminOrderSaveIfCommitted(transactionId) {
    if (!transactionId) return Promise.resolve(null);
    var tries = 0;
    function once() {
      tries += 1;
      return queryAdminOrderTransactionStatus(transactionId).then(function (data) {
        if (data && (data.commitVerified || data.committed) && String(data.orderId || data.id || '').trim()) return data;
        if (tries >= 3) return null;
        return new Promise(function (resolve) { setTimeout(function () { resolve(once()); }, 900); });
      });
    }
    return once();
  }

  function adminOrderSaveIsConfirmed(data) {
    if (!data || data.ok === false) return false;
    var orderId = String(data.orderId || data.id || '').trim();
    if (!orderId) return false;
    if (data.commitVerified === false || data.inventoryCommitted === false || data.saved === false) return false;
    return true;
  }

  function postAdminCartOrder(payload, timeoutMs) {
    payload = payload || {};
    var txId = String(payload.clientTransactionId || newAdminOrderClientTransactionId());
    payload.clientTransactionId = txId;
    return fetchJsonWithTimeout('./cart-order-api.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    }, Math.max(60000, Number(timeoutMs || 60000)), '打單儲存逾時，正在確認是否已寫入').then(function (data) {
      if (!adminOrderSaveIsConfirmed(data)) throw new Error((data && data.error) || '訂單未儲存成功，未扣庫存');
      data.clientTransactionId = txId;
      return data;
    }).catch(function (error) {
      return recoverAdminOrderSaveIfCommitted(txId).then(function (recovered) {
        if (recovered && adminOrderSaveIsConfirmed(recovered)) return recovered;
        var msg = (error && error.message) || '訂單未儲存成功';
        throw new Error(msg + '。請先用電話到訂單追蹤搜尋；沒有單才可重送，避免重複扣庫。');
      });
    });
  }

  function holdAdminOrderSaveSuccess(info) {
    info = info || {};
    return new Promise(function (resolve) {
      var overlay = document.querySelector('[data-admin-order-save-success]');
      if (!overlay) {
        overlay = document.createElement('div');
        overlay.className = 'admin-order-save-success';
        overlay.setAttribute('data-admin-order-save-success', '');
        overlay.innerHTML = [
          '<div class="admin-order-save-success-card">',
          '<p>SAVE CONFIRMED</p>',
          '<b class="ok-title">儲存成功</b>',
          '<strong data-admin-order-save-success-id></strong>',
          '<span data-admin-order-save-success-meta></span>',
          '<em data-admin-order-save-success-msg></em>',
          '<small data-admin-order-save-success-count>畫面將停留 3 秒，確認完成後才可換下一筆</small>',
          '<button type="button" data-admin-order-save-success-close disabled>請等待 3 秒</button>',
          '</div>'
        ].join('');
        document.body.appendChild(overlay);
      }
      overlay.hidden = false;
      document.body.classList.add('is-order-save-locked');
      overlay.querySelector('[data-admin-order-save-success-id]').textContent = String(info.orderId || '');
      overlay.querySelector('[data-admin-order-save-success-meta]').textContent = [info.name, info.phone].filter(Boolean).join(' ／ ');
      overlay.querySelector('[data-admin-order-save-success-msg]').textContent = String(info.message || '訂單已完整儲存，庫存已一併扣除。');
      var closeBtn = overlay.querySelector('[data-admin-order-save-success-close]');
      var countEl = overlay.querySelector('[data-admin-order-save-success-count]');
      var nextStep = String(info.nextStep || '').trim();
      if (nextStep && countEl) countEl.textContent = nextStep;
      var finished = false;
      function finish() {
        if (finished) return;
        finished = true;
        overlay.hidden = true;
        document.body.classList.remove('is-order-save-locked');
        resolve();
      }
      closeBtn.disabled = true;
      var left = 3;
      closeBtn.textContent = '請等待 ' + left + ' 秒';
      var tick = setInterval(function () {
        left -= 1;
        if (left > 0) {
          closeBtn.textContent = '請等待 ' + left + ' 秒';
          countEl.textContent = '畫面將停留 ' + left + ' 秒，確認完成後才可換下一筆';
        }
      }, 1000);
      setTimeout(function () {
        clearInterval(tick);
        closeBtn.disabled = false;
        closeBtn.textContent = nextStep ? '開啟出貨小卡與物流' : '關閉，換下一筆';
        countEl.textContent = nextStep ? nextStep : '已確認儲存成功，可以換下一筆';
        closeBtn.onclick = finish;
        finish();
      }, ORDER_SAVE_SUCCESS_HOLD_MS);
    });
  }

  function ensureCameraScanDialog() {
    var dialog = document.querySelector('[data-camera-scan-dialog]');
    if (dialog) return dialog;
    dialog = document.createElement('div');
    dialog.className = 'camera-scan-dialog';
    dialog.setAttribute('data-camera-scan-dialog', '');
    dialog.hidden = true;
    dialog.innerHTML = [
      '<div class="camera-scan-card">',
      '<div class="camera-scan-head"><b>相機掃碼</b><button type="button" data-camera-scan-close>關閉</button></div>',
      '<video data-camera-scan-video playsinline muted></video>',
      '<div class="camera-scan-reader" data-camera-scan-reader hidden></div>',
      '<p data-camera-scan-status>請把 QR Code 或商品條碼放進畫面。</p>',
      '</div>'
    ].join('');
    document.body.appendChild(dialog);
    return dialog;
  }

  var cameraScanLibraryPromise = null;
  function loadCameraScanLibrary() {
    if (window.Html5Qrcode) return Promise.resolve();
    if (cameraScanLibraryPromise) return cameraScanLibraryPromise;
    cameraScanLibraryPromise = new Promise(function (resolve, reject) {
      var script = document.createElement('script');
      script.src = 'https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js';
      script.async = true;
      script.onload = function () { resolve(); };
      script.onerror = function () { reject(new Error('scanner library failed')); };
      document.head.appendChild(script);
    });
    return cameraScanLibraryPromise;
  }

  function stopCameraScan(dialog) {
    if (!dialog) dialog = document.querySelector('[data-camera-scan-dialog]');
    if (!dialog) return;
    dialog.hidden = true;
    if (dialog._scanFrame) cancelAnimationFrame(dialog._scanFrame);
    dialog._scanFrame = null;
    if (dialog._html5Scanner) {
      var scanner = dialog._html5Scanner;
      dialog._html5Scanner = null;
      scanner.stop().then(function () {
        return scanner.clear();
      }).catch(function () {});
    }
    if (dialog._stream) {
      dialog._stream.getTracks().forEach(function (track) { track.stop(); });
      dialog._stream = null;
    }
  }

  function applyCameraScanValue(selector, value) {
    var input = document.querySelector(selector || '[data-manual-preorder-search]');
    if (!input) return;
    input.value = String(value || '').trim();
    input.dispatchEvent(new Event('input', { bubbles: true }));
    input.focus();
  }

  function startProductCameraScan(selector) {
    var dialog = ensureCameraScanDialog();
    var video = dialog.querySelector('[data-camera-scan-video]');
    var reader = dialog.querySelector('[data-camera-scan-reader]');
    var status = dialog.querySelector('[data-camera-scan-status]');
    if (!navigator.mediaDevices || !navigator.mediaDevices.getUserMedia) {
      toast('這個瀏覽器目前不支援相機，請先手動輸入產品條碼或 SKU。');
      return;
    }
    stopCameraScan(dialog);
    dialog.hidden = false;
    video.hidden = false;
    if (reader) {
      reader.hidden = true;
      reader.innerHTML = '';
    }
    status.textContent = '正在開啟相機...';
    if (typeof window.BarcodeDetector === 'undefined') {
      startProductCameraScanFallback(selector, dialog);
      return;
    }
    var detector;
    try {
      // Keep the list conservative: some mobile Chromium builds throw when a
      // single optional format (notably ITF/UPC) is unsupported.
      detector = new BarcodeDetector({ formats: ['qr_code', 'code_128', 'code_39', 'ean_13', 'ean_8'] });
    } catch (error) {
      startProductCameraScanFallback(selector, dialog);
      return;
    }
    navigator.mediaDevices.getUserMedia({ video: { facingMode: { ideal: 'environment' } }, audio: false }).then(function (stream) {
      dialog._stream = stream;
      video.srcObject = stream;
      return video.play();
    }).then(function () {
      status.textContent = '請把 QR Code 或商品條碼放進畫面。';
      var scanLoop = function () {
        if (dialog.hidden) return;
        detector.detect(video).then(function (codes) {
          if (codes && codes.length) {
            var raw = codes[0].rawValue || '';
            stopCameraScan(dialog);
            applyCameraScanValue(selector, raw);
            toast('已帶入條碼：' + raw);
            return;
          }
          dialog._scanFrame = requestAnimationFrame(scanLoop);
        }).catch(function () {
          dialog._scanFrame = requestAnimationFrame(scanLoop);
        });
      };
      dialog._scanFrame = requestAnimationFrame(scanLoop);
    }).catch(function () {
      stopCameraScan(dialog);
      toast('無法開啟相機，請確認瀏覽器相機權限。');
    });
  }

  function startProductCameraScanFallback(selector, dialog) {
    var video = dialog.querySelector('[data-camera-scan-video]');
    var reader = dialog.querySelector('[data-camera-scan-reader]');
    var status = dialog.querySelector('[data-camera-scan-status]');
    if (video) video.hidden = true;
    if (!reader) {
      toast('這個瀏覽器目前不支援相機掃碼，請先手動輸入產品條碼或 SKU。');
      return;
    }
    reader.hidden = false;
    if (!reader.id) reader.id = 'camera-scan-reader-' + Date.now();
    status.textContent = '正在準備備援掃碼器...';
    loadCameraScanLibrary().then(function () {
      var formats = window.Html5QrcodeSupportedFormats ? [
        Html5QrcodeSupportedFormats.QR_CODE,
        Html5QrcodeSupportedFormats.CODE_128,
        Html5QrcodeSupportedFormats.CODE_39,
        Html5QrcodeSupportedFormats.EAN_13,
        Html5QrcodeSupportedFormats.EAN_8,
        Html5QrcodeSupportedFormats.UPC_A,
        Html5QrcodeSupportedFormats.UPC_E
      ].filter(function (item) { return item !== undefined; }) : undefined;
