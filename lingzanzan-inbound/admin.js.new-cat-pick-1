  function lookupFreightInterlinkByCode(force) {
    var productCode = freightCurrentLinkProductCode();
    var panel = document.querySelector('[data-freight-code-interlink]');
    if (!productCode) {
      freightCodeInterlinkPayload = null;
      if (panel) panel.hidden = true;
      return Promise.resolve(null);
    }
    var key = normalizeLiveCode(productCode);
    if (!force && panel && panel.dataset.freightInterlinkCode === key && freightCodeInterlinkPayload) return Promise.resolve(freightCodeInterlinkPayload);
    if (panel) panel.dataset.freightInterlinkCode = key;
    var sequence = ++freightCodeInterlinkLookupSequence;
    var url = './stock-inquiry-api.php?action=product-code-link-candidates&productCode=' + encodeURIComponent(productCode) + '&_=' + Date.now();
    return fetch(url, { cache: 'no-store', headers: adminAuthorizationHeaders() }).then(function (res) {
      return res.json().then(function (payload) { if (!res.ok || !payload.ok) throw new Error(payload.error || '產品編號互聯查詢失敗'); return payload; });
    }).then(function (payload) {
      if (sequence !== freightCodeInterlinkLookupSequence) return null;
      renderFreightCodeInterlink(payload);
      return payload;
    }).catch(function (error) {
      if (sequence !== freightCodeInterlinkLookupSequence) return null;
      freightCodeInterlinkPayload = null;
      if (panel) panel.hidden = true;
      setFreightBarcodeMatchStatus('產品編號互聯查詢失敗：' + (error.message || error), 'error');
      return null;
    });
  }

  function clearFreightAutoCustomerCandidate(matchModes) {
    var input = document.querySelector('[data-freight-customer-order-no]');
    matchModes = Array.isArray(matchModes) && matchModes.length ? matchModes : ['tracking-exact'];
    if (!input || matchModes.indexOf(input.dataset.freightMatchMode) === -1) return;
    input.value = '';
    [
      'freightInquiryId', 'freightOrderId', 'freightItemIndex', 'freightLineId',
      'freightLineKey', 'freightGroupKey', 'freightMatchMode', 'freightPendingQty',
      'freightMatchedTracking', 'freightMatchedBarcode'
    ].forEach(function (key) { input.dataset[key] = ''; });
    var nameInput = document.querySelector('[data-freight-customer-name]');
    var phoneInput = document.querySelector('[data-freight-customer-phone]');
    var codeInput = document.querySelector('[data-freight-product-code]');
    var productIdInput = document.querySelector('[data-freight-product-id]');
    var skuIdInput = document.querySelector('[data-freight-sku-id]');
    var aliasesInput = document.querySelector('[data-freight-product-aliases]');
    var productNameInput = document.querySelector('[data-freight-product-name]');
    if (nameInput) nameInput.value = '';
    if (phoneInput) phoneInput.value = '';
    if (codeInput) codeInput.value = '';
    if (productIdInput) productIdInput.value = '';
    if (skuIdInput) skuIdInput.value = '';
    if (aliasesInput) aliasesInput.value = JSON.stringify(freightNameAliases([productNameInput && productNameInput.value]));
