  function freightArrivalSaveCount(batch, row, trackingNo) {
    if (!batch || !row || freightArrivalReceivingSession.saving) return;
    freightArrivalReceivingSession.saving = true;
    var summary = freightBatchReceivingSummary(batch);
    var scannedRows = freightArrivalRowsForScan(batch, row && row.item, trackingNo);
    var targetKeys = new Set(scannedRows.map(function (candidate) { return candidate.key; }));
    var targets = summary.rows.filter(function (candidate) { return targetKeys.has(candidate.key); });
    if (!targets.length) {
      freightArrivalReceivingSession.saving = false;
      freightArrivalRenderActive('找不到這筆在批次內的點貨明細，未增加件數。', 'error');
      return;
    }
    var now = new Date().toISOString();
    batch.status = '台灣收到待點貨';
    batch.taiwanArrivedAt = batch.taiwanArrivedAt || now;
    var scannedTrackings = Array.isArray(batch.arrivalReceiving && batch.arrivalReceiving.scannedTrackings)
      ? batch.arrivalReceiving.scannedTrackings.slice()
      : [];
    if (!scannedTrackings.some(function (entry) { return normalizeScanCode(entry.trackingNo || entry) === normalizeScanCode(trackingNo); })) {
      scannedTrackings.push({ trackingNo: trackingNo || '', scannedAt: now, quantityStatus: 'pending_manual_confirmation' });
    }
    batch.arrivalReceiving = Object.assign({}, batch.arrivalReceiving || {}, {
      startedAt: batch.arrivalReceiving && batch.arrivalReceiving.startedAt || now,
      firstTrackingNo: batch.arrivalReceiving && batch.arrivalReceiving.firstTrackingNo || trackingNo || '',
      lastTrackingNo: trackingNo || '',
      updatedAt: now,
      scannedTrackings: scannedTrackings
    });
    freightArrivalReceivingSession.lastTrackingNo = trackingNo || '';
    saveFreightTracking().then(function () {
      freightArrivalReceivingSession.saving = false;
      freightArrivalRenderActive('已登記物流單號 ' + trackingNo + ' 的包裹到貨；尚未把預報數量當成實收。');
      openFreightQuantityConfirmation(batch.id || '', trackingNo);
      toast('包裹已登記；請逐色填寫實際收到數量');
    }).catch(function (error) {
      freightArrivalReceivingSession.saving = false;
      freightArrivalRenderActive('保存失敗，本件未確認寫入；請重新掃描。' + (error.message || ''), 'error');
    });
  }

  function startFreightArrivalReceiving() {
    var batch = freightBatchById(freightArrivalReceivingSession.batchId);
    var select = document.querySelector('[data-freight-arrival-customs-select]');
    var selected = String(select && select.value || '');
    if (!batch) { toast('找不到要啟動的物流批次'); return; }
    if (!freightArrivalReceivingSession.batchConfirmed) {
      toast('請先核對批號，確認正確後按「是，批號正確」');
      return;
    }
    var needsCustoms = freightBatchNeedsBaohuiCustoms(batch);
    if (needsCustoms && (!selected || selected === 'TAX_FREE')) {
      if (freightBatchHasCustomsBinding(batch)) {
        syncFreightBatchCustomsToRows(batch);
      } else {
        toast('請先選擇寶輝關稅號碼');
        if (select) select.focus();
        return;
      }
    }
    if (selected.indexOf('BAOHUI:') === 0) {
      var customs = (state.baohuiCustoms || [])[Number(selected.split(':')[1])];
      if (!customs) { toast('找不到這筆寶輝關稅資料，請重新整理'); return; }
      applyBaohuiCustomsCostsToBatch(batch, customs);
    } else if (selected === 'CURRENT') {
      syncFreightBatchCustomsToRows(batch);
    }
    var summary = freightBatchReceivingSummary(batch);
    var pendingRow = summary.rows.find(function (row) { return row.key === freightArrivalReceivingSession.pendingRowKey; }) || null;
    var now = new Date().toISOString();
    var operator = freightReceivingOperator();
    saveFreightBatchReceivingState(batch, summary, { now: now, completedAt: '', operator: operator });
    batch.status = '台灣收到待點貨';
    batch.taiwanArrivedAt = batch.taiwanArrivedAt || now;
    batch.statusHistory = Array.isArray(batch.statusHistory) ? batch.statusHistory : [];
    if (!batch.statusHistory.some(function (history) { return history.status === '台灣收到待點貨'; })) {
      batch.statusHistory.push({ status: '台灣收到待點貨', at: now, by: operator.label });
    }
    if (pendingRow) {
      freightArrivalSaveCount(batch, pendingRow, freightArrivalReceivingSession.firstTrackingNo);
      return;
    }
    freightArrivalReceivingSession.saving = true;
    saveFreightTracking().then(function () {
      freightArrivalReceivingSession.saving = false;
      freightArrivalRenderActive('批次驗貨已啟動，請開始逐件掃描。');
    }).catch(function (error) {
      freightArrivalReceivingSession.saving = false;
      toast(error.message || '批次驗貨啟動失敗');
    });
  }

