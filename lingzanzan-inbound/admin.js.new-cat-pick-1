        }
        toast(error.message || '批次同步未完成，請稍後再按一次');
      });
      return;
    }
    if (finalize && actual !== expected && !reason) {
      reason = '物流原登記 ' + expected + ' 件，實際驗收 ' + actual + ' 件，系統依實收修正';
      if (reasonBox) reasonBox.value = reason;
    }
    if (actionStatus) {
      actionStatus.className = 'freight-receiving-action-status is-working';
      actionStatus.textContent = finalize
        ? ('正在保存：原登記 ' + expected + ' 件／實收 ' + actual + ' 件；接著會進入正式入庫。')
        : ('正在暫存本張實收 ' + actual + ' 件…');
