  function normalizeImageToken(src) {
    src = String(src || '').split('?')[0].split('#')[0];
    var name = src.split('/').pop() || '';
    return normalizeScanCode(decodeURIComponent(name).replace(/\.[a-z0-9]+$/i, ''));
  }

  function imageHashFromSource(src) {
    return new Promise(function (resolve) {
      if (!src) {
        resolve(null);
        return;
      }
      var img = new Image();
      var done = false;
      var timer = setTimeout(function () {
        if (done) return;
        done = true;
        resolve(null);
      }, 2600);
      img.crossOrigin = 'anonymous';
      img.onload = function () {
        if (done) return;
        done = true;
        clearTimeout(timer);
        try {
          var size = 16;
          var canvas = document.createElement('canvas');
          canvas.width = size;
          canvas.height = size;
          var ctx = canvas.getContext('2d', { willReadFrequently: true });
          var sourceSize = Math.min(img.naturalWidth || img.width || size, img.naturalHeight || img.height || size);
          var sourceX = Math.max(0, ((img.naturalWidth || img.width || size) - sourceSize) / 2);
          var sourceY = Math.max(0, ((img.naturalHeight || img.height || size) - sourceSize) / 2);
          ctx.drawImage(img, sourceX, sourceY, sourceSize, sourceSize, 0, 0, size, size);
          var data = ctx.getImageData(0, 0, size, size).data;
          var values = [];
          var total = 0;
          var r = 0;
          var g = 0;
          var b = 0;
          for (var i = 0; i < data.length; i += 4) {
            var lum = data[i] * 0.299 + data[i + 1] * 0.587 + data[i + 2] * 0.114;
            values.push(lum);
            total += lum;
            r += data[i];
            g += data[i + 1];
            b += data[i + 2];
          }
          var avg = total / values.length;
          resolve({
            bits: values.map(function (value) { return value >= avg ? '1' : '0'; }).join(''),
            rgb: [Math.round(r / values.length), Math.round(g / values.length), Math.round(b / values.length)],
            token: normalizeImageToken(src)
          });
        } catch (err) {
          resolve({ bits: '', rgb: [0, 0, 0], token: normalizeImageToken(src), blocked: true });
        }
      };
      img.onerror = function () {
        if (done) return;
        done = true;
        clearTimeout(timer);
        resolve({ bits: '', rgb: [0, 0, 0], token: normalizeImageToken(src), blocked: true });
      };
      img.src = src;
    });
  }

  function imageHashDistance(a, b) {
    if (!a || !b || !a.bits || !b.bits || a.bits.length !== b.bits.length) return 999;
    var diff = 0;
    for (var i = 0; i < a.bits.length; i += 1) {
      if (a.bits[i] !== b.bits[i]) diff += 1;
    }
    return diff;
  }

  function imageColorDistance(a, b) {
    if (!a || !b || !a.rgb || !b.rgb) return 999;
    return Math.abs(a.rgb[0] - b.rgb[0]) + Math.abs(a.rgb[1] - b.rgb[1]) + Math.abs(a.rgb[2] - b.rgb[2]);
  }

  function productImageSources(product) {
    var images = [];
    if (product.mainImage) images.push(product.mainImage);
    (product.images || []).forEach(function (src) { if (src) images.push(src); });
    (product.colors || []).forEach(function (color) { if (color && color.image) images.push(color.image); });
    var seen = {};
    return images.filter(function (src) {
      var key = String(src || '');
      if (!key || seen[key]) return false;
      seen[key] = true;
      return true;
    }).slice(0, 5);
  }

