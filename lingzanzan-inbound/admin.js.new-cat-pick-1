  }

  function loadPurchaseStats() {
    var root = purchaseStatsRoot();
    if (!root) return Promise.resolve(null);
    var range = purchaseStatsRange();
    var sequence = ++purchaseStatsLoadSequence;
    setPurchaseStatsLoading();
    var url = './stock-inquiry-api.php?action=purchase-summary&from=' + encodeURIComponent(range.from) + '&to=' + encodeURIComponent(range.to) + '&_=' + Date.now();
    return fetch(url, { cache: 'no-store', headers: adminAuthorizationHeaders() }).then(function (res) {
      return res.json().catch(function () { return {}; }).then(function (data) {
        if (res.status === 401 || res.status === 403) {
          throw new Error('管理者登入已逾時，請重新登入後再讀取今天訂單。');
        }
        if (!res.ok || !data.ok || !data.summary) throw new Error(data.error || '無法讀取採購統計');
        return data.summary;
      });
    }).then(function (summary) {
      if (sequence !== purchaseStatsLoadSequence) return null;
      purchaseStatsSummary = summary;
      renderPurchaseStats(summary);
      return summary;
    }).catch(function (error) {
      if (sequence !== purchaseStatsLoadSequence) return null;
      setPurchaseStatsError(error.message || error);
      return null;
    });
  }

  function schedulePurchaseStatsLoad() {
    if (purchaseStatsReloadTimer) clearTimeout(purchaseStatsReloadTimer);
    purchaseStatsReloadTimer = setTimeout(function () {
      purchaseStatsReloadTimer = null;
      loadPurchaseStats();
    }, 120);
  }

  function syncPurchaseStatsDateControls(shouldLoad) {
    var root = purchaseStatsRoot();
    if (!root) return;
    var mode = root.querySelector('[data-purchase-date-mode]');
    var from = root.querySelector('[data-purchase-date-from]');
    var to = root.querySelector('[data-purchase-date-to]');
    var today = purchaseStatsTaipeiDay();
    if (from && !from.value) from.value = today;
    if (to && !to.value) to.value = from && from.value || today;
    var isRange = mode && mode.value === 'range';
    if (to) {
      to.disabled = !isRange;
      if (!isRange && from) to.value = from.value;
    }
    if (shouldLoad) {
      setPurchaseStatsLoading();
      schedulePurchaseStatsLoad();
    }
  }

  function purchaseStatsRenderedRange() {
    var root = purchaseStatsRoot();
    if (!root || root.dataset.purchaseStatsState !== 'ready') return null;
    var from = String(root.dataset.purchaseRangeFrom || '');
    var to = String(root.dataset.purchaseRangeTo || from);
    return from && to ? { from: from, to: to } : null;
  }

  function setPurchaseStatsQuickRange(value) {
    var root = purchaseStatsRoot();
    if (!root) return;
    var mode = root.querySelector('[data-purchase-date-mode]');
    var from = root.querySelector('[data-purchase-date-from]');
    var to = root.querySelector('[data-purchase-date-to]');
    var today = purchaseStatsTaipeiDay();
    if (value === 'yesterday') {
      if (mode) mode.value = 'day';
      if (from) from.value = purchaseStatsShiftDay(today, -1);
      if (to) to.value = purchaseStatsShiftDay(today, -1);
    } else if (value === '7days') {
      if (mode) mode.value = 'range';
      if (from) from.value = purchaseStatsShiftDay(today, -6);
      if (to) to.value = today;
    } else {
      if (mode) mode.value = 'day';
      if (from) from.value = today;
      if (to) to.value = today;
    }
    syncPurchaseStatsDateControls(true);
  }

