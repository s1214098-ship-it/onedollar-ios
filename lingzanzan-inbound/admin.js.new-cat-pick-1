  function printInventoryBarcodeSingle(payload, purpose, copies) {
    if (!payload || !payload.barcode) {
      toast('這個 SKU 沒有條碼可列印');
      return false;
    }
    if (!Number.isFinite(copies) || copies < 1) copies = 1;
    copies = Math.min(99, Math.floor(copies));
    var labelOne = inventoryBarcodeLabelHtml(payload, purpose);
    var labels = Array.from({ length: copies }).map(function () { return labelOne; }).join('');
    var labelHtml = [
      '<!doctype html><html><head><meta charset="utf-8"><title>Print QR Label ' + escapeHtml(payload.barcode) + '</title>',
      '<style>', inventoryBarcodePrintStyle(), '</style></head><body><div class="no-print print-toolbar"><button type="button" class="print-command" data-barcode-print-command>列印 QR 標籤</button><button type="button" class="download-command" data-barcode-download-command>下載列印檔</button><span>先核對標籤，確認無誤再按列印</span></div>',
      labels,
      '</body></html>'
    ].join('');
    return showInventoryBarcodePrintOverlay(labelHtml, 'LINGZANZAN-qr-label-' + String(payload.barcode || 'label') + '.html');
  }

