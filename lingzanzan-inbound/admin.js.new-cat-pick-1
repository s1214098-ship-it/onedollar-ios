    function refreshBackupStatus() {
      if (!document.querySelector('[data-backup-auto-state]')) return;
      fetch(SERVER_STATE_API + '?backup_status=1&_=' + Date.now(), { cache: 'no-store' }).then(function (res) {
        if (!res.ok) throw new Error('備份狀態讀取失敗');
        return res.json();
      }).then(function (data) {
        var auto = document.querySelector('[data-backup-auto-state]');
        var latest = document.querySelector('[data-backup-latest]');
        var count = document.querySelector('[data-backup-count]');
        if (auto) auto.textContent = '已啟用';
        if (latest) latest.textContent = data.latestAt ? String(data.latestAt).slice(0, 16).replace('T', ' ') : '尚未建立';
        if (count) count.textContent = '目前保留 ' + Number(data.count || 0) + ' 份伺服器快照';
      }).catch(function () {
        var auto = document.querySelector('[data-backup-auto-state]');
        if (auto) auto.textContent = '狀態讀取失敗';
      });
    }

    function downloadFullBackup() {
      toast('正在整理完整備份…');
      fetch(SERVER_STATE_API + '?backup=1&_=' + Date.now(), { cache: 'no-store' }).then(function (res) {
        if (!res.ok) throw new Error('完整備份讀取失敗');
        return res.json();
      }).then(function (payload) {
        var blob = new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' });
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = 'lingzanzan-full-backup-' + new Date().toISOString().replace(/[:.]/g, '-') + '.json';
        a.click();
        window.setTimeout(function () { URL.revokeObjectURL(url); }, 1000);
        toast('完整備份已下載');
      }).catch(function (error) { toast(error.message || '完整備份失敗'); });
    }

    document.querySelectorAll('[data-backup]').forEach(function (button) {
      button.addEventListener('click', downloadFullBackup);
    });

    bindIf('[data-backup-now]', 'click', function (event) {
      var button = event.currentTarget;
      button.disabled = true;
      button.textContent = '建立中…';
      fetch(SERVER_STATE_API + '?backup_now=1', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: '{}' }).then(function (res) {
        return res.json().then(function (data) { if (!res.ok || !data.ok) throw new Error(data.error || '伺服器快照失敗'); return data; });
      }).then(function () {
        toast('伺服器快照已建立');
        refreshBackupStatus();
      }).catch(function (error) { toast(error.message || '伺服器快照失敗'); }).finally(function () {
        button.disabled = false;
        button.textContent = '立即建立快照';
      });
    });

    bindIf('[data-restore-file]', 'change', function (event) {
      var file = event.target.files && event.target.files[0];
      var result = document.querySelector('[data-restore-result]');
      if (!file) { if (result) result.textContent = '尚未選擇檔案'; return; }
      file.text().then(function (text) {
        var payload = JSON.parse(text);
        var fileCount = payload && payload.files && typeof payload.files === 'object' ? Object.keys(payload.files).length : 0;
        if (!payload || (!fileCount && !payload.products && !payload.skus)) throw new Error('不是有效的 LINGZANZAN 備份檔');
        if (result) result.textContent = '格式檢查通過：' + (fileCount ? fileCount + ' 類資料' : '舊版備份') + '。目前尚未執行覆蓋。';
      }).catch(function (error) {
        if (result) result.textContent = error.message || '備份檔格式錯誤';
      });
    });

    refreshBackupStatus();

    document.querySelectorAll('.sidebar nav a').forEach(function (link) {
      if (link.classList && link.classList.contains('preorder-menu-link')) return;
      link.addEventListener('click', function () {
        setTimeout(renderAdminPage, 0);
      });
    });
    window.addEventListener('hashchange', function () { renderAdminPage(); setTimeout(scrollManualPreorderFromHash, 120); });
    window.addEventListener('load', function () { setTimeout(scrollManualPreorderFromHash, 350); });
  }

