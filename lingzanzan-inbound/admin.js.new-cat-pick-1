  function freightDamageRetentionDate(value) {
    var parsed = Date.parse(String(value || ''));
    if (!Number.isFinite(parsed)) return '-';
    try {
      return new Intl.DateTimeFormat('zh-TW', { timeZone: 'Asia/Taipei', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date(parsed));
    } catch (error) {
      return new Date(parsed).toISOString().slice(0, 10);
    }
  }

  function freightDamageRetentionDays(value) {
    var parsed = Date.parse(String(value || ''));
    if (!Number.isFinite(parsed)) return 0;
    return Math.max(0, Math.ceil((parsed - Date.now()) / (24 * 60 * 60 * 1000)));
  }

