  function chooseFreightReceivingPriority(preview, item) {
    var ownership = preview && preview.ownership || {};
    var links = Array.isArray(ownership.linkedOrders) ? ownership.linkedOrders : [];
    var seen = {};
    var dispatchChoices = [];
    links.forEach(function (link) {
      var inquiry = freightReceivingLinkedInquiry(link);
      var customer = inquiry.customer || {};
      var inquiryId = String(link.inquiryId || link.customerOrderNo || inquiry.id || '');
      if (!inquiryId || seen[inquiryId]) return;
      seen[inquiryId] = true;
      var otherItems = freightReceivingOtherItems(inquiry, link);
      var pendingOtherItems = otherItems.filter(function (other) { return other.pending > 0; });
      dispatchChoices.push({
        inquiryId: inquiryId,
        decision: otherItems.length ? 'wait_all' : 'ship_now',
        customerName: String(link.customerName || customer.name || inquiry.customerName || inquiryId),
        otherItemCount: otherItems.length,
        pendingOtherItemCount: pendingOtherItems.length
