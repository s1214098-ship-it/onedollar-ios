  function rememberFreightComputerCategory(name) {
    var raw = freightNormalizeComputerCategory(name);
    if (!raw) return;
    state.computerCategories = Array.isArray(state.computerCategories) ? state.computerCategories : [];
    var exists = state.computerCategories.some(function (item) {
      return String(item || '').trim().toLocaleLowerCase() === raw.toLocaleLowerCase();
    });
    if (!exists) state.computerCategories.push(raw);
  }

  function freightCategoryRules() {
    return Array.isArray(state.computerCategoryRules) ? state.computerCategoryRules : [];
  }

  function rememberFreightCategoryRule(rule) {
    var type = String(rule && rule.type || '').replace(/\s+/g, ' ').trim();
    var spec = String(rule && rule.spec || '').replace(/\s+/g, ' ').trim();
    var brand = String(rule && rule.brand || '').replace(/\s+/g, ' ').trim();
    if (freightIsComputerFilingMode()) type = freightNormalizeComputerCategory(type);
    if (!type || /^(null|undefined)$/i.test(spec) || /^請(?:先)?選/.test(spec)) return;
    if (freightIsComputerFilingMode()) rememberFreightComputerCategory(type);
    state.computerCategoryRules = freightCategoryRules();
    var exists = state.computerCategoryRules.some(function (row) {
      return String(row && row.type || '').trim() === type
        && String(row && row.spec || '').trim() === spec
        && String(row && row.brand || '').trim() === brand;
    });
    if (!exists) {
      state.computerCategoryRules.push({
        type: type,
        spec: spec,
        brand: brand,
        updatedAt: new Date().toISOString()
      });
    }
  }

  function freightSubcategoryChoices(type, selected) {
    var wanted = freightNormalizeComputerCategory(type);
    var selectedValue = String(selected || '').trim();
    var defaultsByCategory = freightComputerSubcategoryDefaults();
    var defaults = defaultsByCategory[wanted] || ['一般項目', '其他項目'];
    var fromRules = freightCategoryRules().filter(function (row) {
      return freightNormalizeComputerCategory(row && row.type || '') === wanted && String(row && row.spec || '').trim();
    }).map(function (row) { return row.spec; });
    var fromProducts = (state.products || []).filter(function (product) {
      return isComputerDepartmentRecord(product) && freightNormalizeComputerCategory(product.category || product.categoryName || '') === wanted;
    }).map(function (product) {
      return product.subcategory || product.categorySpec || product.category_spec || '';
    });
    return uniqueFreightChoiceValues(defaults.concat(fromRules, fromProducts, selectedValue ? [selectedValue] : []));
  }

  function freightBrandChoicesForPath(type, spec, selected) {
    var wantedType = String(type || '').trim();
    var wantedSpec = String(spec || '').trim();
    var selectedValue = String(selected || '').trim();
    var fromRules = freightCategoryRules().filter(function (row) {
      if (String(row && row.type || '').trim() !== wantedType) return false;
      if (wantedSpec && String(row && row.spec || '').trim() && String(row.spec).trim() !== wantedSpec) return false;
      return String(row && row.brand || '').trim();
    }).map(function (row) { return row.brand; });
    var masterRows = normalizePurchasePlatforms(state.purchasePlatforms || []);
    var fromMaster = masterRows.filter(function (row) { return row.masterKind === 'brand'; }).map(function (row) { return row.name; });
    var fromProducts = (state.products || []).map(function (product) { return freightProductMetadata(product).brand; });
    return uniqueFreightChoiceValues(fromRules.concat(fromMaster, fromProducts, selectedValue ? [selectedValue] : []));
  }

  function syncFreightCategoryPath(selected) {
    selected = selected || {};
    var type = syncFreightCategorySelect(selected.category);
    var computer = freightIsComputerFilingMode();
    var specSelect = document.querySelector('[data-freight-subcategory]');
    var specValue = String(selected.spec !== undefined ? selected.spec : (specSelect && specSelect.value || '')).replace(/\s+/g, ' ').trim();
    if (!computer) {
      if (specSelect) specSelect.value = '';
      return type;
    }
    var knownSpecs = freightSubcategoryChoices(type, '');
    if (specValue && knownSpecs.indexOf(specValue) === -1) {
      if (selected.spec !== undefined) rememberFreightCategoryRule({ type: type, spec: specValue, brand: '' });
      else specValue = '';
    }
    fillFreightChoiceSelect('[data-freight-subcategory]', type ? freightSubcategoryChoices(type, specValue) : [], type ? '請選擇次分類，例如後背包' : '請先選主分類', type ? specValue : '');
    var brandValue = String(selected.brand !== undefined ? selected.brand : (document.querySelector('[data-freight-brand]') && document.querySelector('[data-freight-brand]').value || '')).replace(/\s+/g, ' ').trim();
    fillFreightChoiceSelect('[data-freight-brand]', freightBrandChoicesForPath(type, specValue, brandValue), '請選擇品牌', brandValue);
    return type;
  }

