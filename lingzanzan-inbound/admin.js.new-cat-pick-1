    if (!options.auto && !window.confirm('後台有 ' + packages.length + ' 筆物流單號（含拼多多／寶輝／豪鴻），豪鴻我的包裹還沒有。確定預報到豪鴻嗎？\n\n東莞自取不會送去豪鴻。豪鴻入庫後才會有重量；現在先把單號帶上去。')) {
      return Promise.resolve({ ok: false, cancelled: true, createdCount: 0, message: '已取消預報' });
    }
    request.packages = packages;
    if (button && !options.auto) { button.disabled = true; button.textContent = '正在預報到豪鴻…'; }
    if (status) status.textContent = '後台已有條碼／物流單號、豪鴻還沒有，正在預報到豪鴻我的包裹…';
    return fetch('./haohong-sync-api.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      cache: 'no-store',
      body: JSON.stringify(request)
    }).then(function (response) {
      return response.json().then(function (payload) {
        if (!response.ok || !payload.ok) throw new Error(payload.error || '豪鴻預報失敗');
        return payload;
      });
    }).then(function (payload) {
      applyHaoHongStoredLogin({ stored: payload.credentialsStored, username: request.username || haohongStoredLogin.username }, { skipStatus: true });
      if (Array.isArray(payload.packages) && payload.packages.length) {
        haohongSyncPackages = payload.packages;
        haohongLastPackageApplySummary = applyHaoHongPackageWeights(haohongSyncPackages);
      }
      markHaoHongForecastStatus((payload.created || []).map(function (row) { return row.trackingNo; }), 'registered', '');
      markHaoHongForecastStatus((payload.existing || []).map(function (row) { return row.trackingNo; }), 'matched', '');
      markHaoHongForecastStatus((payload.skipped || []).map(function (row) { return row.trackingNo; }), 'failed', (payload.skipped[0] && payload.skipped[0].reason) || '豪鴻預報失敗');
      return saveFreightTracking().then(function () {
        var skipped = Array.isArray(payload.skipped) ? payload.skipped.length : 0;
        var existing = Number(payload.existingCount || 0);
        var message = '已把後台單號預報到豪鴻 ' + Number(payload.createdCount || 0) + ' 筆'
          + (existing ? '；豪鴻本來就有 ' + existing + ' 筆' : '')
          + (skipped ? '；' + skipped + ' 筆豪鴻沒接受' : '')
          + '。入庫後再同步就會帶重量。';
        if (status) status.textContent = message;
        if (!options.auto) toast(message);
        renderHaoHongSyncPreview();
        renderFreightTracking();
        return { ok: true, createdCount: Number(payload.createdCount || 0), skipped: payload.skipped || [], message: message };
      });
    }).catch(function (error) {
      var message = error.message || '豪鴻預報失敗；若要求驗證碼，請先在豪鴻網頁完成驗證。';
      if (status) status.textContent = message;
      if (!options.auto) toast(message);
      return { ok: false, createdCount: 0, message: message };
    }).finally(function () {
      if (!options.auto && passwordInput) passwordInput.value = '';
      if (button && !options.auto) { button.disabled = false; button.textContent = '後台單號預報到豪鴻'; }
    });
  }

  function maybeSyncHaoHongNameAfterFreightSave(savedItem) {
    if (!savedItem || !haohongItemCanPushFromAdmin(savedItem)) return Promise.resolve();
    return registerMissingHaoHongPackages({ auto: true, item: savedItem }).then(function (reg) {
      if (reg && reg.createdCount) {
        toast('後台單號已預報到豪鴻 ' + reg.createdCount + ' 筆；豪鴻入庫後再同步就會帶重量進集運');
      }
      if (!haohongItemNameForSync(savedItem)) return reg;
      return syncHaoHongProductNames({ auto: true }).then(function (result) {
        if (result && result.updatedCount) {
          toast('後台品名已同步到豪鴻 ' + result.updatedCount + ' 筆；請到豪鴻重新整理即可看到');
        }
        return result;
      });
    });
  }

  function haohongFormalBatchId(order) {
    var token = String(order && (order.haohongOrderId || order.haohongOrderCode || order.transferOrderNo) || Date.now()).replace(/[^A-Za-z0-9_-]/g, '');
    return 'HAOHONG-' + token;
  }

  function findHaohongLinkedBatch(order) {
    var expectedId = haohongFormalBatchId(order);
    var orderId = String(order && order.haohongOrderId || '');
    var orderCode = String(order && order.haohongOrderCode || '');
    var batches = normalizeFreightTracking(state.freightTracking).batches || [];
    var exact = batches.find(function (batch) { return String(batch.id || '') === expectedId; });
    if (exact) return exact;
    return batches.find(function (batch) {
      var isHaohong = String(batch.provider || '').toLowerCase() === 'haohong'
        || /豪鴻/.test(String(batch.forwarder || ''))
        || /^HAOHONG-/i.test(String(batch.id || ''));
      if (!isHaohong) return false;
      return (orderId && String(batch.haohongOrderId || '') === orderId)
        || (orderCode && (String(batch.haohongOrderCode || '') === orderCode || String(batch.batchNo || '') === orderCode))
        || (orderId && String(batch.batchNo || '') === orderId);
    }) || null;
  }

  function haohongKeepPurchaseIdentity(item, identity) {
    var account = String(identity && identity.purchaseAccount || item.purchaseAccount || item.platform || '').replace(/拚/g, '拼').trim();
    if (!account || account === '豪鴻未分類') {
      return Object.assign({}, identity, {
        purchaseAccount: String(item.purchaseAccount || '').trim(),
        platform: String(item.platform || item.purchaseAccount || identity.platform || '').trim()
      });
    }
    return Object.assign({}, identity, { purchaseAccount: account, platform: account });
  }

  function applyHaoHongOrderData(order) {
    state.freightTracking = normalizeFreightTracking(state.freightTracking);
    var now = new Date().toISOString();
    var existingBatch = findHaohongLinkedBatch(order);
    var batchId = String(existingBatch && existingBatch.id || haohongFormalBatchId(order));
    var batchNo = String(order.haohongOrderId || order.haohongOrderCode || batchId).trim();
    var packageCount = Math.max(0, Number(order.packageCount || (order.rows || []).length || 0));
    var rowByTracking = new Map();
    (order.rows || []).forEach(function (row) {
      var key = haohongTrackingKey(row.trackingNo);
      if (key) rowByTracking.set(key, row);
    });
    var matchedIds = new Set();
    var matchedItemCount = 0;
    state.freightTracking.items = state.freightTracking.items.map(function (item) {
      if (haohongItemIsSelfPickup(item)) return item;
      var keys = haohongItemTrackingNumbers(item).map(haohongTrackingKey);
      var row = null;
      keys.forEach(function (key) {
        if (!row && rowByTracking.has(key)) row = rowByTracking.get(key);
      });
      if (!row) return item;
      matchedItemCount += 1;
      matchedIds.add(String(item.id || ''));
      var identity = haohongKeepPurchaseIdentity(item, haohongPurchaseIdentity([row.note, row.productName, item.purchaseContentRaw, item.note].filter(Boolean).join(' '), item.purchaseAccount || item.platform || ''));
      return Object.assign({}, item, identity, {
        batchId: batchId,
        provider: 'haohong',
        logisticsSource: 'haohong',
        forwarder: '豪鴻集運倉',
        destinationWarehouse: 'TW_BAOHUI',
        destinationSite: '寶輝據點',
        handlingPerItemTwd: 30,
        costMode: 'haohong_weight_batch',
        haohongOrderId: order.haohongOrderId || '',
        haohongOrderCode: order.haohongOrderCode || '',
        haohongTrackingNo: row.trackingNo || item.haohongTrackingNo || item.trackingNo || '',
        actualWeightKg: Number(row.actualWeightKg || item.actualWeightKg || 0),
        volumeWeightKg: Number(row.volumeWeightKg || item.volumeWeightKg || 0),
        billedWeightKg: Number(row.billedWeightKg || item.billedWeightKg || 0),
        shippingWeightKg: Number(row.billedWeightKg || item.shippingWeightKg || item.billedWeightKg || 0),
        weightKg: Number(row.billedWeightKg || item.weightKg || 0),
        weightSource: 'haohong_order_detail',
        haohongPackageStatus: '豪鴻已形成正式批次',
        haohongAwaitingConsolidation: false,
        haohongWeightUpdatedAt: now,
        purchaseContentRaw: item.purchaseContentRaw || row.note || '',
        customerPriority: Boolean(item.customerPriority || identity.customerPriority),
        progress: order.status && /簽收|签收/.test(order.status) ? '配送中' : (item.progress || '已集運'),
        updatedAt: now
      });
    });
    var imported = 0;
    var signed = !!(order.status && /簽收|签收/.test(order.status));
    // 已簽收的歷史批次仍可能少連少數正式物流單號。只在後台已有同一
    // 豪鴻批次且至少一筆物流已精確匹配時補缺漏，避免把整張陌生歷史
    // 訂單直接匯入；補入資料維持待分類／人工核對，不會自動入庫。
    var canImportMissingRows = !signed || (existingBatch && matchedItemCount > 0);
    if (canImportMissingRows) {
      (order.rows || []).forEach(function (row, rowIndex) {
      var key = haohongTrackingKey(row.trackingNo);
      if (!key) return;
      if (state.freightTracking.items.some(function (item) { return haohongItemTrackingNumbers(item).map(haohongTrackingKey).indexOf(key) >= 0; })) return;
      var identity = haohongPurchaseIdentity([row.note, row.productName].filter(Boolean).join(' '), '');
      var qty = haohongQuantityFromContent(row.note || '');
      var id = batchId + '-' + String(rowIndex + 1).padStart(3, '0');
      matchedIds.add(id);
      state.freightTracking.items.push(Object.assign({
        id: id,
        date: String(row.receivedAt || order.orderDate || freightToday()).slice(0, 10),
        provider: 'haohong', logisticsSource: 'haohong', forwarder: '豪鴻集運倉',
        destinationWarehouse: 'TW_BAOHUI', destinationSite: '寶輝據點', handlingPerItemTwd: 30, costMode: 'haohong_weight_batch',
        trackingNo: row.trackingNo || '', haohongTrackingNo: row.trackingNo || '',
        haohongOrderId: order.haohongOrderId || '', haohongOrderCode: order.haohongOrderCode || '', batchId: batchId,
        productName: row.productName || '豪鴻待補產品名稱', purchaseContentRaw: row.note || '', note: row.note || '',
