  var FREIGHT_PAGE_SIZE = 10;
  var freightPaginationState = { batches: 1, items: 1, filed: 1 };
  var freightSecondaryRenderToken = 0;
  var freightSecondaryRenderHandle = 0;
  var freightSecondaryRenderUsesIdle = false;

  function cancelFreightSecondaryRender() {
    freightSecondaryRenderToken += 1;
    if (!freightSecondaryRenderHandle) return;
    if (freightSecondaryRenderUsesIdle && typeof window.cancelIdleCallback === 'function') {
      window.cancelIdleCallback(freightSecondaryRenderHandle);
    } else {
      window.clearTimeout(freightSecondaryRenderHandle);
    }
    freightSecondaryRenderHandle = 0;
    freightSecondaryRenderUsesIdle = false;
  }

  function scheduleFreightSecondaryRender(steps) {
    cancelFreightSecondaryRender();
    steps = Array.isArray(steps) ? steps.filter(function (step) { return typeof step === 'function'; }) : [];
    if (!steps.length) {
      if (document.body) delete document.body.dataset.adminFreightSecondaryLoading;
      return;
    }
    var token = freightSecondaryRenderToken;
    if (document.body) document.body.dataset.adminFreightSecondaryLoading = 'true';

    function finish() {
      freightSecondaryRenderHandle = 0;
      freightSecondaryRenderUsesIdle = false;
      if (token === freightSecondaryRenderToken && document.body) {
        delete document.body.dataset.adminFreightSecondaryLoading;
      }
    }

    function runStep(index) {
      if (token !== freightSecondaryRenderToken) return;
      if (index >= steps.length) {
        finish();
        return;
      }
      var execute = function () {
        freightSecondaryRenderHandle = 0;
        freightSecondaryRenderUsesIdle = false;
        if (token !== freightSecondaryRenderToken) return;
        try {
          steps[index]();
        } catch (error) {
          console.error('Deferred freight render failed', error);
        }
        runStep(index + 1);
      };
      if (typeof window.requestIdleCallback === 'function') {
        freightSecondaryRenderUsesIdle = true;
        freightSecondaryRenderHandle = window.requestIdleCallback(execute, { timeout: 6000 });
      } else {
        freightSecondaryRenderUsesIdle = false;
        freightSecondaryRenderHandle = window.setTimeout(execute, 250);
      }
    }

    runStep(0);
  }

  function prepareFreightLazyRender(selector, renderer) {
    var host = document.querySelector(selector);
    if (!host || typeof renderer !== 'function' || host.dataset.freightLazyRenderBound === '1') return;
    host.dataset.freightLazyRenderBound = '1';

    function renderOnce() {
      if (host.dataset.freightLazyRendered === '1') return;
      host.dataset.freightLazyRendered = '1';
      renderer();
    }

    host.addEventListener('pointerdown', renderOnce, { once: true, passive: true });
    host.addEventListener('focusin', renderOnce, { once: true });
    if (typeof window.IntersectionObserver === 'function' && !host.hidden) {
      var observer = new window.IntersectionObserver(function (entries) {
        if (!entries.some(function (entry) { return entry.isIntersecting; })) return;
        observer.disconnect();
        renderOnce();
      }, { rootMargin: '700px 0px' });
      observer.observe(host);
    }
    // The shipment board is a primary work surface. Some embedded/mobile
    // browsers do not deliver the initial IntersectionObserver callback until
    // the operator touches the page, leaving the board stuck on "整理中".
    // Schedule the same idempotent loader after first paint so data is always
    // available without requiring a click or scroll.
    if (selector === '[data-freight-customer-shipment-board]') {
      window.setTimeout(renderOnce, 120);
    }
  }

  function prepareFreightLazySecondarySections() {
