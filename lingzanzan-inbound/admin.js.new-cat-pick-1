    var page = freightFifoReadSharedPage(sectionKey);
    page = Math.min(page, totalPages);
    freightFifoWriteSharedPage(sectionKey, page);
    var start = (page - 1) * freightFifoPageSize;
    return {
      page: page,
      totalPages: totalPages,
      total: list.length,
      start: start,
      rows: list.slice(start, start + freightFifoPageSize)
    };
  }

