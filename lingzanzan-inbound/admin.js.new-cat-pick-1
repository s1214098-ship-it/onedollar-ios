        else toast('目前欄位已有資料，未覆蓋現有內容');
        return;
      }
      var clearButton = event.target.closest && event.target.closest('[data-order-customer-clear]');
      if (clearButton) { event.preventDefault(); clearAdminOrderCustomerDraft(); }
    });
  }
