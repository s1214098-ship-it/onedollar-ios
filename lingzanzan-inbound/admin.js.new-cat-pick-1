  function orderIsCnTwInTransit(row) {
    row = row || {};
    if (row.cnTwInTransit) return true;
    if (String(row.reservedShippingHoldReason || '') === 'cn_tw_in_transit') return true;
    if (String(row.fulfillmentKind || '') === 'pre_pick' && /china_to_taiwan|cn_to_tw/.test(String(row.shipMode || ''))) return true;
    return String(row.shipMode || '').toLowerCase() === 'china_to_taiwan';
  }

  function cnTwReservedQty(sku) {
    sku = sku || {};
    var holds = Array.isArray(sku.cnTwHolds) ? sku.cnTwHolds : [];
    var sum = holds.reduce(function (total, hold) {
      var status = String(hold && hold.status || 'held').toLowerCase();
      if (['released', 'received', 'cancelled', 'shipped'].indexOf(status) >= 0) return total;
      return total + Math.max(0, Number(hold && hold.qty || 0));
    }, 0);
    return Math.max(sum, Math.max(0, Number(sku.cnTwReservedQty || 0)));
  }

  function cnTwInTransitQty(sku) {
    return Math.max(0, Number((sku || {}).cnTwInTransitQty || 0));
  }

  function cnTwFreeQty(sku) {
    return Math.max(0, Number((sku || {}).stock || 0) - Math.max(cnTwReservedQty(sku), cnTwInTransitQty(sku)));
  }

  function cnTwHolderMessage(sku, needQty) {
    sku = sku || {};
    var holds = (Array.isArray(sku.cnTwHolds) ? sku.cnTwHolds : []).filter(function (hold) {
      var status = String(hold && hold.status || 'held').toLowerCase();
      return ['released', 'received', 'cancelled', 'shipped'].indexOf(status) === -1 && Math.max(0, Number(hold && hold.qty || 0)) > 0;
    });
    var names = holds.map(function (hold) {
      return String(hold.customerName || '未填客戶') + '／' + String(hold.orderId || '未編號') + '（' + Math.max(0, Number(hold && hold.qty || 0)) + '件）';
    });
    var book = Math.max(0, Number(sku.stock || 0));
    var free = cnTwFreeQty(sku);
    var inTransit = cnTwInTransitQty(sku);
    if (!names.length) {
      if (inTransit > 0) return '本筆產品已在途調撥 ' + inTransit + ' 件（尚未驗收入台灣倉），可綁只剩 ' + free + ' 件。帳面仍在中國倉 ' + book + ' 件。';
      return '中國倉可賣庫存不足（帳面 ' + book + ' 件，可綁 0 件）。';
    }
    return '本筆產品已經綁給誰：' + names.join('、') + '。帳面仍在中國倉 ' + book + ' 件，未入台灣倉。' + (needQty ? '還要 ' + needQty + ' 件，可綁只剩 ' + free + ' 件。' : '');
  }

  function liveUsesCnTwHold() { // LZ_CN_TW_HOLD_20260924
    var shipMode = String(document.querySelector('[data-live-ship-mode]')?.value || document.querySelector('[data-admin-shipment-ship-mode]')?.value || '');
    if (shipMode === 'china_to_taiwan' || shipMode === 'cn_to_tw') return true;
    var route = typeof adminLiveRouteProfile === 'function' ? adminLiveRouteProfile(shipMode) : null;
    return !!(route && route.sourceCode === 'CN' && route.destinationCode === 'TW');
  }

  function reservedHoldReasonLabel(code) {
    var found = reservedHoldReasonOptions().find(function (row) { return row.id === String(code || ''); });
    return found ? found.label : '';
