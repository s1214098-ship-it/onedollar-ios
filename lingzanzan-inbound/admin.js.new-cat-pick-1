        if (!res.ok || payload.ok === false) throw new Error(payload.error || '無法讀取下線結算資料');
        var rows = payload && payload.state && Array.isArray(payload.state.resellerSettlements) ? payload.state.resellerSettlements.slice() : [];
        var id = 'RSL-' + String(orderId).replace(/[^A-Za-z0-9_-]/g, '-');
        var existing = rows.find(function (row) { return String(row.id || '') === id || String(row.orderId || '') === String(orderId); });
        var now = new Date().toISOString();
        var entry = Object.assign({}, reseller, {
          id: existing && existing.id || id, orderId: String(orderId), date: String(orderDate || now).slice(0, 10),
          createdAt: existing && existing.createdAt || now, updatedAt: now
        });
