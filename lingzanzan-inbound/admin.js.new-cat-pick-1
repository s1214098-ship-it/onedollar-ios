  function freightReminderDate(row) {
    var candidates = [row && row.consolidationDate, row && row.date, row && row.createdAt];
    for (var i = 0; i < candidates.length; i += 1) {
      var raw = String(candidates[i] || '').trim();
      if (!raw) continue;
      var shortDate = raw.match(/^(\d{1,2})[\/-](\d{1,2})$/);
      if (shortDate) {
        var year = new Date().getFullYear();
        var month = Number(shortDate[1]);
        var day = Number(shortDate[2]);
        var localTime = new Date(year, month - 1, day).getTime();
        if (Number.isFinite(localTime)) return { time: localTime, text: year + '-' + String(month).padStart(2, '0') + '-' + String(day).padStart(2, '0') };
      }
      var time = Date.parse(raw);
      if (Number.isFinite(time)) return { time: time, text: raw.slice(0, 10) };
    }
    return null;
  }

  function freightReminderCompleted(row) {
    var text = [row && row.status, row && row.progress, row && row.issueProgress].join(' ').toLowerCase();
    return /已入庫|已分攤成本|已完成|完成|結案|已退貨|已退款|取消|退回供應商|closed|completed|returned|refunded|cancelled|canceled/.test(text);
  }

  function freightReminderProvider(row, batch) {
    var text = (batch && (batch.forwarder || batch.provider)) || (row && (row.forwarder || row.progress || row.platform)) || '未指定集運';
    return String(text || '未指定集運').trim();
  }

  function renderFreightOverdueAlerts() {
    var host = document.querySelector('[data-freight-overdue-alerts]');
    if (!host) return;
    var freight = normalizeFreightTracking(state.freightTracking);
    var now = new Date();
    var groups = {};
    var undated = 0;
    var batchIdsWithItems = new Set();
    var activeFreightWorkline = freightCurrentWorkline();
    freight.items.filter(function (item) { return freightWorklineForItem(item) === activeFreightWorkline; }).forEach(function (item) {
      if (item.batchId) batchIdsWithItems.add(String(item.batchId));
      if (freightReminderCompleted(item)) return;
      var dateInfo = freightReminderDate(item);
      if (!dateInfo) { undated += 1; return; }
      var days = Math.floor((now.getTime() - dateInfo.time) / 86400000);
      if (days < 10) return;
      var batch = freightBatchById(item.batchId) || null;
      var provider = freightReminderProvider(item, batch);
      var key = item.batchId ? 'batch:' + item.batchId : 'provider:' + provider;
      if (!groups[key]) groups[key] = { provider: provider, label: item.batchId ? freightBatchLabel(batch || { id: item.batchId }) : provider, rows: 0, qty: 0, oldestDays: days, oldestDate: dateInfo.text, examples: [] };
      groups[key].rows += 1;
      groups[key].qty += Math.max(1, Number(item.quantity || item.qty || 1));
      if (days > groups[key].oldestDays) { groups[key].oldestDays = days; groups[key].oldestDate = dateInfo.text; }
      if (groups[key].examples.length < 4) groups[key].examples.push([item.trackingNo || '-', item.productName || item.productCode || '-', dateInfo.text].join(' / '));
    });
    freight.batches.filter(function (batch) { return freightWorklineForBatch(batch) === activeFreightWorkline; }).forEach(function (batch) {
      if (batchIdsWithItems.has(String(batch.id || '')) || freightReminderCompleted(batch)) return;
      var dateInfo = freightReminderDate(batch);
      if (!dateInfo) { undated += 1; return; }
      var days = Math.floor((now.getTime() - dateInfo.time) / 86400000);
      if (days < 10) return;
      var provider = freightReminderProvider(null, batch);
      var key = 'batch:' + String(batch.id || batch.batchNo || provider);
      groups[key] = { provider: provider, label: freightBatchLabel(batch), rows: 1, qty: Math.max(0, Number(batch.itemCount || batch.unitCount || 0)), oldestDays: days, oldestDate: dateInfo.text, examples: [[batch.logisticsTrackingNo || batch.taiwanTrackingNo || '-', batch.batchNo || batch.id || '-', dateInfo.text].join(' / ')] };
    });
    var rows = Object.keys(groups).map(function (key) { return groups[key]; }).sort(function (a, b) { return b.oldestDays - a.oldestDays; });
    var overdueCount = rows.reduce(function (sum, group) { return sum + group.rows; }, 0);
    if (!rows.length) {
      host.classList.remove('has-overdue');
      host.innerHTML = '<header><div><small>10 DAY FREIGHT CHECK</small><h3>集運 10 天提醒</h3></div><strong>目前沒有逾期未處理</strong></header>' + (undated ? '<p class="freight-overdue-undated">另有 ' + undated + ' 筆未填有效日期，無法判斷是否超過 10 天。</p>' : '');
      return;
    }
    host.classList.add('has-overdue');
    host.innerHTML = '<header><div><small>10 DAY FREIGHT CHECK</small><h3>集運超過 10 天尚未完成</h3><p>只要狀態還不是「已入庫／已完成／已分攤成本」，第 10 天起就持續提醒。</p></div><strong>' + overdueCount + ' 筆待處理</strong></header><div class="freight-overdue-grid">' + rows.map(function (group) {
      return '<article><header><div><b>' + escapeHtml(group.provider) + '</b><span>' + escapeHtml(group.label) + '</span></div><strong>最久 ' + group.oldestDays + ' 天</strong></header><p>' + group.rows + ' 筆物流／' + group.qty + ' 件；最早日期 ' + escapeHtml(group.oldestDate) + '</p><details><summary>查看物流明細</summary>' + group.examples.map(function (line) { return '<small>' + escapeHtml(line) + '</small>'; }).join('') + (group.rows > group.examples.length ? '<em>另有 ' + (group.rows - group.examples.length) + ' 筆，可用下方搜尋查看。</em>' : '') + '</details></article>';
    }).join('') + '</div>' + (undated ? '<p class="freight-overdue-undated">另有 ' + undated + ' 筆未填有效日期，請補日期後才能納入 10 天提醒。</p>' : '');
  }

  function freightBalanceKey(item) {
    var raw = item && (item.code || item.productCode || item.productId || item.sku || item.skuId || item.barcode || item.sampleBarcode || item.taiwanBarcode || item.productName || item.title || '');
    var family = scanFamilyCode(raw || '');
    return normalizeScanCode(family || raw || '').replace(/^P-/, '');
  }

  // 本機420：預購配貨固定先用台灣倉，再用中國倉可配數量。
  // 一般中國倉同一正式規格固定保留 1 件樣品；GB4 全部是客戶貨，不保留樣品。
  function preorderChinaCustomerStockOnly(productCode) {
    return String(productCode || '').trim().toUpperCase() === 'GB4';
  }

  function finalizePreorderChinaStockBucket(bucket) {
    if (!bucket) return bucket;
    var physical = Math.max(0, Number(bucket.CN || 0));
    var customerOnly = preorderChinaCustomerStockOnly(bucket.productKey);
    bucket.CNPhysical = physical;
    bucket.CNSampleReserved = customerOnly ? 0 : Math.min(1, physical);
    bucket.CNCustomerStock = customerOnly ? physical : 0;
    bucket.CN = customerOnly ? physical : Math.max(0, physical - bucket.CNSampleReserved);
    return bucket;
  }

  function preorderChinaStockCaption(bucket) {
    if (!bucket) return '次順位可配 0';
    if (preorderChinaCustomerStockOnly(bucket.productKey)) return 'GB4 客戶貨 ' + Number(bucket.CNCustomerStock || 0);
    return '可配 ' + Number(bucket.CN || 0) + '／樣品保留 ' + Number(bucket.CNSampleReserved || 0);
  }

