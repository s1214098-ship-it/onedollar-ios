    if (isDelivered(row)) return 'delivered';
    if (!String(no || '').trim()) return 'missing';
    if (/查無|無資料|没有资料|沒有資料|tidak ada data|no data|not found/i.test(text)) return 'no_data';
    if (/訂單已成立|訂單成立未寄件|尚未至門市|尚未交寄|未交寄|未寄件|未寄出|未到店家交寄|建單未寄/i.test(text)) return 'not_handed';
    if (/已到門市|到店|待取|門市取件|取件門市|配達取件門市|取件店舖|取件店铺/i.test(text)) return 'arrived_store';
    if (/配送中|物流配送中|已交寄|已寄出|物流中心|轉運|運送中|發貨|集運中|已集運|待簽收|寄件門市已收件|門市已收件|入帳成功|交寄郵件/i.test(text)) return 'in_transit';
    return 'undelivered';
