  function freightFifoCollectWaitNotifyRows() {
    var seen = new Set();
    var rows = [];
    function add(row) {
      if (!row || !freightFifoRowMatchesScope(row)) return;
      if (String(row.freightCustomerQueueDecision || '') === 'deferred') return;
      var status = String(row.status || '').toLowerCase();
      if (['cancelled', 'returned', 'delivered', 'completed', 'draft'].indexOf(status) !== -1) return;
      var inquiry = freightFifoSourceInquiry(row);
      if (!freightFifoIsWaitNotify(row) && !freightFifoIsWaitNotify(inquiry)) return;
      var pair = freightFifoWaitNotifyTargetIds(row);
      var key = pair.inquiryId || pair.orderId || String(row.id || '');
      if (!key || seen.has(key)) return;
      seen.add(key);
      if (pair.inquiryId) seen.add(pair.inquiryId);
      if (pair.orderId) seen.add(pair.orderId);
      rows.push(row);
    }
    (state.inquiries || []).forEach(function (row) {
      if (preorderInquiryConverted(row)) return;
      add(row);
    });
    (state.orders || []).forEach(function (order) {
      if (!order) return;
      var status = String(order.status || '').toLowerCase();
      var delivery = String(order.deliveryState || '').toLowerCase();
      if (status === 'shipped' || status === 'in_transit' || delivery === 'in_transit' || delivery === 'delivered') return;
      add(order);
    });
    rows.sort(function (a, b) {
      return freightFifoWaitNotifyMeta(a).sortTime - freightFifoWaitNotifyMeta(b).sortTime
        || String(a && a.id || '').localeCompare(String(b && b.id || ''), 'zh-Hant', { numeric: true });
