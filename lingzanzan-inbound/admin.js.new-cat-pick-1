  function finishFreightBatchReceiving(batchId, control) {
    var batch = freightBatchById(batchId);
    if (!batch) { toast('找不到要完成的物流批次'); return Promise.resolve(false); }
    var summary = freightBatchReceivingSummary(batch);
    if (!summary.startedAt) { toast('請先掃描本批第一筆物流單號'); return Promise.resolve(false); }
    if (summary.missingQty > 0) {
      showFreightBatchMissingPrompt(batch);
      toast('本批尚缺 ' + summary.missingQty + ' 件，請繼續逐筆掃描；滿 3 天會自動提醒追貨');
      return Promise.resolve(false);
    }
    if (control) {
      control.disabled = true;
      control.setAttribute('data-idle-label', control.getAttribute('data-idle-label') || control.textContent || '');
      control.textContent = '正在完成本批並準備後續作業…';
    }
    var now = new Date().toISOString();
    var operator = freightReceivingOperator();
    var costTotalTwd = Math.max(0, Number(batch.chargeTotalTwd || batch.amount || 0));
    var provider = String(batch.provider || '').toLowerCase();
    var customsBasisQty = Math.max(0, Number(batch.customsPackageCount || 0));
    var finalCostBasisQty = provider === 'pinduoduo' && customsBasisQty > 0
      ? customsBasisQty
      : Math.max(0, Number(summary.receivedQty || 0));
    batch.costBasisQty = finalCostBasisQty;
    batch.costBasisSource = provider === 'pinduoduo' && customsBasisQty > 0
      ? '寶輝關稅登記件數'
      : '本批最終實收件數';
    batch.costAverageTwd = finalCostBasisQty > 0 ? Math.round(costTotalTwd / finalCostBasisQty * 100) / 100 : 0;
    batch.allocationPerItem = batch.costAverageTwd;
    saveFreightBatchReceivingState(batch, summary, { now: now, completedAt: now, operator: operator });
    batch.receivedBy = operator.label;
    batch.completedBy = operator.label;
    batch.statusHistory = Array.isArray(batch.statusHistory) ? batch.statusHistory : [];
    if (summary.missingQty > 0) {
      batch.status = '缺件待處理';
      batch.issueType = '缺件';
      batch.issueProgress = '待處理';
      batch.missingConfirmedAt = now;
      batch.statusHistory.push({ status: '缺件待處理', at: now, by: operator.label, missingQty: summary.missingQty, overQty: summary.overQty, costBasisQty: finalCostBasisQty, costAverageTwd: batch.costAverageTwd });
    } else {
      batch.status = '已驗收進貨';
      batch.issueType = '';
      batch.issueProgress = '';
      batch.receivedAt = now;
      batch.statusHistory.push({ status: '已驗收進貨', at: now, by: operator.label, missingQty: 0, overQty: summary.overQty, costBasisQty: finalCostBasisQty, costAverageTwd: batch.costAverageTwd });
    }
    var progress = batch.status;
    state.freightTracking.items = normalizeFreightTracking(state.freightTracking).items.map(function (item) {
      return String(item.batchId || '') === String(batchId || '') ? Object.assign({}, item, { progress: progress, issueType: summary.missingQty > 0 ? '缺件' : (item.issueType || ''), updatedAt: now, receivedBy: operator.label, checkedBy: operator.label }) : item;
    });
    return saveFreightTracking().then(function () {
      toast('本批點貨已完成；現在逐筆處理產品條碼、正式入庫、客戶配對與出貨');
      renderFreightTracking();
      setTimeout(function () { openFreightBatchNextSteps(batchId); }, 120);
      return true;
    }).catch(function (error) {
      if (control) {
        control.disabled = false;
        control.textContent = control.getAttribute('data-idle-label') || '完成本批點貨';
      }
      toast(error.message || '完成點貨失敗');
      return false;
    });
  }

