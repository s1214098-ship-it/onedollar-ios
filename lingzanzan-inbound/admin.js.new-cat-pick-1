      if (token !== freightExistingImageToken) return;
      draftHashes = draftHashes.filter(Boolean);
      var candidates = unifiedProductRecognitionCatalog().filter(function (catalogRow) {
        return freightLookupCatalogAllowed(catalogRow.product) && productImageSources(catalogRow.product).length > 0;
