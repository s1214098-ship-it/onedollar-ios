    var reason = String(reasonInput && reasonInput.value || '').trim();
    if (!reason) {
      reason = isGift ? '管理者設為贈品' : (qty !== oldQty ? '管理者調整數量 ' + oldQty + '→' + qty : '管理者調整商品金額');
