    var isStoreOrHome = /7\s*-?\s*11|711|全家|超商|宅配|住家|home|store|family/i.test(deliveryText);
    if (modeInput && !String(modeInput.value || '').trim() && total > 0 && isStoreOrHome) modeInput.value = hasDeposit ? 'deposit_cod' : 'cod_full';
    if (isIndonesiaSalesCollectionMode(String((modeInput || {}).value || ''))) {
      if (partyInput) partyInput.value = 'sales';
