  }

  function freightFifoPriorityProductRows(source, keyword) {
    source = String(source || 'PREORDER').toUpperCase();
    keyword = normalizeLiveCode(keyword || '');
    var products = {};
    (state.products || []).forEach(function (product) {
      if (product && product.id) products[String(product.id)] = product;
    });
    var seen = {};
    var formalRows = (state.skus || []).filter(function (sku) {
      if (!sku || sku.archived === true || sku.active === false || String(sku.status || '').toLowerCase() === 'inactive') return false;
      if (source === 'ALL' && freightSkuWarehouseCode(sku) === 'CN' && !canUseChinaWarehouseForTaiwanLiveOrder()) return false;
      if (source !== 'PREORDER' && source !== 'ALL' && freightSkuWarehouseCode(sku) !== source) return false;
      var product = products[String(sku.productId || '')] || {};
      var searchable = searchLooseNormalize([
        product.code, product.productLine, product.title, product.name, product.frontTitle,
        product.englishName, product.nameEn, product.titleEn, product.englishTitle,
        product.category, product.categoryName, product.productCategory, product.brand, product.brandName,
        Array.isArray(product.nameAliases) ? product.nameAliases.join(' ') : '',
        sku.id, sku.sku, sku.companyBarcode, sku.barcode,
        sku.colorName, sku.color, sku.sizeName, sku.size
      ].filter(Boolean).join(' '));
      var needle = searchLooseNormalize(keyword);
      return !needle || searchable.indexOf(needle) !== -1;
    }).filter(function (sku) {
      if (source !== 'PREORDER') return true;
      var key = [
        String(sku.productId || ''),
        freightDemandIdentity(sku.colorName || sku.color),
        freightDemandIdentity(canonicalNoSize(sku.sizeName || sku.size || 'NO SIZE'))
      ].join('|');
      if (seen[key]) return false;
      seen[key] = true;
      return true;
    }).map(function (sku) {
      var product = products[String(sku.productId || '')] || {};
      return {
        sku: sku,
        product: product,
        code: product.code || product.productLine || sku.productCode || '',
        title: product.title || product.name || sku.productName || '未命名商品',
        color: sku.colorName || sku.color || '未設定顏色',
        size: canonicalNoSize(sku.sizeName || sku.size || 'NO SIZE'),
        image: sku.colorImage || sku.image || product.image || product.cover || '',
        stock: Math.max(0, Number(sku.stock || 0)),
        price: zhangzhangSalePriceForSku(product, sku),
        source: source === 'PREORDER' ? 'PREORDER' : freightSkuWarehouseCode(sku)
      };
    });
    var freightRows = (source === 'PREORDER' || source === 'ALL') ? manualPreorderFreightSkuRows().map(function (entry) {
      var sku = entry.sku || {};
      var product = entry.product || {};
      var searchable = searchLooseNormalize([
        product.code, product.productCode, product.title, product.name,
        product.category, product.categoryName, product.productCategory, product.brand, product.brandName,
        sku.id, sku.sku, sku.companyBarcode, sku.barcode,
        sku.colorName, sku.color, sku.sizeName, sku.size
      ].filter(Boolean).join(' '));
      var needle = searchLooseNormalize(keyword);
      if (needle && searchable.indexOf(needle) === -1) return null;
      return {
        sku: sku,
        product: product,
        code: product.code || product.productCode || (product.temporaryFreightProduct ? '預購暫存' : ''),
        title: product.title || product.name || '未命名商品',
        color: sku.colorName || sku.color || '未設定顏色',
        size: canonicalNoSize(sku.sizeName || sku.size || 'NO SIZE'),
        image: sku.colorImage || product.mainImage || '',
        stock: Math.max(0, Number(sku.forecastAvailable || entry.forecastAvailable || 0)),
        price: zhangzhangSalePriceForSku(product, sku),
        source: 'PREORDER',
        temporaryFreightProduct: !!product.temporaryFreightProduct,
        freightSourceId: product.freightSourceId || ''
      };
    }).filter(Boolean) : [];
    var combined = formalRows.concat(freightRows).filter(function (row, index, rows) {
      var sku = row.sku || {};
      var key = [String(row.product && row.product.id || ''), String(sku.id || sku.sku || ''), row.color, row.size, row.source || source].join('|');
      return rows.findIndex(function (candidate) {
        var candidateSku = candidate.sku || {};
        return [String(candidate.product && candidate.product.id || ''), String(candidateSku.id || candidateSku.sku || ''), candidate.color, candidate.size, candidate.source || source].join('|') === key;
      }) === index;
    });
    return combined.sort(function (left, right) {
      if (source !== 'PREORDER' && right.stock !== left.stock) return right.stock - left.stock;
      return String(left.code || left.title).localeCompare(String(right.code || right.title), 'zh-Hant');
    }).slice(0, 30);
  }

  function freightFifoRenderPriorityProducts(modal) {
    var panel = modal && modal.querySelector('[data-freight-fifo-priority-add]');
    if (!panel) return;
    var source = String((panel.querySelector('[data-freight-fifo-priority-source]') || {}).value || 'PREORDER');
    var query = String((panel.querySelector('[data-freight-fifo-priority-search]') || {}).value || '').trim();
    var result = panel.querySelector('[data-freight-fifo-priority-results]');
    if (!result) return;
    if (query.length < 2) {
      result.innerHTML = '<p class="empty-state">輸入產品編號、條碼或名稱至少 2 個字。</p>';
      panel._priorityRows = [];
      return;
    }
    var pendingFreightKey = String(query || '').replace(/[^a-z0-9]/gi, '').toLowerCase();
    var pendingFreightState = adminPreorderPendingFreightSearchCache[pendingFreightKey];
    if ((source === 'PREORDER' || source === 'ALL') && pendingFreightKey && !(pendingFreightState && Array.isArray(pendingFreightState.rows))) {
      result.innerHTML = '<p class="empty-state">正在同步最新預購倉與豪鴻商品...</p>';
      panel._priorityRows = [];
      loadManualPreorderPendingFreightRows(query).then(function () {
        if (modal && modal.parentNode) freightFifoRenderPriorityProducts(modal);
      });
      return;
    }
    if (!(state.products || []).length || !(state.skus || []).length) {
      result.innerHTML = '<p class="empty-state">正在載入正式商品與庫存，請稍候...</p>';
      panel._priorityRows = [];
      ensureAdminOrderAdjustmentCatalogData().then(function () {
        if (modal && modal.parentNode) freightFifoRenderPriorityProducts(modal);
      }).catch(function () {
        result.innerHTML = '<p class="empty-state">商品資料載入失敗，請重試。</p>';
      });
      return;
    }
    var rows = freightFifoPriorityProductRows(source, query);
    panel._priorityRows = rows;
    result.innerHTML = rows.length ? rows.map(function (row, index) {
      var rowSource = row.source || source;
