    var orderIndex = (state.orders || []).findIndex(function (order) { return String(order && order.id || '') === orderId; });
    if (!modal || !orderId || !Number.isInteger(itemIndex)) { toast('請先轉成正式出貨單再調整商品'); return; }
    var qtyInput = modal.querySelector('[data-freight-fifo-edit-item-qty="' + itemIndex + '"]');
