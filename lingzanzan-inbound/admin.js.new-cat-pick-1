      Array.from(clipboard.items).forEach(function (item) {
        if (String(item && item.type || '').match(/^image\//) && item.getAsFile) {
          var file = item.getAsFile();
          if (file && files.indexOf(file) < 0) files.push(file);
        }
      });
    }
    var imageFiles = files.filter(function (file) {
      return String(file.type || '').match(/^image\//);
    });
    return filesToDataUrls(imageFiles);
  }

