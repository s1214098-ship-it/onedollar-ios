    }
    var index = new Map();
    for (var productIndex = 0; productIndex < products.length; productIndex += 1) {
      var product = products[productIndex] || {};
      var info = {
        id: String(product.id || '').trim(),
        code: String(product.code || product.barcode || '').trim(),
        title: String(product.title || product.name || '').trim(),
        filedAt: String(product.updatedAt || product.createdAt || '').trim(),
        source: 'product-catalog'
      };
      var linkedIds = [product.freightItemId, product.costFreightItemId];
      for (var collectionIndex = 0; collectionIndex < collections.length; collectionIndex += 1) {
        var rows = Array.isArray(product[collections[collectionIndex]]) ? product[collections[collectionIndex]] : [];
        rows.forEach(function (row) {
          row = row || {};
          linkedIds.push(row.freightItemId, row.costFreightItemId, row.sourceItemId);
        });
      }
      linkedIds.forEach(function (value) {
        var itemId = String(value || '').trim();
        if (itemId && !index.has(itemId)) index.set(itemId, Object.assign({}, info, { inventoryReceived: freightProductInventoryReceiptForItem(product, itemId) }));
