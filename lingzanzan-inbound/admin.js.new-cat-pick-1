  function reservedHoldReasonFromHost(host, reasonSelector, otherSelector, required) {
    if (!host) return required === false
      ? { code: 'scheduled_ship', text: '預約指定出貨日' }
      : { error: '找不到寄庫欄位' };
    var code = String((host.querySelector(reasonSelector || '[data-reserved-hold-reason]') || {}).value || '').trim();
    var other = String((host.querySelector(otherSelector || '[data-reserved-hold-reason-other]') || {}).value || '').trim();
    if (!code) {
      if (required === false) return { code: 'scheduled_ship', text: '預約指定出貨日' };
      return { error: '寄庫請先選擇原因' };
    }
    if (code === 'other' && !other) return { error: '選「其他」時請填寫原因' };
    return {
      code: code,
      text: code === 'other' ? other : reservedHoldReasonLabel(code)
    };
  }

  function freightFifoNoteLooksHold(text) {
    return /寄庫|等待直播|等直播|先不出貨/.test(String(text || ''));
  }

  function freightFifoHoldFromNotes(noteBlob) {
    noteBlob = String(noteBlob || '');
    if (/先不出貨/.test(noteBlob)) return { code: 'hold_no_ship', text: '先不出貨' };
    if (/等待直播|等直播/.test(noteBlob)) return { code: 'wait_live', text: '等待直播' };
    if (/寄庫/.test(noteBlob)) return { code: 'wait_other', text: '等其他商品到齊' };
    return null;
  }

  function freightFifoParcelsHeldPending(parcels) {
    return (Array.isArray(parcels) ? parcels : []).map(function (parcel) {
      parcel = Object.assign({}, parcel || {});
      var state = String(parcel.deliveryState || parcel.status || '').toLowerCase();
      if (['delivered', 'returned', 'arrived_store'].indexOf(state) === -1) {
        parcel.deliveryState = 'pending';
        parcel.status = 'pending';
      }
      return parcel;
    });
  }

  function freightFifoReservationPayload(modal, dispatchDecision) {
    dispatchDecision = String(dispatchDecision || '').trim();
    var reservedDate = String((modal && modal.querySelector('[data-freight-fifo-reserved-date]') || {}).value || '').trim();
    var reservedNote = String((modal && modal.querySelector('[data-freight-fifo-reserved-note]') || {}).value || '').trim();
    var shippingNote = String((modal && modal.querySelector('[data-freight-fifo-note]') || {}).value || '').trim();
    var trackingNo = freightFifoPrimaryTrackingNo(modal);
    var hold = reservedHoldReasonFromHost(modal, '[data-freight-fifo-hold-reason]', '[data-freight-fifo-hold-reason-other]', false);
    if (hold.error) {
      return {
        reservedDate: reservedDate,
        note: reservedNote,
        holdReason: '',
        holdReasonText: '',
        shouldReserve: false,
        isHold: false,
        error: hold.error
      };
    }
    var noteBlob = [reservedNote, shippingNote, hold.text].join(' ');
    var inferredHold = freightFifoHoldFromNotes(noteBlob);
    // 先不出貨／寄庫備註優先於「有單號就現在寄出」
    if (inferredHold && (!hold.code || hold.code === 'scheduled_ship')) {
      hold = inferredHold;
    }
    if (dispatchDecision === 'wait_all' && (!hold.code || hold.code === 'scheduled_ship')) {
      hold = /等待直播|等直播/.test(noteBlob)
        ? { code: 'wait_live', text: '等待直播' }
        : { code: 'wait_other', text: '等其他商品到齊' };
    }
    if (dispatchDecision === 'ask_sales' && (!hold.code || hold.code === 'scheduled_ship')) {
      hold = { code: 'sales_no_ship', text: reservedHoldReasonLabel('sales_no_ship') };
    }
    var isHold = !!(hold.code && hold.code !== 'scheduled_ship');
    var shouldReserve = !!reservedDate || isHold || dispatchDecision === 'wait_all' || dispatchDecision === 'ask_sales';
    return {
      reservedDate: reservedDate,
      note: reservedNote,
      holdReason: hold.code || (reservedDate ? 'scheduled_ship' : ''),
      holdReasonText: hold.text || (reservedDate ? '預約指定出貨日' : ''),
      shouldReserve: shouldReserve,
      isHold: isHold,
      error: ''
    };
  }

  function reservedShippingLane(row) {
    if (!row || String(row.reservedShippingStatus || '') === 'cancelled') return '';
    if (orderIsCnTwInTransit(row)) return 'hold';
    var reason = String(row.reservedShippingHoldReason || '').trim();
    var note = [
      row.shippingNote,
      row.reservedShippingNote,
      row.reservedShippingHoldReasonText
    ].join(' ');
    // 先不出貨／寄庫可先填單號，仍留在寄庫，不能因單號被推進配送中。
    if ((reason && reason !== 'scheduled_ship') || freightFifoNoteLooksHold(note)) return 'hold';
    // 已建立正式出貨物流後，就應進入第 5 區核對；即使早於預約日
    // 出貨，也不能繼續留在寄庫／預約排程造成同單重複。
    if (freightFifoTrackingJoin(row)) return '';
    if (String(row.reservedShippingStatus || '') === 'reserved') return 'schedule';
    return '';
  }

  function reservedShippingInquiryIsOpen(inquiry) {
    var status = String(inquiry && inquiry.status || '').toLowerCase();
    if (['cancelled', 'converted', 'shipped', 'in_transit', 'delivered', 'completed', 'returned'].indexOf(status) !== -1) return false;
    if (String(inquiry && inquiry.convertedOrderId || '').trim()) return false;
