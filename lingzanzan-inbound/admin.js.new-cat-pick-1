  var freightReceivedPrintPayloads = [];

  function freightPrintCustomerDetails(link) {
    link = link || {};
    var inquiryId = String(link.inquiryId || link.customerOrderNo || '').trim();
    var inquiry = (state.inquiries || []).find(function (row) {
      return String(row.id || '') === inquiryId;
    }) || {};
    var customer = inquiry.customer || {};
    return {
      customerName: String(link.customerName || customer.name || inquiry.customerName || '').trim(),
