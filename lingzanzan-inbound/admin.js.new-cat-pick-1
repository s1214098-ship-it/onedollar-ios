  var freightProgressSavePromises = {};

  function saveExistingFreightProgress() {
    var idInput = document.querySelector('[data-freight-item-id]');
    var progressInput = document.querySelector('[data-freight-progress]');
    var itemId = String(idInput?.value || '').trim();
    var progress = String(progressInput?.value || '').trim();
    if (!itemId || !progress) return Promise.resolve(null);
    var existing = freightItemById(itemId);
    if (!existing) {
      toast('找不到正在編輯的物流資料，請重新整理後再試');
      return Promise.resolve(null);
    }
    var inferredDestination = freightDestinationFromReceivingStatus(progress);
    var destinationAlreadyCorrect = !inferredDestination || String(existing.destinationWarehouse || '').trim() === inferredDestination.code;
    if (String(existing.progress || '').trim() === progress && destinationAlreadyCorrect) return Promise.resolve(existing);
    var saveKey = itemId + '|' + progress + '|' + (inferredDestination && inferredDestination.code || '');
    if (freightProgressSavePromises[saveKey]) return freightProgressSavePromises[saveKey];
    if (progressInput) progressInput.disabled = true;
    var progressPatch = {
      id: itemId,
      progress: progress
    };
    if (inferredDestination) {
      progressPatch.destinationWarehouse = inferredDestination.code;
      progressPatch.destinationSite = inferredDestination.site;
      progressPatch.handlingPerItemTwd = inferredDestination.handlingPerItem;
    }
    var mutationId = 'freight-progress-' + Date.now() + '-' + Math.random().toString(36).slice(2, 9);
    freightProgressSavePromises[saveKey] = saveFreightItemRecord(progressPatch, mutationId).then(function (savedItem) {
      if (String(document.querySelector('[data-freight-item-id]')?.value || '').trim() === itemId && progressInput) progressInput.value = progress;
      if (inferredDestination && String(document.querySelector('[data-freight-item-id]')?.value || '').trim() === itemId) {
        var destinationInput = document.querySelector('[data-freight-destination]');
        if (destinationInput) destinationInput.value = inferredDestination.code;
        renderFreightAutoCost();
      }
      toast(inferredDestination
        ? '處理進度已儲存，產品建檔收貨倉自動判定為「' + inferredDestination.warehouse + '／' + inferredDestination.site + '」'
        : '處理進度已自動儲存');
      return savedItem || Object.assign({}, existing, progressPatch);
    }).catch(function (error) {
      if (String(document.querySelector('[data-freight-item-id]')?.value || '').trim() === itemId && progressInput) progressInput.value = existing.progress || '待下單';
      toast(error.message || '處理進度儲存失敗');
      return null;
    }).finally(function () {
      delete freightProgressSavePromises[saveKey];
      if (progressInput) progressInput.disabled = false;
    });
    return freightProgressSavePromises[saveKey];
  }

  function freightPurchaseAccountValue(item) {
    var account = canonicalPurchasePlatformName(item && (item.purchaseAccount || item.platform) || '');
    return ['豪鴻未分類', '多帳號', '未填帳號', '待確認'].indexOf(account) >= 0 ? '' : account;
  }

  function freightBatchAllowsMultipleAccounts(batch) {
    return !!(batch && batch.allowMultiplePurchaseAccounts) ||
      freightBatchPurchaseAccounts(batch).length > 1 ||
      String(batch && batch.provider || '') === 'haohong' ||
      ['haohong_weight', 'haohong_batch', 'haohong_weight_batch'].indexOf(String(batch && batch.costMode || '')) >= 0 ||
      /豪鴻/.test(String(batch && batch.forwarder || ''));
  }

  function freightConsolidationAccountNames() {
    return ['拼郭', '拼直', '拼電', '拼張', '拼A'];
  }

  function freightBatchCostFormula(batch) {
    batch = batch || {};
    var provider = String(batch.provider || '').toLowerCase();
    if (['self_pickup', 'pinduoduo', 'haohong'].indexOf(provider) < 0) provider = 'pinduoduo';
    var destination = freightDestinationRule(batch.destinationWarehouse || batch.destinationSite);
    if (provider === 'self_pickup') destination = freightDestinationRule('CN_DONGGUAN');
    else if (!destination.code) destination = freightDestinationRule('TW_BAOHUI');
    var isDongguan = destination.code === 'CN_DONGGUAN';
    if (provider === 'self_pickup' || isDongguan) {
      return {
        provider: provider === 'self_pickup' ? 'self_pickup' : provider,
        logisticsSource: provider === 'self_pickup' ? 'self_pickup' : provider,
        costMode: provider === 'self_pickup' ? 'self_pickup' : 'dongguan_handling',
        chargeType: 'none',
        warehouseTaxType: 'tax_exempt',
        destinationWarehouse: 'CN_DONGGUAN',
        destinationSite: '東莞據點',
        handlingPerItemTwd: 30,
        forwarder: provider === 'self_pickup' ? '自取／東莞據點' : (batch.forwarder || '拼多多集運倉')
      };
    }
    if (provider === 'haohong') {
      return {
        provider: 'haohong',
        logisticsSource: 'haohong',
        costMode: 'haohong_batch',
        chargeType: 'shipping',
        warehouseTaxType: 'tax_exempt',
        destinationWarehouse: destination.code,
        destinationSite: destination.site,
        handlingPerItemTwd: destination.handlingPerItem,
        forwarder: '豪鴻集運倉'
      };
    }
    return {
      provider: 'pinduoduo',
      logisticsSource: 'pinduoduo',
      costMode: 'pinduoduo_batch',
      chargeType: 'tax',
      warehouseTaxType: 'taxable',
      destinationWarehouse: destination.code,
      destinationSite: destination.site,
      handlingPerItemTwd: destination.handlingPerItem,
      forwarder: '拼多多集運倉'
    };
  }

  function freightApplyBatchLastFilter(batch, item) {
    var formula = freightBatchCostFormula(batch);
    var allowsMultiple = freightBatchAllowsMultipleAccounts(Object.assign({}, batch, formula));
    var account = allowsMultiple
      ? (freightPurchaseAccountValue(item) || freightPurchaseAccountValue(batch))
      : canonicalPurchasePlatformName(batch.purchaseAccount || batch.platform || '');
    if (['多帳號', '豪鴻未分類', '未填帳號', '待確認'].indexOf(account) >= 0) account = '';
    return Object.assign({}, item, {
      logisticsSource: formula.logisticsSource,
      provider: formula.provider,
      forwarder: formula.forwarder,
      purchasePlatform: item.purchasePlatform || '拼多多',
      purchaseAccount: account,
      platform: account || item.platform || batch.platform,
      destinationWarehouse: formula.destinationWarehouse,
      destinationSite: formula.destinationSite,
      handlingPerItemTwd: formula.handlingPerItemTwd,
      costMode: formula.costMode,
      chargeType: formula.chargeType,
      warehouseTaxType: formula.warehouseTaxType,
      customerPriority: !!item.customerPriority || account === '拼張' || account === '拼A',
