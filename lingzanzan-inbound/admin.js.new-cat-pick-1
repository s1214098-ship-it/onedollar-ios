  function ensurePreorderSelectionSet() {
    if (!(state.preorderSelectedIds instanceof Set)) state.preorderSelectedIds = new Set();
    return state.preorderSelectedIds;
  }

  function syncPreorderSelectionFromInputs() {
    var selected = ensurePreorderSelectionSet();
    document.querySelectorAll('[data-admin-orders] [data-preorder-pick-summary], [data-preorder-list] [data-preorder-pick-summary]').forEach(function (input) {
      var id = input.value || '';
      if (!id) return;
      if (input.checked) selected.add(id);
      else selected.delete(id);
    });
    updatePreorderMergeShipmentStatus();
  }

  function syncPreorderInputsFromSelection() {
    var selected = ensurePreorderSelectionSet();
    document.querySelectorAll('[data-admin-orders] [data-preorder-pick-summary], [data-preorder-list] [data-preorder-pick-summary]').forEach(function (input) {
      input.checked = selected.has(input.value || '');
    });
    updatePreorderMergeShipmentStatus();
  }

  function selectedPreorderShipmentRows() {
    var selected = ensurePreorderSelectionSet();
    return (state.inquiries || []).filter(function (row) {
      return row && selected.has(String(row.id || ''));
    });
  }

  function preorderShipmentMergeValidation(rows) {
    rows = Array.isArray(rows) ? rows : [];
    if (rows.length < 2) return { ok: false, message: '請至少勾選同一客戶的 2 張預購單。' };
    var phoneKeys = {};
    var invalidPhoneIds = [];
    var notReadyIds = [];
    rows.forEach(function (row) {
      var customer = row.customer || {};
      var phone = preorderCustomerPhoneKey(customer.phone || row.customerPhone || row.phone || '');
      if (phone.length < 6) invalidPhoneIds.push(String(row.id || ''));
      else phoneKeys[phone] = true;
      var workflow = preorderWorkflowStatus(row);
      var ready = !workflow.converted && (!!row.reserved || (!!row.inventoryReceived && workflow.waitStatus === 'ready_to_ship'));
      if (!ready) notReadyIds.push(String(row.id || ''));
    });
    if (invalidPhoneIds.length) return { ok: false, message: '有 ' + invalidPhoneIds.length + ' 張未填完整電話，無法確認是同一客戶。' };
    if (Object.keys(phoneKeys).length !== 1) return { ok: false, message: '只能合併同一支電話的預購單，請重新勾選。' };
    if (notReadyIds.length) return { ok: false, message: '有 ' + notReadyIds.length + ' 張尚未到貨或尚未選「商品已齊／准許出貨」。' };
    return { ok: true, message: '已選 ' + rows.length + ' 張同客戶預購單，可合併當天出貨；運費只計一次。' };
  }

  function updatePreorderMergeShipmentStatus(message) {
    var output = document.querySelector('[data-preorder-merge-shipment-status]');
    var button = document.querySelector('[data-preorder-merge-shipment]');
    if (!output && !button) return;
    var rows = selectedPreorderShipmentRows();
    var validation = preorderShipmentMergeValidation(rows);
    if (output) {
      output.textContent = message || (rows.length ? validation.message : '尚未勾選；請在每張預購單左上角勾選。');
      output.classList.toggle('is-ready', !!validation.ok && !message);
      output.classList.toggle('is-error', !!rows.length && !validation.ok && !message);
    }
    if (button) button.disabled = !validation.ok;
  }

  function mergeSelectedPreordersForShipment(button) {
    syncPreorderSelectionFromInputs();
    var rows = selectedPreorderShipmentRows();
    var validation = preorderShipmentMergeValidation(rows);
    if (!validation.ok) {
      updatePreorderMergeShipmentStatus(validation.message);
      toast(validation.message);
      return;
    }
    rows.sort(function (a, b) {
      return String(a.createdAt || '').localeCompare(String(b.createdAt || '')) || String(a.id || '').localeCompare(String(b.id || ''));
    });
    var customer = rows[0].customer || {};
    var customerName = customer.name || rows[0].customerName || '此客戶';
    if (!window.confirm('確定把「' + customerName + '」的 ' + rows.length + ' 張預購單合併成今天同一批出貨嗎？\\n\\n系統會逐張扣除畫面所選倉庫的庫存；正式出貨仍保留原預購單來源，但運費只會計一次。')) return;
    if (button) button.disabled = true;
    updatePreorderMergeShipmentStatus('正在逐張轉正式出貨並核對庫存，請勿關閉頁面…');
    var login = currentLogin();
    var operatorName = login.name || login.account || '管理者';
    var convertedOrderIds = [];
    var completedInquiryIds = [];
    var mergedShipmentReference = '';
    var sequence = Promise.resolve();
    rows.forEach(function (row) {
      sequence = sequence.then(function () {
        var id = String(row.id || '');
        var warehouseSelect = document.querySelector('[data-preorder-fulfill="' + CSS.escape(id) + '"]');
        var fulfillWarehouse = warehouseSelect ? warehouseSelect.value : String(row.preorderFulfillWarehouse || row.preorderWarehouse || row.arrivalWarehouse || 'TW').toUpperCase();
        updatePreorderMergeShipmentStatus('正在處理 ' + (completedInquiryIds.length + 1) + '／' + rows.length + '：' + id);
        return callStockInquiryApi({
          action: 'convert',
          inquiryId: id,
          fulfillWarehouse: fulfillWarehouse,
          transferredBy: operatorName
        }).then(function (data) {
          var orderId = String(data && data.order && data.order.id || data && data.inquiry && (data.inquiry.convertedToOrderId || data.inquiry.orderId) || id);
          if (orderId) convertedOrderIds.push(orderId);
          completedInquiryIds.push(id);
        });
      });
    });
    sequence.then(function () {
      if (convertedOrderIds.length < 2) throw new Error('轉正式成功的訂單不足 2 張，尚未執行合併。');
      updatePreorderMergeShipmentStatus('正式出貨單已建立，正在合併運費與配送批次…');
      return callOrderAdmin({ action: 'merge-shipment', orderIds: convertedOrderIds });
    }).then(function (data) {
      if (Array.isArray(data.orders)) state.orders = data.orders;
      mergedShipmentReference = String(data.masterOrderId || data.shipmentMergeGroupId || convertedOrderIds[0] || '');
      ensurePreorderSelectionSet().clear();
      return refreshOrdersAndInquiries().then(function () {
        renderAll();
        updatePreorderMergeShipmentStatus('合併完成：' + rows.length + ' 張預購單已成為一張客戶合併單；運費只計一次。');
        toast('合併完成，正在開啟一張客戶合併單');
        window.setTimeout(function () { openCombinedShipmentCustomerCard(mergedShipmentReference); }, 120);
      });
    }).catch(function (error) {
      var completedText = completedInquiryIds.length ? '；已有 ' + completedInquiryIds.length + ' 張成功轉正式，請重新整理後到現貨訂單核對' : '';
      updatePreorderMergeShipmentStatus('合併未完成：' + (error.message || '未知錯誤') + completedText);
      toast((error.message || '預購合併出貨失敗') + completedText);
    }).finally(function () {
      if (button) button.disabled = !preorderShipmentMergeValidation(selectedPreorderShipmentRows()).ok;
    });
  }

