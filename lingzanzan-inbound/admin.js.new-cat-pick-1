  function orderTrackingBuildEntries() {
    var orders = Array.isArray(state.orders) ? state.orders.slice() : [];
    var inquiries = Array.isArray(state.inquiries) ? state.inquiries.slice() : [];
    var consumed = new Set();
    var result = { ready: [], preorder: [], live: [], inquiry: [] };
    // 舊版每一張詢問單都會重新掃一次全部訂單。先建立索引，避免資料量增加後呈平方級卡住。
    var ordersById = new Map();
    var ordersByInquiryId = new Map();
    function orderTrackingIsHiddenArchive(order) {
      if (!order) return false;
      if (order.revertedToWaitingAt || order.cancelledAt) return true;
      var status = String(order.status || order.internalStatus || '').toLowerCase();
      if (status === 'reverted_to_waiting' || status === 'cancelled' || status === 'canceled' || status === 'customer_cancelled') return true;
      if (String(order.deliveryState || '').toLowerCase() === 'cancelled') return true;
      return String(order.id || '').indexOf('REVERT-') === 0;
    }
    var trackingQuery = String((document.querySelector('[data-order-tracking-query]') || {}).value || '').trim();
    function hideArchiveUnlessSearching(order) {
      if (!orderTrackingIsHiddenArchive(order)) return false;
      return !trackingQuery;
    }
    orders.forEach(function (order) {
      if (!order || hideArchiveUnlessSearching(order)) return;
      var orderId = String(order.id || '');
      if (orderId) ordersById.set(orderId, order);
      [order.sourceInquiryId, order.convertedFromInquiryId, order.inquiryId].filter(Boolean).forEach(function (inquiryId) {
        inquiryId = String(inquiryId);
        if (!ordersByInquiryId.has(inquiryId)) ordersByInquiryId.set(inquiryId, []);
        ordersByInquiryId.get(inquiryId).push(order);
      });
    });
    inquiries.forEach(function (row) {
      if (!row || hideArchiveUnlessSearching(row)) return;
      var candidates = orderTrackingLinkIds(row).map(function (id) { return ordersById.get(String(id)); }).filter(Boolean);
      var inquiryId = String(row.id || '');
      candidates = candidates.concat(ordersByInquiryId.get(inquiryId) || []);
      var linkedOrder = candidates.find(function (order) { return !consumed.has(String(order && order.id || '')); }) || null;
      if (linkedOrder) consumed.add(String(linkedOrder.id || ''));
      var category = orderTrackingIsPreorderInquiry(row) ? 'preorder' : 'inquiry';
