  function applyFreightFifoReturnClientState(orderId, result) {
    var index = (state.orders || []).findIndex(function (row) { return String(row && row.id || '') === orderId; });
    if (index >= 0 && result && result.order) state.orders[index] = result.order;
    Object.keys((result && result.restockedStocks) || {}).forEach(function (skuId) {
      var sku = (state.skus || []).find(function (row) { return String(row && row.id || '') === skuId; });
      if (sku) sku.stock = Number(result.restockedStocks[skuId] || 0);
    });
    freightFifoTransitSelectedOrderIds.delete(orderId);
    freightFifoInvalidateQueueCaches();
  }

  function requestFreightFifoBlacklistFollowup(orderId, preview, options) {
    options = options || {};
    var shouldReturn = !!options.shouldReturn;
    var shouldLoss = !!options.shouldLoss;
    if (!orderId || (!shouldReturn && !shouldLoss)) return Promise.resolve({ skipped: true });
    var mutationId = (shouldReturn ? 'return-order-' : 'record-shipping-loss-') + orderId + '-' + Date.now() + '-' + Math.random().toString(36).slice(2, 9);
    return callOrderAdmin({
      action: shouldReturn ? 'return-order' : 'record-shipping-loss',
      orderId: orderId,
      reasonCode: 'blacklist',
      note: options.note || '黑名單退貨／業務分擔',
      fromBlacklist: true,
      shareWithSales: shouldLoss,
      createShippingLoss: shouldLoss,
      restock: shouldReturn,
      carrierKind: options.carrierKind || '',
      operator: currentLogin().name || currentLogin().account || '管理者',
      expectedUpdatedAt: String((preview && preview.updatedAt) || ''),
      clientMutationId: mutationId
    }).then(function (result) {
      applyFreightFifoReturnClientState(orderId, result);
      return result;
    });
  }

