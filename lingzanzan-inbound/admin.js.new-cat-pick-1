  function focusOrderTrackingTarget() {
    var params = new URLSearchParams(location.search);
    if (params.get('trackingFocus') !== '1' || document.body.dataset.orderTrackingTargetFocused === '1') return;
    var candidates = [params.get('order'), params.get('sourceOrder')].filter(Boolean);
    var target = null;
    candidates.some(function (id) {
      var escaped = CSS.escape(String(id));
      target = document.querySelector('[data-order-card="' + escaped + '"], [data-preorder-card="' + escaped + '"]');
      return !!target;
    });
    if (!target) {
      var attempts = Math.max(0, Number(document.body.dataset.orderTrackingTargetFocusAttempts || 0));
      if (attempts >= 16) {
        if (document.body.dataset.orderTrackingTargetFocusFailed !== '1') {
          document.body.dataset.orderTrackingTargetFocusFailed = '1';
          toast('已套用訂單搜尋，但資料仍在載入；請按一次重新整理');
        }
        return;
      }
      document.body.dataset.orderTrackingTargetFocusAttempts = String(attempts + 1);
      if (document.body.dataset.orderTrackingTargetFocusScheduled !== '1') {
        document.body.dataset.orderTrackingTargetFocusScheduled = '1';
        setTimeout(function () {
          delete document.body.dataset.orderTrackingTargetFocusScheduled;
          focusOrderTrackingTarget();
        }, Math.min(900, 180 + attempts * 55));
      }
      return;
    }
    document.body.dataset.orderTrackingTargetFocused = '1';
    delete document.body.dataset.orderTrackingTargetFocusScheduled;
    target.classList.add('order-tracking-focus-target');
    target.setAttribute('aria-label', '由訂單追蹤直接開啟的訂單');
    [120, 650, 1400, 2400, 3800, 5600].forEach(function (delay, index, delays) {
      setTimeout(function () {
        if (!document.body.contains(target)) return;
        target.scrollIntoView({ behavior: index === delays.length - 1 ? 'smooth' : 'auto', block: 'start' });
        if (index === 0) toast('已直接找到並開啟這筆訂單');
      }, delay);
    });
  }

