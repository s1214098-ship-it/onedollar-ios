  function refreshPreorderAfterBulk(message) {
    if (adminCurrentFileName() === 'admin-preorders.html' && adminPreorderServerSearchActive) {
      return refreshAdminPreorderServerSearch().then(function () {
        if (message) toast(message);
      });
    }
    return loadStockInquiries().then(function (rows) {
      state.inquiries = rows;
      renderOrders();
      if (message) toast(message);
    });
