      '<strong>第 ' + page + '／' + totalPages + ' 頁</strong>' +
      '<button type="button" class="ghost-button" data-freight-interlink-page="' + kind + '" data-page="' + Math.min(totalPages, page + 1) + '"' + (page >= totalPages ? ' disabled' : '') + '>下一頁</button>' +
      '</nav>';
