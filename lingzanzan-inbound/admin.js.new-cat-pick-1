              if (distance <= 40) score = Math.max(score, 96 - distance * 0.8);
              var colorDistance = imageColorDistance(hash, draftHash);
              if (distance <= 80 && colorDistance <= 70) score = Math.max(score, 82 - distance * 0.25);
              best = Math.max(best, score);
            });
          });
          return best >= 48 ? { product: product, score: best, catalogRow: catalogRow } : null;
        });
      })).then(function (matches) {
        if (token !== productImageSimilarityToken) return;
        matches = (matches || []).filter(Boolean).sort(function (a, b) { return b.score - a.score; }).slice(0, 6);
        renderProductImageSimilarity(matches, false);
      });
    }).catch(function () {
      if (token !== productImageSimilarityToken) return;
      renderProductImageSimilarity([], false);
    });
  }

