  function inventoryLabelPayloadsForTotal(payloads, total) {
    payloads = Array.isArray(payloads) ? payloads.filter(function (item) { return item && item.barcode; }) : [];
    total = Math.max(1, Math.min(99, Math.floor(Number(total) || 1)));
    if (!payloads.length) return [];
    var preferredFallback = payloads.find(function (item) { return item && item.preorderCustomer === false; }) || payloads[payloads.length - 1] || payloads[0];
    var labels = payloads.slice(0, total);
    while (labels.length < total) {
      labels.push(Object.assign({}, preferredFallback, {
        preorderCustomer: false,
        customerName: '',
        customerPhone: '',
        customerOrderNo: '',
        companyUnitIndex: labels.length + 1
      }));
    }
    return labels;
  }

  function openInventoryLabelPurposePicker(payloads, batchMode) {
    payloads = Array.isArray(payloads) ? payloads.filter(function (item) {
      return item && item.barcode;
    }) : [];
    if (!payloads.length) {
      toast('沒有可列印的條碼／Tidak ada barcode untuk dicetak');
      return;
    }
    closeInventoryLabelPurposePicker();
    var picker = document.createElement('div');
    var customerNames = payloads.map(function (item) {
      return labelCleanText(item.customerName || '');
    }).filter(Boolean);
    var receivingTotal = payloads.reduce(function (max, item) {
      return Math.max(max, Math.floor(Number(item && item.receivingLabelTotal || 0)));
    }, 0);
    var totalCountMode = receivingTotal > 0;
    var initialCopies = totalCountMode ? receivingTotal : 1;
    var customerSummary = customerNames.length
      ? '<br><b>預購客戶／Pelanggan preorder：</b>' + escapeHtml(customerNames.join('、'))
      : '';
    var variantSeen = {};
    var variantRows = payloads.reduce(function (rows, item) {
      var barcode = String(item && item.barcode || '').trim();
      var key = [normalizeScanCode(barcode), freightVariantIdentityKey(item)].join('|');
      if (!barcode || variantSeen[key]) return rows;
      variantSeen[key] = true;
      rows.push('<div><code>' + escapeHtml(barcode) + '</code><span>' + escapeHtml(item.color || '-') + '／' + escapeHtml(item.size || 'NO SIZE') + '</span></div>');
      return rows;
    }, []);
    var variantSummary = '<div class="inventory-label-purpose-summary"><b>本次條碼核對／Pemeriksaan barcode</b>'
      + variantRows.slice(0, 12).join('')
      + (variantRows.length > 12 ? '<small>另有 ' + (variantRows.length - 12) + ' 組，會依正式 SKU 分別列印。</small>' : '')
      + '</div>';
    function labelPurposeCopies() {
      var input = picker.querySelector('[data-label-purpose-copies]');
      var copies = Math.floor(Number(input && input.value || initialCopies));
      if (!Number.isFinite(copies) || copies < 1) copies = 1;
      return Math.min(99, copies);
    }
    function renderLabelPurposeSummary() {
      var summary = picker.querySelector('[data-label-purpose-summary]');
      if (!summary) return;
      var copies = labelPurposeCopies();
      var total = totalCountMode ? copies : payloads.length * copies;
      summary.innerHTML = '本次 ' + total + ' 個標籤／' + total + ' label' + customerSummary;
    }
    picker.className = 'inventory-label-purpose-picker';
    picker.setAttribute('data-inventory-label-purpose-picker', '');
    picker.innerHTML = [
      '<section role="dialog" aria-modal="true" aria-labelledby="inventory-label-purpose-title">',
      '<header><div><small>LABEL PURPOSE / TUJUAN LABEL</small><h3 id="inventory-label-purpose-title">選擇標籤用途／Pilih tujuan label</h3></div><button type="button" data-label-purpose-close aria-label="關閉／Tutup">×</button></header>',
      '<p>用途會直接印在每張條碼標籤底部，請先核對再輸出。<br><span>Tujuan akan dicetak pada bagian bawah setiap label.</span></p>',
      '<div class="inventory-label-purpose-options">',
      inventoryLabelPurposeOptions().map(function (item) {
        return '<label><input type="radio" name="inventory-label-purpose" value="' + escapeHtml(item.value) + '"' + (item.value === 'sample' ? ' checked' : '') + '><span><b>' + escapeHtml(item.zh) + '</b><small>' + escapeHtml(item.id) + '</small></span></label>';
      }).join(''),
      '</div>',
      '<label class="inventory-label-copy-field"><span>列印份數／Jumlah label</span><input type="number" min="1" max="99" step="1" value="' + initialCopies + '" data-label-purpose-copies></label>',
      '<label class="inventory-label-copy-field"><span>列印倉庫位置</span><select data-label-print-warehouse>' +
        [['TW','台灣寶輝倉'],['CN','中國東莞倉'],['ID','印尼倉']].map(function (row) {
          var selected = String((payloads[0] && (payloads[0].warehouseCode || payloads[0].warehouse) || 'TW')).toUpperCase().indexOf(row[0]) !== -1 ? ' selected' : '';
          return '<option value="' + row[0] + '"' + selected + '>' + row[1] + '</option>';
        }).join('') + '</select></label>',
      '<div class="inventory-label-purpose-summary" data-label-purpose-summary></div>',
      variantSummary,
      '<footer><button type="button" class="ghost-button" data-label-purpose-close>取消／Batal</button><button type="button" class="primary-button" data-label-purpose-confirm>輸出標籤／Cetak label</button></footer>',
      '</section>'
    ].join('');
    document.body.appendChild(picker);
    var confirmButton = picker.querySelector('[data-label-purpose-confirm]');
    renderLabelPurposeSummary();
    picker.addEventListener('change', function (event) {
      if (event.target && event.target.name === 'inventory-label-purpose') {
        confirmButton.disabled = false;
      }
      if (event.target && event.target.matches('[data-label-purpose-copies]')) renderLabelPurposeSummary();
    });
    picker.addEventListener('input', function (event) {
      if (event.target && event.target.matches('[data-label-purpose-copies]')) renderLabelPurposeSummary();
    });
    picker.addEventListener('click', function (event) {
      if (event.target === picker || event.target.closest('[data-label-purpose-close]')) {
        event.preventDefault();
        closeInventoryLabelPurposePicker();
        return;
      }
      if (!event.target.closest('[data-label-purpose-confirm]')) return;
      event.preventDefault();
      var selected = picker.querySelector('input[name="inventory-label-purpose"]:checked');
      var purpose = inventoryLabelPurposeByValue(selected && selected.value);
      if (!purpose) {
        toast('請先選擇標籤用途／Silakan pilih tujuan label');
        return;
      }
      var copiesInput = picker.querySelector('[data-label-purpose-copies]');
      var copies = Math.floor(Number(copiesInput && copiesInput.value || 1));
      if (!Number.isFinite(copies) || copies < 1) copies = 1;
      copies = Math.min(99, copies);
      var warehouseSelect = picker.querySelector('[data-label-print-warehouse]');
      var warehouseCode = String(warehouseSelect && warehouseSelect.value || 'TW').toUpperCase();
      var warehouseName = warehouseCode === 'CN' ? '中國東莞倉' : (warehouseCode === 'ID' ? '印尼倉' : '台灣寶輝倉');
      closeInventoryLabelPurposePicker();
      var printPayloads = (totalCountMode ? inventoryLabelPayloadsForTotal(payloads, copies) : payloads).map(function (row, index) {
