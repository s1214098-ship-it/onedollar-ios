    window.setTimeout(function () {
      var draft = readOrderCustomerDraft();
      updateOrderCustomerDraftStatus(draft ? '已有已存客戶；需要接續時再按「帶入已存客戶」' : '尚未儲存', draft ? 'available' : '');
