    });
    var calculatedSubtotal = lines.reduce(function (sum, line) { return sum + line.subtotal; }, 0);
    var hasLinePrice = lines.some(function (line) { return line.hasPrice; });
    var storedSubtotal = Math.max(0, Number(row.subtotal || row.productsSubtotal || row.itemsSubtotal || 0));
    var subtotal = hasLinePrice ? calculatedSubtotal : storedSubtotal;
    var total = freightFifoPaymentTotal(row);
    var shippingFee = freightFifoEffectiveShippingFee(row, subtotal);
    if (!freightFifoWaivesCustomerShippingFee(row) && shippingFee <= 0 && subtotal > 0 && total > subtotal) shippingFee = total - subtotal;
