  function applyHaoHongPackageWeights(packages) {
    state.freightTracking = normalizeFreightTracking(state.freightTracking);
    var packageRows = Array.isArray(packages) ? packages : [];
    var cacheByTracking = new Map();
    (state.freightTracking.haohongPackageWeights || []).forEach(function (row) {
      var key = haohongTrackingKey(row.trackingNo);
      if (key) cacheByTracking.set(key, haohongPackageWeightRecord(row));
    });
    packageRows.forEach(function (row) {
      var key = haohongTrackingKey(row.trackingNo);
