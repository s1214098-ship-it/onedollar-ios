  function haohongItemNameForSync(item) {
    item = item || {};
    var name = String(item.productName || item.productFiledProductTitle || item.productFiledProductCode || item.productCode || '').replace(/\s+/g, ' ').trim();
    if (haohongIsPlaceholderName(name)) return '';
    var variants = [];
    try { variants = freightVariantLines(item) || []; } catch (error) { variants = []; }
    if (variants.length) {
      var bits = variants.map(function (line) {
        var color = String(line.color || line.colorName || '').replace(/\s+/g, ' ').trim();
        var qty = Math.max(1, Number(line.quantity || 1));
        return color ? color + '*' + qty : '';
      }).filter(Boolean);
      if (bits.length) name = (name + ' ' + bits.join(' ')).trim();
    }
    return name.slice(0, 180);
  }

  function haohongRemotePackageMap() {
    var map = new Map();
    function add(row) {
      if (!row) return;
      var rec = haohongPackageWeightRecord(row);
      var key = haohongTrackingKey(rec.trackingNo);
      if (key) map.set(key, rec);
    }
    (haohongSyncPackages || []).forEach(add);
    ((state.freightTracking && state.freightTracking.haohongPackageWeights) || []).forEach(function (row) {
      var key = haohongTrackingKey(row && row.trackingNo);
      if (key && !map.has(key)) add(row);
    });
    return map;
  }

  function haohongItemIsSelfPickup(item) {
    item = item || {};
    var source = String(item.logisticsSource || item.provider || '').toLowerCase();
    if (source === 'self_pickup') return true;
    return /東莞自取|自取／東莞|自提取回/.test(String(item.forwarder || ''));
  }

  function haohongItemTrackingNumbers(item) {
    item = item || {};
    return [item.trackingNo, item.haohongTrackingNo].concat((item.splitPackages || []).map(function (parcel) {
      return parcel && parcel.trackingNo;
    })).map(function (value) {
      return String(value || '').replace(/\s+/g, '').trim();
    }).filter(function (value) {
      return value && !/^(待補|未填|無|N\/A|-)$/i.test(value);
    });
  }

  function haohongItemIsHaohongTagged(item) {
    item = item || {};
    return String(item.logisticsSource || item.provider || '').toLowerCase() === 'haohong'
      || !!String(item.haohongTrackingNo || '').trim()
      || /豪鴻/.test(String(item.forwarder || ''));
  }

  function haohongItemCanPushFromAdmin(item) {
    return !haohongItemIsSelfPickup(item) && haohongItemTrackingNumbers(item).length > 0;
  }

  function haohongItemLooksLinked(item, remoteMap) {
    if (!haohongItemCanPushFromAdmin(item)) return false;
    if (!remoteMap) return true;
    var numbers = haohongItemTrackingNumbers(item);
    if (numbers.some(function (trackingNo) { return remoteMap.has(haohongTrackingKey(trackingNo)); })) return true;
    return haohongItemIsHaohongTagged(item);
  }

  function collectHaoHongProductNameUpdates() {
    var remoteByTracking = haohongRemotePackageMap();
    var grouped = new Map();
    (normalizeFreightTracking(state.freightTracking).items || []).forEach(function (item) {
      if (!haohongItemLooksLinked(item, remoteByTracking)) return;
      var name = haohongItemNameForSync(item);
      if (!name) return;
      haohongItemTrackingNumbers(item).forEach(function (trackingNo) {
        var key = haohongTrackingKey(trackingNo);
        if (!key) return;
        if (remoteByTracking.size && !remoteByTracking.has(key) && !haohongItemIsHaohongTagged(item)) return;
        var group = grouped.get(key) || {
          trackingNo: trackingNo,
          names: new Set(),
          inRemote: remoteByTracking.has(key)
        };
        group.names.add(name);
        if (remoteByTracking.has(key)) group.inRemote = true;
        grouped.set(key, group);
      });
    });
    var updates = [];
    var conflicts = [];
    var alreadySame = 0;
    var unmatched = 0;
    grouped.forEach(function (group, key) {
      var values = Array.from(group.names);
      if (values.length !== 1) {
        conflicts.push({ trackingNo: group.trackingNo, names: values });
        return;
      }
      var remote = remoteByTracking.get(key) || {};
      if (String(remote.productName || '').replace(/\s+/g, ' ').trim() === values[0]) {
        alreadySame += 1;
        return;
      }
      if (!group.inRemote) unmatched += 1;
      updates.push({ trackingNo: remote.trackingNo || group.trackingNo, productName: values[0], inRemote: group.inRemote });
    });
    updates.sort(function (a, b) { return Number(b.inRemote) - Number(a.inRemote); });
    return {
      updates: updates.slice(0, 100).map(function (row) { return { trackingNo: row.trackingNo, productName: row.productName }; }),
      conflicts: conflicts,
      alreadySame: alreadySame,
      unmatched: unmatched,
      remoteCount: remoteByTracking.size
    };
  }

  function syncHaoHongProductNames(options) {
    options = options || {};
    var request = haohongSyncRequestBody({ action: 'sync_names' });
    var passwordInput = document.querySelector('[data-haohong-sync-password]');
    var button = document.querySelector('[data-haohong-name-sync]');
    var status = document.querySelector('[data-haohong-sync-status]');
    if (!request.username && !haohongStoredLogin.stored) {
