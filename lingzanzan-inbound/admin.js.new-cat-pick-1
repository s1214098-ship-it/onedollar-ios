  }

  function freightAllocationSimilarColor(left, right) {
    var exactLeft = freightAllocationColorKey(left);
    var exactRight = freightAllocationColorKey(right);
    if (!exactLeft || !exactRight || exactLeft === exactRight) return false;
    function loose(value) {
      var translated = String(labelColorText(String(value || '').trim()) || value).split('/')[0].trim();
      return translated.normalize ? translated.normalize('NFKC').replace(/\s+/g, '').replace(/色$/g, '').toUpperCase() : translated.replace(/\s+/g, '').replace(/色$/g, '').toUpperCase();
    }
    var looseLeft = loose(left);
    var looseRight = loose(right);
    return !!looseLeft && !!looseRight && (looseLeft === looseRight || looseLeft.indexOf(looseRight) >= 0 || looseRight.indexOf(looseLeft) >= 0);
