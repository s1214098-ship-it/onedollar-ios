    var text = freightFifoCompactCardText(shareModel);
    var customerImage = orderCustomerPhoto(row.customer || {}) || row.customerImage || row.customerPhoto || '';
    var imageUrls = [customerImage].concat((Array.isArray(row.items) ? row.items : []).map(orderTrackingItemImage)).filter(Boolean);
    imageUrls = imageUrls.filter(function (url, index) { return imageUrls.indexOf(url) === index; });
    imageUrls = imageUrls.map(function (url) {
      try { return new URL(url, window.location.href).href; } catch (error) { return url; }
    });
    var result = modal.querySelector('[data-freight-fifo-result]');
    var originalLabel = button ? button.textContent : '';
    var isMobileShare = /Android|iPhone|iPad|iPod/i.test(navigator.userAgent || '') && Boolean(navigator.share);
    if (!isMobileShare) {
