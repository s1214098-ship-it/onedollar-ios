          var ready = inputs.every(function (input) {
            var article = input.closest('article');
            return freightQuantityLineVoided(article) || String(input.value).trim() !== '';
          });
          if (!ready) return;
          var lines = inputs.map(function (input) {
            var article = input.closest('article');
            var voided = freightQuantityLineVoided(article);
            var raw = String(input.value).trim();
            if (voided) return { actualQty: 0, voided: true, voidReason: article.getAttribute('data-freight-void-reason') || '' };
            if (raw === '') return { actualQty: null };
            var inspectQty = Math.max(0, Math.floor(Number(raw) || 0));
            var arrivedQty = freightSafeQty(input.getAttribute('data-arrived'), 0);
            var extraColor = input.getAttribute('data-extra-color') === '1';
            var expectedQty = freightSafeQty(input.getAttribute('data-expected'), 0);
            var actualQty = extraColor ? inspectQty : arrivedQty + inspectQty;
            return { actualQty: actualQty, inspectQty: inspectQty, arrivedQty: arrivedQty, adjustedExpectedQty: Math.max(expectedQty, actualQty), voided: false };
          });
          var reasonBox = group.querySelector('[data-freight-quantity-reason]');
          var reason = String(reasonBox && reasonBox.value || '').trim();
          requests.push({
            action: 'save-receiving-inspection',
            freightItemId: itemId,
            lines: lines,
            varianceReason: reason,
            final: false
          });
        });
        if (!requests.length) return;
        autosaveInFlight = true;
        modal.setAttribute('data-freight-quantity-autosave-note', '自動暫存中…');
        updateTotal();
        var sequence = Promise.resolve();
        requests.forEach(function (body) {
          sequence = sequence.then(function () {
            return fetch('./freight-tracking-api.php', {
              method: 'POST',
              headers: adminAuthorizationHeaders({ 'Content-Type': 'application/json' }),
              body: JSON.stringify(body)
            }).then(function (response) {
              return response.json().then(function (payload) {
                if (!response.ok || !payload.ok) throw new Error(payload.error || '自動暫存失敗');
                if (payload.item) {
                  var index = state.freightTracking.items.findIndex(function (row) { return String(row && row.id || '') === String(body.freightItemId); });
                  if (index >= 0) state.freightTracking.items[index] = payload.item;
                }
                if (payload.revision !== undefined) state.freightTracking.revision = payload.revision;
                return payload;
              });
            });
          });
        });
        sequence.then(function () {
          modal.setAttribute('data-freight-quantity-autosave-note', '已自動暫存（未完成仍可繼續點貨）');
        }).catch(function (error) {
          modal.setAttribute('data-freight-quantity-autosave-note', '自動暫存失敗：' + String(error && error.message || error || ''));
        }).then(function () {
          autosaveInFlight = false;
          updateTotal();
        });
      }, 800);
    };
    modal.addEventListener('focusin', function (event) {
      var input = event.target && event.target.closest ? event.target.closest('[data-freight-quantity-actual]') : null;
      Array.from(modal.querySelectorAll('article.freight-quantity-line')).forEach(function (article) {
        article.classList.toggle('is-active', !!(input && article.contains(input)));
      });
    });
    modal.addEventListener('focusout', function (event) {
      var related = event.relatedTarget;
      window.setTimeout(function () {
        Array.from(modal.querySelectorAll('article.freight-quantity-line.is-active')).forEach(function (article) {
          if (!article.contains(document.activeElement)) article.classList.remove('is-active');
        });
      }, 0);
    });
    modal.addEventListener('click', function (event) {
      var voidLine = event.target && event.target.closest ? event.target.closest('[data-freight-quantity-void-line]') : null;
      if (voidLine && modal.contains(voidLine)) {
        event.preventDefault();
        var article = voidLine.closest('article');
        var group = voidLine.closest('[data-freight-quantity-item]');
        var color = article && article.querySelector('b') ? article.querySelector('b').textContent : '此規格';
        var reason = freightAskVoidReason('沒寄到');
        if (!reason) return;
        freightApplyQuantityLineVoidState(article, true, reason);
        freightAppendQuantityVoidReason(group, reason, color);
        updateTotal();
        scheduleFreightQuantityAutosave();
        return;
      }
      var undoLine = event.target && event.target.closest ? event.target.closest('[data-freight-quantity-undo-void]') : null;
      if (undoLine && modal.contains(undoLine)) {
        event.preventDefault();
        freightApplyQuantityLineVoidState(undoLine.closest('article'), false, '');
        var input = undoLine.closest('article') && undoLine.closest('article').querySelector('[data-freight-quantity-actual]');
        if (input) {
          var extraColor = input.getAttribute('data-extra-color') === '1';
          var arrived = freightSafeQty(input.getAttribute('data-arrived'), 0);
          var expected = freightSafeQty(input.getAttribute('data-expected'), 0);
          input.value = String(extraColor ? 1 : 0);
          void arrived;
          void expected;
        }
        updateTotal();
        return;
      }
      var voidItem = event.target && event.target.closest ? event.target.closest('[data-freight-quantity-void-item]') : null;
      if (voidItem && modal.contains(voidItem)) {
        event.preventDefault();
        var group = voidItem.closest('[data-freight-quantity-item]');
        if (!window.confirm('確定作廢這個產品？所有顏色／尺寸都不會入庫。')) return;
        var reason = freightAskVoidReason('沒寄到');
        if (!reason) return;
        Array.from((group && group.querySelectorAll('article.freight-quantity-line')) || []).forEach(function (article) {
          freightApplyQuantityLineVoidState(article, true, reason);
        });
        freightAppendQuantityVoidReason(group, reason, '整項產品作廢');
        updateTotal();
        scheduleFreightQuantityAutosave();
        return;
      }
      var voidAll = event.target && event.target.closest ? event.target.closest('[data-freight-quantity-void-all]') : null;
      if (voidAll && modal.contains(voidAll)) {
        event.preventDefault();
        if (!window.confirm('確定整張物流單作廢？廠商沒寄到或故障時使用，這張不會入庫。')) return;
        var reason = freightAskVoidReason('沒寄到');
        if (!reason) return;
        Array.from(modal.querySelectorAll('article.freight-quantity-line')).forEach(function (article) {
          freightApplyQuantityLineVoidState(article, true, reason);
        });
        Array.from(modal.querySelectorAll('[data-freight-quantity-item]')).forEach(function (group) {
          freightAppendQuantityVoidReason(group, reason, '整張作廢');
        });
        updateTotal();
        var saveBtn = modal.querySelector('[data-freight-quantity-confirm-save]');
        if (saveBtn) saveFreightQuantityConfirmation(saveBtn);
        return;
      }
      var tap = event.target && event.target.closest ? event.target.closest('[data-freight-quantity-tap]') : null;
      if (event.target && event.target.closest && event.target.closest('[data-freight-qty-step]')) return;
      if (!tap || !modal.contains(tap)) return;
      var input = tap.querySelector('[data-freight-quantity-actual]');
      if (!input) return;
      var article = tap.closest('article');
      Array.from(modal.querySelectorAll('article.freight-quantity-line')).forEach(function (row) {
        row.classList.toggle('is-active', row === article);
      });
      if (String(input.value).trim() === '') {
        var expected = Math.max(0, Math.floor(Number(input.getAttribute('data-expected') || 0)));
        input.value = String(expected);
        input.dispatchEvent(new Event('input', { bubbles: true }));
      }
      try { input.focus(); input.select && input.select(); } catch (err) {}
    });
    modal.addEventListener('input', function (event) {
      updateTotal();
      if (event && event.target && event.target.matches && (event.target.matches('[data-freight-quantity-actual]') || event.target.matches('[data-freight-quantity-reason]'))) {
        scheduleFreightQuantityAutosave();
      }
    });
    updateTotal();
  }

  function markFreightOriginalAsDifferentProduct(modal) {
    if (!modal) return;
    Array.from(modal.querySelectorAll('[data-freight-quantity-actual]')).forEach(function (input) {
      input.value = '0';
    });
    Array.from(modal.querySelectorAll('[data-freight-quantity-reason]')).forEach(function (textarea) {
      if (!String(textarea.value || '').trim()) {
        textarea.value = '本包實收為不同產品；原預報品項本次收到 0 件，保留為未到貨／待追蹤，不以原商品替代入庫。';
      }
    });
    modal.dispatchEvent(new Event('input', { bubbles: true }));
    var output = modal.querySelector('[data-freight-quantity-total]');
    if (output) {
      output.textContent = '原預報品項已標成本次收到 0；請另建實際收到的不同產品，原商品不會被替代入庫。';
      output.setAttribute('data-state', 'partial');
    }
  }

  function markOpenFreightQuantityOriginalAsDifferentProduct(parentId) {
    var modals = Array.from(document.querySelectorAll('[data-freight-quantity-confirm]'));
    var escapedParentId = window.CSS && typeof window.CSS.escape === 'function'
      ? window.CSS.escape(String(parentId || ''))
      : String(parentId || '').replace(/"/g, '\\"');
    var modal = modals.find(function (candidate) {
      return candidate.querySelector('[data-freight-quantity-extra-open="' + escapedParentId + '"]');
    }) || modals[0] || null;
    markFreightOriginalAsDifferentProduct(modal);
  }

  function saveFreightQuantityConfirmation(control) {
    var modal = control && control.closest('[data-freight-quantity-confirm]');
    var trackingNo = String(modal && modal.getAttribute('data-freight-quantity-confirm') || '');
    var batchId = String(modal && modal.getAttribute('data-freight-arrival-status-modal') || '');
    if (!modal) return;
    var itemGroups = Array.from(modal.querySelectorAll('[data-freight-quantity-item]'));
    var actualInputs = Array.from(modal.querySelectorAll('[data-freight-quantity-actual]'));
    var unclassifiedGroup = modal.querySelector('[data-freight-quantity-unclassified]');
    if (unclassifiedGroup && !actualInputs.length) {
      toast('這包還沒選實際商品。請先搜尋產品編號／條碼／品名，選定後才能點貨。');
      var searchBox = unclassifiedGroup.querySelector('[data-freight-supplemental-product-search]');
      if (searchBox) searchBox.focus();
      return;
    }
    var blank = actualInputs.find(function (input) {
      return !freightQuantityLineVoided(input.closest('article')) && String(input.value).trim() === '';
    });
    var invalid = actualInputs.find(function (input) {
      return !freightQuantityLineVoided(input.closest('article')) && typeof input.checkValidity === 'function' && !input.checkValidity();
    });
    var statusOutput = modal.querySelector('[data-freight-quantity-total]');
    if (blank || invalid) {
      if (statusOutput) {
        statusOutput.textContent = '尚未儲存：每個顏色／尺寸都要填實收，或按「沒寄到／刪除此規格」作廢。';
        statusOutput.setAttribute('data-state', 'error');
      }
      toast('每個顏色／尺寸都要填實收，沒寄到請按作廢／刪除規格');
      (blank || invalid).focus();
      return;
    }
    var requests = itemGroups.map(function (group) {
      var itemId = String(group.getAttribute('data-freight-quantity-item') || '');
      var item = freightItemById(itemId) || {};
      var destination = freightReceivingWorkbenchDestination(item);
      var canDirectReceive = destination.code !== 'CN_DONGGUAN';
      var inputs = Array.from(group.querySelectorAll('[data-freight-quantity-actual]'));
      var lines = inputs.map(function (input) {
        var article = input.closest('article');
        var voided = freightQuantityLineVoided(article);
        var inspectQty = voided ? 0 : Math.max(0, Math.floor(Number(input.value) || 0));
        var arrivedQty = freightSafeQty(input.getAttribute('data-arrived'), 0);
        var extraColor = input.getAttribute('data-extra-color') === '1';
        var expectedQty = freightSafeQty(input.getAttribute('data-expected'), 0);
        var actualQty = voided ? 0 : (extraColor ? inspectQty : arrivedQty + inspectQty);
        return {
          actualQty: actualQty,
          inspectQty: inspectQty,
          arrivedQty: arrivedQty,
          adjustedExpectedQty: Math.max(expectedQty, actualQty),
          voided: voided,
          voidReason: voided ? (article.getAttribute('data-freight-void-reason') || '') : ''
        };
      });
      var expected = inputs.reduce(function (sum, input) { return sum + Math.max(0, Number(input.getAttribute('data-expected') || 0)); }, 0);
      var actual = lines.reduce(function (sum, line) { return sum + (line.voided ? 0 : line.actualQty); }, 0);
      var allVoided = lines.length > 0 && lines.every(function (line) { return line.voided; });
      var reasonBox = group.querySelector('[data-freight-quantity-reason]');
      var reason = String(reasonBox && reasonBox.value || '').trim();
      if (allVoided && !reason) reason = '廠商未寄到或故障，整筆作廢';
      else if (actual !== expected && !reason) reason = actual < expected
        ? '分批到貨：物流預報 ' + expected + ' 件，本次實收 ' + actual + ' 件，尚待到貨 ' + (expected - actual) + ' 件'
        : '物流預報 ' + expected + ' 件，本次實收 ' + actual + ' 件，多到 ' + (actual - expected) + ' 件';
      return {
        itemId: itemId,
        actual: actual,
        voided: allVoided,
        destination: destination,
        canDirectReceive: canDirectReceive && !allVoided,
        body: {
          action: 'save-receiving-inspection',
          freightItemId: itemId,
          lines: lines,
          varianceReason: reason,
          voided: allVoided,
          voidReason: reason,
          final: canDirectReceive && !allVoided ? true : allVoided
        }
      };
    });
    control.disabled = true;
    control.textContent = '正在暫存本次實收數量…';
    if (statusOutput) {
      statusOutput.textContent = '正在儲存本張物流的實收數量，請稍候…';
      statusOutput.setAttribute('data-state', 'saving');
    }
    var sequence = Promise.resolve();
    requests.forEach(function (request) {
      sequence = sequence.then(function () {
        return fetch('./freight-tracking-api.php', {
          method: 'POST',
          headers: adminAuthorizationHeaders({ 'Content-Type': 'application/json' }),
          body: JSON.stringify(request.body)
        }).then(function (response) {
          return response.json().then(function (payload) {
            if (!response.ok || !payload.ok) throw new Error(payload.error || '數量保存失敗');
            return syncFreightBatchActualAfterInspection(request.itemId, request.actual).then(function () { return payload; });
          });
        });
      });
    });
    sequence.then(function () {
      return loadFreightTracking(true);
    }).then(function () {
      var refreshedBatch = freightBatchById(batchId);
      var summary = freightConfirmedReceivingSummary(refreshedBatch);
      freightArrivalReceivingSession.batchId = batchId;
      freightArrivalReceivingSession.lastTrackingNo = trackingNo;
      var refreshedItems = freightArrivalItemsForTracking(refreshedBatch, trackingNo);
      var pendingItems = refreshedItems.filter(function (item) {
        return !freightItemClosesBatchQueueWithoutSelectionCheck(item);
      });
      var voidedAll = refreshedItems.length > 0 && refreshedItems.every(function (item) {
        return item.receivingVoided === true || String((item.receivingInspection || {}).status || '') === 'voided';
      });
      if (voidedAll || !pendingItems.length) {
        freightArrivalRenderActive('物流單號 ' + trackingNo + ' 已作廢，沒有入庫。');
        closeFreightArrivalStatusModal();
        toast(voidedAll ? '已作廢：廠商沒寄到或故障，這張不入庫' : '這張物流單已處理完畢');
        if (typeof renderFreightTracking === 'function') renderFreightTracking();
        return;
      }
      freightArrivalRenderActive('物流單號 ' + trackingNo + ' 已完成逐色實收核對；本批已點貨 ' + summary.receivedQty + '／預報 ' + summary.expectedQty + ' 件。');
      if (pendingItems.length === 1 && freightFormalReceiptReadiness(pendingItems[0]).ready) {
        var refreshedDestination = freightReceivingWorkbenchDestination(pendingItems[0]);
        if (refreshedDestination.code === 'CN_DONGGUAN') {
          openFreightReceivingWorkbench(pendingItems[0].id, { fromArrival: true, prefillExpected: false });
          toast('中國倉請選樣品或公司現貨，再完成正式入庫與條碼列印');
        } else {
          openFreightReceivingWorkbench(pendingItems[0].id, { fromArrival: true, prefillExpected: false });
          toast('實收數量已確認；請在本頁確認正式入庫，完成後跳出條碼列印');
        }
      } else {
        showFreightArrivalItemActions(refreshedBatch, trackingNo);
        toast('實收數量已暫存；尚未正式入庫，請先完成正式產品與 SKU');
      }
    }).catch(function (error) {
      control.disabled = false;
      control.textContent = '確認本次實收數量 → 下一步';
      if (statusOutput) {
        statusOutput.textContent = '儲存失敗：' + (error.message || '實收數量保存失敗');
        statusOutput.setAttribute('data-state', 'error');
      }
      toast(error.message || '實收數量保存失敗');
    });
  }

