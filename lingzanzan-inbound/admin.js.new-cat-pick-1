  function applyFreightCustomerCandidate(row, matchMode) {
    row = row || {};
    var input = document.querySelector('[data-freight-customer-order-no]');
    if (!input) return false;
    input.value = row.customerOrderNo || row.orderNo || row.inquiryId || '';
    input.dataset.freightInquiryId = row.inquiryId || '';
    input.dataset.freightOrderId = row.orderId || '';
    input.dataset.freightItemIndex = row.itemIndex == null ? '' : String(row.itemIndex);
    input.dataset.freightLineId = row.lineId || '';
    input.dataset.freightLineKey = row.lineId || row.lineKey || '';
    input.dataset.freightGroupKey = row.groupKey || '';
    input.dataset.freightMatchMode = matchMode || 'manual-order';
    input.dataset.freightPendingQty = row.pendingQty == null ? '' : String(row.pendingQty);
    input.dataset.freightMatchedTracking = normalizeFreightIdentityNumber(document.querySelector('[data-freight-tracking-no]')?.value || '');
    input.dataset.freightMatchedBarcode = normalizeFreightIdentityNumber(row.matchedBarcode || document.querySelector('[data-freight-sample-barcode]')?.value || '');
    var nameInput = document.querySelector('[data-freight-customer-name]');
    var phoneInput = document.querySelector('[data-freight-customer-phone]');
    if (nameInput) nameInput.value = row.customerName || row.name || nameInput.value || '';
    if (phoneInput) phoneInput.value = row.customerPhone || row.phone || phoneInput.value || '';
    var codeInput = document.querySelector('[data-freight-product-code]');
    var productIdInput = document.querySelector('[data-freight-product-id]');
    var skuIdInput = document.querySelector('[data-freight-sku-id]');
    if (codeInput) codeInput.value = row.productCode || '';
    if (productIdInput) productIdInput.value = row.productId || '';
    if (skuIdInput) skuIdInput.value = row.skuId || '';
    var productNameInput = document.querySelector('[data-freight-product-name]');
    if (productNameInput && !String(productNameInput.value || '').trim()) productNameInput.value = row.productName || '';
    var aliasesInput = document.querySelector('[data-freight-product-aliases]');
    if (aliasesInput) aliasesInput.value = JSON.stringify(mergeFreightNameAliases(aliasesInput.value, [row.productName, productNameInput && productNameInput.value]));
    if (row.color) fillFreightChoiceSelect('[data-freight-color]', collectFreightColorChoices([row.color]), '請選擇產品顏色', row.color);
    if (row.size) fillFreightChoiceSelect('[data-freight-size]', freightStandardSizes().concat([row.size]), '請選擇產品尺寸', row.size);
    var qty = document.querySelector('[data-freight-qty]');
    var freightQty = Math.max(1, Number(qty && qty.value || 1));
    var product = freightProductByOfficialText(row.productCode || row.productId || row.skuId || '');
    if (product) applyFreightProductRules(product);
    if (matchMode === 'tracking-exact') {
      setFreightCustomerMatchStatus('已依正式物流單號自動對上 ' + input.value + '；物流數量保留 ' + freightQty + ' 件，儲存後只會抵銷此客戶 1 件，這位客戶尚待 ' + Math.max(0, Number(row.pendingQty || 0) - 1) + ' 件。', 'matched');
    } else if (matchMode === 'barcode-exact') {
      setFreightCustomerMatchStatus('已依完整條碼自動對上 ' + input.value + '；物流數量保留 ' + freightQty + ' 件，儲存後只抵銷這筆客戶商品 1 件，其他客戶需求不會被誤扣。', 'matched');
    } else {
      setFreightCustomerMatchStatus('已使用人工訂單備援選擇 ' + input.value + '；物流數量保留 ' + freightQty + ' 件，儲存時仍會由後端核對並只抵銷此客戶 1 件。', 'choice');
    }
    return true;
  }

  function lookupFreightCustomerByTracking() {
    var tracking = String(document.querySelector('[data-freight-tracking-no]')?.value || '').trim();
    var offsetId = String(document.querySelector('[data-freight-purchase-offset-id]')?.value || '').trim();
    var sequence = ++freightMatchLookupSequence;
    if (offsetId) {
      setFreightCustomerMatchStatus('這筆物流已抵銷 1 件客戶需求（帳本 ' + offsetId + '），不會再次扣數量。', 'matched');
      return Promise.resolve(null);
    }
    if (!tracking) {
      setFreightCustomerMatchStatus('輸入正式物流單號後，系統會自動尋找符合物流單號且尚未抵銷的客戶訂單；每次只扣一件。', '');
      return Promise.resolve(null);
    }
    setFreightCustomerMatchStatus('正在用正式物流單號搜尋客戶訂單…', 'searching');
    var url = './stock-inquiry-api.php?action=freight-match-candidates&trackingNo=' + encodeURIComponent(tracking) + '&_=' + Date.now();
    return fetch(url, { cache: 'no-store', credentials: 'same-origin', headers: adminAuthorizationHeaders() }).then(function (res) {
      return res.json().then(function (payload) {
        if (!res.ok || !payload.ok) throw new Error(payload.error || '客戶訂單查詢失敗');
        return payload;
      });
    }).then(function (payload) {
      if (sequence !== freightMatchLookupSequence) return null;
      if (payload.autoCandidate) {
        applyFreightCustomerCandidate(payload.autoCandidate, 'tracking-exact');
      } else if (Number(payload.candidateCount || 0) > 0) {
        setFreightCustomerMatchStatus('這個物流單號對到 ' + Number(payload.candidateCount) + ' 筆客戶商品明細；為避免扣錯客戶，請在「對應客戶訂單號」人工選一筆。', 'choice');
      } else {
        setFreightCustomerMatchStatus('這個正式物流單號尚未在客戶訂單找到。物流仍可先保存；如為舊資料，請人工選擇客戶訂單。', 'pending-offset');
      }
      return payload;
    }).catch(function (error) {
      if (sequence !== freightMatchLookupSequence) return null;
      var message = String(error && error.message || error || '');
      if (/重新登入|登入已逾時|登入已失效|工作階段/.test(message)) {
        setFreightCustomerMatchStatus('客戶訂單暫時無法自動對上。相近單號仍可帶入並先保存物流，稍後再人工選擇訂單。', 'pending-offset');
      } else {
        setFreightCustomerMatchStatus('自動搜尋失敗：' + message + '。相近單號仍可帶入；可稍後重試或人工選擇訂單。', 'error');
      }
      return null;
    });
  }

  function lookupFreightCustomerByBarcode() {
    var barcodeInput = document.querySelector('[data-freight-sample-barcode]');
    var barcode = String(barcodeInput?.value || '').trim();
    var sequence = ++freightBarcodeMatchLookupSequence;
    var currentOrderInput = document.querySelector('[data-freight-customer-order-no]');
    if (currentOrderInput && currentOrderInput.dataset.freightMatchMode === 'barcode-exact'
      && normalizeFreightIdentityNumber(currentOrderInput.dataset.freightMatchedBarcode || '') !== normalizeFreightIdentityNumber(barcode)) {
      clearFreightAutoCustomerCandidate(['barcode-exact']);
    }
    if (!barcode) {
      if (barcodeInput) {
        ['freightSupplyMode', 'freightReadyStockQty', 'freightForecastQty'].forEach(function (key) { barcodeInput.dataset[key] = ''; });
      }
      setFreightBarcodeMatchStatus('輸入或產生完整條碼後，系統會判斷台灣現貨、物流預報庫存，並搜尋尚缺這款的客戶訂單。', '');
      return Promise.resolve(null);
    }
    setFreightBarcodeMatchStatus('正在依完整條碼核對現貨、物流預報與客戶訂單…', '');
    var url = './stock-inquiry-api.php?action=barcode-match-candidates&barcode=' + encodeURIComponent(barcode) + '&_=' + Date.now();
    return fetch(url, { cache: 'no-store', credentials: 'same-origin', headers: adminAuthorizationHeaders() }).then(function (res) {
      return res.json().then(function (payload) {
        if (!res.ok || !payload.ok) throw new Error(payload.error || '完整條碼查詢失敗');
        return payload;
      });
    }).then(function (payload) {
      if (sequence !== freightBarcodeMatchLookupSequence) return null;
      var availability = payload.availability || {};
      var readyQty = Math.max(0, Number(availability.readyStockQty || 0));
      var forecastQty = Math.max(0, Number(availability.forecastQty || 0));
      var mode = String(availability.mode || (readyQty ? 'ready_stock' : (forecastQty ? 'freight_forecast' : 'no_supply')));
      if (barcodeInput) {
        barcodeInput.dataset.freightSupplyMode = mode;
        barcodeInput.dataset.freightReadyStockQty = String(readyQty);
        barcodeInput.dataset.freightForecastQty = String(forecastQty);
      }
      var inventoryText = readyQty > 0
        ? '台灣現貨可配 ' + readyQty + ' 件'
        : (forecastQty > 0 ? '物流預報庫存 ' + forecastQty + ' 件，等待到貨' : '目前沒有台灣現貨，也沒有同條碼預報庫存');
      var candidateCount = Math.max(0, Number(payload.candidateCount || 0));
      var orderText = candidateCount ? '；尚有 ' + candidateCount + ' 筆客戶商品明細需要這款' : '；目前沒有尚缺這款的客戶訂單';
      setFreightBarcodeMatchStatus('完整條碼 ' + barcode + '：' + inventoryText + orderText + '。', readyQty > 0 ? 'ready-stock' : (forecastQty > 0 ? 'forecast' : 'empty'));
      var orderInput = document.querySelector('[data-freight-customer-order-no]');
      var currentOrderNo = String(orderInput && orderInput.value || '').trim();
      var autoOrderNo = String(payload.autoCandidate && (payload.autoCandidate.customerOrderNo || payload.autoCandidate.orderNo || payload.autoCandidate.inquiryId) || '').trim();
      var hasManualChoice = orderInput && currentOrderNo && ['tracking-exact', 'barcode-exact'].indexOf(String(orderInput.dataset.freightMatchMode || '')) === -1;
      var hasConflictingAutoChoice = currentOrderNo && autoOrderNo && normalizeLiveCode(currentOrderNo) !== normalizeLiveCode(autoOrderNo);
      if (payload.autoCandidate && !hasManualChoice && !hasConflictingAutoChoice && !String(document.querySelector('[data-freight-purchase-offset-id]')?.value || '').trim()) {
        applyFreightCustomerCandidate(payload.autoCandidate, 'barcode-exact');
      } else if (candidateCount > 1 && !hasManualChoice && !hasConflictingAutoChoice) {
        setFreightCustomerMatchStatus('完整條碼對到 ' + candidateCount + ' 筆尚缺商品；為避免配錯客戶，請在「對應客戶訂單號」選擇正確客人。', 'choice');
      } else if (hasConflictingAutoChoice) {
        setFreightCustomerMatchStatus('目前已選擇另一筆客戶訂單，完整條碼查詢不會自動覆蓋；請確認後再手動更換。', 'choice');
      }
      return payload;
    }).catch(function (error) {
      if (sequence !== freightBarcodeMatchLookupSequence) return null;
      setFreightBarcodeMatchStatus('完整條碼核對失敗：' + (error.message || error), 'error');
      return null;
    });
  }

  function commitFreightBarcodeLookup(force) {
    var input = document.querySelector('[data-freight-sample-barcode]');
    if (!input) return Promise.resolve(null);
    var barcodeKey = normalizeFreightIdentityNumber(input.value || '');
    if (!force && String(input.dataset.freightLookupCommittedBarcode || '') === barcodeKey) return Promise.resolve(null);
    input.dataset.freightLookupCommittedBarcode = barcodeKey;
    autoFillFreightProductFromBarcode();
    return Promise.all([lookupFreightCustomerByBarcode(), lookupFreightInterlinkByCode(force)]);
  }

  function freightCustomerOrderRows() {
    var rows = [];
    var sources = [];
    (state.inquiries || []).forEach(function (order) { sources.push({ order: order, kind: 'inquiry' }); });
    (state.orders || []).forEach(function (order) { sources.push({ order: order, kind: 'order' }); });
    sources.forEach(function (entry) {
      var order = entry.order || {};
      var status = String(order.status || '').toLowerCase();
      if (['cancelled', 'canceled', 'deleted', 'removed'].indexOf(status) !== -1) return;
      if (entry.kind === 'inquiry' && (order.convertedOrderId || order.convertedToOrderId || status === 'converted')) return;
      if (entry.kind === 'order' && order.sourceInquiryId) return;
      var customer = order.customer && typeof order.customer === 'object' ? order.customer : {};
      var orderNo = String(order.id || order.orderId || '').trim();
      if (!orderNo) return;
      var name = String(customer.name || order.customerName || order.name || '').trim();
      var phone = String(customer.phone || order.phone || order.customerPhone || '').trim();
      var items = Array.isArray(order.items) && order.items.length ? order.items : [null];
      items.forEach(function (item, itemIndex) {
        item = item || {};
        var productCode = String(item.productCode || item.code || item.sku || item.skuId || '').trim();
        var productName = String(item.productName || item.name || item.title || '').trim();
        var color = String(item.color || item.colorName || '').trim();
        var size = String(item.size || item.sizeName || '').trim();
        var fullBarcode = String(item.companyBarcode || item.barcode || item.taiwanBarcode || item.sampleBarcode || item.skuId || item.sku || '').trim();
        rows.push({
          orderNo: orderNo,
          customerOrderNo: orderNo,
          inquiryId: entry.kind === 'inquiry' ? orderNo : String(order.sourceInquiryId || ''),
          orderId: entry.kind === 'order' ? orderNo : String(order.orderId || order.convertedOrderId || ''),
          itemIndex: itemIndex,
          lineId: String(item.lineId || '').trim(),
          lineKey: String(item.lineId || [entry.kind, orderNo, itemIndex].join(':')),
          groupKey: '',
          displayValue: orderNo + (items.length > 1 ? '｜第' + (itemIndex + 1) + '項' : ''),
          name: name,
          phone: phone,
          customerName: name,
          customerPhone: phone,
          productId: String(item.productId || '').trim(),
          skuId: String(item.skuId || item.sku || '').trim(),
          barcode: fullBarcode,
          matchedBarcode: fullBarcode,
          productCode: productCode,
          productName: productName,
          color: color,
          size: size,
          quantity: Math.max(1, Number(item.requestedQty || item.quantity || item.qty || 1)),
          pendingQty: Math.max(1, Number(item.requestedQty || item.quantity || item.qty || 1))
        });
      });
    });
    return rows;
  }

  function fillFreightCustomerOrderOptions() {
    var list = document.getElementById('freight-customer-order-options');
    if (!list) return;
    list.innerHTML = freightCustomerOrderRows().slice(0, 600).map(function (row) {
      var label = [row.name, row.phone, row.barcode, row.productCode || row.productName, row.color, row.size].filter(Boolean).join('／');
      return '<option value="' + escapeHtml(row.displayValue) + '">' + escapeHtml(label) + '</option>';
    }).join('');
  }

  function applyFreightCustomerOrderLink() {
    var input = document.querySelector('[data-freight-customer-order-no]');
    if (!input) return;
    var raw = String(input.value || '').trim();
    var rows = freightCustomerOrderRows();
    var matches = rows.filter(function (row) {
      return normalizeFreightIdentityNumber(row.displayValue) === normalizeFreightIdentityNumber(raw) || normalizeFreightIdentityNumber(row.orderNo) === normalizeFreightIdentityNumber(raw);
    });
    if (!matches.length) {
      input.dataset.freightInquiryId = '';
      input.dataset.freightOrderId = '';
      input.dataset.freightItemIndex = '';
      input.dataset.freightLineId = '';
      input.dataset.freightLineKey = '';
      input.dataset.freightGroupKey = '';
      input.dataset.freightMatchMode = '';
      input.dataset.freightMatchedTracking = '';
      input.dataset.freightMatchedBarcode = '';
      return;
    }
    var exactLine = matches.find(function (candidate) { return normalizeFreightIdentityNumber(candidate.displayValue) === normalizeFreightIdentityNumber(raw); }) || null;
    if (!exactLine && matches.length > 1) {
      setFreightCustomerMatchStatus('這張訂單有多個商品，請從選單選擇「第幾項」後再儲存，系統不會猜測。', 'choice');
      return;
    }
    applyFreightCustomerCandidate(exactLine || matches[0], 'manual-order');
  }

  var FREIGHT_PRODUCT_IMAGE_LIMIT = 24;

  function normalizeFreightProductImages(value) {
    if (typeof value === 'string') {
      var raw = value.trim();
      if (!raw) value = [];
      else if (raw.charAt(0) === '[') {
        try { value = JSON.parse(raw); } catch (error) { value = []; }
      } else value = [raw];
    }
    var seen = new Set();
    return (Array.isArray(value) ? value : []).map(function (src) { return String(src || '').trim(); }).filter(function (src) {
      if (!src || seen.has(src)) return false;
      if (!/^(?:data:image\/|https?:\/\/|\.\.\/|\.\/|\/)/i.test(src)) return false;
      seen.add(src);
      return true;
    }).slice(0, FREIGHT_PRODUCT_IMAGE_LIMIT);
  }

  function normalizeFreightColorImages(value) {
    if (typeof value === 'string') {
      var raw = value.trim();
      if (!raw) value = {};
      else {
        try { value = JSON.parse(raw); } catch (error) { value = {}; }
      }
    }
    var result = {};
    if (Array.isArray(value)) {
      value.forEach(function (row) {
        var color = String(row && (row.color || row.name) || '').trim();
        var image = String(row && (row.image || row.src) || '').trim();
        if (color && /^(?:data:image\/|https?:\/\/|\.\.\/|\.\/|\/)/i.test(image)) result[color] = image;
      });
      return result;
    }
    if (!value || typeof value !== 'object') return result;
    Object.keys(value).slice(0, 30).forEach(function (color) {
      var name = String(color || '').trim();
      var image = String(value[color] || '').trim();
      if (name && /^(?:data:image\/|https?:\/\/|\.\.\/|\.\/|\/)/i.test(image)) result[name] = image;
    });
    return result;
  }

  function freightImageFormState() {
    return {
      productImages: normalizeFreightProductImages(document.querySelector('[data-freight-product-images]')?.value || '[]'),
      colorImages: normalizeFreightColorImages(document.querySelector('[data-freight-color-images]')?.value || '{}')
    };
  }

  function renderFreightImageEditor() {
    var productPreview = document.querySelector('[data-freight-product-image-preview]');
    var colorPreview = document.querySelector('[data-freight-color-image-preview]');
    var colorSelect = document.querySelector('[data-freight-color-image-color]');
    var summary = document.querySelector('[data-freight-product-image-summary]');
    if (!productPreview && !colorPreview && !colorSelect) return;
    var state = freightImageFormState();
    var currentColor = String(colorSelect?.value || document.querySelector('[data-freight-color]')?.value || '').trim();
    var colors = [];
    freightVariantControlLines().forEach(function (line) { if (line.color && colors.indexOf(line.color) === -1) colors.push(line.color); });
    var activeColor = String(document.querySelector('[data-freight-color]')?.value || '').trim();
    if (activeColor && colors.indexOf(activeColor) === -1) colors.push(activeColor);
    Object.keys(state.colorImages).forEach(function (color) { if (colors.indexOf(color) === -1) colors.push(color); });
    if (colorSelect) {
      colorSelect.innerHTML = '<option value="">請選顏色</option>' + colors.map(function (color) { return '<option value="' + escapeHtml(color) + '">' + escapeHtml(color) + '</option>'; }).join('');
      colorSelect.value = colors.indexOf(currentColor) >= 0 ? currentColor : (colors[0] || '');
    }
    if (summary) summary.textContent = '明細圖 ' + state.productImages.length + ' 張／顏色圖 ' + Object.keys(state.colorImages).length + ' 張';
    if (productPreview) {
      productPreview.innerHTML = state.productImages.length ? state.productImages.map(function (src, index) {
        return '<figure><img src="' + escapeHtml(src) + '" alt="產品明細圖 ' + (index + 1) + '"><figcaption>明細圖 ' + (index + 1) + '</figcaption><button type="button" class="primary-button" data-freight-product-image-use-color="' + index + '">選作目前顏色圖</button><button type="button" class="danger-button" data-freight-product-image-remove="' + index + '">移除</button></figure>';
      }).join('') : '<p>尚未加入產品明細圖。</p>';
    }
    if (colorPreview) {
      var colorKeys = Object.keys(state.colorImages);
      colorPreview.innerHTML = colorKeys.length ? colorKeys.map(function (color) {
        return '<figure><img src="' + escapeHtml(state.colorImages[color]) + '" alt="' + escapeHtml(color) + ' 顏色圖"><figcaption>' + escapeHtml(color) + '</figcaption><button type="button" class="danger-button" data-freight-color-image-remove="' + escapeHtml(color) + '">移除</button></figure>';
      }).join('') : '<p>尚未加入顏色圖。</p>';
    }
  }

  function setFreightImageFormState(productImages, colorImages) {
    var productInput = document.querySelector('[data-freight-product-images]');
    var colorInput = document.querySelector('[data-freight-color-images]');
    if (productInput) productInput.value = JSON.stringify(normalizeFreightProductImages(productImages));
    if (colorInput) colorInput.value = JSON.stringify(normalizeFreightColorImages(colorImages));
    renderFreightImageEditor();
  }

  function appendFreightProductImages(images, sourceLabel) {
    var cleanImages = normalizeFreightProductImages(images || []);
    var state = freightImageFormState();
    var merged = normalizeFreightProductImages(state.productImages.concat(cleanImages));
    var addedCount = Math.max(0, merged.length - state.productImages.length);
    setFreightImageFormState(merged, state.colorImages);
    if (!cleanImages.length) {
      toast('沒有讀到可用圖片，請重新選擇 JPG、PNG 或 WebP 圖片');
    } else if (!addedCount && state.productImages.length >= FREIGHT_PRODUCT_IMAGE_LIMIT) {
      toast('目前已達 ' + FREIGHT_PRODUCT_IMAGE_LIMIT + ' 張明細圖上限，請先移除不需要的圖片');
    } else if (cleanImages.length && addedCount < cleanImages.length) {
      toast('實際加入 ' + addedCount + ' 張；其餘為重複圖片或已達上限');
    } else {
      toast('已加入 ' + addedCount + ' 張產品明細圖' + (sourceLabel ? '（' + sourceLabel + '）' : '') + '；請按儲存物流永久保留');
    }
    return addedCount;
  }

  function freightListPhotoThumbHtml(src, alt, extraClass) {
    src = String(src || '').trim();
    if (!src) return '';
    alt = String(alt || '產品圖片');
    return '<button type="button" class="freight-list-photo-thumb' + (extraClass ? ' ' + extraClass : '') + '" data-order-photo="' + escapeHtml(src) + '" aria-label="放大查看 ' + escapeHtml(alt) + '"><img src="' + escapeHtml(src) + '" alt="' + escapeHtml(alt) + '" loading="lazy" decoding="async"><span>點圖放大</span></button>';
  }

  function freightItemImageGalleryHtml(item) {
    var images = normalizeFreightProductImages(item && (item.productImages || item.images) || []);
    var colorImages = normalizeFreightColorImages(item && item.colorImages || {});
    freightVariantLines(item).forEach(function (line) { if (line.color && line.image && !colorImages[line.color]) colorImages[line.color] = line.image; });
    if (!images.length && !Object.keys(colorImages).length) return '';
    return '<section class="freight-card-image-gallery"><header><b>產品圖片</b><span>明細 ' + images.length + ' 張／顏色 ' + Object.keys(colorImages).length + ' 張／點縮圖放大</span></header><div>' +
      images.map(function (src, index) { return '<figure>' + freightListPhotoThumbHtml(src, '產品明細圖 ' + (index + 1)) + '<figcaption>明細 ' + (index + 1) + '</figcaption></figure>'; }).join('') +
      Object.keys(colorImages).map(function (color) { return '<figure class="is-color">' + freightListPhotoThumbHtml(colorImages[color], color) + '<figcaption>' + escapeHtml(color) + '</figcaption></figure>'; }).join('') +
      '</div></section>';
  }

  function freightFiledPhotoHtml(item) {
    item = item || {};
    var lines = freightVariantLines(item);
    var baseCode = item.productCode || item.catalogProductCode || freightProductCodeFromBarcode(item.sampleBarcode || item.taiwanBarcode || '');
    var sources = [];
    lines.forEach(function (line) {
      freightForecastImageSources(item, line, baseCode).forEach(function (src) {
        if (sources.indexOf(src) === -1) sources.push(src);
      });
    });
    if (!lines.length) {
      normalizeFreightProductImages(item.productImages || item.images || []).forEach(function (src) {
        if (sources.indexOf(src) === -1) sources.push(src);
      });
      Object.keys(normalizeFreightColorImages(item.colorImages || {})).forEach(function (color) {
        var src = normalizeFreightColorImages(item.colorImages || {})[color];
        if (src && sources.indexOf(src) === -1) sources.push(src);
      });
