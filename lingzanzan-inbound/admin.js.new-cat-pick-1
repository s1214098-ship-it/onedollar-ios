  function freightSplitAssignVariantQty(parcel, variantIndex, quantity) {
    if (!parcel) return;
    parcel.variantAssignments = Array.isArray(parcel.variantAssignments) ? parcel.variantAssignments : [];
    var qty = Math.max(1, Math.floor(Number(quantity || 1)));
    var existing = parcel.variantAssignments.find(function (row) { return Number(row.variantIndex) === Number(variantIndex); });
    if (existing) existing.quantity = Math.max(0, Math.floor(Number(existing.quantity || 0))) + qty;
    else parcel.variantAssignments.push({ variantIndex: variantIndex, quantity: qty });
  }

  function freightSplitApplyComposerToMainForm(fields) {
    fields = fields || {};
    var product = fields.productRecord || null;
    var sku = fields.sku || null;
    var productIdInput = document.querySelector('[data-freight-product-id]');
    var productCodeInput = document.querySelector('[data-freight-product-code]');
    var productNameInput = document.querySelector('[data-freight-product-name]');
    var skuIdInput = document.querySelector('[data-freight-sku-id]');
    var qtyInput = document.querySelector('[data-freight-qty]');
    var rmbInput = document.querySelector('[data-freight-cost-rmb]');
    var twdInput = document.querySelector('[data-freight-existing-twd-cost]');
    var sampleInput = document.querySelector('[data-freight-sample-barcode]');
    if (product) {
      if (productIdInput) productIdInput.value = product.id || '';
      if (productCodeInput) productCodeInput.value = product.code || product.productLine || fields.productCode || '';
      if (productNameInput) {
        productNameInput.value = product.title || product.name || product.productName || fields.productText || '';
        productNameInput.dataset.freightExplicitProductCode = product.code || product.productLine || product.id || '';
      }
      applyFreightProductRules(product, { selectedColor: fields.color, selectedSize: fields.size });
      if (skuIdInput) skuIdInput.value = sku && (sku.id || sku.sku) || '';
    } else {
      if (productIdInput) productIdInput.value = '';
      if (skuIdInput) skuIdInput.value = '';
      if (productNameInput) {
        productNameInput.value = fields.productText || '';
        delete productNameInput.dataset.freightLockedProductName;
        delete productNameInput.dataset.freightExplicitProductCode;
      }
      var existingSame = freightVariantControlLines().find(function (line) {
        return freightVariantTextKey(line.productName || line.productCode || '') === freightVariantTextKey(fields.productText || fields.productCode || '');
      });
      if (productCodeInput) productCodeInput.value = existingSame && (existingSame.productCode || existingSame.catalogProductCode) || '';
    }
    var category = fields.category || (product && (product.category || product.categoryName || product.productCategory)) || '';
    if (category) syncFreightCategoryPath({ category: category, spec: product && (product.subcategory || product.categorySpec) || '', brand: product && (product.brand || product.brandName) || '' });
    fillFreightChoiceSelect('[data-freight-color]', collectFreightColorChoices([fields.color]), '請選擇產品顏色', fields.color || '');
    fillFreightChoiceSelect('[data-freight-size]', freightStandardSizes().concat([fields.size || 'NO SIZE']), '請選擇產品尺寸', fields.size || 'NO SIZE');
    if (qtyInput) {
      if (qtyInput.tagName === 'SELECT' && !Array.from(qtyInput.options || []).some(function (option) { return option.value === String(fields.quantity || 1); })) {
        try { qtyInput.add(new Option(String(fields.quantity || 1), String(fields.quantity || 1))); } catch (error) {}
      }
      qtyInput.value = String(fields.quantity || 1);
    }
    var latest = product ? latestEffectiveCostInfo(product, sku || {}) : { hasCost: false, cost: 0 };
    if ((!latest || !latest.hasCost) && product) latest = latestEffectiveCostAcrossSkus(product, fields.skus || (sku ? [sku] : []));
    var costTwd = Number(fields.costTwd || 0) || (latest && latest.hasCost ? Math.round(Number(latest.cost || 0)) : 0);
    var costRmb = Number(fields.costRmb || 0);
    if (!(costTwd > 0) && costRmb > 0) costTwd = Math.round(costRmb * 5);
    if (!(costRmb > 0) && costTwd > 0) costRmb = Math.round((costTwd / 5) * 100) / 100;
    if (rmbInput) rmbInput.value = costRmb > 0 ? String(costRmb) : '';
    if (twdInput) twdInput.value = costTwd > 0 ? String(costTwd) : '';
    if (sampleInput) {
      sampleInput.dataset.freightLatestCostTwd = costTwd > 0 ? String(costTwd) : '';
      sampleInput.dataset.freightLatestCostSource = latest && latest.hasCost ? String(latest.source || '最新廠商進價') : (costTwd > 0 ? '獨立點貨填入進價' : '');
    }
    freightSplitMergeFormImages(fields.color, fields.image, fields.mainImages);
    generateFreightUnifiedBarcode(true);
    return { ok: true, costTwd: costTwd, costRmb: costRmb, latest: latest };
  }

  function freightSplitCommitLineToVariants(parcel, fields) {
    fields = fields || {};
    if (!fields.category && !fields.productRecord) {
      toast('新款請先選分類，或在「新分類」輸入');
      return null;
    }
    var applied = freightSplitApplyComposerToMainForm(fields);
    if (!(applied.costTwd > 0) && !fields.productRecord) {
      toast('新款請填人民幣或台幣進價');
      return null;
    }
    var line = addCurrentFreightVariantLine({ silent: true, keepInputs: true, quantity: fields.quantity });
    if (!line) {
      toast(fields.productRecord
        ? '這組還沒產生條碼或進價，請確認分類、顏色與進價後再加入'
        : '新款還缺分類、條碼或進價，請補齊後再按新增');
      return null;
    }
    var liveRows = freightSplitPackageFormRows();
    var live = liveRows.find(function (row) {
      return parcel && (String(row.id || '') === String(parcel.id || '') || freightTrackingComparable(row.trackingNo) === freightTrackingComparable(parcel.trackingNo));
    }) || parcel;
    var lines = freightVariantControlLines();
    var variantIndex = lines.findIndex(function (candidate) { return freightVariantLineKey(candidate) === freightVariantLineKey(line); });
    if (variantIndex < 0) variantIndex = Math.max(0, lines.length - 1);
    freightSplitAssignVariantQty(live, variantIndex, fields.quantity);
    if (live && live !== parcel) {
      parcel.variantAssignments = live.variantAssignments;
    }
    renderFreightSplitPackages(liveRows.length ? liveRows : [live]);
    return line;
  }

  function freightSplitPromoteManualItemsIntoVariants() {
    var snapshot = freightSplitPackageFormRows();
    var jobs = [];
    snapshot.forEach(function (parcel) {
      (parcel.manualItems || []).forEach(function (manual) {
        jobs.push({ trackingNo: parcel.trackingNo, parcelId: parcel.id, manual: manual });
      });
    });
    if (!jobs.length) return { promoted: 0, leftover: 0 };
    var leftover = 0;
    var promoted = 0;
    jobs.forEach(function (job) {
      var manual = job.manual || {};
      var productText = String(manual.productCode || manual.product || manual.productName || '').trim();
      var color = String(manual.color || '').trim();
      var size = String(manual.size || 'NO SIZE').trim() || 'NO SIZE';
      var quantity = Math.max(1, Math.floor(Number(manual.quantity || 1)));
      if (!productText || !color) { leftover += 1; return; }
      var resolved = freightSplitResolveCatalogProduct(productText, color, size);
      if (resolved && resolved.ambiguous) { leftover += 1; return; }
      if (!(resolved && resolved.matched && resolved.product)) { leftover += 1; return; }
      var latest = latestEffectiveCostAcrossSkus(resolved.product, resolved.sku ? [resolved.sku] : []);
      var liveRows = freightSplitPackageFormRows();
      var live = liveRows.find(function (row) {
        return String(row.id || '') === String(job.parcelId || '') || freightTrackingComparable(row.trackingNo) === freightTrackingComparable(job.trackingNo);
      });
      if (!live) { leftover += 1; return; }
      var line = freightSplitCommitLineToVariants(live, {
        productRecord: resolved.product,
        sku: resolved.sku,
        skus: [],
        productText: resolved.productName || productText,
        productCode: resolved.productCode,
        color: resolved.color || color,
        size: size,
        quantity: quantity,
        image: manual.image || resolved.image,
        category: String(resolved.product.category || resolved.product.categoryName || resolved.product.productCategory || '').trim(),
        costTwd: latest.hasCost ? Math.round(Number(latest.cost || 0)) : 0,
        costRmb: 0,
        mainImages: freightSplitProductMainImages(resolved.product)
      });
      if (!line) { leftover += 1; return; }
      var afterRows = freightSplitPackageFormRows();
      var after = afterRows.find(function (row) {
        return String(row.id || '') === String(job.parcelId || '') || freightTrackingComparable(row.trackingNo) === freightTrackingComparable(job.trackingNo);
      });
      if (after) {
        after.manualItems = (after.manualItems || []).filter(function (row) {
          return !(searchLooseNormalize(row.productCode || row.product || row.productName || '') === searchLooseNormalize(productText)
            && searchLooseNormalize(row.color || '') === searchLooseNormalize(color)
            && searchLooseNormalize(row.size || 'NO SIZE') === searchLooseNormalize(size));
        });
        renderFreightSplitPackages(afterRows);
      }
      promoted += 1;
    });
    return { promoted: promoted, leftover: leftover };
  }

  function freightSplitSelectProductRow(composer, productRow) {
    if (!composer || !productRow) return;
    var productInput = composer.querySelector('[data-freight-split-new-product]');
    if (productInput) productInput.value = productRow.code || productRow.name || '';
    composer._freightSplitSelectedProduct = productRow;
    var colorHost = composer.querySelector('[data-freight-split-color-results]');
    if (colorHost) colorHost.innerHTML = (productRow.skus || []).length ? freightSplitColorPickerHtml(productRow) : '<p>這個產品尚未建立顏色，可直接輸入新顏色並上傳或貼上照片；新款也可在下方補分類、進價與主圖。</p>';
    var results = composer.querySelector('[data-freight-split-product-results]');
    if (results) results.innerHTML = '<p class="is-success">✓ 已選 ' + escapeHtml(productRow.code || productRow.name) + '；先填件數，再點顏色尺寸即可一次加入。最新廠商進價會顯示在下方。</p>';
    freightSplitPaintSelectedProductExtras(composer, productRow);
  }

  function freightSplitMergeManualLine(parcel, newLine) {
    parcel.manualItems = Array.isArray(parcel.manualItems) ? parcel.manualItems : [];
    var productKey = searchLooseNormalize(newLine.productCode || newLine.product || newLine.productName || '');
    var colorKey = searchLooseNormalize(newLine.color || '');
    var sizeKey = searchLooseNormalize(newLine.size || 'NO SIZE');
    var existing = parcel.manualItems.find(function (line) {
      return searchLooseNormalize(line.productCode || line.product || line.productName || '') === productKey
        && searchLooseNormalize(line.color || '') === colorKey
        && searchLooseNormalize(line.size || 'NO SIZE') === sizeKey;
    });
    if (existing) {
      existing.quantity = Math.max(1, Number(existing.quantity || 1)) + Math.max(1, Number(newLine.quantity || 1));
      if (newLine.image && !existing.image) existing.image = newLine.image;
      if (newLine.matched) existing.matched = true;
      return { line: existing, merged: true };
    }
    parcel.manualItems.push(newLine);
    return { line: newLine, merged: false };
  }

  // LZ_SPLIT_QTY_NOSIZE_20260924: one size button per color; qty stepper adds that many
  // LZ_SPLIT_SAVE_COST_20260924: composer adds become variant lines; latest vendor cost + new-product photos/category
  function freightSplitAddManualComposerLine(targetRow) {
    var allRows = Array.from(document.querySelectorAll('[data-freight-split-package-list] [data-freight-split-row]'));
    var targetIndex = allRows.indexOf(targetRow);
    var parcelRows = freightSplitPackageFormRows();
    var parcel = parcelRows[targetIndex];
    if (!parcel || !targetRow) return false;
    var product = String(targetRow.querySelector('[data-freight-split-new-product]')?.value || '').trim();
    var color = String(targetRow.querySelector('[data-freight-split-new-color]')?.value || '').trim();
    var size = String(targetRow.querySelector('[data-freight-split-new-size]')?.value || 'NO SIZE').trim() || 'NO SIZE';
    size = typeof canonicalNoSize === 'function' ? (canonicalNoSize(size) || size) : size;
    var selectedImage = String(targetRow.querySelector('[data-freight-split-new-image]')?.value || '').trim();
    var quantity = Math.max(1, Math.min(999, Math.floor(Number(targetRow.querySelector('[data-freight-split-new-item-qty]')?.value || 1))));
    var composer = targetRow.querySelector('.freight-split-manual-composer');
    var selectedProduct = composer && composer._freightSplitSelectedProduct;
    var extras = freightSplitReadComposerExtras(composer);
    if (!product && !color) {
      var emptyHost = targetRow.querySelector('[data-freight-split-product-results]');
      if (emptyHost) emptyHost.innerHTML = '<p class="is-warning">請先在第 ① 欄輸入產品編號／款式，再從搜尋結果選顏色與尺寸。</p>';
      var emptyProductInput = targetRow.querySelector('[data-freight-split-new-product]');
      if (emptyProductInput) emptyProductInput.focus();
      toast('請先輸入產品編號／款式');
      return false;
    }
    if (!color) {
      toast('請先選顏色與尺寸，或填顏色後按新增');
      return false;
    }
    var resolved = null;
    if (selectedProduct && selectedProduct.product) {
      var selectedSkus = selectedProduct.skus || [];
      var selectedSku = selectedSkus.find(function (row) {
        return searchLooseNormalize(row.colorName || row.color || '') === searchLooseNormalize(color)
          && searchLooseNormalize(freightSplitCanonicalSize(row)) === searchLooseNormalize(size);
      }) || selectedSkus.find(function (row) {
        return searchLooseNormalize(row.colorName || row.color || '') === searchLooseNormalize(color);
      }) || null;
      resolved = {
        matched: true,
        product: selectedProduct.product,
        sku: selectedSku,
        skus: selectedSkus,
        productId: String(selectedProduct.product.id || ''),
        productCode: String(selectedProduct.code || selectedProduct.product.code || selectedProduct.product.productLine || ''),
        productName: String(selectedProduct.name || selectedProduct.product.title || selectedProduct.product.name || product),
        skuId: String(selectedSku && (selectedSku.id || selectedSku.sku) || ''),
        color: color,
        size: size,
        image: selectedImage || freightExistingProductImage(selectedProduct.product, selectedSku, selectedSkus)
      };
    } else {
      resolved = freightSplitResolveCatalogProduct(product, color, size);
      if (resolved && resolved.ambiguous) { toast('找到多個相近產品，請改輸入完整產品編號後再加入，避免配錯圖片'); return false; }
    }
    var isCatalog = !!(resolved && resolved.matched && resolved.product);
    var category = extras.category || (isCatalog ? String(resolved.product.category || resolved.product.categoryName || resolved.product.productCategory || '').trim() : '');
    if (!isCatalog && !category) {
      toast('這是店裡還沒有的新款：請先選分類，或在「新分類」輸入');
      var catManual = composer && composer.querySelector('[data-freight-split-new-category-manual]');
      if (catManual) catManual.focus();
      return false;
    }
    var costTwd = extras.costTwd;
    var costRmb = extras.costRmb;
    if (isCatalog && !(costTwd > 0)) {
      var latest = latestEffectiveCostInfo(resolved.product, resolved.sku || {});
      if (!latest.hasCost) latest = latestEffectiveCostAcrossSkus(resolved.product, resolved.skus || (resolved.sku ? [resolved.sku] : []));
      if (latest.hasCost) costTwd = Math.round(Number(latest.cost || 0));
    }
    if (!isCatalog && !(costTwd > 0) && !(costRmb > 0)) {
      toast('這是店裡還沒有的新款：請填人民幣或台幣進價');
      var rmbField = composer && composer.querySelector('[data-freight-split-new-cost-rmb]');
      if (rmbField) rmbField.focus();
      return false;
    }
    var line = freightSplitCommitLineToVariants(parcel, {
      productRecord: isCatalog ? resolved.product : null,
      sku: isCatalog ? resolved.sku : null,
      skus: isCatalog ? (resolved.skus || []) : [],
      productText: isCatalog ? (resolved.productName || product) : product,
      productCode: isCatalog ? resolved.productCode : '',
      color: color,
      size: size,
      quantity: quantity,
      image: selectedImage || (isCatalog ? resolved.image : '') || extras.colorImage,
