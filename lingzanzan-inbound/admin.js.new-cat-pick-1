      [location.shelf].filter(function (item) { return item && !isInvalidShelfName(item); }).forEach(function (item) { if (state.shelves.indexOf(item) === -1) state.shelves.push(item); });
      [location.layer].filter(function (item) { return item && !isInvalidLayerName(item); }).forEach(function (item) { if (state.layers.indexOf(item) === -1) state.layers.push(item); });
    });
    state.shelves = state.shelves.filter(function (item) { return !isInvalidShelfName(item); });
    state.defaultShelves = state.defaultShelves.filter(function (item) { return !isInvalidShelfName(item); });
    state.layers = state.layers.filter(function (item) { return !isInvalidLayerName(item); });
    // Legacy barcode/color mappings remain available to scanners, but must
    // not populate the product color picker by themselves. The picker is a
    // curated list; unused bilingual legacy labels should stay removed.
    if (!state.defaultShelves.length) state.defaultShelves.push('台灣倉 / A架 / 第一層');
  }

  function promiseWithTimeout(promise, timeoutMs, message) {
    var timer = null;
    return Promise.race([
      promise,
      new Promise(function (_, reject) {
        timer = setTimeout(function () {
          reject(new Error(message || '連線逾時'));
        }, timeoutMs || 8000);
      })
    ]).then(function (value) {
      if (timer) clearTimeout(timer);
      return value;
    }, function (error) {
      if (timer) clearTimeout(timer);
      throw error;
    });
  }

  function fetchJsonWithTimeout(url, options, timeoutMs, message) {
    timeoutMs = Math.max(8000, Number(timeoutMs || 30000));
    options = options || {};
    var controller = typeof AbortController === 'function' ? new AbortController() : null;
    var timer = controller ? setTimeout(function () { controller.abort(); }, timeoutMs) : null;
    if (controller) options.signal = controller.signal;
    return fetch(url, options).then(function (res) {
      return res.text().then(function (rawText) {
        var data;
        try {
          data = rawText ? JSON.parse(rawText) : {};
        } catch (parseError) {
          var snippet = String(rawText || '').replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim().slice(0, 160);
          throw new Error(res.ok ? '後台回傳不是正確資料' : ('資料未儲存 HTTP ' + res.status + (snippet ? '：' + snippet : '')));
        }
        if (!res.ok || !data.ok) throw new Error(data.error || message || '資料寫入失敗');
        return data;
      });
    }).catch(function (error) {
      if (error && error.name === 'AbortError') throw new Error(message || '後台連線逾時，請先確認是否已寫入，再決定是否重試');
      throw error;
    }).finally(function () {
      if (timer) clearTimeout(timer);
    });
  }

