  function freightWorkbenchFilteredCandidates() {
    var rawKeyword = document.querySelector('[data-freight-workbench-search]')?.value || '';
    var shortcutCode = freightShortProductCode(rawKeyword);
    var keyword = freightSearchKeyword(rawKeyword);
    var suffixKey = normalizeFreightIdentityNumber(rawKeyword).replace(/\D/g, '');
    var useSuffix = /^\d+$/.test(String(rawKeyword || '').trim().replace(/\s+/g, '')) && suffixKey.length >= 4;
    var platformFilter = canonicalPurchasePlatformName(document.querySelector('[data-freight-account-filter]')?.value || '');
    var sourceRows = Array.isArray(adminFreightWorkbenchServerRows)
      ? adminFreightWorkbenchServerRows
      : normalizeFreightTracking(state.freightTracking).items;
    return sourceRows.filter(function (item) {
      if (item.batchId || freightItemLeavesBatchSelection(item)) return false;
      if (platformFilter && canonicalPurchasePlatformName(item.purchaseAccount || item.platform || '') !== platformFilter) return false;
      if (shortcutCode) return freightItemMatchesProductCode(item, shortcutCode);
      if (useSuffix) return freightWorkbenchTrackingSuffixMatch(item, suffixKey);
      return !keyword || searchMatchesParts(freightWorkbenchItemSearchText(item), keyword);
    });
  }

  function freightWorkbenchShortTrackingQuery(value) {
    var compact = String(value || '').trim().replace(/\s+/g, '');
    var digits = compact.replace(/\D/g, '');
    var looksLikeTracking = /^\d+$/.test(compact) || /^(?:YT|SF|STO|ZTO|YTO|JT|EMS)\d+$/i.test(compact);
    return looksLikeTracking && digits.length > 0 && digits.length < 4;
  }

  function freightWorkbenchLogisticsImage(item) {
    item = item || {};
    var colorImages = normalizeFreightColorImages(item.colorImages || {});
    var wantedColor = String(item.color || item.colorName || '').trim();
    if (wantedColor && colorImages[wantedColor]) return String(colorImages[wantedColor]);
    var variant = freightVariantLines(item).find(function (line) {
      return line.image && (!wantedColor || String(line.color || '').trim() === wantedColor);
    });
    if (variant && variant.image) return String(variant.image);
    return String(normalizeFreightProductImages(item.productImages || item.images || [])[0] || item.image || item.photo || '');
  }

  function freightWorkbenchReferenceImage(item) {
    item = item || {};
    var filed = freightItemFiledProductInfo(item) || {};
    var productCode = String(filed.code || item.catalogProductCode || item.productCode || freightProductCodeFromBarcode(item.sampleBarcode || '') || '').trim();
    var product = state.products.find(function (row) {
      return String(row.id || '') === String(filed.id || item.productId || '')
        || (productCode && String(row.code || row.productCode || '') === productCode);
    });
    var sku = state.skus.find(function (row) {
      return String(row.id || row.sku || '') === String(filed.skuId || item.skuId || '')
        || String(row.barcode || row.skuBarcode || '') === String(item.sampleBarcode || item.taiwanBarcode || '');
    });
    if (product) return { src: freightExistingProductImage(product, sku), label: '正式商品照片' };
    var customerLink = (Array.isArray(item.customerLinks) ? item.customerLinks : []).find(function (link) {
      return link && (link.inquiryId || link.customerOrderNo || link.orderId);
    }) || {};
    var linkedOrderId = item.inquiryId || item.customerOrderNo || item.orderId || customerLink.inquiryId || customerLink.customerOrderNo || customerLink.orderId || '';
    var linkedLineId = item.inquiryLineId || customerLink.lineId || customerLink.inquiryLineId || '';
    var linkedItemIndex = item.inquiryItemIndex != null ? item.inquiryItemIndex : customerLink.itemIndex;
    var order = state.inquiries.find(function (row) {
      return String(row.id || row.orderNo || '') === String(linkedOrderId);
    });
    var orderItems = order && Array.isArray(order.items) ? order.items : [];
    var orderLine = orderItems.find(function (line, index) {
      return (linkedLineId && String(line.lineId || line.id || '') === String(linkedLineId))
        || (linkedItemIndex != null && Number(linkedItemIndex) === index);
    });
    var src = orderLine && (orderLine.image || orderLine.productImage || orderLine.thumbnail || orderLine.photo) || '';
    return { src: String(src || ''), label: src ? '預購訂單照片' : '尚無比對照片' };
