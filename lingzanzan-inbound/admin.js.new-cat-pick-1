  function setFreightFifoProductScope(items, trackingNo, candidateInquiryIds) {
    items = (items || []).filter(Boolean);
    if (!items.length) {
      freightFifoProductScope = null;
      renderFreightCustomerShipmentQueue();
      return;
    }
    var linkedInquiryIds = new Set();
    items.forEach(function (item) {
      var links = Array.isArray(item.inventoryLinkedOrders)
        ? item.inventoryLinkedOrders
        : (Array.isArray(item.customerLinks) ? item.customerLinks : []);
      links.forEach(function (link) {
        var id = String(link && (link.inquiryId || link.customerOrderNo) || '');
        if (id) linkedInquiryIds.add(id);
      });
    });
    (Array.isArray(candidateInquiryIds) ? candidateInquiryIds : []).forEach(function (id) {
      id = String(id || '');
      if (id) linkedInquiryIds.add(id);
    });
    var remainingCompanyQty = items.reduce(function (sum, item) {
      var links = Array.isArray(item.inventoryLinkedOrders)
        ? item.inventoryLinkedOrders
        : (Array.isArray(item.customerLinks) ? item.customerLinks : []);
      var linkedQty = links.reduce(function (qty, link) {
        return qty + Math.max(0, Number(link && link.qty || 0));
      }, 0);
      var receivedQty = Math.max(0, Number(item.receivingActualQty || item.quantity || 0));
      return sum + Math.max(0, Number(item.companyStockQty != null ? item.companyStockQty : receivedQty - linkedQty));
    }, 0);
    freightFifoProductScope = {
      trackingNo: String(trackingNo || items[0].trackingNo || ''),
      label: items.map(function (item) {
        return item.productCode || item.productName || '未命名產品';
      }).filter(function (label, index, labels) { return labels.indexOf(label) === index; }).join('、'),
      lines: freightFifoScopeLines(items),
      linkedInquiryIds: linkedInquiryIds,
      strictInquiryIds: Array.isArray(candidateInquiryIds) || (linkedInquiryIds.size > 0 && remainingCompanyQty <= 0)
    };
    renderFreightCustomerShipmentQueue();
  }

  function freightFifoRowMatchesScope(row) {
