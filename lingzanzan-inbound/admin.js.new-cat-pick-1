  function saveFreightBatch() {
    var batch = freightBatchFormData();
    if (!batch.id) {
      toast('請先在集運追蹤建立或匯入正式批次；物流打單區只負責綁入既有批次');
      return;
    }
    if (!batch.batchNo) {
      toast('請先輸入這批貨的批號');
      return;
    }
    if (!batch.logisticsTrackingNo) {
      toast('請輸入物流條碼或集運單號');
      return;
    }
    if (!batch.itemCount || batch.itemCount < 1) {
      toast('請填本批商品總件數');
      return;
    }
    if (batch.provider !== 'haohong' && !batch.purchaseAccount) {
      toast('請選擇本批最終集運帳號；儲存後會回寫批次內全部物流');
      document.querySelector('[data-freight-batch-platform]')?.focus();
      return;
    }
    if (batch.provider === 'pinduoduo' && Number(batch.amount || 0) > 0 && Number(batch.costBasisQty || 0) < 1) {
      toast('已有關稅／台灣快遞費用，請先填關稅單號件數；成本必須依關稅登記件數分攤');
      document.querySelector('[data-freight-customs-package-count]')?.focus();
      return;
    }
    state.freightTracking = normalizeFreightTracking(state.freightTracking);
    var index = state.freightTracking.batches.findIndex(function (row) { return row.id === batch.id; });
    if (index >= 0) {
      var existingBatch = state.freightTracking.batches[index];
      var mergedBatch = Object.assign({}, existingBatch, batch);
      if (batch.provider !== 'haohong') {
        mergedBatch.purchaseAccount = batch.purchaseAccount;
        mergedBatch.platform = batch.purchaseAccount;
        mergedBatch.purchaseAccounts = batch.purchaseAccount ? [batch.purchaseAccount] : [];
      }
      freightApplyBatchLastFilterToRecords(mergedBatch);
      state.freightTracking.batches[index] = mergedBatch;
    }
    else {
      toast('找不到這筆既有批次，請重新整理後再修改');
      return;
    }
    saveFreightTracking().then(function () {
      resetFreightBatchEntryForm();
      resetFreightWorkbenchAfterSave();
      toast('批次已儲存：' + (batch.batchName || batch.batchNo));
      return reconcileFreightBatchCosts(batch.id, { quietIfPending: true }).catch(function (error) {
        console.warn('freight batch saved but cost reconciliation failed', error);
        toast('批次已儲存；已入庫成本回溯暫時失敗：' + (error.message || error) + '。可按「重算已入庫成本」補做，庫存數量不受影響');
        return null;
      });
    }).then(function (reconciliation) {
      if (reconciliation) toast('已入庫品項已依實收數量核對成本，庫存件數不重複增減');
    }).catch(function (error) {
      toast(error.message || '集運批次儲存失敗');
    });
  }

  function reconcileFreightBatchCosts(batchId, options) {
    options = options || {};
    batchId = String(batchId || '').trim();
    if (!batchId) return Promise.reject(new Error('缺少要回溯成本的集運批次'));
    var batch = freightBatchById(batchId);
    var prepare = options.skipBaohuiRefresh
      ? Promise.resolve(batch)
      : refreshBatchCustomsFromBaohuiThen(batch).then(function (updated) {
          if (!updated) return null;
          return saveFreightTracking().then(function () { return updated; });
        });
    return prepare.then(function () {
      return callStockInquiryApi({
        action: 'reconcile-freight-batch-cost',
        freightBatchId: batchId
      });
    }).then(function (data) {
      var result = data && data.reconciliation || {};
      var adjustedItems = Math.max(0, Number(result.adjustedItemCount || 0));
      var adjustedLines = Math.max(0, Number(result.adjustedLineCount || 0));
      var qty = Math.max(0, Number(result.qty || 0));
      var delta = Number(result.deltaTwd || 0);
      var deltaLabel = (delta > 0 ? '增加 ' : (delta < 0 ? '扣回 ' : '差額 ')) + 'NT$' + Math.abs(delta).toLocaleString();
      return loadFreightTracking(true).catch(function () {}).then(function () {
        if (adjustedItems > 0) {
          toast('成本回溯完成：' + adjustedItems + ' 筆物流／' + adjustedLines + ' 個顏色尺寸／' + qty + ' 件，' + deltaLabel + '；庫存數量未變');
        } else if (!options.quietIfPending || Number(result.unchangedItemCount || 0) > 0) {
          toast(data.message || '本批尚無已入庫品項，之後入庫會使用最新集運成本');
        }
        return data;
      });
    });
  }

