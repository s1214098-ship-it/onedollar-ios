  function loadAdminOrdersFromServerSearch(query) {
    query = String(query || '');
    if (query.normalize) query = query.normalize('NFKC');
    query = query.replace(/[\u200B-\u200D\u2060\uFEFF]/g, '').trim();
    if (adminOrderCustomerScope.baseQuery !== query) {
      adminOrderCustomerScope = readAdminOrderCustomerScope(query) || { baseQuery: query, key: '', from: '', to: '', page: 1 };
      saveAdminOrderCustomerScope();
    }
    if (adminCurrentFileName() !== 'admin-orders.html') return ensureAdminOrdersDeferredData();
    adminOrderCustomerHistoryRows = [];
    renderAdminOrderCustomerHistory(query);
    var digits = query.replace(/\D/g, '');
    if (/^\d+$/.test(query) && adminOrderSearchIsTooShort(query)) {
      renderShortPhoneSearchPrompt();
      adminOrderServerSearchStatus(adminOrderSearchMinimumMessage(query), 'minimum');
      return Promise.resolve(false);
    }
    if (!/^\d+$/.test(query) && query.length < 2) {
      adminOrderServerSearchStatus('姓名或訂單資料請至少輸入 2 個字。', 'minimum');
      return Promise.resolve(false);
    }
    if (adminOrderServerSearchController && typeof adminOrderServerSearchController.abort === 'function') {
      adminOrderServerSearchController.abort();
    }
    adminOrderServerSearchController = typeof AbortController === 'function' ? new AbortController() : null;
    adminOrderServerSearchSequence += 1;
    var sequence = adminOrderServerSearchSequence;
    var url = './admin-order-search-api.php?q=' + encodeURIComponent(query) + '&limit=10&history=' + (adminOrderSearchIsPhoneOnly(query) ? '1' : '0')
      + '&customerKey=' + encodeURIComponent(adminOrderCustomerScope.key)
      + '&from=' + encodeURIComponent(adminOrderCustomerScope.from)
      + '&to=' + encodeURIComponent(adminOrderCustomerScope.to)
      + '&page=' + encodeURIComponent(String(adminOrderCustomerScope.page || 1))
      + '&_=' + Date.now();
    document.body.setAttribute('data-admin-orders-searching', 'true');
    adminOrderServerSearchStatus('正在伺服器搜尋「' + query + '」；只回傳最多 10 筆，不下載完整訂單檔。', 'searching');
    var options = {
      cache: 'no-store',
      credentials: 'same-origin',
      headers: adminAuthorizationHeaders()
    };
    if (adminOrderServerSearchController) options.signal = adminOrderServerSearchController.signal;
    return fetch(url, options).then(function (response) {
      return response.json().catch(function () { return {}; }).then(function (payload) {
        if (!response.ok || !payload || payload.ok !== true) throw new Error(payload && payload.error || '訂單搜尋失敗');
        return payload;
      });
    }).then(function (payload) {
      if (sequence !== adminOrderServerSearchSequence) return false;
      var currentQuery = String(document.querySelector('[data-order-search]')?.value || '').trim();
      if (currentQuery !== query) return false;
      state.orders = normalizeOrderRows(payload.orders);
      renderAdminOrderSearchMatches(payload, query);
      renderAdminOrderCustomerScope(payload, query);
      adminOrderCustomerHistoryRows = normalizeOrderRows(payload.historyOrders || []);
      adminOrdersDeferredDataLoaded = true;
      adminOrderServerSearchTotal = Math.max(0, Number(payload.count || state.orders.length));
      adminOrderMergeCountIndex = null;
      adminOrderSearchIndexCache = typeof WeakMap === 'function' ? new WeakMap() : null;
      renderOrders();
      renderAdminOrderCustomerHistory(query);
      adminOrderServerSearchStatus('找到 ' + adminOrderServerSearchTotal + ' 筆；畫面只載入最符合的 ' + state.orders.length + ' 筆。需要其他結果可再補姓名、電話或單號。', 'ready');
      document.body.setAttribute('data-admin-orders-search-source', 'server');
      document.body.setAttribute('data-admin-orders-search-count', String(adminOrderServerSearchTotal));
      return true;
    }).catch(function (error) {
      if (error && error.name === 'AbortError') return false;
      if (sequence !== adminOrderServerSearchSequence) return false;
      adminOrderServerSearchStatus(error && error.message ? error.message : '訂單搜尋失敗，請稍後再試。', 'error');
      toast(error && error.message ? error.message : '訂單搜尋失敗，請稍後再試');
      return false;
    }).then(function (result) {
      if (sequence === adminOrderServerSearchSequence) {
        document.body.removeAttribute('data-admin-orders-searching');
        adminOrderServerSearchController = null;
      }
      return result;
    });
  }

