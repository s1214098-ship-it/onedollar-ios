  function saveFreightCustomsReselection(batchId, control) {
    var batch = freightBatchById(batchId);
    var modal = control && control.closest('[data-freight-customs-reselection]');
    var select = modal && modal.querySelector('[data-freight-customs-reselection-select]');
    var reasonInput = modal && modal.querySelector('[data-freight-customs-reselection-reason]');
    var selected = String(select && select.value || '');
    var reason = String(reasonInput && reasonInput.value || '').trim();
    if (!batch) { toast('找不到要更正的物流批次'); return; }
    var hasFormalInventoryReceipt = freightBatchHasFormalInventoryReceipt(batch);
    if (selected.indexOf('BAOHUI:') !== 0) { toast('請選擇寶輝關稅號碼'); if (select) select.focus(); return; }
    var customs = (state.baohuiCustoms || [])[Number(selected.split(':')[1])];
    if (!customs) { toast('找不到這筆寶輝關稅資料，請重新整理'); return; }
    var oldSnapshot = {
      customsNo: batch.customsNo || batch.consolidationNo || '',
      taiwanTrackingNo: batch.taiwanTrackingNo || '',
      dutyTwd: Number(batch.dutyTwd || 0),
      taiwanCourierFeeTwd: Number(batch.taiwanCourierFeeTwd || batch.handlingFeeTwd || 0),
      chargeTotalTwd: Number(batch.chargeTotalTwd || batch.amount || 0),
      customsPackageCount: Number(batch.customsPackageCount || 0),
      baohuiCustomsId: batch.baohuiCustomsId || ''
    };
    var newNo = customs.customsNo || customs.taiwanTrackingNo || '';
    var sameNumber = String(oldSnapshot.baohuiCustomsId || oldSnapshot.customsNo) === String(customs.id || newNo);
    if (sameNumber && !reason) reason = '補填／更正關稅費用後重抓實收';
    if (!reason) { toast('請填寫更正原因'); if (reasonInput) reasonInput.focus(); return; }
    if (sameNumber && !freightBatchCustomsCostIsStale(batch, customs)) {
      toast('這筆關稅實收已與寶輝相同，不必重抓');
      if (select) select.focus();
      return;
    }
    var now = new Date().toISOString();
    var cost = applyBaohuiCustomsCostsToBatch(batch, customs);
