    var freeShipping = false; // Free shipping is selected explicitly, never by subtotal.
    var linkedShipping = skipLinkedLookup
      ? { waived: false, orderIds: [] }
      : adminLinkedShippingStatus(form);
    linkedShipping.waived = false; // Existing orders are informational, not permission to waive a fee.
    var fee = regularFee;
