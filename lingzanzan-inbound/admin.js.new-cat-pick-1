  function freightPostJsonWithTimeout(body, timeoutMs) {
    timeoutMs = Math.max(5000, Number(timeoutMs || 30000));
    var controller = typeof AbortController === 'function' ? new AbortController() : null;
    var timer = controller ? setTimeout(function () { controller.abort(); }, timeoutMs) : null;
    var options = {
      method: 'POST',
      headers: adminAuthorizationHeaders({ 'Content-Type': 'application/json' }),
      body: JSON.stringify(body || {})
    };
    if (controller) options.signal = controller.signal;
    return fetch('./freight-tracking-api.php', options).then(function (response) {
      return response.json().catch(function () { return {}; }).then(function (payload) {
        if (!response.ok || !payload.ok) throw new Error(payload.error || ('API failed ' + response.status));
        return payload;
      });
    }).catch(function (error) {
      if (error && error.name === 'AbortError') throw new Error('API timeout; reload and press continue once.');
      throw error;
    }).finally(function () {
      if (timer) clearTimeout(timer);
    });
  }
  function syncFreightBatchActualAfterInspection(itemId, actualQty) {
    var item = freightItemById(itemId);
    var batch = freightArrivalBatchForItem(item);
    if (!item || !batch) return Promise.resolve();
    // The inspection endpoint has already saved this item's exact quantity.
    // Ask the server to merge only the affected batch receiving/cost fields
    // while it holds the freight lock. A shipping-order page may update
    // customer allocations at the same moment; resending the entire freight
    // document here used to produce a revision conflict or overwrite risk.
    return freightPostJsonWithTimeout({
        action: 'sync-batch-receiving-after-inspection',
        freightItemId: itemId,
        actualQty: Math.max(0, Math.floor(Number(actualQty) || 0)),
        clientMutationId: 'receiving-batch-sync-' + freightStableToken([
          itemId,
          Math.max(0, Math.floor(Number(actualQty) || 0))
        ].join('|'))
      }, 12000).then(function (payload) {
        var compactState = normalizeFreightTracking(state.freightTracking);
        if (payload.batch) {
          var batchIndex = compactState.batches.findIndex(function (row) {
            return String(row && row.id || '') === String(payload.batch && payload.batch.id || '');
          });
          if (batchIndex >= 0) compactState.batches[batchIndex] = payload.batch;
          else compactState.batches.unshift(payload.batch);
        }
        if (payload.revision != null) compactState.revision = Math.max(0, Number(payload.revision || 0));
        if (payload.updatedAt) compactState.updatedAt = payload.updatedAt;
        state.freightTracking = compactState;
        return payload;
      });
  }

  function continueFreightReceivingAfterInspection(itemId, actual, expected, button, modal, actionStatus, allocationMode, selectedDestination, confirmReleaseCustomerReservations, selectedStockPurpose) {
    if (actionStatus) {
      actionStatus.className = 'freight-receiving-action-status is-working';
      actionStatus.textContent = '點貨數量已保存，正在同步這一批的成本與入庫資料；請勿重複按。';
    }
    if (button) button.textContent = '點貨已存，正在同步批次…';
    return syncFreightBatchActualAfterInspection(itemId, actual).catch(function (error) {
      var message = String(error && error.message || '');
      if (/尚未開始點貨|不能同步驗收數量/.test(message)) return null;
      throw error;
    }).then(function () {
      if (actionStatus) actionStatus.textContent = '批次資料已同步，正在核對客戶分配與正式庫存。';
      if (button) button.textContent = '正在核對客戶與正式庫存…';
      toast('最終驗收已保存：原登記 ' + expected + ' 件／實收 ' + actual + ' 件；接著確認正式入庫與客戶分流');
      if (actual <= 0) {
        modal.remove();
        renderFreightTracking();
        toast('本筆最終實收 0 件，已列短少追蹤，不建立進貨單');
        return;
      }
      quickReceiveFreightItem(itemId, button, allocationMode, selectedDestination, confirmReleaseCustomerReservations, selectedStockPurpose);
    });
  }

  function voidFreightReceivingWorkbench(button) {
    // LZ_WORKBENCH_VOID_DOC_20260923
    var modal = document.querySelector('[data-freight-receiving-workbench]');
    if (!modal) return;
    var itemId = modal.getAttribute('data-freight-receiving-workbench') || '';
    var item = freightItemById(itemId);
    if (!item) { toast('找不到這筆物流產品'); return; }
    if (item.receivingVoided === true || String((item.receivingInspection && item.receivingInspection.status) || '') === 'voided' || String(item.receivingStage || '') === 'voided' || /作廢/.test(String(item.progress || ''))) {
      toast('這一張已經作廢');
      return;
    }
    if (typeof freightItemHasPostedInventory === 'function' ? freightItemHasPostedInventory(item) : !!(item.inventoryReceivedAt || item.productFiledInventoryReceived || String(item.inventoryStatus || '') === 'received')) {
      toast('已正式入庫，不能作廢；請走退貨／沖銷，不要從驗收作廢');
      return;
    }
    var trackingNo = String(item.trackingNo || item.haohongTrackingNo || '').trim();
    var label = trackingNo || item.productCode || item.productName || itemId;
    if (!window.confirm('確定作廢這一張物流單（' + label + '）？整張不會入庫，歷史紀錄會保留。')) return;
    var reason = freightAskVoidReason('沒寄到');
    if (!reason) return;
    var targets = (state.freightTracking && Array.isArray(state.freightTracking.items) ? state.freightTracking.items : []).filter(function (row) {
      if (!row) return false;
      if (String(row.id || '') === String(itemId)) return true;
      if (!trackingNo) return false;
      if (String(row.trackingNo || '') !== trackingNo && String(row.haohongTrackingNo || '') !== trackingNo) return false;
      return !(row.receivingVoided === true || String((row.receivingInspection && row.receivingInspection.status) || '') === 'voided');
    });
    if (!targets.length) targets = [item];
    var actionStatus = modal.querySelector('[data-freight-receiving-action-status]');
    if (actionStatus) {
      actionStatus.className = 'freight-receiving-action-status is-working';
      actionStatus.textContent = '正在作廢這一張單，不會入庫…';
    }
    Array.from(modal.querySelectorAll('[data-freight-receiving-void]')).forEach(function (control) {
      control.disabled = true;
      control.setAttribute('data-idle-label', control.getAttribute('data-idle-label') || control.textContent || '');
      control.textContent = '正在作廢…';
    });
    if (button) {
      button.disabled = true;
      button.setAttribute('data-idle-label', button.getAttribute('data-idle-label') || button.textContent || '');
      button.textContent = '正在作廢…';
    }
    var sequence = Promise.resolve();
    targets.forEach(function (row) {
      sequence = sequence.then(function () {
        var lines = freightVariantLines(row).map(function () {
          return { actualQty: 0, voided: true, voidReason: reason };
        });
        return freightPostJsonWithTimeout({
          action: 'save-receiving-inspection',
          freightItemId: row.id,
          lines: lines,
          voided: true,
          voidReason: reason,
          varianceReason: reason,
          final: true,
          auditAction: '作廢物流單'
        }, 30000);
      });
