  function preorderItemReadyStockQty(item) {
    var itemIdentities = preorderOfficialProductIdentities(
      [item && (item.code || item.productCode)],
      [item && item.sku, item && item.skuId, item && item.productId, item && item.barcode]
    );
    var identityList = Array.from(itemIdentities).sort();
    var itemCode = preorderItemCode(item);
    var cacheKey = [
      identityList.join(','),
      freightDemandIdentity(canonicalProductSpecificVariantColor(itemCode, preorderItemColor(item))),
      freightDemandIdentity(canonicalProductVariantSize(preorderItemSize(item)))
    ].join('|');
    var context = freightFifoPlanningContext;
    if (context && context.readyStockQty.has(cacheKey)) return context.readyStockQty.get(cacheKey);
    var readyQty = 0;
    (state.skus || []).forEach(function (sku) {
      if (freightSkuWarehouseCode(sku) !== 'TW' || Number(sku.stock || 0) <= 0) return;
      var product = context
        ? (context.productById.get(String(sku.productId || '')) || {})
        : ((state.products || []).find(function (candidate) { return String(candidate.id || '') === String(sku.productId || ''); }) || {});
      var skuIdentities = preorderOfficialProductIdentities(
        [product.code, sku.productCode],
        [sku.id, sku.sku, sku.companyBarcode, sku.barcode, sku.legacyBarcode, sku.productId, product.id]
      );
