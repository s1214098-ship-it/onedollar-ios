  function freightSupplementalChildFromVariants(parent, variants, sequence, note) {
    var now = new Date().toISOString();
    var total = (variants || []).reduce(function (sum, line) {
      return sum + Math.max(0, Number(line && (line.quantity || line.qty) || 0));
    }, 0);
    var child = Object.assign({}, parent || {});
    [
      'inventoryReceiptClaim', 'inventoryReceivedAt', 'receivedAt', 'inventoryReceivedWarehouse', 'inventoryStatus',
      'inventoryOperationId', 'receivingDocumentId', 'receivingDocumentNo', 'receivingStage', 'receivingStatus',
      'freightReceivingStatus', 'receivingInspection', 'receivingActualQty', 'receivingExpectedQty',
      'receivingQuantityDifference', 'receivingVarianceReason', 'quantityReconciliationRequired',
      'quantityReconciliationStatus', 'quantityReconciliationNote', 'quantityReconciliationUpdatedAt',
      'productFiledInventoryReceiptId', 'productFiledInventoryReceiptNo', 'customerAllocatedQty', 'companyStockQty'
    ].forEach(function (key) { delete child[key]; });
    var first = variants[0] || {};
    var supplementalId = 'SPLIT-' + Date.now() + '-' + Math.random().toString(36).slice(2, 7).toUpperCase();
    child.id = 'FRTI-' + Date.now() + '-' + Math.random().toString(36).slice(2, 7).toUpperCase();
    child.parentFreightItemId = parent.id || '';
    child.parentInventoryOperationId = parent.inventoryOperationId || parent.inventoryReceiptClaim && parent.inventoryReceiptClaim.operationId || '';
    child.isSupplementalSplitReceipt = true;
    child.supplementalReceiptId = supplementalId;
    child.supplementalSequence = sequence;
    child.supplementalTrackingNo = parent.trackingNo || parent.supplementalTrackingNo || '';
    child.sourceFreightBatchId = parent.batchId || parent.sourceFreightBatchId || '';
    child.batchId = '';
    ['computerWarehouseReceivedAt', 'computerWarehouseReceivedLines', 'baohuiTransferId', 'baohuiTransferStatus', 'productFiledInventoryReceivedAt'].forEach(function (key) { delete child[key]; });
    child.quantity = total;
    child.qty = total;
    child.productId = first.productId || child.productId || '';
    child.skuId = first.skuId || child.skuId || '';
    child.productCode = first.productCode || first.catalogProductCode || child.productCode || '';
    child.catalogProductCode = first.catalogProductCode || first.productCode || child.catalogProductCode || '';
    child.productName = first.productName || child.productName || '';
    child.productFiledProductId = first.productId || child.productFiledProductId || '';
    child.productFiledProductCode = first.productCode || first.catalogProductCode || child.productFiledProductCode || '';
    child.productFiledProductTitle = first.productName || child.productFiledProductTitle || '';
    child.productFiledSkuId = first.skuId || child.productFiledSkuId || '';
    child.productFiledSkuIds = variants.map(function (line) { return String(line.skuId || '').trim(); }).filter(Boolean);
    child.productFiledBarcode = first.sampleBarcode || first.taiwanBarcode || first.barcode || child.productFiledBarcode || '';
    child.productFiledBarcodes = variants.map(function (line) { return line.sampleBarcode || line.taiwanBarcode || line.barcode || ''; }).filter(Boolean);
    child.productFiledStatus = 'filed';
    child.productFiledInventoryReceived = false;
    // New split lines carry their own cost; never borrow another product's parent cost.
    child.fixedTwdCost = false;
    child.costRmb = Math.max(0, Number(first.costRmb || 0));
    child.existingTwdCost = Math.max(0, Number(first.barcodeCostTwd || 0));
    child.variants = variants.map(function (line, index) {
      var cleanLine = Object.assign({}, line);
      ['inventoryReceivedAt', 'baohuiTransferId', 'inventoryOperationId', 'inventoryReceiptClaim', 'computerWarehouseReceivedAt'].forEach(function (key) { delete cleanLine[key]; });
      return normalizeFreightVariantLine(Object.assign({}, cleanLine, {
        quantity: Math.max(1, Number(line.quantity || line.qty || 1)),
        qty: Math.max(1, Number(line.quantity || line.qty || 1))
      }), index, child);
    });
    child.supplementalReceivingPrefillLines = child.variants.map(function (line, index) {
      return { sourceVariantIndex: index, actualQty: Math.max(0, Math.floor(Number(line.quantity || line.qty || 0))) };
    });
    child.supplementalReceivingPrefillTotal = total;
    child.customerLinks = [];
    child.purchaseOffsetId = '';
    child.purchaseOffsetIds = [];
    child.purchaseOffsetQty = 0;
    child.purchaseOffsetStatus = '';
    child.inventoryOwnership = 'auto_mixed';
    child.progress = '拆包追加待驗收';
    child.note = [note || '同物流單號新增產品待驗收', '原物流已入庫；本次為同單號新增產品／拆包 ' + sequence + '，尚未正式入庫'].filter(Boolean).join('；');
    child.splitPackages = [{ id: supplementalId, trackingNo: child.supplementalTrackingNo, quantity: total, status: '新增產品待驗收', note: note || '', createdAt: now }];
    child.trackingNumbers = [child.supplementalTrackingNo].filter(Boolean);
    child.createdAt = now;
    child.updatedAt = now;
    return child;
  }

  function freightSupplementalPendingRows(parent) {
    return (Array.isArray(parent && parent.pendingSupplementalReceipts) ? parent.pendingSupplementalReceipts : [])
      .filter(function (row) { return row && String(row.status || 'pending') === 'pending'; });
  }

  function freightSupplementalPendingHtml(parent) {
    var rows = freightSupplementalPendingRows(parent);
    if (!rows.length) return '';
    return '<section class="freight-supplemental-pending-review"><header><div><small>PENDING APPROVAL／待批准追加</small><b>原預報 + 新增不同產品，確認無誤後才帶入驗收</b></div><strong>' + rows.length + ' 筆待審核</strong></header>' +
      rows.map(function (row) {
        var variants = Array.isArray(row.variants) ? row.variants : [];
        var total = variants.reduce(function (sum, line) { return sum + Math.max(0, Number(line && (line.quantity || line.qty) || 0)); }, 0);
        var names = variants.map(function (line) {
          return escapeHtml([line.productCode || line.catalogProductCode || '-', line.productName || '', line.color || '未填顏色', line.size || 'NO SIZE', Math.max(1, Number(line.quantity || line.qty || 1)) + ' 件'].filter(Boolean).join('／'));
        }).join('<br>');
        return '<article><div><b>' + names + '</b><small>' + escapeHtml(row.note || '同物流單號新增不同產品') + '</small><small>建立人：' + escapeHtml(row.createdBy || '-') + '／' + escapeHtml(String(row.createdAt || '').replace('T', ' ').slice(0, 16)) + '</small></div><strong>待帶入 ' + total + ' 件</strong><div><button type="button" class="primary-button" data-freight-supplemental-approve="' + escapeHtml(parent.id || '') + '" data-freight-supplemental-pending="' + escapeHtml(row.id || '') + '">批准帶入驗收</button><button type="button" class="ghost-button" data-freight-supplemental-reject="' + escapeHtml(parent.id || '') + '" data-freight-supplemental-pending="' + escapeHtml(row.id || '') + '">退回</button></div></article>';
      }).join('') +
    '</section>';
  }

  function saveFreightSupplementalPending(parent, variants, note) {
    var now = new Date().toISOString();
    var operator = currentLogin();
    var rows = freightSupplementalPendingRows(parent);
    rows.push({
      id: 'PEND-SPLIT-' + Date.now() + '-' + Math.random().toString(36).slice(2, 7).toUpperCase(),
      status: 'pending',
      variants: variants,
      note: note || '同物流單號新增不同產品待批准',
      createdAt: now,
      createdBy: operator.name || operator.account || '管理者'
    });
    return saveFreightItemRecord(Object.assign({}, parent, {
      pendingSupplementalReceipts: rows,
      updatedAt: now
    }), 'freight-supplemental-pending-' + freightStableToken((parent.id || '') + '|' + now));
  }

  function freightQuantityConfirmationDraftSnapshot() {
    var modal = document.querySelector('[data-freight-quantity-confirm]');
    if (!modal) return null;
    var rows = {};
    Array.from(modal.querySelectorAll('[data-freight-quantity-item]')).forEach(function (group) {
      var itemId = String(group.getAttribute('data-freight-quantity-item') || '');
      if (!itemId) return;
      var reason = group.querySelector('[data-freight-quantity-reason]');
      rows[itemId] = {
        quantities: Array.from(group.querySelectorAll('[data-freight-quantity-actual]')).map(function (input) {
          return String(input.value == null ? '' : input.value);
        }),
        reason: String(reason && reason.value || '')
      };
    });
    return rows;
  }

  function restoreFreightQuantityConfirmationDraft(rows) {
    if (!rows) return;
    var modal = document.querySelector('[data-freight-quantity-confirm]');
    if (!modal) return;
    Object.keys(rows).forEach(function (itemId) {
      var group = Array.from(modal.querySelectorAll('[data-freight-quantity-item]')).find(function (candidate) {
        return String(candidate.getAttribute('data-freight-quantity-item') || '') === itemId;
      });
      if (!group) return;
      var saved = rows[itemId] || {};
      Array.from(group.querySelectorAll('[data-freight-quantity-actual]')).forEach(function (input, index) {
        if (saved.quantities && saved.quantities[index] !== undefined) input.value = saved.quantities[index];
      });
      var reason = group.querySelector('[data-freight-quantity-reason]');
      if (reason && saved.reason !== undefined) reason.value = saved.reason;
    });
    modal.dispatchEvent(new Event('input', { bubbles: true }));
  }

  function reopenFreightQuantityAfterPending(parent, draftRows) {
    var modal = document.querySelector('[data-freight-quantity-confirm]');
    if (modal) modal.remove();
    if (parent && parent.batchId && parent.trackingNo) {
      openFreightQuantityConfirmation(parent.batchId, parent.trackingNo);
      restoreFreightQuantityConfirmationDraft(draftRows);
      return;
    }
    if (parent && parent.id) {
      openFreightSupplementalReceipt(parent.id, parent.trackingNo || parent.supplementalTrackingNo || '', 0);
    }
  }

  function approveFreightSupplementalPending(parentId, pendingId, control) {
    var parent = freightItemById(parentId);
    var pending = freightSupplementalPendingRows(parent).find(function (row) { return String(row.id || '') === String(pendingId || ''); });
    if (!parent || !pending) { toast('找不到待批准的追加品項'); return; }
    var variants = (Array.isArray(pending.variants) ? pending.variants : []).filter(function (line) {
      return Math.max(0, Number(line && (line.quantity || line.qty) || 0)) > 0;
    });
    if (!variants.length) { toast('這筆待批准品項沒有數量'); return; }
    if (!window.confirm('批准後會把這筆不同產品追加到同一張驗收清單。\n\n原預報品項與你已填的實收數量會完整保留；新增 SKU 會列為下一項，再由你一起核對。確認批准？')) return;
    var quantityDraft = freightQuantityConfirmationDraftSnapshot();
    var child = freightSupplementalChildFromVariants(parent, variants, freightSupplementalReceiptSequence(parent), pending.note || '同物流單號新增不同產品待驗收');
    child.pendingSupplementalReceiptId = pending.id || '';
    if (control) { control.disabled = true; control.textContent = '正在批准…'; }
    saveFreightItemRecord(child, 'freight-supplemental-approve-' + child.supplementalReceiptId).then(function (savedChild) {
      var latest = freightItemById(parentId) || parent;
      var remaining = freightSupplementalPendingRows(latest).filter(function (row) { return String(row.id || '') !== String(pendingId || ''); });
      return saveFreightItemRecord(Object.assign({}, latest, {
        pendingSupplementalReceipts: remaining,
        updatedAt: new Date().toISOString()
      }), 'freight-supplemental-pending-clear-' + freightStableToken(parentId + '|' + pendingId)).then(function () {
        toast('已保留原預報品項，並把新增 SKU 追加到同一張驗收清單');
        if (latest.batchId && latest.trackingNo) {
          reopenFreightQuantityAfterPending(latest, quantityDraft);
        } else {
          var supplementalModal = document.querySelector('[data-freight-supplemental-modal]');
          if (supplementalModal) supplementalModal.remove();
          openFreightReceivingWorkbench(savedChild.id, { prefillExpected: true, fromArrival: true, supplemental: true });
        }
      });
    }).catch(function (error) {
      if (control) { control.disabled = false; control.textContent = '批准帶入驗收'; }
      toast('批准失敗：' + (error.message || error || '未知錯誤'));
    });
  }

  function rejectFreightSupplementalPending(parentId, pendingId, control) {
    var parent = freightItemById(parentId);
    if (!parent) { toast('找不到原物流單'); return; }
    if (!window.confirm('退回這筆待批准追加品項？不會刪正式產品資料，只是不帶入這張驗收。')) return;
    var remaining = freightSupplementalPendingRows(parent).filter(function (row) { return String(row.id || '') !== String(pendingId || ''); });
    if (control) { control.disabled = true; control.textContent = '退回中…'; }
    saveFreightItemRecord(Object.assign({}, parent, {
      pendingSupplementalReceipts: remaining,
      updatedAt: new Date().toISOString()
    }), 'freight-supplemental-pending-reject-' + freightStableToken(parentId + '|' + pendingId)).then(function (savedParent) {
      toast('已退回這筆追加品項');
      reopenFreightQuantityAfterPending(savedParent);
    }).catch(function (error) {
      if (control) { control.disabled = false; control.textContent = '退回'; }
      toast('退回失敗：' + (error.message || error || '未知錯誤'));
    });
  }

  function applyFreightPackageProductVariants(parent, variants, note) {
    parent = parent && typeof parent === 'object' ? parent : {};
    variants = Array.isArray(variants) ? variants.filter(function (line) {
      return Math.max(0, Number(line && (line.quantity || line.qty) || 0)) > 0;
    }) : [];
    if (!parent.id || !variants.length) return Promise.reject(new Error('沒有可寫入的實際商品'));
    var first = variants[0] || {};
    var total = variants.reduce(function (sum, line) {
      return sum + Math.max(0, Number(line && (line.quantity || line.qty) || 0));
    }, 0);
    var vendor = freightVendorLabel(parent);
    var inspection = parent.receivingInspection && typeof parent.receivingInspection === 'object'
      ? Object.assign({}, parent.receivingInspection)
      : {};
    inspection.status = 'draft';
    inspection.lines = [];
    inspection.finalizedAt = '';
    inspection.updatedAt = new Date().toISOString();
    return saveFreightItemRecord(Object.assign({}, parent, {
      variants: variants,
      quantity: total || parent.quantity || 1,
      qty: total || parent.qty || 1,
      productId: first.productId || '',
      skuId: first.skuId || '',
      productCode: first.productCode || first.catalogProductCode || '',
      catalogProductCode: first.catalogProductCode || first.productCode || '',
      productName: first.productName || parent.productName || '',
      category: first.category || parent.category || '',
      color: first.color || '',
      size: first.size || 'NO SIZE',
      sampleBarcode: first.sampleBarcode || first.barcode || '',
      taiwanBarcode: first.taiwanBarcode || first.barcode || '',
      classificationStatus: 'confirmed',
      requiresProductReview: false,
      progress: parent.progress === '到貨待分類' ? '台灣收到待點貨' : parent.progress,
      issueType: parent.issueType === '待分類' ? '' : (parent.issueType || ''),
      receivingInspection: inspection,
      receivingStage: 'inspection_open',
      vendorSourceName: parent.vendorSourceName || vendor,
      note: [parent.note, note || ('原豪鴻只記廠商「' + vendor + '」，已改選實際商品')].filter(Boolean).join('；'),
      updatedAt: new Date().toISOString()
    }), 'freight-classify-package-' + freightStableToken(parent.id || ''));
  }

  function createFreightSupplementalProductFromModal(parentId, control) {
    var parent = freightItemById(parentId);
    var modal = (control && control.closest && (control.closest('[data-freight-supplemental-modal]') || control.closest('[data-freight-quantity-confirm]')))
      || document.querySelector('[data-freight-supplemental-modal]')
      || document.querySelector('[data-freight-quantity-confirm]');
    var panel = modal && modal.querySelector('[data-freight-supplemental-new-product]');
    if (!parent || !panel) { toast('找不到同單號新品建檔區'); return; }
    var code = normalizeScanCode(panel.querySelector('[data-freight-supplemental-new-code]')?.value || '');
    var title = String(panel.querySelector('[data-freight-supplemental-new-title]')?.value || '').trim();
    var warehouse = String(panel.querySelector('[data-freight-supplemental-new-warehouse]')?.value || '').trim();
    var category = String(panel.querySelector('[data-freight-supplemental-new-category]')?.value || '').trim();
    var colorName = String(panel.querySelector('[data-freight-supplemental-new-color]')?.value || '').trim() || '未填顏色';
    var sizeName = canonicalNoSize(panel.querySelector('[data-freight-supplemental-new-size]')?.value || 'NO SIZE');
    var qty = Math.max(1, Math.floor(Number(panel.querySelector('[data-freight-supplemental-new-qty]')?.value || 1)));
    var price = Math.max(0, Math.round(Number(panel.querySelector('[data-freight-supplemental-new-price]')?.value || 0)));
    var cost = Math.max(0, Math.round(Number(panel.querySelector('[data-freight-supplemental-new-cost]')?.value || 0)));
    var status = panel.querySelector('[data-freight-supplemental-new-status]');
    var existingSkuIds = String(panel.querySelector('[data-freight-supplemental-existing-sku]')?.value || '').split(',').map(function (id) { return id.trim(); }).filter(Boolean);
    var selectedExistingRows = existingSkuIds.map(function (skuId) {
      var sku = state.skus.find(function (item) { return String(item && (item.id || item.sku) || '') === skuId; }) || null;
      var product = sku ? state.products.find(function (item) { return String(item && item.id || '') === String(sku.productId || ''); }) || null : null;
      return sku && product ? { sku: sku, product: product, skuId: skuId } : null;
    }).filter(Boolean);
    if (!category && !selectedExistingRows.length) { toast('請先填產品類別'); return; }
    if (!warehouse && !selectedExistingRows.length) { toast('請先選倉別'); return; }
    if (selectedExistingRows.length) {
      var nowExisting = new Date().toISOString();
      var payloads = [];
      var variants = [];
      selectedExistingRows.forEach(function (row) {
        var rowQtyInput = Array.prototype.find.call(panel.querySelectorAll('[data-freight-supplemental-selected-qty]'), function (input) {
          return String(input.getAttribute('data-freight-supplemental-selected-qty') || '') === String(row.skuId || '');
        });
        var rowQty = Math.max(1, Math.floor(Number(rowQtyInput && rowQtyInput.value || qty || 1)));
        row.product.updatedAt = row.product.updatedAt || nowExisting;
        var barcode = freightSkuBarcode(row.sku) || row.skuId;
        var selectedFixedCost = fixedBarcodeCostInfo(row.product, row.sku, row.sku.currentCostTwd || row.sku.cost || row.product.currentCostTwd || row.product.cost || 0, {
          sampleBarcode: barcode,
          taiwanBarcode: barcode
        });
        variants.push({
          productId: row.product.id || '',
          skuId: row.sku.id || row.sku.sku || row.skuId,
          productCode: row.product.code || row.product.productLine || '',
          catalogProductCode: row.product.code || row.product.productLine || '',
          productName: row.product.title || row.product.name || '',
          category: row.product.category || row.product.categoryName || '',
          color: row.sku.colorName || row.sku.color || '',
          size: canonicalNoSize(row.sku.sizeName || row.sku.size || 'NO SIZE'),
          quantity: rowQty,
          qty: rowQty,
          sampleBarcode: barcode,
          taiwanBarcode: barcode,
          barcode: barcode,
          barcodeCostTwd: Math.max(0, Number(selectedFixedCost.cost || 0)),
          barcodeCostSource: selectedFixedCost.source || '首次建檔成本（固定）',
          latestCostTwd: Math.max(0, Number(row.sku.currentCostTwd || row.sku.cost || row.product.currentCostTwd || row.product.cost || 0)),
          costRmb: 0,
          image: row.sku.colorImage || row.product.mainImage || ''
        });
        payloads.push(inventorySkuPrintPayload(row.product, row.sku));
      });
      var sequenceExisting = freightSupplementalReceiptSequence(parent);
      if (control) { control.disabled = true; control.textContent = freightItemNeedsProductClassification(parent) ? '正在寫入實際商品…' : '正在加入待批准…'; }
      if (status) status.textContent = freightItemNeedsProductClassification(parent) ? '正在把選定商品寫入這包…' : '正在建立待批准清單…';
      var saveSelected = freightItemNeedsProductClassification(parent)
        ? applyFreightPackageProductVariants(parent, variants, '原豪鴻只記廠商「' + freightVendorLabel(parent) + '」，已改選實際 SKU')
        : saveFreightSupplementalPending(parent, variants, '同物流單號新增既有 SKU 待批准／追加拆包 ' + sequenceExisting);
      saveSelected.then(function (savedParent) {
        if (modal && modal.hasAttribute('data-freight-supplemental-modal')) modal.remove();
        if (status) status.textContent = freightItemNeedsProductClassification(parent) ? '已寫入實際商品' : '已加入待批准清單';
        toast(freightItemNeedsProductClassification(parent)
          ? '已把 ' + selectedExistingRows.length + ' 個實際商品寫入這包，請填本次實收數量'
          : '已加入 ' + selectedExistingRows.length + ' 個 SKU 到待批准清單，請在原物流單確認後批准');
        reopenFreightQuantityAfterPending(savedParent);
      }).catch(function (error) {
