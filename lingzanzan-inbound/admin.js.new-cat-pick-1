        ? '沒有可安全同步的品名；有 ' + plan.conflicts.length + ' 個物流單號存在多個公司品名，請先統一。'
        : (plan.remoteCount ? '豪鴻品名已和公司資料一致，沒有需要修改。' : '豪鴻還沒有對得上的包裹快取。請先按「同步我的包裹與重量」。');
      if (!options.auto) {
        if (status) status.textContent = noUpdateText;
        toast(noUpdateText);
      }
      return Promise.resolve({ ok: true, updatedCount: 0, skipped: [], message: noUpdateText });
    }
    if (!options.auto) {
      var confirmText = '確定將 ' + plan.updates.length + ' 個物流單號的「產品名稱」更新到豪鴻嗎？\n\n拼多多、寶輝、豪鴻都可以更新。備註、數量、價格與分類都不會修改。';
      if (!window.confirm(confirmText)) return Promise.resolve({ ok: false, cancelled: true, updatedCount: 0, message: '已取消品名同步' });
    }
    request.updates = plan.updates;
    if (button && !options.auto) { button.disabled = true; button.textContent = '正在同步公司品名…'; }
    if (status && !options.auto) status.textContent = '正在依物流單號把後台品名更新到豪鴻；備註不會修改…';
    return fetch('./haohong-sync-api.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      cache: 'no-store',
      body: JSON.stringify(request)
    }).then(function (response) {
      return response.json().then(function (payload) {
        if (!response.ok || !payload.ok) throw new Error(payload.error || '豪鴻品名同步失敗');
        return payload;
      });
    }).then(function (payload) {
      applyHaoHongStoredLogin({ stored: payload.credentialsStored, username: request.username || haohongStoredLogin.username }, { skipStatus: true });
      var updatedByTracking = new Map((payload.updated || []).map(function (row) { return [haohongTrackingKey(row.trackingNo), row.productName]; }));
      state.freightTracking.haohongPackageWeights = (state.freightTracking.haohongPackageWeights || []).map(function (row) {
        var syncedName = updatedByTracking.get(haohongTrackingKey(row.trackingNo));
        return syncedName ? Object.assign({}, row, { productName: syncedName, syncedAt: new Date().toISOString() }) : row;
      });
      haohongSyncPackages = (haohongSyncPackages || []).map(function (row) {
        var syncedName = updatedByTracking.get(haohongTrackingKey(row.trackingNo));
        return syncedName ? Object.assign({}, row, { productName: syncedName }) : row;
      });
      return saveFreightTracking().then(function () {
        var skipped = Array.isArray(payload.skipped) ? payload.skipped.length : 0;
        var message = '豪鴻產品名稱已更新 ' + Number(payload.updatedCount || 0) + ' 筆' + (skipped ? '；' + skipped + ' 筆豪鴻找不到相同單號或無法修改' : '') + '。';
        if (!options.auto) {
          if (status) status.textContent = message;
          toast(message);
        }
        renderHaoHongSyncPreview();
        return { ok: true, updatedCount: Number(payload.updatedCount || 0), skipped: payload.skipped || [], message: message };
      });
    }).catch(function (error) {
      var message = error.message || '豪鴻品名同步失敗；若要求驗證碼，請先在豪鴻網頁完成驗證。';
      if (!options.auto) {
        if (status) status.textContent = message;
        toast(message);
      }
      return { ok: false, updatedCount: 0, message: message };
    }).finally(function () {
      if (!options.auto && passwordInput) passwordInput.value = '';
      if (button && !options.auto) { button.disabled = false; button.textContent = '將公司品名同步到豪鴻'; }
    });
  }

  function collectHaoHongMissingPackages(focusItem) {
    var remoteByTracking = haohongRemotePackageMap();
    var source = focusItem ? [focusItem] : (normalizeFreightTracking(state.freightTracking).items || []);
    var grouped = new Map();
    source.forEach(function (item) {
      if (!haohongItemCanPushFromAdmin(item)) return;
      var numbers = haohongItemTrackingNumbers(item);
      numbers.forEach(function (value) {
        var trackingNo = String(value || '').trim();
        var key = haohongTrackingKey(trackingNo);
        if (!key || remoteByTracking.has(key) || grouped.has(key)) return;
        grouped.set(key, {
          trackingNo: trackingNo,
          productName: haohongItemNameForSync(item) || '後台預報包裹',
          quantity: Math.max(1, Number(item.quantity || 1)),
          note: String(item.note || item.purchaseContentRaw || '').replace(/\s+/g, ' ').trim().slice(0, 180)
        });
      });
    });
    return Array.from(grouped.values());
  }

  function markHaoHongForecastStatus(trackingNos, status, reason) {
    var keys = new Set((trackingNos || []).map(haohongTrackingKey).filter(Boolean));
    if (!keys.size) return;
    var now = new Date().toISOString();
    state.freightTracking.items = (normalizeFreightTracking(state.freightTracking).items || []).map(function (item) {
      var itemKeys = [item.trackingNo, item.haohongTrackingNo].concat((item.splitPackages || []).map(function (parcel) {
        return parcel && parcel.trackingNo;
      })).map(haohongTrackingKey);
      if (!itemKeys.some(function (key) { return keys.has(key); })) return item;
      return Object.assign({}, item, {
        haohongForecastStatus: status,
        haohongForecastReason: reason || '',
        haohongForecastAt: now,
        updatedAt: now
      });
    });
  }

  function registerMissingHaoHongPackages(options) {
    options = options || {};
    var request = haohongSyncRequestBody({ action: 'register_packages' });
    var passwordInput = document.querySelector('[data-haohong-sync-password]');
    var button = document.querySelector('[data-haohong-register-missing]');
    var status = document.querySelector('[data-haohong-sync-status]');
    if (!request.username && !haohongStoredLogin.stored) {
