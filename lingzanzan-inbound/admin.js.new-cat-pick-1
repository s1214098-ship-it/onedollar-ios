      ? { type: shipping.addressPrimary, fee: shipping.addressPrimary === 'store' ? storeFee : 100, cost: shipping.addressPrimary === 'store' ? 45 : 100 }
      : adminShipmentShippingInfoFromAddress(addressText);
    if (info && info.type === 'store') info.fee = storeFee;
