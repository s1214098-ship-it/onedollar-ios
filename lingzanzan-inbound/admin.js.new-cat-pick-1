    var inquiryId = String(row && (row.sourceInquiryId || row.convertedFromInquiryId || row.inquiryId || row.id) || '');
    if (inquiryId && freightFifoProductScope.linkedInquiryIds.has(inquiryId)) return true;
    if (freightFifoProductScope.strictInquiryIds) return false;
    return (Array.isArray(row && row.items) ? row.items : []).some(function (item) {
      var identities = [
        item && item.code,
        item && item.productCode,
