  function confirmAdminBlacklist(payload) {
    if (!payload || (payload.action !== 'create' && payload.action !== 'convert')) return Promise.resolve(payload);
    var name = '';
    var phone = '';
    if (payload.customer) {
      name = String(payload.customer.name || '');
      phone = String(payload.customer.phone || '');
    } else {
      var customer = inquiryCustomerForBlacklist(payload.inquiryId);
      name = customer.name;
      phone = customer.phone;
    }
    var api = window.LingzanzanMemberRisk;
    var stage = payload.action === 'convert' ? '轉正式出貨' : '下單';
    if (!api || typeof api.confirmProceed !== 'function') return Promise.resolve(payload);
