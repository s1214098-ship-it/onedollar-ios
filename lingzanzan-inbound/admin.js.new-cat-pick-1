  function readableImageUrl(value) {
    // 清單可用縮圖，但放大檢視必須回到保存的原始檔，避免把 420/960px 衍生圖再次放大。
    return String(value || '').trim().replace(/(\/data\/image-assets)\/(?:thumb|medium|large|dm)\//i, '$1/');
  }

  function canvasToReadableDataUrl(canvas, sourceType) {
    try {
      var webp = canvas.toDataURL('image/webp', 0.96);
      if (webp.indexOf('data:image/webp') === 0) return webp;
    } catch (error) {}
    var quality = /^image\/png$/i.test(sourceType || '') ? 0.97 : 0.95;
    return canvas.toDataURL('image/jpeg', quality);
  }

  function fileToDataUrl(file) {
    return new Promise(function (resolve, reject) {
      if (!file) {
        resolve('');
        return;
      }
      var reader = new FileReader();
      reader.onload = function () {
        var dataUrl = reader.result || '';
        if (!String(file.type || '').match(/^image\//)) {
          resolve(dataUrl);
          return;
        }
        var img = new Image();
        img.onload = function () {
          // 聊天截圖通常又高又窄；長邊 1600 會讓寬度只剩約 700px，收據與地址文字無法辨識。
          // 3200px 可保留手機截圖細節，同時仍由伺服器產生小尺寸清單縮圖。
          var max = 3200;
          var scale = Math.min(1, max / Math.max(img.width || max, img.height || max));
          var canvas = document.createElement('canvas');
          canvas.width = Math.max(1, Math.round((img.width || max) * scale));
          canvas.height = Math.max(1, Math.round((img.height || max) * scale));
          var ctx = canvas.getContext('2d');
          ctx.imageSmoothingEnabled = true;
          ctx.imageSmoothingQuality = 'high';
          ctx.drawImage(img, 0, 0, canvas.width, canvas.height);
          resolve(canvasToReadableDataUrl(canvas, file.type));
        };
        img.onerror = function () { resolve(dataUrl); };
        img.src = dataUrl;
      };
      reader.onerror = reject;
      reader.readAsDataURL(file);
    });
  }

  function filesToDataUrls(files) {
    return Promise.all(Array.from(files || []).map(fileToDataUrl)).then(function (items) {
