  // LZ_INTERNAL_USE_DEDUCT_20260924: 自用不是樣品；入庫後扣庫存。
  function freightStockPurposeForItem(item, destinationCode, rawValue) {
    if (freightIsInternalUseItem(item)) return 'internal_use';
