  function freightSupplementalReceivedByLine(parentItem) {
    var parentId = String(parentItem && parentItem.id || '');
    var totals = [];
    normalizeFreightTracking(state.freightTracking).items.forEach(function (item) {
      if (String(item && item.parentFreightItemId || '') !== parentId || item.isSupplementalSplitReceipt !== true) return;
      if (!freightItemClosesBatchQueueWithoutSelectionCheck(item)) return;
      var inspection = item.receivingInspection && typeof item.receivingInspection === 'object' ? item.receivingInspection : {};
      var receivedLines = Array.isArray(inspection.lines) ? inspection.lines : [];
      freightVariantLines(item).forEach(function (line, index) {
        var sourceIndex = Math.max(0, Math.floor(Number(line.sourceVariantIndex !== undefined ? line.sourceVariantIndex : index) || 0));
        var qty = receivedLines[index] && receivedLines[index].actualQty !== undefined
          ? Number(receivedLines[index].actualQty || 0)
          : Number(line.quantity || line.qty || 0);
        totals[sourceIndex] = Math.max(0, Number(totals[sourceIndex] || 0)) + Math.max(0, qty);
      });
    });
    return totals;
  }

  function freightOutstandingArrivalByLine(parentItem) {
    var inspection = parentItem && parentItem.receivingInspection && typeof parentItem.receivingInspection === 'object'
      ? parentItem.receivingInspection
      : {};
    var firstReceived = Array.isArray(inspection.lines) ? inspection.lines : [];
    var supplemental = freightSupplementalReceivedByLine(parentItem);
    var legacyReceivedRemainder = firstReceived.length
      ? 0
      : Math.max(0, Math.floor(Number(parentItem && parentItem.receivingActualQty || 0)));
    return freightVariantLines(parentItem).map(function (line, index) {
      var expected = Math.max(1, Math.floor(Number(line.quantity || line.qty || 1)));
      if (firstReceived[index] && firstReceived[index].voided) return 0;
      var received = firstReceived.length
        ? Math.max(0, Math.floor(Number(firstReceived[index] && firstReceived[index].actualQty || 0)))
        : Math.min(expected, legacyReceivedRemainder);
      if (!firstReceived.length) legacyReceivedRemainder = Math.max(0, legacyReceivedRemainder - received);
      var later = Math.max(0, Math.floor(Number(supplemental[index] || 0)));
      return Math.max(0, expected - received - later);
    });
  }


