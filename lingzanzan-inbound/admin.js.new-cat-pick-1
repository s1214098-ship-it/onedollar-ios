      '<div class="preorder-progress-steps">',
      stages.map(function (label, index) { return '<span class="' + (index < info.stage ? 'is-complete' : (index === info.stage ? 'is-current' : '')) + '"><i>' + (index < info.stage ? '✓' : (index + 1)) + '</i><b>' + label + '</b></span>'; }).join(''),
