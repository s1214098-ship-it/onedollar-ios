      return String(row.dataset.liveSkuId || '') === skuKey;
    });
    if (liveUsesCnTwHold() && (adminOrderWarehouseCode(liveSkuWarehouse(product, sku)) === 'CN' || String(document.querySelector('[data-live-ship-mode]')?.value || '') === 'china_to_taiwan')) {
      var existingQty = existing ? Math.max(0, Number((existing.querySelector('[data-live-qty]') || {}).value || 0)) : 0;
      var need = existingQty + Math.max(1, Number(qty || 1));
      if (cnTwFreeQty(sku) < need) {
        toast(cnTwHolderMessage(sku, need), 'error');
        return null;
      }
    }
    if (existing) {
      var existingQty = existing.querySelector('[data-live-qty]') || existing.querySelector('input[type="number"]:not([data-live-price])');
      if (existingQty) existingQty.value = Math.max(1, Number(existingQty.value || 0) + Math.max(1, Number(qty || 1)));
      if (priceOverride !== undefined && priceOverride !== null && priceOverride !== '') {
        var existingPrice = existing.querySelector('[data-live-price]');
        if (existingPrice) existingPrice.value = priceOverride;
      }
      existing.classList.remove('live-scan-pulse');
      void existing.offsetWidth;
      existing.classList.add('live-scan-pulse');
      updateLiveScanSummary();
      return { row: existing, incremented: true };
    }
    var scanner = liveScannerRow();
    var holder = document.createElement('div');
    holder.innerHTML = liveLineTemplate();
    var row = holder.firstElementChild;
    var rowWarehouseSelect = row.querySelector('[data-live-warehouse]');
    if (rowWarehouseSelect && adminOrderWarehouseLock) rowWarehouseSelect.value = adminOrderWarehouseLock;
    row.dataset.liveCommitted = '1';
    row.classList.add('is-committed', 'live-scan-pulse');
