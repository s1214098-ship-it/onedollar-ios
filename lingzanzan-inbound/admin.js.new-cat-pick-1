  function freightPrintLinkMatchesLine(link, line, lineIndex) {
    link = link || {};
    line = line || {};
    if (Number.isFinite(Number(link.receivedSourceLineIndex))
      && Number(link.receivedSourceLineIndex) === Number(line.sourceLineIndex === undefined ? lineIndex : line.sourceLineIndex)) return true;
    var linkBarcode = normalizeScanCode(link.barcode || '');
    var lineBarcode = normalizeScanCode(line.barcode || line.companyBarcode || '');
    if (linkBarcode && lineBarcode) return linkBarcode === lineBarcode;
    var linkCode = normalizeLiveCode(link.productCode || '');
    var lineCode = normalizeLiveCode(line.productCode || '');
    if (linkCode && lineCode && linkCode !== lineCode) return false;
    return freightDemandIdentity(link.color || '') === freightDemandIdentity(line.color || '')
      && freightDemandIdentity(labelSizeText(link.size || 'NO SIZE')) === freightDemandIdentity(labelSizeText(line.size || 'NO SIZE'));
  }

  function freightReceivedBarcodePayloads(data, receipt) {
    var inventory = data && data.inventory || {};
    var ownership = data && data.ownership || {};
    var linkedOrders = Array.isArray(ownership.linkedOrders) ? ownership.linkedOrders : [];
    var dispatchChoices = Array.isArray(ownership.customerDispatchChoices) ? ownership.customerDispatchChoices : [];
    var dispatchLabels = { wait_all: '等其他款到齊一起出貨', ship_now: '本商品先出（分批寄）', ask_sales: '先詢問業務，暫不出貨' };
    var receiptLines = Array.isArray(receipt && receipt.lines) ? receipt.lines.filter(function (line) {
      return Math.max(0, Math.floor(Number(line && (line.qty || line.actualQty || line.receivedQty) || 0))) > 0;
    }) : [];
    var lines = receiptLines.length ? receiptLines : (Array.isArray(inventory.lines) && inventory.lines.length ? inventory.lines : []);
    var receiptActualTotal = freightReceivedActualTotal(data, receipt);
    return lines.reduce(function (allPayloads, line, lineIndex) {
      var productCode = line.productCode || receipt && receipt.product && receipt.product.code || receipt && receipt.filed && receipt.filed.code || '';
      var productId = line.productId || receipt && receipt.product && receipt.product.id || receipt && receipt.filed && receipt.filed.id || '';
      var product = (state.products || []).find(function (row) {
        return (productId && String(row.id || '') === String(productId))
          || (productCode && normalizeLiveCode(row.code || row.barcode || '') === normalizeLiveCode(productCode));
      }) || {};
      var skuId = String(line.skuId || '').trim();
      // LZ_RECV_CHIP_PM_20260927 / LZ_RECV_COLOR_FIRST_20260927: 帶入顏色只找這款產品的 SKU，不准拿目錄第一筆咖啡／L。
      var resolvedProductId = String((product && product.id) || productId || '').trim();
      if (!resolvedProductId && productCode) {
        product = (state.products || []).find(function (row) {
          return productPrefix(row.code || row.barcode || '') === productPrefix(productCode)
            || normalizeLiveCode(row.code || '') === normalizeLiveCode(productCode);
        }) || product;
        resolvedProductId = String((product && product.id) || '').trim();
      }
      var productSkus = (state.skus || []).filter(function (row) {
        return resolvedProductId && String(row.productId || '') === resolvedProductId;
      });
      var sku = freightExactVariantSku(productSkus, line, line.barcode) || {};
      var officialV2 = freightLatestOfficialLabelBarcode(product, sku, line);
      var storedBarcode = String(sku.officialBarcode || sku.companyBarcode || sku.barcode || sku.legacyBarcode || sku.mappingCode || line.barcode || '').trim();
      var formalBarcode = officialV2 || (line.lockFormalBarcode && isLatestLabelBarcode(line.barcode) ? String(line.barcode || '').trim() : storedBarcode);
      var mergedProduct = Object.assign({}, product, {
        id: product.id || productId || ('p-' + normalizeLiveCode(productCode).toLowerCase()),
        code: product.code || productCode,
        title: product.title || product.name || line.productName || productCode
      });
      var mergedSku = Object.assign({}, sku, {
        id: sku.id || skuId || line.barcode,
        sku: sku.sku || skuId || line.barcode,
        productId: sku.productId || mergedProduct.id,
        barcode: formalBarcode || skuId,
        companyBarcode: formalBarcode || skuId,
        color: sku.color || sku.colorName || line.color || '',
        colorName: sku.colorName || sku.color || line.color || '',
        size: sku.size || sku.sizeName || line.size || 'NO SIZE',
        sizeName: sku.sizeName || sku.size || line.size || 'NO SIZE',
        currentCostTwd: Number(line.unitCostTwd || sku.currentCostTwd || sku.cost || 0),
        currentCostUpdatedAt: data && data.receivedAt || new Date().toISOString(),
        costSource: 'freight-receiving'
      });
      var payload = inventorySkuPrintPayload(mergedProduct, mergedSku);
      payload.warehouseCode = freightReceivedCurrentWarehouseCode(inventory);
      payload.warehouse = payload.warehouseCode === 'CN' ? '中國東莞倉' : (payload.warehouseCode === 'ID' ? '印尼倉' : '台灣寶輝倉');
      payload.warehouseName = payload.warehouse;
      // 進貨列印：貨艙 {編號}{色碼}{尺碼}P{成本}. 舊款 C/S 留掃描別名。
      if (formalBarcode) {
        payload.barcode = formalBarcode;
        payload.barcodeSource = isLatestLabelBarcode(formalBarcode) ? '新款正式標籤' : '正式入庫條碼';
        payload.lockFormalBarcode = false;
      } else if (!payload.barcode) {
        payload.barcode = skuId || productCode;
      }
      if (!payload.barcode) return allPayloads;
      var lineQty = Math.max(1, Number(line.receivedQty || line.actualQty || line.qty || line.quantity || 1));
      if (lines.length === 1) {
        lineQty = Math.max(lineQty, receiptActualTotal);
      }
      var matchingLinks = linkedOrders.filter(function (link) {
        return freightPrintLinkMatchesLine(link, line, lineIndex);
      });
      var allocatedQty = 0;
      matchingLinks.forEach(function (link) {
        var remainingQty = Math.max(0, lineQty - allocatedQty);
        if (!remainingQty) return;
        var linkQty = Math.min(remainingQty, Math.max(1, Number(link.qty || 1)));
        var customer = freightPrintCustomerDetails(link);
        for (var customerCopy = 0; customerCopy < linkQty; customerCopy += 1) {
          allPayloads.push(Object.assign({}, payload, customer, {
            customerUnitIndex: customerCopy + 1,
            preorderCustomer: true
          }));
        }
        allocatedQty += linkQty;
      });
      var companyQty = Math.max(0, lineQty - allocatedQty);
      for (var companyCopy = 0; companyCopy < companyQty; companyCopy += 1) {
        allPayloads.push(Object.assign({}, payload, {
          companyUnitIndex: companyCopy + 1,
          preorderCustomer: false
        }));
      }
      return allPayloads;
    }, []);
  }

  function freightReceivedActualTotal(data, receipt, payloads) {
    var inventory = data && data.inventory || {};
    var receiptLineTotal = Array.isArray(receipt && receipt.lines)
      ? receipt.lines.reduce(function (sum, line) { return sum + Math.max(0, Math.floor(Number(line && (line.qty || line.actualQty || line.receivedQty) || 0))); }, 0)
      : 0;
    var inventoryLineTotal = Array.isArray(inventory.lines)
      ? inventory.lines.reduce(function (sum, line) { return sum + Math.max(0, Math.floor(Number(line && (line.qty || line.actualQty || line.receivedQty || line.quantity) || 0))); }, 0)
      : 0;
    var candidates = [
      receipt && receipt.actualQty,
      receiptLineTotal,
      inventory.actualQty,
      inventory.receivedQty,
      inventoryLineTotal,
      Array.isArray(payloads) ? payloads.length : 0
    ];
    for (var index = 0; index < candidates.length; index += 1) {
      var quantity = Math.max(0, Math.floor(Number(candidates[index]) || 0));
      if (quantity > 0) return quantity;
    }
    return 0;
  }


  var freightReceivedOtherStockPrintRows = [];

  function freightReceivedCurrentWarehouseCode(inventory) {
    inventory = inventory || {};
    var raw = inventory.warehouseCode || inventory.warehouse || inventory.arrivalWarehouse || '';
    var code = String(raw || '').trim().toUpperCase();
    if (code === 'TW_BAOHUI' || code === 'TAIWAN' || code === 'BAOHUI') return 'TW';
    if (code === 'CN_DONGGUAN' || code === 'CHINA' || code === 'DONGGUAN') return 'CN';
    if (code === 'ID_DIRECT' || code === 'INDONESIA' || code === 'INDO') return 'ID';
    var normalized = normalizeWarehouseCode(raw);
    if (normalized === 'CN' || normalized === 'ID' || normalized === 'TW') return normalized;
    return normalized === 'PREORDER' ? 'TW' : (normalized || 'TW');
  }

  function freightReceivedOtherWarehouseCodes(currentCode) {
    currentCode = String(currentCode || 'TW').trim().toUpperCase();
    return ['TW', 'ID', 'CN'].filter(function (code) { return code !== currentCode; });
  }

  function freightReceivedSizeRank(size) {
    var text = String(size || '').toUpperCase().replace(/\s+/g, '');
    var map = { XXS: 0, XS: 1, S: 2, M: 3, L: 4, XL: 5, XXL: 6, '2XL': 6, XXXL: 7, '3XL': 7, '4XL': 8, 'NO SIZE': 90, NOSIZE: 90 };
    if (map[text] != null) return map[text];
    var n = parseInt(text, 10);
    return Number.isFinite(n) ? 40 + n : 80;
  }

  function freightReceivedProductFromData(data, receipt) {
    var inventory = data && data.inventory || {};
    var lines = Array.isArray(receipt && receipt.lines) ? receipt.lines : (Array.isArray(inventory.lines) ? inventory.lines : []);
    var first = lines[0] || {};
    var productId = String(first.productId || (receipt && receipt.product && receipt.product.id) || (receipt && receipt.filed && receipt.filed.id) || inventory.productId || '').trim();
    var productCode = String(first.productCode || (receipt && receipt.product && receipt.product.code) || (receipt && receipt.filed && receipt.filed.code) || inventory.productCode || '').trim();
    var products = state.products || [];
    var product = products.find(function (row) {
      return productId && String(row.id || '') === productId;
    }) || products.find(function (row) {
      return productCode && normalizeLiveCode(row.code || row.barcode || row.productCode || '') === normalizeLiveCode(productCode);
    }) || null;
    if (product) return product;
    var fromSku = (state.skus || []).find(function (sku) {
      return (productId && String(sku.productId || '') === productId)
        || (productCode && normalizeLiveCode(sku.productCode || '') === normalizeLiveCode(productCode));
    });
    if (!fromSku) return null;
    return products.find(function (row) { return String(row.id || '') === String(fromSku.productId || ''); }) || {
      id: fromSku.productId,
