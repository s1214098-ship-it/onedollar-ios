  function renderLogistics() {
    var target = document.querySelector('[data-logistics-list]');
    if (!target) return;
    var now = new Date();
    var defaultEnd = latestLogisticsDate() || now;
    var defaultStart = new Date(defaultEnd.getFullYear(), defaultEnd.getMonth(), defaultEnd.getDate() - 13);
    var rawQuery = (document.querySelector('[data-logistics-search]')?.value || '').trim();
    var query = rawQuery.toLowerCase();
    var looseQuery = searchLooseNormalize(rawQuery);
    var compactQuery = searchCompactNormalize(rawQuery);
    var phoneQuery = searchPhoneDigits(rawQuery);
    var searching = !!(looseQuery || compactQuery || (phoneQuery && phoneQuery.length >= 5));
    var typeFilter = document.querySelector('[data-logistics-type]')?.value || 'all';
    var statusFilter = document.querySelector('[data-logistics-status]')?.value || 'all';
    var staffFilter = document.querySelector('[data-logistics-staff]')?.value || 'all';
    var startValue = formatInputDate(defaultStart);
    var endValue = formatInputDate(defaultEnd);
    if (document.querySelector('[data-logistics-start]') && !document.querySelector('[data-logistics-start]').value) {
      document.querySelector('[data-logistics-start]').value = startValue;
    }
    if (document.querySelector('[data-logistics-end]') && !document.querySelector('[data-logistics-end]').value) {
      document.querySelector('[data-logistics-end]').value = endValue;
    }
    var startDate = startValue ? new Date(startValue + 'T00:00:00') : null;
    var endDate = endValue ? new Date(endValue + 'T23:59:59') : null;
    var rows = state.logistics.filter(function (row) {
      var hasUsefulData = [row.name, row.phone, row.postNo, row.familyNo, row.sevenNo, row.status, row.delivered].some(function (value) {
        return String(value || '').trim() && String(value || '').trim() !== '-';
      });
      if (!hasUsefulData || logisticsOrderIsHeld(row)) return false;
      var type = logisticsType(row);
      var rowDate = logisticsDate(row);
      var delivered = isDelivered(row);
      var abnormal = isReturnOrAbnormal(row);
      var bucket = logisticsStatusBucket(row);
      var deliveredExpire = false;
      if (!searching && delivered && rowDate && !abnormal) {
        deliveredExpire = (now - rowDate) > 20 * 24 * 60 * 60 * 1000;
      }
      var hay = [row.date, row.name, row.phone, row.address, row.customerId, row.orderId, row.id, row.amount, row.returnFlag, row.status, cleanStaffName(row.staff), row.postNo, row.familyNo, row.sevenNo, row.note].join(' ');
      var text = hay.toLowerCase();
      var looseText = searchLooseNormalize(hay);
      var compactText = searchCompactNormalize(hay);
      var phoneText = searchPhoneDigits(hay);
      var staffText = cleanStaffName(row.staff);
      var matchQuery = !searching ||
        (query && text.indexOf(query) !== -1) ||
        (looseQuery && looseText.indexOf(looseQuery) !== -1) ||
        (compactQuery && compactQuery.length > 1 && compactText.indexOf(compactQuery) !== -1) ||
        (phoneQuery && phoneQuery.length >= 5 && phoneText.indexOf(phoneQuery) !== -1);
      var matchStatus = statusFilter === 'all' ||
        (statusFilter === 'problem' && (abnormal || logisticsNeedsManualQuery(row) || bucket === 'missing' || bucket === 'no_data')) ||
        (statusFilter === 'manual' && logisticsNeedsManualQuery(row)) ||
        (statusFilter === 'missing' && bucket === 'missing') ||
        (statusFilter === 'no_data' && bucket === 'no_data') ||
        (statusFilter === 'not_handed' && bucket === 'not_handed') ||
        (statusFilter === 'in_transit' && bucket === 'in_transit') ||
        (statusFilter === 'arrived_store' && bucket === 'arrived_store') ||
        (statusFilter === 'delivered' && delivered && !abnormal) ||
        (statusFilter === 'undelivered' && !delivered && !abnormal) ||
        (statusFilter === 'return' && abnormal);
      var matchDate = searching || ['problem', 'manual', 'missing', 'no_data', 'not_handed', 'return', 'in_transit', 'arrived_store', 'delivered'].indexOf(statusFilter) !== -1 || !!rowDate && ((!startDate || rowDate >= startDate) && (!endDate || rowDate <= endDate));
      return matchQuery &&
        (typeFilter === 'all' || type === typeFilter) &&
        (staffFilter === 'all' || staffText === staffFilter) &&
        matchStatus &&
        matchDate &&
        !deliveredExpire;
    });
    var delivered = rows.filter(isDelivered).length;
    var abnormalCount = rows.filter(isReturnOrAbnormal).length;
    var manualCount = rows.filter(logisticsNeedsManualQuery).length;
    var notHandedCount = rows.filter(function (row) { return logisticsStatusBucket(row) === 'not_handed'; }).length;
    var noDataCount = rows.filter(function (row) { return logisticsStatusBucket(row) === 'no_data'; }).length;
    var arrivedStoreCount = rows.filter(function (row) { return logisticsStatusBucket(row) === 'arrived_store'; }).length;
    var inTransitCount = rows.filter(function (row) { return logisticsStatusBucket(row) === 'in_transit'; }).length;
    var missingCount = rows.filter(function (row) { return logisticsStatusBucket(row) === 'missing'; }).length;
    var logisticsSidebarCounts = {schema: 2, updatedAt: new Date().toISOString(), manual: 0, missing: 0, not_handed: 0, in_transit: 0, arrived_store: 0, delivered: 0, no_data: 0, return: 0, problem: 0};
    (state.logistics || []).forEach(function (row) {
      if (logisticsOrderIsHeld(row)) return;
      if (![row.name, row.phone, row.postNo, row.familyNo, row.sevenNo, row.status, row.delivered].some(function (v) { return String(v || '').trim() && String(v || '').trim() !== '-'; })) return;
      var bucket = logisticsStatusBucket(row);
      var manual = logisticsNeedsManualQuery(row);
      if (Object.prototype.hasOwnProperty.call(logisticsSidebarCounts, bucket)) logisticsSidebarCounts[bucket] += 1;
      if (manual) logisticsSidebarCounts.manual += 1;
