    if (hint) {
      hint.textContent = computer
        ? '先選電腦主分類，再選次分類與品牌；選單沒有時可新增主分類或次分類，新增主分類只存入電腦部門。'
        : '目前是張張一般庫存：分類顯示服裝與生活用品。這批若是電腦商品，請先把「庫存歸屬」改成電腦部門暫存。';
    }
    var addInput = document.querySelector('[data-freight-category-master]');
    if (addInput) {
      addInput.disabled = false;
      addInput.placeholder = computer ? '輸入新的電腦主分類' : '選單沒有時輸入新分類';
    }
    var addButton = document.querySelector('[data-add-freight-master="category"]');
    if (addButton) {
      addButton.disabled = false;
      addButton.title = computer ? '新增到電腦部門主分類' : '';
    }
    document.body.classList.toggle('freight-filing-computer', computer);
    return current;
  }

  function freightIsInternalUseItem(item) {
