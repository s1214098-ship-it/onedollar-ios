  function mergeUniqueNameList(local, remote) {
    var seen = new Set();
    var merged = [];
    (Array.isArray(local) ? local : []).concat(Array.isArray(remote) ? remote : []).forEach(function (item) {
      var text = String(item || '').replace(/\s+/g, ' ').trim();
      var key = text.toLocaleLowerCase();
      if (!text || seen.has(key)) return;
      seen.add(key);
      merged.push(text);
    });
    return merged;
  }

  function mergeComputerCategoryRules(local, remote) {
    var seen = new Set();
    var merged = [];
    (Array.isArray(local) ? local : []).concat(Array.isArray(remote) ? remote : []).forEach(function (row) {
      if (!row || typeof row !== 'object') return;
      var type = String(row.type || '').replace(/\s+/g, ' ').trim();
      var spec = String(row.spec || '').replace(/\s+/g, ' ').trim();
      var brand = String(row.brand || '').replace(/\s+/g, ' ').trim();
      if (!type) return;
      var key = [type, spec, brand].join('\u0001').toLocaleLowerCase();
      if (seen.has(key)) return;
      seen.add(key);
      merged.push({
        type: type,
        spec: spec,
        brand: brand,
        updatedAt: row.updatedAt || new Date().toISOString()
      });
    });
    return merged;
  }

