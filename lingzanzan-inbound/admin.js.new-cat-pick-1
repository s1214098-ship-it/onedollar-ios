  function freightDemandIdentity(value) {
    return normalizeLiveCode(String(value || '').replace(/\s+/g, ''));
  }

  function freightSearchKeyword(value) {
    var keyword = String(value || '').normalize('NFKC').replace(/[\u200B-\u200D\u2060\uFEFF]/g, '').trim().toLowerCase();
    var compact = keyword.replace(/[^a-z0-9]/g, '');
    if (compact.length >= 8 && /\d/.test(compact)) keyword = compact;
    return /^\d{1,3}$/.test(keyword) ? 'olan' + keyword : keyword;
  }

  function freightShortProductCode(value) {
    var keyword = String(value || '').normalize('NFKC').replace(/[\u200B-\u200D\u2060\uFEFF\s]+/g, '').trim().toLowerCase();
    if (/^\d{1,3}$/.test(keyword)) return 'olan' + keyword;
    // A complete short product code (for example OLAN79, K399 or JA318)
    // should use exact product-family matching.  Treating it as free text made
    // a matching batch visible while leaving every unrelated row in that
    // batch on screen.
    return /^[a-z]+\d{1,6}$/.test(keyword) ? keyword : '';
  }

  function freightItemMatchesProductCode(item, productCode) {
    var wanted = freightDemandIdentity(productCode);
