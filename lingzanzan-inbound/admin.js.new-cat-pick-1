    if (!(state.inquiries || []).length || !normalizeFreightTracking(state.freightTracking).items.length) {
      return Promise.resolve({ allocated: 0, orders: 0, statusUpdated: 0, customers: [] });
    }
    return reconcilePreorderWarehouseAllocationsUntilStable(4).then(function (summary) {
      if (summary.allocated > 0 || summary.statusUpdated > 0) {
        renderOrders();
        renderFreightTracking();
      }
      if (summary.allocated > 0) {
