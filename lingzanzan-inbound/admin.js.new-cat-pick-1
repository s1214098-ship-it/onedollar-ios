      shell.removeAttribute('data-freight-fifo-opening');
      shell.innerHTML = '<section><header><div><small>FIFO SHIPPING WORKBENCH</small><h3>客戶出貨核對無法開啟</h3><p>訂單資料可能剛被更新，請重新載入後再試。原因：' + escapeHtml(message) + '</p></div><button type="button" class="ghost-button" data-freight-fifo-close>關閉</button></header><div class="freight-formal-priority-warning"><b>畫面不會再卡在載入中</b><span>重新載入會同步最新待配訂單、正式訂單與庫存資料，不會修改訂單。</span></div><footer><button type="button" class="primary-button" data-freight-fifo-reload>重新載入資料</button></footer></section>';
      var reloadButton = shell.querySelector('[data-freight-fifo-reload]');
      if (reloadButton) reloadButton.addEventListener('click', function () { window.location.reload(); });
