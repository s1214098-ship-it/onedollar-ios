    historyBox.innerHTML = history.length ? '<b>本張收款紀錄 ' + history.length + ' 次</b>' + history.map(function (entry, index) {
      if (String(entry && entry.type || '') === 'payment-correction') {
        return '<div class="is-correction">第 ' + (index + 1) + ' 次：' + escapeHtml(entry.date || entry.recordedAt || '-') + '／更正既有訂金・已收 ' + freightFifoMoney(entry.oldPaidAmount || 0) + ' → ' + freightFifoMoney(entry.newPaidAmount || 0) + '／原因：' + escapeHtml(entry.reason || entry.note || '未填原因') + '</div>';
      }
