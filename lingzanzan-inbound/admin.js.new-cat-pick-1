    document.addEventListener('click', function (event) {
      var saveButton = event.target.closest && event.target.closest('[data-order-customer-save]');
      if (saveButton) { event.preventDefault(); saveAdminOrderCustomerDraft(saveButton); return; }
      var loadButton = event.target.closest && event.target.closest('[data-order-customer-load]');
      if (loadButton) {
        event.preventDefault();
        var savedDraft = readOrderCustomerDraft();
        if (!savedDraft) { updateOrderCustomerDraftStatus('目前沒有已存客戶', 'empty'); toast('目前沒有已存客戶'); return; }
