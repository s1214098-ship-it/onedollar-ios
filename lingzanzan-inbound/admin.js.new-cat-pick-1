    window.dispatchEvent(new CustomEvent('lingzanzan:logistics-summary', { detail: logisticsSidebarCounts }));
    var statusFilterLabel = {
      manual: '人工查詢／需處理',
      missing: '待補物流單號',
      no_data: '查無資料',
      not_handed: '已建單未交寄',
      in_transit: '配送中',
      arrived_store: '到店待取',
      undelivered: '未送達',
