    return [header].concat(rows).map(function (row) {
      var values = Array.isArray(row) ? row : [
        sheetStockCompareStatusLabel(row.status),
        row.code || '',
        row.color || '',
        row.colorCode || '',
        row.size || row.backendSize || '',
        row.sheetQty == null ? '' : row.sheetQty,
        row.backendQty == null ? '' : row.backendQty,
        row.diff == null ? '' : row.diff,
        (row.rows || []).join('/'),
        (row.warehouses || []).join('/'),
        row.backendSkus || '',
        row.issue || '',
        row.suggestion || ''
      ];
      return values.map(function (cell) {
        cell = String(cell == null ? '' : cell);
        return '"' + cell.replace(/"/g, '""') + '"';
      }).join(',');
    }).join('\n');
  }

