  // LZ_PRINT_STAY_20260924: keep labels on this page. Do not window.open+auto-print (that popup flashes and closes).
  function showInventoryBarcodePrintOverlay(printableHtml, fileName) {
    closeInventoryBarcodePrintOverlay();
    var overlay = document.createElement('div');
    overlay.className = 'inventory-barcode-print-overlay';
    overlay.setAttribute('data-inventory-barcode-print-overlay', '');
    overlay.style.cssText = 'position:fixed;inset:0;z-index:10050;display:grid;place-items:center;padding:16px;background:rgba(8,7,10,.86)';
    overlay.innerHTML = '<section role="dialog" aria-modal="true" style="width:min(720px,100%);max-height:calc(100dvh - 24px);display:grid;grid-template-rows:auto minmax(240px,1fr) auto;gap:12px;box-sizing:border-box;padding:16px;border:1px solid rgba(239,191,91,.55);border-radius:20px;background:#17131b;color:#fff">'
      + '<header style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap"><div><small style="color:#efbf5b;font-weight:900;letter-spacing:.08em">QR LABEL PREVIEW</small><h3 style="margin:4px 0 0;font-size:20px">標籤已產生，請核對後再列印</h3></div>'
      + '<button type="button" class="ghost-button" data-label-overlay-close aria-label="關閉">×</button></header>'
      + '<iframe title="標籤預覽" data-label-print-frame style="width:100%;min-height:280px;height:min(58dvh,520px);border:1px solid #3d3342;border-radius:12px;background:#fff"></iframe>'
      + '<footer style="display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap">'
      + '<button type="button" class="primary-button" data-label-overlay-print>列印 QR 標籤</button>'
      + '<button type="button" class="ghost-button" data-label-overlay-download>下載列印檔</button>'
      + '<button type="button" class="ghost-button" data-label-overlay-close>關閉</button>'
      + '</footer></section>';
    document.body.appendChild(overlay);
    var frame = overlay.querySelector('[data-label-print-frame]');
    var frameDoc = frame && (frame.contentDocument || (frame.contentWindow && frame.contentWindow.document));
    if (!frameDoc) {
      toast('標籤預覽無法開啟，請改下載列印檔');
      return false;
    }
    frameDoc.open();
    frameDoc.write(printableHtml);
    frameDoc.close();
    var printWindow = frame.contentWindow;
    overlay.addEventListener('click', function (event) {
      if (event.target === overlay || event.target.closest('[data-label-overlay-close]')) {
        event.preventDefault();
        closeInventoryBarcodePrintOverlay();
        return;
      }
      if (event.target.closest('[data-label-overlay-print]')) {
        event.preventDefault();
        if (printWindow && !printWindow.closed) {
          printWindow.focus();
          printWindow.print();
        }
        return;
      }
      if (!event.target.closest('[data-label-overlay-download]')) return;
      event.preventDefault();
      var blob = new Blob([printableHtml], { type: 'text/html;charset=utf-8' });
      var url = URL.createObjectURL(blob);
      var link = document.createElement('a');
      link.href = url;
      link.download = fileName || 'LINGZANZAN-qr-label-labels.html';
      document.body.appendChild(link);
      link.click();
      link.remove();
      setTimeout(function () { URL.revokeObjectURL(url); }, 2000);
    });
    return true;
  }

