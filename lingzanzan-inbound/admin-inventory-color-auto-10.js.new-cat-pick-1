  function scissorPoint(event, stage) {
    var rect = stage.getBoundingClientRect();
    return {
      x: Math.max(0, Math.min(rect.width, event.clientX - rect.left)),
      y: Math.max(0, Math.min(rect.height, event.clientY - rect.top))
    };
  }

  function renderScissorSelection() {
    if (!scissorToolState) return;
    var sel = scissorToolState.modal.querySelector('[data-scissor-selection]');
    if (!sel) return;
    var start = scissorToolState.start;
    var current = scissorToolState.current;
    if (!start || !current) {
      sel.hidden = true;
      return;
    }
    var left = Math.min(start.x, current.x);
    var top = Math.min(start.y, current.y);
    var width = Math.abs(start.x - current.x);
    var height = Math.abs(start.y - current.y);
    sel.hidden = width < 8 || height < 8;
    sel.style.left = left + 'px';
    sel.style.top = top + 'px';
    sel.style.width = width + 'px';
    sel.style.height = height + 'px';
  }

  function bindScissorTool(modal) {
    var stage = modal.querySelector('[data-scissor-stage]');
    stage.addEventListener('pointerdown', function (event) {
      if (!scissorToolState) return;
      stage.setPointerCapture(event.pointerId);
      scissorToolState.dragging = true;
      scissorToolState.start = scissorPoint(event, stage);
      scissorToolState.current = scissorToolState.start;
      renderScissorSelection();
    });
    stage.addEventListener('pointermove', function (event) {
      if (!scissorToolState || !scissorToolState.dragging) return;
      scissorToolState.current = scissorPoint(event, stage);
      renderScissorSelection();
    });
    stage.addEventListener('pointerup', function (event) {
      if (!scissorToolState) return;
      scissorToolState.dragging = false;
      scissorToolState.current = scissorPoint(event, stage);
      renderScissorSelection();
    });
    modal.addEventListener('click', function (event) {
      if (event.target.matches('[data-scissor-close]')) {
        closeScissorTool();
        return;
      }
      if (event.target.matches('[data-scissor-use-crop]')) {
