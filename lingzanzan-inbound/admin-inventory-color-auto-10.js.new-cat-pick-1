  function playStocktakeBeeps(count) {
    var AudioContextClass = window.AudioContext || window.webkitAudioContext;
    if (!AudioContextClass) return;
    try {
      var context = window.__stocktakeAudioContext;
      if (!context || context.state === 'closed') {
        context = new AudioContextClass();
        window.__stocktakeAudioContext = context;
      }
      if (context.state === 'suspended') context.resume().catch(function () {});
      var total = Math.max(1, Number(count || 1));
      var startAt = context.currentTime + 0.03;
      for (var i = 0; i < total; i += 1) {
        var oscillator = context.createOscillator();
        var gain = context.createGain();
        var beepAt = startAt + i * 0.16;
        oscillator.type = total > 1 ? 'square' : 'sine';
        oscillator.frequency.setValueAtTime(total > 1 ? 420 : 920, beepAt);
        gain.gain.setValueAtTime(0.0001, beepAt);
        gain.gain.exponentialRampToValueAtTime(total > 1 ? 0.24 : 0.30, beepAt + 0.01);
        gain.gain.exponentialRampToValueAtTime(0.0001, beepAt + 0.09);
        oscillator.connect(gain);
        gain.connect(context.destination);
        oscillator.start(beepAt);
        oscillator.stop(beepAt + 0.10);
      }
    } catch (error) {}
  }

  function getStocktakeSkuByKey(key) {
    var parts = String(key || '').split('::');
    var product = state.products.find(function (item) { return String(item.id) === parts[0]; });
    if (!product) return null;
    var sku = productSkus(state.skus, product.id).find(function (item) {
      return String(item.id || item.sku || '') === parts[1];
    }) || productSkus(state.skus, product.id)[0];
    return sku ? { product: product, sku: sku } : null;
  }

  function stocktakeCandidates(scanText) {
    var raw = normalizeScanCode(scanText);
    var parsedLegacy = parseLegacyProductBarcodeForCatalog(raw);
    if (parsedLegacy && !legacyProductPrefixExists(parsedLegacy)) parsedLegacy = null;
    var family = parsedLegacy ? parsedLegacy.productCode : scanFamilyCode(raw);
    var mapped = (state.barcodeMappings || []).find(function (item) {
      return normalizeScanCode(item.companyCode) === raw || normalizeScanCode(item.companyCode) === family;
    });
    if (mapped) {
      var exact = getStocktakeSkuByKey(mapped.skuKey);
      if (exact) return [exact];
    }
    if (parsedLegacy) {
      var legacyMatches = [];
      state.products.forEach(function (product) {
        productSkus(state.skus, product.id).forEach(function (sku) {
          if (stocktakeLegacyMatches(product, sku, parsedLegacy)) {
            legacyMatches.push({ product: product, sku: sku, legacyExact: true, legacyProductMatch: false });
          }
        });
      });
      if (legacyMatches.length) {
        var legacySeen = {};
        return legacyMatches.filter(function (entry) {
          var key = stocktakeSkuKey(entry.product.id, entry.sku.id || entry.sku.sku);
          if (legacySeen[key]) return false;
          legacySeen[key] = true;
          return true;
        });
      }
    }
    var matches = [];
    state.products.forEach(function (product) {
      productSkus(state.skus, product.id).forEach(function (sku) {
        var productCode = normalizeScanCode(product.code || product.id);
        var skuCode = normalizeScanCode(sku.id || sku.sku);
        var printableBarcode = inventoryPreferredLabelBarcode(product, sku);
        var printedScanKeys = [
          printableBarcode,
          numericBarcodeScanKey(printableBarcode),
          legacyNumericBarcodeScanKey(printableBarcode)
        ].map(normalizeScanCode).filter(Boolean);
        var extraCodes = [sku.barcode, sku.companyBarcode, sku.mappingCode, product.barcode, product.companyBarcode].map(normalizeScanCode);
        var skuFamily = scanFamilyCode(skuCode || productCode);
        var productFamily = scanFamilyCode(productCode);
        var legacyExact = stocktakeLegacyMatches(product, sku, parsedLegacy);
        var allowLegacyFamilyFallback = parsedLegacy && !parsedLegacy.colorCode && !parsedLegacy.sizeCode;
        var legacyProductMatch = allowLegacyFamilyFallback && stocktakeLegacyProductMatches(product, parsedLegacy);
        var familyMatch = !parsedLegacy && family && (family === skuFamily || family === productFamily);
        var isMatch = extraCodes.indexOf(raw) !== -1 ||
          printedScanKeys.indexOf(raw) !== -1 ||
          skuCode === raw ||
          productCode === raw ||
          legacyExact ||
          legacyProductMatch ||
          familyMatch;
        if (isMatch) matches.push({ product: product, sku: sku, legacyExact: legacyExact, legacyProductMatch: legacyProductMatch });
      });
    });
    var seen = {};
    return matches.sort(function (a, b) {
      return (b.legacyExact ? 1 : 0) - (a.legacyExact ? 1 : 0);
    }).filter(function (entry) {
      var key = stocktakeSkuKey(entry.product.id, entry.sku.id || entry.sku.sku);
      if (seen[key]) return false;
      seen[key] = true;
      return true;
    });
  }

  function stocktakeCrossWarehouseCandidates(scanText, targetWarehouse) {
    var raw = normalizeScanCode(scanText);
    var family = scanFamilyCode(raw);
    if (!family) return [];
    var parsed = parseLegacyProductBarcodeForCatalog(raw);
    var matches = [];
    state.products.forEach(function (product) {
      var productCodes = [product.code, product.id, product.barcode, product.companyBarcode].map(normalizeScanCode).filter(Boolean);
      var productFamilyMatch = productCodes.some(function (code) { return scanFamilyCode(code) === family; });
      productSkus(state.skus, product.id).forEach(function (sku) {
        var skuCodes = [sku.id, sku.sku, sku.barcode, sku.companyBarcode, sku.mappingCode].map(normalizeScanCode).filter(Boolean);
        var skuFamilyMatch = skuCodes.some(function (code) { return scanFamilyCode(code) === family; });
        if (!productFamilyMatch && !skuFamilyMatch) return;
        var entry = { product: product, sku: sku, crossWarehouseSource: true };
        var location = productLocation(product, [sku]);
        var sourceWarehouse = sku.warehouseName || sku.warehouse || location.warehouse || '其他倉';
        entry.sourceWarehouse = sourceWarehouse;
        entry.crossWarehouseScore = 0;
        if (/台灣/.test(sourceWarehouse)) entry.crossWarehouseScore += 100;
        if (parsed && stocktakeLegacyMatches(product, sku, parsed)) entry.crossWarehouseScore += 50;
        if (skuCodes.indexOf(raw) !== -1 || productCodes.indexOf(raw) !== -1) entry.crossWarehouseScore += 25;
        if (sourceWarehouse === targetWarehouse) entry.crossWarehouseScore -= 20;
        matches.push(entry);
      });
    });
    var seen = {};
    return matches.sort(function (a, b) { return b.crossWarehouseScore - a.crossWarehouseScore; }).filter(function (entry) {
      var key = stocktakeSkuKey(entry.product.id, entry.sku.id || entry.sku.sku);
      if (seen[key]) return false;
      seen[key] = true;
      return true;
    });
  }

