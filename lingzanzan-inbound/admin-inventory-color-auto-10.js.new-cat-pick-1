  function inventoryMergeScanAliases(sku, extraValues) {
    sku = sku || {};
    return Array.from(new Set([
      sku.id, sku.sku, sku.barcode, sku.companyBarcode, sku.officialBarcode,
      sku.legacyBarcode, sku.mappingCode, sku.labelBarcode
    ].concat(Array.isArray(sku.linkedBarcodes) ? sku.linkedBarcodes : [])
      .concat(Array.isArray(sku.barcodeAliases) ? sku.barcodeAliases : [])
      .concat(extraValues || [])
      .map(function (value) { return String(value || '').trim(); })
      .filter(Boolean)));
  }

  function inventoryCanonicalNewBarcode(product, sku) {
    var generated = inventoryLegacyLabelBarcode(product, sku);
    if (generated) return generated;
    return inventoryPreferredLabelBarcode(product, sku) || sku.companyBarcode || sku.barcode || sku.sku || sku.id || '';
  }

  function inventoryAttachOldBarcodeAlias(product, sku, oldScan) {
    if (!sku) return false;
    var old = normalizeScanCode(oldScan);
    var newBarcode = inventoryCanonicalNewBarcode(product, sku);
    var changed = false;
    var aliases = inventoryMergeScanAliases(sku, [old, sku.barcode, newBarcode]);
    if (JSON.stringify(aliases) !== JSON.stringify(sku.linkedBarcodes || [])) {
      sku.linkedBarcodes = aliases;
      changed = true;
    }
    if (old && !sku.legacyBarcode) { sku.legacyBarcode = old; changed = true; }
    if (old && !sku.mappingCode) { sku.mappingCode = old; changed = true; }
    if (newBarcode && normalizeScanCode(sku.barcode) !== normalizeScanCode(newBarcode)) {
      if (sku.barcode && aliases.indexOf(String(sku.barcode)) === -1) aliases.push(String(sku.barcode));
      sku.linkedBarcodes = inventoryMergeScanAliases(sku, aliases);
      sku.barcode = newBarcode;
      sku.companyBarcode = newBarcode;
      sku.officialBarcode = newBarcode;
      sku.labelBarcode = newBarcode;
      changed = true;
    }
    return changed;
  }

  function inventoryPickerSkuForVariant(product, variant, warehouseName) {
    var wanted = inventoryWarehouseFilterName(warehouseName);
    var skus = (variant && variant.skus) || [];
    function inWarehouse(sku, name) {
      return inventoryWarehouseFilterName(inventorySkuLocation(product, sku).warehouse) === name;
    }
    return skus.find(function (sku) { return inWarehouse(sku, wanted) && Number(sku.stock || 0) > 0; })
      || skus.find(function (sku) { return inWarehouse(sku, wanted); })
      || skus.find(function (sku) { return inWarehouse(sku, '台灣倉') && Number(sku.stock || 0) > 0; })
      || skus.find(function (sku) { return inWarehouse(sku, '台灣倉'); })
      || (variant && variant.primary)
      || skus[0]
      || null;
