  function lookupFreightCustoms() {
    var input = document.querySelector('[data-freight-customs-no]');
    var result = document.querySelector('[data-freight-customs-result]');
    var button = document.querySelector('[data-freight-customs-lookup]');
    var taxType = document.querySelector('[data-freight-warehouse-tax-type]')?.value || 'tax_exempt';
    if (taxType !== 'taxable') {
      if (result) result.textContent = '目前選的是免稅集運倉，不需要執行關稅比對。';
      return;
    }
    var query = String(input?.value || '').trim();
    if (!query) {
      if (result) result.textContent = '請先輸入關稅號碼或台灣物流單號，再按比對。';
      toast('請先輸入關稅號碼或台灣物流單號');
      return;
    }
    if (button) {
      button.disabled = true;
      button.textContent = '比對中…';
    }
    if (result) result.textContent = '正在從寶輝比對關稅資料...';
    fetch('./freight-customs-lookup.php?q=' + encodeURIComponent(query), { cache: 'no-store' })
      .then(function (res) { return res.json().then(function (payload) { if (!res.ok || !payload.ok) throw new Error(payload.error || '關稅比對失敗'); return payload; }); })
      .then(function (payload) {
        var match = (payload.matches || [])[0];
        if (!match) {
          if (result) result.textContent = '寶輝找不到相符關稅號或台灣物流單號，請手動核對。';
          return;
        }
        if (input) input.value = match.customsNo || query;
        var date = document.querySelector('[data-freight-batch-date]');
        var amount = document.querySelector('[data-freight-batch-amount]');
        if (date && match.date) date.value = String(match.date).slice(0, 10);
        if (amount) amount.value = Number(match.chargeTotalTwd || 0);
        if (result) result.textContent = '已帶入關稅 ' + (match.customsNo || '-') + '，' + match.packageCount + ' 筆台灣物流，收款合計 NT$' + Number(match.chargeTotalTwd || 0).toLocaleString() + '。請填本批實收件數後儲存分攤。';
        toast('已帶入寶輝關稅收款合計');
      })
      .catch(function (error) {
        if (result) result.textContent = error.message || '關稅比對失敗';
        toast(error.message || '關稅比對失敗');
      })
      .finally(function () {
        if (button) {
          button.disabled = false;
          button.textContent = '從寶輝比對關稅';
        }
      });
  }

