  function addUncountedStocktakeRowsAsZero() {
    var data = stocktakeCompareData();
    var existing = {};
    stocktakeDraft.lines.forEach(function (line) {
      existing[line.key + '::' + line.warehouse] = true;
    });
    var added = 0;
    data.rows.forEach(function (row) {
      if (!row.expected) return;
      var compoundKey = row.key + '::' + stocktakeDraft.warehouse;
      if (existing[compoundKey]) return;
      var parts = row.key.split('::');
      stocktakeDraft.lines.unshift({
        key: row.key,
        productId: parts[0],
        skuId: parts[1],
        productCode: row.productCode,
        skuCode: row.skuCode,
        image: row.image || './assets/brand-logo.png',
        color: row.color,
        size: row.size,
        warehouse: stocktakeDraft.warehouse,
        companyCode: '',
        systemStock: row.systemStock,
        countedQty: 0,
        diff: 0 - Number(row.systemStock || 0)
      });
      added += 1;
    });
    return added;
  }

