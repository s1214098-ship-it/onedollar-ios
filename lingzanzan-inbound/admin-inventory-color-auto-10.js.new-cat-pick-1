  function inventoryCountCheckData(cards, context) {
    cards = Array.isArray(cards) ? cards : [];
    context = context || {};
    var rows = [];
    cards.forEach(function (entry) {
      var product = entry.product || {};
      var skus = entry.skus || [];
      if (context.preorderWarehouseFilter) {
        inventoryLogicalVariantGroups(product, skus).forEach(function (variant) {
          var demand = inventoryPreorderVariantDemand(variant, entry.preorderDemand || {});
          var primary = variant.primary || {};
          rows.push({
            productId: product.id || '',
            skuId: primary.id || primary.sku || '',
            department: inventoryProductDepartmentLabel(product),
            productCode: product.code || product.id || '',
            productName: product.title || product.name || '',
            barcode: primary.companyBarcode || primary.barcode || primary.legacyBarcode || primary.sku || primary.id || '',
            color: variant.color || '未填顏色',
            size: variant.size || 'NO SIZE',
            location: '預購倉',
            warehouse: '預購倉',
            shelf: '',
            layer: '',
            systemQty: Number(demand.qty || 0)
          });
        });
        return;
      }
      skus.forEach(function (sku) {
        var location = inventorySkuLocation(product, sku);
        rows.push({
          productId: product.id || '',
          skuId: sku.id || sku.sku || '',
          department: inventoryProductDepartmentLabel(product),
          productCode: product.code || product.id || '',
          productName: product.title || product.name || '',
          barcode: sku.companyBarcode || sku.barcode || sku.legacyBarcode || sku.sku || sku.id || '',
          color: sku.colorName || sku.color || '未填顏色',
          size: sku.sizeName || sku.size || 'NO SIZE',
          location: [location.warehouse, location.shelf, location.layer].filter(Boolean).join(' / '),
          warehouse: location.warehouse,
          shelf: location.shelf,
          layer: location.layer,
          systemQty: Number(sku.stock || 0)
        });
      });
    });
    // A quantity-count sheet is for physical stock that must be found and
    // counted. Zero rows only create noise and previously made the selected
    // warehouse/shelf/layer report look unrelated to the actual location.
    rows = rows.filter(function (row) { return Number(row.systemQty || 0) > 0; });
    var productKeys = {};
    rows.forEach(function (row) { productKeys[String(row.productId || row.productCode || '')] = true; });
    return {
      rows: rows,
      productCount: Object.keys(productKeys).length,
      variantCount: rows.length,
      systemTotal: rows.reduce(function (sum, row) { return sum + Number(row.systemQty || 0); }, 0)
    };
  }

