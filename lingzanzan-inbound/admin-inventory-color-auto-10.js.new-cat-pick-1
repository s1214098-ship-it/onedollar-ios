  function applyApprovedStocktake(lines, approvalId) {
    var appliedLines = [];
    (lines || []).forEach(function (line) {
      var sku = state.skus.find(function (item) {
        return String(item.productId) === String(line.productId) && String(item.id || item.sku || '') === String(line.skuId || '');
      });
      if (!sku) return;
      sku.stock = Math.max(0, Number(line.countedQty || 0));
      sku.warehouse = line.warehouse || stocktakeDraft.warehouse || sku.warehouse || '台灣倉';
      sku.warehouseName = sku.warehouse;
      if (line.image && line.photoAdded) {
        sku.colorImage = line.image;
        sku.image = line.image;
        var product = state.products.find(function (item) { return String(item.id || '') === String(line.productId || ''); });
        if (product) {
          var colorName = String(sku.colorName || sku.color || line.color || '');
          var color = inventoryFindProductColor(product, colorName, sku.colorCode, line.image);
          if (color) color.image = line.image;
          else if (colorName) {
            product.colors = product.colors || [];
            product.colors.push({ name: colorName, code: sku.colorCode || '', image: line.image });
          }
          if (!product.mainImage) product.mainImage = line.image;
        }
      }
      appliedLines.push({
        productCode: line.productCode,
        skuCode: line.skuCode,
        warehouse: line.warehouse,
        before: line.systemStock,
        after: line.countedQty,
        diff: line.diff,
        companyCode: line.companyCode || ''
      });
    });
    state.stocktakeLogs = state.stocktakeLogs || [];
    state.stocktakeLogs.push({
      id: 'stocktake-log-' + Date.now(),
      approvalId: approvalId || '',
      createdAt: new Date().toISOString(),
      warehouse: (lines && lines[0] && lines[0].warehouse) || stocktakeDraft.warehouse,
      count: appliedLines.length,
      lines: appliedLines
    });
