    var text = [row.returnFlag, row.status, row.returnedStore, row.note, row.delivered].join(' ');
    if (isReturnOrAbnormal(row) || /退回公司|退回原本門市|退回原門市|退貨|拒收|退件/.test(text)) {
      return {
        deliveryState: 'returned',
