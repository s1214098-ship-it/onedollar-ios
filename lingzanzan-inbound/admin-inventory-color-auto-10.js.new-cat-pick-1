  function cropScissorImage() {
    return new Promise(function (resolve) {
      if (!scissorToolState || !scissorToolState.start || !scissorToolState.current) {
        resolve(scissorToolState ? scissorToolState.dataUrl : '');
        return;
      }
      var img = scissorToolState.modal.querySelector('[data-scissor-image]');
      var stage = scissorToolState.modal.querySelector('[data-scissor-stage]');
      var rect = stage.getBoundingClientRect();
      var scaleX = img.naturalWidth / rect.width;
      var scaleY = img.naturalHeight / rect.height;
      var sx = Math.min(scissorToolState.start.x, scissorToolState.current.x) * scaleX;
      var sy = Math.min(scissorToolState.start.y, scissorToolState.current.y) * scaleY;
      var sw = Math.abs(scissorToolState.start.x - scissorToolState.current.x) * scaleX;
      var sh = Math.abs(scissorToolState.start.y - scissorToolState.current.y) * scaleY;
      if (sw < 12 || sh < 12) {
        resolve(scissorToolState.dataUrl);
        return;
      }
      var canvas = document.createElement('canvas');
      canvas.width = Math.round(sw);
      canvas.height = Math.round(sh);
      canvas.getContext('2d').drawImage(img, sx, sy, sw, sh, 0, 0, canvas.width, canvas.height);
      resolve(canvas.toDataURL('image/jpeg', 0.9));
    });
  }

