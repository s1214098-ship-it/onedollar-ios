  function adminShipmentSearchRows(query) {
    var q = String(query || '').trim().toLowerCase();
    var rows = adminShipmentSkuRows();
    if (!q) return rows.slice(0, 10);
    return rows.map(function (row) {
      var text = adminShipmentSkuSearchText(row);
      var rank = productSearchRank(row.product, row.sku, query, text);
      return { row: row, rank: rank, text: text };
    }).filter(function (entry) {
      return entry.rank < 9999;
    }).sort(function (a, b) {
      return a.rank - b.rank || String(a.row.product.code || a.row.product.id || '').localeCompare(String(b.row.product.code || b.row.product.id || ''), 'zh-Hant', { numeric: true });
    }).map(function (entry) { return entry.row; }).slice(0, 14);
  }

  function adminShipmentExactRow(query) {
    var normalized = normalizeScanCode(query).replace(/[\-()（）]/g, '');
    if (!normalized || normalized.length < 4) return null;
    var matches = adminShipmentSkuRows().filter(function (row) {
      var directValues = [
        row.product.code, row.product.id, row.product.barcode, row.product.companyBarcode, row.product.productLine,
        row.sku.id, row.sku.sku, row.sku.barcode, row.sku.companyBarcode, row.sku.legacyBarcode, row.sku.mappingCode,
        inventoryPreferredLabelBarcode(row.product, row.sku)
      ].map(function (value) { return normalizeScanCode(value).replace(/[\-()（）]/g, ''); }).filter(Boolean);
      if (directValues.indexOf(normalized) !== -1) return true;
      var parsed = parseLegacyProductBarcodeForCatalog(query);
      return parsed && stocktakeLegacyProductMatches(row.product, parsed) && stocktakeLegacyMatches(row.product, row.sku, parsed);
    });
    return matches.length === 1 ? matches[0] : null;
  }

  function adminShipmentProductGroups(query) {
    var rows = adminShipmentSearchRows(query);
    var groups = {};
    rows.forEach(function (row) {
      var productId = row.product.id || row.product.code || '';
      if (!groups[productId]) groups[productId] = { product: row.product, rows: [] };
      groups[productId].rows.push(row);
    });
    return Object.keys(groups).map(function (key) { return groups[key]; });
