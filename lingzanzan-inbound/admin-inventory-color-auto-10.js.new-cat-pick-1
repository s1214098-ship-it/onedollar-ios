      id: 'plog-' + Date.now(),
      date: date,
      createdAt: new Date().toISOString(),
      platform: platform || '其他',
      trackingNo: trackingNo,
      progress: progress,
      note: note
    }]);
    ['[data-product-logistics-no]', '[data-product-logistics-progress]', '[data-product-logistics-note]'].forEach(function (selector) {
