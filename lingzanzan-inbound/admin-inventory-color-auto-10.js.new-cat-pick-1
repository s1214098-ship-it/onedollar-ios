  function fillRecentCustomsOptions() {
    fillFreightBatchPlatformSelect();
    var freightList = document.querySelector('[data-freight-customs-options]');
    var recentSelect = document.querySelector('[data-freight-customs-recent-select]');
    var platform = document.querySelector('[data-freight-batch-platform]')?.value || '';
    var taxType = document.querySelector('[data-freight-warehouse-tax-type]')?.value || '';
    var recentBatches = recentFreightBatchesForSelection(platform, taxType);
    if (freightList) freightList.innerHTML = recentBatches.map(function (batch) {
      var no = batch.customsNo || batch.consolidationNo || '';
      return no ? '<option value="' + escapeHtml(no) + '">' + escapeHtml([batch.date, batch.platform || '全部平台', freightBatchTaxType(batch) === 'tax_exempt' ? '免稅倉' : '關稅倉', batch.forwarder].filter(Boolean).join(' / ')) + '</option>' : '';
    }).join('');
    if (recentSelect) {
      var current = recentSelect.value;
      var modeLabel = taxType === 'tax_exempt' ? '免稅集運倉' : '關稅集運倉';
      recentSelect.innerHTML = '<option value="">' + (recentBatches.length ? '選擇近 15 天的' + modeLabel + '號碼' : '近 15 天沒有' + modeLabel + '號碼') + '</option>' + recentBatches.map(function (batch) {
        var no = batch.customsNo || batch.consolidationNo || '未填號碼';
        var label = [batch.date || '未填日期', no, batch.platform || '全部平台', batch.forwarder].filter(Boolean).join(' / ');
        return '<option value="' + escapeHtml(batch.id || '') + '">' + escapeHtml(label) + '</option>';
      }).join('');
      if (Array.from(recentSelect.options).some(function (option) { return option.value === current; })) recentSelect.value = current;
    }
    var lookupButton = document.querySelector('[data-freight-customs-lookup]');
    var lookupResult = document.querySelector('[data-freight-customs-result]');
    if (lookupButton) lookupButton.hidden = taxType !== 'taxable';
    if (lookupResult && taxType === 'tax_exempt') lookupResult.textContent = '免稅集運倉不需要比對關稅；請從上方選擇近 15 天集運號碼。';
    var productList = document.querySelector('[data-product-customs-options]');
    var productPlatform = document.querySelector('[data-product-logistics-platform]')?.value || '';
    var productSource = productFreightSource();
    if (productList) productList.innerHTML = recentFreightBatchesForSelection(productPlatform, '').filter(function (batch) {
      return freightBatchMatchesSource(batch, productSource);
    }).map(function (batch) {
      var no = batch.customsNo || batch.consolidationNo || '';
      return no ? '<option value="' + escapeHtml(no) + '">' + escapeHtml([batch.date, batch.platform || '全部平台', freightBatchTaxType(batch) === 'tax_exempt' ? '免稅倉' : '關稅倉'].join(' / ')) + '</option>' : '';
    }).join('');
  }

