  function renderSalesPerformance() {
    var target = document.querySelector('[data-sales-performance]');
    if (!target) return;
    var now = new Date();
    var todayOrders = (state.orders || []).filter(function (order) {
      return isSameLocalDay(adminDateValue(order), now);
    });
    var names = [];
    (state.salesCustomers || []).forEach(function (person) {
      if (person.name && names.indexOf(person.name) === -1) names.push(person.name);
    });
    (state.staff || []).forEach(function (person) {
      if (/業務|行政|客服|管理/.test(person.role || '') && person.name && names.indexOf(person.name) === -1) names.push(person.name);
    });
    todayOrders.forEach(function (order) {
      var name = orderSalesName(order);
      if (name && names.indexOf(name) === -1) names.push(name);
    });
    var rows = names.map(function (name) {
      var orders = todayOrders.filter(function (order) {
        return orderSalesName(order) === name;
      });
      var total = orders.reduce(function (sum, order) { return sum + Number(order.total || 0); }, 0);
      var pending = orders.filter(isOverviewPendingOrder).length;
      return { name: name, count: orders.length, pending: pending, total: total };
    }).sort(function (a, b) { return b.total - a.total; });
    target.innerHTML = rows.map(function (row) {
      return '<article><b>' + escapeHtml(row.name) + '</b><span>今日 ' + row.count + ' 筆 / 未處理 ' + row.pending + ' 筆</span><strong>NT$' + row.total.toLocaleString('zh-TW') + '</strong></article>';
    }).join('') || '<div class="empty">今天還沒有業務訂單。</div>';
  }

  function saveVisibleProductInlineRows() {
    var rows = Array.from(document.querySelectorAll('[data-product-inline-price]'));
    var changed = 0;
    rows.forEach(function (row) {
      var productId = row.getAttribute('data-product-inline-price');
      var product = state.products.find(function (item) { return item.id === productId; });
      if (!product) return;
      var price = Number(row.querySelector('[data-product-inline-sale]')?.value || 0);
      var cost = Number(row.querySelector('[data-product-inline-cost]')?.value || 0);
      var visible = isProductPreorderSection(product) ? false : row.querySelector('[data-product-inline-visible]')?.checked !== false;
      product.price = price;
      product.cost = cost;
      product.showOnWebsite = visible;
      state.skus.forEach(function (sku) {
        if (sku.productId !== productId) return;
        sku.price = price;
        sku.cost = cost;
      });
      changed += 1;
    });
    if (!changed) {
      toast('目前畫面沒有可儲存的商品列');
      return;
    }
    toast('正在大量儲存目前頁面 ' + changed + ' 件商品...');
    saveLocal().then(function () {
      renderProducts();
      renderInventoryLines();
      renderQuickPriceEditor();
      toast('已大量儲存目前頁面 ' + changed + ' 件商品');
    });
  }

