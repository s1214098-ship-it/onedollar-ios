      productDraft.colors = colors.map(function (color) {
        var existing = productDraft.colors.find(function (item) { return item.name === color.name; });
        return { name: color.name, image: existing ? existing.image || '' : '' };
      });
      productDraft.sizes = sizes.length ? sizes : ['NO SIZE'];
      productDraft.stocks = stocks;
      shelves.forEach(function (shelf) { if (!isInvalidShelfName(shelf) && state.shelves.indexOf(shelf) === -1) state.shelves.push(shelf); });
      layers.forEach(function (layer) { if (!isInvalidLayerName(layer) && state.layers.indexOf(layer) === -1) state.layers.push(layer); });
      saveLocal();
