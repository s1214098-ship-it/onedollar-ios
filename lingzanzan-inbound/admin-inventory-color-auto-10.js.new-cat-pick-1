    if (!modal) return;
    var productId = modal.getAttribute('data-inventory-print-selector-modal');
    var product = state.products.find(function (item) { return String(item.id || '') === String(productId || ''); });
    var variants = modal._inventoryPrintVariants || [];
    if (!product) return;
    var selections = Array.from(modal.querySelectorAll('[data-inventory-print-choice]:checked')).map(function (checkbox) {
      var variant = variants[Number(checkbox.value)];
