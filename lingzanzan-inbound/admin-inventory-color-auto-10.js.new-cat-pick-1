        '<span>' + status.label + '</span>',
        '<strong>帳 ' + row.systemStock + '</strong>',
        '<strong>盤 ' + (row.counted ? row.countedQty : '-') + '</strong>',
        '<strong class="' + (row.diff < 0 ? 'is-minus' : row.diff > 0 ? 'is-plus' : '') + '">' + (row.counted ? ((row.diff > 0 ? '+' : '') + row.diff) : '-') + '</strong>',
        '</article>'
      ].join('');
    }).join('') || '<div class="empty">這個貨倉目前沒有 SKU。</div>';
  }

  function addStocktakeLine(match, companyCode, qty) {
    var product = match.product;
    var sku = match.sku;
    var key = stocktakeSkuKey(product.id, sku.id || sku.sku);
    var warehouse = stocktakeDraft.warehouse || state.warehouses[0] || '台灣倉';
    var existing = stocktakeDraft.lines.find(function (line) { return line.key === key && line.warehouse === warehouse; });
    var currentStock = stocktakeMatchIsInWarehouse(match, warehouse) ? Number(sku.stock || 0) : 0;
    if (existing) {
      existing.countedQty += qty;
      existing.diff = existing.countedQty - existing.systemStock;
      existing.companyCode = companyCode || existing.companyCode;
      return;
    }
    stocktakeDraft.lines.unshift({
      key: key,
      productId: product.id,
      skuId: sku.id || sku.sku,
      productCode: product.code || product.id || '-',
      skuCode: sku.id || sku.sku || '-',
      image: stocktakeSkuImage(product, sku),
      color: sku.colorName || sku.color || '未填顏色',
      size: sku.sizeName || sku.size || 'NO SIZE',
      warehouse: warehouse,
      companyCode: companyCode || '',
      systemStock: currentStock,
      countedQty: qty,
      diff: qty - currentStock
    });
