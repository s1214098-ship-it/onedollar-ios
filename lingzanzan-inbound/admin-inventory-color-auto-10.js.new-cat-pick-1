    var productCode = labelBarcodeBaseProductCode(payload.productCode || raw);
    var product = (state.products || []).find(function (item) {
      return labelBarcodeBaseProductCode(item.code || item.barcode || item.companyBarcode || item.id) === productCode;
    });
    var sku = product && (state.skus || []).find(function (item) {
      if (String(item.productId || '') !== String(product.id || '')) return false;
      return [item.id, item.sku, item.barcode, item.companyBarcode, item.legacyBarcode, item.mappingCode]
        .map(normalizeScanCode)
        .some(function (code) { return code && (code === rawCode || code === backendCode); });
    });
    var generated = product && sku ? inventoryLegacyLabelBarcode(product, sku) : '';
    // Printing uses 編號+顏色+尺寸+P本次台幣. Saved/legacy barcodes remain scan aliases.
    return generated || raw;
  }

  function inventoryBarcodeLabelHtml(payload) {
    var printBarcode = inventoryPrintableBarcode(payload);
    // A full mixed alpha/numeric barcode is too dense for the 23 mm space
    // beside the QR code on a 40 x 30 mm label.  The scanner API and the
    // stocktake scanner both resolve this stable eight-digit alias back to
    // the complete product/cost/colour/size barcode.
    var linearScanKey = numericBarcodeScanKey(printBarcode) || printBarcode;
    var serialLast6 = payload.serialLast6 || inventoryLabelSerialLast6(printBarcode, payload.companyUnitIndex || payload.unitIndex || 1);
    var warehouse = labelShortText(payload.warehouse, '未設定貨倉');
    if (payload.locationText) warehouse += ' · ' + payload.locationText;
    var qrMarkup = qrCodeSvg(printBarcode) || '<div class="qr-fallback"><b>QR</b><span>' + escapeHtml(printBarcode) + '</span></div>';
    var barcodeMarkup = code128Svg(linearScanKey) || '<div class="barcode-fallback">' + escapeHtml(linearScanKey) + '</div>';
    return [
      '<div class="label qr-label">',
      '<div class="info-line barcode-text-line"><b>產品條碼</b><span>' + escapeHtml(printBarcode) + '</span></div>',
      '<div class="info-line serial-line"><b>序號</b><span>SN:' + escapeHtml(serialLast6 || '-') + '</span><em>' + escapeHtml(warehouse) + '</em></div>',
      '<div class="info-line variant-line"><b>顏色＋尺寸</b><span>' + escapeHtml(payload.color || '-') + ' · ' + escapeHtml(payload.size || 'NO SIZE') + '</span></div>',
      '<div class="code-row">',
      '<div class="qr-area" aria-label="產品 QR Code">' + qrMarkup + '</div>',
      '<div class="barcode-area" aria-label="產品一維掃描碼 ' + escapeHtml(linearScanKey) + '">' + barcodeMarkup + '</div>',
      '</div>',
      '</div>'
    ].join('');
  }

