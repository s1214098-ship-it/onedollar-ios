      return;
    }
    var confirm = event.target.closest ? event.target.closest('[data-confirm-preorder-image-review]') : null;
    if (!confirm) return;
    var dialog = document.querySelector('[data-preorder-image-review-dialog]');
    var context = dialog && dialog._reviewContext;
    var product = (state.products || []).find(function (row) { return String(row.id || '') === String(confirm.getAttribute('data-confirm-preorder-image-review') || ''); });
    if (!context || !product) return;
    confirm.disabled = true;
    callStockInquiryApi({ action: 'review-preorder-item', inquiryId: context.inquiryId, itemIndex: context.itemIndex, productId: product.id || '', productCode: product.code || '', productTitle: product.title || product.name || '' }).then(function () {
      toast('已儲存圖片比對結果；尚未轉現貨、未扣庫存。');
      dialog.hidden = true;
      return loadStockInquiries().then(function (rows) { state.inquiries = rows; renderOrders(); });
    }).catch(function (error) {
      toast('儲存比對結果失敗：' + (error.message || error));
      confirm.disabled = false;
    });
  });

  if (!window.__lingzanzanInventoryClassificationEditorBound) {
    window.__lingzanzanInventoryClassificationEditorBound = true;
    document.addEventListener('change', function (event) {
      var departmentSelect = event.target && event.target.matches && event.target.matches('[data-inventory-classification-department]') ? event.target : null;
      if (!departmentSelect) return;
      var editor = departmentSelect.closest('[data-inventory-classification-editor]');
      populateInventoryClassificationCategoryOptions(editor, departmentSelect.value === 'computer' ? 'computer' : 'lingzanzan', '');
    });
    document.addEventListener('click', function (event) {
      var quickDepartmentButton = event.target && event.target.closest ? event.target.closest('[data-inventory-quick-department]') : null;
      if (quickDepartmentButton) {
        event.preventDefault();
        var quickProductId = String(quickDepartmentButton.getAttribute('data-product-id') || '');
        var quickDepartment = quickDepartmentButton.getAttribute('data-inventory-quick-department') === 'computer' ? 'computer' : 'lingzanzan';
        var quickUnit = quickDepartment === 'computer' ? 'baohui_computer' : 'lingzanzan';
        var quickProduct = (state.products || []).find(function (item) { return String(item.id || '') === quickProductId; });
        if (!quickProduct) {
          toast('找不到要指定部門的商品，請重新整理後再試');
          return;
        }
        var quickProductBefore = JSON.parse(JSON.stringify(quickProduct));
        var quickSkus = (state.skus || []).filter(function (sku) { return String(sku.productId || '') === quickProductId; });
        var quickSkusBefore = quickSkus.map(function (sku) { return JSON.parse(JSON.stringify(sku)); });
        quickProduct.department = quickDepartment;
        quickProduct.category_scope = quickDepartment;
        quickProduct.category_group = quickDepartment;
        quickProduct.inventoryBusinessUnit = quickUnit;
        quickProduct.updatedAt = new Date().toISOString();
        if (quickDepartment === 'computer') {
          quickProduct.showOnWebsite = false;
          quickProduct.storefrontManualHidden = true;
        }
        quickSkus.forEach(function (sku) {
          sku.department = quickDepartment;
          sku.category_scope = quickDepartment;
          sku.category_group = quickDepartment;
          sku.inventoryBusinessUnit = quickUnit;
          sku.updatedAt = new Date().toISOString();
          if (quickDepartment === 'computer') sku.showOnWebsite = false;
        });
        quickDepartmentButton.disabled = true;
        quickDepartmentButton.textContent = '儲存中…';
        saveLocal().then(function () {
          inventoryPage = 1;
          renderInventoryLines();
          toast('已將 ' + (quickProduct.code || quickProduct.id || '商品') + ' 指定為' + (quickDepartment === 'computer' ? '電腦部門' : '服裝部門') + '；條碼、庫存、照片與物流紀錄均保留');
        }).catch(function (error) {
          Object.keys(quickProduct).forEach(function (key) { delete quickProduct[key]; });
          Object.assign(quickProduct, quickProductBefore);
          quickSkus.forEach(function (sku, index) {
            Object.keys(sku).forEach(function (key) { delete sku[key]; });
            Object.assign(sku, quickSkusBefore[index] || {});
          });
          quickDepartmentButton.disabled = false;
          quickDepartmentButton.textContent = quickDepartment === 'computer' ? '設為電腦部門' : '設為服裝部門';
          toast((error && error.message) || '部門指定失敗');
        });
        return;
      }
      var summary = event.target && event.target.closest ? event.target.closest('summary') : null;
      var openingEditor = summary && summary.parentElement && summary.parentElement.matches('[data-inventory-classification-editor]') ? summary.parentElement : null;
      if (openingEditor) {
        var openingCategory = openingEditor.querySelector('[data-inventory-classification-category]');
        if (openingCategory && openingCategory.getAttribute('data-inventory-classification-options-ready') !== '1') {
          var openingDepartment = openingEditor.querySelector('[data-inventory-classification-department]')?.value === 'computer' ? 'computer' : 'lingzanzan';
          populateInventoryClassificationCategoryOptions(openingEditor, openingDepartment, String(openingCategory.value || '').trim());
        }
      }
      var button = event.target && event.target.closest ? event.target.closest('[data-inventory-classification-save]') : null;
      if (!button) return;
      event.preventDefault();
      var productId = String(button.getAttribute('data-inventory-classification-save') || '');
      var editor = button.closest('[data-inventory-classification-editor]');
      var product = (state.products || []).find(function (item) { return String(item.id || '') === productId; });
      if (!editor || !product) {
        toast('找不到要修改的商品，請重新整理後再試');
        return;
      }
      var department = editor.querySelector('[data-inventory-classification-department]')?.value === 'computer' ? 'computer' : 'lingzanzan';
      var category = String(editor.querySelector('[data-inventory-classification-category]')?.value || '').trim();
      if (!category) {
        toast('請先選擇商品分類');
        return;
      }
      var inventoryBusinessUnit = department === 'computer' ? 'baohui_computer' : 'lingzanzan';
      var productBefore = JSON.parse(JSON.stringify(product));
      var relatedSkus = (state.skus || []).filter(function (sku) { return String(sku.productId || '') === productId; });
      var skusBefore = relatedSkus.map(function (sku) { return JSON.parse(JSON.stringify(sku)); });
      product.department = department;
      product.category_scope = department;
      product.category_group = department;
      product.inventoryBusinessUnit = inventoryBusinessUnit;
      product.category = category;
      product.categoryName = category;
      if (department === 'computer') {
        product.showOnWebsite = false;
        product.storefrontManualHidden = true;
      }
      product.updatedAt = new Date().toISOString();
      relatedSkus.forEach(function (sku) {
        sku.department = department;
        sku.category_scope = department;
        sku.category_group = department;
        sku.inventoryBusinessUnit = inventoryBusinessUnit;
        sku.category = category;
        sku.categoryName = category;
        if (department === 'computer') sku.showOnWebsite = false;
        sku.updatedAt = new Date().toISOString();
      });
      button.disabled = true;
      button.textContent = '儲存中…';
      saveLocal().then(function () {
        renderInventoryLines();
        toast('已將 ' + (product.code || product.id || '商品') + ' 更新為' + (department === 'computer' ? '電腦部門（不在張張前台上架）' : '服裝部門') + '／' + category + '；條碼、庫存、物流照片與歷史均保留');
      }).catch(function (error) {
        Object.keys(product).forEach(function (key) { delete product[key]; });
        Object.assign(product, productBefore);
        relatedSkus.forEach(function (sku, index) {
          Object.keys(sku).forEach(function (key) { delete sku[key]; });
          Object.assign(sku, skusBefore[index] || {});
        });
        button.disabled = false;
        button.textContent = '儲存部門與分類';
        toast((error && error.message) || '部門與分類儲存失敗');
      });
    }, true);
  }

  var currentAdminFileName = location.pathname.split('/').pop() || 'admin.html';
  var inventoryPageActive = isInventoryPageFile(currentAdminFileName);
  var needsCatalogData = adminNeedsCatalogData();
  var needsCustomerData = ['admin.html', 'admin-orders.html'].indexOf(currentAdminFileName) !== -1 || !!document.querySelector('[data-member-list], [data-manual-preorder-form]');
  if (document.body) document.body.setAttribute('data-inventory-main-before-bootstrap', 'true');
  loadLocal();
  if (document.body) document.body.setAttribute('data-inventory-main-after-local', 'true');
  bootstrapInventoryCatalog();
  installAppNavigationButtons();
  bindLogin();
  loadAuthState().catch(function () {
    return ensureDefaultPassword();
  }).then(function () {
    bindLogin();
    renderLoginIdentity();
    return loadServerState({ includeCatalog: needsCatalogData, includeCustomers: needsCustomerData });
  }).then(function (serverFiles) {
    return loadAdminDataFiles(serverFiles, { reuseEmbeddedCatalog: inventoryPageActive });
  }).then(function (items) {
    applyAdminDataItems(items);
    importCustomersToMembersIfNeeded();
    
    if (inventoryPageActive) {
      renderInventoryLines();
      renderLoginIdentity();
    } else {
      renderAll();
      renderProductCreate();
    }
    loadFreightTracking();
    bindActions();
    installOperationalPatches();
    startAdminAutoSync();
    setTimeout(scrollManualPreorderFromHash, 180);
  }).catch(function () {
    
    if (inventoryPageActive) {
      renderInventoryLines();
      renderLoginIdentity();
    } else {
      renderAll();
      renderProductCreate();
    }
    loadFreightTracking();
    bindActions();
    installOperationalPatches();
    startAdminAutoSync();
    setTimeout(scrollManualPreorderFromHash, 180);
    toast('部分 NAS JSON 尚未讀取，請確認 data 資料夾');
  });
})();
