  function loadOrderPriceMemory() {
    if (orderPriceMemory) return orderPriceMemory;
    try {
      orderPriceMemory = JSON.parse(localStorage.getItem(ORDER_PRICE_MEMORY_KEY) || '{}') || {};
    } catch (error) {
      orderPriceMemory = {};
    }
    return orderPriceMemory;
  }

  function saveOrderPriceMemory() {
    try {
      localStorage.setItem(ORDER_PRICE_MEMORY_KEY, JSON.stringify(loadOrderPriceMemory()));
    } catch (error) {}
  }

  function orderPriceMemoryKeys(product, sku) {
    product = product || {};
    sku = sku || {};
    return [
      sku.id || '',
      sku.sku || '',
      product.id || '',
      product.code || '',
      product.productLine || ''
    ].filter(Boolean).map(function (value) { return String(value).trim().toLowerCase(); });
  }

  function rememberedOrderPrice(product, sku) {
    var memory = loadOrderPriceMemory();
    var keys = orderPriceMemoryKeys(product, sku);
    for (var i = 0; i < keys.length; i += 1) {
      if (memory[keys[i]]) return memory[keys[i]];
    }
    return {};
  }

  // The label barcode must follow the latest confirmed receiving/table cost,
  // not the historical cost embedded in an older barcode.
  function currentLabelCostValue(value) {
    if (value === undefined || value === null || value === '') return null;
    var number = Number(value);
    return Number.isFinite(number) && number > 0 ? number : null;
  }

  function firstLabelCostValue(values) {
    for (var i = 0; i < values.length; i += 1) {
      var value = currentLabelCostValue(values[i]);
      if (value !== null) return value;
    }
    return null;
  }

  function labelCostTimestamp(record, keys) {
    record = record || {};
    for (var i = 0; i < keys.length; i += 1) {
      var value = String(record[keys[i]] || '').trim();
      var time = Date.parse(value);
      if (value && Number.isFinite(time)) return { value: value, time: time };
    }
    return { value: '', time: 0 };
  }

  function datedLabelCost(record, valueKey, timestampKeys, source) {
    record = record || {};
    var cost = currentLabelCostValue(record[valueKey]);
    var timestamp = labelCostTimestamp(record, timestampKeys);
    if (cost === null || !timestamp.time) return null;
    return { cost: cost, hasCost: true, source: source, effectiveAt: timestamp.value, time: timestamp.time };
  }

  function latestLabelCostInfo(product, sku) {
    product = product || {};
    sku = sku || {};
    var dated = [
      datedLabelCost(sku, 'currentCostTwd', ['currentCostUpdatedAt', 'costEffectiveAt'], String(sku.costSource || 'sku-current')),
      datedLabelCost(sku, 'cost', ['costUpdatedAt', 'costEffectiveAt'], String(sku.costSource || 'sku-cost')),
      datedLabelCost(sku, 'freightFinalCostTwd', ['freightCostUpdatedAt'], String(sku.freightCostSource || 'sku-freight')),
      datedLabelCost(sku, 'finalCostTwd', ['finalCostUpdatedAt'], String(sku.costSource || sku.freightCostSource || 'sku-final')),
      datedLabelCost(sku, 'purchaseCost', ['purchaseCostUpdatedAt'], String(sku.costSource || 'sku-purchase')),
      datedLabelCost(product, 'currentCostTwd', ['currentCostUpdatedAt', 'costEffectiveAt'], String(product.costSource || 'product-current')),
      datedLabelCost(product, 'cost', ['costUpdatedAt', 'costEffectiveAt'], String(product.costSource || 'product-cost')),
      datedLabelCost(product, 'freightFinalCostTwd', ['freightCostUpdatedAt'], String(product.freightCostSource || product.costSource || 'product-freight')),
      datedLabelCost(product, 'finalCostTwd', ['finalCostUpdatedAt'], String(product.costSource || product.freightCostSource || 'product-final')),
      datedLabelCost(product, 'purchaseCost', ['purchaseCostUpdatedAt'], String(product.costSource || 'product-purchase'))
    ].filter(Boolean).sort(function (a, b) { return b.time - a.time; });
    if (dated.length) return dated[0];
    var productCost = firstLabelCostValue([product.currentCostTwd, product.cost, product.finalCostTwd, product.purchaseCost]);
    if (productCost !== null) return { cost: productCost, hasCost: true, source: String(product.costSource || 'product-master'), effectiveAt: '' };
    var skuCost = firstLabelCostValue([sku.currentCostTwd, sku.cost, sku.finalCostTwd, sku.purchaseCost]);
    if (skuCost !== null) return { cost: skuCost, hasCost: true, source: String(sku.costSource || 'sku-fallback'), effectiveAt: '' };
    return { cost: 0, hasCost: false, source: 'missing', effectiveAt: '' };
  }

  function rememberOrderPrice(product, sku, price, cost) {
    var memory = loadOrderPriceMemory();
    var record = {};
    if (price !== undefined && price !== null && price !== '') record.price = Number(price || 0);
    if (cost !== undefined && cost !== null && cost !== '') record.cost = Number(cost || 0);
    orderPriceMemoryKeys(product, sku).forEach(function (key) {
      memory[key] = Object.assign({}, memory[key] || {}, record, { updatedAt: new Date().toISOString() });
    });
    if (product && record.price !== undefined) product.price = record.price;
    if (sku && record.price !== undefined) sku.price = record.price;
    if (product && record.cost !== undefined) product.cost = record.cost;
    if (sku && record.cost !== undefined) sku.cost = record.cost;
    saveOrderPriceMemory();
  }

