  function adminShipmentOpenMergeCandidates() {
    var form = document.querySelector('[data-admin-shipment-form]');
    if (!form) return [];
    var name = String((form.querySelector('[data-admin-shipment-name]') || {}).value || '').trim().toLowerCase();
    var phone = adminManualPhoneDigits((form.querySelector('[data-admin-shipment-phone]') || {}).value || '');
    if (!name && phone.length < 6) return [];
    return (state.orders || []).filter(function (order) {
      var customer = order.customer || {};
      var orderName = String(customer.name || '').trim().toLowerCase();
      var orderPhone = adminManualPhoneDigits(customer.phone || '');
      var status = String(order.status || '').toLowerCase();
      var open = ['delivered', 'completed', 'returned', 'cancelled'].indexOf(status) === -1;
