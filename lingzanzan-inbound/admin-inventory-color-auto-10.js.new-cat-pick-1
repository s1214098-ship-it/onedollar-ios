  function preorderInquiryMatches(row, query, salesFilter, statusFilter, typeFilter) {
    var customer = row.customer || {};
    var items = Array.isArray(row.items) ? row.items : [];
    var salesName = row.salesName || row.sales || '未指定';
    var normalizedQuery = String(query || '').trim().toLowerCase();
    var text = [
      row.id,
      row.statusLabel,
      row.orderTypeLabel,
      row.preorderWarehouseLabel,
      row.purchaseStatus,
      row.purchaseStatusLabel,
      customer.name,
      customer.phone,
      customer.note,
      salesName,
      items.map(function (item) { return [item.code, item.sku, item.skuId, item.barcode, item.title, item.color, item.size].join(' '); }).join(' ')
    ].join(' ').toLowerCase();
    var purchaseStatus = row.purchaseStatus || 'not_ordered';
    var preorderStatus = row.status || 'preorder_pending';
    var converted = !!(row.convertedOrderId || row.preorderConvertedAt || row.convertedAt);
    var purchaseFilters = ['not_ordered', 'ordered', 'preparing', 'arrived', 'shipped', 'ready_to_ship', 'completed'];
    var statusMatches = statusFilter === 'all' ||
      preorderStatus === statusFilter ||
      purchaseStatus === statusFilter ||
      (statusFilter === 'converted' && converted) ||
      (statusFilter === 'preorder_pending' && preorderStatus === 'preorder_pending' && !converted);
    return (!normalizedQuery || text.indexOf(normalizedQuery) !== -1) &&
      (salesFilter === 'all' || salesName === salesFilter) &&
      (typeFilter === 'all' || typeFilter === 'preorder') &&
      (purchaseFilters.indexOf(statusFilter) === -1 ? statusMatches : purchaseStatus === statusFilter);
  }

  function preorderPaginationHtml(total, page, totalPages) {
    if (total <= PREORDER_PAGE_SIZE) return '';
    return [
      '<nav class="preorder-pager" data-preorder-pager>',
      '<button type="button" data-preorder-page="' + Math.max(1, page - 1) + '"' + (page <= 1 ? ' disabled' : '') + '>上一頁</button>',
      '<span>第 ' + page + ' / ' + totalPages + ' 頁，每頁 ' + PREORDER_PAGE_SIZE + ' 筆，共 ' + total + ' 筆</span>',
      '<button type="button" data-preorder-page="' + Math.min(totalPages, page + 1) + '"' + (page >= totalPages ? ' disabled' : '') + '>下一頁</button>',
      '</nav>'
    ].join('');
  }

  function directPurchaseRows() {
    var rows = Array.isArray(state.inquiries) ? state.inquiries : [];
    return rows.filter(function (row) {
      if (!row) return false;
      if (!(row.orderType === 'preorder' || row.status === 'preorder_pending')) return false;
      if (row.status === 'cancelled' || row.status === 'converted') return false;
      if (row.orderId || row.convertedOrderId || row.formalOrderId || row.convertedAt || row.preorderConvertedAt) return false;
      return true;
    });
  }

  function renderDirectPurchaseList() {
    var list = document.querySelector('[data-purchase-page] [data-admin-orders]');
    if (!list) return false;
    var query = String(document.querySelector('[data-order-search]')?.value || '').trim().toLowerCase();
    var salesFilter = document.querySelector('[data-order-sales-filter]')?.value || 'all';
    var statusFilter = document.querySelector('[data-order-status-filter]')?.value || 'all';
    var baseRows = directPurchaseRows();
    var rows = baseRows.filter(function (row) {
      return preorderInquiryMatches(row, query, salesFilter, statusFilter, 'preorder');
    });
    if (!rows.length && !query && salesFilter === 'all' && statusFilter === 'all') rows = baseRows.slice();
    updatePreorderSummary(baseRows);
    var total = rows.length;
    var pages = Math.max(1, Math.ceil(total / PREORDER_PAGE_SIZE));
    preorderListPage = Math.min(Math.max(1, preorderListPage), pages);
    var start = (preorderListPage - 1) * PREORDER_PAGE_SIZE;
    var pageRows = rows.slice(start, start + PREORDER_PAGE_SIZE);
    var pager = preorderPaginationHtml(total, preorderListPage, pages);
    var pagerHost = document.querySelector('[data-preorder-pager-host]');
    if (pagerHost) pagerHost.innerHTML = pager;
    list.innerHTML = total ? pageRows.map(renderPreorderInquiryCard).join('') : '<div class="empty">目前沒有符合條件的預購訂單。</div>';
    renderPreorderSelectionSummary();
    return true;
