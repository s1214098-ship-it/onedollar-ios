  function renderAuditAdminOptions() {
    var select = document.querySelector('[data-error-admin]');
    if (!select) return;
    var current = select.value;
    select.innerHTML = adminNames().map(function (name) {
      return '<option value="' + escapeHtml(name) + '">' + escapeHtml(name) + '</option>';
    }).join('');
    if (current) select.value = current;
  }

  function renderErrorStats() {
    var target = document.querySelector('[data-error-stats]');
    if (!target) return;
    var reports = state.errorReports || [];
    var rows = adminNames().map(function (name) {
      var mine = reports.filter(function (item) { return item.adminName === name; });
      var confirmed = mine.filter(function (item) { return item.status === 'confirmed' || item.status === 'fixed'; }).length;
      var pending = mine.filter(function (item) { return !item.status || item.status === 'pending'; }).length;
      var rejected = mine.filter(function (item) { return item.status === 'rejected'; }).length;
      var rate = mine.length ? Math.round((confirmed / mine.length) * 1000) / 10 : 0;
      return [
        '<article>',
        '<b>' + escapeHtml(name) + '</b>',
        '<span>回報 ' + mine.length + ' 筆</span>',
        '<span>已確認 ' + confirmed + ' 筆</span>',
        '<span>待確認 ' + pending + ' 筆</span>',
        '<span>不成立 ' + rejected + ' 筆</span>',
        '<strong>' + rate + '%</strong>',
        '</article>'
      ].join('');
    });
    target.innerHTML = rows.join('') || '<div class="empty">尚無錯誤回報統計。</div>';
  }

  function renderErrorReports() {
    renderAuditAdminOptions();
    renderErrorStats();
    var target = document.querySelector('[data-error-list]');
    if (!target) return;
    var reports = (state.errorReports || []).slice().sort(function (a, b) {
      return String(b.createdAt || '').localeCompare(String(a.createdAt || ''));
    });
    target.innerHTML = reports.slice(0, 80).map(function (item) {
      var images = (item.images || []).slice(0, 4).map(function (src) {
        return '<img src="' + escapeHtml(src) + '" alt="錯誤證據">';
      }).join('');
      var status = item.status || 'pending';
      return [
        '<article class="audit-card">',
        '<header><b>' + escapeHtml(item.type || '其他') + '</b><span>' + reportStatusLabel(status) + '</span></header>',
        '<p>' + escapeHtml(item.reference || '-') + '</p>',
        '<p>責任行政：' + escapeHtml(item.adminName || '未指定') + ' / 回報人：' + escapeHtml(item.reporterName || '-') + '</p>',
        item.note ? '<p>' + escapeHtml(item.note) + '</p>' : '',
        images ? '<div class="audit-images">' + images + '</div>' : '',
        '<footer>',
        '<small>' + escapeHtml((item.createdAt || '').slice(0, 16).replace('T', ' ')) + '</small>',
        '<button type="button" data-error-status="' + escapeHtml(item.id) + '" data-status-value="confirmed">確認錯誤</button>',
        '<button type="button" data-error-status="' + escapeHtml(item.id) + '" data-status-value="fixed">已修正</button>',
        '<button type="button" data-error-status="' + escapeHtml(item.id) + '" data-status-value="rejected">不成立</button>',
        '</footer>',
        '</article>'
      ].join('');
