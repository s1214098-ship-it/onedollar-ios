      return refreshPreorderAfterBulk('已批次更新 ' + ids.length + ' 筆採購狀態');
    }).catch(function (error) {
      toast('批次更新失敗：' + (error.message || error));
    });
  }

  function deleteSelectedPreorders() {
    var ids = selectedPreorderIds();
    if (!ids.length) {
      toast('請先勾選要刪除的預購單');
      return;
    }
    if (!window.confirm('確定刪除已選 ' + ids.length + ' 筆預購單嗎？刪除後採購區與預購區都不會再顯示。')) return;
    Promise.all(ids.map(function (id) {
      return callStockInquiryApi({ action: 'delete', inquiryId: id });
    })).then(function () {
      var selected = ensurePreorderSelectionSet();
      ids.forEach(function (id) { selected.delete(id); });
