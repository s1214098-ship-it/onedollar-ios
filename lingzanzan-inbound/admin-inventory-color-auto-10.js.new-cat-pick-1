      values.forEach(function (value) { if (shelves.indexOf(value) === -1) shelves.push(value); });
    });
    if (!shelves.length) shelves = asList(product.shelves);
    if (!shelves.length && product.shelf) shelves = [product.shelf];
    var layers = [];
