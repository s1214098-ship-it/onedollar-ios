      toast('請先勾選預購單');
      return;
    }
    var statusInput = document.querySelector('[data-preorder-bulk-status]');
    var status = statusInput ? statusInput.value : 'preparing';
    if (!window.confirm('確定把已選 ' + ids.length + ' 筆預購改成「' + preorderPurchaseStatusLabel(status) + '」嗎？')) return;
    Promise.all(ids.map(function (id) {
      return callStockInquiryApi({
        action: 'update-preorder-meta',
        inquiryId: id,
        purchaseStatus: status,
        purchaseNote: (document.querySelector('[data-preorder-purchase-note="' + CSS.escape(id) + '"]') || {}).value || ''
