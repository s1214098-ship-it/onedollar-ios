  function orderDeliveryState(order) {
    if (order.deliveryState) return order.deliveryState;
    if (order.status === 'delivered' || order.status === 'completed') return 'delivered';
    if (order.status === 'returned' || order.status === 'cancelled') return 'returned';
    if (order.trackingNo || order.status === 'shipped' || order.status === 'in_transit') return 'in_transit';
    return 'pending';
