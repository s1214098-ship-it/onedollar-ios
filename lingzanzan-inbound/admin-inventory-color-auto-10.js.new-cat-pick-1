  function openInventoryBarcodePrint(payload) {
    if (!payload || !payload.barcode) {
      toast('這個 SKU 沒有條碼可列印');
      return;
    }
    var copies = Number(prompt('要列印幾張這個條碼？', '1') || 1);
    if (!Number.isFinite(copies) || copies < 1) copies = 1;
    copies = Math.min(99, Math.floor(copies));
    var labelOne = inventoryBarcodeLabelHtml(payload);
    var labels = Array.from({ length: copies }).map(function () { return labelOne; }).join('');
    showInventoryBarcodePrintOverlay(inventoryBarcodePrintDocument(labels, 'Print QR Label ' + payload.barcode), 'LINGZANZAN-qr-label-' + String(payload.barcode || 'label') + '.html');
  }

  function openInventoryBarcodeBatchPrint(payloads) {
    payloads = Array.isArray(payloads) ? payloads.filter(function (item) { return item && item.barcode; }) : [];
    if (!payloads.length) {
      toast('這個顏色沒有可列印的條碼');
      return;
    }
    var copies = Number(prompt('這個顏色每個尺寸要列印幾張？', '1') || 1);
    if (!Number.isFinite(copies) || copies < 1) copies = 1;
    copies = Math.min(99, Math.floor(copies));
    var labels = [];
    payloads.forEach(function (payload) {
      for (var i = 0; i < copies; i += 1) labels.push(inventoryBarcodeLabelHtml(payload));
    });
    showInventoryBarcodePrintOverlay(inventoryBarcodePrintDocument(labels.join(''), 'Print QR Label Group'), 'LINGZANZAN-qr-label-labels.html');
  }

  function openInventoryBarcodeSelectionPrint(selections) {
    selections = Array.isArray(selections) ? selections.filter(function (entry) {
      return entry && entry.payload && entry.payload.barcode && Number(entry.copies || 0) > 0;
    }) : [];
    if (!selections.length) {
      toast('請先勾選要列印的顏色與尺寸');
      return;
    }
    var labels = [];
    selections.forEach(function (entry) {
      var copies = Math.min(99, Math.max(1, Math.floor(Number(entry.copies || 1))));
      for (var index = 0; index < copies; index += 1) labels.push(inventoryBarcodeLabelHtml(entry.payload));
    });
    showInventoryBarcodePrintOverlay(inventoryBarcodePrintDocument(labels.join(''), 'Print Selected QR Labels'), 'LINGZANZAN-qr-label-selected.html');
