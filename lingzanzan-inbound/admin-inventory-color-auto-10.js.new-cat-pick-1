  function logisticsRecipientMatches(order, row) {
    var customer = (order && order.customer) || {};
    var phone = String(customer.phone || '').replace(/\D+/g, '');
    var name = String(customer.name || '').trim().toLowerCase();
    var rowPhone = String((row && row.phone) || '').replace(/\D+/g, '');
    var rowName = String((row && row.name) || '').trim().toLowerCase();
    var phoneOk = phone && rowPhone && (phone === rowPhone || phone.slice(-6) === rowPhone.slice(-6));
    var nameOk = name && rowName && (rowName.indexOf(name) !== -1 || name.indexOf(rowName) !== -1);
    return !!(phoneOk || nameOk);
  }

  function pickLogisticsNo(row, wantedNo) {
    var wanted = normalizeLogisticsNo(wantedNo || '');
    var list = logisticsNos(row);
    if (!wanted) return list[0] || '';
    return list.find(function (no) { return normalizeLogisticsNo(no) === wanted; }) || list[0] || wantedNo || '';
  }

  function reportReference(row) {
    return [row.id, row.name, row.phone, logisticsNo(row)].filter(Boolean).join(' / ');
  }

  function adminNames() {
    var names = (state.staff || []).filter(function (person) {
      return !person.role || String(person.role).indexOf('行政') !== -1;
    }).map(function (person) {
      return person.name || person.account || '';
    }).filter(Boolean);
    (state.errorReports || []).forEach(function (item) {
      if (item.adminName && names.indexOf(item.adminName) === -1) names.push(item.adminName);
