  function pendingProductFreightContext(product) {
    product = product || {};
    var records = normalizeProductLogisticsRecords(product.purchaseLogistics || product.logisticsRecords || []);
    var topTrackingNo = String(product.costTrackingNo || product.freightTrackingNo || '').trim();
    var topItemId = String(product.freightItemId || product.costFreightItemId || '').trim();
    var topBatchId = String(product.freightBatchId || product.costBatchId || '').trim();
    function recordValue(row, fields) {
      for (var index = 0; index < fields.length; index += 1) {
        var value = String(row && row[fields[index]] || '').trim();
        if (value) return value;
      }
      return '';
    }
    function recordMatchesTop(row) {
      if (topTrackingNo && recordValue(row, ['trackingNo', 'costTrackingNo', 'freightTrackingNo']) !== topTrackingNo) return false;
      if (topItemId && recordValue(row, ['freightItemId', 'costFreightItemId']) !== topItemId) return false;
      if (topBatchId && recordValue(row, ['freightBatchId', 'costBatchId']) !== topBatchId) return false;
      return !!(topTrackingNo || topItemId || topBatchId);
    }
    var linkedRecord = records.find(recordMatchesTop);
    if (!linkedRecord && !(topTrackingNo || topItemId || topBatchId)) {
      linkedRecord = records.slice().sort(function (a, b) {
        function score(row) {
          return (recordValue(row, ['freightBatchId', 'costBatchId']) ? 8 : 0) +
            (recordValue(row, ['trackingNo', 'costTrackingNo', 'freightTrackingNo']) ? 4 : 0) +
            (recordValue(row, ['freightItemId', 'costFreightItemId']) ? 2 : 0) +
            (recordValue(row, ['customsNo']) ? 1 : 0);
        }
        var scoreDiff = score(b) - score(a);
        if (scoreDiff) return scoreDiff;
        return String(b.updatedAt || b.date || b.createdAt || '').localeCompare(String(a.updatedAt || a.date || a.createdAt || ''));
      })[0];
    }
    linkedRecord = linkedRecord || {};
    var trackingNo = topTrackingNo || recordValue(linkedRecord, ['trackingNo', 'costTrackingNo', 'freightTrackingNo']);
    var itemId = topItemId || recordValue(linkedRecord, ['freightItemId', 'costFreightItemId']);
    var batchId = topBatchId || recordValue(linkedRecord, ['freightBatchId', 'costBatchId']);
    return {
      linked: !!(trackingNo || itemId || batchId),
      batchId: batchId,
      source: String(product.freightSource || product.logisticsSource || linkedRecord.freightSource || linkedRecord.logisticsSource || 'pinduoduo'),
      destinationWarehouse: String(product.costDestinationWarehouse || product.destinationWarehouse || linkedRecord.costDestinationWarehouse || linkedRecord.destinationWarehouse || ''),
      customsNo: String(product.customsNo || linkedRecord.customsNo || '').trim()
    };
  }

  function pendingProductFreightSaveError(product) {
    var context = pendingProductFreightContext(product);
    if (!context.linked) return '';
    if (!context.batchId) return '這筆商品帶有物流單號，但尚未對應物流批號；請先帶入物流批次。';
    var destination = context.destinationWarehouse.toUpperCase();
    var isDongguan = destination === 'CN_DONGGUAN' || destination.indexOf('東莞') !== -1;
    if (context.source === 'pinduoduo' && !isDongguan && !context.customsNo) return '這筆是拼多多／寶輝物流商品，請先選擇對應關稅／台灣快遞紀錄。';
    return '';
  }

