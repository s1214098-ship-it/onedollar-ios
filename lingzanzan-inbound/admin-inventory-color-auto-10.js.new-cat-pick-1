  function adminShipmentBuildItem(row, qty, priceOverride) {
    var memory = rememberedOrderPrice(row.product, row.sku);
    var price = Math.max(0, Number(priceOverride !== undefined ? priceOverride : ((document.querySelector('[data-admin-shipment-price]') || {}).value || memory.price || row.sku.price || row.product.price || 0)));
    rememberOrderPrice(row.product, row.sku, price, row.sku.cost || row.product.cost || '');
    return {
      skuId: row.sku.id || row.sku.sku || '',
      sku: row.sku.sku || row.sku.id || '',
      barcode: row.sku.barcode || row.sku.companyBarcode || '',
      productId: row.product.id || '',
      code: row.product.code || row.product.productLine || row.product.id || '',
