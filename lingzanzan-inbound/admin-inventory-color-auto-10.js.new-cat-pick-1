  function refreshProductImportedCost() {
    var source = productFreightSource();
    var rmb = Number(document.querySelector('[data-new-product-cost-rmb]')?.value || 0);
    var weightKg = Math.max(0, Number(document.querySelector('[data-new-product-weight-kg]')?.value || 0));
    var customsNo = String(document.querySelector('[data-new-product-customs-no]')?.value || '').trim();
    var platform = document.querySelector('[data-product-logistics-platform]')?.value || '';
    var batch = recentFreightBatchesForSelection(platform, '').filter(function (row) {
      return freightBatchMatchesSource(row, source);
    }).find(function (row) {
      return [row.batchNo, row.customsNo, row.consolidationNo, row.logisticsTrackingNo, row.taiwanTrackingNo].some(function (value) { return String(value || '') === customsNo; });
    }) || null;
    var batchAllocation = Number(batch ? freightAllocationTwd(batch) : 0);
    var allocation = source === 'pinduoduo' ? (batch ? batchAllocation : Number(document.querySelector('[data-new-product-customs-allocation]')?.value || 0)) : 0;
    var freight = source === 'haohong' ? (batch && batch.costMode === 'haohong_weight' && Number(batch.amount || 0) <= 0 ? Math.round(weightKg * 8 * 5) : batchAllocation) : 0;
    var allocationInput = document.querySelector('[data-new-product-customs-allocation]');
    var freightInput = document.querySelector('[data-new-product-freight-twd]');
    if (allocationInput) allocationInput.value = Math.round(allocation);
    if (freightInput) freightInput.value = Math.round(freight);
    applyProductFreightSourceMode();
    var finalInput = document.querySelector('[data-new-product-final-cost]');
    var costInput = document.querySelector('[data-new-product-cost]');
    if (!rmb) return;
    var finalCost = Math.round((rmb * 5) + allocation + freight);
    if (finalInput) finalInput.value = finalCost;
    if (costInput) {
      costInput.value = finalCost;
      updateVariantPricesFromBase('cost');
    }
  }

