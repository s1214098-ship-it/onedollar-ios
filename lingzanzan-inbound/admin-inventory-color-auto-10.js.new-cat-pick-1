  function renderProductLogisticsEditor() {
    var list = document.querySelector('[data-product-logistics-list]');
    var dateInput = document.querySelector('[data-product-logistics-date]');
    syncProductLogisticsPlatformOptions();
    if (dateInput && !dateInput.value) dateInput.value = formatInputDate(new Date());
    if (!list) return;
    var records = normalizeProductLogisticsRecords(productDraft.purchaseLogistics);
    productDraft.purchaseLogistics = records;
    if (!records.length) {
      list.innerHTML = '<div class="product-logistics-empty">尚未加入物流單號。可記錄掏寶/拼多多平台、海關單號、處理進度。</div>';
      return;
    }
    var recordRows = records.map(function (item, index) {
      return { item: item, index: index };
    }).sort(function (a, b) {
      var aTime = Date.parse(a.item.createdAt || a.item.date || '') || 0;
      var bTime = Date.parse(b.item.createdAt || b.item.date || '') || 0;
      return bTime - aTime;
    });
    list.innerHTML = recordRows.map(function (row) {
      var item = row.item;
      var index = row.index;
      return [
        '<article class="product-logistics-row">',
        '<time><span>物流建檔日期</span><b>' + escapeHtml(item.date || '-') + '</b></time>',
        '<div class="product-logistics-record"><span>物流紀錄</span><b>' + escapeHtml(item.trackingNo || '未填單號') + '</b><small>' + escapeHtml(item.progress || '未填進度') + '</small>' + (item.note ? '<em>' + escapeHtml(item.note) + '</em>' : '<em>無備註</em>') + '</div>',
