  function zhLayerName(value) {
    var names = ['零', '一', '二', '三', '四', '五', '六', '七', '八', '九', '十'];
    var n = Number(value);
    if (!Number.isFinite(n)) return value;
    return '第' + (names[n] || n) + '層';
  }

  function expandEntries(value, mode) {
    var clean = String(value || '').trim();
    if (!clean) return [];
    var letterRange = clean.match(/^([A-Za-z])\s*-\s*([A-Za-z])$/);
    if (letterRange) {
      var start = letterRange[1].toUpperCase().charCodeAt(0);
      var end = letterRange[2].toUpperCase().charCodeAt(0);
      var min = Math.min(start, end);
      var max = Math.max(start, end);
      var letters = [];
      for (var code = min; code <= max; code += 1) letters.push(String.fromCharCode(code) + '架');
      return letters;
    }
    var numberRange = clean.match(/^(\d+)\s*-\s*(\d+)$/);
    if (numberRange) {
      var a = Number(numberRange[1]);
      var b = Number(numberRange[2]);
      var from = Math.min(a, b);
      var to = Math.max(a, b);
      var nums = [];
      for (var i = from; i <= to; i += 1) nums.push(mode === 'layer' ? zhLayerName(i) : String(i));
      return nums;
    }
    return clean.split(/[,，、\n\/]+/).map(function (item) {
      return item.trim();
    }).filter(Boolean).map(function (item) {
      if (mode === 'layer' && /^\d+$/.test(item)) return zhLayerName(item);
      return item;
    });
  }

