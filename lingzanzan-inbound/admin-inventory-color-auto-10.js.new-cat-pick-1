  function savePendingStockReview(card) {
    if (!card) return;
    var pendingId = card.getAttribute('data-pending-stock-review-card') || '';
    var item = (state.pendingStockItems || []).find(function (row) { return String(row.id || '') === String(pendingId); });
    var button = card.querySelector('[data-pending-stock-review-save]');
    if (!item) {
      setPendingStockReviewStatus(card, '無法儲存：找不到這筆待整理資料，請重新整理。', 'error');
      return;
    }
    var product = (state.products || []).find(function (row) { return String(row.id || '') === String(item.productId || ''); });
    if (!product) {
      setPendingStockReviewStatus(card, '無法儲存：找不到對應產品資料，請先到產品管理確認。', 'error');
      return;
    }
    var category = String(card.querySelector('[data-pending-stock-review-category-custom]')?.value || card.querySelector('[data-pending-stock-review-category]')?.value || '').trim();
    if (!category || category === '待判別產品' || category === '快速入庫待補') {
      setPendingStockReviewStatus(card, '無法儲存：請先選擇或輸入正式產品分類。', 'error');
      return;
    }
    var draft = pendingStockReviewDrafts[pendingId] || {};
    var images = Array.isArray(draft.images) ? draft.images.filter(Boolean) : [];
    var existingImage = item.image || product.mainImage || '';
    if (!images.length && (!existingImage || String(existingImage).indexOf('brand-logo.png') !== -1)) {
      setPendingStockReviewStatus(card, '無法儲存：請先補圖片、貼上截圖或使用剪刀截圖。', 'error');
      return;
    }
    var freightError = pendingProductFreightSaveError(product);
    if (freightError) {
      setPendingStockReviewStatus(card, '無法儲存：' + freightError, 'error');
      return;
    }
    var beforeItem = JSON.parse(JSON.stringify(item));
    var beforeProduct = JSON.parse(JSON.stringify(product));
    var beforeCategories = (state.categories || []).slice();
    var relatedSkus = (state.skus || []).filter(function (sku) { return String(sku.productId || '') === String(product.id || ''); });
    var beforeSkus = relatedSkus.map(function (sku) { return JSON.parse(JSON.stringify(sku)); });
    var image = images[0] || existingImage;
    item.category = category;
    item.image = image;
    item.status = '已完成整理';
    item.updatedAt = new Date().toISOString();
    item.logs = item.logs || [];
    item.logs.push({ at: new Date().toISOString(), by: currentLogin().name || currentLogin().account || '管理者', action: '補圖片並改分類為 ' + category });
    product.category = category;
    product.title = String(product.title || '').replace(/^\s*待補資料商品\s*/u, '').trim() || product.code || product.id;
    product.mainImage = image;
    product.images = Array.from(new Set(images.concat(product.images || []).filter(Boolean)));
    var itemColor = String(item.colorName || '').trim();
    product.colors = (product.colors || []).map(function (color, index) {
      var colorName = String(color.name || color.color || '').trim();
      return Object.assign({}, color, { image: (!itemColor ? index === 0 : colorName === itemColor) ? image : (color.image || '') });
    });
    product.pendingStockItem = false;
    product.updatedAt = new Date().toISOString();
    relatedSkus.forEach(function (sku) {
      sku.pendingStockItem = false;
      sku.status = sku.status === 'pending_info' ? 'active' : sku.status;
      var skuColor = String(sku.colorName || sku.color || '').trim();
      if (!itemColor || skuColor === itemColor || relatedSkus.length === 1) sku.colorImage = image;
      sku.updatedAt = new Date().toISOString();
    });
    state.categories = state.categories || [];
    if (state.categories.indexOf(category) === -1) state.categories.push(category);
    card.classList.add('is-saving');
    if (button) { button.disabled = true; button.textContent = '儲存中…'; }
    setPendingStockReviewStatus(card, '正在儲存圖片與分類到 NAS…', '');
    saveLocal().then(function () {
      delete pendingStockReviewDrafts[pendingId];
      try {
        renderAll();
        toast('待整理商品已儲存' + (pendingProductFreightContext(product).linked ? '；物流資料已通過檢查' : '；純快速入庫不需物流或關稅資料'));
      } catch (renderError) {
        console.error(renderError);
        toast('資料已儲存，但畫面更新失敗；請重新整理頁面確認。');
      }
    }, function (error) {
      Object.keys(item).forEach(function (key) { delete item[key]; });
      Object.assign(item, beforeItem);
      Object.keys(product).forEach(function (key) { delete product[key]; });
      Object.assign(product, beforeProduct);
      relatedSkus.forEach(function (sku, index) {
        Object.keys(sku).forEach(function (key) { delete sku[key]; });
        Object.assign(sku, beforeSkus[index] || {});
      });
      state.categories = beforeCategories;
      card.classList.remove('is-saving');
      if (button) { button.disabled = false; button.textContent = '儲存本筆'; }
      setPendingStockReviewStatus(card, '無法儲存：' + (error && error.message ? error.message : String(error || '未知錯誤')), 'error');
    });
  }

