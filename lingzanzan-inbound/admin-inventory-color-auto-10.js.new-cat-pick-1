  function inventoryCardCostFromBarcode(product, skuCost) {
    var candidates = [];
    [skuCost, product].forEach(function (row) {
      if (!row) return;
      ['legacyBarcode', 'companyBarcode', 'officialBarcode', 'mappingCode', 'labelBarcode', 'barcode'].forEach(function (key) {
        var value = String(row[key] || '').trim();
        if (value) candidates.push(value);
      });
      if (Array.isArray(row.linkedBarcodes)) {
        row.linkedBarcodes.forEach(function (value) {
          value = String(value || '').trim();
          if (value) candidates.push(value);
        });
      }
    });
    for (var i = 0; i < candidates.length; i += 1) {
      try {
        var parsed = typeof parseLegacyProductBarcodeForCatalog === 'function'
          ? parseLegacyProductBarcodeForCatalog(candidates[i])
          : (typeof parseLegacyProductBarcode === 'function' ? parseLegacyProductBarcode(candidates[i]) : null);
        var cost = Number((parsed && (parsed.rawCost || parsed.cost)) || 0);
        if (Number.isFinite(cost) && cost > 0) return cost;
      } catch (error) {}
    }
    return 0;
  }

  function inventoryCardCostValue(product, skuCost) {
    var rmb = Number((product && (product.costRmb || product.purchaseCostRmb)) || (skuCost && skuCost.costRmb) || 0);
    if (rmb > 0) return Math.round(rmb * 5);
    var barcodeCost = inventoryCardCostFromBarcode(product, skuCost);
    if (barcodeCost > 0) return barcodeCost;
    return Number((product && product.cost) || (skuCost && skuCost.cost) || 0);
  }

