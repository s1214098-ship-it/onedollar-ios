  function adminShipmentShippingInfoFromAddress(address) {
    var text = String(address || '').toLowerCase();
    var isStore = /7\s*-?\s*11|711|全家|family/i.test(text);
    var isPost = /post|郵局|邮局/i.test(text);
    var isHome = /hct|新竹|ktj|大榮|大荣|宅配|住家|家裡|家里|地址|home/i.test(text);
    if (isStore) return { type: 'store', label: '超商取貨', fee: 70, cost: 45, carrier: /全家|family/i.test(text) ? '全家' : '7-11' };
    if (isPost) return { type: 'post', label: '郵局寄送', fee: 100, cost: 110, carrier: 'POST 郵局' };
    if (isHome || text) return { type: 'home', label: '住家宅配', fee: 100, cost: 100, carrier: /ktj|大榮|大荣/i.test(text) ? 'KTJ 大榮' : 'HCT 新竹' };
    return { type: 'home', label: '住家宅配', fee: 100, cost: 100, carrier: 'HCT 新竹' };
  }

  function normalizeAdminShipmentDeliveryOptions() {
    var delivery = document.querySelector('[data-admin-shipment-delivery]');
    if (!delivery) return;
    Array.from(delivery.options || []).forEach(function (option) {
      if (option.value === 'home') {
        option.dataset.fee = '100';
        option.dataset.cost = '100';
        option.textContent = '住家宅配 NT$100';
      } else if (option.value === 'store') {
        option.dataset.fee = '70';
        option.dataset.cost = '45';
        option.textContent = '超商取貨 NT$70';
      } else if (option.value === 'post') {
        option.dataset.fee = '100';
        option.dataset.cost = '110';
