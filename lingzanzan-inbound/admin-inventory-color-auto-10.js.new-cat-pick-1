  function normalizeScanCode(value) {
    return String(value || '').trim().toUpperCase().replace(/\s+/g, '');
  }

  function scanFamilyCode(value) {
    var raw = normalizeScanCode(value);
    if (!raw) return '';
    try {
      var parsed = parseLegacyProductBarcode(raw);
      if (parsed && parsed.productCode) return parsed.productCode;
    } catch (error) {}
    var beforeDash = raw.split('-')[0];
    var v3 = beforeDash.match(/^([A-Z]+\d+)C[A-Z0-9]+S[A-Z0-9]+(?:P\d+)?$/);
    if (v3) return v3[1];
    var pIndex = beforeDash.search(/P\d/);
    if (pIndex > 0) return beforeDash.slice(0, pIndex);
    var match = beforeDash.match(/^[A-Z]{1,6}\d{1,6}/);
    return match ? match[0] : beforeDash;
  }

