        var nextSearch = document.querySelector('[data-admin-shipment-search]');
        var nextHidden = document.querySelector('[data-admin-shipment-sku]');
        if (nextSearch) { nextSearch.value = ''; nextSearch.focus(); }
        if (nextHidden) nextHidden.value = '';
      }, 0);
    }
