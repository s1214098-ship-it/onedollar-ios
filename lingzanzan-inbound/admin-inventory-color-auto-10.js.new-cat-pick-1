    if (/post|郵/i.test(post)) return 'post';
    if (/hct|ktj|大榮|宅配/i.test([post, row.status, row.note].join(' '))) return 'home';
    if (/異常|未達|拒收|退|改址/i.test([row.status, row.returnFlag, row.note].join(' '))) return 'abnormal';
    return post ? 'post' : '711';
