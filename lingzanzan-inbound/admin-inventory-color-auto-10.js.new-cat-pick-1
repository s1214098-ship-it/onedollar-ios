  }

  function renderLogistics() {
    var target = document.querySelector('[data-logistics-list]');
    if (!target) return;
    var now = new Date();
    var defaultEnd = latestLogisticsDate() || now;
    var defaultStart = new Date(defaultEnd.getFullYear(), defaultEnd.getMonth(), defaultEnd.getDate() - 6);
    var query = (document.querySelector('[data-logistics-search]')?.value || '').trim().toLowerCase();
    var typeFilter = document.querySelector('[data-logistics-type]')?.value || 'all';
    var statusFilter = document.querySelector('[data-logistics-status]')?.value || 'all';
    var staffFilter = document.querySelector('[data-logistics-staff]')?.value || 'all';
    var startValue = formatInputDate(defaultStart);
    var endValue = formatInputDate(defaultEnd);
    if (document.querySelector('[data-logistics-start]') && !document.querySelector('[data-logistics-start]').value) {
      document.querySelector('[data-logistics-start]').value = startValue;
    }
    if (document.querySelector('[data-logistics-end]') && !document.querySelector('[data-logistics-end]').value) {
      document.querySelector('[data-logistics-end]').value = endValue;
    }
    var startDate = startValue ? new Date(startValue + 'T00:00:00') : null;
    var endDate = endValue ? new Date(endValue + 'T23:59:59') : null;
    var rows = state.logistics.filter(function (row) {
      var hasUsefulData = [row.name, row.phone, row.postNo, row.familyNo, row.sevenNo, row.status, row.delivered].some(function (value) {
        return String(value || '').trim() && String(value || '').trim() !== '-';
      });
      if (!hasUsefulData) return false;
      var type = logisticsType(row);
      var rowDate = logisticsDate(row);
      var delivered = isDelivered(row);
      var abnormal = isReturnOrAbnormal(row);
      var deliveredExpire = false;
      if (delivered && rowDate && !abnormal) {
        deliveredExpire = (now - rowDate) > 14 * 24 * 60 * 60 * 1000;
      }
      var text = [row.date, row.name, row.phone, row.amount, row.returnFlag, row.status, cleanStaffName(row.staff), row.postNo, row.familyNo, row.sevenNo, row.note].join(' ').toLowerCase();
      var staffText = cleanStaffName(row.staff);
      var matchStatus = statusFilter === 'all' ||
        (statusFilter === 'problem' && abnormal) ||
        (statusFilter === 'delivered' && delivered && !abnormal) ||
        (statusFilter === 'undelivered' && !delivered && !abnormal) ||
        (statusFilter === 'return' && abnormal);
      var matchDate = statusFilter === 'problem' || !!rowDate && ((!startDate || rowDate >= startDate) && (!endDate || rowDate <= endDate));
      return (!query || text.indexOf(query) !== -1) &&
        (typeFilter === 'all' || type === typeFilter) &&
        (staffFilter === 'all' || staffText === staffFilter) &&
        matchStatus &&
        matchDate &&
        !deliveredExpire;
    });
    var delivered = rows.filter(isDelivered).length;
    var abnormalCount = rows.filter(isReturnOrAbnormal).length;
    document.querySelector('[data-logistics-summary]').textContent = '符合 ' + rows.length + ' 筆；已送達 ' + delivered + ' 筆；未送達 ' + (rows.length - delivered - abnormalCount) + ' 筆；退回/異常提醒 ' + abnormalCount + ' 筆。';
    logisticsVisibleRows = rows.slice(0, 80);
    logisticsRowCache = {};
    logisticsVisibleRows.forEach(function (row) {
      logisticsRowCache[logisticsRowKey(row)] = row;
    });
    target.innerHTML = logisticsVisibleRows.map(function (row) {
      var rowKey = logisticsRowKey(row);
      var type = logisticsType(row);
      var no = logisticsNo(row) || '-';
      var done = isDelivered(row);
      var abnormal = isReturnOrAbnormal(row);
      var deliveryLabel = logisticsDeliveryLabel(row);
      var statusText = logisticsStatusText(row);
      var remarkText = String(row.note || '').trim();
      var reference = encodeURIComponent(JSON.stringify({
        id: row.id || '',
        reference: reportReference(row)
      }));
      return [
        '<article class="logistics-row">',
        '<label class="logistics-check"><input type="checkbox" data-logistics-check="' + escapeHtml(rowKey) + '"' + (logisticsSelectedIds.has(rowKey) ? ' checked' : '') + '><span>勾選</span></label>',
        '<b>' + escapeHtml(row.name) + '</b>',
        '<span>' + escapeHtml(row.phone || '-') + '</span>',
        '<span>' + escapeHtml(row.date) + '</span>',
        '<span class="pill">' + logisticsTypeLabel(type) + '</span>',
        '<span>' + escapeHtml(cleanStaffName(row.staff)) + '</span>',
        '<span>' + escapeHtml(no) + '</span>',
        '<button type="button" class="ghost-button logistics-copy-no" data-copy-logistics-no="' + escapeHtml(rowKey) + '"' + (logisticsNo(row) ? '' : ' disabled') + '>複製單號</button>',
        '<strong>' + escapeHtml(row.amount || 0) + '</strong>',
        '<em class="logistics-status-text">' + escapeHtml(statusText) + '</em>',
        '<em>' + escapeHtml(deliveryLabel) + '</em>',
        '<small class="logistics-note-text">' + escapeHtml(remarkText || '-') + '</small>',
        '<button type="button" class="ghost-button" data-copy-logistics-info="' + escapeHtml(rowKey) + '">複製物流資料</button>',
        '<button type="button" class="ghost-button" data-logistics-report="' + reference + '">回報</button>',
        '</article>'
      ].join('');
    }).join('') || '<div class="empty">沒有符合條件的物流回報。</div>';
    updateLogisticsSelectionUi();
    renderErrorReports();
  }

  function renderLiveDate() {
    var input = document.querySelector('[data-live-date]');
    if (!input) return;
    var now = new Date();
    input.value = now.getFullYear() + '-' + pad(now.getMonth() + 1) + '-' + pad(now.getDate());
  }

  function normalizeLiveCode(value) {
    return String(value || '').trim().toUpperCase();
  }

  function productPrefix(code) {
    return normalizeLiveCode(code).replace(/P.*$/, '');
  }

  function findLiveProduct(code) {
    var target = productPrefix(code);
    if (!target) return null;
    return state.products.find(function (product) {
      return productPrefix(product.code) === target || normalizeLiveCode(product.code).indexOf(target) === 0;
    }) || null;
  }

  function findExactLiveSkuRow(code) {
    var raw = normalizeLiveCode(code);
    if (!raw) return null;
    var parsed = parseLegacyProductBarcode(raw);
    var rows = [];
    state.products.forEach(function (product) {
      productSkus(state.skus, product.id).forEach(function (sku) {
        var exactSku = [sku.id, sku.sku, sku.barcode, sku.companyBarcode, sku.legacyBarcode].some(function (value) {
          return normalizeLiveCode(value) === raw;
        });
        if ((parsed && stocktakeLegacyMatches(product, sku, parsed)) || exactSku) {
          rows.push({ product: product, sku: sku });
        }
      });
    });
    return rows.length === 1 ? rows[0] : null;
  }

  function liveProductMatches(query) {
    var q = String(query || '').trim();
    if (!q) return [];
    return state.products.map(function (product) {
      var rank = productSearchRank(product, null, q, [product.code, product.title, product.name, product.category].join(' '));
      return rank < 9999 ? { product: product, rank: rank } : null;
    }).filter(Boolean).sort(function (a, b) {
      return a.rank - b.rank || String(a.product.code || a.product.id || '').localeCompare(String(b.product.code || b.product.id || ''), 'zh-Hant', { numeric: true });
    }).map(function (entry) { return entry.product; }).slice(0, 48);
  }

  function uniqueSkuValues(skus, key, fallbackKey) {
    var seen = {};
    return skus.map(function (sku) {
      return sku[key] || sku[fallbackKey] || '';
    }).filter(function (value) {
      var clean = String(value || '').trim();
      if (!clean || seen[clean]) return false;
      seen[clean] = true;
      return true;
    });
  }

  function fillSelect(select, values, placeholder) {
    if (!select) return;
    select.innerHTML = '<option value="">' + placeholder + '</option>' + values.map(function (value) {
      return '<option value="' + value + '">' + value + '</option>';
    }).join('');
  }

  function hydrateLiveLine(row) {
    if (!row) return;
    var codeInput = row.querySelector('[data-live-code]');
    var titleInput = row.querySelector('[data-live-title]');
    var colorSelect = row.querySelector('[data-live-color]');
    var sizeSelect = row.querySelector('[data-live-size]');
    var priceInput = row.querySelector('[data-live-price]');
    var exactSkuRow = findExactLiveSkuRow(codeInput ? codeInput.value : '');
    if (exactSkuRow) {
      applyLiveSkuToRow(row, exactSkuRow.product, exactSkuRow.sku, 1);
      return;
    }
    var product = findLiveProduct(codeInput ? codeInput.value : '');
    if (!product) {
      if (titleInput) titleInput.value = '';
      fillSelect(colorSelect, [], '選擇顏色');
      fillSelect(sizeSelect, [], '選擇尺寸');
      return;
    }
    var skus = productSkus(state.skus, product.id).filter(function (sku) {
      return Number(sku.stock || 0) > 0;
    });
    if (titleInput) titleInput.value = product.title || '';
    if (priceInput) priceInput.value = product.price || '';
    fillSelect(colorSelect, uniqueSkuValues(skus, 'colorName', 'color'), '選擇顏色');
    fillSelect(sizeSelect, uniqueSkuValues(skus, 'sizeName', 'size'), '選擇尺寸');
    if (colorSelect && colorSelect.options.length > 1) colorSelect.selectedIndex = 1;
    if (sizeSelect && sizeSelect.options.length > 1) sizeSelect.selectedIndex = 1;
    row.classList.add('is-linked');
  }

  function liveColorName(sku) {
    return sku.colorName || sku.color || '';
  }

  function liveSizeName(sku) {
    return sku.sizeName || sku.size || 'NO SIZE';
  }

  function liveSkuImage(product, sku) {
    var colorName = liveColorName(sku);
    var colorCode = sku.colorCode || '';
    var color = (product.colors || []).find(function (item) {
      return String(item.name || item.color || '') === String(colorName) || (colorCode && String(item.code || item.colorCode || '') === String(colorCode));
    });
    return sku.colorImage || sku.image || (color && color.image) || product.mainImage || (product.images || [])[0] || './assets/brand-logo.png';
  }

  function openLivePicker(row, product) {
    var modal = document.querySelector('[data-live-picker]');
    var body = document.querySelector('[data-live-picker-body]');
    if (!modal || !body || !product) return;
    var skus = productSkus(state.skus, product.id).filter(function (sku) { return Number(sku.stock || 0) > 0; });
    var colors = uniqueSkuValues(skus, 'colorName', 'color');
    body.innerHTML = [
      '<div class="live-picker-head"><h3>' + escapeHtml(product.title || product.code) + '</h3><p>' + escapeHtml(product.code) + '：第一步先看圖片選顏色，第二步再選尺寸與數量。</p></div>',
      '<div class="live-picker-color-gallery" role="list" aria-label="第一步：選擇顏色圖片">',
      colors.map(function (color, index) {
        var firstSku = skus.find(function (sku) { return liveColorName(sku) === color; }) || {};
        var image = liveSkuImage(product, firstSku);
        return '<button type="button" class="live-picker-color-choice' + (index === 0 ? ' is-active' : '') + '" data-live-picker-color="' + escapeHtml(color) + '"><img src="' + escapeHtml(image) + '" alt="' + escapeHtml(color) + '"><b>' + escapeHtml(color) + '</b><small>點圖選顏色</small></button>';
      }).join(''),
      '</div>',
      '<div class="live-picker-step-title"><b>第二步：選尺寸與數量</b><span>可用＋／－調整</span></div>',
      '<div class="live-picker-grid">',
      colors.map(function (color, colorIndex) {
        var rows = skus.filter(function (sku) { return liveColorName(sku) === color; });
        return '<section class="live-picker-color' + (colorIndex === 0 ? ' is-active' : '') + '" data-live-picker-size-panel="' + escapeHtml(color) + '"><h4>' + escapeHtml(color) + '<span>' + rows.reduce(function (sum, sku) { return sum + Number(sku.stock || 0); }, 0) + '件</span></h4>' +
          rows.map(function (sku) {
            var stock = Number(sku.stock || 0);
            return '<label><b>' + escapeHtml(liveSizeName(sku)) + '</b><em>剩 ' + stock + ' 件</em><span class="live-picker-qty"><button type="button" data-live-pick-minus>－</button><input type="number" min="0" max="' + stock + '" value="0" data-live-pick-sku="' + escapeHtml(sku.id) + '"><button type="button" data-live-pick-plus>＋</button></span></label>';
          }).join('') + '</section>';
      }).join(''),
      '</div><button type="button" class="primary-button" data-live-picker-apply>帶入商品明細</button>'
    ].join('');
    body.querySelectorAll('[data-live-picker-color]').forEach(function (button) {
      button.addEventListener('click', function () {
        var color = button.getAttribute('data-live-picker-color');
        body.querySelectorAll('[data-live-picker-color]').forEach(function (item) { item.classList.toggle('is-active', item === button); });
        body.querySelectorAll('[data-live-picker-size-panel]').forEach(function (panel) { panel.classList.toggle('is-active', panel.getAttribute('data-live-picker-size-panel') === color); });
      });
    });
    body.querySelectorAll('[data-live-pick-minus], [data-live-pick-plus]').forEach(function (button) {
      button.addEventListener('click', function () {
        var box = button.closest('.live-picker-qty');
        var input = box && box.querySelector('[data-live-pick-sku]');
        if (!input) return;
        var max = Number(input.max || 0);
        var delta = button.hasAttribute('data-live-pick-plus') ? 1 : -1;
        input.value = Math.max(0, Math.min(max, Number(input.value || 0) + delta));
      });
    });
    body.querySelector('[data-live-picker-apply]').addEventListener('click', function () {
      var picks = [];
      body.querySelectorAll('[data-live-pick-sku]').forEach(function (input) {
        var qty = Number(input.value || 0);
        if (qty <= 0) return;
        var sku = skus.find(function (item) { return item.id === input.getAttribute('data-live-pick-sku'); });
        if (sku) picks.push({ sku: sku, qty: Math.min(qty, Number(sku.stock || 0)) });
      });
      if (!picks.length) {
        toast('請至少填一個尺寸數量');
        return;
      }
      picks.forEach(function (pick, index) {
        var targetRow = index === 0 ? row : null;
        if (!targetRow) {
          addLiveLine();
          targetRow = document.querySelector('[data-live-lines] [data-live-line]:last-child');
        }
        applyLiveSkuToRow(targetRow, product, pick.sku, pick.qty);
      });
      closeLivePicker();
      toast('已帶入 ' + picks.length + ' 筆直播商品');
    });
    modal.classList.add('is-open');
    modal.setAttribute('aria-hidden', 'false');
  }

  function closeLivePicker() {
    var modal = document.querySelector('[data-live-picker]');
    if (!modal) return;
    modal.classList.remove('is-open');
    modal.setAttribute('aria-hidden', 'true');
  }

  function applyLiveSkuToRow(row, product, sku, qty) {
    row.querySelector('[data-live-code]').value = product.code || '';
    row.querySelector('[data-live-title]').value = product.title || '';
    row.querySelector('[data-live-price]').value = product.price || '';
    row.querySelector('input[type="number"]:not([data-live-price])').value = qty || 1;
    fillSelect(row.querySelector('[data-live-color]'), [liveColorName(sku)], '選擇顏色');
    fillSelect(row.querySelector('[data-live-size]'), [liveSizeName(sku)], '選擇尺寸');
    row.querySelector('[data-live-color]').selectedIndex = 1;
    row.querySelector('[data-live-size]').selectedIndex = 1;
    var thumb = row.querySelector('[data-live-thumb]');
    if (thumb) thumb.innerHTML = '<img src="' + escapeHtml(liveSkuImage(product, sku)) + '" alt="' + escapeHtml(liveColorName(sku) || product.title || product.code) + '">';
    row.classList.add('is-linked');
  }

  function showLiveSuggestions(input) {
    var box = document.querySelector('[data-live-suggest]');
    var row = input.closest('[data-live-line]');
    if (!box || !row) return;
    var matches = liveProductMatches(input.value);
    if (!matches.length) {
      if (String(input.value || '').trim().length >= 2) {
        var emptyRect = input.getBoundingClientRect();
        box.style.left = emptyRect.left + 'px';
        box.style.top = emptyRect.bottom + 6 + 'px';
        box.innerHTML = '<p class="live-suggest-empty">找不到相近商品，請確認產品編號或名稱。</p>';
        box.hidden = false;
      } else {
        box.hidden = true;
      }
      return;
    }
    var rect = input.getBoundingClientRect();
    box.style.left = rect.left + 'px';
    box.style.top = rect.bottom + 6 + 'px';
    box.innerHTML = matches.map(function (product) {
      var skus = productSkus(state.skus, product.id);
