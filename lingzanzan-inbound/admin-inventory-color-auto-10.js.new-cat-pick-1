  // LZ_PRINT_WH_PICK_20260927: 列印倉庫可跟現有庫存倉分開，貨還在中國倉也能先印台灣倉標。
  function inventoryPrintWarehouseCode(raw) {
    var text = String(raw || '').trim();
    var code = String(text).toUpperCase();
    if (code === 'TW' || code === 'CN' || code === 'ID') return code;
    try {
      code = normalizeWarehouseCode(text);
    } catch (error) {
      code = '';
    }
    if (code === 'TW' || code === 'CN' || code === 'ID') return code;
    return '';
  }

  function inventoryRememberedPrintWarehouse() {
    try {
      return inventoryPrintWarehouseCode(localStorage.getItem('lz-print-warehouse'));
    } catch (error) {
      return '';
    }
  }

  function inventoryRememberPrintWarehouse(code) {
    code = inventoryPrintWarehouseCode(code) || 'TW';
    try { localStorage.setItem('lz-print-warehouse', code); } catch (error) {}
    return code;
  }

  function inventoryPrintWarehouseChoice(modal) {
    modal = modal || document.querySelector('[data-inventory-print-selector-modal]');
    var fromUi = '';
    if (modal) {
      var active = modal.querySelector('[data-inventory-print-warehouse].is-active') || modal.querySelector('select[data-inventory-print-warehouse]');
      fromUi = inventoryPrintWarehouseCode(active && (active.getAttribute('data-inventory-print-warehouse') || active.value));
    }
    if (fromUi) return fromUi;
    var remembered = inventoryRememberedPrintWarehouse();
    if (remembered) return remembered;
    return 'TW';
  }

  function inventoryStampPrintWarehouse(payload, warehouseCode) {
    warehouseCode = inventoryRememberPrintWarehouse(warehouseCode || inventoryPrintWarehouseChoice());
    payload = payload && typeof payload === 'object' ? Object.assign({}, payload) : {};
    payload.warehouseCode = warehouseCode;
    payload.warehouse = warehouseLabel(warehouseCode);
    payload.warehouseName = warehouseLabel(warehouseCode);
    return payload;
  }

  function inventoryPrintPayloadForVariant(product, variant, warehouseCode) {
    warehouseCode = inventoryRememberPrintWarehouse(warehouseCode || inventoryPrintWarehouseChoice());
    var warehouseName = warehouseLabel(warehouseCode);
    var sku = inventoryPickerSkuForVariant(product, variant, warehouseName) || (variant && variant.primary) || {};
    var payload = inventorySkuPrintPayload(product, sku);
    var location = inventorySkuLocation(product, sku);
    var sameWarehouse = inventoryPrintWarehouseCode(location.warehouse) === warehouseCode;
    payload = inventoryStampPrintWarehouse(payload, warehouseCode);
    payload.shelf = sameWarehouse ? location.shelf : '未設定貨架';
    payload.layer = sameWarehouse ? location.layer : '未設定層位';
    payload.locationText = sameWarehouse
      ? [location.shelf, location.layer].filter(function (part) {
        return part && String(part).indexOf('未設定') === -1;
      }).join(' · ')
      : '';
    return payload;
  }

