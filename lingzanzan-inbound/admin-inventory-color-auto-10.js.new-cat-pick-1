  function adminShipmentSkuSearchText(row) {
    return [
      row.product.code, row.product.id, row.product.title, row.product.name, row.product.brand, row.product.spec,
      row.product.barcode, row.product.companyBarcode, row.product.productLine,
      row.sku.id, row.sku.sku, row.sku.barcode, row.sku.companyBarcode, row.sku.legacyBarcode, row.sku.mappingCode,
      row.sku.colorName, row.sku.color, row.sku.colorCode, row.sku.sizeName, row.sku.size,
      row.sku.warehouseName, row.sku.warehouse, row.sku.shelf, row.sku.layer
