      };
    }
    if (isDelivered(row) || /已送達|已收到|送達|收到|已領|取件完成/i.test(text)) {
      return {
        deliveryState: 'delivered',
        orderStatus: 'delivered',
        noticeType: '',
        needsSalesNotice: false,
        salesNotice: '',
        note: '自動比對物流：已完成配送'
      };
    }
    return {
      deliveryState: 'in_transit',
      orderStatus: 'shipped',
