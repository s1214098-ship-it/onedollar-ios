    var noteInput = document.querySelector('[data-preorder-purchase-note="' + preorderId + '"]');
    var platformInput = document.querySelector('[data-preorder-purchase-platform="' + preorderId + '"]');
    return callStockInquiryApi({
      action: 'update-preorder-meta',
      inquiryId: preorderId,
      purchaseStatus: statusInput ? statusInput.value : 'not_ordered',
      purchaseNote: noteInput ? noteInput.value : '',
      purchasePlatform: platformInput ? platformInput.value : ''
    }).then(function () {
      toast('預購採購紀錄已儲存');
      return loadStockInquiries().then(function (rows) {
        state.inquiries = rows;
        renderOrders();
      });
