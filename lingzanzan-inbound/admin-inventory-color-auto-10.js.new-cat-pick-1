  function loadStockInquiries() {
    var login = currentLogin();
    var role = login.role === 'sales' ? 'sales' : 'admin';
    var sales = login.role === 'sales' ? (login.name || login.account || '') : '';
    return fetch('./stock-inquiry-api.php?action=list&role=' + encodeURIComponent(role) + '&sales=' + encodeURIComponent(sales) + '&_=' + Date.now(), { cache: 'no-store' })
      .then(function (res) { if (!res.ok) throw new Error('preorder load ' + res.status); return res.json(); })
      .then(function (data) { return Array.isArray(data.inquiries) ? data.inquiries : []; })
      .catch(function () { return []; });
  }

  function refreshOrdersAndInquiries() {
    return Promise.all([
      loadJson('./data/orders.json').then(normalizeOrderRows).catch(function () { return state.orders || []; }),
      loadStockInquiries()
    ]).then(function (rows) {
      state.orders = normalizeOrderRows(rows[0]);
      state.inquiries = Array.isArray(rows[1]) ? rows[1] : [];
      renderOrders();
      renderSalesPerformance();
    });
