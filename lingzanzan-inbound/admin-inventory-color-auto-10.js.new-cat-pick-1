  function preorderImageReviewText(value) {
    return String(value || '').toLowerCase().replace(/[^a-z0-9\u4e00-\u9fff]+/g, ' ').trim();
  }

  function getPreorderImageReviewCandidates(item, query) {
    var search = preorderImageReviewText(query || [item.code, item.sku, item.title, item.name, item.description].filter(Boolean).join(' '));
    var terms = search.split(/\s+/).filter(function (term) { return term.length >= 2; }).slice(0, 6);
    return (state.products || []).map(function (product) {
      var haystack = preorderImageReviewText([product.code, product.productLine, product.title, product.name, product.category, product.brand, product.spec].join(' '));
      var score = terms.reduce(function (total, term) { return total + (haystack.indexOf(term) !== -1 ? 1 : 0); }, 0);
      return { product: product, score: score };
    }).filter(function (row) { return !terms.length || row.score > 0; }).sort(function (a, b) { return b.score - a.score; }).slice(0, 18);
  }

  function renderPreorderImageReviewCandidates(dialog, context, query) {
    var target = dialog.querySelector('[data-preorder-image-review-results]');
    if (!target) return;
    var rows = getPreorderImageReviewCandidates(context.item || {}, query);
    if (!rows.length) {
      target.innerHTML = '<p class="preorder-image-review-empty">沒有相似候選。可留空，待管理者後續建檔。</p>';
      return;
    }
    target.innerHTML = rows.map(function (row) {
      var product = row.product || {};
      var image = product.mainImage || (product.images || [])[0] || './assets/brand-logo.png';
      return '<article><img src="' + escapeHtml(image) + '" alt=""><div><b>' + escapeHtml(product.code || product.id || '-') + '</b><span>' + escapeHtml(product.title || product.name || '') + '</span><small>' + escapeHtml([product.category, product.brand, product.spec].filter(Boolean).join(' / ')) + '</small></div><button type="button" data-confirm-preorder-image-review="' + escapeHtml(product.id || '') + '">選為比對結果</button></article>';
    }).join('');
  }

