  function installAppNavigationButtons() {
    var selector = 'a[href], a[data-app-nav-href]';
    function isInternalAppLink(anchor) {
      var href = anchor.getAttribute('href') || '';
      if (!href || href.charAt(0) === '#') return false;
      try {
        var url = new URL(href, location.href);
        return url.origin === location.origin && (url.pathname.indexOf('/LINGZANZAN%20V1%20APP/') !== -1 || url.pathname.indexOf('/LINGZANZAN V1 APP/') !== -1);
      } catch (error) {
        return href.indexOf('./') === 0 || href.indexOf('admin-') === 0 || href === './';
      }
    }
    function normalizeLink(anchor) {
      if (!anchor || anchor.dataset.appNavHref || !isInternalAppLink(anchor)) return;
      var href = anchor.getAttribute('href') || '';
      anchor.dataset.appNavHref = new URL(href, location.href).href;
    }
    document.querySelectorAll(selector).forEach(normalizeLink);
    if (!window.__lingzanzanAdminNavButtonBound) {
      window.__lingzanzanAdminNavButtonBound = true;
      document.addEventListener('click', function (event) {
        var anchor = event.target && event.target.closest ? event.target.closest('a[data-app-nav-href]') : null;
        if (!anchor) return;
        if (anchor.getAttribute('href')) return;
        event.preventDefault();
        if (event.metaKey || event.ctrlKey) window.open(anchor.dataset.appNavHref, '_blank');
        else location.href = anchor.dataset.appNavHref;
      });
      document.addEventListener('keydown', function (event) {
        var anchor = event.target && event.target.closest ? event.target.closest('a[data-app-nav-href]') : null;
        if (!anchor || (event.key !== 'Enter' && event.key !== ' ')) return;
        if (anchor.getAttribute('href')) return;
        event.preventDefault();
        location.href = anchor.dataset.appNavHref;
      });
      new MutationObserver(function () {
        document.querySelectorAll(selector).forEach(normalizeLink);
      }).observe(document.documentElement, { childList: true, subtree: true });
    }
  }

