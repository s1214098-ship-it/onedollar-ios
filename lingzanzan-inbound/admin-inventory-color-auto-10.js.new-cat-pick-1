  function applyInventoryPrefixVariantPicker() {
    var overlay = document.querySelector('[data-inventory-prefix-picker]');
    if (!overlay || !overlay._pickerState) return;
    var product = overlay._pickerState.product;
    var scan = overlay._pickerState.scan;
    var warehouseName = overlay._pickerState.warehouseName;
    var variants = overlay._pickerState.variants || [];
    var picks = [];
    overlay.querySelectorAll('[data-prefix-pick-qty]').forEach(function (input) {
      var qty = Math.max(0, Math.floor(Number(input.value || 0)));
      if (qty <= 0) return;
      var parts = String(input.getAttribute('data-prefix-pick-qty') || '').split('::');
      var color = parts[0];
      var size = parts[1];
      var variant = variants.find(function (item) {
        return item.color === color && String(item.size) === String(size);
      });
      if (!variant) return;
      var sku = inventoryPickerSkuForVariant(product, variant, warehouseName);
      if (!sku) return;
      picks.push({ variant: variant, sku: sku, qty: qty });
    });
    if (!picks.length) {
      toast('請先填要帶入的顏色／尺寸數量');
      return;
    }
    ensureStocktakePanel();
    if (stocktakeDraft && warehouseName) stocktakeDraft.warehouse = warehouseName;
    var aliasChanged = false;
    picks.forEach(function (pick) {
      if (inventoryAttachOldBarcodeAlias(product, pick.sku, scan)) aliasChanged = true;
      addStocktakeLine({ product: product, sku: pick.sku }, scan, pick.qty);
      saveStocktakeMapping(scan, { product: product, sku: pick.sku });
    });
    stocktakeDraft.compareStarted = true;
    saveStocktakeDraft();
    closeInventoryPrefixVariantPicker();
    var afterRender = function () {
      renderStocktakePanel();
      toast('已用新條碼帶入 ' + picks.length + ' 組規格；舊碼已綁成別名');
    };
    if (aliasChanged) {
      saveLocal().then(afterRender).catch(function (error) {
        afterRender();
        toast(error.message || '規格已帶入盤點，條碼別名稍後再存');
      });
    } else {
      afterRender();
    }
  }

