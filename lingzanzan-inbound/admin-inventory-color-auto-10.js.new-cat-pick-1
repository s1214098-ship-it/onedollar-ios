  function stocktakeDiffTotals(lines) {
    return (lines || []).reduce(function (totals, line) {
      var diff = Number(line.diff || 0);
      totals.systemQty += Number(line.systemStock || 0);
      totals.countedQty += Number(line.countedQty || 0);
      if (diff > 0) totals.plusQty += diff;
      if (diff < 0) totals.minusQty += Math.abs(diff);
      totals.netDiff += diff;
      return totals;
    }, { systemQty: 0, countedQty: 0, plusQty: 0, minusQty: 0, netDiff: 0 });
  }

  function stocktakeReportType(diff) {
    return Number(diff || 0) > 0 ? '報溢單' : '報損單';
  }

  function stocktakeReportsFromLines(lines) {
    return (lines || []).filter(function (line) { return Number(line.diff || 0) !== 0; }).map(function (line) {
      return {
        id: 'stocktake-report-' + Date.now() + '-' + Math.random().toString(16).slice(2),
        type: stocktakeReportType(line.diff),
        warehouse: line.warehouse || '',
        productCode: line.productCode || '',
        skuCode: line.skuCode || '',
        color: line.color || '',
        size: line.size || '',
        systemQty: Number(line.systemStock || 0),
        countedQty: Number(line.countedQty || 0),
        diff: Number(line.diff || 0),
        status: '待管理者核准'
      };
    });
  }

  function stocktakeCompareStatus(row) {
    if (!row.counted) return { label: '帳上有／現場未盤', className: 'is-missing' };
    if (Number(row.diff || 0) > 0) return { label: '現場多出／報溢', className: 'is-over' };
    if (Number(row.diff || 0) < 0) return { label: '現場短少／報損', className: 'is-loss' };
    return { label: '數量相同', className: 'is-equal' };
  }

