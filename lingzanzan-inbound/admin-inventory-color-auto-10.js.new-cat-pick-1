  function compareTaiwanSheetWithBackend(csv) {
    var sheet = parseTaiwanSheetStockCsv(csv);
    var backend = buildStrictTaiwanBackendStockIndex();
    var results = [];
    Object.keys(sheet.sheetMap).forEach(function (key) {
      var item = sheet.sheetMap[key];
      var backendRow = backend.byKey[key];
      var productRows = backend.byProduct[normalizeVerifyCode(item.code)] || [];
      if (Number(item.sheetQty || 0) <= 0 && !backendRow) return;
      if (!item.colorKnown && Number(item.sheetQty || 0) > 0) {
        results.push(Object.assign({}, item, {
          status: 'color-issue',
          backendQty: '',
          diff: '',
          issue: '雲端表顏色不在目前色表，請小姐先確認是否要建立新顏色',
          suggestion: '建議建立顏色候選：' + item.color
        }));
        return;
      }
      if (!backendRow) {
        if (Number(item.sheetQty || 0) <= 0) return;
        var sameProduct = productRows.length > 0;
        results.push(Object.assign({}, item, {
          status: sameProduct ? 'color-issue' : 'sheet-only',
          backendQty: 0,
          diff: item.sheetQty,
          issue: sameProduct ? '後台有同商品，但沒有嚴格相同色碼/尺寸' : '雲端有庫存，後台台灣倉找不到相同商品/顏色/尺寸',
          suggestion: sameProduct ? '先核對後台顏色表與顏色圖，不硬配' : '先確認是否要建檔或補 SKU'
        }));
        return;
      }
      var diff = Number(item.sheetQty || 0) - Number(backendRow.backendQty || 0);
      if (diff === 0 && Number(item.sheetQty || 0) <= 0) return;
      results.push(Object.assign({}, item, {
        status: diff === 0 ? 'same' : 'diff',
        backendQty: backendRow.backendQty,
        backendColor: backendRow.color,
        backendColorCode: backendRow.colorCode,
        backendSize: backendRow.size,
        backendSkus: backendRow.skus.join(' / '),
        diff: diff,
        issue: diff === 0 ? '' : '雲端表與後台台灣倉數量不同',
        suggestion: diff === 0 ? '' : '先核對實品與表格，不自動覆蓋'
      }));
    });
    Object.keys(backend.byKey).forEach(function (key) {
      if (sheet.sheetMap[key]) return;
      var back = backend.byKey[key];
      if (Number(back.backendQty || 0) <= 0) return;
      results.push({
        key: key,
        status: 'backend-only',
        code: back.code,
        color: back.color,
        colorCode: back.colorCode,
        colorTableName: back.colorTableName,
        size: back.size,
        sheetQty: 0,
        backendQty: back.backendQty,
        backendSkus: back.skus.join(' / '),
        diff: -Number(back.backendQty || 0),
        rows: [],
        warehouses: [],
        issue: '後台台灣倉有庫存，但雲端表 AK:AZ 沒有對應庫存',
        suggestion: '請核對是否表格漏登或後台庫存需盤點'
      });
    });
    var summary = results.reduce(function (acc, row) {
      acc[row.status] = (acc[row.status] || 0) + 1;
      return acc;
    }, { same: 0, diff: 0, 'sheet-only': 0, 'backend-only': 0, 'color-issue': 0 });
    return {
      createdAt: new Date().toISOString(),
      source: '台灣現貨倉 A:C + AK:AZ',
      sheetRows: sheet.rowCount,
      sheetColors: sheet.colors,
      results: results,
      summary: summary
    };
  }

  function renderSheetStockCompare() {
    var summary = document.querySelector('[data-sheet-stock-summary]');
    var resultsBox = document.querySelector('[data-sheet-stock-results]');
    if (!summary || !resultsBox) return;
    if (!sheetStockCompareLast) {
      summary.textContent = '尚未核對。';
      resultsBox.innerHTML = '';
      return;
    }
    var filter = document.querySelector('[data-sheet-stock-filter]')?.value || 'all';
    var query = searchTextNormalize(document.querySelector('[data-sheet-stock-search]')?.value || '');
    var rows = sheetStockCompareLast.results.filter(function (row) {
      if (filter !== 'all' && row.status !== filter) return false;
      if (!query) return true;
      return searchTextNormalize([
        row.code, row.color, row.colorCode, row.colorTableName, row.size,
        row.backendColor, row.backendColorCode, row.backendSize, row.backendSkus,
        (row.warehouses || []).join(' '), row.issue, row.suggestion, (row.rows || []).join(' ')
      ].join(' ')).indexOf(query) !== -1;
    });
    var statusOrder = { 'color-issue': 0, 'sheet-only': 1, diff: 2, 'backend-only': 3, same: 4 };
    rows.sort(function (a, b) {
      var statusDiff = (statusOrder[a.status] == null ? 99 : statusOrder[a.status]) - (statusOrder[b.status] == null ? 99 : statusOrder[b.status]);
      if (statusDiff) return statusDiff;
      var codeDiff = String(a.code || '').localeCompare(String(b.code || ''), 'zh-Hant', { numeric: true, sensitivity: 'base' });
      if (codeDiff) return codeDiff;
      var colorDiff = String(a.colorCode || a.color || '').localeCompare(String(b.colorCode || b.color || ''), 'zh-Hant', { numeric: true, sensitivity: 'base' });
      if (colorDiff) return colorDiff;
      return String(a.size || a.backendSize || '').localeCompare(String(b.size || b.backendSize || ''), 'zh-Hant', { numeric: true, sensitivity: 'base' });
    });
    var s = sheetStockCompareLast.summary || {};
    summary.innerHTML = [
      '<b>核對完成</b>',
      '<span>表格顏色列 ' + sheetStockCompareLast.sheetRows + ' 列</span>',
      '<span>一致 ' + (s.same || 0) + '</span>',
      '<span>數量不同 ' + (s.diff || 0) + '</span>',
      '<span>雲端有後台無 ' + (s['sheet-only'] || 0) + '</span>',
      '<span>後台有雲端無 ' + (s['backend-only'] || 0) + '</span>',
      '<span>顏色待確認 ' + (s['color-issue'] || 0) + '</span>',
      '<span>目前顯示 ' + rows.length + ' 筆</span>'
    ].join('');
    if (!rows.length) {
      resultsBox.innerHTML = '<div class="empty">這個分類目前沒有資料。</div>';
      return;
    }
    resultsBox.innerHTML = rows.slice(0, 500).map(function (row) {
      var status = row.status || '';
      var qtyText = '雲端 ' + (row.sheetQty == null ? '-' : row.sheetQty) + ' / 後台 ' + (row.backendQty === '' || row.backendQty == null ? '-' : row.backendQty);
      var rowIndex = sheetStockCompareLast.results.indexOf(row);
      return [
        '<article class="sheet-stock-row is-' + escapeHtml(status) + '">',
        '<div><span class="sheet-stock-badge">' + escapeHtml(sheetStockCompareStatusLabel(status)) + '</span><b>' + escapeHtml(row.code || '-') + '</b><small>表格列 ' + escapeHtml((row.rows || []).join('、') || '-') + '</small></div>',
        '<div><strong>' + escapeHtml(row.color || '-') + '</strong><span>色碼 ' + escapeHtml(row.colorCode || '待建色') + '</span><small>' + escapeHtml(row.colorTableName || row.backendColor || '') + '</small></div>',
        '<div><strong>' + escapeHtml(row.size || row.backendSize || 'NO SIZE') + '</strong><span>' + escapeHtml(qtyText) + '</span><small>差異 ' + escapeHtml(row.diff == null ? '-' : row.diff) + '</small></div>',
        '<div><span>' + escapeHtml((row.warehouses || []).join(' / ') || '-') + '</span><small>' + escapeHtml(row.backendSkus || '') + '</small></div>',
        '<p>' + escapeHtml(row.issue || '數量與顏色一致') + '<br><small>' + escapeHtml(row.suggestion || '') + '</small>' + sheetStockActionButtons(row, rowIndex) + '</p>',
        '</article>'
      ].join('');
    }).join('') + (rows.length > 500 ? '<p class="muted">只顯示前 500 筆，請用搜尋或分類縮小結果。</p>' : '');
  }

