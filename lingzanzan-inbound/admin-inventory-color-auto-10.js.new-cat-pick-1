  function stocktakeIntakeWarehouses() {
    var base = (state.warehouses || ['台灣倉', '印尼倉', '中國倉']).slice();
    ['現貨倉', '預購倉', '退貨倉', '待判別倉', '瑕疵/故障倉'].forEach(function (item) {
      if (base.indexOf(item) === -1) base.push(item);
    });
    return base;
  }

  function stocktakeParsedPending(scan, qty) {
    var raw = normalizeScanCode(scan);
    var parsed = parseLegacyProductBarcodeForCatalog(raw) || {};
    var productCode = parsed.productCode || scanFamilyCode(raw) || raw || 'TEMP';
    var sizeName = parsed.sizeName || 'NO SIZE';
    var colorName = parsed.colorName || '待補顏色';
    var tempCode = 'TMP-' + raw.replace(/[^A-Z0-9]/gi, '').slice(0, 18) + '-' + Date.now();
    return {
      rawScan: raw,
      tempCode: tempCode,
      productCode: productCode,
      skuCode: raw || tempCode,
      title: '待補資料商品 ' + productCode,
      brand: '',
      spec: '',
      colorCode: parsed.colorCode || '',
      colorName: colorName,
      sizeCode: parsed.sizeCode || '',
      sizeName: sizeName,
      cost: Number(parsed.cost || 0),
      qty: Math.max(1, Number(qty || 1))
    };
  }

  function quickStockInNormalizeWarehouse(value) {
    var text = String(value || '').trim();
    var normalized = normalizeScanCode(text);
    if (!text) return '中國倉';
    if (normalized === 'CN' || normalized.indexOf('中國') !== -1 || normalized.indexOf('中国') !== -1 || normalized.indexOf('CHINA') !== -1) return '中國倉';
    if (normalized === 'TW' || normalized.indexOf('台灣') !== -1 || normalized.indexOf('台湾') !== -1 || normalized.indexOf('TAIWAN') !== -1) return '台灣倉';
    if (normalized === 'ID' || normalized.indexOf('印尼') !== -1 || normalized.indexOf('INDONESIA') !== -1) return '印尼倉';
    return text;
  }

  function quickStockInWarehouseValue() {
    return quickStockInNormalizeWarehouse(localStorage.getItem(QUICK_STOCKIN_WAREHOUSE_KEY) || stocktakeDraft.warehouse || (state.warehouses && state.warehouses[0]) || '中國倉');
  }

  function quickStockInShelfValue() {
    var shelf = String(localStorage.getItem(QUICK_STOCKIN_SHELF_KEY) || '').trim();
    if (isInvalidShelfName(shelf)) {
      localStorage.removeItem(QUICK_STOCKIN_SHELF_KEY);
      return '';
    }
    return shelf;
  }

  function quickStockInLayerValue() {
    var layer = String(localStorage.getItem(QUICK_STOCKIN_LAYER_KEY) || '').trim();
    if (isInvalidLayerName(layer)) {
      localStorage.removeItem(QUICK_STOCKIN_LAYER_KEY);
      return '';
    }
    return layer;
  }

  function quickStockInSetStatus(text) {
    var status = document.querySelector('[data-quick-stockin-status]');
    if (status) status.textContent = text || '等待掃碼';
  }

  function quickStockInWarehouses() {
    var base = (state.warehouses || []).map(quickStockInNormalizeWarehouse).filter(Boolean);
    ['台灣倉', '中國倉', '印尼倉', '現貨倉', '預購倉', '待判別倉'].forEach(function (item) {
      if (base.indexOf(item) === -1) base.push(item);
    });
    return base;
  }

  function quickStockInWarehouseOptions(selected) {
    selected = quickStockInNormalizeWarehouse(selected || quickStockInWarehouseValue());
    return quickStockInWarehouses().map(function (item) {
      return '<option value="' + escapeHtml(item) + '"' + (item === selected ? ' selected' : '') + '>' + escapeHtml(item) + '</option>';
    }).join('');
  }

  function quickStockInLocationOptions(values, selected, emptyLabel) {
    selected = String(selected || '').trim();
    var list = Array.from(new Set((values || []).map(function (item) { return String(item || '').trim(); }).filter(Boolean)));
    if (selected && list.indexOf(selected) === -1) list.unshift(selected);
    return '<option value="">' + escapeHtml(emptyLabel || '不指定') + '</option>' + list.map(function (item) {
      return '<option value="' + escapeHtml(item) + '"' + (item === selected ? ' selected' : '') + '>' + escapeHtml(item) + '</option>';
    }).join('');
  }

  function quickStockInApplyNewLocation(showToast) {
    var panel = document.querySelector('[data-quick-stockin-panel]');
    if (!panel) return false;
    state.shelves = Array.isArray(state.shelves) ? state.shelves : [];
    state.layers = Array.isArray(state.layers) ? state.layers : [];
    var shelfInput = panel.querySelector('[data-quick-stockin-new-shelf]');
    var layerInput = panel.querySelector('[data-quick-stockin-new-layer]');
    var shelf = String(shelfInput && shelfInput.value || '').trim();
    var layer = String(layerInput && layerInput.value || '').trim();
    if (!shelf && !layer) {
      if (showToast) toast('請輸入要新增的貨架或層位');
      return false;
    }
    if (shelf && isInvalidShelfName(shelf)) {
      toast('貨架名稱不能包含「區」，請輸入實際的「架」名稱。');
      return false;
    }
    if (layer && isInvalidLayerName(layer)) {
      toast('層位必須分開建立，不能把兩個層位放在同一項。');
      return false;
    }
    var added = false;
    if (shelf && state.shelves.indexOf(shelf) === -1) { state.shelves.push(shelf); added = true; }
    if (layer && state.layers.indexOf(layer) === -1) { state.layers.push(layer); added = true; }
    if (shelf) localStorage.setItem(QUICK_STOCKIN_SHELF_KEY, shelf);
    if (layer) localStorage.setItem(QUICK_STOCKIN_LAYER_KEY, layer);
    if (shelfInput) shelfInput.value = '';
    if (layerInput) layerInput.value = '';
    renderQuickStockInPanel();
    if (added) saveLocal().catch(function (error) { toast(error.message || '新增位置儲存失敗'); });
    if (showToast) toast(added ? '已新增並套用上架位置' : '已套用既有上架位置');
    return true;
  }

  function quickStockInImageFromProduct(product, colorName, colorCode) {
    product = product || {};
    var targetName = normalizeScanCode(colorName || '');
    var targetCode = normalizeScanCode(colorCode || '');
    var color = (product.colors || []).find(function (item) {
      return (targetName && (normalizeScanCode(item.name) === targetName || normalizeScanCode(item.colorName) === targetName)) ||
        (targetCode && (normalizeScanCode(item.code) === targetCode || normalizeScanCode(item.colorCode) === targetCode));
    });
    return (color && color.image) || product.mainImage || './assets/brand-logo.png';
  }

  function quickStockInProductCodeFromScan(value) {
    var raw = normalizeScanCode(value);
    if (!raw) return '';
    var parsed = parseLegacyProductBarcodeForCatalog(raw);
    if (parsed && parsed.productCode) return parsed.productCode;
    var pIndex = raw.indexOf('P');
    if (pIndex > 0) return raw.slice(0, pIndex);
    return scanFamilyCode(raw) || raw;
  }

  function quickStockInProductByCode(code) {
    var normalized = normalizeScanCode(code);
    var family = quickStockInProductCodeFromScan(normalized);
    var targets = [normalized, family, scanFamilyCode(normalized)].filter(Boolean);
    if (!targets.length) return null;
    return (state.products || []).find(function (product) {
      var values = [product.code, product.id, product.barcode, product.companyBarcode, product.productLine].map(normalizeScanCode).filter(Boolean);
      return values.some(function (value) {
        var valueFamily = scanFamilyCode(value);
        return targets.indexOf(value) !== -1 || targets.indexOf(valueFamily) !== -1;
      });
    }) || null;
  }

  function quickStockInUniqueSkuId(base) {
    var raw = normalizeScanCode(base) || ('QSKU-' + Date.now());
    var id = raw;
    var index = 2;
    while ((state.skus || []).some(function (sku) { return normalizeScanCode(sku.id || sku.sku) === id; })) {
      id = raw + '-' + index;
      index += 1;
    }
    return id;
  }

  function quickStockInFindSku(product, parsed, raw, warehouse, shelf, layer) {
    var targetColor = normalizeScanCode(parsed.colorName || '');
    var targetSize = normalizeScanCode(parsed.sizeCode ? (parsed.sizeName || '') : 'NO SIZE');
    var exactRaw = normalizeScanCode(raw);
    var targetShelf = normalizeScanCode(shelf || '');
    var targetLayer = normalizeScanCode(layer || '');
    var skus = productSkus(state.skus, product.id);
    function sameLocation(sku) {
      var skuShelf = normalizeScanCode(sku.shelf || (Array.isArray(sku.shelves) ? sku.shelves[0] : '') || '');
      var skuLayer = normalizeScanCode(sku.layer || (Array.isArray(sku.layers) ? sku.layers[0] : '') || '');
      return skuShelf === targetShelf && skuLayer === targetLayer;
    }
    return skus.find(function (sku) {
      var sameCode = barcodeValuesShareScanIdentity(sku.id || sku.sku, exactRaw) || barcodeValuesShareScanIdentity(sku.barcode, exactRaw) || barcodeValuesShareScanIdentity(sku.companyBarcode, exactRaw) || barcodeValuesShareScanIdentity(sku.legacyBarcode, exactRaw) || barcodeValuesShareScanIdentity(sku.mappingCode, exactRaw);
      var sameWarehouse = normalizeScanCode(sku.warehouse || sku.warehouseName) === normalizeScanCode(warehouse);
      return sameCode && sameWarehouse && sameLocation(sku);
    }) || skus.find(function (sku) {
      return normalizeScanCode(sku.warehouse || sku.warehouseName) === normalizeScanCode(warehouse) && sameLocation(sku) &&
        normalizeScanCode(sku.colorName || sku.color) === targetColor &&
        normalizeScanCode(sku.sizeName || sku.size || 'NO SIZE') === targetSize;
    }) || null;
  }

  function quickStockInEnsureColor(product, colorName, colorCode, image) {
    product.colors = Array.isArray(product.colors) ? product.colors : [];
    var existing = inventoryFindProductColor(product, colorName, colorCode, image);
    if (existing) {
      if (image && (!existing.image || /brand-logo/i.test(existing.image))) existing.image = image;
      return existing;
    }
    var row = {
      code: colorCode || canonicalInventoryColor(colorName).code || String(product.colors.length + 1).padStart(2, '0'),
      name: canonicalInventoryColor(colorName).name || colorName || '待補顏色',
      image: image || ''
    };
    product.colors.push(row);
    return row;
  }

  function quickStockInCreateProduct(parsed, warehouse, image) {
    var productId = 'p-' + normalizeScanCode(parsed.productCode || parsed.rawScan || ('quick-' + Date.now())).toLowerCase();
    var code = parsed.productCode || parsed.rawScan || ('QUICK-' + Date.now());
    var product = {
      id: productId,
      code: code,
      productLine: productCodeLine(code),
      title: parsed.title || ('快速入庫 ' + code),
      brand: parsed.brand || '',
      brandName: parsed.brand || '',
      spec: parsed.spec || '',
      specification: parsed.spec || '',
      price: 0,
      cost: Number(parsed.cost || 0),
      mainImage: image || './assets/brand-logo.png',
      images: image ? [image] : [],
      colors: [{ code: parsed.colorCode || '00', name: parsed.colorName || '待補顏色', image: image || '' }],
      description: '快速入庫建立。原始掃描值：' + (parsed.rawScan || ''),
      category: '快速入庫待補',
      showOnWebsite: false,
      quickStockIn: true,
      warehouseName: warehouse,
      warehouse: warehouse,
      shelves: [],
      layers: [],
      shelf: '',
      layer: '',
      createdAt: new Date().toISOString()
    };
    state.products.unshift(product);
    return product;
  }

  function quickStockInUpsert(scan, qty, warehouse, image, shelf, layer) {
    warehouse = quickStockInNormalizeWarehouse(warehouse);
    shelf = String(shelf || '').trim();
    if (isInvalidShelfName(shelf)) shelf = '';
    layer = String(layer || '').trim();
    if (isInvalidLayerName(layer)) layer = '';
    var raw = normalizeScanCode(scan);
    var parsedLegacy = parseLegacyProductBarcodeForCatalog(raw);
    var parsed = stocktakeParsedPending(raw, qty);
    if (parsedLegacy) {
      parsed.productCode = parsedLegacy.productCode || parsed.productCode;
      parsed.cost = Number(parsedLegacy.cost || 0);
      parsed.colorCode = parsedLegacy.colorCode || parsed.colorCode;
      parsed.colorName = parsedLegacy.colorName || parsed.colorName;
      parsed.sizeCode = parsedLegacy.sizeCode || parsed.sizeCode;
      parsed.sizeName = parsedLegacy.sizeName || parsed.sizeName;
    }
    var candidates = stocktakeCandidates(raw);
    var product = (candidates[0] && candidates[0].product) || quickStockInProductByCode(parsed.productCode) || quickStockInProductByCode(raw);
    var action = product ? 'updated' : 'created';
    if (!product) product = quickStockInCreateProduct(parsed, warehouse, image);
    var noSizeColorParsed = parseLegacyNoSizeColorBarcode(raw);
    if (product && productSupportsNoSize(product) && noSizeColorParsed && noSizeColorParsed.productCode === parsed.productCode) {
      parsed.cost = Number(noSizeColorParsed.cost || parsed.cost || 0);
      parsed.colorCode = noSizeColorParsed.colorCode || parsed.colorCode;
      parsed.colorName = noSizeColorParsed.colorName || parsed.colorName;
      parsed.sizeCode = noSizeColorParsed.sizeCode || parsed.sizeCode;
      parsed.sizeName = noSizeColorParsed.sizeName || parsed.sizeName || 'NO SIZE';
    }
    if (image) {
      product.mainImage = product.mainImage && product.mainImage !== './assets/brand-logo.png' ? product.mainImage : image;
      product.images = Array.isArray(product.images) ? product.images : [];
      if (product.images.indexOf(image) === -1) product.images.unshift(image);
    }
    var colorName = parsed.colorName || (candidates[0] && (candidates[0].sku.colorName || candidates[0].sku.color)) || '待補顏色';
    var sizeName = parsed.sizeName || (candidates[0] && (candidates[0].sku.sizeName || candidates[0].sku.size)) || 'NO SIZE';
    quickStockInEnsureColor(product, colorName, parsed.colorCode, image);
    if (state.colors.indexOf(colorName) === -1) state.colors.push(colorName);
    if (state.sizes.indexOf(sizeName) === -1) state.sizes.push(sizeName);
    if (state.warehouses.indexOf(warehouse) === -1) state.warehouses.push(warehouse);
    var sku = quickStockInFindSku(product, parsed, raw, warehouse, shelf, layer);
    var before = sku ? Number(sku.stock || 0) : 0;
    if (!sku) {
      var skuId = quickStockInUniqueSkuId(raw || [product.code, parsed.colorCode || '00', parsed.sizeCode || sizeName].join('-'));
      sku = {
        id: skuId,
        sku: skuId,
        barcode: skuId,
        companyBarcode: raw,
        legacyBarcode: raw,
        mappingCode: raw,
        productId: product.id,
        color: colorName,
        colorName: colorName,
        colorCode: parsed.colorCode || '',
        colorImage: image || quickStockInImageFromProduct(product, colorName),
        size: sizeName,
        sizeName: sizeName,
        sizeCode: parsed.sizeCode || '',
        stock: 0,
        price: Number(product.price || 0),
        cost: Number(parsed.cost || product.cost || 0),
        warehouse: warehouse,
        warehouseCode: warehouse,
        warehouseName: warehouse,
        status: 'active',
        quickStockIn: true,
        shelves: shelf ? [shelf] : [],
        layers: layer ? [layer] : [],
        shelf: shelf,
        layer: layer,
        createdAt: new Date().toISOString()
      };
      state.skus.unshift(sku);
      action = action === 'created' ? 'created' : 'sku-created';
    }
    sku.stock = before + Number(qty || 1);
    sku.companyBarcode = sku.companyBarcode || raw;
    sku.legacyBarcode = sku.legacyBarcode || raw;
    sku.mappingCode = sku.mappingCode || raw;
    if (parsed.colorCode && !sku.colorCode) sku.colorCode = parsed.colorCode;
    if (parsed.sizeCode && !sku.sizeCode) sku.sizeCode = parsed.sizeCode;
    if (shelf) { sku.shelf = shelf; sku.shelves = [shelf]; }
    if (layer) { sku.layer = layer; sku.layers = [layer]; }
    sku.colorImage = image || sku.colorImage || quickStockInImageFromProduct(product, colorName);
    sku.updatedAt = new Date().toISOString();
    product.cost = Number(product.cost || parsed.cost || sku.cost || 0);
    if (action === 'created') {
      product.warehouse = warehouse;
      product.warehouseName = warehouse;
      if (shelf) { product.shelf = shelf; product.shelves = [shelf]; }
      if (layer) { product.layer = layer; product.layers = [layer]; }
    }
    state.stocktakeLogs = state.stocktakeLogs || [];
    state.stocktakeLogs.push({
      id: 'quick-stockin-' + Date.now(),
      createdAt: new Date().toISOString(),
      type: 'quick-stockin',
      warehouse: warehouse,
      count: 1,
      lines: [{
        productCode: product.code || product.id,
        skuCode: sku.id || sku.sku,
        warehouse: warehouse,
        shelf: shelf,
        layer: layer,
        before: before,
        after: sku.stock,
        diff: Number(qty || 1),
        companyCode: raw,
        status: action
      }]
    });
    return { product: product, sku: sku, before: before, after: sku.stock, action: action, parsed: parsed };
  }

  function loadQuickStockInBatch() {
    if (Array.isArray(state.quickStockInBatch)) {
      quickStockInBatch = state.quickStockInBatch.map(normalizeQuickStockInBatchItem);
      return;
    }
    try {
      var saved = JSON.parse(localStorage.getItem(QUICK_STOCKIN_BATCH_KEY) || '[]');
      quickStockInBatch = Array.isArray(saved) ? saved.map(normalizeQuickStockInBatchItem) : [];
    } catch (error) {
      quickStockInBatch = [];
    }
  }

  function saveQuickStockInBatch() {
    state.quickStockInBatch = quickStockInBatch.map(normalizeQuickStockInBatchItem);
    localStorage.setItem(QUICK_STOCKIN_BATCH_KEY, JSON.stringify(quickStockInBatch));
    queueDraftNasSave();
  }

  function normalizeStocktakeDraftPayload(saved) {
    saved = saved || {};
    return {
      warehouse: saved.warehouse || stocktakeDraft.warehouse || localStorage.getItem(STOCKTAKE_WAREHOUSE_KEY) || (state.warehouses && state.warehouses[0]) || '',
      lines: Array.isArray(saved.lines) ? saved.lines.map(function (line) {
        return Object.assign({}, line || {});
      }).filter(function (line) {
        return line.key || line.productId || line.skuId || line.skuCode || line.companyCode;
      }) : [],
      compareStarted: !!saved.compareStarted,
      updatedAt: saved.updatedAt || ''
    };
  }

  function saveStocktakeDraft() {
    state.stocktakeDraft = normalizeStocktakeDraftPayload({
      warehouse: stocktakeDraft.warehouse,
      lines: stocktakeDraft.lines,
      compareStarted: stocktakeDraft.compareStarted,
      updatedAt: new Date().toISOString()
    });
    localStorage.setItem('lingzanzan-v1-stocktake-draft', JSON.stringify(state.stocktakeDraft));
    queueDraftNasSave();
  }

  function clearStocktakeDraftStorage() {
    state.stocktakeDraft = normalizeStocktakeDraftPayload({
      warehouse: stocktakeDraft.warehouse,
      lines: [],
      compareStarted: false,
      updatedAt: new Date().toISOString()
    });
    localStorage.setItem('lingzanzan-v1-stocktake-draft', JSON.stringify(state.stocktakeDraft));
    queueDraftNasSave();
  }

  function queueDraftNasSave() {
    clearTimeout(draftNasSaveTimer);
    draftNasSaveTimer = setTimeout(function () {
      if (draftNasSaveBusy) {
        queueDraftNasSave();
        return;
      }
      draftNasSaveBusy = true;
      saveLocal().catch(function () {}).finally(function () {
        draftNasSaveBusy = false;
      });
    }, 500);
  }

  function normalizeQuickStockInBatchItem(item) {
    item = item || {};
    var raw = normalizeScanCode(item.scan || item.raw || item.sku || '');
    if (!raw) return item;
    var parsed = stocktakeParsedPending(raw, item.qty || 1);
    var product = quickStockInProductByCode(parsed.productCode) || quickStockInProductByCode(raw);
    item.scan = raw;
    item.productCode = (product && (product.code || product.id)) || parsed.productCode || item.productCode || raw;
    item.colorName = parsed.colorName || item.colorName || '待補顏色';
    item.sizeName = parsed.sizeName || item.sizeName || 'NO SIZE';
    item.cost = Number(parsed.cost || item.cost || 0);
    if (isInvalidShelfName(item.shelf)) item.shelf = '';
    if (isInvalidLayerName(item.layer)) item.layer = '';
    item.matched = !!product;
    if (!item.image && product) item.image = quickStockInImageFromProduct(product, item.colorName, item.colorCode);
    return item;
  }

  function quickStockInBatchKey(item) {
    return [normalizeScanCode(item.scan), item.warehouse || '', item.shelf || '', item.layer || '', item.image ? 'img' : ''].join('::');
  }

  function quickStockInPreviewData(scan, qty, warehouse, shelf, layer) {
    var raw = normalizeScanCode(scan);
    var parsed = stocktakeParsedPending(raw, qty);
    var candidates = stocktakeCandidates(raw);
    var product = (candidates[0] && candidates[0].product) || quickStockInProductByCode(parsed.productCode) || quickStockInProductByCode(raw);
    var noSizeColorParsed = parseLegacyNoSizeColorBarcode(raw);
    if (product && productSupportsNoSize(product) && noSizeColorParsed && noSizeColorParsed.productCode === parsed.productCode) {
      parsed.cost = Number(noSizeColorParsed.cost || parsed.cost || 0);
      parsed.colorCode = noSizeColorParsed.colorCode || parsed.colorCode;
      parsed.colorName = noSizeColorParsed.colorName || parsed.colorName;
      parsed.sizeCode = noSizeColorParsed.sizeCode || parsed.sizeCode;
      parsed.sizeName = noSizeColorParsed.sizeName || parsed.sizeName || 'NO SIZE';
    }
    return { raw: raw, parsed: parsed, product: product, warehouse: warehouse, shelf: String(shelf || '').trim(), layer: String(layer || '').trim(), qty: Math.max(1, Number(qty || 1)) };
  }

  function renderQuickStockInBatch() {
    var panel = document.querySelector('[data-quick-stockin-panel]');
    if (!panel) return;
    var log = panel.querySelector('[data-quick-stockin-log]');
    if (!log) return;
    loadQuickStockInBatch();
    if (!quickStockInBatch.length) {
      log.innerHTML = '<div class="quick-stockin-empty">本輪尚未加入待入庫商品。</div>';
      return;
    }
    var totalQty = quickStockInBatch.reduce(function (sum, item) { return sum + Number(item.qty || 0); }, 0);
    var warehouseSummary = {};
    quickStockInBatch.forEach(function (item) {
      warehouseSummary[item.warehouse || '未選倉'] = (warehouseSummary[item.warehouse || '未選倉'] || 0) + Number(item.qty || 0);
    });
    var summaryText = Object.keys(warehouseSummary).map(function (name) {
      return name + ' ' + warehouseSummary[name] + ' 件';
    }).join(' / ');
    log.innerHTML = [
      '<div class="quick-stockin-batch-summary"><b>待入庫 ' + quickStockInBatch.length + ' 筆 / ' + totalQty + ' 件</b><span>' + escapeHtml(summaryText) + '</span></div>',
      '<div class="quick-stockin-batch-list">',
      quickStockInBatch.map(function (item, index) {
        return '<article><strong>' + escapeHtml(item.productCode || '-') + '</strong><span>' + escapeHtml(item.colorName || '-') + ' / ' + escapeHtml(item.sizeName || 'NO SIZE') + '</span><em>' + escapeHtml(item.warehouse || '-') + ' / +' + Number(item.qty || 1) + '</em><small>' + escapeHtml(item.scan || '') + '</small><button type="button" data-quick-stockin-remove="' + index + '">移除</button></article>';
      }).join(''),
      '</div>'
    ].join('');
  }

  function renderQuickStockInPanel() {
    var panel = document.querySelector('[data-quick-stockin-panel]');
    if (!panel) return;
    var warehouse = panel.querySelector('[data-quick-stockin-warehouse]');
    var shelf = panel.querySelector('[data-quick-stockin-shelf]');
    var layer = panel.querySelector('[data-quick-stockin-layer]');
    if (warehouse) {
      var current = quickStockInWarehouseValue();
      warehouse.innerHTML = quickStockInWarehouseOptions(current);
      warehouse.value = quickStockInWarehouses().indexOf(current) === -1 ? quickStockInWarehouses()[0] : current;
    }
    if (shelf) {
      shelf.innerHTML = quickStockInLocationOptions(state.shelves || [], quickStockInShelfValue(), '不指定貨架');
