  function renderPeopleLists() {
    var memberSummary = document.querySelector('[data-member-summary]');
    var memberList = document.querySelector('[data-member-list]');
    var salesSummary = document.querySelector('[data-sales-summary]');
    var salesList = document.querySelector('[data-sales-list]');
    var memberQuery = (document.querySelector('[data-member-search]')?.value || '').trim().toLowerCase();
    var deliveryFilter = document.querySelector('[data-member-delivery-filter]')?.value || 'all';
    var typeFilter = document.querySelector('[data-member-type-filter]')?.value || 'tw';
    var filteredMembers = state.members.map(function (item, index) {
      return { item: item, index: index };
    }).filter(function (entry) {
      var item = entry.item;
      var rank = memberSearchRank(item, memberQuery);
      var text = [item.name, item.phone, item.address, item.note, item.deliveryLabel, item.shippingFee, item.customerTypeLabel].join(' ').toLowerCase();
      var looseText = searchLooseNormalize(text);
      var phoneText = searchPhoneDigits([item.phone, text].join(' '));
      var looseQuery = searchLooseNormalize(memberQuery);
      var phoneQuery = searchPhoneDigits(memberQuery);
      var matchQuery = !memberQuery || rank < 9999 || (looseQuery && looseText.indexOf(looseQuery) !== -1) || (phoneQuery && phoneText.indexOf(phoneQuery) !== -1);
      var matchDelivery = deliveryFilter === 'all' || item.deliveryType === deliveryFilter;
      var matchType = typeFilter === 'all' || (item.customerType || 'tw') === typeFilter;
      return matchQuery && matchDelivery && matchType;
    }).sort(function (a, b) {
      var rankA = memberSearchRank(a.item, memberQuery);
      var rankB = memberSearchRank(b.item, memberQuery);
      if (rankA !== rankB) return rankA - rankB;
      var nameA = searchLooseNormalize(a.item.name || '');
      var nameB = searchLooseNormalize(b.item.name || '');
      if (nameA !== nameB) return nameA.localeCompare(nameB, 'zh-Hant', { numeric: true });
      return a.index - b.index;
    });
    if (memberSummary) memberSummary.textContent = '會員總數 ' + state.members.length + ' 筆，符合 ' + filteredMembers.length + ' 筆，目前顯示前 10 筆。';
    if (memberList) memberList.innerHTML = filteredMembers.slice(0, 10).map(function (entry) {
      var item = entry.item;
      var shipping = item.deliveryLabel ? item.deliveryLabel + ' / 運費 ' + (item.shippingFee || 0) + ' / ' + (item.paymentLabel || '貨到付款') : '';
      return [
        '<article class="compact-row member-row">',
        '<input type="checkbox" data-member-check="' + entry.index + '" aria-label="選取會員">',
        '<b>' + item.name + '</b>',
        '<span>' + item.phone + '</span>',
        '<span>' + (item.customerTypeLabel || '台灣客戶') + '</span>',
        '<span>' + (item.address && item.address !== '-' ? item.address : '尚無地址') + '</span>',
        '<span>' + shipping + '</span>',
        '<button type="button" data-edit-member="' + entry.index + '">編輯</button>',
        '<button type="button" data-remove-member="' + entry.index + '">刪除</button>',
        '</article>'
      ].join('');
    }).join('') || '<div class="empty">尚未建立會員。</div>';

    if (salesSummary) salesSummary.textContent = '業務帳號總數 ' + state.salesCustomers.length + ' 筆。';
    if (salesList) salesList.innerHTML = state.salesCustomers.slice(0, 50).map(function (item, index) {
