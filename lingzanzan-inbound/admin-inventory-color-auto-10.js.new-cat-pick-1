  function sheetStockKey(code, colorCode, colorName, size) {
    return [
      normalizeVerifyCode(code),
      colorCode ? ('CODE:' + normalizeScanCode(colorCode)) : ('NAME:' + strictColorDisplayName(colorName).toUpperCase()),
      normalizeVerifySize(size)
    ].join('|');
  }

  function parseTaiwanSheetStockCsv(csv) {
    var rows = parseCsv(csv);
    var header = rows[1] || [];
    var sizeStart = 36;
    var sizeEnd = 51;
    var sizes = [];
    for (var c = sizeStart; c <= sizeEnd; c += 1) {
      sizes.push(normalizeSizeLabel(header[c] || ''));
    }
    ['S', 'M', 'L', 'XL', '2XL', '3XL', 'NO SIZE', '36', '37', '38', '39', '40', '41', '42', '43', '44'].forEach(function (label, index) {
      if (!sizes[index]) sizes[index] = label;
    });
    var currentCode = '';
    var currentLocation = { shelf: '', layer: '', label: '' };
    var sheetMap = {};
    var colors = {};
    var rowCount = 0;
    rows.slice(2).forEach(function (row, rowIndex) {
      var rowNumber = rowIndex + 3;
      var first = String(row[0] || '').trim();
      var second = String(row[1] || '').trim();
      var location = !second ? parseLocationRow(first) : null;
      if (location) {
        currentLocation = {
          shelf: location.shelf || '',
          layer: location.layer || '',
          label: first
        };
        return;
      }
      if (first) currentCode = normalizeSheetProductCode(first);
      var color = second;
      if (!currentCode || !color) return;
      rowCount += 1;
      colors[color] = true;
      var colorInfo = strictColorInfo(color);
      for (var c = sizeStart; c <= sizeEnd; c += 1) {
        var size = sizes[c - sizeStart] || 'NO SIZE';
        var qty = Number(String(row[c] || '').replace(/[^\d.-]/g, '')) || 0;
        var key = sheetStockKey(currentCode, colorInfo.code, color, size);
        if (!sheetMap[key]) {
          sheetMap[key] = {
            key: key,
            code: currentCode,
            color: color,
            colorCode: colorInfo.code,
            colorTableName: colorInfo.tableName,
            size: normalizeVerifySize(size),
            sheetQty: 0,
            rows: [],
            warehouses: [],
            sample: String(row[2] || '').trim(),
            colorKnown: !!colorInfo.code
          };
        }
        sheetMap[key].sheetQty += qty;
        if (sheetMap[key].rows.indexOf(rowNumber) === -1) sheetMap[key].rows.push(rowNumber);
        if (currentLocation.label && sheetMap[key].warehouses.indexOf(currentLocation.label) === -1) sheetMap[key].warehouses.push(currentLocation.label);
      }
    });
    return {
      rows: rows,
      rowCount: rowCount,
      sizes: sizes,
      colors: Object.keys(colors).sort(function (a, b) { return a.localeCompare(b, 'zh-Hant'); }),
      sheetMap: sheetMap
    };
  }

  function buildStrictTaiwanBackendStockIndex() {
