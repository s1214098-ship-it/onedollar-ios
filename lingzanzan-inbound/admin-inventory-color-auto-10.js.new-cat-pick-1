  function addAdminShipmentSkuQty(key, qty, priceOverride, silent) {
    var row = adminShipmentFindRow(key);
    if (!row) { if (!silent) toast('找不到商品 SKU'); return false; }
    qty = Math.max(1, Number(qty || 1));
    var stock = Number(row.sku.stock || 0);
    var skuId = row.sku.id || row.sku.sku || '';
    var existingIndex = adminShipmentItems.findIndex(function (item) { return String(item.skuId || item.sku || '') === String(skuId); });
    var existingQty = existingIndex > -1 ? Number(adminShipmentItems[existingIndex].qty || 0) : 0;
    if (stock < existingQty + qty) { if (!silent) toast('庫存不足：目前剩 ' + stock + ' 件，已選 ' + existingQty + ' 件'); return false; }
    var item = adminShipmentBuildItem(row, qty, priceOverride);
    if (existingIndex > -1) {
      adminShipmentItems[existingIndex].qty = existingQty + qty;
      adminShipmentItems[existingIndex].price = item.price;
    } else {
      adminShipmentItems.push(item);
    }
    return true;
  }

