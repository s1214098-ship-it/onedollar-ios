      return res.text();
    }).catch(function () {
      return fetch('https://docs.google.com/spreadsheets/d/1W1mXSNeDe3OPFYnAS2djTOGg0dqQktbkTzZ2kxxVk4w/export?format=csv&gid=1888755320&_=' + Date.now(), { cache: 'no-store' }).then(function (res) {
        if (!res.ok) throw new Error('Google Sheet ' + res.status);
        return res.text();
      });
    }).then(function (csv) {
      var rows = parseCsv(csv);
      var header = rows[1] || [];
      var sizeStart = 36;
      var sizeEnd = 51;
      var sizeLabels = [];
      for (var c = sizeStart; c <= sizeEnd; c += 1) {
        sizeLabels.push(normalizeSizeLabel(header[c]));
      }
      ['S', 'M', 'L', 'XL', '2XL', '3XL', 'NO SIZE'].forEach(function (label, index) {
        if (!sizeLabels[index]) sizeLabels[index] = label;
      });
      var currentCode = '';
      var currentLocation = {};
      var colors = [];
      var sizes = [];
      var stocks = {};
      var shelves = [];
      var layers = [];
      rows.slice(2).forEach(function (row) {
        var first = String(row[0] || '').trim();
        var location = !String(row[1] || '').trim() ? parseLocationRow(first) : null;
        if (location) {
          currentLocation = location;
          return;
        }
        if (first) currentCode = normalizeSheetProductCode(first);
        if (currentCode !== code) return;
        var color = String(row[1] || '').trim();
        if (!color) return;
        if (!colors.some(function (item) { return item.name === color; })) colors.push({ name: color, image: '' });
        if (currentLocation.shelf && !isInvalidShelfName(currentLocation.shelf) && shelves.indexOf(currentLocation.shelf) === -1) shelves.push(currentLocation.shelf);
        if (currentLocation.layer && !isInvalidLayerName(currentLocation.layer) && layers.indexOf(currentLocation.layer) === -1) layers.push(currentLocation.layer);
        for (var c = sizeStart; c <= sizeEnd; c += 1) {
          var size = sizeLabels[c - sizeStart];
          var qty = Number(String(row[c] || '').replace(/[^\d.-]/g, '')) || 0;
          if (qty <= 0) continue;
          if (!size) size = 'NO SIZE';
          if (sizes.indexOf(size) === -1) sizes.push(size);
          stocks[color + '||' + size] = (stocks[color + '||' + size] || 0) + qty;
        }
      });
