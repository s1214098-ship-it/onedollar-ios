      var colorCode = strictSkuColorCode(sku);
      var size = strictSkuSizeName(sku);
      var productKey = normalizeVerifyCode(code);
      if (!byProduct[productKey]) byProduct[productKey] = [];
      byProduct[productKey].push(sku);
      var key = sheetStockKey(code, colorCode, colorName, size);
