  var stockVerifyLast = null;
  var stockVerifyNeedsRefresh = false;

  function markStockVerifyNeedsRefresh(message) {
    stockVerifyNeedsRefresh = true;
    var summary = document.querySelector('[data-stock-verify-summary]');
    var panel = document.querySelector('[data-stock-verify-panel]');
    if (summary) {
      summary.textContent = message || '庫存數量已修改，請貼上雲端表 AK:AZ 並按「開始比對」核對台灣倉差異';
      summary.classList.add('needs-check');
    }
    if (panel) panel.classList.add('needs-check');
  }

  function clearStockVerifyReminder() {
    stockVerifyNeedsRefresh = false;
    var summary = document.querySelector('[data-stock-verify-summary]');
    var panel = document.querySelector('[data-stock-verify-panel]');
    if (summary) summary.classList.remove('needs-check');
    if (panel) panel.classList.remove('needs-check');
  }

  function normalizeVerifyText(value) {
    return String(value == null ? '' : value).trim();
  }

  function normalizeVerifyCode(value) {
    return normalizeVerifyText(value).toUpperCase().replace(/\s+/g, '');
  }

  function normalizeVerifyColor(value) {
    return normalizeVerifyText(value).replace(/色$/g, '').toLowerCase();
  }

  function normalizeVerifySize(value) {
    var text = normalizeVerifyText(value).toUpperCase();
    if (!text || /NO\s*SIZE|FREE|FREESIZE|無|无/.test(text)) return 'NO SIZE';
    return text.replace(/\s+/g, '');
  }

  function parseStockVerifyRows(raw) {
    raw = String(raw || '').trim();
    if (!raw) return [];
    return raw.split(/\r?\n/).map(function (line) {
      return line.split(/\t|,/).map(function (cell) { return normalizeVerifyText(cell); });
    }).filter(function (row) { return row.some(Boolean); });
  }

  function stockVerifyHeaderMap(header) {
    var map = {};
    header.forEach(function (cell, index) {
      var text = normalizeVerifyText(cell).toLowerCase();
      if (/商品|產品|产品|編號|编号|款號|款号|code|barcode|sku|條碼|条码/.test(text) && map.code == null) map.code = index;
      if (/顏色|颜色|warna|color/.test(text) && map.color == null) map.color = index;
      if (/尺寸|尺碼|尺码|ukuran|size/.test(text) && map.size == null) map.size = index;
      if (/數量|数量|庫存|库存|現貨|现货|stock|qty|台灣|台湾/.test(text) && map.qty == null) map.qty = index;
    });
    return map;
  }

  function looksLikeHeader(row) {
    return row.join(' ').match(/商品|產品|产品|編號|编号|顏色|颜色|尺寸|庫存|库存|stock|qty|barcode|sku/i);
  }

  function inferStockVerifyRow(row, map) {
    var code = map.code != null ? row[map.code] : '';
    var color = map.color != null ? row[map.color] : '';
    var size = map.size != null ? row[map.size] : '';
    var qty = map.qty != null ? row[map.qty] : '';
    if (!code) {
      var codeCell = row.find(function (cell) { return /^[A-Z]{1,4}\d{1,5}(?:[-_][A-Z0-9]+){0,3}$/i.test(cell); });
      code = codeCell || '';
    }
    if (!qty) {
      for (var i = row.length - 1; i >= 0; i -= 1) {
        var n = Number(String(row[i]).replace(/[^0-9.-]/g, ''));
        if (Number.isFinite(n) && String(row[i]).match(/\d/)) {
          qty = String(n);
          break;
        }
      }
    }
    return {
      raw: row,
      code: normalizeVerifyCode(code),
      color: normalizeVerifyText(color),
      size: normalizeVerifyText(size),
      qty: Number(String(qty).replace(/[^0-9.-]/g, ''))
    };
  }

  function productCodeById(productId) {
    var product = state.products.find(function (item) { return String(item.id || '') === String(productId || ''); });
    return normalizeVerifyCode(product && (product.code || product.productLine));
  }

  function isTaiwanSku(sku) {
    var text = [sku.warehouseCode, sku.warehouseName, sku.warehouse].join(' ');
    return !text.trim() || /TW|台灣|台湾/i.test(text);
  }

  function stockVerifyKey(code, color, size) {
    return [normalizeVerifyCode(code), normalizeVerifyColor(color), normalizeVerifySize(size)].join('|');
  }

  function buildBackendStockIndex() {
    var index = {};
    state.skus.filter(isTaiwanSku).forEach(function (sku) {
      var code = productCodeById(sku.productId) || normalizeVerifyCode(sku.sku || sku.id).split('-')[0];
      var key = stockVerifyKey(code, sku.colorName || sku.color, sku.sizeName || sku.size);
      if (!index[key]) {
        index[key] = {
          code: code,
          color: sku.colorName || sku.color || '',
          size: sku.sizeName || sku.size || 'NO SIZE',
          backendQty: 0,
          skus: []
        };
      }
      index[key].backendQty += Number(sku.stock || 0);
      index[key].skus.push(sku.sku || sku.id || '');
    });
    return index;
  }

  function compareStockVerify() {
    var input = document.querySelector('[data-stock-verify-input]');
    var summary = document.querySelector('[data-stock-verify-summary]');
    var results = document.querySelector('[data-stock-verify-results]');
    if (!input || !results) return;
    var rows = parseStockVerifyRows(input.value);
    if (!rows.length) {
      toast('請先貼上 AK:AZ 資料');
      return;
    }
    var header = looksLikeHeader(rows[0]) ? rows.shift() : [];
    var map = header.length ? stockVerifyHeaderMap(header) : {};
    var backend = buildBackendStockIndex();
    var sheetMap = {};
    var problems = [];
    var matched = [];
    rows.forEach(function (row, index) {
      var item = inferStockVerifyRow(row, map);
      item.rowNumber = index + 1 + (header.length ? 1 : 0);
      if (!item.code || !Number.isFinite(item.qty)) {
        problems.push(Object.assign(item, { problem: '缺商品編號或數量，需人工核對' }));
        return;
      }
      var key = stockVerifyKey(item.code, item.color, item.size);
      if (!sheetMap[key]) sheetMap[key] = Object.assign({}, item, { sheetQty: 0, rows: [] });
      sheetMap[key].sheetQty += item.qty;
      sheetMap[key].rows.push(item.rowNumber);
    });
    Object.keys(sheetMap).forEach(function (key) {
      var item = sheetMap[key];
      var back = backend[key];
      if (!back) {
        problems.push(Object.assign(item, { problem: '表上有，後台台灣倉找不到相同商品/顏色/尺寸' }));
        return;
      }
      var diff = item.sheetQty - back.backendQty;
      var row = Object.assign(item, {
        backendQty: back.backendQty,
        diff: diff,
        backendSkus: back.skus.join(' / '),
        backendColor: back.color,
        backendSize: back.size,
        problem: diff === 0 ? '' : '數量不同'
      });
      if (diff === 0) matched.push(row);
      else problems.push(row);
    });
    Object.keys(backend).forEach(function (key) {
      if (sheetMap[key]) return;
      var back = backend[key];
      if (Number(back.backendQty || 0) === 0) return;
      problems.push({
        code: back.code,
        color: back.color,
        size: back.size,
        sheetQty: 0,
        backendQty: back.backendQty,
        diff: -back.backendQty,
        backendSkus: back.skus.join(' / '),
        problem: '後台有台灣倉庫存，但表上沒有'
      });
    });
    stockVerifyLast = { matched: matched, problems: problems, createdAt: new Date().toISOString() };
    clearStockVerifyReminder();
    if (summary) summary.textContent = '比對完成：正常 ' + matched.length + ' 筆；問題 ' + problems.length + ' 筆';
    renderStockVerifyResults();
    toast('庫存核對完成，問題資料已分出來');
  }

  function stockVerifyCsv(rows) {
    var header = ['狀態','商品編號','顏色','尺寸','表格數量','後台台灣倉','差異','問題','後台SKU','表格列'];
    var body = rows.map(function (row) {
      return [
        row.problem ? '問題' : '正常',
        row.code || '',
        row.color || row.backendColor || '',
        row.size || row.backendSize || '',
        row.sheetQty != null ? row.sheetQty : row.qty,
        row.backendQty != null ? row.backendQty : '',
        row.diff != null ? row.diff : '',
        row.problem || '',
        row.backendSkus || '',
        (row.rows || [row.rowNumber || '']).join('/')
      ];
    });
    return [header].concat(body).map(function (row) {
      return row.map(function (cell) {
        cell = String(cell == null ? '' : cell);
        return '"' + cell.replace(/"/g, '""') + '"';
      }).join(',');
    }).join('\n');
  }

  function renderStockVerifyResults() {
    var results = document.querySelector('[data-stock-verify-results]');
    if (!results || !stockVerifyLast) return;
    function table(title, rows, emptyText) {
      return [
        '<article class="stock-verify-table"><h4>' + title + ' <span>' + rows.length + '</span></h4>',
        rows.length ? '<table><thead><tr><th>商品</th><th>顏色</th><th>尺寸</th><th>表格</th><th>後台</th><th>差異</th><th>問題</th></tr></thead><tbody>' + rows.slice(0, 300).map(function (row) {
          return '<tr><td>' + escapeHtml(row.code || '') + '</td><td>' + escapeHtml(row.color || row.backendColor || '') + '</td><td>' + escapeHtml(row.size || row.backendSize || '') + '</td><td>' + escapeHtml(row.sheetQty != null ? row.sheetQty : row.qty) + '</td><td>' + escapeHtml(row.backendQty != null ? row.backendQty : '') + '</td><td>' + escapeHtml(row.diff != null ? row.diff : '') + '</td><td>' + escapeHtml(row.problem || '') + '</td></tr>';
        }).join('') + '</tbody></table>' : '<p class="muted">' + emptyText + '</p>',
        rows.length > 300 ? '<p class="muted">只顯示前 300 筆，完整資料請下載 CSV。</p>' : '',
        '</article>'
      ].join('');
    }
    results.innerHTML = table('有問題需核對', stockVerifyLast.problems, '目前沒有問題資料') + table('比對正常', stockVerifyLast.matched, '目前沒有正常資料');
  }

  function copyStockVerifyProblems() {
    if (!stockVerifyLast) {
      toast('請先開始比對');
      return;
    }
    var text = stockVerifyCsv(stockVerifyLast.problems);
    navigator.clipboard.writeText(text).then(function () {
      toast('問題清單已複製，可以貼給小姐核對');
    }).catch(function () {
      toast('複製失敗，請改用下載 CSV');
    });
  }

  function downloadStockVerifyCsv() {
    if (!stockVerifyLast) {
      toast('請先開始比對');
      return;
    }
    var rows = stockVerifyLast.problems.concat(stockVerifyLast.matched);
    var blob = new Blob(['\uFEFF' + stockVerifyCsv(rows)], { type: 'text/csv;charset=utf-8' });
    var url = URL.createObjectURL(blob);
    var a = document.createElement('a');
    a.href = url;
    a.download = 'taiwan-stock-verify-' + Date.now() + '.csv';
    a.click();
    URL.revokeObjectURL(url);
    toast('已下載核對 CSV');
  }


  function inventoryProductImages(product) {
    /* LZ_COLOR_AS_MAIN_20260926: 只有一張顏色圖時，那張就是主圖，不要再列舊主圖。 */
    var seen = {};
    var images = [];
    function push(src, label, colorName, stock) {
      src = String(src || '').trim();
      if (!src || seen[src]) return;
      seen[src] = true;
      images.push({
        src: src,
        label: label || '產品照片',
        colorName: colorName || '',
        stock: stock
      });
    }
    var colorRows = (product.colors || []).filter(function (color) {
      return color && String(color.image || '').trim();
    });
    if (colorRows.length) {
      colorRows.forEach(function (color, index) {
        var colorSkus = productSkus(state.skus, product.id).filter(function (sku) {
          return (sku.colorName || sku.color || '') === color.name || (sku.colorName || sku.color || '') === color.code;
        });
        var colorStock = colorSkus.reduce(function (sum, sku) { return sum + Number(sku.stock || 0); }, 0);
        push(color.image, index === 0 ? '主圖／顏色圖' : '顏色圖', color.name || color.code || '', colorStock);
      });
      var firstColorSrc = String(colorRows[0].image || '').trim();
      var oldMain = String(product.mainImage || '').trim();
      (product.images || []).forEach(function (src, index) {
        src = String(src || '').trim();
        if (colorRows.length === 1 && oldMain && src === oldMain && src !== firstColorSrc) return;
        push(src, '替代圖 ' + (index + 1), '', null);
      });
      return images;
    }
    push(product.mainImage, '主圖', '', null);
    (product.images || []).forEach(function (src, index) {
      push(src, '照片 ' + (index + 1), '', null);
    });
    return images;
  }

  function inventoryColorSummary(product) {
    var groups = {};
    productSkus(state.skus, product.id).forEach(function (sku) {
      var color = sku.colorName || sku.color || '未填顏色';
