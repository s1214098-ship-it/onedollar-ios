        var location = productLocation(product, [sku]);
        var skuWarehouse = sku.warehouseName || sku.warehouse || location.warehouse;
        if (!(matchesFilter(location.warehouse, warehouse) || matchesFilter(skuWarehouse, warehouse))) return;
        var text = [
          product.code,
