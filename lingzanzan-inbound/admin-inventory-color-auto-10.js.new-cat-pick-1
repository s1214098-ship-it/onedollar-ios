  // LZ_CN_PREFIX_PICK_20260924: China/old barcodes keep only the product prefix.
  // Color, size and qty are chosen against the new Taiwan/system SKUs, then the
  // old scan is stored as an alias so both warehouses share one barcode family.
  function isOldStyleProductBarcode(raw) {
    var parsed = null;
    try { parsed = parseLegacyProductBarcode(raw); } catch (error) { parsed = null; }
    if (!parsed || !parsed.productCode) return false;
    return parsed.format === 'legacy' || parsed.format === 'v2';
  }

  function inventoryProductByPrefix(prefix) {
    var wanted = normalizeScanCode(prefix);
    if (!wanted) return null;
    return (state.products || []).find(function (product) {
