  function adminShipmentMarginSummary() {
    var productSales = adminShipmentLineTotal();
    var productCost = adminShipmentProductCostTotal();
    var productProfit = productSales - productCost;
    var shipping = adminShipmentCurrentShippingInfo();
    var shippingProfit = Number(shipping.fee || 0) - Number(shipping.cost || 0);
    var grossProfit = productProfit + shippingProfit;
    var businessCommission = productProfit > 0 ? Math.round(productProfit * 0.3) : 0;
    var companyProductLoss = productProfit < 0 ? Math.abs(productProfit) : 0;
    return {
      productSales: productSales,
      productCost: productCost,
      productProfit: productProfit,
      shippingFee: Number(shipping.fee || 0),
      shippingCost: Number(shipping.cost || 0),
      shippingProfit: shippingProfit,
      grossProfit: grossProfit,
      businessCommissionRate: 0.3,
      businessCommission: businessCommission,
      companyProductLoss: companyProductLoss,
      companyShippingLossOnReturn: Number(shipping.cost || 0),
      marginStatus: productProfit < 0 ? 'loss_company_absorb' : 'calculated'
