  function stocktakeCompareData() {
    var warehouseRows = stocktakeWarehouseRows();
    var lineMap = {};
    stocktakeDraft.lines.filter(function (line) {
      return line.warehouse === stocktakeDraft.warehouse;
    }).forEach(function (line) {
      lineMap[line.key] = line;
    });
    var expectedRows = warehouseRows.filter(function (row) {
      return Number(row.systemStock || 0) > 0;
    });
    var rows = warehouseRows.filter(function (row) {
      return Number(row.systemStock || 0) > 0 || !!lineMap[row.key];
    });
    var countedSku = 0;
    var countedQty = 0;
    var systemQty = 0;
    var plusQty = 0;
    var minusQty = 0;
    var compareRows = rows.map(function (row) {
      var line = lineMap[row.key];
      var counted = !!line;
      var expected = Number(row.systemStock || 0) > 0;
      var countedLineQty = counted ? Number(line.countedQty || 0) : 0;
      var diff = counted ? countedLineQty - row.systemStock : 0;
      if (expected) systemQty += row.systemStock;
      if (counted) {
        if (expected) countedSku += 1;
        countedQty += countedLineQty;
        if (diff > 0) plusQty += diff;
        if (diff < 0) minusQty += Math.abs(diff);
      }
      return {
        key: row.key,
        productId: row.productId,
        skuId: row.skuId,
        image: row.image,
        productCode: row.productCode,
        skuCode: row.skuCode,
        color: row.color,
        size: row.size,
        systemStock: row.systemStock,
        countedQty: countedLineQty,
        diff: diff,
        counted: counted,
        expected: expected
      };
    });
    return {
      rows: compareRows,
      totalSku: expectedRows.length,
      countedSku: countedSku,
      uncountedSku: Math.max(0, expectedRows.length - countedSku),
      systemQty: systemQty,
      countedQty: countedQty,
      plusQty: plusQty,
      minusQty: minusQty,
      netDiff: plusQty - minusQty
    };
  }

