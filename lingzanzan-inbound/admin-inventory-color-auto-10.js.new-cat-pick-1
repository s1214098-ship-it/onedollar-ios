      return row.id === item.id || row.name === item.name;
    });
    if (!item.id) item.id = 'platform-' + Date.now();
    if (existingIndex >= 0) state.purchasePlatforms[existingIndex] = Object.assign({}, state.purchasePlatforms[existingIndex], item);
