  function warehouseImportCode(value, fallback) {
    var text = String(value || '').trim();
    var lower = text.toLowerCase();
    if (!text) return fallback || 'TW';
    if (text === 'TW' || text.indexOf('台灣') !== -1 || lower.indexOf('taiwan') !== -1) return 'TW';
    if (text === 'CN' || text.indexOf('中國') !== -1 || lower.indexOf('china') !== -1) return 'CN';
    if (text === 'ID' || text.indexOf('印尼') !== -1 || lower.indexOf('indonesia') !== -1) return 'ID';
    return fallback || text;
  }

  function warehouseImportName(code) {
    code = warehouseImportCode(code, 'TW');
    if (code === 'CN') return '中國倉';
    if (code === 'ID') return '印尼倉';
    return '台灣倉';
  }

  function normalizeImportKey(value) {
    return String(value || '').trim().toLowerCase().replace(/\s+/g, '');
  }

  function warehouseImportHeaderIndex(headers, names) {
    var keys = headers.map(normalizeImportKey);
    for (var i = 0; i < names.length; i += 1) {
      var needle = normalizeImportKey(names[i]);
      var found = keys.indexOf(needle);
      if (found >= 0) return found;
    }
    return -1;
  }

  function parseWarehouseCatalogRows(text, fallbackWarehouse) {
    var lines = String(text || '').split(/\r?\n/).map(function (line) { return line.trim(); }).filter(Boolean);
    if (!lines.length) return [];
    var first = lines[0].split(/\t|,/).map(function (cell) { return cell.trim(); });
    var hasHeader = first.some(function (cell) {
      return /倉|warehouse|產品|條碼|barcode|顏色|color|尺寸|size|sku/i.test(cell);
    });
    var headers = hasHeader ? first : [];
    var rows = hasHeader ? lines.slice(1) : lines;
    function col(cells, names, fallbackIndex) {
      var index = headers.length ? warehouseImportHeaderIndex(headers, names) : -1;
      if (index < 0) index = fallbackIndex;
      return String(cells[index] || '').trim();
    }
    return rows.map(function (line) {
      var cells = line.split(/\t|,/).map(function (cell) { return cell.trim(); });
      return {
        warehouseCode: warehouseImportCode(col(cells, ['倉別', '貨倉', 'warehouse', 'gudang'], 0), fallbackWarehouse),
        productCode: col(cells, ['產品條碼', '商品條碼', '產品編號', '商品編號', 'barcode', 'product barcode', 'code'], 1),
        title: col(cells, ['產品名稱', '商品名稱', '品名', 'title', 'name'], 2),
        category: col(cells, ['分類', 'category'], 3),
        brand: col(cells, ['品牌', 'brand'], -1),
        spec: col(cells, ['規格', 'spec', 'specification'], -1),
        color: col(cells, ['顏色', 'color', 'warna'], 4),
        colorCode: col(cells, ['顏色碼', '色碼', 'color code', 'kode warna'], 5),
        size: col(cells, ['尺寸', '尺碼', 'size', 'ukuran'], 6),
        skuBarcode: col(cells, ['SKU條碼', 'SKU', 'sku barcode', '進銷存碼'], 7),
        price: col(cells, ['售價', '價格', 'price'], 8),
        cost: col(cells, ['成本', 'cost'], 9),
        shelf: col(cells, ['貨架', '架位', 'shelf'], 10),
        layer: col(cells, ['層位', '層', 'layer'], 11)
      };
    }).filter(function (row) {
      return row.productCode && (row.color || row.colorCode);
    });
  }

  function safeSkuPart(value) {
    return String(value || '').trim().toUpperCase().replace(/[^A-Z0-9]+/g, '-').replace(/^-+|-+$/g, '') || 'NA';
  }

  function importWarehouseCatalogBasics() {
    var textEl = document.querySelector('[data-warehouse-catalog-text]');
    var defaultEl = document.querySelector('[data-warehouse-catalog-default]');
    var resultEl = document.querySelector('[data-warehouse-catalog-result]');
    if (!textEl) return;
    var fallbackWarehouse = defaultEl ? defaultEl.value : 'TW';
    var rows = parseWarehouseCatalogRows(textEl.value, fallbackWarehouse);
    if (!rows.length) {
      toast('請先貼上三倉產品基本資料');
      if (resultEl) resultEl.textContent = '沒有可匯入的資料。';
      return;
    }
    var addedProducts = 0;
    var addedSkus = 0;
    var updatedSkus = 0;
    rows.forEach(function (row) {
      var productCode = safeSkuPart(row.productCode);
      var colorCode = safeSkuPart(row.colorCode || row.color);
      var size = row.size || 'NO SIZE';
      var warehouseCode = warehouseImportCode(row.warehouseCode, fallbackWarehouse);
      var warehouseName = warehouseImportName(warehouseCode);
      var shelf = isInvalidShelfName(row.shelf) ? '' : String(row.shelf || '').trim();
      var product = state.products.find(function (item) {
        return String(item.code || item.barcode || '').toUpperCase() === productCode;
      });
      if (!product) {
        product = {
          id: 'P-' + productCode,
          code: productCode,
          barcode: productCode,
          productLine: productCodeLine(productCode),
          title: row.title || productCode,
          price: Math.max(0, Number(row.price || 0)),
          cost: Math.max(0, Number(row.cost || 0)),
          mainImage: './assets/brand-logo.png',
          images: [],
          colors: [],
          description: '',
          category: row.category || '',
          showOnWebsite: false,
          warehouseName: warehouseName,
          warehouse: warehouseName,
          shelves: shelf ? [shelf] : [],
          layers: row.layer ? [row.layer] : [],
          shelf: shelf,
          layer: row.layer || '',
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString()
        };
        state.products.unshift(product);
        addedProducts += 1;
      } else {
        product.barcode = product.barcode || productCode;
        if (row.title && !product.title) product.title = row.title;
        if (row.category && !product.category) product.category = row.category;
        if (row.brand && !product.brand) { product.brand = row.brand; product.brandName = row.brand; }
        if (row.spec && !product.spec) { product.spec = row.spec; product.specification = row.spec; }
        product.showOnWebsite = product.showOnWebsite === true ? false : product.showOnWebsite === false ? false : false;
        product.updatedAt = new Date().toISOString();
      }
      if (!Array.isArray(product.colors)) product.colors = [];
      var colorName = row.color || row.colorCode || '未填顏色';
      var colorExists = product.colors.some(function (item) {
        return String(item.name || '').trim() === colorName || String(item.code || '').trim().toUpperCase() === colorCode;
      });
      if (!colorExists) product.colors.push({ code: colorCode, name: colorName, image: '' });
      var skuId = safeSkuPart(row.skuBarcode || [productCode, colorCode, size, warehouseCode].join('-'));
      var sku = state.skus.find(function (item) {
        return String(item.id || item.sku || '').toUpperCase() === skuId;
      });
      var layer = isInvalidLayerName(row.layer) ? '' : String(row.layer || '').trim();
      if (!sku) {
        state.skus.unshift({
          id: skuId,
          sku: skuId,
          barcode: row.skuBarcode || skuId,
          productId: product.id,
          color: colorName,
          colorName: colorName,
          colorCode: colorCode,
          size: size,
          sizeName: size,
          stock: 0,
          price: Math.max(0, Number(row.price || product.price || 0)),
          cost: Math.max(0, Number(row.cost || product.cost || 0)),
          warehouse: warehouseName,
          warehouseCode: warehouseCode,
          warehouseName: warehouseName,
          status: 'active',
          shelves: shelf ? [shelf] : [],
          layers: layer ? [layer] : [],
          shelf: shelf,
          layer: layer,
          createdAt: new Date().toISOString(),
          updatedAt: new Date().toISOString()
        });
        addedSkus += 1;
      } else {
        sku.productId = sku.productId || product.id;
        sku.barcode = sku.barcode || row.skuBarcode || skuId;
        sku.color = sku.color || colorName;
        sku.colorName = sku.colorName || colorName;
        sku.colorCode = sku.colorCode || colorCode;
        sku.size = sku.size || size;
        sku.sizeName = sku.sizeName || size;
        sku.warehouse = sku.warehouse || warehouseName;
        sku.warehouseCode = sku.warehouseCode || warehouseCode;
        sku.warehouseName = sku.warehouseName || warehouseName;
        if (shelf && !sku.shelf) sku.shelf = shelf;
        if (layer && !sku.layer) sku.layer = layer;
        if (!Array.isArray(sku.shelves)) sku.shelves = shelf ? [shelf] : [];
        if (!Array.isArray(sku.layers)) sku.layers = layer ? [layer] : [];
        sku.stock = Number(sku.stock || 0);
        sku.updatedAt = new Date().toISOString();
        updatedSkus += 1;
      }
      if (warehouseName && state.warehouses.indexOf(warehouseName) === -1) state.warehouses.push(warehouseName);
      if (shelf && !isInvalidShelfName(shelf) && state.shelves.indexOf(shelf) === -1) state.shelves.push(shelf);
      if (layer && !isInvalidLayerName(layer) && state.layers.indexOf(layer) === -1) state.layers.push(layer);
    });
    if (resultEl) resultEl.textContent = '正在儲存：新增產品 ' + addedProducts + '，新增 SKU ' + addedSkus + '，補資料 ' + updatedSkus + '。庫存全部維持 0，前台不顯示。';
    saveLocal().then(function () {
      renderAll();
      renderProductCreate();
      if (resultEl) resultEl.textContent = '完成：新增產品 ' + addedProducts + '，新增 SKU ' + addedSkus + '，補資料 ' + updatedSkus + '。庫存全部維持 0，前台不顯示。';
      toast('三倉基本資料已匯入，數量未帶入');
    }).catch(function (error) {
      if (resultEl) resultEl.textContent = error.message || '儲存失敗';
      toast(error.message || '三倉基本資料匯入失敗');
    });
  }

  function fillWarehouseCatalogSample() {
    var textEl = document.querySelector('[data-warehouse-catalog-text]');
