  function adminShipmentFindRow(key) {
    var parts = String(key || '').split('::');
    return adminShipmentSkuRows().find(function (entry) {
      return String(entry.product.id || '') === parts[0] && String(entry.sku.id || entry.sku.sku || '') === parts[1];
