    });
    (state.freightTracking._importCheckpoints || []).forEach(function (item) {
      if (!(state.freightTracking.checkpoints || []).some(function (row) { return row.platform === item.platform && row.productName === item.productName; })) state.freightTracking.checkpoints.push(Object.assign({ id: 'FCP-' + Date.now() + '-' + Math.random().toString(36).slice(2, 6) }, item));
