        [item.code, item.colorCode, item.id, item.no, legacyColorCodeFromName(item.name || item.color || '')].forEach(function (value) {
          var code = normalizeScanCode(value);
          if (code && codes.indexOf(code) === -1) codes.push(code);
        });
      }
    });
    return codes;
  }

  function stocktakeLegacyMatches(product, sku, parsed) {
    if (!parsed) return false;
    var productCodes = [product.code, product.id, product.barcode, product.companyBarcode].map(normalizeScanCode);
    var productMatch = productCodes.some(function (code) {
      return code === parsed.productCode || scanFamilyCode(code) === parsed.productCode;
    });
    if (!productMatch) return false;

    if (parsed.colorCode) {
      var colorCodes = stocktakeLegacyColorCodes(product, sku);
      var colorOk = colorCodes.indexOf(parsed.colorCode) !== -1;
      if (!colorOk && parsed.colorName) {
        var parsedColorText = normalizeScanCode(parsed.colorName);
        var skuColorText = normalizeScanCode((sku.colorName || sku.color || '') + ' ' + colorCodes.map(legacyColorName).join(' '));
        colorOk = !!skuColorText && (skuColorText.indexOf(parsedColorText) !== -1 || parsedColorText.indexOf(skuColorText) !== -1);
      }
      if (!colorOk) return false;
    }

    if (parsed.sizeCode) {
      var skuSizeCode = normalizeScanCode(sku.sizeCode || sku.sizeNo || legacySizeCodeFromName(sku.sizeName || sku.size));
      if (!skuSizeCode || skuSizeCode !== normalizeScanCode(parsed.sizeCode)) return false;
    } else if (parsed.colorCode) {
      var noSizeCode = normalizeScanCode(sku.sizeCode || sku.sizeNo || legacySizeCodeFromName(sku.sizeName || sku.size || ''));
      if (noSizeCode && noSizeCode !== '00' && noSizeCode !== 'NOSIZE' && noSizeCode !== 'NO SIZE') return false;
    }
    return true;
  }

  function stocktakeLegacyProductMatches(product, parsed) {
    if (!parsed || !parsed.productCode || !product) return false;
    return [product.code, product.id, product.barcode, product.companyBarcode].map(normalizeScanCode).some(function (code) {
      return code === parsed.productCode || scanFamilyCode(code) === parsed.productCode;
