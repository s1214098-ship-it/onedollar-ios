  function normalizeProductLogisticsRecords(records) {
    var cutoff = productLogisticsCutoffTime();
    return (Array.isArray(records) ? records : []).map(function (item) {
      item = item || {};
      return Object.assign({}, item, {
        id: item.id || ('plog-' + Date.now() + '-' + Math.random().toString(16).slice(2)),
        date: item.date || item.createdAt || '',
        platform: item.platform || item.sourcePlatform || item.source || '',
        trackingNo: item.trackingNo || item.logisticsNo || item.customsNo || item.no || '',
        progress: item.progress || item.status || item.processStatus || '',
        note: item.note || item.remark || ''
      });
    }).filter(function (item) {
      if (!item.trackingNo && !item.platform && !item.progress && !item.note) return false;
      var time = item.date ? new Date(item.date).getTime() : Date.now();
      return !Number.isFinite(time) || time >= cutoff;
    });
  }

