  }

  function legacyInventorySizeOptions(product, parsed, sourceSkus) {
    if (!parsed || !parsed.productCode || !parsed.cost || !parsed.colorCode) return [];
    var baseSkus = sourceSkus && sourceSkus.length ? sourceSkus : productSkus(state.skus, product.id);
    var allSizes = [];
    baseSkus.forEach(function (sku) {
      var size = inventorySkuSizeKey(sku.sizeName || sku.size);
      if (size && allSizes.indexOf(size) === -1) allSizes.push(size);
    });
    if (!allSizes.length && parsed.sizeName) allSizes.push(inventorySkuSizeKey(parsed.sizeName));
    if (!allSizes.length) allSizes = ['NO SIZE'];
    return allSizes.map(function (size) {
      var sizeCode = legacySizeCodeFromName(size) || parsed.sizeCode || '';
      return {
        size: size,
        colorCode: parsed.colorCode,
        sizeCode: sizeCode,
        oldBarcode: parsed.productCode + 'P' + parsed.cost + parsed.colorCode + sizeCode
      };
    });
  }



  function inventoryLegacyColorSwitchHtml(product, activeColorCode, parsed) {
    var allSkus = productSkus(state.skus, product.id);
    var colors = [];
    (product.colors || []).forEach(function (item) {
      var code = normalizeScanCode(item.colorCode || item.no || item.legacyColorCode || item.code || legacyColorCodeFromName(item.name));
      if (!code) return;
      if (colors.some(function (row) { return row.code === code; })) return;
      var colorSkus = allSkus.filter(function (sku) {
        return stocktakeLegacyColorCodes(product, sku).indexOf(code) !== -1;
      });
      var stock = colorSkus.reduce(function (sum, sku) { return sum + Number(sku.stock || 0); }, 0);
      colors.push({
        code: code,
        name: item.name || legacyColorName(code) || item.code || code,
        image: item.image || (colorSkus[0] && (colorSkus[0].image || colorSkus[0].colorImage)) || product.mainImage || '',
        stock: stock
      });
    });
    allSkus.forEach(function (sku) {
      var code = normalizeScanCode(sku.colorCode || sku.colorNo || legacyColorCodeFromName(sku.colorName || sku.color));
      if (!code || colors.some(function (row) { return row.code === code; })) return;
      var stock = allSkus.filter(function (item) {
        return stocktakeLegacyColorCodes(product, item).indexOf(code) !== -1;
      }).reduce(function (sum, item) { return sum + Number(item.stock || 0); }, 0);
      colors.push({ code: code, name: sku.colorName || sku.color || legacyColorName(code) || code, image: product.mainImage || '', stock: stock });
    });
    if (!colors.length) return '';
