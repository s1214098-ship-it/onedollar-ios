  function inventoryLocationCompareWarehouseLabel(value) {
    var raw = String(value || '').trim();
    if (!raw) return '未設定貨倉';
    var code = normalizeWarehouseCode(raw);
    if (code === 'TW' || code === 'CN' || code === 'ID') return warehouseLabel(code);
    if (code === 'PREORDER' || /預購|preorder/i.test(raw)) return '預購倉';
    return raw;
  }

  function inventoryLocationCompareLocation(product, sku) {
    product = product || {};
    sku = sku || {};
    var warehouses = asList(sku.warehouseCode || sku.warehouseName || sku.warehouse || product.warehouseCode || product.warehouseName || product.warehouse);
    var shelves = asList(sku.shelves).concat(asList(sku.shelf));
    var layers = asList(sku.layers).concat(asList(sku.layer));
    if (!shelves.length) shelves = asList(product.shelves).concat(asList(product.shelf));
    if (!layers.length) layers = asList(product.layers).concat(asList(product.layer));
    warehouses = warehouses.filter(function (value, index, list) { return list.indexOf(value) === index; });
    shelves = shelves.filter(function (value, index, list) { return list.indexOf(value) === index; });
    layers = layers.filter(function (value, index, list) { return list.indexOf(value) === index; });
    return {
      warehouse: warehouses.length ? warehouses.map(inventoryLocationCompareWarehouseLabel).join('、') : '未設定貨倉',
      shelf: shelves.length ? shelves.join('、') : '未設定貨架',
      layer: layers.length ? layers.join('、') : '未設定層位',
      composite: warehouses.length > 1 || shelves.length > 1 || layers.length > 1
    };
  }

  function inventoryLocationCompareRows() {
    var products = {};
    (state.products || []).forEach(function (product) { products[String(product.id || '')] = product; });
    return (state.skus || []).map(function (sku, index) {
      if (typeof inventorySkuShouldDisplay === 'function' && !inventorySkuShouldDisplay(sku)) return null;
      var product = products[String(sku.productId || '')] || {};
      var location = inventoryLocationCompareLocation(product, sku);
      var key = encodeURIComponent([location.warehouse, location.shelf, location.layer].join('|||'));
      return {
        key: key,
        warehouse: location.warehouse,
        shelf: location.shelf,
        layer: location.layer,
        composite: location.composite,
        stock: Number(sku.stock || 0),
        productCode: String(product.code || product.id || sku.productId || '未連結商品'),
        title: String(product.title || product.name || '未命名商品'),
        skuCode: String(sku.barcode || sku.companyBarcode || sku.sku || sku.id || ('SKU-' + (index + 1))),
        variant: [sku.colorName || sku.color || '未填顏色', sku.sizeName || sku.size || 'NO SIZE'].join(' / ')
      };
    }).filter(Boolean);
  }

  function inventoryLocationCompareOrder(values, reference) {
    var refs = (reference || []).map(function (value) { return String(value || '').trim(); }).filter(Boolean);
    return values.slice().sort(function (a, b) {
      var ai = refs.indexOf(a);
      var bi = refs.indexOf(b);
      if (ai === -1) ai = 9999;
      if (bi === -1) bi = 9999;
      return ai === bi ? String(a).localeCompare(String(b), 'zh-Hant') : ai - bi;
    });
  }

  function inventoryLocationCompareOptions(select, values, allLabel) {
    if (!select) return 'all';
    var current = select.value || 'all';
    select.innerHTML = '<option value="all">' + escapeHtml(allLabel) + '</option>' + values.map(function (value) {
      return '<option value="' + escapeHtml(value) + '">' + escapeHtml(value) + '</option>';
    }).join('');
    select.value = values.indexOf(current) >= 0 ? current : 'all';
    return select.value;
  }

  function renderInventoryLocationCompare() {
    var panel = document.querySelector('[data-inventory-location-compare]');
    if (!panel || isSalesLogin()) return;
    var warehouseOptions = panel.querySelector('[data-inventory-location-compare-warehouse-options]');
    var shelfSelect = panel.querySelector('[data-inventory-location-compare-shelf]');
    var includeEmptyInput = panel.querySelector('[data-inventory-location-compare-empty]');
    var content = panel.querySelector('[data-inventory-location-compare-content]');
    if (!content) return;
    var rows = inventoryLocationCompareRows();
    var warehouses = inventoryLocationCompareOrder(Array.from(new Set(rows.map(function (row) { return row.warehouse; }))), state.warehouses);
    inventoryLocationCompareWarehouses = inventoryLocationCompareWarehouses.filter(function (warehouse) { return warehouses.indexOf(warehouse) >= 0; });
    if (warehouseOptions) {
      warehouseOptions.innerHTML = '<button type="button" class="' + (!inventoryLocationCompareWarehouses.length ? 'is-selected' : '') + '" data-inventory-location-compare-warehouse="all" aria-pressed="' + (!inventoryLocationCompareWarehouses.length ? 'true' : 'false') + '">全部貨倉</button>' + warehouses.map(function (warehouse) {
        var selected = inventoryLocationCompareWarehouses.indexOf(warehouse) >= 0;
        return '<button type="button" class="' + (selected ? 'is-selected' : '') + '" data-inventory-location-compare-warehouse="' + escapeHtml(warehouse) + '" aria-pressed="' + (selected ? 'true' : 'false') + '">' + escapeHtml(warehouse) + '</button>';
      }).join('');
    }
    var warehouseRows = rows.filter(function (row) { return !inventoryLocationCompareWarehouses.length || inventoryLocationCompareWarehouses.indexOf(row.warehouse) >= 0; });
    var shelves = inventoryLocationCompareOrder(Array.from(new Set(warehouseRows.map(function (row) { return row.shelf; }))), state.shelves);
    var selectedShelf = inventoryLocationCompareOptions(shelfSelect, shelves, '全部貨架');
    var includeEmpty = Boolean(includeEmptyInput && includeEmptyInput.checked);
    var filteredRows = warehouseRows.filter(function (row) {
      return (selectedShelf === 'all' || row.shelf === selectedShelf) && (includeEmpty || row.stock !== 0);
    });
    var groups = {};
    filteredRows.forEach(function (row) {
      if (!groups[row.key]) groups[row.key] = { key: row.key, warehouse: row.warehouse, shelf: row.shelf, layer: row.layer, stock: 0, rows: [] };
      groups[row.key].stock += row.stock;
      groups[row.key].rows.push(row);
    });
    var grouped = Object.keys(groups).map(function (key) { return groups[key]; });
    var totalStock = filteredRows.reduce(function (sum, row) { return sum + row.stock; }, 0);
    var issueRows = filteredRows.filter(function (row) {
      return row.stock > 0 && (row.composite || /^未設定/.test(row.warehouse) || /^未設定/.test(row.shelf) || /^未設定/.test(row.layer));
    });
    if (!filteredRows.length) {
      content.innerHTML = '<div class="inventory-location-compare-stats"><b>帳面 0 件</b><span>沒有符合目前條件的 SKU</span></div><p class="empty-state">請切換貨倉、貨架，或勾選「包含 0 庫存 SKU」。</p>';
      return;
    }
    var matrixHtml = warehouses.filter(function (warehouse) {
      return inventoryLocationCompareWarehouses.length
        ? inventoryLocationCompareWarehouses.indexOf(warehouse) >= 0 && grouped.some(function (group) { return group.warehouse === warehouse; })
        : grouped.some(function (group) { return group.warehouse === warehouse; });
    }).map(function (warehouse) {
      var warehouseGroups = grouped.filter(function (group) { return group.warehouse === warehouse; });
      var matrixShelves = inventoryLocationCompareOrder(Array.from(new Set(warehouseGroups.map(function (group) { return group.shelf; }))), state.shelves);
      var matrixLayers = inventoryLocationCompareOrder(Array.from(new Set(warehouseGroups.map(function (group) { return group.layer; }))), state.layers);
      var head = matrixLayers.map(function (layer) { return '<th>' + escapeHtml(layer) + '</th>'; }).join('');
      var body = matrixShelves.map(function (shelf) {
        var cells = matrixLayers.map(function (layer) {
          var group = warehouseGroups.find(function (item) { return item.shelf === shelf && item.layer === layer; });
          if (!group) return '<td><span class="is-zero">—</span></td>';
          var selected = inventoryLocationCompareSelection === group.key ? ' is-selected' : '';
          return '<td><button type="button" class="inventory-location-compare-cell' + selected + '" data-inventory-location-compare-cell="' + escapeHtml(group.key) + '"><b>' + Number(group.stock || 0) + '</b><small>' + group.rows.length + ' SKU</small></button></td>';
        }).join('');
        var shelfTotal = warehouseGroups.filter(function (group) { return group.shelf === shelf; }).reduce(function (sum, group) { return sum + group.stock; }, 0);
        return '<tr><th>' + escapeHtml(shelf) + '<small>共 ' + shelfTotal + ' 件</small></th>' + cells + '</tr>';
      }).join('');
      var warehouseTotal = warehouseGroups.reduce(function (sum, group) { return sum + group.stock; }, 0);
      return '<section class="inventory-location-compare-warehouse"><h4>' + escapeHtml(warehouse) + '<span>' + warehouseTotal + ' 件</span></h4><div class="inventory-location-compare-table-wrap"><table><thead><tr><th>貨架 ＼ 層架</th>' + head + '</tr></thead><tbody>' + body + '</tbody></table></div></section>';
    }).join('');
    var selectedGroup = groups[inventoryLocationCompareSelection] || null;
    if (!selectedGroup) inventoryLocationCompareSelection = '';
    var detailHtml = selectedGroup ? '<section class="inventory-location-compare-detail"><header><div><small>LOCATION DETAIL</small><h4>' + escapeHtml([selectedGroup.warehouse, selectedGroup.shelf, selectedGroup.layer].join(' / ')) + '</h4></div><b>' + selectedGroup.stock + ' 件</b></header><div>' + selectedGroup.rows.slice().sort(function (a, b) { return b.stock - a.stock; }).map(function (row) {
      return '<article><div><b>' + escapeHtml(row.productCode) + '　' + escapeHtml(row.title) + '</b><span>' + escapeHtml(row.variant) + '</span><small>條碼／SKU：' + escapeHtml(row.skuCode) + '</small></div><strong>' + row.stock + ' 件</strong></article>';
    }).join('') + '</div></section>' : '<p class="inventory-location-compare-help">點選表格中的數量，即可展開該層架的商品明細。</p>';
    var issueHtml = issueRows.length ? '<div class="inventory-location-compare-warning"><b>需整理倉位 ' + issueRows.length + ' 個 SKU</b><span>有庫存但位置未填完整，或同一 SKU 同時綁定多個位置；請先核對再盤點。</span></div>' : '';
    content.innerHTML = '<div class="inventory-location-compare-stats"><b>帳面合計 ' + totalStock + ' 件</b><span>' + filteredRows.length + ' 個 SKU・' + grouped.length + ' 個倉架層位置</span></div>' + issueHtml + matrixHtml + detailHtml;
  }

