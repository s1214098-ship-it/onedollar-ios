  function visiblePreorderInquiries() {
    var login = currentLogin();
    var list = Array.isArray(state.inquiries) ? state.inquiries : [];
    return list.filter(function (row) {
      var isPreorder = row && (row.orderType === 'preorder' || row.status === 'preorder_pending');
      if (!isPreorder || !isRecentOrderRow(row)) return false;
      if (login.role !== 'sales') return true;
      var owner = login.name || login.account || '';
      return (row.salesName || row.sales || '') === owner;
    });
