  }

  function logisticsRowKey(row) {
    return String(row.id || [row.date, row.name, row.phone, logisticsNo(row), row.amount].join('|')).trim();
  }

  function updateLogisticsSelectionUi() {
    var count = logisticsSelectedIds.size;
    var countEl = document.querySelector('[data-logistics-selected-count]');
    if (countEl) countEl.textContent = '已勾選 ' + count + ' 筆';
    var bulkButton = document.querySelector('[data-logistics-bulk-report]');
    if (bulkButton) bulkButton.disabled = count < 1;
    var selectPage = document.querySelector('[data-logistics-select-page]');
    if (selectPage) {
      var visibleKeys = logisticsVisibleRows.map(logisticsRowKey);
      var selectedOnPage = visibleKeys.filter(function (key) { return logisticsSelectedIds.has(key); }).length;
      selectPage.checked = visibleKeys.length > 0 && selectedOnPage === visibleKeys.length;
      selectPage.indeterminate = selectedOnPage > 0 && selectedOnPage < visibleKeys.length;
    }
  }

  function selectedLogisticsRows() {
    return Array.from(logisticsSelectedIds).map(function (key) {
      return logisticsRowCache[key];
    }).filter(Boolean);
  }

  function fillLogisticsBulkReport() {
    var selected = selectedLogisticsRows();
    if (!selected.length) {
      toast('請先勾選要回報的物流資料');
      return;
    }
    var refs = selected.map(reportReference);
    var refInput = document.querySelector('[data-error-logistics-ref]');
    var typeSelect = document.querySelector('[data-error-type]');
    var noteInput = document.querySelector('[data-error-note]');
    if (refInput) refInput.value = refs.join('；');
    if (typeSelect) typeSelect.value = selected.some(isReturnOrAbnormal) ? '退回門市' : '未送達';
    if (noteInput) {
      noteInput.value = selected.map(function (row, index) {
        var statusText = logisticsDeliveryLabel(row);
        return (index + 1) + '. ' + reportReference(row) + ' / ' + (row.date || '-') + ' / ' + statusText;
      }).join('\n');
    }
    document.querySelector('[data-logistics-audit]')?.scrollIntoView({ behavior: 'smooth', block: 'start' });
