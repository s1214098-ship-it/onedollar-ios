  function findLogisticsForOrder(order, trackingNo) {
    var customer = order.customer || {};
    var wantedNo = normalizeLogisticsNo(trackingNo || order.trackingNo || '');
    var phone = String(customer.phone || '').replace(/\D+/g, '');
    var name = String(customer.name || '').trim().toLowerCase();
    var rows = Array.isArray(state.logistics) ? state.logistics : [];
    if (wantedNo) {
      var exactRows = rows.filter(function (row) {
        return logisticsNos(row).some(function (no) {
          return normalizeLogisticsNo(no) === wantedNo;
        });
      });
      var verified = exactRows.find(function (row) {
        return logisticsRecipientMatches(order, row);
      });
      if (verified) return verified;
      if (exactRows.length === 1) return exactRows[0];
    }
    return rows.find(function (row) {
      var rowPhone = String(row.phone || '').replace(/\D+/g, '');
      var rowName = String(row.name || '').trim().toLowerCase();
      var phoneOk = phone && rowPhone && (phone === rowPhone || phone.slice(-6) === rowPhone.slice(-6));
      var nameOk = name && rowName && (rowName.indexOf(name) !== -1 || name.indexOf(rowName) !== -1);
      return phoneOk || nameOk;
    }) || null;
  }

  var ORDER_VISIBLE_DAYS = 10;

  function orderVisibleTime(row) {
    var value = row && (row.createdAt || row.updatedAt || row.preorderConvertedAt || row.convertedAt || '');
    var time = Date.parse(value);
    return Number.isFinite(time) ? time : 0;
  }

  function isRecentOrderRow(row) {
    var time = orderVisibleTime(row);
    if (!time) return true;
    return Date.now() - time <= ORDER_VISIBLE_DAYS * 24 * 60 * 60 * 1000;
  }

  function isWithinLiveDeskWindow(row) {
    var time = orderVisibleTime(row);
    if (!time) return false;
    return Date.now() - time <= 24 * 60 * 60 * 1000;
  }

  function isAdminLiveOrder(order) {
    if (!order) return false;
    var text = [
      order.source,
      order.orderType,
      order.orderTypeLabel,
      order.liveSession,
      order.shipMode,
      order.shipModeLabel
    ].join(' ').toLowerCase();
    return /live-order|live|直播/.test(text);
  }

  function visibleOrders() {
    var login = currentLogin();
    var list = (Array.isArray(state.orders) ? state.orders : []).filter(isRecentOrderRow);
    if (login.role !== 'sales') return list;
    var owner = login.name || login.account || '';
    return list.filter(function (order) {
      return orderSalesName(order) === owner;
    });
