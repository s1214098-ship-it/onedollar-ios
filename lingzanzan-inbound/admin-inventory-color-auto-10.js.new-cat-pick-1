  function freightToday() {
    return new Date().toISOString().slice(0, 10);
  }

  function normalizeFreightTracking(data) {
    data = data || {};
    return {
      schemaVersion: Math.max(2, Number(data.schemaVersion || 2)),
      revision: Math.max(0, Number(data.revision || 0)),
      batches: Array.isArray(data.batches) ? data.batches : [],
      items: Array.isArray(data.items) ? data.items : [],
      checkpoints: Array.isArray(data.checkpoints) ? data.checkpoints : [],
      damages: Array.isArray(data.damages) ? data.damages : [],
      importMeta: data.importMeta && typeof data.importMeta === 'object' ? data.importMeta : {}
    };
  }

  function loadFreightTracking() {
    if (!document.querySelector('[data-freight-tracking-panel]') && !document.querySelector('[data-product-customs-options]')) return Promise.resolve();
    return fetch('./freight-tracking-api.php?_=' + Date.now(), { cache: 'no-store' })
      .then(function (res) {
        if (!res.ok) throw new Error('物流集運讀取失敗 ' + res.status);
        return res.json();
      })
      .then(function (payload) {
        state.freightTracking = normalizeFreightTracking(payload && payload.data);
        fillFreightBatchSelect();
        fillRecentCustomsOptions();
        renderFreightTracking();
      })
      .catch(function (error) {
        state.freightTracking = normalizeFreightTracking(state.freightTracking);
        renderFreightTracking();
        toast(error.message || '物流集運讀取失敗');
      });
  }

  function saveFreightTracking() {
    state.freightTracking = normalizeFreightTracking(state.freightTracking);
    return fetch('./freight-tracking-api.php', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(state.freightTracking)
    }).then(function (res) {
      return res.json().then(function (payload) {
        if (!res.ok || !payload.ok) throw new Error(payload.error || '物流集運儲存失敗');
        state.freightTracking = normalizeFreightTracking(payload.data);
        fillFreightBatchSelect();
        fillRecentCustomsOptions();
        renderFreightTracking();
        return payload;
      });
    });
  }

  function freightBatchLabel(batch) {
    if (!batch) return '未綁定批次';
    return [batch.date, batch.forwarder, batch.batchNo || batch.customsNo || batch.consolidationNo || batch.logisticsTrackingNo || batch.id].filter(Boolean).join(' / ');
  }

  function freightBatchById(id) {
    return normalizeFreightTracking(state.freightTracking).batches.find(function (batch) {
      return String(batch.id || '') === String(id || '');
    }) || null;
  }

  function freightAllocationTwd(batch) {
    if (!batch) return 0;
    if ((batch.costMode || '') === 'self_pickup') return 30;
    if ((batch.chargeType || '') === 'none') return 0;
    var each = Number(batch.allocationPerItem || 0);
    if ((!Number.isFinite(each) || each <= 0) && Number(batch.itemCount || 0) > 0) each = Number(batch.amount || 0) / Number(batch.itemCount || 1);
    if (!Number.isFinite(each)) each = 0;
    return Math.round(each * 100) / 100;
  }

  function freightFinalCost(item) {
    var qty = Math.max(1, Number(item.quantity || 1));
    var batch = freightBatchById(item.batchId);
    var fixedTwd = Number(item.existingTwdCost || 0);
    var isFixedTwd = !!item.fixedTwdCost && fixedTwd > 0;
    var base = isFixedTwd ? Math.round(fixedTwd) : Math.round(Number(item.costRmb || 0) * 5);
    var allocation = isFixedTwd ? 0 : freightAllocationTwd(batch);
    var haohongShipping = !isFixedTwd && batch && batch.costMode === 'haohong_weight' && Number(batch.amount || 0) <= 0
      ? Math.round(Number(item.weightKg || 0) * 8 * 5)
      : 0;
    return {
      base: base,
      allocation: allocation,
      haohongShipping: haohongShipping,
      isFixedTwd: isFixedTwd,
      displayCost: Math.max(0, base + allocation + haohongShipping),
      companyInternalCost: Math.max(0, base + allocation + haohongShipping),
      qty: qty
    };
  }

  function fillFreightBatchSelect() {
    var select = document.querySelector('[data-freight-batch-select]');
    if (!select) return;
    var batches = normalizeFreightTracking(state.freightTracking).batches;
    select.innerHTML = '<option value="">未綁定批次</option>' + batches.map(function (batch) {
      return '<option value="' + escapeHtml(batch.id) + '">' + escapeHtml(freightBatchLabel(batch)) + '</option>';
    }).join('');
  }

  function freightBatchIsRecent(batch) {
    var time = Date.parse(batch && (batch.date || batch.updatedAt || batch.createdAt || ''));
    return Number.isFinite(time) && time >= Date.now() - (15 * 24 * 60 * 60 * 1000);
  }

  function freightBatchTaxType(batch) {
    return batch && (batch.warehouseTaxType || (batch.chargeType === 'none' ? 'tax_exempt' : 'taxable')) || 'taxable';
  }

  function recentFreightBatchesForSelection(platform, taxType) {
    platform = String(platform || '').trim().toLowerCase();
    return normalizeFreightTracking(state.freightTracking).batches.filter(function (batch) {
      var batchPlatform = String(batch.platform || '').trim().toLowerCase();
      return freightBatchIsRecent(batch) && (!taxType || freightBatchTaxType(batch) === taxType) && (!platform || !batchPlatform || batchPlatform === platform);
    }).sort(function (a, b) { return Date.parse(b.date || b.updatedAt || 0) - Date.parse(a.date || a.updatedAt || 0); });
  }

  function freightBatchMatchesSource(batch, source) {
    source = source === 'haohong' ? 'haohong' : 'pinduoduo';
    var isHaohong = ['haohong_weight', 'haohong_batch'].indexOf(String(batch && batch.costMode || '')) >= 0 || /豪鴻/.test(String(batch && batch.forwarder || ''));
    return source === 'haohong' ? isHaohong : !isHaohong;
  }

  function productFreightSource() {
    return document.querySelector('[data-product-freight-source]')?.value === 'haohong' ? 'haohong' : 'pinduoduo';
  }

  function fillFreightBatchPlatformSelect() {
    var select = document.querySelector('[data-freight-batch-platform]');
    if (!select) return;
    var current = select.value;
    select.innerHTML = '<option value="">未指定平台／顯示全部</option>' + purchasePlatformNames().map(function (name) { return '<option value="' + escapeHtml(name) + '">' + escapeHtml(name) + '</option>'; }).join('');
    if (Array.from(select.options).some(function (option) { return option.value === current; })) select.value = current;
