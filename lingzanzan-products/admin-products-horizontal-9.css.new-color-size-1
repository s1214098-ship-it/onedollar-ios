  z-index: 1000;
  display: grid;
  gap: 6px;
  width: min(360px, calc(100vw - 24px));
  border: 1px solid rgba(240, 201, 109, .45);
  border-radius: 14px;
  padding: 8px;
  background: #1c121c;
  box-shadow: 0 18px 44px rgba(0, 0, 0, .35);
