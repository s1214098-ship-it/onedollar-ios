.stocktake-compare-row.is-over { border-color: rgba(74, 191, 224, .62); background: rgba(74, 191, 224, .10); }
.stocktake-compare-row.is-loss { border-color: rgba(238, 111, 121, .64); background: rgba(238, 111, 121, .10); }
.stocktake-compare-row.is-missing { border-color: rgba(240, 201, 109, .55); background: rgba(240, 201, 109, .08); }
.stocktake-compare-row.is-equal > span { color: #82e7b5; }
.stocktake-compare-row.is-over > span { color: #8ee6ff; }
.stocktake-compare-row.is-loss > span { color: #ff9fa6; }
.stocktake-compare-row.is-missing > span { color: #ffd166; }

