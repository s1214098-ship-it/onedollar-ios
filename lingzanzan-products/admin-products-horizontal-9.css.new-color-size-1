:root {
  color-scheme: dark;
  --bg: #110d12;
  --panel: #1b151d;
  --panel-2: #241b27;
  --ink: #fff8ed;
  --muted: #b8aab2;
  --line: rgba(255, 248, 237, .14);
  --gold: #e8b75b;
  --rose: #e05c7e;
  --danger: #ef4b4b;
  --teal: #35c2ae;
}

.style-column-admin,
.style-column-form,
.style-product-picker,
.style-column-list {
  display: grid;
  gap: 14px;
}

.style-column-form label {
  display: grid;
  gap: 7px;
  color: var(--gold);
  font-weight: 900;
}

.style-column-form input,
.style-column-form textarea,
.style-column-form select {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 12px 13px;
  color: var(--ink);
  background: rgba(255, 248, 237, .08);
}

.style-product-picker > div {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 10px;
}

.style-product-choice {
  display: grid;
  grid-template-columns: 22px 58px minmax(0, 1fr);
  gap: 10px;
  align-items: center;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 8px;
  color: var(--ink);
  background: rgba(255, 248, 237, .05);
}

.style-product-choice label {
  min-width: 0;
}

.style-product-image {
  width: 58px;
  height: 70px;
  border: 0;
  border-radius: 10px;
  padding: 0;
  background: transparent;
  cursor: zoom-in;
  overflow: hidden;
}

.style-product-choice img {
  width: 58px;
  height: 70px;
  border-radius: 10px;
  object-fit: cover;
}

.order-photo-lightbox figure {
  margin: 0;
  text-align: center;
}

.order-photo-lightbox figcaption {
  margin-top: 10px;
  color: var(--gold);
  font-size: 20px;
  font-weight: 950;
}

.style-product-choice b,
.style-product-choice em,
.style-column-row b,
.style-column-row span {
  display: block;
}

.style-product-choice em,
.style-column-row span {
  color: var(--muted);
  font-style: normal;
  font-size: 13px;
}

.style-form-actions,
.style-row-actions {
  display: flex;
  flex-wrap: wrap;
  gap: 10px;
}

.style-form-actions button,
.style-row-actions button {
  border: 1px solid var(--gold);
  border-radius: 999px;
  padding: 10px 14px;
  color: #111;
  background: var(--gold);
  font-weight: 950;
}

.style-column-row {
  display: flex;
  justify-content: space-between;
  gap: 14px;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 13px;
  background: rgba(255, 248, 237, .05);
}

* { box-sizing: border-box; }

body {
  overflow-x: hidden;
margin: 0;
  min-height: 100vh;
  font-family: "Microsoft JhengHei", Arial, sans-serif;
  color: var(--ink);
  background:
    radial-gradient(circle at 82% 0, rgba(224, 92, 126, .16), transparent 32%),
    linear-gradient(135deg, #110d12 0%, #181018 60%, #102522 100%);
}

a { color: inherit; text-decoration: none; }
button, input, select { font: inherit; }
button { cursor: pointer; }

[hidden],
main > [hidden],
.sidebar nav a[hidden] {
  display: none !important;
}

.login-gate {
  position: fixed;
  inset: 0;
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 100vh;
  min-height: 100svh;
  width: 100%;
  padding: 18px;
  overflow: auto;
  background:
    radial-gradient(circle at 70% 12%, rgba(232, 183, 91, .18), transparent 30%),
    linear-gradient(135deg, #110d12 0%, #181018 60%, #102522 100%);
}

.login-gate.is-unlocked,
body.is-admin-unlocked .login-gate {
  display: none !important;
}

.login-card {
  display: grid;
  gap: 12px;
  width: min(420px, calc(100vw - 32px));
  max-width: 420px;
  max-height: calc(100svh - 32px);
  overflow: auto;
  border: 1px solid var(--line);
  border-radius: 24px;
  padding: clamp(20px, 5vw, 28px);
  background: rgba(27, 21, 29, .96);
  box-shadow: 0 28px 70px rgba(0, 0, 0, .32);
}

.login-card img {
  width: 72px;
  height: 72px;
  border-radius: 50%;
  object-fit: cover;
  background: #fff;
}

.login-card p {
  margin: 0;
  color: var(--gold);
  font-size: 12px;
  font-weight: 950;
  letter-spacing: .14em;
}

.login-card h1 {
  margin: 0;
  font-size: clamp(32px, 8vw, 42px);
  line-height: 1.12;
  letter-spacing: 0;
}

.login-card span,
.login-card small {
  color: var(--muted);
  line-height: 1.7;
}

.login-card input {
  border: 1px solid var(--line);
  border-radius: 12px;
  padding: 13px 14px;
  color: var(--ink);
  background: rgba(255, 248, 237, .08);
}

.login-card button,
.head-actions button {
  border: 1px solid var(--gold);
  border-radius: 999px;
  padding: 11px 18px;
  color: var(--gold);
  background: transparent;
  font-weight: 950;
}

.login-home-link {
  border: 1px solid rgba(232, 183, 91, .42);
  border-radius: 999px;
  padding: 11px 18px;
  color: var(--gold);
  text-align: center;
  font-weight: 950;
}

.head-actions {
  display: flex;
  gap: 8px;
  flex-wrap: wrap;
}

.admin-shell {
  display: none;
  grid-template-columns: 248px minmax(0, 1fr);
  min-height: 100vh;
}

body.is-admin-unlocked .admin-shell {
  display: grid;
}

body:not(.is-admin-unlocked) .admin-shell {
  display: none !important;
}

.admin-top-actions {
  position: fixed;
  top: 14px;
  right: 18px;
  z-index: 35;
  display: none;
  gap: 8px;
}

.admin-top-actions[hidden] {
  display: none !important;
}

body.is-admin-unlocked .admin-top-actions {
  display: flex;
}

.admin-top-actions a,
.admin-top-actions button {
  border: 1px solid var(--gold);
  border-radius: 999px;
  padding: 9px 13px;
  color: #111;
  background: var(--gold);
  font-weight: 950;
  box-shadow: 0 10px 24px rgba(0, 0, 0, .25);
}

.login-identity {
  border: 1px solid rgba(232, 183, 91, .4);
  border-radius: 999px;
  padding: 9px 13px;
  color: var(--gold);
  background: rgba(20, 13, 19, .92);
  font-size: 12px;
  font-weight: 950;
  white-space: nowrap;
  box-shadow: 0 10px 24px rgba(0, 0, 0, .25);
}

.login-identity[hidden] {
  display: none !important;
}

body.is-sales-mode [data-admin-stats],
body.is-sales-mode .admin-only {
  display: none !important;
}

.sidebar {
  position: sticky;
  top: 0;
  height: 100vh;
  height: 100dvh;
  max-height: 100vh;
  max-height: 100dvh;
  overflow-y: auto;
  overscroll-behavior: contain;
  scrollbar-gutter: stable;
  border-right: 1px solid var(--line);
  padding: 24px;
  background: rgba(17, 13, 18, .9);
}

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 28px;
  color: var(--gold);
  font-size: 22px;
  font-weight: 950;
}

.brand img {
  width: 38px;
  height: 38px;
  border-radius: 50%;
  object-fit: cover;
  background: #fff;
}

.customer-window-links {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
  margin: -14px 0 18px;
  padding: 10px;
  border: 1px solid rgba(232, 183, 91, .28);
  border-radius: 14px;
  background: rgba(232, 183, 91, .07);
}

.customer-window-links span {
  grid-column: 1 / -1;
  color: var(--muted);
  font-size: 12px;
  font-weight: 900;
}

.customer-window-links a {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 34px;
  border-radius: 10px;
  color: #1b151d;
  background: var(--gold);
  font-size: 12px;
  font-weight: 950;
}

.customer-window-links a:last-child {
  color: #dff9f8;
  background: rgba(30, 184, 179, .26);
}

.sidebar nav {
  display: grid;
  gap: 8px;
  padding-bottom: 24px;
}

.sidebar nav a {
  border: 1px solid transparent;
  border-radius: 14px;
  padding: 11px 13px;
  color: #f4edf2;
  font-weight: 900;
  background: rgba(255, 255, 255, .03);
}

.sidebar nav a:hover {
  border-color: var(--line);
  color: #fff;
  background: var(--panel);
}

.sidebar nav a.is-active {
  border-color: var(--gold);
  color: var(--gold);
  background: rgba(232, 183, 91, .08);
}

main {
  width: min(1160px, calc(100% - 28px));
  margin: 0 auto;
  padding: 28px 0 56px;
}

.admin-hero,
.panel,
.stats article {
  border: 1px solid var(--line);
  border-radius: 22px;
  background: rgba(27, 21, 29, .92);
  box-shadow: 0 24px 60px rgba(0, 0, 0, .18);
}

.admin-hero {
  display: flex;
  justify-content: space-between;
  gap: 20px;
  align-items: end;
  padding: 28px;
}

.admin-hero p,
.panel-head p {
  margin: 0 0 8px;
  color: var(--gold);
  font-size: 12px;
  font-weight: 950;
  letter-spacing: .14em;
}

.admin-hero h1,
.panel h2,
.template-card h3 {
  margin: 0;
  letter-spacing: 0;
}

.admin-hero h1 {
  font-size: clamp(42px, 7vw, 82px);
  line-height: .95;
}

.admin-hero span {
  display: block;
  max-width: 680px;
  margin-top: 14px;
  color: var(--muted);
  line-height: 1.8;
}

.admin-hero a,
.panel-head button,
.inline-form button,
.role-grid button,
.maintenance-grid button {
  flex: 0 0 auto;
  border: 1px solid var(--gold);
  border-radius: 999px;
  padding: 10px 16px;
  color: var(--gold);
  background: transparent;
  font-weight: 950;
}

.stats {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 14px;
  margin: 16px 0;
}

.stats article,
.template-card,
.role-grid article,
.maintenance-grid article,
.warehouse-grid article {
  padding: 18px;
  background: var(--panel-2);
}

.stats span,
.warehouse-grid span,
.role-grid span,
.maintenance-grid span {
  color: var(--muted);
}

.stats strong {
  display: block;
  margin-top: 8px;
  color: var(--rose);
  font-size: 34px;
}

.panel {
  margin-top: 16px;
  padding: 20px;
}

.danger-panel {
  border-color: rgba(239, 75, 75, .35);
}

.panel-head {
  display: flex;
  justify-content: space-between;
  gap: 16px;
  align-items: end;
  margin-bottom: 14px;
}

.form-grid,
.role-grid,
.maintenance-grid,
.template-layout,
.warehouse-grid,
.permission-box {
  display: grid;
  gap: 12px;
}

.form-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.member-tools {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  gap: 12px;
  margin-top: 12px;
}

.role-grid,
.maintenance-grid,
.warehouse-grid {
  grid-template-columns: repeat(3, minmax(0, 1fr));
}

.template-layout {
  grid-template-columns: .8fr 1.1fr 1.1fr;
  margin-bottom: 14px;
}

label,
.template-card,
.role-grid article,
.maintenance-grid article,
.warehouse-grid article,
.permission-box {
  border: 1px solid var(--line);
  border-radius: 16px;
}

label {
  display: grid;
  gap: 8px;
  padding: 12px;
  color: var(--gold);
  background: var(--panel-2);
  font-weight: 900;
}

.permission-box {
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin: 12px 0;
  padding: 14px;
  background: var(--panel-2);
}

.permission-box h3 {
  grid-column: 1 / -1;
  margin: 0;
}

.permission-box label {
  display: flex;
  align-items: center;
  gap: 8px;
  padding: 10px;
}

label input,
label select,
.inline-form input,
.inline-form select,
textarea {
  width: 100%;
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 11px 12px;
  color: var(--ink);
  background: rgba(255, 248, 237, .08);
}

textarea {
  min-height: 92px;
  resize: vertical;
}

label select,
select {
  color: #111;
  background: #fff7fb;
}

label select option,
select option {
  color: #111;
  background: #fff7fb;
}

label select option:checked,
select option:checked {
  color: #111;
  background: #f3a6c8;
}

.role-grid b,
.maintenance-grid b,
.warehouse-grid b,
.warehouse-grid span,
.warehouse-grid strong {
  display: block;
}

.role-grid span,
.maintenance-grid span {
  display: block;
  min-height: 48px;
  margin: 8px 0 14px;
  line-height: 1.6;
}

.danger {
  border-color: var(--danger) !important;
  color: #fff !important;
  background: var(--danger) !important;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
  margin: 14px 0;
}

.chips span {
  border: 1px solid rgba(232, 183, 91, .42);
  border-radius: 999px;
  padding: 7px 10px;
  color: var(--gold);
  background: rgba(232, 183, 91, .08);
  font-weight: 900;
}

.dynamic-chips span {
  display: inline-flex;
  gap: 8px;
  align-items: center;
}

.dynamic-chips .selectable-chip {
  padding-left: 8px;
}

.selectable-chip input {
  width: auto;
  accent-color: var(--gold);
}

.selectable-chip em {
  font-style: normal;
}

.chip-remove {
  border: 0;
  border-radius: 50%;
  width: 20px;
  height: 20px;
  padding: 0;
  color: #110d12;
  background: var(--gold);
  font-weight: 950;
}

.inline-form {
  display: grid;
  grid-template-columns: 1fr auto;
  gap: 8px;
}

.module-form {
  margin-top: 10px;
}

.ai-copy-box {
  display: grid;
  gap: 10px;
  margin-top: 16px;
}

.admin-list {
  display: grid;
  gap: 10px;
}

.admin-product {
  display: grid;
  grid-template-columns: 28px 74px minmax(220px, 1fr) minmax(250px, 330px) auto auto;
  gap: 14px;
  align-items: center;
  border: 1px solid var(--line);
  border-radius: 16px;
  padding: 10px;
  background: var(--panel-2);
}

.admin-product img {
  width: 74px;
  height: 92px;
  object-fit: cover;
  border-radius: 12px;
}

.admin-product h3,
.admin-product p {
  margin: 0;
}

.admin-product p {
  margin-top: 5px;
  color: var(--muted);
}

.admin-product strong {
  color: var(--teal);
}

.product-inline-price {
  display: grid;
  grid-template-columns: 1fr 1fr auto;
  gap: 8px;
  align-items: end;
}

.product-inline-price label {
  color: var(--gold);
  font-size: 12px;
  font-weight: 950;
}

.product-inline-price input {
  width: 100%;
  margin-top: 4px;
  border: 1px solid var(--line);
  border-radius: 10px;
  padding: 8px 9px;
  color: #111;
  background: #fff7fb;
}

.product-inline-price button {
  border: 1px solid var(--gold);
  border-radius: 999px;
  padding: 9px 12px;
  color: #17110f;
  background: var(--gold);
  font-weight: 950;
}

.order-list {
  margin-top: 14px;
}

.order-card {
  display: grid;
  gap: 14px;
  border: 1px solid var(--line);
  border-radius: 18px;
  padding: 16px;
  background: var(--panel-2);
}

.order-card-head,
.order-customer {
  display: flex;
  gap: 12px;
  align-items: center;
  justify-content: space-between;
}

.order-card-head p,
.order-card-head h3,
.order-card-head span,
.order-customer p {
  margin: 0;
}

.order-card-head p {
  color: var(--gold);
  font-size: 12px;
  font-weight: 900;
}

.order-card-head h3 {
  color: var(--ink);
  font-size: 22px;
  letter-spacing: 0;
}

.order-card-head span,
.order-customer span,
.order-customer em {
  color: var(--muted);
  font-style: normal;
}

.order-card-head strong {
  border-radius: 999px;
  padding: 10px 14px;
  color: #111;
  background: linear-gradient(135deg, #f5c95c, #f8e19a);
  font-size: 18px;
}

.order-check {
  display: inline-flex;
  align-items: center;
  gap: 6px;
  color: var(--gold);
  font-size: 12px;
  font-weight: 900;
}

.order-bulk-toolbar {
  display: flex;
  justify-content: space-between;
  gap: 12px;
  align-items: center;
  border: 1px solid rgba(232, 183, 91, .35);
  border-radius: 14px;
  padding: 12px;
  margin: 12px 0;
  background: rgba(232, 183, 91, .07);
}

.order-bulk-toolbar > div:first-child {
  display: grid;
  gap: 4px;
}

.order-bulk-toolbar b {
  color: var(--text);
  font-size: 15px;
}

.order-bulk-toolbar span {
  color: var(--muted);
  font-size: 13px;
}

.order-bulk-actions {
  display: flex;
  flex-wrap: wrap;
  justify-content: flex-end;
  gap: 8px;
}

.order-bulk-actions button:disabled {
  cursor: not-allowed;
  opacity: .45;
}

.order-first-panel {
  display: grid;
  gap: 12px;
  border: 1px solid rgba(240, 201, 109, .34);
  border-radius: 18px;
  padding: 12px;
  background: rgba(240, 201, 109, .05);
}

.order-first-head {
  display: grid;
  grid-template-columns: auto minmax(210px, 1fr) minmax(220px, auto) minmax(140px, auto);
  gap: 12px;
  align-items: center;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 12px;
  background: rgba(255, 255, 255, .04);
}

.order-first-customer {
  display: flex;
  align-items: center;
  gap: 14px;
  flex-wrap: wrap;
}

.order-first-customer b {
  color: var(--teal);
  font-size: 18px;
}

.order-first-customer span,
.order-first-customer em,
.order-first-no span,
.order-first-no small,
.order-first-total span {
  color: var(--muted);
  font-style: normal;
}

.order-first-no,
.order-first-total {
  display: grid;
  gap: 3px;
}

.order-first-no strong {
  color: #fff;
}

.order-first-total strong {
  color: var(--gold);
  font-size: 20px;
}

.order-first-body {
  display: grid;
  grid-template-columns: minmax(360px, 1fr) minmax(420px, 1.05fr);
  gap: 12px;
  align-items: start;
}

.order-first-left {
  display: grid;
  grid-template-columns: 96px minmax(0, 1fr);
  gap: 12px;
}

.order-first-note {
  min-height: 96px;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 12px;
  background: rgba(255, 255, 255, .04);
}

.order-first-note p {
  margin: 0 0 6px;
}

.order-first-note small {
  color: var(--gold);
  line-height: 1.5;
}

.order-upload-photo,
.order-upload-empty {
  display: grid;
  gap: 6px;
  align-content: start;
  width: 96px;
  min-height: 96px;
  border: 1px solid var(--line);
  border-radius: 14px;
  padding: 8px;
  color: var(--gold);
  background: rgba(255, 255, 255, .04);
  font-size: 12px;
  font-weight: 900;
  text-align: center;
}

.order-upload-photo {
  cursor: zoom-in;
}

.order-upload-photo img {
  width: 78px;
  height: 78px;
  border-radius: 10px;
  object-fit: cover;
}

.order-upload-empty b {
  color: var(--muted);
}

.order-mini-items {
  grid-column: 1 / -1;
  display: grid;
  gap: 8px;
}

.order-mini-items section {
  display: grid;
  grid-template-columns: 64px minmax(0, 1fr);
  gap: 10px;
  align-items: center;
  border: 1px solid rgba(240, 201, 109, .28);
  border-radius: 14px;
  padding: 9px;
  background: rgba(240, 201, 109, .06);
}

.order-mini-items button {
  border: 0;
  padding: 0;
  background: transparent;
  cursor: zoom-in;
}

.order-mini-items img {
  width: 64px;
  height: 76px;
  border-radius: 10px;
  object-fit: cover;
}

.order-mini-items b,
.order-mini-items span,
.order-mini-items em {
  display: block;
}

.order-mini-items span {
  color: var(--muted);
}

.order-mini-items em {
  color: var(--gold);
  font-style: normal;
  font-weight: 900;
}

.order-first-logistics {
  display: grid;
  gap: 10px;
}

.order-status-row {
  display: flex;
  align-items: end;
  gap: 10px;
  flex-wrap: wrap;
  padding: 12px;
  border: 1px solid var(--line);
  border-radius: 14px;
  background: rgba(255, 255, 255, .04);
}

.order-status-row label {
  display: grid;
  gap: 5px;
  min-width: 150px;
