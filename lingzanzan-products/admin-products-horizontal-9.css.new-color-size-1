.product-color-main-picker {
  display: grid;
  gap: 12px;
  margin: 14px 0;
  padding: 14px;
  border: 1px solid rgba(53, 194, 174, .48);
  border-radius: 16px;
  background: rgba(53, 194, 174, .07);
}

.product-color-main-picker-head {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(220px, 320px);
