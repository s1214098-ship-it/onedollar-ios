/* Codex 20260716: split the long product page into focused left-side work areas. */
#product-admin.product-sections-ready {
  display: grid !important;
  grid-template-columns: 220px minmax(0, 1fr);
  gap: 16px 20px !important;
  align-items: start;
}

#product-admin.product-sections-ready > .panel-head {
  grid-column: 1 / -1;
  margin-bottom: 0 !important;
}

.product-section-nav {
  position: sticky;
  top: 18px;
  z-index: 4;
  grid-column: 1;
  grid-row: 2 / span 20;
  display: grid;
  gap: 9px;
  padding: 12px;
  border: 1px solid rgba(255, 248, 237, .13);
  border-radius: 18px;
  background: #120f14;
  box-shadow: 0 14px 34px rgba(0, 0, 0, .22);
}

.product-section-nav button {
  display: grid;
  gap: 4px;
  width: 100%;
  min-height: 68px;
  padding: 11px 13px !important;
  border: 1px solid rgba(255, 248, 237, .1) !important;
  border-radius: 13px !important;
  color: #f4edf2 !important;
  -webkit-text-fill-color: #f4edf2 !important;
  background: #201a22 !important;
  text-align: left;
  cursor: pointer;
}

.product-section-nav button b {
  color: inherit;
  font-size: 16px;
  line-height: 1.25;
}

.product-section-nav button span {
  color: #a99fa7;
  -webkit-text-fill-color: #a99fa7;
  font-size: 12px;
  line-height: 1.35;
}

.product-section-nav button:hover,
.product-section-nav button:focus-visible {
  border-color: rgba(92, 226, 204, .58) !important;
  background: #18302e !important;
}

.product-section-nav button.is-active {
  border-color: #64e4cf !important;
  color: #eafffb !important;
  -webkit-text-fill-color: #eafffb !important;
  background: linear-gradient(135deg, #164a43, #203934) !important;
  box-shadow: inset 4px 0 0 #73ead8;
}

.product-section-nav button.is-active span {
  color: #bdf8ef;
  -webkit-text-fill-color: #bdf8ef;
}

#product-admin.product-sections-ready > [data-product-section-panel] {
  grid-column: 2;
  min-width: 0;
  margin-top: 0 !important;
}

#product-admin.product-sections-ready > [data-product-section-panel]:not(.is-product-section-active),
#product-admin.product-sections-ready > .product-editor-shell:not(.is-section-active):not(.is-modal) {
  display: none !important;
}

#product-admin.product-sections-ready > .product-editor-shell.is-modal {
  display: block !important;
}

#product-admin.product-sections-ready > .product-editor-shell.is-section-active {
  display: block !important;
}

#product-admin.product-sections-ready > .product-editor-shell.is-section-active .product-editor-modal-head {
  display: flex;
  padding: 14px 16px;
  border: 1px solid rgba(92, 226, 204, .28);
  border-radius: 16px;
  background: #182321;
}

#product-admin.product-sections-ready > .product-editor-shell.is-section-active [data-product-editor-close] {
  display: none;
}

@media (max-width: 980px) {
  #product-admin.product-sections-ready {
    grid-template-columns: minmax(0, 1fr);
    gap: 13px !important;
  }

  #product-admin.product-sections-ready > .panel-head,
  #product-admin.product-sections-ready > [data-product-section-panel] {
    grid-column: 1;
  }

  .product-section-nav {
    position: sticky;
    top: 0;
    grid-column: 1;
    grid-row: auto;
    display: flex;
    gap: 8px;
    overflow-x: auto;
    padding: 9px;
    border-radius: 14px;
    scroll-snap-type: x proximity;
    scrollbar-width: thin;
  }

  .product-section-nav button {
    flex: 0 0 154px;
    min-height: 60px;
    scroll-snap-align: start;
  }
}

@media (max-width: 560px) {
  .product-section-nav button {
    flex-basis: 132px;
    min-height: 56px;
    padding: 9px 10px !important;
  }

  .product-section-nav button b { font-size: 14px; }
  .product-section-nav button span { font-size: 11px; }
}

